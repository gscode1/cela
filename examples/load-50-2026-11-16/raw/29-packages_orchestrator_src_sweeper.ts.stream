ENTRY 11774 {"id":11774,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport type { SessionRef } from \"@pi-durable-k8s/session-core\";\n     2\timport { errorMessage, log } from \"./log.js\";\n     3\timport { planSweep } from \"./sweep.js\";\n     4\timport type { SweepAction, SweepAgent, SweepClaim, SweepPvc, SweepSecret } from \"./sweep.js\";\n     5\t\n     6\texport interface SweeperDeps {\n     7\t  listSessions: () => Promise<SessionRef[]>;\n     8\t  listClaims: () => Promise<SweepClaim[]>;\n     9\t  listPvcs: () => Promise<SweepPvc[]>;\n    10\t  /** Undefined when OneCLI is not configured: the sweep then leaves agents alone. */\n    11\t  listOneCli: (() => Promise<{ agents: SweepAgent[]; secrets: SweepSecret[] }>) | undefined;\n    12\t  /** The session deletion's teardown: stops the bridge, deletes the claim, then the PVC. Also removes a lone PVC. */\n    13\t  destroyClaim: (claimName: string, sessionLabel: string) => Promise<void>;\n    14\t  revokeSession: (sessionId: string) => Promise<void>;\n    15\t  graceMs: number;\n    16\t  maxActions: number;\n    17\t  now?: () => number;\n    18\t}\n    19\t\n    20\t/**\n    21\t * The execution half of the orphan sweep: reads the world, asks `planSweep` what is orphaned, does it, logs each\n    22\t * action. One run at a time. A failing action is logged and the run goes on; the next run retries it. The log lines\n    23\t * carry names and ids only, never a token or secret value.\n    24\t */\n    25\texport class OrphanSweeper {\n    26\t  readonly #deps: SweeperDeps;\n    27\t  #running = false;\n    28\t  #timer: NodeJS.Timeout | undefined;\n    29\t\n    30\t  constructor(deps: SweeperDeps) {\n    31\t    this.#deps = deps;\n    32\t  }\n    33\t\n    34\t  start(intervalMs: number): void {\n    35\t    if (intervalMs <= 0) {\n    36\t      log(\"sweep-disabled\", {});\n    37\t      return;\n    38\t    }\n    39\t    this.#timer = setInterval(() => void this.run(), intervalMs);\n    40\t    this.#timer.unref();\n    41\t  }\n    42\t\n    43\t  stop(): void {\n    44\t    if (this.#timer !== undefined) clearInterval(this.#timer);\n    45\t  }\n    46\t\n    47\t  /** One sweep. Returns the actions that succeeded; never throws. */\n    48\t  async run(): Promise<SweepAction[]> {\n    49\t    if (this.#running) return [];\n    50\t    this.#running = true;\n    51\t    const done: SweepAction[] = [];\n    52\t    try {\n    53\t      const d = this.#deps;\n    54\t      const [sessions, claims, pvcs, oneCli] = await Promise.all([\n    55\t        d.listSessions(),\n    56\t        d.listClaims(),\n    57\t        d.listPvcs(),\n    58\t        d.listOneCli?.(),\n    59\t      ]);\n    60\t      const actions = planSweep({\n    61\t        sessions,\n    62\t        claims,\n    63\t        pvcs,\n    64\t        agents: oneCli?.agents,\n    65\t        secrets: oneCli?.secrets ?? [],\n    66\t        now: d.now?.() ?? Date.now(),\n    67\t        graceMs: d.graceMs,\n    68\t        maxActions: d.maxActions,\n    69\t      });\n    70\t      for (const action of actions) {\n    71\t        try {\n    72\t          await this.#apply(action);\n    73\t          log(\"sweep-action\", { ...action });\n    74\t          done.push(action);\n    75\t        } catch (error) {\n    76\t          log(\"sweep-action-failed\", { ...action, message: errorMessage(error) });\n    77\t        }\n    78\t      }\n    79\t      if (actions.length > 0) log(\"sweep-done\", { planned: actions.length, done: done.length });\n    80\t    } catch (error) {\n    81\t      log(\"sweep-failed\", { message: errorMessage(error) });\n    82\t    } finally {\n    83\t      this.#running = false;\n    84\t    }\n    85\t    return done;\n    86\t  }\n    87\t\n    88\t  async #apply(action: SweepAction): Promise<void> {\n    89\t    switch (action.kind) {\n    90\t      case \"delete-claim\":\n    91\t        return this.#deps.destroyClaim(action.claim, action.sessionLabel);\n    92\t      case \"delete-pvc\":\n    93\t        // The claim does not exist, so there is no label to check; deleteClaimAndPvc refuses if one appears meanwhile.\n    94\t        return this.#deps.destroyClaim(action.claim, \"orphan-pvc-sweep\");\n    95\t      case \"revoke-agent\":\n    96\t        return this.#deps.revokeSession(action.sessionId);\n    97\t    }\n    98\t  }\n    99\t}\n */\nexport class RepoAccess {\n  readonly #deps: RepoAccessDeps;\n  readonly #access = new Map<string, Access>();\n  readonly #byConversation = new Map<number, SessionRow>();\n  readonly #inFlight = new Map<string, Promise<Access>>();\n  readonly #prepared = new Set<string>();\n\n  constructor(deps: RepoAccessDeps) {\n    this.#deps = deps;\n  }\n\n  #now(): number {\n    return this.#deps.now?.() ?? Date.now();\n  }\n\n  /** The `shellEnv` of a repo session's env, provisioning OneCLI first if needed. Undefined for a plain session. */\n  async shellEnv(\n    session: SessionRow,\n    conversationId: number,\n  ): Promise<Record<string, string> | undefined> {\n    if (session.repo === null) return undefined;\n    this.#byConversation.set(conversationId, session);\n    const access = await this.ensureAccess(session);\n    return buildShellEnv({ gateway: this.#deps.gateway, token: access.proxyToken });\n  }\n\n  /** Called before each tool call of an open env: renews a GitHub token that is about to expire. No-op otherwise. */\n  async beforeUse(conversationId: number): Promise<void> {\n    const session = this.#byConversation.get(conversationId);\n    if (session === undefined) return;\n    const access = this.#access.get(session.id);\n    if (access !== undefined && access.expiresAt - this.#now() > REMINT_BEFORE_MS) return;\n    await this.ensureAccess(session);\n  }\n\n  /** Agent, secrets, narrow grants and a fresh token. Serialised per session; warm calls only check the expiry. */\n  ensureAccess(session: SessionRow): Promise<Access> {\n    const running = this.#inFlight.get(session.id);\n    if (running !== undefined) return running;\n    const work = this.#ensure(session).finally(() => this.#inFlight.delete(session.id));\n    this.#inFlight.set(session.id, work);\n    return work;\n  }\n\n  async #ensure(session: SessionRow): Promise<Access> {\n    const { onecli } = this.#deps;\n    if (session.repo === null) throw new Error(\"not a repo session\");\n    if (onecli === undefined) {\n      throw new RepoUnavailableError(\n        \"repository workspaces are not configured: ONECLI_API_KEY is not set\",\n      );\n    }\n    const warm = this.#access.get(session.id);\n    if (warm !== undefined && warm.expiresAt - this.#now() > REMINT_BEFORE_MS) return warm;\n\n    const minted = await this.#mint(session.repo.repo);\n    const gitValue = Buffer.from(`x-access-token:${minted.token.reveal()}`).toString(\"base64\");\n    const valueOf = (suffix: string): string =>\n      suffix === \"git\" ? gitValue : minted.token.reveal();\n\n    const identifier = agentIdentifier(session.id);\n    const findAgent = async () =>\n      (await onecli.listAgents()).find((a) => a.identifier === identifier);\n    let found = await findAgent();\n    const created = found === undefined;\n    if (found === undefined) {\n      await onecli.createAgent(identifier, identifier);\n      found = await findAgent();\n    }\n    if (found === undefined) throw new Error(\"OneCLI created the agent but does not list it\");\n    const agent = found;\n    const existing = new Map((await onecli.listSecrets()).map((s) => [s.name, s.id]));\n    const secretIds: string[] = [];\n    for (const spec of SECRET_SUFFIXES) {\n      const name = secretName(session.id, spec.suffix);\n      let id = existing.get(name);\n      if (id === undefined) {\n        id = await onecli.createSecret({\n          name,\n          value: valueOf(spec.suffix),\n          hostPattern: spec.host,\n          header: spec.header,\n          valueFormat: spec.format,\n        });\n      } else {\n        await onecli.updateSecretValue(id, valueOf(spec.suffix));\n      }\n      secretIds.push(id);\n    }\n\npackages/orchestrator/test/sweep.test.ts:30:    maxActions: 100,\npackages/orchestrator/test/sweep.test.ts:200:  it(\"stops at maxActions and puts claims before PVCs before agents\", () => {\npackages/orchestrator/test/sweep.test.ts:208:      maxActions: 2,\npackages/orchestrator/test/sweep.test.ts:213:  it(\"does nothing when there is nothing to do, and when maxActions is 0\", () => {\npackages/orchestrator/test/sweep.test.ts:218:        maxActions: 0,\npackages/orchestrator/test/sweeper.test.ts:34:    maxActions: 10,\npackages/orchestrator/test/sweeper.test.ts:44:    const done = await new OrphanSweeper(value).run();\npackages/orchestrator/test/sweeper.test.ts:61:    const done = await new OrphanSweeper(value).run();\npackages/orchestrator/test/sweeper.test.ts:68:    await new OrphanSweeper(without.value).run();\npackages/orchestrator/test/sweeper.test.ts:72:    expect(await new OrphanSweeper(broken.value).run()).toEqual([]);\npackages/orchestrator/test/sweeper.test.ts:85:    const sweeper = new OrphanSweeper(value);\n","isError":false}]}
ENTRY 11827 {"id":11827,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n\n### 1. Inconsistent snapshots can revoke a live session’s credentials\n- Severity: high\n- Confidence: high\n- Location: packages/orchestrator/src/sweeper.ts:54\n- What happens: The session list can be read before a new session is created, while the OneCLI list is read after that session provisions its agent. The planner then sees the agent as belonging to an unknown session and revokes its credentials, disrupting the live session. OneCLI agents have no creation-time grace check in the production caller.\n- Evidence: `Promise.all([d.listSessions(), ... d.listOneCli?.()])`\n- Fix idea: Recheck the session’s current status immediately before revoking its OneCLI objects. Coordinate that check with session creation if necessary to prevent a new owner appearing between the check and revocation.\n\n### 2. Repeatedly failing actions can starve later orphans\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/sweeper.ts:68\n- What happens: If the first `maxActions` planned actions repeatedly fail—for example, because their claims cannot be deleted—each run selects those same actions again. Later PVCs and agents are never reached, so orphaned resources and usable tokens can remain indefinitely.\n- Evidence: `maxActions: d.maxActions` followed by a loop that logs failures without changing future selection.\n- Fix idea: Rotate or back off failed actions across runs so other candidates get a chance, while retaining the per-run action limit.\n\n### 3. OneCLI listing failure blocks unrelated Kubernetes cleanup\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/sweeper.ts:54\n- What happens: If OneCLI is unavailable or either of its list requests fails, `Promise.all` rejects and the sweep performs no claim or PVC cleanup, even when Kubernetes and the session database are healthy. A prolonged OneCLI outage therefore leaves orphaned sandboxes and storage running.\n- Evidence: `d.listOneCli?.()` is included in the same `Promise.all` as the Kubernetes and session lists.\n- Fix idea: Handle OneCLI listing failure separately and run the Kubernetes portion with agents undefined; log the OneCLI failure and retry it on the next run.\n\nEND-OF-REPORT"}]}
DONE
