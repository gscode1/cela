ENTRY 11726 {"id":11726,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/orchestrator/src/onecli-admin.ts:6: * provision and revoke per-session agents. Paths and bodies come from `docs/research/onecli-spike.md` and\npackages/orchestrator/src/main.ts:7:  listSessionRefs,\npackages/orchestrator/src/main.ts:141:    listSessions: () => listSessionRefs(pool),\npackages/orchestrator/src/repo-access.ts:81:  /** The `shellEnv` of a repo session's env, provisioning OneCLI first if needed. Undefined for a plain session. */\npackages/orchestrator/src/repo-access.ts:221:   * Before the first turn of a repo session: provision, then clone through the session's env. Returns quickly once\n","isError":false}]}
ENTRY 11727 {"id":11727,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"    });\n    await markWorkspaceReady(this.#deps.pool, session.id);\n    this.#prepared.add(session.id);\n    // `workspace-cloned` once per session; `workspace-present` after a restart. tests/e2e/run-phase4c.sh greps both.\n    log(outcome === \"cloned\" ? \"workspace-cloned\" : \"workspace-present\", {\n      session: session.id,\n      repo: spec.repo,\n    });\n  }\n\n  /**\n   * Revokes everything the session held in OneCLI: the agent first (its token fails at once), then the secrets.\n   * Looks objects up by name as well as by stored id, so a crash between creating an object and storing its id\n   * cannot leave one behind. Idempotent. A plain session has nothing and makes no OneCLI call.\n   */\n  async teardown(session: SessionRow): Promise<void> {\n    if (session.repo === null) return;\n    const { onecli } = this.#deps;\n    this.#forget(session.id);\n    if (onecli === undefined) {\n      if (session.onecli === null) return;\n      throw new Error(\"cannot revoke the session's OneCLI agent: ONECLI_API_KEY is not set\");\n    }\n    await this.#revoke(session.id, session.onecli?.agentId, session.onecli?.secretIds ?? []);\n    log(\"repo-access-revoked\", { session: session.id });\n  }\n\n  /**\n   * The orphan sweep's revoke: removes whatever OneCLI still holds under this session's names (agent first, then the\n   * secrets), with no session row needed. Nothing is stored for a session that is deleted or unknown.\n   */\n  async revokeSession(sessionId: string): Promise<void> {\n    this.#forget(sessionId);\n    await this.#revoke(sessionId, undefined, []);\n  }\n\n  async #revoke(\n    sessionId: string,\n    agentId: string | undefined,\n    secretIds: readonly string[],\n  ): Promise<void> {\n    const { onecli } = this.#deps;\n    if (onecli === undefined) return;\n    const agents = (await onecli.listAgents())\n      .filter((a) => a.identifier === agentIdentifier(sessionId))\n      .map((a) => a.id);\n    for (const id of new Set([...(agentId === undefined ? [] : [agentId]), ...agents])) {\n      await onecli.deleteAgent(id);\n    }\n    const names = new Set(SECRET_SUFFIXES.map((s) => secretName(sessionId, s.suffix)));\n    const named = (await onecli.listSecrets()).filter((s) => names.has(s.name)).map((s) => s.id);\n    for (const id of new Set([...secretIds, ...named])) {\n      try {\n        await onecli.deleteSecret(id);\n      } catch (error) {\n        if (!(error instanceof OneCliError && error.status === 404)) throw error;\n      }\n    }\n  }\n\n  #forget(sessionId: string): void {\n    this.#access.delete(sessionId);\n    this.#prepared.delete(sessionId);\n    for (const [conversationId, session] of this.#byConversation) {\n      if (session.id === sessionId) this.#byConversation.delete(conversationId);\n    }\n  }\n}\n    await ensureLabeledClaim(namespace, claimName, warmPool, sessionKey, env);\n  }\n}\n\nconst sleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));\n\n/**\n * Deletes a session's SandboxClaim, then its workspace PVC, and waits until both are gone. The claim goes\n * first: its Sandbox owns the Pod, and a PVC that a Pod still mounts only finishes deleting after the Pod.\n * Both calls ignore \"not found\", so this is safe to repeat. Needs `delete` on sandboxclaims and\n * persistentvolumeclaims in the namespace (and the `get` on claims the orchestrator has anyway).\n */\nexport async function deleteClaimAndPvc(\n  namespace: string,\n  claimName: string,\n  sessionKey: string,\n  timeoutMs = 180_000,\n): Promise<void> {\n  const kc = new KubeConfig();\n  kc.loadFromDefault();\n  const custom = kc.makeApiClient(CustomObjectsApi);\n  const core = kc.makeApiClient(CoreV1Api);\n  const claim = {\n    group: \"extensions.agents.x-k8s.io\",\n    version: \"v1beta1\",\n    namespace,\n    plural: \"sandboxclaims\",\n    name: claimName,\n  };\n  // The Sandbox controller names the PVC after the volume claim template and the Sandbox (`workspace-<claim>`).\n  const pvc = { name: `workspace-${claimName}`, namespace };\n\n  // Never delete a claim that is not this session's (`get` is already granted for the SDK).\n  try {\n    const found: unknown = await custom.getNamespacedCustomObject(claim);\n    if (labelOf(found) !== sessionKey) {\n      throw new Error(\n        `SandboxClaim ${claimName} is not labelled for this session: not deleting it`,\n      );\n    }\n  } catch (error) {\n    if (statusOf(error) !== 404) throw error;\n  }\n  // Only `delete` is needed: a delete that answers 404 means the object is gone. The PVC is deleted only once\n  // the claim is gone, so the Sandbox controller cannot recreate it from a Sandbox that still exists.\n  const deadline = Date.now() + timeoutMs;\n  for (;;) {\n    const claimPresent = await ignoreNotFound(custom.deleteNamespacedCustomObject(claim));\n    const pvcPresent = claimPresent\n      ? true\n      : await ignoreNotFound(core.deleteNamespacedPersistentVolumeClaim(pvc));\n    if (!claimPresent && !pvcPresent) return;\n    if (Date.now() > deadline) {\n      throw new Error(\n        `timed out deleting ${claimName}: claim ${claimPresent ? \"present\" : \"gone\"}, pvc ${pvcPresent ? \"present\" : \"gone\"}`,\n      );\n    }\n    await sleep(2_000);\n  }\n}\n\nfunction clients(): { custom: CustomObjectsApi; core: CoreV1Api } {\n  const kc = new KubeConfig();\n  kc.loadFromDefault();\n  return { custom: kc.makeApiClient(CustomObjectsApi), core: kc.makeApiClient(CoreV1Api) };\n}\n\nconst SANDBOX_REF = { group: \"agents.x-k8s.io\", version: \"v1beta1\", plural: \"sandboxes\" };\n\n/** A SandboxClaim as the orphan sweep sees it. `sessionLabel` is undefined for a claim we never labelled. */\nexport interface ClaimInfo {\n  name: string;\n  sessionLabel: string | undefined;\n  createdAt: Date;\n}\n\n/** Every SandboxClaim in the namespace, labelled or not: the sweep must know a claim exists to leave its PVC alone. */\nexport async function listClaims(namespace: string): Promise<ClaimInfo[]> {\n  const { custom } = clients();\n  const list = (await custom.listNamespacedCustomObject({ ...CLAIM_REF, namespace })) as {\n    items?: { metadata?: { name?: string; creationTimestamp?: string } }[];\n  };\n  return (list.items ?? []).flatMap((item) => {\n    const name = item.metadata?.name;\n    const created = item.metadata?.creationTimestamp;\n    if (name === undefined || created === undefined) return [];\n    return [{ name, sessionLabel: labelOf(item), createdAt: new Date(created) }];\n  });\n}\n\nexport interface PvcInfo {\n  name: string;\n  createdAt: Date;\n}\n\nexport async function listPvcs(namespace: string): Promise<PvcInfo[]> {\n  const { core } = clients();\n  const list = await core.listNamespacedPersistentVolumeClaim({ namespace });\n  return list.items.flatMap((item) => {\n    const name = item.metadata?.name;\n    const created = item.metadata?.creationTimestamp;\n  }\n\n  /**\n   * Session deletion: stops the bridge, then deletes the SandboxClaim and the PVC. Idempotent, so a deletion cut\n   * off by a crash is simply run again. With `destroyOrphan` the only place that deletes a claim.\n   */\n  async destroy(conversationId: number): Promise<void> {\n    await this.#teardown(conversationId, await this.#sessionKeyOf(conversationId));\n  }\n\n  /**\n   * The orphan sweep's delete: the same teardown as a session deletion, for a claim whose session is deleted or\n   * unknown. `sessionLabel` is the label the sweep read from the claim, so `deleteClaimAndPvc` still refuses a\n   * claim that changed hands meanwhile.\n   */\n  async destroyOrphan(claimName: string, sessionLabel: string): Promise<void> {\n    const conversationId = conversationOfName(claimName);\n    if (conversationId === undefined) throw new Error(`${claimName} is not a conversation claim`);\n    await this.#teardown(conversationId, sessionLabel);\n  }\n\n  async #teardown(conversationId: number, sessionKey: string): Promise<void> {\n    await this.#replacing.get(conversationId);\n    this.#interrupted.delete(conversationId);\n    this.#failed.delete(conversationId);\n    this.#lastUsed.delete(conversationId);\n    const opened = this.#envs.get(conversationId);\n    this.#usage.delete(conversationId);\n    this.#envs.delete(conversationId);\n    if (opened !== undefined) {\n      const env = await opened.catch(() => undefined);\n      env?.close();\n    }\n    const claimName = claimNameFor(conversationId);\n    await deleteClaimAndPvc(this.#config.namespace, claimName, sessionKey);\n    log(\"sandbox-deleted\", { claim: claimName });\n  }\n\n  /** Stops every bridge. Never deletes a claim. */\n  async closeAll(): Promise<void> {\n    this.stop();\n    const opened = await Promise.allSettled([...this.#envs.values()]);\n    for (const result of opened) if (result.status === \"fulfilled\") result.value.close();\n    this.#envs.clear();\n  }\n}\n","isError":false}]}
