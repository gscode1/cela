ENTRY 11465 {"id":11465,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport {\n     2\t  applyMigrations,\n     3\t  conversationsWithExecInFlight,\n     4\t  createPool,\n     5\t  errorMessage,\n     6\t  getSession,\n     7\t  listSessionRefs,\n     8\t  setExecInFlight,\n     9\t  tokenAuthenticator,\n    10\t} from \"@pi-durable-k8s/session-core\";\n    11\timport { loadConfig } from \"./config.js\";\n    12\timport type { FetchLike } from \"./github-app.js\";\n    13\timport { OneCliAdmin } from \"./onecli-admin.js\";\n    14\timport { RepoAccess } from \"./repo-access.js\";\n    15\timport type { SandboxHooks } from \"./sandboxes.js\";\n    16\timport { Host } from \"./host.js\";\n    17\timport { createOrchestratorServer } from \"./http.js\";\n    18\timport type { Lifecycle } from \"./http.js\";\n    19\timport { InboxLoop } from \"./inbox.js\";\n    20\timport { listClaims, listPvcs } from \"./kube.js\";\n    21\timport { log } from \"./log.js\";\n    22\timport { SessionService } from \"./sessions.js\";\n    23\timport { openStorageWhenFree } from \"./storage.js\";\n    24\timport { OrphanSweeper } from \"./sweeper.js\";\n    25\t\n    26\tasync function main(): Promise<void> {\n    27\t  const config = loadConfig(process.env);\n    28\t  const lifecycle: Lifecycle = { state: \"waiting-for-lock\", instance: config.instance };\n    29\t  // A second, independent connection pool for the inbox and the owner check: the Pi Durable adapter pins its\n    30\t  // own connection and holds the ownership lock on it, and neither may share it.\n    31\t  const pool = createPool(config.databaseUrl, `${config.instance}-inbox`, 10);\n    32\t  const server = createOrchestratorServer({\n    33\t    lifecycle,\n    34\t    authenticate: tokenAuthenticator(config.apiTokens),\n    35\t    pool,\n    36\t    control: config.control,\n    37\t  });\n    38\t  await new Promise<void>((resolve) => server.listen(config.port, resolve));\n    39\t  log(\"listening\", { instance: config.instance, port: config.port });\n    40\t\n    41\t  const running: { inbox?: InboxLoop; service?: SessionService; sweeper?: OrphanSweeper } = {};\n    42\t  const stop = new AbortController();\n    43\t  const shutdown = (signal: string): void => {\n    44\t    log(\"shutdown\", { signal });\n    45\t    stop.abort();\n    46\t    server.close();\n    47\t    void (async () => {\n    48\t      running.service?.stop();\n    49\t      running.sweeper?.stop();\n    50\t      await running.inbox?.stop();\n    51\t      await lifecycle.host?.close();\n    52\t      server.closeAllConnections();\n    53\t      await pool.end().catch(() => undefined);\n    54\t    })().finally(() => process.exit(0));\n    55\t    setTimeout(() => process.exit(0), 10_000).unref();\n    56\t  };\n    57\t  process.on(\"SIGTERM\", () => shutdown(\"SIGTERM\"));\n    58\t  process.on(\"SIGINT\", () => shutdown(\"SIGINT\"));\n    59\t\n    60\t  for (;;) {\n    61\t    try {\n    62\t      await applyMigrations(pool);\n    63\t      break;\n    64\t    } catch (error) {\n    65\t      log(\"migrate-failed\", { message: errorMessage(error) });\n    66\t      await new Promise((resolve) => setTimeout(resolve, 2_000));\n    67\t    }\n    68\t  }\n    69\t\n    70\t  const storage = await openStorageWhenFree(config, stop.signal);\n    71\t  log(\"lock-acquired\", { instance: config.instance });\n    72\t  const sessionKeyOf = async (conversationId: number): Promise<string> => {\n    73\t    const { rows } = await pool.query<{ id: string }>(\n    74\t      \"select id from inbox.sessions where conversation_id = $1\",\n    75\t      [conversationId],\n    76\t    );\n    77\t    // Conversations the inbox does not know are the test-only /control sessions.\n    78\t    return rows[0]?.id ?? `control-${String(conversationId)}`;\n    79\t  };\n    80\t  // Repo workspaces (Phase 4c). Plain sessions never touch OneCLI's management API or GitHub through this.\n    81\t  const callApi: FetchLike = (url, init) => fetch(url, init);\n    82\t  const onecli =\n    83\t    config.repos.onecliApiKey === undefined\n    84\t      ? undefined\n    85\t      : new OneCliAdmin(config.repos.onecliApi, config.repos.onecliApiKey, callApi);\n    86\t  const repos = new RepoAccess({\n    87\t    pool,\n    88\t    onecli,\n    89\t    githubAppDir: config.repos.githubAppDir,\n    90\t    gateway: config.onecli.gateway,\n    91\t    caFile: config.onecli.caFile,\n    92\t    fetch: callApi,\n    93\t  });\n    94\t  const hooks: SandboxHooks = {\n    95\t    shellEnv: async (conversationId) => {\n    96\t      const { rows } = await pool.query<{ id: string }>(\n    97\t        \"select id from inbox.sessions where conversation_id = $1\",\n    98\t        [conversationId],\n    99\t      );\n   100\t      const session = rows[0] === undefined ? undefined : await getSession(pool, rows[0].id);\n   101\t      return session === undefined ? undefined : repos.shellEnv(session, conversationId);\n   102\t    },\n   103\t    beforeUse: (conversationId) => repos.beforeUse(conversationId),\n   104\t    execInFlight: (conversationId, inFlight) => setExecInFlight(pool, conversationId, inFlight),\n   105\t  };\n   106\t  // Sandboxes that had a command running when the previous process died: Host.open recycles their Pods before Pi\n   107\t  // Durable resumes (docs/decisions/0003-recycle-pod-on-interrupt.md).\n   108\t  const recycleAtStart = await conversationsWithExecInFlight(pool);\n   109\t  if (recycleAtStart.length > 0) log(\"recycle-at-start\", { conversations: recycleAtStart });\n   110\t  const host = await Host.open(\n   111\t    storage,\n   112\t    config,\n   113\t    (error) => {\n   114\t      // Fail closed: a Harness that lost its storage stops here. Nothing reconnects and nothing more is\n   115\t      // written; the Deployment starts a fresh process, which waits for the lock like any other owner.\n   116\t      log(\"fail-closed\", { instance: config.instance, message: errorMessage(error) });\n   117\t      process.exit(1);\n   118\t    },\n   119\t    sessionKeyOf,\n   120\t    hooks,\n   121\t    recycleAtStart,\n   122\t  );\n   123\t  const service = new SessionService(pool, host, {\n   124\t    testFaults: config.testFaults,\n   125\t    defaultModel: config.models.default,\n   126\t    turnBudget: config.turnBudget,\n   127\t    repos,\n   128\t  });\n   129\t  running.service = service;\n   130\t  // Not fatal: a failed scan only means a run that died unseen is noticed at its next input.\n   131\t  await service.recoverWatches().catch((error: unknown) => {\n   132\t    log(\"run-watch-recover-failed\", { message: errorMessage(error) });\n   133\t  });\n   134\t  lifecycle.host = host;\n   135\t  lifecycle.service = service;\n   136\t  lifecycle.state = \"owner\";\n   137\t  log(\"owner\", { instance: config.instance });\n   138\t\n   139\t  // Orphan sweep (docs/decisions/0002-orphan-sweep.md): only the owner runs it, like the inbox.\n   140\t  const sweeper = new OrphanSweeper({\n   141\t    listSessions: () => listSessionRefs(pool),\n   142\t    listClaims: () => listClaims(config.namespace),\n   143\t    listPvcs: () => listPvcs(config.namespace),\n   144\t    listOneCli:\n   145\t      onecli === undefined\n   146\t        ? undefined\n   147\t        : async () => ({\n   148\t            agents: (await onecli.listAgents()).map(({ id, identifier }) => ({ id, identifier })),\n   149\t            secrets: await onecli.listSecrets(),\n   150\t          }),\n   151\t    destroyClaim: (claim, label) => host.destroyOrphanSandbox(claim, label),\n   152\t    revokeSession: (sessionId) => repos.revokeSession(sessionId),\n   153\t    graceMs: config.sweep.graceMs,\n   154\t    maxActions: config.sweep.maxActions,\n   155\t  });\n   156\t  running.sweeper = sweeper;\n   157\t  sweeper.start(config.sweep.intervalMs);\n   158\t\n   159\t  // Only the owner consumes the inbox. Rows that arrived while no orchestrator ran are waiting.\n   160\t  const inbox = new InboxLoop(pool, (event, session) => service.apply(event, session));\n   161\t  running.inbox = inbox;\n   162\t  inbox.start();\n   163\t}\n   164\t\n   165\tmain().catch((error: unknown) => {\n   166\t  log(\"fatal\", { message: errorMessage(error) });\n   167\t  process.exit(1);\n   168\t});\n","isError":false}]}
ENTRY 11494 {"id":11494,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && cat -n packages/orchestrator/src/sweeper.ts && cat -n packages/orchestrator/src/storage.ts && cat -n packages/orchestrator/src/host.ts\",\"timeout\":10000})"]}]}
ENTRY 11502 {"id":11502,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport type { SessionRef } from \"@pi-durable-k8s/session-core\";\n     2\timport { errorMessage, log } from \"./log.js\";\n     3\timport { planSweep } from \"./sweep.js\";\n     4\timport type { SweepAction, SweepAgent, SweepClaim, SweepPvc, SweepSecret } from \"./sweep.js\";\n     5\t\n     6\texport interface SweeperDeps {\n     7\t  listSessions: () => Promise<SessionRef[]>;\n     8\t  listClaims: () => Promise<SweepClaim[]>;\n     9\t  listPvcs: () => Promise<SweepPvc[]>;\n    10\t  /** Undefined when OneCLI is not configured: the sweep then leaves agents alone. */\n    11\t  listOneCli: (() => Promise<{ agents: SweepAgent[]; secrets: SweepSecret[] }>) | undefined;\n    12\t  /** The session deletion's teardown: stops the bridge, deletes the claim, then the PVC. Also removes a lone PVC. */\n    13\t  destroyClaim: (claimName: string, sessionLabel: string) => Promise<void>;\n    14\t  revokeSession: (sessionId: string) => Promise<void>;\n    15\t  graceMs: number;\n    16\t  maxActions: number;\n    17\t  now?: () => number;\n    18\t}\n    19\t\n    20\t/**\n    21\t * The execution half of the orphan sweep: reads the world, asks `planSweep` what is orphaned, does it, logs each\n    22\t * action. One run at a time. A failing action is logged and the run goes on; the next run retries it. The log lines\n    23\t * carry names and ids only, never a token or secret value.\n    24\t */\n    25\texport class OrphanSweeper {\n    26\t  readonly #deps: SweeperDeps;\n    27\t  #running = false;\n    28\t  #timer: NodeJS.Timeout | undefined;\n    29\t\n    30\t  constructor(deps: SweeperDeps) {\n    31\t    this.#deps = deps;\n    32\t  }\n    33\t\n    34\t  start(intervalMs: number): void {\n    35\t    if (intervalMs <= 0) {\n    36\t      log(\"sweep-disabled\", {});\n    37\t      return;\n    38\t    }\n    39\t    this.#timer = setInterval(() => void this.run(), intervalMs);\n    40\t    this.#timer.unref();\n    41\t  }\n    42\t\n    43\t  stop(): void {\n    44\t    if (this.#timer !== undefined) clearInterval(this.#timer);\n    45\t  }\n    46\t\n    47\t  /** One sweep. Returns the actions that succeeded; never throws. */\n    48\t  async run(): Promise<SweepAction[]> {\n    49\t    if (this.#running) return [];\n    50\t    this.#running = true;\n    51\t    const done: SweepAction[] = [];\n    52\t    try {\n    53\t      const d = this.#deps;\n    54\t      const [sessions, claims, pvcs, oneCli] = await Promise.all([\n    55\t        d.listSessions(),\n    56\t        d.listClaims(),\n    57\t        d.listPvcs(),\n    58\t        d.listOneCli?.(),\n    59\t      ]);\n    60\t      const actions = planSweep({\n    61\t        sessions,\n    62\t        claims,\n    63\t        pvcs,\n    64\t        agents: oneCli?.agents,\n    65\t        secrets: oneCli?.secrets ?? [],\n    66\t        now: d.now?.() ?? Date.now(),\n    67\t        graceMs: d.graceMs,\n    68\t        maxActions: d.maxActions,\n    69\t      });\n    70\t      for (const action of actions) {\n    71\t        try {\n    72\t          await this.#apply(action);\n    73\t          log(\"sweep-action\", { ...action });\n    74\t          done.push(action);\n    75\t        } catch (error) {\n    76\t          log(\"sweep-action-failed\", { ...action, message: errorMessage(error) });\n    77\t        }\n    78\t      }\n    79\t      if (actions.length > 0) log(\"sweep-done\", { planned: actions.length, done: done.length });\n    80\t    } catch (error) {\n    81\t      log(\"sweep-failed\", { message: errorMessage(error) });\n    82\t    } finally {\n    83\t      this.#running = false;\n    84\t    }\n    85\t    return done;\n    86\t  }\n    87\t\n    88\t  async #apply(action: SweepAction): Promise<void> {\n    89\t    switch (action.kind) {\n    90\t      case \"delete-claim\":\n    91\t        return this.#deps.destroyClaim(action.claim, action.sessionLabel);\n    92\t      case \"delete-pvc\":\n    93\t        // The claim does not exist, so there is no label to check; deleteClaimAndPvc refuses if one appears meanwhile.\n    94\t        return this.#deps.destroyClaim(action.claim, \"orphan-pvc-sweep\");\n    95\t      case \"revoke-agent\":\n    96\t        return this.#deps.revokeSession(action.sessionId);\n    97\t    }\n    98\t  }\n    99\t}\n     1\timport type { Storage } from \"@earendil-works/pi-durable\";\n     2\timport { openNodePostgresStorage } from \"@netzlabor/pi-durable-postgres\";\n     3\timport type { OrchestratorConfig } from \"./config.js\";\n     4\timport { errorMessage, log } from \"./log.js\";\n     5\t\n     6\t/**\n     7\t * Connection settings against silent drops: TCP keepalive notices a dead peer in about a minute, and\n     8\t * the statement timeout turns a hung query into a failure (which fails the Harness closed) instead of\n     9\t * a hang. The adapter pins one connection, so `max: 1` is all it can use.\n    10\t */\n    11\texport function poolConfig(config: OrchestratorConfig): Record<string, unknown> {\n    12\t  return {\n    13\t    connectionString: config.databaseUrl,\n    14\t    options: `-c search_path=${config.schema}`,\n    15\t    application_name: config.instance,\n    16\t    max: 1,\n    17\t    connectionTimeoutMillis: 5_000,\n    18\t    keepAlive: true,\n    19\t    keepAliveInitialDelayMillis: 10_000,\n    20\t    statement_timeout: 30_000,\n    21\t    query_timeout: 35_000,\n    22\t  };\n    23\t}\n    24\t\n    25\tconst LOCK_HELD = /only one owner is supported|in use/;\n    26\t\n    27\t/**\n    28\t * Opens the storage, and waits while another orchestrator owns the schema. The adapter refuses a\n    29\t * second owner immediately instead of blocking, so \"blocking on the lock\" is this retry loop. Other\n    30\t * failures (database not reachable yet) are retried the same way; secrets are never in these messages.\n    31\t */\n    32\texport async function openStorageWhenFree(\n    33\t  config: OrchestratorConfig,\n    34\t  signal: AbortSignal,\n    35\t  retryMs = 2_000,\n    36\t): Promise<Storage> {\n    37\t  let waitingLogged = false;\n    38\t  for (;;) {\n    39\t    signal.throwIfAborted();\n    40\t    try {\n    41\t      return await openNodePostgresStorage({ config: poolConfig(config) });\n    42\t    } catch (error) {\n    43\t      const message = errorMessage(error);\n    44\t      if (LOCK_HELD.test(message)) {\n    45\t        if (!waitingLogged) log(\"waiting-for-lock\", { instance: config.instance });\n    46\t        waitingLogged = true;\n    47\t      } else {\n    48\t        log(\"storage-open-failed\", { instance: config.instance, message });\n    49\t      }\n    50\t      await new Promise((resolve) => setTimeout(resolve, retryMs));\n    51\t    }\n    52\t  }\n    53\t}\n     1\timport { BACKGROUND_CONTEXT as context } from \"@earendil-works/chord/context\";\n     2\timport type { Message } from \"@earendil-works/pi-ai\";\n     3\timport { createRegistry, Harness } from \"@earendil-works/pi-durable\";\n     4\timport type {\n     5\t  Conversation,\n     6\t  ConversationId,\n     7\t  ConversationWatch,\n     8\t  ConversationWindow,\n     9\t  Cursor,\n    10\t  Storage,\n    11\t} from \"@earendil-works/pi-durable\";\n    12\timport type { ModelChoice } from \"@pi-durable-k8s/session-core\";\n    13\timport { createCodingTools } from \"@earendil-works/pi-durable/tools\";\n    14\timport type { OrchestratorConfig } from \"./config.js\";\n    15\timport { errorMessage, log } from \"./log.js\";\n    16\timport type { Script } from \"./model.js\";\n    17\timport { buildModels } from \"./providers.js\";\n    18\timport { claimNameFor, Sandboxes, WORKSPACE } from \"./sandboxes.js\";\n    19\timport type { SandboxHooks, SessionKeyOf } from \"./sandboxes.js\";\n    20\timport type { SubmissionState } from \"./watcher.js\";\n    21\timport type { WorkspaceEnv } from \"./workspace.js\";\n    22\t\n    23\texport interface SessionEvent {\n    24\t  role: Message[\"role\"];\n    25\t  /** Assistant text, tool output, or the user's script. */\n    26\t  text: string;\n    27\t  /** Tool calls the assistant made, as `name(args)`. */\n    28\t  calls?: string[];\n    29\t  /** Tool results only. */\n    30\t  isError?: boolean;\n    31\t}\n    32\t\n    33\texport interface SessionStatus {\n    34\t  id: number;\n    35\t  claim: string;\n    36\t  state: \"running\" | \"done\";\n    37\t  events: number;\n    38\t  /** Text of every tool result so far, in order. */\n    39\t  results: { text: string; isError: boolean }[];\n    40\t  answer?: string;\n    41\t}\n    42\t\n    43\tfunction contentText(content: Message[\"content\"]): string {\n    44\t  if (typeof content === \"string\") return content;\n    45\t  return content\n    46\t    .map((block) => {\n    47\t      if (block.type === \"text\") return block.text;\n    48\t      return block.type === \"toolCall\" ? \"\" : `[${block.type}]`;\n    49\t    })\n    50\t    .join(\"\");\n    51\t}\n    52\t\n    53\texport function toEvent(message: Message): SessionEvent {\n    54\t  const event: SessionEvent = { role: message.role, text: contentText(message.content) };\n    55\t  if (message.role === \"assistant\") {\n    56\t    const calls = message.content.flatMap((block) =>\n    57\t      block.type === \"toolCall\" ? [`${block.name}(${JSON.stringify(block.arguments)})`] : [],\n    58\t    );\n    59\t    if (calls.length > 0) event.calls = calls;\n    60\t  }\n    61\t  if (message.role === \"toolResult\") event.isError = message.isError;\n    62\t  return event;\n    63\t}\n    64\t\n    65\t/** The Pi Durable host: one Harness over the Postgres storage, one conversation per session. */\n    66\texport class Host {\n    67\t  readonly #harness: Harness;\n    68\t  readonly #sandboxes: Sandboxes;\n    69\t  readonly #storage: Storage;\n    70\t\n    71\t  private constructor(harness: Harness, sandboxes: Sandboxes, storage: Storage) {\n    72\t    this.#harness = harness;\n    73\t    this.#sandboxes = sandboxes;\n    74\t    this.#storage = storage;\n    75\t  }\n    76\t\n    77\t  /**\n    78\t   * Opens the Harness over an owned storage and resumes whatever the last process left running.\n    79\t   * `onFailed` fires when the Harness ends on a storage error, e.g. the database connection died.\n    80\t   */\n    81\t  static async open(\n    82\t    storage: Storage,\n    83\t    config: OrchestratorConfig,\n    84\t    onFailed: (error: unknown) => void,\n    85\t    sessionKeyOf: SessionKeyOf,\n    86\t    hooks: SandboxHooks = {},\n    87\t    recycleAtStart: readonly number[] = [],\n    88\t  ): Promise<Host> {\n    89\t    const models = await buildModels(config);\n    90\t    const registry = createRegistry();\n    91\t    registry.install(createCodingTools());\n    92\t    const sandboxes = new Sandboxes(config, sessionKeyOf, hooks);\n    93\t    // Before resume(): a continuing run must not run its next command in a Pod that still holds the leftovers of\n    94\t    // the command the previous process was killed in.\n    95\t    sandboxes.recycleAtStart(recycleAtStart);\n    96\t\n    97\t    const harness = await Harness.open(\n    98\t      storage,\n    99\t      {\n   100\t        models,\n   101\t        registry,\n   102\t        // Lazy: the SandboxClaim is created at the first tool call, not at the first model request.\n   103\t        env: ({ conversationId }) => Promise.resolve(sandboxes.lazyEnv(Number(conversationId))),\n   104\t        onReport: (report) => {\n   105\t          log(\"report\", { kind: report.kind, message: errorMessage(report.error) });\n   106\t        },\n   107\t      },\n   108\t      context,\n   109\t    );\n   110\t    void harness.closed.then((end) => {\n   111\t      if (end.kind === \"failed\") onFailed(end.error);\n   112\t    });\n   113\t    // No new input needed: open recovers nothing by itself, resume() continues unfinished runs.\n   114\t    harness.resume();\n   115\t    return new Host(harness, sandboxes, storage);\n   116\t  }\n   117\t\n   118\t  /** Creates the conversation and its sandbox claim, then submits the script as the first input. */\n   119\t  async startSession(script: Script): Promise<{ id: number; claim: string }> {\n   120\t    const conversation = await this.#harness.createConversation(\n   121\t      {\n   122\t        ownership: { kind: \"ownerless\" },\n   123\t        agent: { model: { provider: \"faux\", modelId: \"faux-1\" }, cwd: WORKSPACE },\n   124\t      },\n   125\t      context,\n   126\t    );\n   127\t    const id = Number(conversation.id);\n   128\t    await this.#sandboxes.ensure(id);\n   129\t    await conversation.submit(\n   130\t      { type: \"input\", content: JSON.stringify(script), requestId: `start-${String(id)}` },\n   131\t      context,\n   132\t    );\n   133\t    log(\"session-started\", { id, claim: claimNameFor(id) });\n   134\t    return { id, claim: claimNameFor(id) };\n   135\t  }\n   136\t\n   137\t  /** A further input to an existing session; the model follows the newest script. False if unknown. */\n   138\t  async sendInput(id: number, script: Script): Promise<boolean> {\n   139\t    const conversation = await this.#harness.conversation(id as ConversationId, context);\n   140\t    if (conversation === undefined) return false;\n   141\t    await conversation.submit({ type: \"input\", content: JSON.stringify(script) }, context);\n   142\t    return true;\n   143\t  }\n   144\t\n   145\t  async events(id: number): Promise<SessionEvent[] | undefined> {\n   146\t    const conversation = await this.#harness.conversation(id as ConversationId, context);\n   147\t    if (conversation === undefined) return undefined;\n   148\t    const view = await conversation.context(context);\n   149\t    // Stored entries, not view.messages: the view adds a placeholder result for a call still running.\n   150\t    return view.entries.flatMap((entry) => entry.model ?? []).map(toEvent);\n   151\t  }\n   152\t\n   153\t  async status(id: number): Promise<SessionStatus | undefined> {\n   154\t    const events = await this.events(id);\n   155\t    if (events === undefined) return undefined;\n   156\t    const last = events.at(-1);\n   157\t    const results = events\n   158\t      .filter((e) => e.role === \"toolResult\")\n   159\t      .map((e) => ({ text: e.text, isError: e.isError === true }));\n   160\t    const answered = last?.role === \"assistant\" && last.calls === undefined;\n   161\t    return {\n   162\t      id,\n   163\t      claim: claimNameFor(id),\n   164\t      state: answered ? \"done\" : \"running\",\n   165\t      events: events.length,\n   166\t      results,\n   167\t      ...(answered ? { answer: last.text } : {}),\n   168\t    };\n   169\t  }\n   170\t\n   171\t  /**\n   172\t   * Creates an empty conversation for a session, running on `model`. No sandbox: that is created lazily, at the\n   173\t   * first tool call, by the `env` callback of the Harness.\n   174\t   *\n   175\t   * Pi Durable stores the model in the conversation's `pi.agent` document, in the creating commit. It survives\n   176\t   * restarts, so it is set once here and not on every turn; only the provider must be installed again at each start.\n   177\t   */\n   178\t  async createConversation(model: ModelChoice): Promise<number> {\n   179\t    const conversation = await this.#harness.createConversation(\n   180\t      {\n   181\t        ownership: { kind: \"ownerless\" },\n   182\t        agent: {\n   183\t          model: { provider: model.provider, modelId: model.model },\n   184\t          ...(model.reasoning === undefined ? {} : { thinkingLevel: model.reasoning }),\n   185\t          cwd: WORKSPACE,\n   186\t        },\n   187\t      },\n   188\t      context,\n   189\t    );\n   190\t    return Number(conversation.id);\n   191\t  }\n   192\t\n   193\t  /** The model a conversation runs on, as Pi Durable stored it. */\n   194\t  async modelOf(id: number): Promise<ModelChoice | undefined> {\n   195\t    const agent = await (await this.#conversation(id)).agent(context);\n   196\t    return agent.model === undefined\n   197\t      ? undefined\n   198\t      : { provider: agent.model.provider, model: agent.model.modelId };\n   199\t  }\n   200\t\n   201\t  /** The reasoning effort a conversation runs with, as Pi Durable resolved it (`off` when none was stored). */\n   202\t  async thinkingOf(id: number): Promise<string> {\n   203\t    return (await (await this.#conversation(id)).agent(context)).thinkingLevel;\n   204\t  }\n   205\t\n   206\t  /** Model turns (assistant responses) in the conversation's transcript so far. */\n   207\t  async turnsUsed(id: number): Promise<number> {\n   208\t    const conversation = await this.#conversation(id);\n   209\t    let turns = 0;\n   210\t    let cursor: Cursor | undefined;\n   211\t    do {\n   212\t      const page = await conversation.entries({ order: \"ascending\" }, 200, cursor, context);\n   213\t      turns += page.items.filter((entry) => entry.kind === \"pi.assistant\").length;\n   214\t      cursor = page.next;\n   215\t    } while (cursor !== undefined);\n   216\t    return turns;\n   217\t  }\n   218\t\n   219\t  /** Caps the tool rounds of any run of this conversation, so one run cannot overshoot the session's turn budget. */\n   220\t  async limitTurns(id: number, maxTurns: number): Promise<void> {\n   221\t    await (await this.#conversation(id)).configure({ maxTurns }, context);\n   222\t  }\n   223\t\n   224\t  /** The stored state of a submission, for the run watcher. */\n   225\t  async submissionState(id: number, requestId: string): Promise<SubmissionState | undefined> {\n   226\t    return this.#storage.submissionByRequest(id as ConversationId, requestId, context);\n   227\t  }\n   228\t\n   229\t  /**\n   230\t   * Durably admits one inbox event. `requestId` is the inbox row id, so a resubmission after a crash returns the\n   231\t   * original submission instead of adding a second turn. A message queues behind a running turn (follow-up); a\n   232\t   * steer joins the running turn after its current tool round, and starts a turn when the session is idle.\n   233\t   */\n   234\t  async submitInput(\n   235\t    id: number,\n   236\t    input: { text: string; requestId: string; steer: boolean },\n   237\t  ): Promise<void> {\n   238\t    const conversation = await this.#conversation(id);\n   239\t    await conversation.submit(\n   240\t      {\n   241\t        type: \"input\",\n   242\t        content: input.text,\n   243\t        requestId: input.requestId,\n   244\t        whenBusy: input.steer ? \"steer\" : \"followUp\",\n   245\t      },\n   246\t      context,\n   247\t    );\n   248\t  }\n   249\t\n   250\t  async hasSubmission(id: number, requestId: string): Promise<boolean> {\n   251\t    // A read on the Storage: the Harness has no lookup by request id. Only the test-fault gate uses it.\n   252\t    const record = await this.#storage.submissionByRequest(\n   253\t      id as ConversationId,\n   254\t      requestId,\n   255\t      context,\n   256\t    );\n   257\t    return record !== undefined;\n   258\t  }\n   259\t\n   260\t  /** Withdraws queued inputs, aborts the running turn and resolves once the conversation is idle. */\n   261\t  async abort(id: number): Promise<void> {\n   262\t    await (await this.#conversation(id)).abort(context);\n   263\t  }\n   264\t\n   265\t  /** The conversation and a watch of its structural view (a window over the transcript plus live state). */\n   266\t  async watch(\n   267\t    id: number,\n   268\t    window?: ConversationWindow,\n   269\t  ): Promise<{ conversation: Conversation; watch: ConversationWatch } | undefined> {\n   270\t    const conversation = await this.#harness.conversation(id as ConversationId, context);\n   271\t    if (conversation === undefined) return undefined;\n   272\t    return { conversation, watch: await conversation.watch(context, window) };\n   273\t  }\n   274\t\n   275\t  /**\n   276\t   * The session's sandbox env, opening it (claim, bridge) if needed. Only repo sessions call this directly, to clone\n   277\t   * before the first turn; every other session opens its sandbox lazily at the first tool call.\n   278\t   * It is the same tracked env the tools get: the raw env would hide a running clone from idle eviction and suspension\n   279\t   * (a Pod deleted mid-clone) and would never be evicted itself.\n   280\t   */\n   281\t  workspaceEnv(id: number): Promise<WorkspaceEnv> {\n   282\t    return Promise.resolve(this.#sandboxes.lazyEnv(id));\n   283\t  }\n   284\t\n   285\t  /** Stops the session's bridge and deletes its SandboxClaim and PVC. */\n   286\t  async destroySandbox(id: number): Promise<void> {\n   287\t    await this.#sandboxes.destroy(id);\n   288\t  }\n   289\t\n   290\t  /** The orphan sweep's delete of a claim and its PVC: the session deletion's teardown, for a claim with no live session. */\n   291\t  async destroyOrphanSandbox(claimName: string, sessionLabel: string): Promise<void> {\n   292\t    await this.#sandboxes.destroyOrphan(claimName, sessionLabel);\n   293\t  }\n   294\t\n   295\t  async #conversation(id: number): Promise<Conversation> {\n   296\t    const conversation = await this.#harness.conversation(id as ConversationId, context);\n   297\t    if (conversation === undefined) throw new Error(`conversation ${String(id)} does not exist`);\n   298\t    return conversation;\n   299\t  }\n   300\t\n   301\t  /** Waits for in-flight work to settle and closes storage; bridges stop, claims stay. */\n   302\t  async close(): Promise<void> {\n   303\t    await this.#harness.close(context);\n   304\t    await this.#sandboxes.closeAll();\n   305\t  }\n   306\t}\n","isError":false}]}
ENTRY 11531 {"id":11531,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && cat -n packages/orchestrator/src/http.ts | head -160; cat -n packages/orchestrator/src/inbox.ts | head -180; cat -n packages/orchestrator/src/sweep.ts | head -210; cat -n packages/orchestrator/src/main.ts | sed -n '38,165p'\",\"timeout\":10000})"]}]}
ENTRY 11548 {"id":11548,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport { createServer } from \"node:http\";\n     2\timport type { IncomingMessage, Server, ServerResponse } from \"node:http\";\n     3\timport { errorMessage, getSession, sendJson, UUID } from \"@pi-durable-k8s/session-core\";\n     4\timport type { Authenticator } from \"@pi-durable-k8s/session-core\";\n     5\timport type pg from \"pg\";\n     6\timport type { Host } from \"./host.js\";\n     7\timport { log } from \"./log.js\";\n     8\timport { parseScript } from \"./model.js\";\n     9\timport type { SessionService } from \"./sessions.js\";\n    10\timport { serveStream } from \"./stream.js\";\n    11\t\n    12\t/** What /readyz reports: ready only once this process holds the storage lock and the Harness is open. */\n    13\texport interface Lifecycle {\n    14\t  state: \"waiting-for-lock\" | \"owner\";\n    15\t  instance: string;\n    16\t  host?: Host;\n    17\t  service?: SessionService;\n    18\t}\n    19\t\n    20\texport interface ServerDeps {\n    21\t  lifecycle: Lifecycle;\n    22\t  authenticate: Authenticator;\n    23\t  /** For the owner check on the stream. Independent of the Pi Durable storage connection. */\n    24\t  pool: pg.Pool;\n    25\t  /** Mounts the test-only /control surface (PI_ORCH_CONTROL=1). */\n    26\t  control: boolean;\n    27\t}\n    28\t\n    29\tasync function readBody(req: IncomingMessage): Promise<string> {\n    30\t  const chunks: Buffer[] = [];\n    31\t  let size = 0;\n    32\t  for await (const chunk of req) {\n    33\t    const buffer = chunk as Buffer;\n    34\t    size += buffer.length;\n    35\t    if (size > 64 * 1024) throw new Error(\"body too large\");\n    36\t    chunks.push(buffer);\n    37\t  }\n    38\t  return Buffer.concat(chunks).toString(\"utf8\");\n    39\t}\n    40\t\n    41\t/**\n    42\t * The orchestrator's HTTP surface.\n    43\t *   GET /healthz                  liveness: 200 while the process runs\n    44\t *   GET /readyz                   200 once this process owns the schema and serves, else 503\n    45\t *   GET /sessions/{id}/stream     SSE; bearer token + owner check, the same Authenticator as ingest\n    46\t *   /control/...                  test-only (PI_ORCH_CONTROL=1): the Phase 3 scripted-session surface, same auth\n    47\t */\n    48\texport function createOrchestratorServer(deps: ServerDeps): Server {\n    49\t  const server = createServer((req, res) => {\n    50\t    void handle(req, res, deps).catch((error: unknown) => {\n    51\t      log(\"http-error\", { message: errorMessage(error) });\n    52\t      if (!res.headersSent) sendJson(res, 500, { error: \"internal error\" });\n    53\t      else res.destroy();\n    54\t    });\n    55\t  });\n    56\t  server.requestTimeout = 0;\n    57\t  return server;\n    58\t}\n    59\t\n    60\tasync function handle(req: IncomingMessage, res: ServerResponse, deps: ServerDeps): Promise<void> {\n    61\t  const { lifecycle } = deps;\n    62\t  const url = new URL(req.url ?? \"/\", \"http://localhost\");\n    63\t  const parts = url.pathname.split(\"/\").filter(Boolean);\n    64\t  const method = req.method ?? \"GET\";\n    65\t\n    66\t  if (method === \"GET\" && url.pathname === \"/healthz\") {\n    67\t    sendJson(res, 200, { status: \"ok\", state: lifecycle.state, instance: lifecycle.instance });\n    68\t    return;\n    69\t  }\n    70\t  if (method === \"GET\" && url.pathname === \"/readyz\") {\n    71\t    const ready = lifecycle.host !== undefined && lifecycle.service !== undefined;\n    72\t    sendJson(res, ready ? 200 : 503, { state: lifecycle.state, instance: lifecycle.instance });\n    73\t    return;\n    74\t  }\n    75\t\n    76\t  const principal = await deps.authenticate(req.headers);\n    77\t  if (principal === undefined) {\n    78\t    sendJson(res, 401, { error: \"unauthorized\" }, { \"www-authenticate\": \"Bearer\" });\n    79\t    return;\n    80\t  }\n    81\t\n    82\t  const { host, service } = lifecycle;\n    83\t  if (host === undefined || service === undefined) {\n    84\t    // Not the owner yet (starting, or waiting for the lock). Clients retry; ingest keeps accepting events.\n    85\t    sendJson(res, 503, { error: lifecycle.state }, { \"retry-after\": \"2\" });\n    86\t    return;\n    87\t  }\n    88\t\n    89\t  if (method === \"GET\" && parts.length === 3 && parts[0] === \"sessions\" && parts[2] === \"stream\") {\n    90\t    const id = parts[1] ?? \"\";\n    91\t    const session = UUID.test(id) ? await getSession(deps.pool, id) : undefined;\n    92\t    if (session?.ownerSubject !== principal.subject) {\n    93\t      sendJson(res, 404, { error: \"session not found\" });\n    94\t      return;\n    95\t    }\n    96\t    if (session.status === \"deleted\") {\n    97\t      sendJson(res, 410, { error: \"session deleted\" });\n    98\t      return;\n    99\t    }\n   100\t    const conversationId = await service.ensureConversation(session);\n   101\t    await serveStream(req, res, host, service.streams, session.id, conversationId);\n   102\t    return;\n   103\t  }\n   104\t\n   105\t  if (deps.control && parts[0] === \"control\") {\n   106\t    await handleControl(req, res, host, method, parts.slice(1));\n   107\t    return;\n   108\t  }\n   109\t  sendJson(res, 404, { error: \"not found\" });\n   110\t}\n   111\t\n   112\t/**\n   113\t * Test-only. Scripted sessions created straight on the Harness, not through the inbox, with the sandbox claim\n   114\t * created eagerly. Kept only so the Phase 3 failure tests keep running unchanged in substance.\n   115\t *   POST /control/sessions            body = script JSON\n   116\t *   POST /control/sessions/:id/inputs body = script JSON\n   117\t *   GET  /control/sessions/:id        status and tool results\n   118\t */\n   119\tasync function handleControl(\n   120\t  req: IncomingMessage,\n   121\t  res: ServerResponse,\n   122\t  host: Host,\n   123\t  method: string,\n   124\t  parts: string[],\n   125\t): Promise<void> {\n   126\t  if (parts[0] !== \"sessions\") {\n   127\t    sendJson(res, 404, { error: \"not found\" });\n   128\t    return;\n   129\t  }\n   130\t  if (method === \"POST\" && parts.length === 1) {\n   131\t    let script;\n   132\t    try {\n   133\t      script = parseScript(await readBody(req));\n   134\t    } catch (error) {\n   135\t      sendJson(res, 400, { error: errorMessage(error) });\n   136\t      return;\n   137\t    }\n   138\t    sendJson(res, 201, await host.startSession(script));\n   139\t    return;\n   140\t  }\n   141\t  const id = Number(parts[1]);\n   142\t  if (method === \"POST\" && parts[2] === \"inputs\") {\n   143\t    let script;\n   144\t    try {\n   145\t      script = parseScript(await readBody(req));\n   146\t    } catch (error) {\n   147\t      sendJson(res, 400, { error: errorMessage(error) });\n   148\t      return;\n   149\t    }\n   150\t    const known = Number.isInteger(id) && (await host.sendInput(id, script));\n   151\t    sendJson(res, known ? 202 : 404, known ? { id } : { error: \"unknown session\" });\n   152\t    return;\n   153\t  }\n   154\t  if (method === \"GET\" && parts.length === 2 && Number.isInteger(id)) {\n   155\t    const status = await host.status(id);\n   156\t    sendJson(res, status === undefined ? 404 : 200, status ?? { error: \"unknown session\" });\n   157\t    return;\n   158\t  }\n   159\t  sendJson(res, 404, { error: \"not found\" });\n   160\t}\n     1\timport type pg from \"pg\";\n     2\timport { errorMessage, getSession, toEvent } from \"@pi-durable-k8s/session-core\";\n     3\timport type { EventDbRow, InboxEvent, SessionRow } from \"@pi-durable-k8s/session-core\";\n     4\timport { log } from \"./log.js\";\n     5\timport { PermanentError } from \"./sessions.js\";\n     6\t\n     7\tconst POLL_MS = 1_000;\n     8\tconst BATCH = 20;\n     9\tconst MAX_PARALLEL_SESSIONS = 8;\n    10\tconst MAX_ATTEMPTS = 5;\n    11\tconst DELETE_RETRY_BASE_MS = 1_000;\n    12\tconst DELETE_RETRY_MAX_MS = 60_000;\n    13\t\n    14\t/**\n    15\t * Wait before the next try of a failing `delete` row: 1 s, 2 s, 4 s ... capped at 60 s. A delete is not given up after\n    16\t * MAX_ATTEMPTS like other events (docs/decisions/0006-deletes-retry-until-done.md): five tries a second apart end\n    17\t * inside one short Kubernetes or OneCLI outage, and a failed delete leaks the sandbox, PVC and OneCLI agent.\n    18\t */\n    19\texport function deleteRetryDelayMs(attempt: number): number {\n    20\t  return Math.min(DELETE_RETRY_MAX_MS, DELETE_RETRY_BASE_MS * 2 ** Math.max(0, attempt - 1));\n    21\t}\n    22\t\n    23\texport type ApplyEvent = (event: InboxEvent, session: SessionRow) => Promise<void>;\n    24\t\n    25\t/**\n    26\t * The orchestrator's side of the inbox. It claims `pending` rows, hands each to Pi Durable (the row id is the\n    27\t * `requestId`), and only then marks the row `submitted`. Pi Durable owns run recovery: a row that is\n    28\t * already `submitted` is never touched again, so a run that died is never re-run from here.\n    29\t *\n    30\t *  - Wake-up: LISTEN on `inbox_events` (sent by a trigger on insert) plus a short poll as the safety net.\n    31\t *  - Claim: one transaction per session batch, `FOR UPDATE SKIP LOCKED`, oldest first. The row locks are held\n    32\t *    until the rows are marked, so a crash in between rolls the batch back to `pending`; the retry submits\n    33\t *    with the same `requestId` and Pi Durable returns the original submission.\n    34\t *  - Ordering: one drain per session at a time, rows in (created_at, id) order. A transient failure stops\n    35\t *    that session's batch so later rows cannot overtake it; other sessions are unaffected.\n    36\t *  - Batching: rows of a session are claimed up to 20 at a time and submitted one by one, in order. They are\n    37\t *    not merged into one input: each keeps its own requestId and therefore its own idempotent submission.\n    38\t */\n    39\texport class InboxLoop {\n    40\t  readonly #pool: pg.Pool;\n    41\t  readonly #apply: ApplyEvent;\n    42\t  readonly #inFlight = new Set<string>();\n    43\t  /** Sessions whose failing delete waits out its backoff (epoch ms). In memory: a restart simply retries at once. */\n    44\t  readonly #notBefore = new Map<string, number>();\n    45\t  #listener: pg.PoolClient | undefined;\n    46\t  #timer: NodeJS.Timeout | undefined;\n    47\t  #ticking = false;\n    48\t  #again = false;\n    49\t  #stopped = false;\n    50\t\n    51\t  constructor(pool: pg.Pool, apply: ApplyEvent) {\n    52\t    this.#pool = pool;\n    53\t    this.#apply = apply;\n    54\t  }\n    55\t\n    56\t  start(): void {\n    57\t    void this.#listen();\n    58\t    this.#timer = setInterval(() => this.wake(), POLL_MS);\n    59\t    this.wake();\n    60\t  }\n    61\t\n    62\t  async stop(): Promise<void> {\n    63\t    this.#stopped = true;\n    64\t    if (this.#timer !== undefined) clearInterval(this.#timer);\n    65\t    this.#listener?.removeAllListeners();\n    66\t    this.#listener?.release(true);\n    67\t    // Let drains in flight finish their current row: they hold row locks and a transaction.\n    68\t    while (this.#inFlight.size > 0) await new Promise((resolve) => setTimeout(resolve, 100));\n    69\t  }\n    70\t\n    71\t  wake(): void {\n    72\t    if (this.#stopped) return;\n    73\t    if (this.#ticking) {\n    74\t      this.#again = true;\n    75\t      return;\n    76\t    }\n    77\t    this.#ticking = true;\n    78\t    void this.#tick().finally(() => {\n    79\t      this.#ticking = false;\n    80\t      if (this.#again) {\n    81\t        this.#again = false;\n    82\t        this.wake();\n    83\t      }\n    84\t    });\n    85\t  }\n    86\t\n    87\t  async #listen(): Promise<void> {\n    88\t    while (!this.#stopped) {\n    89\t      try {\n    90\t        const client = await this.#pool.connect();\n    91\t        this.#listener = client;\n    92\t        await new Promise<void>((resolve) => {\n    93\t          client.on(\"notification\", () => this.wake());\n    94\t          client.on(\"error\", () => resolve());\n    95\t          client.on(\"end\", () => resolve());\n    96\t          client.query(\"listen inbox_events\").catch(() => resolve());\n    97\t        });\n    98\t        client.removeAllListeners();\n    99\t        client.release(true);\n   100\t      } catch (error) {\n   101\t        log(\"inbox-listen-failed\", { message: errorMessage(error) });\n   102\t      }\n   103\t      // The poll covers the gap until the listener is back.\n   104\t      await new Promise((resolve) => setTimeout(resolve, 2_000));\n   105\t    }\n   106\t  }\n   107\t\n   108\t  async #tick(): Promise<void> {\n   109\t    try {\n   110\t      const { rows } = await this.#pool.query<{ session_id: string }>(\n   111\t        \"select distinct session_id from inbox.events where status = 'pending' limit 100\",\n   112\t      );\n   113\t      for (const { session_id: sessionId } of rows) {\n   114\t        if (this.#inFlight.has(sessionId) || this.#inFlight.size >= MAX_PARALLEL_SESSIONS) continue;\n   115\t        if ((this.#notBefore.get(sessionId) ?? 0) > Date.now()) continue;\n   116\t        this.#inFlight.add(sessionId);\n   117\t        void this.#drain(sessionId)\n   118\t          .then((progressed) => {\n   119\t            if (progressed) this.wake();\n   120\t          })\n   121\t          .catch((error: unknown) => {\n   122\t            log(\"inbox-drain-failed\", { session: sessionId, message: errorMessage(error) });\n   123\t          })\n   124\t          .finally(() => this.#inFlight.delete(sessionId));\n   125\t      }\n   126\t    } catch (error) {\n   127\t      log(\"inbox-poll-failed\", { message: errorMessage(error) });\n   128\t    }\n   129\t  }\n   130\t\n   131\t  /** Claims and applies batches for one session until none is pending. True if it made progress. */\n   132\t  async #drain(sessionId: string): Promise<boolean> {\n   133\t    let progressed = false;\n   134\t    while (!this.#stopped) {\n   135\t      const client = await this.#pool.connect();\n   136\t      let finished = true;\n   137\t      let submitted = 0;\n   138\t      try {\n   139\t        await client.query(\"begin\");\n   140\t        const { rows } = await client.query<EventDbRow>(\n   141\t          `select * from inbox.events\n   142\t            where session_id = $1 and status = 'pending'\n   143\t            order by created_at, id\n   144\t            limit $2\n   145\t            for update skip locked`,\n   146\t          [sessionId, BATCH],\n   147\t        );\n   148\t        if (rows.length === 0) {\n   149\t          await client.query(\"commit\");\n   150\t          return progressed;\n   151\t        }\n   152\t        for (const row of rows) {\n   153\t          const event = toEvent(row);\n   154\t          const outcome = await this.#applyRow(client, event);\n   155\t          if (outcome === \"retry-later\") {\n   156\t            finished = false;\n   157\t            break;\n   158\t          }\n   159\t          progressed = true;\n   160\t          if (outcome === \"submitted\") submitted += 1;\n   161\t        }\n   162\t        await client.query(\"commit\");\n   163\t      } catch (error) {\n   164\t        await client.query(\"rollback\").catch(() => undefined);\n   165\t        throw error;\n   166\t      } finally {\n   167\t        client.release();\n   168\t      }\n   169\t      // Once per batch and after the commit. Inside the transaction this update would hold the session row's lock\n   170\t      // until the commit, and a later row of the batch (delete, a failSession) updates the same row on another\n   171\t      // connection: it would wait for a lock that only this transaction's end releases, until statement_timeout.\n   172\t      if (submitted > 0) await this.#touchSession(sessionId);\n   173\t      if (!finished) return progressed;\n   174\t    }\n   175\t    return progressed;\n   176\t  }\n   177\t\n   178\t  async #touchSession(sessionId: string): Promise<void> {\n   179\t    try {\n   180\t      await this.#pool.query(\n     1\timport type { SessionRef } from \"@pi-durable-k8s/session-core\";\n     2\timport { UUID } from \"@pi-durable-k8s/session-core\";\n     3\t\n     4\t/**\n     5\t * The decision half of the orphan sweep (docs/decisions/0002-orphan-sweep.md): which sandbox resources have no\n     6\t * live session. Pure: the inputs are what the cluster, OneCLI and the inbox report right now, the output is the\n     7\t * list of things to remove. Nothing here calls Kubernetes, OneCLI or Postgres.\n     8\t *\n     9\t * Only three kinds of object are ever candidates, and only by exact name or label pattern:\n    10\t *  - a SandboxClaim `pi-conv-<n>` whose `pi-durable-k8s/session-id` label is a session UUID;\n    11\t *  - a PVC `workspace-pi-conv-<n>` for which no SandboxClaim of that name exists;\n    12\t *  - a OneCLI agent `pi-session-<uuid>` and its secrets `pi-session-<uuid>-git` / `-api`.\n    13\t * Anything else is left alone: unlabelled claims (the e2e Phase 1 claim `e2e-phase1`), `control-<n>` labels of\n    14\t * the test-only control sessions, other namespaces' naming schemes.\n    15\t *\n    16\t * A session is an orphan's owner only if it is `deleted` or unknown. `active`, `failed` and `deleting` sessions\n    17\t * are live: a claim of an active session whose sandbox can never work again (a token from before ADR 0001) is an\n    18\t * operator decision, because removing it destroys the workspace of a session the user can still talk to.\n    19\t */\n    20\t\n    21\texport interface SweepClaim {\n    22\t  name: string;\n    23\t  sessionLabel: string | undefined;\n    24\t  createdAt: Date;\n    25\t}\n    26\t\n    27\texport interface SweepPvc {\n    28\t  name: string;\n    29\t  createdAt: Date;\n    30\t}\n    31\t\n    32\texport interface SweepAgent {\n    33\t  id: string;\n    34\t  identifier: string;\n    35\t  /** OneCLI does not always report it; an agent without it is judged by its session alone. */\n    36\t  createdAt?: Date;\n    37\t}\n    38\t\n    39\texport interface SweepSecret {\n    40\t  id: string;\n    41\t  name: string;\n    42\t}\n    43\t\n    44\texport interface SweepInput {\n    45\t  sessions: readonly SessionRef[];\n    46\t  claims: readonly SweepClaim[];\n    47\t  pvcs: readonly SweepPvc[];\n    48\t  /** Undefined when OneCLI is not configured: no agent is judged. */\n    49\t  agents: readonly SweepAgent[] | undefined;\n    50\t  secrets: readonly SweepSecret[];\n    51\t  now: number;\n    52\t  /** An object younger than this is never touched, so a session being created cannot race the sweep. */\n    53\t  graceMs: number;\n    54\t  /** Upper bound of actions in one run; the rest waits for the next run. */\n    55\t  maxActions: number;\n    56\t}\n    57\t\n    58\texport type SweepReason = \"session-deleted\" | \"session-unknown\";\n    59\t\n    60\texport type SweepAction =\n    61\t  /** Deletes the claim and its PVC (the session delete path, `deleteClaimAndPvc`). */\n    62\t  | { kind: \"delete-claim\"; claim: string; sessionLabel: string; reason: SweepReason }\n    63\t  /** A workspace PVC whose claim is gone and whose session is deleted or unknown. */\n    64\t  | { kind: \"delete-pvc\"; claim: string; reason: SweepReason }\n    65\t  /** Revokes a session's OneCLI agent and per-session secrets. Ids are not secret; tokens are never carried. */\n    66\t  | {\n    67\t      kind: \"revoke-agent\";\n    68\t      sessionId: string;\n    69\t      agentIds: string[];\n    70\t      secretIds: string[];\n    71\t      reason: SweepReason;\n    72\t    };\n    73\t\n    74\tconst CLAIM_NAME = /^pi-conv-(\\d+)$/;\n    75\tconst PVC_NAME = /^workspace-(pi-conv-(\\d+))$/;\n    76\tconst AGENT_IDENTIFIER = /^pi-session-([0-9a-f-]{36})$/;\n    77\tconst SECRET_NAME = /^pi-session-([0-9a-f-]{36})-(git|api)$/;\n    78\t\n    79\texport function planSweep(input: SweepInput): SweepAction[] {\n    80\t  const bySession = new Map(input.sessions.map((s) => [s.id, s]));\n    81\t  const byConversation = new Map(\n    82\t    input.sessions.flatMap((s) => (s.conversationId === null ? [] : [[s.conversationId, s]])),\n    83\t  );\n    84\t  const old = (createdAt: Date | undefined): boolean =>\n    85\t    createdAt === undefined || input.now - createdAt.getTime() >= input.graceMs;\n    86\t  /** The reason a session no longer owns anything, or undefined if it is live. */\n    87\t  const orphanReason = (session: SessionRef | undefined): SweepReason | undefined => {\n    88\t    if (session === undefined) return \"session-unknown\";\n    89\t    return session.status === \"deleted\" ? \"session-deleted\" : undefined;\n    90\t  };\n    91\t\n    92\t  const actions: SweepAction[] = [];\n    93\t\n    94\t  for (const claim of input.claims) {\n    95\t    if (!CLAIM_NAME.test(claim.name)) continue;\n    96\t    const label = claim.sessionLabel;\n    97\t    if (label === undefined || !UUID.test(label)) continue;\n    98\t    if (!old(claim.createdAt)) continue;\n    99\t    const reason = orphanReason(bySession.get(label));\n   100\t    if (reason !== undefined)\n   101\t      actions.push({ kind: \"delete-claim\", claim: claim.name, sessionLabel: label, reason });\n   102\t  }\n   103\t\n   104\t  // Any claim of that name, labelled or not, means the PVC is (or may soon be) in use: leave it.\n   105\t  const claimNames = new Set(input.claims.map((c) => c.name));\n   106\t  for (const pvc of input.pvcs) {\n   107\t    const match = PVC_NAME.exec(pvc.name);\n   108\t    if (match === null || !old(pvc.createdAt)) continue;\n   109\t    const [, claim, conversation] = match;\n   110\t    if (claim === undefined || conversation === undefined || claimNames.has(claim)) continue;\n   111\t    const reason = orphanReason(byConversation.get(Number(conversation)));\n   112\t    if (reason !== undefined) actions.push({ kind: \"delete-pvc\", claim, reason });\n   113\t  }\n   114\t\n   115\t  if (input.agents !== undefined) {\n   116\t    const found = new Map<string, { agentIds: string[]; secretIds: string[] }>();\n   117\t    const entry = (sessionId: string) => {\n   118\t      let e = found.get(sessionId);\n   119\t      if (e === undefined) {\n   120\t        e = { agentIds: [], secretIds: [] };\n   121\t        found.set(sessionId, e);\n   122\t      }\n   123\t      return e;\n   124\t    };\n   125\t    for (const agent of input.agents) {\n   126\t      const sessionId = AGENT_IDENTIFIER.exec(agent.identifier)?.[1];\n   127\t      if (sessionId === undefined || !old(agent.createdAt)) continue;\n   128\t      if (orphanReason(bySession.get(sessionId)) !== undefined)\n   129\t        entry(sessionId).agentIds.push(agent.id);\n   130\t    }\n   131\t    for (const secret of input.secrets) {\n   132\t      const sessionId = SECRET_NAME.exec(secret.name)?.[1];\n   133\t      if (sessionId === undefined) continue;\n   134\t      if (orphanReason(bySession.get(sessionId)) !== undefined)\n   135\t        entry(sessionId).secretIds.push(secret.id);\n   136\t    }\n   137\t    for (const [sessionId, ids] of found) {\n   138\t      const reason = orphanReason(bySession.get(sessionId));\n   139\t      if (reason !== undefined) actions.push({ kind: \"revoke-agent\", sessionId, ...ids, reason });\n   140\t    }\n   141\t  }\n   142\t\n   143\t  return actions.slice(0, Math.max(0, input.maxActions));\n   144\t}\n    38\t  await new Promise<void>((resolve) => server.listen(config.port, resolve));\n    39\t  log(\"listening\", { instance: config.instance, port: config.port });\n    40\t\n    41\t  const running: { inbox?: InboxLoop; service?: SessionService; sweeper?: OrphanSweeper } = {};\n    42\t  const stop = new AbortController();\n    43\t  const shutdown = (signal: string): void => {\n    44\t    log(\"shutdown\", { signal });\n    45\t    stop.abort();\n    46\t    server.close();\n    47\t    void (async () => {\n    48\t      running.service?.stop();\n    49\t      running.sweeper?.stop();\n    50\t      await running.inbox?.stop();\n    51\t      await lifecycle.host?.close();\n    52\t      server.closeAllConnections();\n    53\t      await pool.end().catch(() => undefined);\n    54\t    })().finally(() => process.exit(0));\n    55\t    setTimeout(() => process.exit(0), 10_000).unref();\n    56\t  };\n    57\t  process.on(\"SIGTERM\", () => shutdown(\"SIGTERM\"));\n    58\t  process.on(\"SIGINT\", () => shutdown(\"SIGINT\"));\n    59\t\n    60\t  for (;;) {\n    61\t    try {\n    62\t      await applyMigrations(pool);\n    63\t      break;\n    64\t    } catch (error) {\n    65\t      log(\"migrate-failed\", { message: errorMessage(error) });\n    66\t      await new Promise((resolve) => setTimeout(resolve, 2_000));\n    67\t    }\n    68\t  }\n    69\t\n    70\t  const storage = await openStorageWhenFree(config, stop.signal);\n    71\t  log(\"lock-acquired\", { instance: config.instance });\n    72\t  const sessionKeyOf = async (conversationId: number): Promise<string> => {\n    73\t    const { rows } = await pool.query<{ id: string }>(\n    74\t      \"select id from inbox.sessions where conversation_id = $1\",\n    75\t      [conversationId],\n    76\t    );\n    77\t    // Conversations the inbox does not know are the test-only /control sessions.\n    78\t    return rows[0]?.id ?? `control-${String(conversationId)}`;\n    79\t  };\n    80\t  // Repo workspaces (Phase 4c). Plain sessions never touch OneCLI's management API or GitHub through this.\n    81\t  const callApi: FetchLike = (url, init) => fetch(url, init);\n    82\t  const onecli =\n    83\t    config.repos.onecliApiKey === undefined\n    84\t      ? undefined\n    85\t      : new OneCliAdmin(config.repos.onecliApi, config.repos.onecliApiKey, callApi);\n    86\t  const repos = new RepoAccess({\n    87\t    pool,\n    88\t    onecli,\n    89\t    githubAppDir: config.repos.githubAppDir,\n    90\t    gateway: config.onecli.gateway,\n    91\t    caFile: config.onecli.caFile,\n    92\t    fetch: callApi,\n    93\t  });\n    94\t  const hooks: SandboxHooks = {\n    95\t    shellEnv: async (conversationId) => {\n    96\t      const { rows } = await pool.query<{ id: string }>(\n    97\t        \"select id from inbox.sessions where conversation_id = $1\",\n    98\t        [conversationId],\n    99\t      );\n   100\t      const session = rows[0] === undefined ? undefined : await getSession(pool, rows[0].id);\n   101\t      return session === undefined ? undefined : repos.shellEnv(session, conversationId);\n   102\t    },\n   103\t    beforeUse: (conversationId) => repos.beforeUse(conversationId),\n   104\t    execInFlight: (conversationId, inFlight) => setExecInFlight(pool, conversationId, inFlight),\n   105\t  };\n   106\t  // Sandboxes that had a command running when the previous process died: Host.open recycles their Pods before Pi\n   107\t  // Durable resumes (docs/decisions/0003-recycle-pod-on-interrupt.md).\n   108\t  const recycleAtStart = await conversationsWithExecInFlight(pool);\n   109\t  if (recycleAtStart.length > 0) log(\"recycle-at-start\", { conversations: recycleAtStart });\n   110\t  const host = await Host.open(\n   111\t    storage,\n   112\t    config,\n   113\t    (error) => {\n   114\t      // Fail closed: a Harness that lost its storage stops here. Nothing reconnects and nothing more is\n   115\t      // written; the Deployment starts a fresh process, which waits for the lock like any other owner.\n   116\t      log(\"fail-closed\", { instance: config.instance, message: errorMessage(error) });\n   117\t      process.exit(1);\n   118\t    },\n   119\t    sessionKeyOf,\n   120\t    hooks,\n   121\t    recycleAtStart,\n   122\t  );\n   123\t  const service = new SessionService(pool, host, {\n   124\t    testFaults: config.testFaults,\n   125\t    defaultModel: config.models.default,\n   126\t    turnBudget: config.turnBudget,\n   127\t    repos,\n   128\t  });\n   129\t  running.service = service;\n   130\t  // Not fatal: a failed scan only means a run that died unseen is noticed at its next input.\n   131\t  await service.recoverWatches().catch((error: unknown) => {\n   132\t    log(\"run-watch-recover-failed\", { message: errorMessage(error) });\n   133\t  });\n   134\t  lifecycle.host = host;\n   135\t  lifecycle.service = service;\n   136\t  lifecycle.state = \"owner\";\n   137\t  log(\"owner\", { instance: config.instance });\n   138\t\n   139\t  // Orphan sweep (docs/decisions/0002-orphan-sweep.md): only the owner runs it, like the inbox.\n   140\t  const sweeper = new OrphanSweeper({\n   141\t    listSessions: () => listSessionRefs(pool),\n   142\t    listClaims: () => listClaims(config.namespace),\n   143\t    listPvcs: () => listPvcs(config.namespace),\n   144\t    listOneCli:\n   145\t      onecli === undefined\n   146\t        ? undefined\n   147\t        : async () => ({\n   148\t            agents: (await onecli.listAgents()).map(({ id, identifier }) => ({ id, identifier })),\n   149\t            secrets: await onecli.listSecrets(),\n   150\t          }),\n   151\t    destroyClaim: (claim, label) => host.destroyOrphanSandbox(claim, label),\n   152\t    revokeSession: (sessionId) => repos.revokeSession(sessionId),\n   153\t    graceMs: config.sweep.graceMs,\n   154\t    maxActions: config.sweep.maxActions,\n   155\t  });\n   156\t  running.sweeper = sweeper;\n   157\t  sweeper.start(config.sweep.intervalMs);\n   158\t\n   159\t  // Only the owner consumes the inbox. Rows that arrived while no orchestrator ran are waiting.\n   160\t  const inbox = new InboxLoop(pool, (event, session) => service.apply(event, session));\n   161\t  running.inbox = inbox;\n   162\t  inbox.start();\n   163\t}\n   164\t\n   165\tmain().catch((error: unknown) => {\n","isError":false}]}
