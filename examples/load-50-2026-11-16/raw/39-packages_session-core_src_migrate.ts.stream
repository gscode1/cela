ENTRY 11923 {"id":11923,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import {\n  applyMigrations,\n  createPool,\n  errorMessage,\n  tokenAuthenticator,\n} from \"@pi-durable-k8s/session-core\";\nimport { loadConfig } from \"./config.js\";\nimport { log } from \"./log.js\";\nimport { createIngestServer } from \"./server.js\";\n\nasync function main(): Promise<void> {\n  const config = loadConfig(process.env);\n  const authenticate = tokenAuthenticator(config.apiTokens);\n  const pool = createPool(config.databaseUrl, config.instance, 5);\n\n  let schemaReady = false;\n  const state = { stopping: false };\n  const server = createIngestServer({\n    pool,\n    authenticate,\n    orchestratorUrl: config.orchestratorUrl,\n    models: config.models,\n    schemaReady: () => schemaReady,\n  });\n  // Long-lived SSE responses must not be cut by Node's default request timeouts.\n  server.requestTimeout = 0;\n  server.headersTimeout = 60_000;\n  await new Promise<void>((resolve) => server.listen(config.port, resolve));\n  log(\"listening\", { instance: config.instance, port: config.port });\n\n  // The inbox schema is ingest's own precondition: it must accept events while the orchestrator is down. The server\n  // is already up, so /healthz answers while a migration waits for a lock (a liveness failure would only restart\n  // the pod into the same wait). Retry instead of crashing; /readyz stays 503 until it succeeds.\n  void (async () => {\n    while (!state.stopping) {\n      try {\n        await applyMigrations(pool);\n        schemaReady = true;\n        log(\"migrated\", { instance: config.instance });\n        return;\n      } catch (error) {\n        log(\"migrate-failed\", { message: errorMessage(error) });\n        await new Promise((resolve) => setTimeout(resolve, 2_000));\n      }\n    }\n  })();\n\n  const shutdown = (signal: string): void => {\n    log(\"shutdown\", { signal });\n    state.stopping = true;\n    server.close();\n    server.closeAllConnections();\n    void pool.end().finally(() => process.exit(0));\n    setTimeout(() => process.exit(0), 5_000).unref();\n  };\n  process.on(\"SIGTERM\", () => shutdown(\"SIGTERM\"));\n  process.on(\"SIGINT\", () => shutdown(\"SIGINT\"));\n}\n\nmain().catch((error: unknown) => {\n  log(\"fatal\", { message: errorMessage(error) });\n  process.exit(1);\n});\n    pool,\n    control: config.control,\n  });\n  await new Promise<void>((resolve) => server.listen(config.port, resolve));\n  log(\"listening\", { instance: config.instance, port: config.port });\n\n  const running: { inbox?: InboxLoop; service?: SessionService; sweeper?: OrphanSweeper } = {};\n  const stop = new AbortController();\n  const shutdown = (signal: string): void => {\n    log(\"shutdown\", { signal });\n    stop.abort();\n    server.close();\n    void (async () => {\n      running.service?.stop();\n      running.sweeper?.stop();\n      await running.inbox?.stop();\n      await lifecycle.host?.close();\n      server.closeAllConnections();\n      await pool.end().catch(() => undefined);\n    })().finally(() => process.exit(0));\n    setTimeout(() => process.exit(0), 10_000).unref();\n  };\n  process.on(\"SIGTERM\", () => shutdown(\"SIGTERM\"));\n  process.on(\"SIGINT\", () => shutdown(\"SIGINT\"));\n\n  for (;;) {\n    try {\n      await applyMigrations(pool);\n      break;\n    } catch (error) {\n      log(\"migrate-failed\", { message: errorMessage(error) });\n      await new Promise((resolve) => setTimeout(resolve, 2_000));\n    }\n  }\n\n  const storage = await openStorageWhenFree(config, stop.signal);\n  log(\"lock-acquired\", { instance: config.instance });\n  const sessionKeyOf = async (conversationId: number): Promise<string> => {\n    const { rows } = await pool.query<{ id: string }>(\n      \"select id from inbox.sessions where conversation_id = $1\",\n      [conversationId],\n    );\n    // Conversations the inbox does not know are the test-only /control sessions.\n    return rows[0]?.id ?? `control-${String(conversationId)}`;\n  };\n  // Repo workspaces (Phase 4c). Plain sessions never touch OneCLI's management API or GitHub through this.\n  const callApi: FetchLike = (url, init) => fetch(url, init);\n  const onecli =\n    config.repos.onecliApiKey === undefined\n      ? undefined\n      : new OneCliAdmin(config.repos.onecliApi, config.repos.onecliApiKey, callApi);\n  const repos = new RepoAccess({\n    pool,\n    onecli,\n    githubAppDir: config.repos.githubAppDir,\n    gateway: config.onecli.gateway,\nimport { mkdtemp, writeFile } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { pathToFileURL } from \"node:url\";\nimport type pg from \"pg\";\nimport { beforeEach, describe, expect, it } from \"vitest\";\nimport { applyMigrations } from \"../src/migrate.ts\";\n\n/** Records every statement; `recorded` stands for the rows of inbox.schema_migrations (undefined: no table). */\nclass FakeDb {\n  statements: string[] = [];\n  recorded: string[] | undefined;\n  failOn: string | undefined;\n\n  query(sql: string, params?: unknown[]): Promise<{ rows: { version: string }[] }> {\n    this.statements.push(sql.trim().split(\"\\n\")[0] ?? \"\");\n    if (this.failOn !== undefined && sql.includes(this.failOn)) {\n      return Promise.reject(\n        Object.assign(new Error(\"canceling statement due to lock timeout\"), { code: \"55P03\" }),\n      );\n    }\n    if (sql.startsWith(\"select version\")) {\n      if (this.recorded === undefined)\n        throw Object.assign(new Error(\"no table\"), { code: \"42P01\" });\n      return Promise.resolve({ rows: this.recorded.map((version) => ({ version })) });\n    }\n    if (sql.startsWith(\"create table if not exists inbox.schema_migrations\")) this.recorded ??= [];\n    if (sql.startsWith(\"insert into inbox.schema_migrations\"))\n      this.recorded?.push(String(params?.[0]));\n    return Promise.resolve({ rows: [] });\n  }\n\n  connect(): Promise<{ query: FakeDb[\"query\"]; release: () => void }> {\n    return Promise.resolve({\n      query: (sql, params) => this.query(sql, params),\n      release: () => undefined,\n    });\n  }\n  asPool(): pg.Pool {\n    return this as unknown as pg.Pool;\n  }\n}\n\nlet dir: URL;\nbeforeEach(async () => {\n  const path = await mkdtemp(join(tmpdir(), \"migrate-test-\"));\n  await writeFile(join(path, \"001_a.sql\"), \"-- a\");\n  await writeFile(join(path, \"002_b.sql\"), \"-- b\");\n  await writeFile(join(path, \"README.txt\"), \"ignored\");\n  dir = pathToFileURL(path + \"/\");\n});\n\nconst ran = (db: FakeDb): string[] => db.statements.filter((s) => s.startsWith(\"-- \"));\n\ndescribe(\"applyMigrations\", () => {\n  it(\"issues one SELECT and nothing else when every file is recorded\", async () => {\n    const db = new FakeDb();\n    db.recorded = [\"001_a.sql\", \"002_b.sql\"];\n    await applyMigrations(db.asPool(), dir);\n    expect(db.statements).toEqual([\"select version from inbox.schema_migrations\"]);\n  });\n\n  it(\"applies only the missing files, under a short lock timeout\", async () => {\n    const db = new FakeDb();\n    db.recorded = [\"001_a.sql\"];\n    await applyMigrations(db.asPool(), dir);\n    expect(ran(db)).toEqual([\"-- b\"]);\n    expect(db.recorded).toEqual([\"001_a.sql\", \"002_b.sql\"]);\n    const lock = db.statements.findIndex((s) => s.includes(\"pg_advisory_xact_lock\"));\n    expect(db.statements.findIndex((s) => s.includes(\"lock_timeout\"))).toBeLessThan(lock);\n    expect(db.statements.at(-1)).toBe(\"commit\");\n  });\n\n  it(\"backfills a database that predates the version table, then takes the fast path\", async () => {\n    const db = new FakeDb(); // recorded undefined: the first rollout\n    await applyMigrations(db.asPool(), dir);\n    expect(ran(db)).toEqual([\"-- a\", \"-- b\"]);\n    expect(db.recorded).toEqual([\"001_a.sql\", \"002_b.sql\"]);\n    db.statements = [];\n    await applyMigrations(db.asPool(), dir);\n    expect(db.statements).toEqual([\"select version from inbox.schema_migrations\"]);\n  });\n\n  it(\"rolls back and rethrows when DDL cannot get its lock\", async () => {\n    const db = new FakeDb();\n    db.failOn = \"-- a\";\n    await expect(applyMigrations(db.asPool(), dir)).rejects.toThrow(/lock timeout/);\n    expect(db.statements.at(-1)).toBe(\"rollback\");\n  });\n});\n# 0005: Migrations take no DDL locks when the schema is current; the drain transaction stays (for now)\n\nStatus: accepted, 2026-11-16 (issue #3).\n\n## Context\n\nOn 2026-11-16 ingest pods crash-looped while repo sessions were starting:\n\n1. The orchestrator's inbox drain (`InboxLoop.#drain`) opens a transaction, locks the claimed `inbox.events` rows\n   (`FOR UPDATE SKIP LOCKED`) and keeps it open while `#apply` creates the sandbox, provisions OneCLI and clones the\n   repository (about 96 s observed). Only then does it mark the row and commit.\n2. `applyMigrations` re-ran every migration (DDL) in a transaction at every process start. `ALTER TABLE` needs ACCESS\n   EXCLUSIVE, so it queued behind the drain, hit `statement_timeout`, and while queued it also blocked every other\n   query on those tables, including ingest's inserts.\n3. Ingest ran migrations before it listened, so `/healthz` was not served, the liveness probe failed six times and the\n   kubelet killed the pod (exit 137), which restarted into the same wait.\n\n## Decision\n\n- `inbox.schema_migrations(version, applied_at)` records each applied file. A start reads it with a plain SELECT;\n  when every file is recorded it returns without a lock or any DDL. Only a missing file takes the advisory lock, under\n  `lock_timeout = 3s`, and runs just the missing files (still idempotent). The caller retries on failure.\n- Rollout: a database that predates the table has everything applied but nothing recorded. Its first start takes the\n  slow path once: the idempotent files re-run (no change) and are recorded. That one run still needs the DDL locks,\n  so it can fail fast behind a long drain and retry until the orchestrator is between rows; afterwards no start does\n  DDL again. Old ingest/orchestrator images keep running their old unconditional DDL until they are replaced.\n- Ingest listens first and migrates in the background. `/healthz` (liveness) answers from process start; `/readyz`\n  and the API answer `503` until migrations succeeded, then keep their meaning (\"the database answers\"). The\n  orchestrator already listened before migrating and has no liveness probe, so it is unchanged.\n\n## The long drain transaction (assessed, not changed)\n\nHolding a transaction across the workspace preparation is a cost, but it is also what makes `crash-before-mark`\n(`tests/e2e/run-phase4.sh`) hold: the row locks mean a crash between submit and mark rolls the row back to `pending`,\nand Pi Durable's idempotent `requestId` keeps the retry from double-submitting.\n\nShortening it means splitting `SessionService.apply` into an idempotent prepare phase (ensure conversation, budget,\n`#prepareRepo`) that runs before the claim, and the claim + submit + mark that stays transactional. The submit/mark\nwindow and its guarantee would be untouched. It is not done here because it is not small: prepare failures currently\nbecome row outcomes (`PermanentError` fails the row, a transient error bumps `attempts` and stops the batch, a lost\nworkspace fails the session), so prepare outside the transaction needs its own claim-free way to record those, plus\ncare that two orchestrators or a drain and a delete do not prepare concurrently. With migrations no longer taking\nlocks, the remaining harm of the long transaction is bounded: row locks on that session's pending events only (other\nsessions' rows are skipped, ingest inserts do not conflict with them).\n\nRelated risk, to be handled in that follow-up: each busy session holds one pool connection for the whole preparation.\nThe orchestrator inbox pool has `max 10` (`main.ts`), `MAX_PARALLEL_SESSIONS` is 8 and the LISTEN connection takes\none, so eight concurrent repo sessions leave a single connection for `getSession`, `setExecInFlight`, the watcher and\nthe HTTP owner check, each waiting at most `connectionTimeoutMillis` (5 s). Until then the pool should be sized as\n`MAX_PARALLEL_SESSIONS + listener + headroom`, or the parallelism lowered for repo sessions.\n\n## Consequences\n\n- A restart of any process on a current schema issues no DDL and cannot be stalled by, or stall, running traffic.\n- A new migration file is applied by the first process that starts with it, under the lock; it can still wait for\n  running drains (fail fast, retry), but never queues ahead of traffic for longer than 3 s per attempt.\n     1\timport { readdir, readFile } from \"node:fs/promises\";\n     2\timport type pg from \"pg\";\n     3\t\n     4\tconst MIGRATIONS = new URL(\"../migrations/\", import.meta.url);\n     5\t/** Serialises concurrent starters (several ingest replicas plus the orchestrator). */\n     6\tconst LOCK_KEY = \"pi-durable-k8s:inbox-migrate\";\n     7\t/**\n     8\t * How long DDL may wait for a lock. ALTER TABLE queues for ACCESS EXCLUSIVE and, while queued, blocks every other\n     9\t * query on the table; the orchestrator's inbox drain holds row locks for minutes while it prepares a repo workspace.\n    10\t * Failing fast lets the caller retry instead of stalling all traffic behind a migration that cannot run yet.\n    11\t */\n    12\tconst LOCK_TIMEOUT = \"3s\";\n    13\tconst UNDEFINED_TABLE = \"42P01\";\n    14\t\n    15\t/**\n    16\t * Applies the inbox schema: every `NNN_*.sql` in order, each idempotent, each recorded in\n    17\t * `inbox.schema_migrations`. When every file is recorded this is one plain SELECT: no advisory lock, no DDL, so a\n    18\t * process restart never queues behind (or in front of) running traffic. Only a missing file takes the lock and runs.\n    19\t *\n    20\t * A database that predates the table has all files applied but nothing recorded; it takes the slow path once, the\n    21\t * idempotent files re-run (they change nothing) and are recorded, which is the backfill.\n    22\t */\n    23\texport async function applyMigrations(pool: pg.Pool, dir: URL = MIGRATIONS): Promise<void> {\n    24\t  const files = (await readdir(dir)).filter((name) => name.endsWith(\".sql\")).sort();\n    25\t  const applied = await recordedVersions(pool);\n    26\t  if (applied !== undefined && files.every((name) => applied.has(name))) return;\n    27\t\n    28\t  const scripts = new Map(\n    29\t    await Promise.all(\n    30\t      files.map(async (name) => [name, await readFile(new URL(name, dir), \"utf8\")] as const),\n    31\t    ),\n    32\t  );\n    33\t  const client = await pool.connect();\n    34\t  try {\n    35\t    await client.query(\"begin\");\n    36\t    await client.query(`set local lock_timeout = '${LOCK_TIMEOUT}'`);\n    37\t    await client.query(\"select pg_advisory_xact_lock(hashtextextended($1, 0))\", [LOCK_KEY]);\n    38\t    // Another starter may have finished while this one waited for the lock.\n    39\t    await client.query(\"create schema if not exists inbox\");\n    40\t    await client.query(\n    41\t      `create table if not exists inbox.schema_migrations (\n    42\t         version    text primary key,\n    43\t         applied_at timestamptz not null default clock_timestamp()\n    44\t       )`,\n    45\t    );\n    46\t    const done = await recordedVersions(client);\n    47\t    for (const [name, sql] of scripts) {\n    48\t      if (done?.has(name) === true) continue;\n    49\t      await client.query(sql);\n    50\t      await client.query(\"insert into inbox.schema_migrations (version) values ($1)\", [name]);\n    51\t    }\n    52\t    await client.query(\"commit\");\n    53\t  } catch (error) {\n    54\t    await client.query(\"rollback\").catch(() => undefined);\n    55\t    throw error;\n    56\t  } finally {\n    57\t    client.release();\n    58\t  }\n    59\t}\n    60\t\n    61\t/** The recorded versions, or undefined while the table does not exist yet. */\n    62\tasync function recordedVersions(db: pg.Pool | pg.PoolClient): Promise<Set<string> | undefined> {\n    63\t  try {\n    64\t    const { rows } = await db.query<{ version: string }>(\n    65\t      \"select version from inbox.schema_migrations\",\n    66\t    );\n    67\t    return new Set(rows.map((row) => row.version));\n    68\t  } catch (error) {\n    69\t    if ((error as { code?: string }).code === UNDEFINED_TABLE) return undefined;\n    70\t    throw error;\n    71\t  }\n    72\t}\n","isError":false}]}
