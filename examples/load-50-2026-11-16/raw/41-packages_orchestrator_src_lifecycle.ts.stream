ENTRY 12033 {"id":12033,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/orchestrator/test/lifecycle.test.ts:2:import { conversationOfName, interruptedExec, planSuspend } from \"../src/lifecycle.ts\";\npackages/orchestrator/test/lifecycle.test.ts:4:describe(\"interruptedExec\", () => {\npackages/orchestrator/test/lifecycle.test.ts:7:      interruptedExec({ threw: false, result: { ok: false, error: { code: \"aborted\" } } }),\npackages/orchestrator/test/lifecycle.test.ts:10:      interruptedExec({ threw: false, result: { ok: false, error: { code: \"timeout\" } } }),\npackages/orchestrator/test/lifecycle.test.ts:12:    expect(interruptedExec({ threw: true })).toBe(true);\npackages/orchestrator/test/lifecycle.test.ts:16:    expect(interruptedExec({ threw: false, result: { ok: true, value: { exitCode: 0 } } })).toBe(\npackages/orchestrator/test/lifecycle.test.ts:19:    expect(interruptedExec({ threw: false, result: { ok: true, value: { exitCode: 137 } } })).toBe(\npackages/orchestrator/test/lifecycle.test.ts:23:      interruptedExec({ threw: false, result: { ok: false, error: { code: \"spawn_error\" } } }),\npackages/orchestrator/test/lifecycle.test.ts:25:    expect(interruptedExec({ threw: false, result: undefined })).toBe(false);\npackages/orchestrator/test/lifecycle.test.ts:29:describe(\"conversationOfName\", () => {\npackages/orchestrator/test/lifecycle.test.ts:31:    expect(conversationOfName(\"pi-conv-5858\")).toBe(5858);\npackages/orchestrator/test/lifecycle.test.ts:33:      expect(conversationOfName(name)).toBeUndefined();\npackages/orchestrator/test/lifecycle.test.ts:38:describe(\"planSuspend\", () => {\npackages/orchestrator/test/lifecycle.test.ts:44:    const plan = planSuspend({\npackages/orchestrator/test/lifecycle.test.ts:57:    const plan = planSuspend({ ...base, running: [\"pi-conv-7\"], lastUsed: new Map() });\npackages/orchestrator/test/lifecycle.test.ts:62:    const plan = planSuspend({\npackages/orchestrator/test/lifecycle.test.ts:72:    const plan = planSuspend({\npackages/orchestrator/test/lifecycle.test.ts:81:    const plan = planSuspend({\npackages/orchestrator/src/sandboxes.ts:21:import { conversationOfName, interruptedExec, planSuspend } from \"./lifecycle.js\";\npackages/orchestrator/src/sandboxes.ts:174:            if (property === \"exec\" && outcome !== undefined && interruptedExec(outcome)) {\npackages/orchestrator/src/sandboxes.ts:287:        const conversationId = conversationOfName(sandbox.name);\npackages/orchestrator/src/sandboxes.ts:291:      const plan = planSuspend({\npackages/orchestrator/src/sandboxes.ts:381:    const conversationId = conversationOfName(claimName);\npackages/orchestrator/src/lifecycle.ts:13:export function interruptedExec(\npackages/orchestrator/src/lifecycle.ts:25:export function conversationOfName(name: string): number | undefined {\npackages/orchestrator/src/lifecycle.ts:54:export function planSuspend(input: SuspendInput): SuspendPlan {\npackages/orchestrator/src/lifecycle.ts:58:    const conversation = conversationOfName(name);\n","isError":false}]}
