ENTRY 11863 {"id":11863,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { request as httpRequest, createServer } from \"node:http\";\nimport type { IncomingMessage, Server, ServerResponse } from \"node:http\";\nimport { URL } from \"node:url\";\nimport type pg from \"pg\";\nimport {\n  BodyError,\n  chooseModel,\n  chooseRepo,\n  createSession,\n  deleteEventKey,\n  enqueueEvent,\n  errorMessage,\n  getSession,\n  readJsonObject,\n  requestDelete,\n  requeueFailedDelete,\n  sendJson,\n  summarize,\n  UUID,\n} from \"@pi-durable-k8s/session-core\";\nimport type {\n  Authenticator,\n  ModelChoice,\n  ModelPolicy,\n  Principal,\n  SessionRow,\n} from \"@pi-durable-k8s/session-core\";\nimport { parseEventBody } from \"./events.js\";\nimport { log } from \"./log.js\";\n\nexport interface IngestDeps {\n  pool: pg.Pool;\n  authenticate: Authenticator;\n  orchestratorUrl: string;\n  models: ModelPolicy;\n  /** False until the inbox schema is migrated; liveness does not wait for it, readiness and the API do. */\n  schemaReady: () => boolean;\n}\n\nexport function createIngestServer(deps: IngestDeps): Server {\n  return createServer((req, res) => {\n    void handle(req, res, deps).catch((error: unknown) => {\n      log(\"http-error\", { message: errorMessage(error) });\n      if (!res.headersSent) sendJson(res, 500, { error: \"internal error\" });\n      else res.destroy();\n    });\n  });\n}\n\nasync function handle(req: IncomingMessage, res: ServerResponse, deps: IngestDeps): Promise<void> {\n  const url = new URL(req.url ?? \"/\", \"http://localhost\");\n  const parts = url.pathname.split(\"/\").filter(Boolean);\n  const method = req.method ?? \"GET\";\n\n  if (method === \"GET\" && url.pathname === \"/healthz\") {\n    sendJson(res, 200, { status: \"ok\" });\n    return;\n  }\n  if (method === \"GET\" && url.pathname === \"/readyz\") {\n    // Ready means \"can accept events\": the schema is migrated and the database answers. The orchestrator is\n    // deliberately not checked.\n    if (!deps.schemaReady()) {\n      sendJson(res, 503, { status: \"migrating\" });\n      return;\n    }\n    try {\n      await deps.pool.query(\"select 1\");\n      sendJson(res, 200, { status: \"ready\" });\n    } catch {\n      sendJson(res, 503, { status: \"database unavailable\" });\n    }\n    return;\n  }\n\n  if (!deps.schemaReady()) {\n    sendJson(res, 503, { error: \"starting\" }, { \"retry-after\": \"2\" });\n    return;\n  }\n\n  // Every route below is behind this one check.\n  const principal = await deps.authenticate(req.headers);\n  if (principal === undefined) {\n    sendJson(res, 401, { error: \"unauthorized\" }, { \"www-authenticate\": \"Bearer\" });\n    return;\n  }\n\n  if (method === \"POST\" && url.pathname === \"/sessions\") {\n    await postSession(req, res, deps, principal);\n    return;\n  }\n  if (parts[0] !== \"sessions\" || parts[1] === undefined) {\n    sendJson(res, 404, { error: \"not found\" });\n    return;\n  }\n  const session = await ownedSession(deps.pool, parts[1], principal);\n  if (session === undefined) {\n    // Unknown id and someone else's id look the same: the API does not reveal that a session exists.\n    sendJson(res, 404, { error: \"session not found\" });\n    return;\n  }\n\n  if (parts.length === 2 && method === \"GET\") {\n    const summary = await summarize(deps.pool, session);\n    sendJson(res, 200, {\n      sessionId: session.id,\n      status: summary.status,\n      model: modelOf(session, deps.models),\n      ...(session.repo === null ? {} : { repo: session.repo }),\n      ...(session.failure === null ? {} : { failure: session.failure }),\n      createdAt: session.createdAt.toISOString(),\n      lastActivityAt: summary.lastActivityAt.toISOString(),\n      events: summary.events,\n    });\n    return;\n  }\n  if (parts.length === 2 && method === \"DELETE\") {\n    await queueDelete(deps.pool, session, res);\n    return;\n  }\n  if (parts.length === 3 && parts[2] === \"events\" && method === \"POST\") {\n    await postEvent(req, res, deps.pool, session, principal);\n    return;\n  }\n  if (parts.length === 3 && parts[2] === \"stream\" && method === \"GET\") {\n    if (session.status === \"deleted\") {\n      sendJson(res, 410, { error: \"session deleted\" });\n      return;\n    }\n    proxyStream(req, res, deps.orchestratorUrl, session.id);\n    return;\n  }\n  sendJson(res, 404, { error: \"not found\" });\n}\n\n/** Sessions that predate migration 002 have no stored model: they run the default. */\nfunction modelOf(session: SessionRow, policy: ModelPolicy): ModelChoice {\n  return session.model ?? policy.default;\n}\n\nasync function postSession(\n  req: IncomingMessage,\n  res: ServerResponse,\n  deps: IngestDeps,\n  principal: Principal,\n): Promise<void> {\n  let body: Record<string, unknown>;\n  try {\n    body = await readJsonObject(req);\n  } catch (error) {\n    if (error instanceof BodyError) {\n      sendJson(res, 400, { error: error.message });\n      return;\n    }\n    throw error;\n  }\n  const model = chooseModel(deps.models, body);\n  if (typeof model === \"string\") {\n    sendJson(res, 400, { error: model });\n    return;\n  }\n  const repo = chooseRepo(body);\n  if (typeof repo === \"string\") {\n    sendJson(res, 400, { error: repo });\n    return;\n  }\n  const sessionId = await createSession(deps.pool, principal, model, repo);\n  sendJson(res, 201, {\n    sessionId,\n    provider: model.provider,\n    model: model.model,\n    ...(model.reasoning === undefined ? {} : { reasoning: model.reasoning }),\n    ...(repo === undefined\n      ? {}\n      : { repo: repo.repo, ...(repo.branch === undefined ? {} : { branch: repo.branch }) }),\n  });\n}\n\nasync function ownedSession(\n  pool: pg.Pool,\n  id: string,\n  principal: Principal,\n): Promise<SessionRow | undefined> {\n  if (!UUID.test(id)) return undefined;\n  const session = await getSession(pool, id);\n  return session?.ownerSubject === principal.subject ? session : undefined;\n}\n\nasync function postEvent(\n  req: IncomingMessage,\n  res: ServerResponse,\n  pool: pg.Pool,\n  session: SessionRow,\n  principal: Principal,\n): Promise<void> {\n  let parsed;\n  try {\n    parsed = parseEventBody(await readJsonObject(req));\n  } catch (error) {\n    if (error instanceof BodyError) {\n      sendJson(res, 400, { error: error.message });\n      return;\n    }\n    throw error;\n  }\n  if (typeof parsed === \"string\") {\n    sendJson(res, 400, { error: parsed });\n    return;\n  }\n  if (session.status !== \"active\") {\n    sendJson(res, session.status === \"deleted\" ? 410 : 409, {\n      error: `session is ${session.status}`,\n    });\n    return;\n  }\n  const result = await enqueueEvent(\n    pool,\n    {\n      sessionId: session.id,\n      source: `api:${principal.owner}`,\n      sourceEventId: parsed.sourceEventId,\n      kind: parsed.kind,\n      payload: parsed.payload,\n    },\n    { requireActive: true },\n  );\n  if (result.outcome === \"inactive\") {\n    // The session was deleted or failed after the check above (the body is read in between).\n    sendJson(res, result.status === \"deleted\" ? 410 : 409, {\n      error: `session is ${result.status}`,\n    });\n    return;\n  }\n  if (result.outcome === \"conflict\") {\n    sendJson(res, 409, { error: \"sourceEventId was already used for another session\" });\n    return;\n  }\n  // 202 either way: a repeated post is accepted and names the first event.\n  sendJson(res, 202, { eventId: result.eventId, duplicate: result.outcome === \"duplicate\" });\n}\n\nasync function queueDelete(pool: pg.Pool, session: SessionRow, res: ServerResponse): Promise<void> {\n  if (session.status === \"deleted\") {\n    sendJson(res, 202, { sessionId: session.id, status: \"deleted\" });\n    return;\n  }\n  // Status first: events are admitted only while the session is active, so once this commits nothing new can be\n  // accepted, and the delete row below sorts after every event that was. The delete is an inbox row like any other.\n  await requestDelete(pool, session.id);\n  const result = await enqueueEvent(pool, {\n    sessionId: session.id,\n    ...deleteEventKey(session.id),\n    kind: \"delete\",\n    payload: {},\n  });\n  // A repeated DELETE is the client's retry: a delete row that ended `failed` runs again.\n  await requeueFailedDelete(pool, session.id);\n  const eventId = \"eventId\" in result ? result.eventId : undefined;\n  sendJson(res, 202, { sessionId: session.id, status: \"deleting\", eventId });\n}\n\nimport { createServer } from \"node:http\";\nimport type { IncomingMessage, Server, ServerResponse } from \"node:http\";\nimport { errorMessage, getSession, sendJson, UUID } from \"@pi-durable-k8s/session-core\";\nimport type { Authenticator } from \"@pi-durable-k8s/session-core\";\nimport type pg from \"pg\";\nimport type { Host } from \"./host.js\";\nimport { log } from \"./log.js\";\nimport { parseScript } from \"./model.js\";\nimport type { SessionService } from \"./sessions.js\";\nimport { serveStream } from \"./stream.js\";\n\n/** What /readyz reports: ready only once this process holds the storage lock and the Harness is open. */\nexport interface Lifecycle {\n  state: \"waiting-for-lock\" | \"owner\";\n  instance: string;\n  host?: Host;\n  service?: SessionService;\n}\n\nexport interface ServerDeps {\n  lifecycle: Lifecycle;\n  authenticate: Authenticator;\n  /** For the owner check on the stream. Independent of the Pi Durable storage connection. */\n  pool: pg.Pool;\n  /** Mounts the test-only /control surface (PI_ORCH_CONTROL=1). */\n  control: boolean;\n}\n\nasync function readBody(req: IncomingMessage): Promise<string> {\n  const chunks: Buffer[] = [];\n  let size = 0;\n  for await (const chunk of req) {\n    const buffer = chunk as Buffer;\n    size += buffer.length;\n    if (size > 64 * 1024) throw new Error(\"body too large\");\n    chunks.push(buffer);\n  }\n  return Buffer.concat(chunks).toString(\"utf8\");\n}\n\n/**\n * The orchestrator's HTTP surface.\n *   GET /healthz                  liveness: 200 while the process runs\n *   GET /readyz                   200 once this process owns the schema and serves, else 503\n *   GET /sessions/{id}/stream     SSE; bearer token + owner check, the same Authenticator as ingest\n *   /control/...                  test-only (PI_ORCH_CONTROL=1): the Phase 3 scripted-session surface, same auth\n */\nexport function createOrchestratorServer(deps: ServerDeps): Server {\n  const server = createServer((req, res) => {\n    void handle(req, res, deps).catch((error: unknown) => {\n      log(\"http-error\", { message: errorMessage(error) });\n      if (!res.headersSent) sendJson(res, 500, { error: \"internal error\" });\n      else res.destroy();\n    });\n  });\n  server.requestTimeout = 0;\n  return server;\n}\n\nasync function handle(req: IncomingMessage, res: ServerResponse, deps: ServerDeps): Promise<void> {\n  const { lifecycle } = deps;\n  const url = new URL(req.url ?? \"/\", \"http://localhost\");\n  const parts = url.pathname.split(\"/\").filter(Boolean);\n  const method = req.method ?? \"GET\";\n\n  if (method === \"GET\" && url.pathname === \"/healthz\") {\n    sendJson(res, 200, { status: \"ok\", state: lifecycle.state, instance: lifecycle.instance });\n    return;\n  }\n  if (method === \"GET\" && url.pathname === \"/readyz\") {\n    const ready = lifecycle.host !== undefined && lifecycle.service !== undefined;\n    sendJson(res, ready ? 200 : 503, { state: lifecycle.state, instance: lifecycle.instance });\n    return;\n  }\n\n  const principal = await deps.authenticate(req.headers);\n  if (principal === undefined) {\n    sendJson(res, 401, { error: \"unauthorized\" }, { \"www-authenticate\": \"Bearer\" });\n    return;\n  }\n\n  const { host, service } = lifecycle;\n  if (host === undefined || service === undefined) {\n    // Not the owner yet (starting, or waiting for the lock). Clients retry; ingest keeps accepting events.\n    sendJson(res, 503, { error: lifecycle.state }, { \"retry-after\": \"2\" });\n    return;\n  }\n\n  if (method === \"GET\" && parts.length === 3 && parts[0] === \"sessions\" && parts[2] === \"stream\") {\n    const id = parts[1] ?? \"\";\n    const session = UUID.test(id) ? await getSession(deps.pool, id) : undefined;\n    if (session?.ownerSubject !== principal.subject) {\n      sendJson(res, 404, { error: \"session not found\" });\n      return;\n    }\n    if (session.status === \"deleted\") {\n      sendJson(res, 410, { error: \"session deleted\" });\n      return;\n    }\n    const conversationId = await service.ensureConversation(session);\n    await serveStream(req, res, host, service.streams, session.id, conversationId);\n    return;\n  }\n\n  if (deps.control && parts[0] === \"control\") {\n    await handleControl(req, res, host, method, parts.slice(1));\n    return;\n  }\n  sendJson(res, 404, { error: \"not found\" });\n}\n\n/**\n * Test-only. Scripted sessions created straight on the Harness, not through the inbox, with the sandbox claim\n * created eagerly. Kept only so the Phase 3 failure tests keep running unchanged in substance.\n *   POST /control/sessions            body = script JSON\n *   POST /control/sessions/:id/inputs body = script JSON\n *   GET  /control/sessions/:id        status and tool results\n */\nasync function handleControl(\n  req: IncomingMessage,\n  res: ServerResponse,\n  host: Host,\n  method: string,\n  parts: string[],\n): Promise<void> {\n  if (parts[0] !== \"sessions\") {\n    sendJson(res, 404, { error: \"not found\" });\n    return;\n  }\n  if (method === \"POST\" && parts.length === 1) {\n    let script;\n    try {\n      script = parseScript(await readBody(req));\n    } catch (error) {\n      sendJson(res, 400, { error: errorMessage(error) });\n      return;\n    }\n    sendJson(res, 201, await host.startSession(script));\n    return;\n  }\n  const id = Number(parts[1]);\n  if (method === \"POST\" && parts[2] === \"inputs\") {\n    let script;\n    try {\n      script = parseScript(await readBody(req));\n    } catch (error) {\n      sendJson(res, 400, { error: errorMessage(error) });\n      return;\n    }\n    const known = Number.isInteger(id) && (await host.sendInput(id, script));\n    sendJson(res, known ? 202 : 404, known ? { id } : { error: \"unknown session\" });\n    return;\n  }\n  if (method === \"GET\" && parts.length === 2 && Number.isInteger(id)) {\n    const status = await host.status(id);\n    sendJson(res, status === undefined ? 404 : 200, status ?? { error: \"unknown session\" });\n    return;\n  }\n  sendJson(res, 404, { error: \"not found\" });\n}\nimport type { IncomingMessage, ServerResponse } from \"node:http\";\n\nexport function sendJson(\n  res: ServerResponse,\n  status: number,\n  body: unknown,\n  headers: Record<string, string> = {},\n): void {\n  res.writeHead(status, { \"content-type\": \"application/json\", ...headers });\n  res.end(JSON.stringify(body));\n}\n\nexport class BodyError extends Error {}\n\n/** Reads a JSON object body, at most `limit` bytes. Throws BodyError for anything a client got wrong. */\nexport async function readJsonObject(\n  req: IncomingMessage,\n  limit = 128 * 1024,\n): Promise<Record<string, unknown>> {\n  const chunks: Buffer[] = [];\n  let size = 0;\n  for await (const chunk of req) {\n    const buffer = chunk as Buffer;\n    size += buffer.length;\n    if (size > limit) throw new BodyError(\"body too large\");\n    chunks.push(buffer);\n  }\n  const text = Buffer.concat(chunks).toString(\"utf8\");\n  if (text.trim() === \"\") return {};\n  let parsed: unknown;\n  try {\n    parsed = JSON.parse(text);\n  } catch {\n    throw new BodyError(\"body is not valid JSON\");\n  }\n  if (typeof parsed !== \"object\" || parsed === null || Array.isArray(parsed)) {\n    throw new BodyError(\"body must be a JSON object\");\n  }\n  return parsed as Record<string, unknown>;\n}\n\nexport const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;\n\nexport function errorMessage(error: unknown): string {\n  return error instanceof Error ? error.message : String(error);\n}\n","isError":false}]}
ENTRY 11876 {"id":11876,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n### 1. Oversized request bodies reset the connection instead of returning an error\n- Severity: low\n- Confidence: high\n- Location: packages/session-core/src/http.ts:25\n- What happens: When a request body exceeds the limit, throwing inside the stream’s async iterator destroys the request stream and its underlying connection. The ingest handlers catch the `BodyError` and attempt to send a 400 response, but the client can receive a connection reset instead.\n- Evidence: `if (size > limit) throw new BodyError(\"body too large\");`\n- Fix idea: Stop reading without destroying the request before the response is sent, and explicitly handle the remaining body or close the connection after returning the error.\n\nEND-OF-REPORT"}]}
DONE
