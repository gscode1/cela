ENTRY 11709 {"id":11709,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"./packages/sandbox-env/test/stdio-smoke.e2e.ts\n./packages/sandbox-env/test/reattach.e2e.test.ts\npackages/sandbox-env/test/reattach.e2e.test.ts:58:      console.log(`DNS-STALENESS ${log.join(\" | \")}`);\n     1\t# Holds the driver scripts and the Phase 1 bundle (tests/e2e/run.sh loads it). Only one pod mounts it at a time.\n     2\tapiVersion: v1\n     3\tkind: PersistentVolumeClaim\n     4\tmetadata:\n     5\t  name: e2e-driver\n     6\t  namespace: pi-durable-poc\n     7\tspec:\n     8\t  accessModes: [ReadWriteOnce]\n     9\t  storageClassName: longhorn-static\n    10\t  resources:\n    11\t    requests:\n    12\t      storage: 1Gi\n    13\t# The e2e driver Job's identity: exactly what tests/e2e/run-phase{1,3,4}.sh do, in pi-durable-poc only.\n    14\tapiVersion: v1\n    15\tkind: ServiceAccount\n    16\tmetadata:\n    17\t  name: e2e-driver\n    18\t  namespace: pi-durable-poc\n    19\t---\n    20\tapiVersion: rbac.authorization.k8s.io/v1\n    21\tkind: Role\n    22\tmetadata:\n    23\t  name: e2e-driver\n    24\t  namespace: pi-durable-poc\n    25\trules:\n    26\t  # Orchestrator, ingest, sandbox and runner pods: look, wait, delete (kill tests), create the Phase 1 runner.\n    27\t  - apiGroups: [\"\"]\n    28\t    resources: [pods]\n    29\t    verbs: [get, list, watch, create, delete]\n    30\t  - apiGroups: [\"\"]\n    31\t    resources: [pods/exec]\n    32\t    verbs: [create]\n    33\t  - apiGroups: [\"\"]\n    34\t    resources: [pods/log]\n    35\t    verbs: [get]\n    36\t  # pi-orchestrator-b (create/delete), rollout status, scale to 0 and back (Phase 4).\n    37\t  - apiGroups: [apps]\n    38\t    resources: [deployments]\n    39\t    verbs: [get, list, watch, create, delete]\n    40\t  - apiGroups: [apps]\n    41\t    resources: [deployments/scale]\n    42\t    verbs: [get, update, patch]\n    43\t  - apiGroups: [extensions.agents.x-k8s.io]\n    44\t    resources: [sandboxclaims]\n    45\t    verbs: [get, list, watch, create, delete]\n    46\t  - apiGroups: [agents.x-k8s.io]\n    47\t    resources: [sandboxes]\n    48\t    verbs: [get, list, watch]\n    49\t  - apiGroups: [\"\"]\n    50\t    resources: [persistentvolumeclaims]\n    51\t    verbs: [get, list, delete]\n    52\t  # deploy/gen-api-secret.sh (create if missing) and the sandboxd-auth presence check.\n    53\t  - apiGroups: [\"\"]\n    54\t    resources: [secrets]\n    55\t    verbs: [get, create]\n    56\t  # `kubectl wait` for the CNPG cluster. Pod exec into pi-pg-1 (pg_terminate_backend) is the pods/exec rule above.\n    57\t  - apiGroups: [postgresql.cnpg.io]\n    58\t    resources: [clusters]\n    59\t    verbs: [get, list, watch]\n    60\t---\n    61\tapiVersion: rbac.authorization.k8s.io/v1\n    62\tkind: RoleBinding\n    63\tmetadata:\n    64\t  name: e2e-driver\n    65\t  namespace: pi-durable-poc\n    66\tsubjects:\n    67\t  - kind: ServiceAccount\n    68\t    name: e2e-driver\n    69\t    namespace: pi-durable-poc\n    70\troleRef:\n    71\t  apiGroup: rbac.authorization.k8s.io\n    72\t  kind: Role\n    73\t  name: e2e-driver\n    74\t# Identity, RBAC and the code volume of the in-cluster e2e driver (the Job that runs tests/e2e/run-phase*.sh).\n    75\t# Applied by tests/e2e/run.sh. Namespace-scoped: nothing here is cluster-wide.\n    76\tapiVersion: kustomize.config.k8s.io/v1beta1\n    77\tkind: Kustomization\n    78\tresources:\n    79\t  - driver-rbac.yaml\n    80\t  - driver-pvc.yaml\n    81\t  - runner-rbac.yaml\n    82\t# Throwaway identity for the e2e runner pod. Namespace-scoped, nothing cluster-wide.\n    83\tapiVersion: v1\n    84\tkind: ServiceAccount\n    85\tmetadata:\n    86\t  name: e2e-runner\n    87\t  namespace: pi-durable-poc\n    88\t---\n    89\tapiVersion: rbac.authorization.k8s.io/v1\n    90\tkind: Role\n    91\tmetadata:\n    92\t  name: e2e-runner\n    93\t  namespace: pi-durable-poc\n    94\trules:\n    95\t  - apiGroups: [extensions.agents.x-k8s.io]\n    96\t    resources: [sandboxclaims]\n    97\t    verbs: [get, list, watch, create, delete]\n    98\t  - apiGroups: [agents.x-k8s.io]\n    99\t    resources: [sandboxes]\n   100\t    verbs: [get, list, watch, create, delete]\n   101\t  - apiGroups: [\"\"]\n   102\t    resources: [pods, services]\n   103\t    verbs: [get]\n   104\t---\n   105\tapiVersion: rbac.authorization.k8s.io/v1\n   106\tkind: RoleBinding\n   107\tmetadata:\n   108\t  name: e2e-runner\n   109\t  namespace: pi-durable-poc\n   110\tsubjects:\n   111\t  - kind: ServiceAccount\n   112\t    name: e2e-runner\n   113\t    namespace: pi-durable-poc\n   114\troleRef:\n   115\t  apiGroup: rbac.authorization.k8s.io\n   116\t  kind: Role\n   117\t  name: e2e-runner\n","isError":false}]}
