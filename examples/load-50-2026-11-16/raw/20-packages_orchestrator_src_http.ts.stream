ENTRY 11543 {"id":11543,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"  const principal = await deps.authenticate(req.headers);\n  if (principal === undefined) {\n    sendJson(res, 401, { error: \"unauthorized\" }, { \"www-authenticate\": \"Bearer\" });\n    return;\n  }\n\n  const { host, service } = lifecycle;\n  if (host === undefined || service === undefined) {\n    // Not the owner yet (starting, or waiting for the lock). Clients retry; ingest keeps accepting events.\n    sendJson(res, 503, { error: lifecycle.state }, { \"retry-after\": \"2\" });\n    return;\n  }\n\n  if (method === \"GET\" && parts.length === 3 && parts[0] === \"sessions\" && parts[2] === \"stream\") {\n    const id = parts[1] ?? \"\";\n    const session = UUID.test(id) ? await getSession(deps.pool, id) : undefined;\n    if (session?.ownerSubject !== principal.subject) {\n      sendJson(res, 404, { error: \"session not found\" });\n      return;\n    }\n    if (session.status === \"deleted\") {\n      sendJson(res, 410, { error: \"session deleted\" });\n      return;\n    }\n    const conversationId = await service.ensureConversation(session);\n    await serveStream(req, res, host, service.streams, session.id, conversationId);\n    return;\n  }\n  /**\n   * The session's conversation id, creating the conversation on first use. Serialised per session, so the\n   * stream handler and the inbox loop cannot create two. A crash between creating the conversation and\n   * storing its id leaves one empty, unreferenced conversation behind (documented limit).\n   */\n  async ensureConversation(session: SessionRow): Promise<number> {\n    if (session.conversationId !== null) return session.conversationId;\n    let creating = this.#creating.get(session.id);\n    if (creating === undefined) {\n      creating = this.#create(session.id).finally(() => this.#creating.delete(session.id));\n      this.#creating.set(session.id, creating);\n    }\n    return creating;\n  }\n\n  async #create(sessionId: string): Promise<number> {\n    const current = await getSession(this.#pool, sessionId);\n    if (current?.conversationId != null) return current.conversationId;\n    const conversationId = await this.#host.createConversation(\n      current?.model ?? this.#options.defaultModel,\n    );\n    await this.#pool.query(\n      \"update inbox.sessions set conversation_id = $1 where id = $2 and conversation_id is null\",\n      [conversationId, sessionId],\n    );\n    log(\"conversation-created\", { session: sessionId, conversation: conversationId });\n    return conversationId;\n  /**\n   * Stop the session, delete the SandboxClaim and PVC, mark the session deleted. The conversation's stored state\n   * stays: the Postgres adapter can only delete it in a maintenance window (docs/session-api.md).\n   */\n  async #delete(session: SessionRow): Promise<void> {\n    log(\"session-delete-start\", { session: session.id });\n    // Record what the session holds before anything is revoked, then revoke its OneCLI agent first: from that moment\n    // its proxy token is dead, whatever happens to the claim after. A plain session has no OneCLI objects.\n    await writeTombstone(this.#pool, session);\n    await this.#options.repos?.teardown(session);\n    const conversationId = session.conversationId;\n    if (conversationId !== null) {\n      await this.#host.abort(conversationId);\n      this.streams.closeSession(session.id, \"deleted\");\n      await this.#host.destroySandbox(conversationId);\n    }\n    await this.#pool.query(\n      \"update inbox.sessions set status = 'deleted', last_activity_at = clock_timestamp() where id = $1\",\n      [session.id],\n    );\n    await completeTombstone(this.#pool, session.id);\n    log(\"session-deleted\", { session: session.id });\n  conversationId: number,\n): Promise<void> {\n  const watched = await host.watch(conversationId);\n  if (watched === undefined) {\n    res.writeHead(404, { \"content-type\": \"application/json\" });\n    res.end(JSON.stringify({ error: \"conversation not found\" }));\n    return;\n  }\n  const { conversation, watch } = watched;\n  let cursor = parseLastEventId(req.headers[\"last-event-id\"]);\n\n  res.writeHead(200, {\n    \"content-type\": \"text/event-stream\",\n    \"cache-control\": \"no-cache\",\n    connection: \"keep-alive\",\n    \"x-accel-buffering\": \"no\",\n  });\n  res.write(\"retry: 2000\\n\\n\");\n\n  let lastLive = \"\";\n  const finish = (reason?: string): void => {\n    clearInterval(keepalive);\n    unregister();\n    void watch.stop();\n    if (res.writableEnded || res.destroyed) return;\n    if (reason !== undefined) res.write(`event: ${reason}\\ndata: {}\\n\\n`);\n    res.end();\n  };\n  const keepalive = setInterval(() => {\n    if (!res.destroyed) res.write(\": keepalive\\n\\n\");\n  }, KEEPALIVE_MS);\n  const unregister = streams.add(sessionId, finish);\n  res.on(\"close\", () => finish());\n}\n\n/**\n * Puts a `failed` delete row back to `pending`. A repeated DELETE calls it: the row is deduplicated, so without this\n * a delete that failed (rows from before deletes were retried without limit, or a permanent error since fixed) could\n * never run again.\n */\nexport async function requeueFailedDelete(pool: pg.Pool, sessionId: string): Promise<void> {\n  await pool.query(\n    `update inbox.events set status = 'pending', attempts = 0, error = null\n      where session_id = $1 and kind = 'delete' and status = 'failed'`,\n    [sessionId],\n  );\n}\n\n/** Marks an active session as being deleted, so no further events are accepted. Idempotent. */\nexport async function requestDelete(pool: pg.Pool, sessionId: string): Promise<void> {\n  await pool.query(\n    \"update inbox.sessions set status = 'deleting', last_activity_at = clock_timestamp() where id = $1 and status in ('active', 'failed')\",\n    [sessionId],\n  );\n}\n\nexport interface SessionSummary {\n  status: SessionStatus;\n  lastActivityAt: Date;\n  events: Record<EventStatus, number>;\n}\n\nexport async function summarize(pool: pg.Pool, session: SessionRow): Promise<SessionSummary> {\n  `persistentvolumeclaims`, namespace-scoped.\n\n## Deletion\n\n`DELETE /sessions/{id}` answers `202` and queues a `delete` row. From that moment new events get `409` (`410` once deleted). Admission is one conditional insert (`session is active`), so an event whose body was still being read when the session was deleted is refused too, and the session is marked `deleting` before the delete row is written, so every accepted event sorts before it; events\naccepted earlier are still processed first, in order. Then the orchestrator:\n\n1. aborts the conversation (withdraws queued input, stops the running turn),\n2. ends the session's open streams (`deleted`),\n3. stops the bridge and deletes the SandboxClaim, then the workspace PVC, and waits until both are gone,\n4. marks the session `deleted` (`410` from then on).\n\n**Conversation state is not removed live.** The Postgres adapter's `deleteConversation` is a maintenance helper: it\n","isError":false}]}
ENTRY 11576 {"id":11576,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n\n### 1. A stream can open after session deletion has closed its streams\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/http.ts:96\n- What happens: A stream request can read a session before or during deletion, then register its stream after deletion has already called `closeSession`. The stream remains open without receiving the `deleted` event, even after the session is marked deleted. A request for a session already in `deleting` state is also allowed through this check.\n- Evidence: `if (session.status === \"deleted\")` is followed by `await service.ensureConversation(session)` and `await serveStream(...)`; stream registration happens later, after `host.watch`.\n- Fix idea: Coordinate stream registration with deletion and recheck session status after registration, closing the stream if deletion has begun or completed.\n\nEND-OF-REPORT"}]}
DONE
