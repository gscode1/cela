ENTRY 11458 {"id":11458,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport { once } from \"node:events\";\n     2\timport type { IncomingMessage, ServerResponse } from \"node:http\";\n     3\timport { BACKGROUND_CONTEXT as context } from \"@earendil-works/chord/context\";\n     4\timport type { ConversationView, EntryRecord } from \"@earendil-works/pi-durable\";\n     5\timport { errorMessage } from \"@pi-durable-k8s/session-core\";\n     6\timport type { Host } from \"./host.js\";\n     7\timport { toEvent } from \"./host.js\";\n     8\timport { log } from \"./log.js\";\n     9\timport type { StreamRegistry } from \"./sessions.js\";\n    10\t\n    11\tconst KEEPALIVE_MS = 15_000;\n    12\tconst GAP_PAGE = 100;\n    13\t\n    14\t/** What the client sees of the run in progress. Carries no SSE id: it is not addressable by a cursor. */\n    15\texport interface LiveEvent {\n    16\t  running: boolean;\n    17\t  /** Inputs queued behind the running turn. */\n    18\t  queued: number;\n    19\t  /** The throttled partial answer of the response being generated, if any. */\n    20\t  partial?: string;\n    21\t  tools?: { callId: string; name: string; status: string }[];\n    22\t  /** Why the newest run ended without an answer, e.g. `aborted`. */\n    23\t  runFailure?: string;\n    24\t}\n    25\t\n    26\tfunction asObject(value: unknown): Record<string, unknown> | undefined {\n    27\t  return typeof value === \"object\" && value !== null && !Array.isArray(value)\n    28\t    ? (value as Record<string, unknown>)\n    29\t    : undefined;\n    30\t}\n    31\t\n    32\t/** Projects `pi.live` and `pi.inbox` of a conversation view. Defensive: these are plain JSON documents. */\n    33\texport function liveEvent(docs: ConversationView[\"docs\"]): LiveEvent {\n    34\t  const live = asObject(docs[\"pi.live\"]);\n    35\t  const inbox = asObject(docs[\"pi.inbox\"]);\n    36\t  const items = inbox?.items;\n    37\t  const event: LiveEvent = {\n    38\t    running: live?.run !== undefined,\n    39\t    queued: Array.isArray(items) ? items.length : 0,\n    40\t  };\n    41\t  const content = asObject(asObject(live?.generation)?.message)?.content;\n    42\t  if (Array.isArray(content)) {\n    43\t    const partial = content\n    44\t      .map((block) => {\n    45\t        const b = asObject(block);\n    46\t        return b?.type === \"text\" && typeof b.text === \"string\" ? b.text : \"\";\n    47\t      })\n    48\t      .join(\"\");\n    49\t    if (partial !== \"\") event.partial = partial;\n    50\t  }\n    51\t  if (Array.isArray(live?.tools)) {\n    52\t    event.tools = (live.tools as unknown[]).flatMap((slot) => {\n    53\t      const s = asObject(slot);\n    54\t      return s !== undefined\n    55\t        ? [{ callId: String(s.callId), name: String(s.name), status: String(s.status) }]\n    56\t        : [];\n    57\t    });\n    58\t  }\n    59\t  const failure = asObject(live?.runFailure);\n    60\t  if (typeof failure?.reason === \"string\") event.runFailure = failure.reason;\n    61\t  return event;\n    62\t}\n    63\t\n    64\t/** Only entries that carry model messages are streamed (inputs, answers, tool calls and results). */\n    65\tfunction entryEvent(\n    66\t  entry: EntryRecord,\n    67\t): { id: number; kind: string; messages: unknown[] } | undefined {\n    68\t  // System messages (the rendered system prompt) are the host's, not the conversation's: never streamed.\n    69\t  const messages = (entry.model ?? []).filter((message) => message.role !== \"system\");\n    70\t  if (messages.length === 0) return undefined;\n    71\t  return { id: entry.id, kind: entry.kind, messages: messages.map(toEvent) };\n    72\t}\n    73\t\n    74\texport function parseLastEventId(header: string | string[] | undefined): number {\n    75\t  const raw = Array.isArray(header) ? header[0] : header;\n    76\t  const value = Number(raw);\n    77\t  return raw !== undefined && Number.isSafeInteger(value) && value > 0 ? value : 0;\n    78\t}\n    79\t\n    80\t/**\n    81\t * Writes a chunk and waits for the socket to drain, or for the client to go away. Whichever event loses the race must\n    82\t * drop its listener: a slow client under backpressure would otherwise pile up one `close` listener per write.\n    83\t */\n    84\texport async function write(res: ServerResponse, chunk: string): Promise<void> {\n    85\t  if (res.destroyed || res.writableEnded) return;\n    86\t  if (!res.write(chunk)) {\n    87\t    const done = new AbortController();\n    88\t    try {\n    89\t      await Promise.race([\n    90\t        once(res, \"drain\", { signal: done.signal }),\n    91\t        once(res, \"close\", { signal: done.signal }),\n    92\t      ]);\n    93\t    } catch {\n    94\t      // the stream failed or was aborted; the caller sees the closed response on its next write\n    95\t    } finally {\n    96\t      done.abort();\n    97\t    }\n    98\t  }\n    99\t}\n   100\t\n   101\t/**\n   102\t * Server-sent events for one conversation, built on `Conversation.watch()` (the conversation view).\n   103\t *\n   104\t *  - `event: entry`, `id: <entry id>`: a committed transcript entry, once, in order. The id is the cursor.\n   105\t *  - `event: live`, no id: the run in progress (partial answer, tool calls, queue). Sent whole on connect and\n   106\t *    on every change; not replayed from a cursor, so a reconnect starts from the current state of the response.\n   107\t *  - `event: deleted`: the session was deleted; the stream ends.\n   108\t *\n   109\t * A client reconnects with `Last-Event-ID: <last entry id>`: entries after it are sent first (those the\n   110\t * watch's window no longer holds are read with `Conversation.entries()`), then live updates. Without the\n   111\t * header the whole transcript is replayed from the start.\n   112\t */\n   113\texport async function serveStream(\n   114\t  req: IncomingMessage,\n   115\t  res: ServerResponse,\n   116\t  host: Host,\n   117\t  streams: StreamRegistry,\n   118\t  sessionId: string,\n   119\t  conversationId: number,\n   120\t): Promise<void> {\n   121\t  const watched = await host.watch(conversationId);\n   122\t  if (watched === undefined) {\n   123\t    res.writeHead(404, { \"content-type\": \"application/json\" });\n   124\t    res.end(JSON.stringify({ error: \"conversation not found\" }));\n   125\t    return;\n   126\t  }\n   127\t  const { conversation, watch } = watched;\n   128\t  let cursor = parseLastEventId(req.headers[\"last-event-id\"]);\n   129\t\n   130\t  res.writeHead(200, {\n   131\t    \"content-type\": \"text/event-stream\",\n   132\t    \"cache-control\": \"no-cache\",\n   133\t    connection: \"keep-alive\",\n   134\t    \"x-accel-buffering\": \"no\",\n   135\t  });\n   136\t  res.write(\"retry: 2000\\n\\n\");\n   137\t\n   138\t  let lastLive = \"\";\n   139\t  const finish = (reason?: string): void => {\n   140\t    clearInterval(keepalive);\n   141\t    unregister();\n   142\t    void watch.stop();\n   143\t    if (res.writableEnded || res.destroyed) return;\n   144\t    if (reason !== undefined) res.write(`event: ${reason}\\ndata: {}\\n\\n`);\n   145\t    res.end();\n   146\t  };\n   147\t  const keepalive = setInterval(() => {\n   148\t    if (!res.destroyed) res.write(\": keepalive\\n\\n\");\n   149\t  }, KEEPALIVE_MS);\n   150\t  const unregister = streams.add(sessionId, finish);\n   151\t  res.on(\"close\", () => finish());\n   152\t\n   153\t  const sendEntry = async (entry: EntryRecord): Promise<void> => {\n   154\t    if (entry.id <= cursor) return;\n   155\t    cursor = entry.id;\n   156\t    const event = entryEvent(entry);\n   157\t    if (event !== undefined) {\n   158\t      await write(res, `id: ${String(event.id)}\\nevent: entry\\ndata: ${JSON.stringify(event)}\\n\\n`);\n   159\t    }\n   160\t  };\n   161\t\n   162\t  const emit = async (view: ConversationView): Promise<void> => {\n   163\t    // The window may start after the client's cursor (long outage, or a fresh connect): read the gap.\n   164\t    if (view.before !== undefined && view.before > cursor) {\n   165\t      let after = cursor;\n   166\t      for (;;) {\n   167\t        const page = await conversation.entries(\n   168\t          {\n   169\t            minEntryId: (after + 1) as EntryRecord[\"id\"],\n   170\t            maxEntryId: view.before,\n   171\t            order: \"ascending\",\n   172\t          },\n   173\t          GAP_PAGE,\n   174\t          undefined,\n   175\t          context,\n   176\t        );\n   177\t        for (const entry of page.items) await sendEntry(entry);\n   178\t        const newest = page.items.at(-1);\n   179\t        if (newest === undefined || page.items.length < GAP_PAGE) break;\n   180\t        after = newest.id;\n   181\t      }\n   182\t    }\n   183\t    for (const entry of view.entries) await sendEntry(entry);\n   184\t    const live = JSON.stringify(liveEvent(view.docs));\n   185\t    if (live !== lastLive) {\n   186\t      lastLive = live;\n   187\t      await write(res, `event: live\\ndata: ${live}\\n\\n`);\n   188\t    }\n   189\t  };\n   190\t\n   191\t  try {\n   192\t    await emit(watch.value);\n   193\t  } catch (error) {\n   194\t    log(\"stream-failed\", { session: sessionId, message: errorMessage(error) });\n   195\t    finish();\n   196\t    return;\n   197\t  }\n   198\t  watch.start(async (call) => {\n   199\t    if (call.kind !== \"value\") return;\n   200\t    await emit(call.value);\n   201\t  });\n   202\t  // The watch ends when the Harness closes (orchestrator shutdown) or fails: end the response so the client reconnects.\n   203\t  void watch.closed.then(() => {\n   204\t    finish();\n   205\t  });\n   206\t}\n     1\timport { writeSync } from \"node:fs\";\n     2\timport type pg from \"pg\";\n     3\timport {\n     4\t  completeTombstone,\n     5\t  errorMessage,\n     6\t  failSession,\n     7\t  getSession,\n     8\t  writeTombstone,\n     9\t} from \"@pi-durable-k8s/session-core\";\n    10\timport type { InboxEvent, ModelChoice, SessionRow } from \"@pi-durable-k8s/session-core\";\n    11\timport { terminalFailure } from \"./failure.js\";\n    12\timport type { RunOutcome } from \"./failure.js\";\n    13\timport { GithubDeniedError } from \"./github-app.js\";\n    14\timport type { Host } from \"./host.js\";\n    15\timport { log } from \"./log.js\";\n    16\timport { RepoUnavailableError } from \"./repo-access.js\";\n    17\timport type { RepoAccess } from \"./repo-access.js\";\n    18\timport { WorkspaceLostError } from \"./workspace.js\";\n    19\timport { RunWatcher } from \"./watcher.js\";\n    20\timport type { Watched } from \"./watcher.js\";\n    21\t\n    22\t/** An event that can never succeed (deleted session, malformed payload): the row is marked failed, not retried. */\n    23\texport class PermanentError extends Error {}\n    24\t\n    25\t/** Open SSE streams by session, so deleting a session can end them. */\n    26\texport class StreamRegistry {\n    27\t  readonly #streams = new Map<string, Set<(reason: string) => void>>();\n    28\t\n    29\t  add(sessionId: string, close: (reason: string) => void): () => void {\n    30\t    let set = this.#streams.get(sessionId);\n    31\t    if (set === undefined) {\n    32\t      set = new Set();\n    33\t      this.#streams.set(sessionId, set);\n    34\t    }\n    35\t    set.add(close);\n    36\t    return () => {\n    37\t      set.delete(close);\n    38\t      if (set.size === 0) this.#streams.delete(sessionId);\n    39\t    };\n    40\t  }\n    41\t\n    42\t  closeSession(sessionId: string, reason: string): void {\n    43\t    for (const close of [...(this.#streams.get(sessionId) ?? [])]) close(reason);\n    44\t  }\n    45\t}\n    46\t\n    47\texport interface SessionServiceOptions {\n    48\t  /**\n    49\t   * Honour `payload.testFault` on inbox rows. Test-only (PI_ORCH_TEST_FAULTS=1): lets the e2e suite kill the\n    50\t   * orchestrator between \"submitted to Pi Durable\" and \"row marked submitted\".\n    51\t   */\n    52\t  testFaults: boolean;\n    53\t  /** Model of a session that predates the per-session model (null in `inbox.sessions`). */\n    54\t  defaultModel: ModelChoice;\n    55\t  /** Model turns one session may use in total. A session that reaches it is `failed`. */\n    56\t  turnBudget: number;\n    57\t  /** Repo workspaces (Phase 4c). Without it a session that asked for a repo is refused at its first input. */\n    58\t  repos?: RepoAccess;\n    59\t}\n    60\t\n    61\t/**\n    62\t * Maps API sessions onto Pi Durable and applies inbox events. One session = one conversation = one\n    63\t * SandboxClaim `pi-conv-<conversation id>` = one PVC; the claim is created lazily by the Harness at the first\n    64\t * tool call, never here.\n    65\t */\n    66\texport class SessionService {\n    67\t  readonly #pool: pg.Pool;\n    68\t  readonly #host: Host;\n    69\t  readonly #options: SessionServiceOptions;\n    70\t  readonly streams = new StreamRegistry();\n    71\t  readonly #creating = new Map<string, Promise<number>>();\n    72\t  readonly #watcher: RunWatcher;\n    73\t\n    74\t  constructor(pool: pg.Pool, host: Host, options: SessionServiceOptions) {\n    75\t    this.#pool = pool;\n    76\t    this.#host = host;\n    77\t    this.#options = options;\n    78\t    this.#watcher = new RunWatcher({\n    79\t      lookup: (conversationId, requestId) => host.submissionState(conversationId, requestId),\n    80\t      onUnanswered: (watched, outcome) => this.#runEnded(watched, outcome),\n    81\t      onError: (error) => {\n    82\t        log(\"run-watch-failed\", { message: errorMessage(error) });\n    83\t      },\n    84\t    });\n    85\t  }\n    86\t\n    87\t  stop(): void {\n    88\t    this.#watcher.stop();\n    89\t  }\n    90\t\n    91\t  /**\n    92\t   * After a start: watch the inputs of live sessions that were handed over recently, because the process that\n    93\t   * handed them over may have died before it saw the run fail. Settled ones drop out at the first poll.\n    94\t   */\n    95\t  async recoverWatches(): Promise<void> {\n    96\t    const { rows } = await this.#pool.query<{\n    97\t      id: string;\n    98\t      session_id: string;\n    99\t      conversation_id: string;\n   100\t    }>(\n   101\t      `select e.id, e.session_id, s.conversation_id\n   102\t         from inbox.events e join inbox.sessions s on s.id = e.session_id\n   103\t        where e.kind in ('message', 'steer') and e.status = 'submitted'\n   104\t          and s.status = 'active' and s.conversation_id is not null\n   105\t          and e.submitted_at > clock_timestamp() - interval '24 hours'\n   106\t        order by e.submitted_at desc limit 1000`,\n   107\t    );\n   108\t    for (const row of rows) {\n   109\t      this.#watcher.add({\n   110\t        sessionId: row.session_id,\n   111\t        conversationId: Number(row.conversation_id),\n   112\t        requestId: row.id,\n   113\t      });\n   114\t    }\n   115\t    if (rows.length > 0) log(\"run-watches-recovered\", { count: rows.length });\n   116\t    await this.#recoverFailedAborts();\n   117\t  }\n   118\t\n   119\t  /**\n   120\t   * A session is marked `failed` before its conversation is aborted, so a crash or a storage error in between leaves a\n   121\t   * failed session whose queued inputs still run, and nothing watches a failed session. Abort the recently failed\n   122\t   * ones again: `abort` is idempotent and a no-op on an idle conversation.\n   123\t   */\n   124\t  async #recoverFailedAborts(): Promise<void> {\n   125\t    const { rows } = await this.#pool.query<{ id: string; conversation_id: string }>(\n   126\t      `select id, conversation_id from inbox.sessions\n   127\t        where status = 'failed' and conversation_id is not null\n   128\t          and last_activity_at > clock_timestamp() - interval '24 hours'\n   129\t        order by last_activity_at desc limit 1000`,\n   130\t    );\n   131\t    for (const row of rows) {\n   132\t      try {\n   133\t        await this.#host.abort(Number(row.conversation_id));\n   134\t      } catch (error) {\n   135\t        log(\"failed-session-abort-failed\", { session: row.id, message: errorMessage(error) });\n   136\t      }\n   137\t    }\n   138\t  }\n   139\t\n   140\t  /**\n   141\t   * A submission ended without an answer. Rejected model credentials and a used-up turn budget end the session\n   142\t   * for good (`failed`); anything else leaves it active. The stored message is ours, never the provider's text.\n   143\t   */\n   144\t  async #runEnded(watched: Watched, outcome: RunOutcome): Promise<void> {\n   145\t    const failure = terminalFailure(outcome);\n   146\t    if (failure === undefined) return;\n   147\t    await this.#failSession(watched.sessionId, watched.conversationId, failure);\n   148\t  }\n   149\t\n   150\t  async #failSession(\n   151\t    sessionId: string,\n   152\t    conversationId: number | null,\n   153\t    failure: string,\n   154\t  ): Promise<void> {\n   155\t    const changed = await failSession(this.#pool, sessionId, failure);\n   156\t    if (changed) {\n   157\t      log(\"session-failed\", { session: sessionId, failure });\n   158\t    } else if ((await getSession(this.#pool, sessionId))?.status !== \"failed\") {\n   159\t      return;\n   160\t    }\n   161\t    // Withdraw whatever queued behind the failed run, so nothing more is sent to the provider. Also when the session\n   162\t    // was failed already: the status commits before the abort, so a caller whose abort died (or whose process did)\n   163\t    // retries here and must not find \"nothing changed\" and stop. A deleting or deleted session is not ours to abort.\n   164\t    if (conversationId !== null) await this.#host.abort(conversationId);\n   165\t  }\n   166\t\n   167\t  /**\n   168\t   * The session's conversation id, creating the conversation on first use. Serialised per session, so the\n   169\t   * stream handler and the inbox loop cannot create two. A crash between creating the conversation and\n   170\t   * storing its id leaves one empty, unreferenced conversation behind (documented limit).\n   171\t   */\n   172\t  async ensureConversation(session: SessionRow): Promise<number> {\n   173\t    if (session.conversationId !== null) return session.conversationId;\n   174\t    let creating = this.#creating.get(session.id);\n   175\t    if (creating === undefined) {\n   176\t      creating = this.#create(session.id).finally(() => this.#creating.delete(session.id));\n   177\t      this.#creating.set(session.id, creating);\n   178\t    }\n   179\t    return creating;\n   180\t  }\n   181\t\n   182\t  async #create(sessionId: string): Promise<number> {\n   183\t    const current = await getSession(this.#pool, sessionId);\n   184\t    if (current?.conversationId != null) return current.conversationId;\n   185\t    const conversationId = await this.#host.createConversation(\n   186\t      current?.model ?? this.#options.defaultModel,\n   187\t    );\n   188\t    await this.#pool.query(\n   189\t      \"update inbox.sessions set conversation_id = $1 where id = $2 and conversation_id is null\",\n   190\t      [conversationId, sessionId],\n   191\t    );\n   192\t    log(\"conversation-created\", { session: sessionId, conversation: conversationId });\n   193\t    return conversationId;\n   194\t  }\n   195\t\n   196\t  /** Applies one inbox event. Resolves when it is durably handed over; throws PermanentError if it never can be. */\n   197\t  async apply(event: InboxEvent, session: SessionRow): Promise<void> {\n   198\t    if (session.status === \"deleted\") throw new PermanentError(\"session is deleted\");\n   199\t    switch (event.kind) {\n   200\t      case \"message\":\n   201\t      case \"steer\": {\n   202\t        const text = event.payload.text;\n   203\t        if (typeof text !== \"string\" || text === \"\") throw new PermanentError(\"event has no text\");\n   204\t        if (session.status === \"failed\") {\n   205\t          // Retries an abort that failed when the session was failed (see #failSession); throws, and so retries the\n   206\t          // row, if the abort fails again.\n   207\t          if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n   208\t          throw new PermanentError(\"session has failed\");\n   209\t        }\n   210\t        const conversationId = await this.ensureConversation(session);\n   211\t        await this.#withinBudget(session, conversationId);\n   212\t        // Before the first turn: OneCLI agent, token and clone. A session without a repo skips all of it.\n   213\t        if (session.repo !== null) await this.#prepareRepo(session, conversationId);\n   214\t        const requestId = event.id;\n   215\t        const faultArmed =\n   216\t          this.#options.testFaults && event.payload.testFault === \"exit-after-submit\";\n   217\t        const alreadyAdmitted =\n   218\t          faultArmed && (await this.#host.hasSubmission(conversationId, requestId));\n   219\t        await this.#host.submitInput(conversationId, {\n   220\t          text,\n   221\t          requestId,\n   222\t          steer: event.kind === \"steer\",\n   223\t        });\n   224\t        this.#watcher.add({ sessionId: session.id, conversationId, requestId });\n   225\t        if (faultArmed && !alreadyAdmitted) {\n   226\t          // After the durable hand-over, before the row says so: exactly the window test 4 needs.\n   227\t          // Synchronous write: stdout to a pipe is async and process.exit would drop the line.\n   228\t          writeSync(\n   229\t            1,\n   230\t            `${JSON.stringify({ event: \"test-fault\", fault: \"exit-after-submit\", id: event.id })}\\n`,\n   231\t          );\n   232\t          process.exit(137);\n   233\t        }\n   234\t        return;\n   235\t      }\n   236\t      case \"cancel\": {\n   237\t        if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n   238\t        return;\n   239\t      }\n   240\t      case \"delete\": {\n   241\t        await this.#delete(session);\n   242\t        return;\n   243\t      }\n   244\t    }\n   245\t  }\n   246\t\n   247\t  /**\n   248\t   * Provisions the repo session's GitHub access and makes sure its clone exists. What no retry can fix ends the input\n   249\t   * for good (and, for a lost workspace or refused access, the session): the agent must not run a turn in a workspace\n   250\t   * that is not the one the user asked for. Anything else throws as is, so the inbox retries it.\n   251\t   */\n   252\t  async #prepareRepo(session: SessionRow, conversationId: number): Promise<void> {\n   253\t    const repos = this.#options.repos;\n   254\t    if (repos === undefined) throw new PermanentError(\"repository workspaces are not configured\");\n   255\t    try {\n   256\t      await repos.prepare(session, await this.#host.workspaceEnv(conversationId));\n   257\t    } catch (error) {\n   258\t      if (error instanceof WorkspaceLostError) {\n   259\t        await this.#failSession(session.id, conversationId, error.message);\n   260\t        throw new PermanentError(error.message);\n   261\t      }\n   262\t      if (error instanceof GithubDeniedError) {\n   263\t        const failure =\n   264\t          \"GitHub refused access to the repository: is the GitHub App installed on it?\";\n   265\t        await this.#failSession(session.id, conversationId, failure);\n   266\t        throw new PermanentError(failure);\n   267\t      }\n   268\t      if (error instanceof RepoUnavailableError) throw new PermanentError(error.message);\n   269\t      throw error;\n   270\t    }\n   271\t  }\n   272\t\n   273\t  /**\n   274\t   * The per-session turn budget, checked before every input: a session that used all its turns fails for good, and\n   275\t   * otherwise the conversation's `maxTurns` is set to what is left, so a single long run cannot overshoot it.\n   276\t   * Turns are model responses, counted from the stored transcript, so a restart does not reset the count.\n   277\t   */\n   278\t  async #withinBudget(session: SessionRow, conversationId: number): Promise<void> {\n   279\t    const used = await this.#host.turnsUsed(conversationId);\n   280\t    const left = this.#options.turnBudget - used;\n   281\t    if (left <= 0) {\n   282\t      const failure = terminalFailure({ reason: \"turn_limit\" });\n   283\t      await this.#failSession(session.id, conversationId, failure ?? \"turn budget exhausted\");\n   284\t      throw new PermanentError(\"turn budget exhausted\");\n   285\t    }\n   286\t    await this.#host.limitTurns(conversationId, left);\n   287\t  }\n   288\t\n   289\t  /**\n   290\t   * Stop the session, delete the SandboxClaim and PVC, mark the session deleted. The conversation's stored state\n   291\t   * stays: the Postgres adapter can only delete it in a maintenance window (docs/session-api.md).\n   292\t   */\n   293\t  async #delete(session: SessionRow): Promise<void> {\n   294\t    log(\"session-delete-start\", { session: session.id });\n   295\t    // Record what the session holds before anything is revoked, then revoke its OneCLI agent first: from that moment\n   296\t    // its proxy token is dead, whatever happens to the claim after. A plain session has no OneCLI objects.\n   297\t    await writeTombstone(this.#pool, session);\n   298\t    await this.#options.repos?.teardown(session);\n   299\t    const conversationId = session.conversationId;\n   300\t    if (conversationId !== null) {\n   301\t      await this.#host.abort(conversationId);\n   302\t      this.streams.closeSession(session.id, \"deleted\");\n   303\t      await this.#host.destroySandbox(conversationId);\n   304\t    }\n   305\t    await this.#pool.query(\n   306\t      \"update inbox.sessions set status = 'deleted', last_activity_at = clock_timestamp() where id = $1\",\n   307\t      [session.id],\n   308\t    );\n   309\t    await completeTombstone(this.#pool, session.id);\n   310\t    log(\"session-deleted\", { session: session.id });\n   311\t  }\n   312\t}\n","isError":false}]}
