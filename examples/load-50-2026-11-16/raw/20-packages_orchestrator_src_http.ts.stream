ENTRY 11411 {"id":11411,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport { createServer } from \"node:http\";\n     2\timport type { IncomingMessage, Server, ServerResponse } from \"node:http\";\n     3\timport { errorMessage, getSession, sendJson, UUID } from \"@pi-durable-k8s/session-core\";\n     4\timport type { Authenticator } from \"@pi-durable-k8s/session-core\";\n     5\timport type pg from \"pg\";\n     6\timport type { Host } from \"./host.js\";\n     7\timport { log } from \"./log.js\";\n     8\timport { parseScript } from \"./model.js\";\n     9\timport type { SessionService } from \"./sessions.js\";\n    10\timport { serveStream } from \"./stream.js\";\n    11\t\n    12\t/** What /readyz reports: ready only once this process holds the storage lock and the Harness is open. */\n    13\texport interface Lifecycle {\n    14\t  state: \"waiting-for-lock\" | \"owner\";\n    15\t  instance: string;\n    16\t  host?: Host;\n    17\t  service?: SessionService;\n    18\t}\n    19\t\n    20\texport interface ServerDeps {\n    21\t  lifecycle: Lifecycle;\n    22\t  authenticate: Authenticator;\n    23\t  /** For the owner check on the stream. Independent of the Pi Durable storage connection. */\n    24\t  pool: pg.Pool;\n    25\t  /** Mounts the test-only /control surface (PI_ORCH_CONTROL=1). */\n    26\t  control: boolean;\n    27\t}\n    28\t\n    29\tasync function readBody(req: IncomingMessage): Promise<string> {\n    30\t  const chunks: Buffer[] = [];\n    31\t  let size = 0;\n    32\t  for await (const chunk of req) {\n    33\t    const buffer = chunk as Buffer;\n    34\t    size += buffer.length;\n    35\t    if (size > 64 * 1024) throw new Error(\"body too large\");\n    36\t    chunks.push(buffer);\n    37\t  }\n    38\t  return Buffer.concat(chunks).toString(\"utf8\");\n    39\t}\n    40\t\n    41\t/**\n    42\t * The orchestrator's HTTP surface.\n    43\t *   GET /healthz                  liveness: 200 while the process runs\n    44\t *   GET /readyz                   200 once this process owns the schema and serves, else 503\n    45\t *   GET /sessions/{id}/stream     SSE; bearer token + owner check, the same Authenticator as ingest\n    46\t *   /control/...                  test-only (PI_ORCH_CONTROL=1): the Phase 3 scripted-session surface, same auth\n    47\t */\n    48\texport function createOrchestratorServer(deps: ServerDeps): Server {\n    49\t  const server = createServer((req, res) => {\n    50\t    void handle(req, res, deps).catch((error: unknown) => {\n    51\t      log(\"http-error\", { message: errorMessage(error) });\n    52\t      if (!res.headersSent) sendJson(res, 500, { error: \"internal error\" });\n    53\t      else res.destroy();\n    54\t    });\n    55\t  });\n    56\t  server.requestTimeout = 0;\n    57\t  return server;\n    58\t}\n    59\t\n    60\tasync function handle(req: IncomingMessage, res: ServerResponse, deps: ServerDeps): Promise<void> {\n    61\t  const { lifecycle } = deps;\n    62\t  const url = new URL(req.url ?? \"/\", \"http://localhost\");\n    63\t  const parts = url.pathname.split(\"/\").filter(Boolean);\n    64\t  const method = req.method ?? \"GET\";\n    65\t\n    66\t  if (method === \"GET\" && url.pathname === \"/healthz\") {\n    67\t    sendJson(res, 200, { status: \"ok\", state: lifecycle.state, instance: lifecycle.instance });\n    68\t    return;\n    69\t  }\n    70\t  if (method === \"GET\" && url.pathname === \"/readyz\") {\n    71\t    const ready = lifecycle.host !== undefined && lifecycle.service !== undefined;\n    72\t    sendJson(res, ready ? 200 : 503, { state: lifecycle.state, instance: lifecycle.instance });\n    73\t    return;\n    74\t  }\n    75\t\n    76\t  const principal = await deps.authenticate(req.headers);\n    77\t  if (principal === undefined) {\n    78\t    sendJson(res, 401, { error: \"unauthorized\" }, { \"www-authenticate\": \"Bearer\" });\n    79\t    return;\n    80\t  }\n    81\t\n    82\t  const { host, service } = lifecycle;\n    83\t  if (host === undefined || service === undefined) {\n    84\t    // Not the owner yet (starting, or waiting for the lock). Clients retry; ingest keeps accepting events.\n    85\t    sendJson(res, 503, { error: lifecycle.state }, { \"retry-after\": \"2\" });\n    86\t    return;\n    87\t  }\n    88\t\n    89\t  if (method === \"GET\" && parts.length === 3 && parts[0] === \"sessions\" && parts[2] === \"stream\") {\n    90\t    const id = parts[1] ?? \"\";\n    91\t    const session = UUID.test(id) ? await getSession(deps.pool, id) : undefined;\n    92\t    if (session?.ownerSubject !== principal.subject) {\n    93\t      sendJson(res, 404, { error: \"session not found\" });\n    94\t      return;\n    95\t    }\n    96\t    if (session.status === \"deleted\") {\n    97\t      sendJson(res, 410, { error: \"session deleted\" });\n    98\t      return;\n    99\t    }\n   100\t    const conversationId = await service.ensureConversation(session);\n   101\t    await serveStream(req, res, host, service.streams, session.id, conversationId);\n   102\t    return;\n   103\t  }\n   104\t\n   105\t  if (deps.control && parts[0] === \"control\") {\n   106\t    await handleControl(req, res, host, method, parts.slice(1));\n   107\t    return;\n   108\t  }\n   109\t  sendJson(res, 404, { error: \"not found\" });\n   110\t}\n   111\t\n   112\t/**\n   113\t * Test-only. Scripted sessions created straight on the Harness, not through the inbox, with the sandbox claim\n   114\t * created eagerly. Kept only so the Phase 3 failure tests keep running unchanged in substance.\n   115\t *   POST /control/sessions            body = script JSON\n   116\t *   POST /control/sessions/:id/inputs body = script JSON\n   117\t *   GET  /control/sessions/:id        status and tool results\n   118\t */\n   119\tasync function handleControl(\n   120\t  req: IncomingMessage,\n   121\t  res: ServerResponse,\n   122\t  host: Host,\n   123\t  method: string,\n   124\t  parts: string[],\n   125\t): Promise<void> {\n   126\t  if (parts[0] !== \"sessions\") {\n   127\t    sendJson(res, 404, { error: \"not found\" });\n   128\t    return;\n   129\t  }\n   130\t  if (method === \"POST\" && parts.length === 1) {\n   131\t    let script;\n   132\t    try {\n   133\t      script = parseScript(await readBody(req));\n   134\t    } catch (error) {\n   135\t      sendJson(res, 400, { error: errorMessage(error) });\n   136\t      return;\n   137\t    }\n   138\t    sendJson(res, 201, await host.startSession(script));\n   139\t    return;\n   140\t  }\n   141\t  const id = Number(parts[1]);\n   142\t  if (method === \"POST\" && parts[2] === \"inputs\") {\n   143\t    let script;\n   144\t    try {\n   145\t      script = parseScript(await readBody(req));\n   146\t    } catch (error) {\n   147\t      sendJson(res, 400, { error: errorMessage(error) });\n   148\t      return;\n   149\t    }\n   150\t    const known = Number.isInteger(id) && (await host.sendInput(id, script));\n   151\t    sendJson(res, known ? 202 : 404, known ? { id } : { error: \"unknown session\" });\n   152\t    return;\n   153\t  }\n   154\t  if (method === \"GET\" && parts.length === 2 && Number.isInteger(id)) {\n   155\t    const status = await host.status(id);\n   156\t    sendJson(res, status === undefined ? 404 : 200, status ?? { error: \"unknown session\" });\n   157\t    return;\n   158\t  }\n   159\t  sendJson(res, 404, { error: \"not found\" });\n   160\t}\n","isError":false}]}
ENTRY 11447 {"id":11447,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && cat -n packages/orchestrator/src/stream.ts && cat -n packages/orchestrator/src/sessions.ts\"})","bash({\"command\":\"cd /workspace/repo && rg -n 'lifecycle\\\\.|createOrchestratorServer|requestTimeout|ensureConversation' packages/orchestrator/src\"})","bash({\"command\":\"cd /workspace/repo && rg -n 'function getSession|const getSession|function sendJson|type Authenticator' packages\"})"]}]}
