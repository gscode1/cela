  return fauxAssistantMessage([], { stopReason: \"error\", errorMessage: script.error });\n    await access().shellEnv(session(), 7);\n    await access().teardown(session());\n    expect([...onecli.agents.values()].map((a) => a.identifier)).toEqual([agentIdentifier(other)]);\n    expect(onecli.secretNamed(`${agentIdentifier(other)}-git`)).toBeDefined();\n  });\n});\n\ndescribe(\"parseGrants\", () => {\n  it(\"reads both shapes and refuses anything else\", () => {\n    expect(parseGrants({ secrets: [{ id: \"a\" }, \"b\"], connections: [{ id: \"c\" }] })).toEqual([\n      { kind: \"secret\", id: \"a\" },\n      { kind: \"secret\", id: \"b\" },\n      { kind: \"connection\", id: \"c\" },\n    ]);\n    expect(\n      parseGrants([\n        { type: \"secret\", id: \"a\" },\n        { kind: \"app\", appConnectionId: \"z\" },\n      ]),\n    ).toEqual([\n      { kind: \"secret\", id: \"a\" },\n      { kind: \"connection\", id: \"z\" },\n    ]);\n    expect(parseGrants({ secrets: [] })).toEqual([]);\n    expect(() => parseGrants({ something: [] })).toThrow(/unexpected shape/);\n    expect(() => parseGrants(\"nope\")).toThrow();\n    expect(() => parseGrants([{ type: \"mystery\", id: \"a\" }])).toThrow(/unknown kind/);\n  });\n});\n\ndescribe(\"admin client errors\", () => {\n  it(\"names the call and status, never a body or the key\", async () => {\n    const bad = new OneCliAdmin(\"http://onecli:10256\", new Redacted(\"oc_wrong\"), onecli.fetch);\n    const error = await bad.listAgents().catch((e: unknown) => e as Error);\n    expect((error as Error).message).toBe(\"OneCLI GET /v1/agents answered HTTP 401\");\n    expect((error as Error).message).not.toContain(\"oc_\");\n  });\n});\nimport { generateKeyPairSync } from \"node:crypto\";\nimport { mkdtemp, rm, writeFile } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport type pg from \"pg\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport type { SessionRow } from \"@pi-durable-k8s/session-core\";\nimport type { FetchLike } from \"../src/github-app.ts\";\nimport { OneCliAdmin, parseGrants } from \"../src/onecli-admin.ts\";\nimport { Redacted } from \"../src/onecli.ts\";\nimport { agentIdentifier, RepoAccess } from \"../src/repo-access.ts\";\nimport { FakeOneCli } from \"./fake-onecli.ts\";\n\nconst SESSION = \"11111111-2222-4333-8444-555555555555\";\nconst NAME = agentIdentifier(SESSION);\n\nconst session = (over: Partial<SessionRow> = {}): SessionRow => ({\n  id: SESSION,\n  owner: \"alice\",\n  ownerSubject: \"static:alice\",\n  status: \"active\",\n  conversationId: 7,\n  model: null,\n  failure: null,\n  repo: { repo: \"octo/hello\" },\n  onecli: null,\n  workspaceReadyAt: null,\n  createdAt: new Date(),\n  lastActivityAt: new Date(),\n  ...over,\n});\n\nlet dir: string;\nlet onecli: FakeOneCli;\nlet queries: { sql: string; params: unknown[] }[];\nlet minted: { repo: string; expires: string }[];\nlet clock: number;\nlet githubStatus: number;\n\nconst pool = {\n  query: (sql: string, params: unknown[] = []) => {\n    queries.push({ sql, params });\n    return Promise.resolve({ rows: [], rowCount: 1 });\n  },\n} as unknown as pg.Pool;\n\nfunction githubApi(): FetchLike {\n  return (_url, init) => {\n    const body = JSON.parse(init.body ?? \"{}\") as { repositories: string[] };\n    const expires = new Date(clock + 60 * 60 * 1000).toISOString();\n    minted.push({ repo: body.repositories.join(\",\"), expires });\n    const answer = {\n      token: `ghs_token_${String(minted.length)}`,\n      expires_at: expires,\n      repositories: [{ full_name: `octo/${body.repositories[0] ?? \"\"}` }],\n    };\n    return Promise.resolve({\n      status: githubStatus,\n      json: () => Promise.resolve(answer),\n      text: () => Promise.resolve(JSON.stringify(answer)),\n    });\n  };\n}\n\nfunction access(over: { onecli?: OneCliAdmin | undefined } = {}): RepoAccess {\n  return new RepoAccess({\n    pool,\n    onecli:\n      \"onecli\" in over\n        ? over.onecli\n        : new OneCliAdmin(\"http://onecli:10256\", new Redacted(\"oc_admin\"), onecliFetch()),\n    githubAppDir: dir,\n    gateway: \"http://onecli.onecli:10255\",\n    caFile: join(dir, \"ca.pem\"),\n    fetch: githubApi(),\n    now: () => clock,\n  });\n}\nconst onecliFetch = (): FetchLike => onecli.fetch;\n\nbeforeEach(async () => {\n  dir = await mkdtemp(join(tmpdir(), \"repo-access-\"));\n  const { privateKey } = generateKeyPairSync(\"rsa\", {\n    modulusLength: 2048,\n    privateKeyEncoding: { type: \"pkcs8\", format: \"pem\" },\n    publicKeyEncoding: { type: \"spki\", format: \"pem\" },\n  });\n  await writeFile(join(dir, \"app-id\"), \"123456\");\n  await writeFile(join(dir, \"installation-id\"), \"7890123\");\n  await writeFile(join(dir, \"private-key.pem\"), privateKey);\n  onecli = new FakeOneCli();\n  queries = [];\n  minted = [];\n  clock = Date.UTC(2026, 10, 15, 12, 0, 0);\n  githubStatus = 201;\n});\nafterEach(async () => {\n  await rm(dir, { recursive: true, force: true });\n});\n\n{\n  \"name\": \"pi-durable-k8s\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"packageManager\": \"pnpm@12.21.0\",\n  \"engines\": {\n    \"node\": \">=22.19.0\"\n  },\n  \"scripts\": {\n    \"lint\": \"eslint .\",\n    \"format\": \"prettier --write .\",\n    \"format:check\": \"prettier --check .\",\n    \"build\": \"pnpm -r run build\",\n    \"typecheck\": \"pnpm build && pnpm -r run typecheck\",\n    \"test\": \"pnpm build && pnpm -r run test\",\n    \"check\": \"pnpm build && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test\"\n  },\n  \"devDependencies\": {\n    \"@eslint/js\": \"10.0.1\",\n    \"eslint\": \"10.15.0\",\n    \"prettier\": \"3.10.1\",\n    \"typescript\": \"6.0.3\",\n    \"typescript-eslint\": \"8.72.2\"\n  },\n  \"license\": \"MIT\"\n}\n","isError":false}]}
ENTRY 11887 {"id":11887,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n\n### 1. Unknown grant categories are silently ignored\n- Severity: high\n- Confidence: high\n- Location: packages/orchestrator/src/onecli-admin.ts:97\n- What happens: If OneCLI returns a recognized `secrets` list alongside a new or otherwise unrecognized grant category, `parseGrants` ignores the latter. The caller can then conclude that an agent has only its two session secrets and hand out its token while the agent still has additional access.\n- Evidence: The parser iterates only over `secrets`, `connections`, `apps`, and `appConnections`, then returns if any one was present: `if (!known) throw ...; return grants;`.\n- Fix idea: Reject unrecognized grant-bearing fields, or validate the complete response against a known schema before treating it as proof that the agent is narrow.\n\n### 2. Malformed successful responses can leak agent tokens through errors\n- Severity: high\n- Confidence: high\n- Location: packages/orchestrator/src/onecli-admin.ts:149\n- What happens: If a successful `GET /v1/agents` response contains malformed JSON, the `JSON.parse` exception can include a fragment of the response containing an agent access token. Callers log error messages, exposing the token in logs.\n- Evidence: `body: text === \"\" ? undefined : (JSON.parse(text) as unknown)`\n- Fix idea: Catch JSON parsing errors and throw a sanitized error containing only the method, path, and status, without the parser’s original message.\n\n### 3. Accepted 404 responses can still break idempotent deletion\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/onecli-admin.ts:145\n- What happens: A delete request for an already-absent agent or secret accepts HTTP 404, but a nonempty plain-text or HTML 404 body is passed to `JSON.parse` and throws. Teardown then fails instead of continuing to revoke the remaining objects.\n- Evidence: `deleteAgent` accepts `[200, 204, 404]`, but `#call` only skips body parsing for status 204.\n- Fix idea: Ignore response bodies for deletion calls, or explicitly skip parsing for accepted 404 responses.\n\nEND-OF-REPORT"}]}
