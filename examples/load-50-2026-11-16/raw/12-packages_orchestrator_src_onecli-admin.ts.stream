ENTRY 11847 {"id":11847,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"/** One JSON line per event on stdout. Never pass secrets in `fields`. */\nexport function log(event: string, fields: Record<string, unknown> = {}): void {\n  process.stdout.write(`${JSON.stringify({ t: new Date().toISOString(), event, ...fields })}\\n`);\n}\n\nexport function errorMessage(error: unknown): string {\n  return error instanceof Error ? error.message : String(error);\n}\npackages/orchestrator/src/log.ts:6:export function errorMessage(error: unknown): string {\npackages/orchestrator/src/main.ts:5:  errorMessage,\npackages/orchestrator/src/main.ts:65:      log(\"migrate-failed\", { message: errorMessage(error) });\npackages/orchestrator/src/main.ts:116:      log(\"fail-closed\", { instance: config.instance, message: errorMessage(error) });\npackages/orchestrator/src/main.ts:132:    log(\"run-watch-recover-failed\", { message: errorMessage(error) });\npackages/orchestrator/src/main.ts:166:  log(\"fatal\", { message: errorMessage(error) });\npackages/orchestrator/src/sessions.ts:5:  errorMessage,\npackages/orchestrator/src/sessions.ts:82:        log(\"run-watch-failed\", { message: errorMessage(error) });\npackages/orchestrator/src/sessions.ts:135:        log(\"failed-session-abort-failed\", { session: row.id, message: errorMessage(error) });\npackages/orchestrator/src/storage.ts:4:import { errorMessage, log } from \"./log.js\";\npackages/orchestrator/src/storage.ts:43:      const message = errorMessage(error);\npackages/orchestrator/src/inbox.ts:2:import { errorMessage, getSession, toEvent } from \"@pi-durable-k8s/session-core\";\npackages/orchestrator/src/inbox.ts:101:        log(\"inbox-listen-failed\", { message: errorMessage(error) });\npackages/orchestrator/src/inbox.ts:122:            log(\"inbox-drain-failed\", { session: sessionId, message: errorMessage(error) });\npackages/orchestrator/src/inbox.ts:127:      log(\"inbox-poll-failed\", { message: errorMessage(e