n   125\t    method: string,\n   126\t    path: string,\n   127\t    body?: unknown,\n   128\t    accept: readonly number[] = [200, 201, 204],\n   129\t  ): Promise<{ status: number; body: unknown }> {\n   130\t    const response = await this.#fetch(`${this.#base}${path}`, {\n   131\t      method,\n   132\t      headers: {\n   133\t        authorization: `Bearer ${this.#key.reveal()}`,\n   134\t        accept: \"application/json\",\n   135\t        ...(body === undefined ? {} : { \"content-type\": \"application/json\" }),\n   136\t      },\n   137\t      ...(body === undefined ? {} : { body: JSON.stringify(body) }),\n   138\t    });\n   139\t    if (!accept.includes(response.status)) {\n   140\t      throw new OneCliError(\n   141\t        `OneCLI ${method} ${path.replace(/[0-9a-f-]{20,}/g, \":id\")} answered HTTP ${String(response.status)}`,\n   142\t        response.status,\n   143\t      );\n   144\t    }\n   145\t    if (response.status === 204) return { status: 204, body: undefined };\n   146\t    const text = await response.text();\n   147\t    return {\n   148\t      status: response.status,\n   149\t      body: text === \"\" ? undefined : (JSON.parse(text) as unknown),\n   150\t    };\n   151\t  }\n   152\t\n   153\t  async listAgents(): Promise<OneCliAgent[]> {\n   154\t    const { body } = await this.#call(\"GET\", \"/v1/agents\");\n   155\t    return listOf(body, [\"agents\", \"data\"], \"the agent list\").map((entry) => {\n   156\t      const record = asRecord(entry, \"an agent\");\n   157\t      const token = record.accessToken;\n   158\t      if (typeof record.id !== \"string\" || typeof token !== \"string\") {\n   159\t        throw new Error(\"OneCLI answered an agent without id or accessToken\");\n   160\t      }\npackages/orchestrator/src/repo-access.ts:186:        error instanceof Error ? error.message : \"GitHub App secret is not available\",\npackages/orchestrator/src/log.ts:7:  return error instanceof Error ? error.message : String(error);\npac