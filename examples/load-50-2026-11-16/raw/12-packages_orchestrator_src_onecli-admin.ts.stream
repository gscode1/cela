ENTRY 11747 {"id":11747,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/orchestrator/src/repo-access.ts:10:import type { OneCliAdmin, OneCliGrant } from \"./onecli-admin.js\";\npackages/orchestrator/src/repo-access.ts:23:  onecli: OneCliAdmin | undefined;\npackages/orchestrator/src/repo-access.ts:128:      (await onecli.listAgents()).find((a) => a.identifier === identifier);\npackages/orchestrator/src/repo-access.ts:143:        id = await onecli.createSecret({\npackages/orchestrator/src/repo-access.ts:201:    const have = await onecli.listGrants(agentId);\npackages/orchestrator/src/repo-access.ts:204:        await onecli.grantSecret(agentId, id);\npackages/orchestrator/src/repo-access.ts:210:    const left: OneCliGrant[] = await onecli.listGrants(agentId);\npackages/orchestrator/src/repo-access.ts:283:    const agents = (await onecli.listAgents())\npackages/orchestrator/src/main.ts:13:import { OneCliAdmin } from \"./onecli-admin.js\";\npackages/orchestrator/src/main.ts:85:      : new OneCliAdmin(config.repos.onecliApi, config.repos.onecliApiKey, callApi);\npackages/orchestrator/src/main.ts:148:            agents: (await onecli.listAgents()).map(({ id, identifier }) => ({ id, identifier })),\npackages/orchestrator/src/onecli-admin.ts:78:export function parseGrants(value: unknown): OneCliGrant[] {\npackages/orchestrator/src/onecli-admin.ts:113:export class OneCliAdmin {\npackages/orchestrator/src/onecli-admin.ts:153:  async listAgents(): Promise<OneCliAgent[]> {\npackages/orchestrator/src/onecli-admin.ts:170:  /** The create answer has no token (v2.20 recheck); read it back with `listAgents`. */\npackages/orchestrator/src/onecli-admin.ts:192:  async createSecret(input: SecretInput): Promise<string> {\npackages/orchestrator/src/onecli-admin.ts:215:  /** What the agent can use right now. See `parseGrants` for the UNVERIFIED shape. */\npackages/orchestrator/src/onecli-admin.ts:216:  async listGrants(agentId: string): Promise<OneCliGrant[]> {\npackages/orchestrator/src/onecli-admin.ts:218:    return parseGrants(body);\npackages/orchestrator/src/onecli-admin.ts:221:  async grantSecret(agentId: string, secretId: string): Promise<void> {\n","isError":false}]}
