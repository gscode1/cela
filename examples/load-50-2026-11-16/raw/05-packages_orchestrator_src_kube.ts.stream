ENTRY 11342 {"id":11342,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport {\n     2\t  CoreV1Api,\n     3\t  CustomObjectsApi,\n     4\t  KubeConfig,\n     5\t  PatchStrategy,\n     6\t  setHeaderOptions,\n     7\t} from \"@kubernetes/client-node\";\n     8\t\n     9\t/** HTTP status of a Kubernetes client error, whichever shape this client version uses. */\n    10\tfunction statusOf(error: unknown): number | undefined {\n    11\t  if (typeof error !== \"object\" || error === null) return undefined;\n    12\t  const e = error as { code?: unknown; statusCode?: unknown };\n    13\t  const status = e.code ?? e.statusCode;\n    14\t  return typeof status === \"number\" ? status : undefined;\n    15\t}\n    16\t\n    17\tasync function ignoreNotFound(call: Promise<unknown>): Promise<boolean> {\n    18\t  try {\n    19\t    await call;\n    20\t    return true;\n    21\t  } catch (error) {\n    22\t    if (statusOf(error) === 404) return false;\n    23\t    throw error;\n    24\t  }\n    25\t}\n    26\t\n    27\t/** Label that ties a SandboxClaim to the API session (or `control-<id>` for the test-only control sessions). */\n    28\texport const SESSION_LABEL = \"pi-durable-k8s/session-id\";\n    29\t\n    30\tconst CLAIM_REF = {\n    31\t  group: \"extensions.agents.x-k8s.io\",\n    32\t  version: \"v1beta1\",\n    33\t  plural: \"sandboxclaims\",\n    34\t};\n    35\t\n    36\t/** A `spec.env` entry of a SandboxClaim. */\n    37\texport interface ClaimEnvVar {\n    38\t  name: string;\n    39\t  value: string;\n    40\t}\n    41\t\n    42\tfunction envValueOf(claim: unknown, name: string): string | undefined {\n    43\t  const env = (claim as { spec?: { env?: ClaimEnvVar[] } }).spec?.env;\n    44\t  return env?.find((entry) => entry.name === name)?.value;\n    45\t}\n    46\t\n    47\tfunction labelOf(claim: unknown): string | undefined {\n    48\t  const labels = (claim as { metadata?: { labels?: Record<string, string> } }).metadata?.labels;\n    49\t  return labels?.[SESSION_LABEL];\n    50\t}\n    51\t\n    52\t/**\n    53\t * Makes sure the named claim exists and belongs to this session. A missing claim is created with the session\n    54\t * label; an existing one is accepted only if its label matches: a claim with the right name but another (or no)\n    55\t * label is never adopted, so a name collision cannot hand one session another's sandbox and PVC. The SDK then\n    56\t * adopts the claim by name and waits for its Sandbox (it never sees an unlabelled foreign claim).\n    57\t *\n    58\t * `env` is the claim's `spec.env` (the per-sandbox token hash). The template's envVarsInjectionPolicy must allow\n    59\t * it. The env is baked into the Pod at creation, so an existing claim is accepted only if it carries the same\n    60\t * value: one created before per-sandbox tokens (or under another master) would otherwise fail every call with a\n    61\t * bare 401, and a name collision with a hash from another master must not be adopted.\n    62\t */\n    63\texport async function ensureLabeledClaim(\n    64\t  namespace: string,\n    65\t  claimName: string,\n    66\t  warmPool: string,\n    67\t  sessionKey: string,\n    68\t  env: readonly ClaimEnvVar[],\n    69\t): Promise<void> {\n    70\t  const kc = new KubeConfig();\n    71\t  kc.loadFromDefault();\n    72\t  const custom = kc.makeApiClient(CustomObjectsApi);\n    73\t  const ref = { ...CLAIM_REF, namespace, name: claimName };\n    74\t  let existing: unknown;\n    75\t  try {\n    76\t    existing = await custom.getNamespacedCustomObject(ref);\n    77\t  } catch (error) {\n    78\t    if (statusOf(error) !== 404) throw error;\n    79\t  }\n    80\t  if (existing !== undefined) {\n    81\t    if (labelOf(existing) !== sessionKey) {\n    82\t      throw new Error(`SandboxClaim ${claimName} exists but is not labelled for this session`);\n    83\t    }\n    84\t    for (const { name, value } of env) {\n    85\t      if (envValueOf(existing, name) !== value) {\n    86\t        throw new Error(\n    87\t          `SandboxClaim ${claimName} has no matching ${name}: it predates per-sandbox tokens or the master key changed; ` +\n    88\t            `delete the claim and its PVC to recreate it (docs/decisions/0001-per-sandbox-sandboxd-token.md)`,\n    89\t        );\n    90\t      }\n    91\t    }\n    92\t    return;\n    93\t  }\n    94\t  try {\n    95\t    await custom.createNamespacedCustomObject({\n    96\t      group: ref.group,\n    97\t      version: ref.version,\n    98\t      namespace,\n    99\t      plural: ref.plural,\n   100\t      body: {\n   101\t        apiVersion: `${ref.group}/${ref.version}`,\n   102\t        kind: \"SandboxClaim\",\n   103\t        metadata: { name: claimName, namespace, labels: { [SESSION_LABEL]: sessionKey } },\n   104\t        spec: { warmPoolRef: { name: warmPool }, env },\n   105\t      },\n   106\t    });\n   107\t  } catch (error) {\n   108\t    // Lost a race with another creator: fall back to the label check.\n   109\t    if (statusOf(error) !== 409) throw error;\n   110\t    await ensureLabeledClaim(namespace, claimName, warmPool, sessionKey, env);\n   111\t  }\n   112\t}\n   113\t\n   114\tconst sleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));\n   115\t\n   116\t/**\n   117\t * Deletes a session's SandboxClaim, then its workspace PVC, and waits until both are gone. The claim goes\n   118\t * first: its Sandbox owns the Pod, and a PVC that a Pod still mounts only finishes deleting after the Pod.\n   119\t * Both calls ignore \"not found\", so this is safe to repeat. Needs `delete` on sandboxclaims and\n   120\t * persistentvolumeclaims in the namespace (and the `get` on claims the orchestrator has anyway).\n   121\t */\n   122\texport async function deleteClaimAndPvc(\n   123\t  namespace: string,\n   124\t  claimName: string,\n   125\t  sessionKey: string,\n   126\t  timeoutMs = 180_000,\n   127\t): Promise<void> {\n   128\t  const kc = new KubeConfig();\n   129\t  kc.loadFromDefault();\n   130\t  const custom = kc.makeApiClient(CustomObjectsApi);\n   131\t  const core = kc.makeApiClient(CoreV1Api);\n   132\t  const claim = {\n   133\t    group: \"extensions.agents.x-k8s.io\",\n   134\t    version: \"v1beta1\",\n   135\t    namespace,\n   136\t    plural: \"sandboxclaims\",\n   137\t    name: claimName,\n   138\t  };\n   139\t  // The Sandbox controller names the PVC after the volume claim template and the Sandbox (`workspace-<claim>`).\n   140\t  const pvc = { name: `workspace-${claimName}`, namespace };\n   141\t\n   142\t  // Never delete a claim that is not this session's (`get` is already granted for the SDK).\n   143\t  try {\n   144\t    const found: unknown = await custom.getNamespacedCustomObject(claim);\n   145\t    if (labelOf(found) !== sessionKey) {\n   146\t      throw new Error(\n   147\t        `SandboxClaim ${claimName} is not labelled for this session: not deleting it`,\n   148\t      );\n   149\t    }\n   150\t  } catch (error) {\n   151\t    if (statusOf(error) !== 404) throw error;\n   152\t  }\n   153\t  // Only `delete` is needed: a delete that answers 404 means the object is gone. The PVC is deleted only once\n   154\t  // the claim is gone, so the Sandbox controller cannot recreate it from a Sandbox that still exists.\n   155\t  const deadline = Date.now() + timeoutMs;\n   156\t  for (;;) {\n   157\t    const claimPresent = await ignoreNotFound(custom.deleteNamespacedCustomObject(claim));\n   158\t    const pvcPresent = claimPresent\n   159\t      ? true\n   160\t      : await ignoreNotFound(core.deleteNamespacedPersistentVolumeClaim(pvc));\n   161\t    if (!claimPresent && !pvcPresent) return;\n   162\t    if (Date.now() > deadline) {\n   163\t      throw new Error(\n   164\t        `timed out deleting ${claimName}: claim ${claimPresent ? \"present\" : \"gone\"}, pvc ${pvcPresent ? \"present\" : \"gone\"}`,\n   165\t      );\n   166\t    }\n   167\t    await sleep(2_000);\n   168\t  }\n   169\t}\n   170\t\n   171\tfunction clients(): { custom: CustomObjectsApi; core: CoreV1Api } {\n   172\t  const kc = new KubeConfig();\n   173\t  kc.loadFromDefault();\n   174\t  return { custom: kc.makeApiClient(CustomObjectsApi), core: kc.makeApiClient(CoreV1Api) };\n   175\t}\n   176\t\n   177\tconst SANDBOX_REF = { group: \"agents.x-k8s.io\", version: \"v1beta1\", plural: \"sandboxes\" };\n   178\t\n   179\t/** A SandboxClaim as the orphan sweep sees it. `sessionLabel` is undefined for a claim we never labelled. */\n   180\texport interface ClaimInfo {\n   181\t  name: string;\n   182\t  sessionLabel: string | undefined;\n   183\t  createdAt: Date;\n   184\t}\n   185\t\n   186\t/** Every SandboxClaim in the namespace, labelled or not: the sweep must know a claim exists to leave its PVC alone. */\n   187\texport async function listClaims(namespace: string): Promise<ClaimInfo[]> {\n   188\t  const { custom } = clients();\n   189\t  const list = (await custom.listNamespacedCustomObject({ ...CLAIM_REF, namespace })) as {\n   190\t    items?: { metadata?: { name?: string; creationTimestamp?: string } }[];\n   191\t  };\n   192\t  return (list.items ?? []).flatMap((item) => {\n   193\t    const name = item.metadata?.name;\n   194\t    const created = item.metadata?.creationTimestamp;\n   195\t    if (name === undefined || created === undefined) return [];\n   196\t    return [{ name, sessionLabel: labelOf(item), createdAt: new Date(created) }];\n   197\t  });\n   198\t}\n   199\t\n   200\texport interface PvcInfo {\n   201\t  name: string;\n   202\t  createdAt: Date;\n   203\t}\n   204\t\n   205\texport async function listPvcs(namespace: string): Promise<PvcInfo[]> {\n   206\t  const { core } = clients();\n   207\t  const list = await core.listNamespacedPersistentVolumeClaim({ namespace });\n   208\t  return list.items.flatMap((item) => {\n   209\t    const name = item.metadata?.name;\n   210\t    const created = item.metadata?.creationTimestamp;\n   211\t    return name === undefined || created === undefined\n   212\t      ? []\n   213\t      : [{ name, createdAt: new Date(created) }];\n   214\t  });\n   215\t}\n   216\t\n   217\t/** `Suspended` keeps the PVC and the Sandbox object and deletes the Pod (agent-sandbox v1.0.11, controllers/sandbox_controller.go). */\n   218\texport type OperatingMode = \"Running\" | \"Suspended\";\n   219\t\n   220\texport interface SandboxInfo {\n   221\t  name: string;\n   222\t  mode: OperatingMode;\n   223\t  /** The controller's `Suspended=True` condition: the Pod is really gone, not just asked to go. */\n   224\t  podTerminated: boolean;\n   225\t}\n   226\t\n   227\texport async function listSandboxes(namespace: string): Promise<SandboxInfo[]> {\n   228\t  const { custom } = clients();\n   229\t  const list = (await custom.listNamespacedCustomObject({ ...SANDBOX_REF, namespace })) as {\n   230\t    items?: {\n   231\t      metadata?: { name?: string };\n   232\t      spec?: { operatingMode?: string };\n   233\t      status?: { conditions?: { type?: string; status?: string }[] };\n   234\t    }[];\n   235\t  };\n   236\t  return (list.items ?? []).flatMap((item) => {\n   237\t    const name = item.metadata?.name;\n   238\t    if (name === undefined) return [];\n   239\t    const suspended = item.status?.conditions?.find((c) => c.type === \"Suspended\");\n   240\t    return [\n   241\t      {\n   242\t        name,\n   243\t        mode: item.spec?.operatingMode === \"Suspended\" ? \"Suspended\" : \"Running\",\n   244\t        podTerminated: suspended?.status === \"True\",\n   245\t      },\n   246\t    ];\n   247\t  });\n   248\t}\n   249\t\n   250\t/**\n   251\t * Sets `spec.operatingMode` of the Sandbox that a claim created (same name). The claim controller only syncs the\n   252\t * Sandbox's pod metadata and labels, never the mode, so the patch sticks (verified live on c2 and in the controller\n   253\t * source). False if the Sandbox does not exist.\n   254\t */\n   255\texport async function setOperatingMode(\n   256\t  namespace: string,\n   257\t  sandboxName: string,\n   258\t  mode: OperatingMode,\n   259\t): Promise<boolean> {\n   260\t  const { custom } = clients();\n   261\t  try {\n   262\t    await custom.patchNamespacedCustomObject(\n   263\t      { ...SANDBOX_REF, namespace, name: sandboxName, body: { spec: { operatingMode: mode } } },\n   264\t      setHeaderOptions(\"Content-Type\", PatchStrategy.MergePatch),\n   265\t    );\n   266\t    return true;\n   267\t  } catch (error) {\n   268\t    if (statusOf(error) === 404) return false;\n   269\t    throw error;\n   270\t  }\n   271\t}\n   272\t\n   273\t/**\n   274\t * Suspends a sandbox and waits until the controller reports its Pod gone (`Suspended=True`). Waiting matters: a\n   275\t * resume that lands while the Pod is still terminating would see a Ready Sandbox and connect to a dying Pod.\n   276\t */\n   277\texport async function suspendSandbox(\n   278\t  namespace: string,\n   279\t  sandboxName: string,\n   280\t  timeoutMs = 120_000,\n   281\t): Promise<boolean> {\n   282\t  if (!(await setOperatingMode(namespace, sandboxName, \"Suspended\"))) return false;\n   283\t  const deadline = Date.now() + timeoutMs;\n   284\t  for (;;) {\n   285\t    const found = (await listSandboxes(namespace)).find((s) => s.name === sandboxName);\n   286\t    if (found === undefined || found.podTerminated) return true;\n   287\t    if (Date.now() > deadline) throw new Error(`timed out waiting for ${sandboxName} to suspend`);\n   288\t    await sleep(1_000);\n   289\t  }\n   290\t}\n   291\t\n   292\t/**\n   293\t * Resumes a suspended sandbox before the SDK waits for it to be Ready (a Suspended Sandbox is never Ready, so the\n   294\t * wait would run into its timeout). True if it was suspended.\n   295\t */\n   296\texport async function resumeIfSuspended(namespace: string, sandboxName: string): Promise<boolean> {\n   297\t  const sandbox = (await listSandboxes(namespace)).find((s) => s.name === sandboxName);\n   298\t  if (sandbox?.mode !== \"Suspended\") return false;\n   299\t  await setOperatingMode(namespace, sandboxName, \"Running\");\n   300\t  return true;\n   301\t}\n   302\t\n   303\t/**\n   304\t * Deletes the sandbox Pod (never the claim or the PVC) so the Sandbox controller creates a clean one on the same\n   305\t * PVC, and waits until the replacement is Ready. Needed after an interrupted command: `setsid` children escape\n   306\t * pi-env's process-group kill and only a Pod replacement reaps them. The delete is bound to the Pod's uid, so it\n   307\t * cannot hit a replacement that already exists. Returns false when there was no Pod.\n   308\t */\n   309\texport async function recyclePod(\n   310\t  namespace: string,\n   311\t  podName: string,\n   312\t  timeoutMs = 120_000,\n   313\t): Promise<boolean> {\n   314\t  const { core } = clients();\n   315\t  let uid: string | undefined;\n   316\t  try {\n   317\t    uid = (await core.readNamespacedPod({ name: podName, namespace })).metadata?.uid;\n   318\t  } catch (error) {\n   319\t    if (statusOf(error) === 404) return false;\n   320\t    throw error;\n   321\t  }\n   322\t  if (uid === undefined) return false;\n   323\t  await ignoreNotFound(\n   324\t    core.deleteNamespacedPod({\n   325\t      name: podName,\n   326\t      namespace,\n   327\t      // Short grace: what runs inside is what we are getting rid of. The PVC is a network volume, so a 10 s kill\n   328\t      // costs no more than a node failure would.\n   329\t      gracePeriodSeconds: 10,\n   330\t      body: { preconditions: { uid } },\n   331\t    }),\n   332\t  );\n   333\t  const deadline = Date.now() + timeoutMs;\n   334\t  for (;;) {\n   335\t    try {\n   336\t      const current = await core.readNamespacedPod({ name: podName, namespace });\n   337\t      // The replacement has the same name, so the uid tells old from new. Wait for it to be Ready: the SDK's own\n   338\t      // wait reads the Sandbox status, which can still say Ready for an instant after the Pod changed.\n   339\t      const ready = current.status?.conditions?.some(\n   340\t        (c) => c.type === \"Ready\" && c.status === \"True\",\n   341\t      );\n   342\t      if (current.metadata?.uid !== uid && ready === true) return true;\n   343\t    } catch (error) {\n   344\t      if (statusOf(error) !== 404) throw error;\n   345\t    }\n   346\t    if (Date.now() > deadline)\n   347\t      throw new Error(`timed out waiting for Pod ${podName} to be replaced`);\n   348\t    await sleep(1_000);\n   349\t  }\n   350\t}\n","isError":false}]}
