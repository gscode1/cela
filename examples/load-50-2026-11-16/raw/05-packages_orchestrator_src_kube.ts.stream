ENTRY 11435 {"id":11435,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport type { SessionRef } from \"@pi-durable-k8s/session-core\";\n     2\timport { errorMessage, log } from \"./log.js\";\n     3\timport { planSweep } from \"./sweep.js\";\n     4\timport type { SweepAction, SweepAgent, SweepClaim, SweepPvc, SweepSecret } from \"./sweep.js\";\n     5\t\n     6\texport interface SweeperDeps {\n     7\t  listSessions: () => Promise<SessionRef[]>;\n     8\t  listClaims: () => Promise<SweepClaim[]>;\n     9\t  listPvcs: () => Promise<SweepPvc[]>;\n    10\t  /** Undefined when OneCLI is not configured: the sweep then leaves agents alone. */\n    11\t  listOneCli: (() => Promise<{ agents: SweepAgent[]; secrets: SweepSecret[] }>) | undefined;\n    12\t  /** The session deletion's teardown: stops the bridge, deletes the claim, then the PVC. Also removes a lone PVC. */\n    13\t  destroyClaim: (claimName: string, sessionLabel: string) => Promise<void>;\n    14\t  revokeSession: (sessionId: string) => Promise<void>;\n    15\t  graceMs: number;\n    16\t  maxActions: number;\n    17\t  now?: () => number;\n    18\t}\n    19\t\n    20\t/**\n    21\t * The execution half of the orphan sweep: reads the world, asks `planSweep` what is orphaned, does it, logs each\n    22\t * action. One run at a time. A failing action is logged and the run goes on; the next run retries it. The log lines\n    23\t * carry names and ids only, never a token or secret value.\n    24\t */\n    25\texport class OrphanSweeper {\n    26\t  readonly #deps: SweeperDeps;\n    27\t  #running = false;\n    28\t  #timer: NodeJS.Timeout | undefined;\n    29\t\n    30\t  constructor(deps: SweeperDeps) {\n    31\t    this.#deps = deps;\n    32\t  }\n    33\t\n    34\t  start(intervalMs: number): void {\n    35\t    if (intervalMs <= 0) {\n    36\t      log(\"sweep-disabled\", {});\n    37\t      return;\n    38\t    }\n    39\t    this.#timer = setInterval(() => void this.run(), intervalMs);\n    40\t    this.#timer.unref();\n    41\t  }\n    42\t\n    43\t  stop(): void {\n    44\t    if (this.#timer !== undefined) clearInterval(this.#timer);\n    45\t  }\n    46\t\n    47\t  /** One sweep. Returns the actions that succeeded; never throws. */\n    48\t  async run(): Promise<SweepAction[]> {\n    49\t    if (this.#running) return [];\n    50\t    this.#running = true;\n    51\t    const done: SweepAction[] = [];\n    52\t    try {\n    53\t      const d = this.#deps;\n    54\t      const [sessions, claims, pvcs, oneCli] = await Promise.all([\n    55\t        d.listSessions(),\n    56\t        d.listClaims(),\n    57\t        d.listPvcs(),\n    58\t        d.listOneCli?.(),\n    59\t      ]);\n    60\t      const actions = planSweep({\n    61\t        sessions,\n    62\t        claims,\n    63\t        pvcs,\n    64\t        agents: oneCli?.agents,\n    65\t        secrets: oneCli?.secrets ?? [],\n    66\t        now: d.now?.() ?? Date.now(),\n    67\t        graceMs: d.graceMs,\n    68\t        maxActions: d.maxActions,\n    69\t      });\n    70\t      for (const action of actions) {\n    71\t        try {\n    72\t          await this.#apply(action);\n    73\t          log(\"sweep-action\", { ...action });\n    74\t          done.push(action);\n    75\t        } catch (error) {\n    76\t          log(\"sweep-action-failed\", { ...action, message: errorMessage(error) });\n    77\t        }\n    78\t      }\n    79\t      if (actions.length > 0) log(\"sweep-done\", { planned: actions.length, done: done.length });\n    80\t    } catch (error) {\n    81\t      log(\"sweep-failed\", { message: errorMessage(error) });\n    82\t    } finally {\n    83\t      this.#running = false;\n    84\t    }\n    85\t    return done;\n    86\t  }\n    87\t\n    88\t  async #apply(action: SweepAction): Promise<void> {\n    89\t    switch (action.kind) {\n    90\t      case \"delete-claim\":\n    91\t        return this.#deps.destroyClaim(action.claim, action.sessionLabel);\n    92\t      case \"delete-pvc\":\n    93\t        // The claim does not exist, so there is no label to check; deleteClaimAndPvc refuses if one appears meanwhile.\n    94\t        return this.#deps.destroyClaim(action.claim, \"orphan-pvc-sweep\");\n    95\t      case \"revoke-agent\":\n    96\t        return this.#deps.revokeSession(action.sessionId);\n    97\t    }\n    98\t  }\n    99\t}\n     1\t            await this.#awaitCleanPod(conversationId);\n     2\t            await this.#hooks.beforeUse?.(conversationId);\n     3\t            const real = (await this.ensure(conversationId)).env as unknown as Record<\n     4\t              string,\n     5\t              (...a: unknown[]) => unknown\n     6\t            >;\n     7\t            // Only commands can leave processes behind. Record that one may be running before it starts, so a\n     8\t            // crash in the middle is still known after the restart.\n     9\t            if (property === \"exec\" && !usage.recorded) {\n    10\t              await this.#hooks.execInFlight?.(conversationId, true);\n    11\t              usage.recorded = true;\n    12\t            }\n    13\t            try {\n    14\t              const result = await real[property]?.(...args);\n    15\t              outcome = { threw: false, result };\n    16\t              return result;\n    17\t            } catch (error) {\n    18\t              outcome = { threw: true };\n    19\t              throw error;\n    20\t            }\n    21\t          } finally {\n    22\t            usage.inUse--;\n    23\t            usage.lastUsed = Date.now();\n    24\t            this.#lastUsed.set(conversationId, usage.lastUsed);\n    25\t            if (property === \"exec\" && outcome !== undefined && interruptedExec(outcome)) {\n    26\t              this.#interrupted.add(conversationId);\n    27\t            }\n    28\t            if (usage.inUse === 0) this.#settle(conversationId, usage);\n    29\t          }\n    30\t        };\n    31\t      },\n    32\t      set: (object, property, value) => {\n    33\t        if (property === \"cwd\") object.cwd = String(value);\n    34\t        return property === \"cwd\";\n    35\t      },\n    36\t    }) as unknown as ExecutionEnv;\n    37\t  }\n    38\t\n    39\t  /**\n    40\t   * No call is in flight any more. An interrupted command means its sandbox may hold children that escaped the\n    41\t   * process-group kill: replace the Pod. Otherwise the commands ended on their own and the in-flight record goes.\n    42\t   */\n    43\t  #settle(conversationId: number, usage: Usage): void {\n    44\t    if (this.#interrupted.has(conversationId) && !this.#replacing.has(conversationId)) {\n    45\t      this.#interrupted.delete(conversationId);\n    46\t      this.#replace(conversationId, \"interrupted\", async () => {\n    47\t        await this.#closeEnv(conversationId);\n    48\t        await recyclePod(this.#config.namespace, claimNameFor(conversationId));\n    49\t        // Cleared only now: if the recycle fails or the process dies first, the record is still there.\n    50\t        await this.#hooks.execInFlight?.(conversationId, false);\n    51\t        usage.recorded = false;\n    52\t      });\n    53\t    } else if (usage.recorded) {\n    54\t      usage.recorded = false;\n    55\t      void this.#hooks.execInFlight?.(conversationId, false).catch((error: unknown) => {\n    56\t        usage.recorded = true; // still recorded: the next settle clears it\n    57\t        log(\"exec-record-failed\", {\n    58\t          claim: claimNameFor(conversationId),\n    59\t          message: errorMessage(error),\n    60\t        });\n    61\t      });\n    62\t    }\n    63\t  }\n    64\t\n    65\t  /**\n    66\t   * Waits for a replacement under way, then makes sure no recycle is still owed. A failed recycle is retried here, by\n    67\t   * the call that needs the Pod; if it fails again the call throws (the inbox retries the input) rather than run in a\n    68\t   * Pod that may still hold an interrupted command's leftovers.\n    69\t   */\n    70\t  async #awaitCleanPod(conversationId: number): Promise<void> {\n    71\t    await this.#replacing.get(conversationId);\n    72\t    const owed = this.#failed.get(conversationId);\n    73\t    if (owed === undefined) return;\n    74\t    this.#replace(conversationId, owed.why, owed.work);\n    75\t    await this.#replacing.get(conversationId);\n    76\t    if (this.#failed.has(conversationId)) {\n    77\t      throw new Error(\n    78\t        `sandbox ${claimNameFor(conversationId)} could not be recycled after an interrupted command`,\n    79\t      );\n    80\t    }\n    81\t  }\n    82\t\n    83\t  /**\n    84\t   * Runs a Pod replacement (recycle) or suspension for a conversation's sandbox. Calls made meanwhile wait for it.\n    85\t   * A failure is logged; a failed recycle stays owed in `#failed` and blocks calls until a retry succeeds.\n    86\t   */\n    87\t  #replace(\n    88\t    conversationId: number,\n    89\t    why: \"interrupted\" | \"orchestrator-restart\" | \"idle\",\n    90\t    work: () => Promise<void>,\n    91\t  ): void {\n    92\t    if (this.#replacing.has(conversationId)) return;\n    93\t    const claim = claimNameFor(conversationId);\n    94\t    const run = (async () => {\n    95\t      await work();\n    96\t      this.#failed.delete(conversationId);\n    97\t      this.#lastUsed.delete(conversationId);\n    98\t      log(why === \"idle\" ? \"sandbox-suspended\" : \"sandbox-recycled\", { claim, why });\n    99\t    })()\n   100\t      .catch((error: unknown) => {\n   101\t        if (why !== \"idle\") this.#failed.set(conversationId, { why, work });\n   102\t        log(\"sandbox-replace-failed\", { claim, why, message: errorMessage(error) });\n   103\t      })\n   104\t      .finally(() => this.#replacing.delete(conversationId));\n   105\t    this.#replacing.set(conversationId, run);\n   106\t  }\n   107\t\n   108\t  /**\n   109\t   * After a start: the conversations that had a command in flight when the previous process stopped. Their Pods are\n   110\t   * replaced before Pi Durable resumes (the caller invokes this first), so the continuing run finds a clean sandbox.\n   111\t   * Nothing is known about which of them really has a leftover child, so every one is recycled.\n   112\t   */\n   113\t  recycleAtStart(conversationIds: readonly number[]): void {\n   114\t    for (const conversationId of conversationIds) {\n   115\t      this.#replace(conversationId, \"orchestrator-restart\", async () => {\n   116\t        await recyclePod(this.#config.namespace, claimNameFor(conversationId));\n   117\t        await this.#hooks.execInFlight?.(conversationId, false);\n   118\t      });\n   119\t    }\n   120\t  }\n   121\t\n   122\t  async #closeEnv(conversationId: number): Promise<void> {\n   123\t    const opened = this.#envs.get(conversationId);\n   124\t    if (this.#usage.get(conversationId)?.inUse === 0) this.#usage.delete(conversationId);\n   125\t    this.#envs.delete(conversationId);\n   126\t    if (opened !== undefined) (await opened.catch(() => undefined))?.close();\n   127\t  }\n   128\t\n   129\t  /** Suspends the sandboxes that have been idle for `idleSuspendMs`. Never throws: it runs on a timer. */\n   130\t  async #suspendIdle(): Promise<void> {\n   131\t    try {\n   132\t      const sandboxes = await listSandboxes(this.#config.namespace);\n   133\t      const now = Date.now();\n   134\t      const busy = new Set<number>(this.#replacing.keys());\n   135\t      for (const [conversationId, usage] of this.#usage)\n   136\t        if (usage.inUse > 0) busy.add(conversationId);\n   137\t      for (const sandbox of sandboxes) {\n   138\t        const conversationId = conversationOfName(sandbox.name);\n   139\t        if (conversationId !== undefined && sandbox.mode === \"Suspended\")\n   140\t          this.#lastUsed.delete(conversationId);\n   141\t      }\n   142\t      const plan = planSuspend({\n   143\t        running: sandboxes.filter((s) => s.mode === \"Running\").map((s) => s.name),\n   144\t        lastUsed: this.#lastUsed,\n   145\t        busy,\n   146\t        now,\n   147\t        afterMs: this.#config.sandbox.idleSuspendMs,\n   148\t      });\n   149\t      for (const conversationId of plan.seen) this.#lastUsed.set(conversationId, now);\n   150\t      for (const conversationId of plan.suspend) {\n   151\t        this.#replace(conversationId, \"idle\", async () => {\n   152\t          await this.#closeEnv(conversationId);\n   153\t          await suspendSandbox(this.#config.namespace, claimNameFor(conversationId));\n   154\t        });\n   155\t      }\n   156\t    } catch (error) {\n   157\t      log(\"suspend-scan-failed\", { message: errorMessage(error) });\n   158\t    }\n   159\t  }\n   160\t\n   161\t  /** Creates or adopts the claim and waits for its Sandbox; safe to call on every start. */\n   162\t  async ensure(conversationId: number): Promise<SandboxEnv> {\n   163\t    let env = this.#envs.get(conversationId);\n   164\t    if (env === undefined) {\n   165\t      env = this.#open(conversationId);\n   166\t      this.#envs.set(conversationId, env);\n   167\t      // A failed open must not be cached: the next tool call tries again.\n   168\t      env.catch(() => this.#envs.delete(conversationId));\n   169\t    }\n   170\t    return env;\n   171\t  }\n   172\t\n   173\t  async #open(conversationId: number): Promise<SandboxEnv> {\n   174\t    const claimName = claimNameFor(conversationId);\n   175\t    const { namespace, warmPool } = this.#config;\n   176\t    // Required: a sandbox with no token would be unauthenticated or unreachable. Only the hash goes into the claim.\n   177\t    const master = process.env[ENV.masterKey];\n   178\t    if (master === undefined || master === \"\") throw new Error(`${ENV.masterKey} is not set`);\n   179\t    const token = deriveSandboxToken(master, claimName);\n   180\t    try {\n   181\t      // Create the claim with the session label, or accept an existing one only if the label matches. The SDK\n   182\t      // then adopts it by name.\n   183\t      await ensureLabeledClaim(\n   184\t        namespace,\n   185\t        claimName,\n   186\t        warmPool,\n   187\t        await this.#sessionKeyOf(conversationId),\n   188\t        [{ name: SANDBOXD_TOKEN_SHA256_ENV, value: sandboxTokenSha256(token) }],\n   189\t      );\n   190\t      // A suspended sandbox is never Ready, so the wait below would only time out: resume it first.\n   191\t      if (await resumeIfSuspended(namespace, claimName))\n   192\t        log(\"sandbox-resumed\", { claim: claimName });\n   193\t      await ensureClaim({\n   194\t        claimName,\n   195\t        namespace,\n   196\t        warmPool,\n   197\t        connectivity: \"in-cluster-service\",\n   198\t        authToken: token,\n   199\t      });\n   200\t    } catch (error) {\n   201\t      log(\"claim-failed\", { claim: claimName, message: errorMessage(error) });\n   202\t      throw error;\n   203\t    }\n   204\t    log(\"claim-ready\", { claim: claimName });\n   205\t    // Credentials for a repo session's commands only; plain sessions get nothing here. The token travels through the\n   206\t    // pi-env protocol to the daemon, never through the bridge process environment (bridge-launcher derives its own claim's token and drops the master).\n   207\t    const shellEnv = await this.#hooks.shellEnv?.(conversationId);\n   208\t    return connectSandboxEnv({\n   209\t      claimName,\n   210\t      namespace,\n   211\t      cwd: WORKSPACE,\n   212\t      id: `pi-env:${claimName}`,\n   213\t      bridgeCommand: [process.execPath, BRIDGE_LAUNCHER],\n   214\t      ...(shellEnv === undefined ? {} : { shellEnv }),\n   215\t    });\n   216\t  }\n   217\t\n   218\t  /**\n   219\t   * Session deletion: stops the bridge, then deletes the SandboxClaim and the PVC. Idempotent, so a deletion cut\n   220\t   * off by a crash is simply run again. With `destroyOrphan` the only place that deletes a claim.\n   221\t   */\n   222\t  async destroy(conversationId: number): Promise<void> {\n   223\t    await this.#teardown(conversationId, await this.#sessionKeyOf(conversationId));\n   224\t  }\n   225\t\n   226\t  /**\n   227\t   * The orphan sweep's delete: the same teardown as a session deletion, for a claim whose session is deleted or\n   228\t   * unknown. `sessionLabel` is the label the sweep read from the claim, so `deleteClaimAndPvc` still refuses a\n   229\t   * claim that changed hands meanwhile.\n   230\t   */\n   231\t  async destroyOrphan(claimName: string, sessionLabel: string): Promise<void> {\n   232\t    const conversationId = conversationOfName(claimName);\n   233\t    if (conversationId === undefined) throw new Error(`${claimName} is not a conversation claim`);\n   234\t    await this.#teardown(conversationId, sessionLabel);\n   235\t  }\n   236\t\n   237\t  async #teardown(conversationId: number, sessionKey: string): Promise<void> {\n   238\t    await this.#replacing.get(conversationId);\n   239\t    this.#interrupted.delete(conversationId);\n   240\t    this.#failed.delete(conversationId);\n   241\t    this.#lastUsed.delete(conversationId);\n   242\t    const opened = this.#envs.get(conversationId);\n   243\t    this.#usage.delete(conversationId);\n   244\t    this.#envs.delete(conversationId);\n   245\t    if (opened !== undefined) {\n   246\t      const env = await opened.catch(() => undefined);\n   247\t      env?.close();\n   248\t    }\n   249\t    const claimName = claimNameFor(conversationId);\n   250\t    await deleteClaimAndPvc(this.#config.namespace, claimName, sessionKey);\n   251\t    log(\"sandbox-deleted\", { claim: claimName });\n   252\t  }\n   253\t\n   254\t  /** Stops every bridge. Never deletes a claim. */\n   255\t  async closeAll(): Promise<void> {\n   256\t    this.stop();\n   257\t    const opened = await Promise.allSettled([...this.#envs.values()]);\n   258\t    for (const result of opened) if (result.status === \"fulfilled\") result.value.close();\n   259\t    this.#envs.clear();\n   260\t  }\n   261\t}\n{\n  \"name\": \"@pi-durable-k8s/orchestrator\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"description\": \"Pi Durable host: Postgres storage, inbox consumer, SSE streams, one sandbox per conversation, scripted model.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.19.0\"\n  },\n  \"scripts\": {\n    \"build\": \"rm -rf dist && tsc -p tsconfig.build.json\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@earendil-works/chord\": \"1.5.2\",\n    \"@earendil-works/pi-ai\": \"1.5.2\",\n    \"@earendil-works/pi-durable\": \"1.5.2\",\n    \"@kubernetes/client-node\": \"2.0.0\",\n    \"@netzlabor/pi-durable-postgres\": \"file:../../vendor/netzlabor-pi-durable-postgres-0.2.0.tgz\",\n    \"@pi-durable-k8s/sandbox-env\": \"workspace:*\",\n    \"@pi-durable-k8s/session-core\": \"workspace:*\",\n    \"undici\": \"8.12.4\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"22.20.5\",\n    \"@types/pg\": \"8.23.1\",\n    \"typescript\": \"7.0.2\",\n    \"vitest\": \"5.1.0\"\n  }\n}\ngrep: package-lock.json: No such file or directory\n","isError":false}]}
ENTRY 11467 {"id":11467,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && grep -R -nE 'foreground|ownerReferences|workspace-|SandboxClaim' docs | head -65; ls -a | head; find . -path '*client-node*' | head; cat -n packages/orchestrator/src/sweep.ts | sed -n '70,190p'\"})"]}]}
ENTRY 11487 {"id":11487,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"docs/decisions/0001-per-sandbox-sandboxd-token.md:17:- **What a sandbox gets.** Only `sha256(token)`, set by the orchestrator in the SandboxClaim `spec.env` as\ndocs/decisions/0001-per-sandbox-sandboxd-token.md:45:  `SandboxClaim <name> has no matching SANDBOXD_AUTH_TOKEN_SHA256 ... delete the claim and its PVC to recreate it`.\ndocs/decisions/0001-per-sandbox-sandboxd-token.md:47:- Recreating means deleting the claim and its workspace PVC (`workspace-<claim>`); the session's conversation state is\ndocs/decisions/0004-idle-suspend.md:26:- A Sandbox owned by a SandboxClaim may be patched, and the claim controller does not revert it. The claim API has no\ndocs/decisions/0002-orphan-sweep.md:25:| SandboxClaim | name `pi-conv-<n>` and label `pi-durable-k8s/session-id` is a UUID | the label's session is deleted or unknown |\ndocs/decisions/0002-orphan-sweep.md:26:| PVC | `workspace-pi-conv-<n>` | no claim of that name exists (labelled or not) and the session that owns conversation `<n>` is deleted or unknown |\ndocs/session-api.md:5:consumes it. Terms follow `plan.md`: one session = one Pi conversation = one named SandboxClaim = one PVC.\ndocs/session-api.md:147:- Every SandboxClaim carries the label `pi-durable-k8s/session-id: <session UUID>`. The orchestrator creates the\ndocs/session-api.md:172:  stream (`inbox.sessions.conversation_id`) and the SandboxClaim `pi-conv-<conversation id>` lazily at the first tool\ndocs/session-api.md:184:3. stops the bridge and deletes the SandboxClaim, then the workspace PVC, and waits until both are gone,\ndocs/session-api.md:212:`PI_SWEEP_INTERVAL_SECONDS` (300; 0 = off) it removes SandboxClaims `pi-conv-<n>` labelled with a session UUID, workspace\ndocs/session-api.md:213:PVCs `workspace-pi-conv-<n>` without a claim, and OneCLI agents `pi-session-<uuid>` with their secrets, when the session\ndocs/research/phase1-apis.md:122:- In v1beta1 a **SandboxClaim references a SandboxWarmPool, not a SandboxTemplate**: `spec.warmPoolRef` is `required` (CRD in `extensions.yaml` v1.0.11; `extensions/api/v1beta1/sandboxclaim_types.go:110-112`). The SandboxWarmPool references the template via `spec.sandboxTemplateRef.name`. A warm pool can have `replicas: 0` (`Minimum=0`, default 1; `sandboxwarmpool_types.go:41-46`), so cold-start-only is expressible: UNVERIFIED that replicas 0 behaves as a pure template alias in practice.\ndocs/research/phase1-apis.md:123:- The TS SDK's `createSandbox(warmpool, ...)` always builds the claim with `spec: { warmPoolRef: { name: warmpool }, ...extras }` (`sandbox-client.ts:~1407`). So Phase 1 needs three objects: SandboxTemplate, SandboxWarmPool, SandboxClaim.\ndocs/research/phase1-apis.md:159:kind: SandboxClaim\ndocs/research/phase1-apis.md:212:- `examples/pi-code-agent/` (`Dockerfile`, `sandbox.yaml`, `README.md`, `run-test-kind.sh`; docs mirror `site/content/docs/use-cases/examples/pi-code-agent/_index.md`). It runs the **interactive Pi coding-agent TUI inside a Sandbox** (`node:24-bookworm-slim`, `npm i -g @earendil-works/pi-coding-agent@0.84.1`, `kubectl attach -it`, plain `Sandbox` CRD, two PVCs, API key via Secret). It does NOT use sandboxd, pi-env, SandboxClaim, Pi Durable or an outside orchestrator, so it is \"Pi inside\" rather than \"orchestrator outside, tools inside\". Good place to put the Phase 5 example next to it.\ndocs/research/phase1-apis.md:239:- Claims reference a SandboxWarmPool; plan.md's \"SandboxTemplate + named SandboxClaim\" needs a (possibly zero-replica) SandboxWarmPool in between. The SDK's `createSandbox` takes the warm pool name.\n.\n..\n.git\n.gitignore\n.prettierignore\n.prettierrc.json\nAGENT.md\nCLAUDE.md\nLICENSE\nREADME.md\n    70\t      secretIds: string[];\n    71\t      reason: SweepReason;\n    72\t    };\n    73\t\n    74\tconst CLAIM_NAME = /^pi-conv-(\\d+)$/;\n    75\tconst PVC_NAME = /^workspace-(pi-conv-(\\d+))$/;\n    76\tconst AGENT_IDENTIFIER = /^pi-session-([0-9a-f-]{36})$/;\n    77\tconst SECRET_NAME = /^pi-session-([0-9a-f-]{36})-(git|api)$/;\n    78\t\n    79\texport function planSweep(input: SweepInput): SweepAction[] {\n    80\t  const bySession = new Map(input.sessions.map((s) => [s.id, s]));\n    81\t  const byConversation = new Map(\n    82\t    input.sessions.flatMap((s) => (s.conversationId === null ? [] : [[s.conversationId, s]])),\n    83\t  );\n    84\t  const old = (createdAt: Date | undefined): boolean =>\n    85\t    createdAt === undefined || input.now - createdAt.getTime() >= input.graceMs;\n    86\t  /** The reason a session no longer owns anything, or undefined if it is live. */\n    87\t  const orphanReason = (session: SessionRef | undefined): SweepReason | undefined => {\n    88\t    if (session === undefined) return \"session-unknown\";\n    89\t    return session.status === \"deleted\" ? \"session-deleted\" : undefined;\n    90\t  };\n    91\t\n    92\t  const actions: SweepAction[] = [];\n    93\t\n    94\t  for (const claim of input.claims) {\n    95\t    if (!CLAIM_NAME.test(claim.name)) continue;\n    96\t    const label = claim.sessionLabel;\n    97\t    if (label === undefined || !UUID.test(label)) continue;\n    98\t    if (!old(claim.createdAt)) continue;\n    99\t    const reason = orphanReason(bySession.get(label));\n   100\t    if (reason !== undefined)\n   101\t      actions.push({ kind: \"delete-claim\", claim: claim.name, sessionLabel: label, reason });\n   102\t  }\n   103\t\n   104\t  // Any claim of that name, labelled or not, means the PVC is (or may soon be) in use: leave it.\n   105\t  const claimNames = new Set(input.claims.map((c) => c.name));\n   106\t  for (const pvc of input.pvcs) {\n   107\t    const match = PVC_NAME.exec(pvc.name);\n   108\t    if (match === null || !old(pvc.createdAt)) continue;\n   109\t    const [, claim, conversation] = match;\n   110\t    if (claim === undefined || conversation === undefined || claimNames.has(claim)) continue;\n   111\t    const reason = orphanReason(byConversation.get(Number(conversation)));\n   112\t    if (reason !== undefined) actions.push({ kind: \"delete-pvc\", claim, reason });\n   113\t  }\n   114\t\n   115\t  if (input.agents !== undefined) {\n   116\t    const found = new Map<string, { agentIds: string[]; secretIds: string[] }>();\n   117\t    const entry = (sessionId: string) => {\n   118\t      let e = found.get(sessionId);\n   119\t      if (e === undefined) {\n   120\t        e = { agentIds: [], secretIds: [] };\n   121\t        found.set(sessionId, e);\n   122\t      }\n   123\t      return e;\n   124\t    };\n   125\t    for (const agent of input.agents) {\n   126\t      const sessionId = AGENT_IDENTIFIER.exec(agent.identifier)?.[1];\n   127\t      if (sessionId === undefined || !old(agent.createdAt)) continue;\n   128\t      if (orphanReason(bySession.get(sessionId)) !== undefined)\n   129\t        entry(sessionId).agentIds.push(agent.id);\n   130\t    }\n   131\t    for (const secret of input.secrets) {\n   132\t      const sessionId = SECRET_NAME.exec(secret.name)?.[1];\n   133\t      if (sessionId === undefined) continue;\n   134\t      if (orphanReason(bySession.get(sessionId)) !== undefined)\n   135\t        entry(sessionId).secretIds.push(secret.id);\n   136\t    }\n   137\t    for (const [sessionId, ids] of found) {\n   138\t      const reason = orphanReason(bySession.get(sessionId));\n   139\t      if (reason !== undefined) actions.push({ kind: \"revoke-agent\", sessionId, ...ids, reason });\n   140\t    }\n   141\t  }\n   142\t\n   143\t  return actions.slice(0, Math.max(0, input.maxActions));\n   144\t}\n","isError":false}]}
ENTRY 11554 {"id":11554,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && cat docs/decisions/0004-idle-suspend.md && grep -R -n 'propagationPolicy\\\\|blockOwnerDeletion\\\\|finalizer' docs/research docs/decisions | head -35 && sed -n '140,168p;277,301p;313,347p' packages/orchestrator/src/kube.ts\"})"]}]}
ENTRY 11558 {"id":11558,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"# 0004: Idle shutdown by suspending the sandbox\n\nStatus: accepted, 2026-11-16 (issue #9). Replaces the \"set `shutdownAfterSeconds` as a backstop\" line of Phase 4.\n\n## Context\n\nIdle sandboxes hold a gVisor Pod (100m CPU and 128 Mi requested) for sessions nobody is using. The plan forbids the\nobvious answer: `Sandbox.spec.shutdownTime` / `shutdownAfterSeconds` is an absolute time after which the controller\ndeletes the Sandbox, and with its `shutdownPolicy: Delete` the workspace PVC goes with it. A session is a\nconversation that can resume days later, so a deadline that deletes its workspace is wrong, and \"renew on activity\" is\nan orchestrator write per call that fails the same way when the orchestrator is down.\n\n`shutdownPolicy: Retain` keeps the Sandbox object after `shutdownTime` but marks it `Expired` and tears the Pod down\n(`handleSandboxExpiry` in `controllers/sandbox_controller.go`). It is still an absolute deadline that has to be\nrenewed, and `Expired` is not a state the controller resumes from, so it is no substitute for a suspend.\n\n## What `operatingMode: Suspended` does (agent-sandbox v1.0.11, verified in source and on c2)\n\n- `Sandbox.spec.operatingMode` is `Running` (default) or `Suspended`\n  (`kubectl explain sandbox.spec.operatingMode`; `clients/k8s/applyconfiguration/api/v1beta1/sandboxspec.go` documents\n  it: \"the controller terminates the backing Pod but retains the Sandbox object and its volumes so it can later be\n  resumed. Resuming creates a new Pod from the current podTemplate that reattaches the retained volumes\").\n- `controllers/sandbox_controller.go` (`reconcilePod`, the branch on `OperatingModeSuspended`): deletes the Pod it owns,\n  and `reconcilePVCs` is not skipped, so the PVC stays. The `Suspended` condition goes `PodTerminating`, then\n  `Suspended=True` with reason `PodTerminated`; `Ready` is `False` with reason `SandboxSuspended`. The Service stays.\n- A Sandbox owned by a SandboxClaim may be patched, and the claim controller does not revert it. The claim API has no\n  operating mode; `extensions/controllers/sandboxclaim_controller.go` only patches the Sandbox's pod-template metadata\n  and labels (`mergePodMetadata`), never the mode. Verified on c2 with a throwaway claim: a merge patch of\n  `spec.operatingMode` to `Suspended` removed the Pod within seconds, the PVC (same uid) and the claim stayed, the\n  claim reported `Ready=False/SandboxSuspended`, and 40 s later the mode was still `Suspended`. Patching back to\n  `Running` gave a Ready Pod in 15 s on the same PVC.\n- `Finished` is not set by a suspension (the controller keeps the previous value), so a future\n  `ttlSecondsAfterFinished` would not delete a suspended sandbox either.\n\n## Decision\n\nAfter `PI_SANDBOX_IDLE_SUSPEND_SECONDS` (1800; 0 turns it off) with no call, the orchestrator suspends the session's\nsandbox. The next tool call resumes it. No deadline, no deletion, no renewal.\n\n- **Builds on bridge eviction.** `Sandboxes#evictIdle` already closes an idle env's bridge after\n  `PI_SANDBOX_IDLE_EVICT_SECONDS` (120). Suspension needs the last-use time of sandboxes whose env was evicted, so\n  `Sandboxes` keeps a second map, `#lastUsed`, that outlives the env. Config refuses a suspend age below the eviction\n  age. A timer every 30 s lists the Sandboxes and `planSuspend` (pure, `lifecycle.ts`) picks the `pi-conv-<n>` ones that\n  are `Running` and idle long enough.\n- **A restart postpones, never suspends.** A Running sandbox the process has no record of (it just started, or it never\n  used it) starts its idle clock at first sight. Suspended sandboxes need no tracking.\n- **Suspend completes before anything else.** The patch is followed by a wait for `Suspended=True`; calls for that\n  conversation wait for it (`#replacing`), so a resume cannot race a Pod that is still terminating and connect to it.\n- **Resume is lazy**, like claim creation. `#open` calls `resumeIfSuspended` (patch to `Running`) before the SDK's\n  Ready wait, because a Suspended Sandbox is never Ready and the wait would only time out. It runs on every open, so\n  it also covers an orchestrator restart and a session whose sandbox was suspended by an earlier process.\n- **Busy conversations are skipped** (a call in flight, a recycle or suspend under way).\n- Only `pi-conv-<n>` Sandboxes are considered, which excludes the Phase 1 claim `e2e-phase1`.\n\n## Consequences\n\n- RBAC: `patch` on `sandboxes` (deploy/orchestrator-rbac.yaml). The claim stays the unit of ownership; nothing but the\n  mode is written to the Sandbox.\n- A suspended session costs its PVC and a Service. A resumed one starts a fresh Pod (about 15 s) and loses whatever ran\n  in the old one, which was idle by definition.\n- The workspace marker for repo sessions is on the PVC and survives. The in-memory GitHub token cache\n  (`RepoAccess.beforeUse`) renews its token at the next call as it does after an eviction.\n- Not done: suspending a sandbox that is busy but silent for 30 minutes (a model thinking). Its next command resumes it.\n  const pvc = { name: `workspace-${claimName}`, namespace };\n\n  // Never delete a claim that is not this session's (`get` is already granted for the SDK).\n  try {\n    const found: unknown = await custom.getNamespacedCustomObject(claim);\n    if (labelOf(found) !== sessionKey) {\n      throw new Error(\n        `SandboxClaim ${claimName} is not labelled for this session: not deleting it`,\n      );\n    }\n  } catch (error) {\n    if (statusOf(error) !== 404) throw error;\n  }\n  // Only `delete` is needed: a delete that answers 404 means the object is gone. The PVC is deleted only once\n  // the claim is gone, so the Sandbox controller cannot recreate it from a Sandbox that still exists.\n  const deadline = Date.now() + timeoutMs;\n  for (;;) {\n    const claimPresent = await ignoreNotFound(custom.deleteNamespacedCustomObject(claim));\n    const pvcPresent = claimPresent\n      ? true\n      : await ignoreNotFound(core.deleteNamespacedPersistentVolumeClaim(pvc));\n    if (!claimPresent && !pvcPresent) return;\n    if (Date.now() > deadline) {\n      throw new Error(\n        `timed out deleting ${claimName}: claim ${claimPresent ? \"present\" : \"gone\"}, pvc ${pvcPresent ? \"present\" : \"gone\"}`,\n      );\n    }\n    await sleep(2_000);\n  }\nexport async function suspendSandbox(\n  namespace: string,\n  sandboxName: string,\n  timeoutMs = 120_000,\n): Promise<boolean> {\n  if (!(await setOperatingMode(namespace, sandboxName, \"Suspended\"))) return false;\n  const deadline = Date.now() + timeoutMs;\n  for (;;) {\n    const found = (await listSandboxes(namespace)).find((s) => s.name === sandboxName);\n    if (found === undefined || found.podTerminated) return true;\n    if (Date.now() > deadline) throw new Error(`timed out waiting for ${sandboxName} to suspend`);\n    await sleep(1_000);\n  }\n}\n\n/**\n * Resumes a suspended sandbox before the SDK waits for it to be Ready (a Suspended Sandbox is never Ready, so the\n * wait would run into its timeout). True if it was suspended.\n */\nexport async function resumeIfSuspended(namespace: string, sandboxName: string): Promise<boolean> {\n  const sandbox = (await listSandboxes(namespace)).find((s) => s.name === sandboxName);\n  if (sandbox?.mode !== \"Suspended\") return false;\n  await setOperatingMode(namespace, sandboxName, \"Running\");\n  return true;\n}\n): Promise<boolean> {\n  const { core } = clients();\n  let uid: string | undefined;\n  try {\n    uid = (await core.readNamespacedPod({ name: podName, namespace })).metadata?.uid;\n  } catch (error) {\n    if (statusOf(error) === 404) return false;\n    throw error;\n  }\n  if (uid === undefined) return false;\n  await ignoreNotFound(\n    core.deleteNamespacedPod({\n      name: podName,\n      namespace,\n      // Short grace: what runs inside is what we are getting rid of. The PVC is a network volume, so a 10 s kill\n      // costs no more than a node failure would.\n      gracePeriodSeconds: 10,\n      body: { preconditions: { uid } },\n    }),\n  );\n  const deadline = Date.now() + timeoutMs;\n  for (;;) {\n    try {\n      const current = await core.readNamespacedPod({ name: podName, namespace });\n      // The replacement has the same name, so the uid tells old from new. Wait for it to be Ready: the SDK's own\n      // wait reads the Sandbox status, which can still say Ready for an instant after the Pod changed.\n      const ready = current.status?.conditions?.some(\n        (c) => c.type === \"Ready\" && c.status === \"True\",\n      );\n      if (current.metadata?.uid !== uid && ready === true) return true;\n    } catch (error) {\n      if (statusOf(error) !== 404) throw error;\n    }\n    if (Date.now() > deadline)\n      throw new Error(`timed out waiting for Pod ${podName} to be replaced`);\n","isError":false}]}
ENTRY 11595 {"id":11595,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]## Findings\n\n### 1. Claim ownership check races with deletion\n- Severity: high\n- Confidence: high\n- Location: packages/orchestrator/src/kube.ts:157\n- What happens: A claim can be created or replaced after the ownership check but before a delete in the loop. The delete is by name alone, so teardown can delete a different session’s claim and then its workspace PVC. This also affects the orphan-PVC sweep when a claim appears after the initial 404.\n- Evidence: `getNamespacedCustomObject(claim)` checks the label once; subsequent iterations call `deleteNamespacedCustomObject(claim)` without a UID precondition.\n- Fix idea: Bind deletion to the checked claim UID with a Kubernetes delete precondition. If the initial lookup returns 404, do not delete a subsequently appearing claim; recheck ownership before any deletion.\n\n### 2. Claim disappearance does not guarantee the Sandbox is gone\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/kube.ts:157\n- What happens: Kubernetes can delete the claim using background cascading deletion, so the claim may return 404 while its dependent Sandbox is still being reconciled. The function can then delete the PVC, observe it gone, and return before that Sandbox recreates it, leaving an orphan workspace after teardown reports success.\n- Evidence: `const pvcPresent = claimPresent ? true : await ignoreNotFound(core.deleteNamespacedPersistentVolumeClaim(pvc));`\n- Fix idea: Use foreground cascading deletion and wait for the claim and its dependents to disappear before deleting the PVC, or explicitly wait for the Sandbox to be gone.\n\nEND-OF-REPORT"}]}
DONE
