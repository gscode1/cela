ENTRY 11239 {"id":11239,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"    \"update inbox.tombstones set completed_at = coalesce(completed_at, clock_timestamp()) where session_id = $1\",\n    [sessionId],\n  );\n}\n\n/**\n * Records that a command may be running (or was interrupted) in the sandbox of this conversation. Called when a\n * burst of commands starts; a process that dies mid-command never clears it, which is the signal to recycle the Pod.\n * A conversation without a session row (the test-only control sessions) updates nothing.\n */\nexport async function setExecInFlight(\n  db: Pick<pg.Pool, \"query\">,\n  conversationId: number,\n  inFlight: boolean,\n): Promise<void> {\n  await db.query(\n    \"update inbox.sessions set exec_in_flight_at = case when $2::boolean then clock_timestamp() else null end where conversation_id = $1\",\n    [conversationId, inFlight],\n  );\n}\n\n/** Conversations whose sandbox had a command in flight when the last orchestrator process stopped. */\nexport async function conversationsWithExecInFlight(db: Pick<pg.Pool, \"query\">): Promise<number[]> {\n  const { rows } = await db.query<{ conversation_id: string }>(\n    \"select conversation_id from inbox.sessions where exec_in_flight_at is not null and conversation_id is not null and status in ('active', 'failed', 'deleting')\",\n  );\n  return rows.map((row) => Number(row.conversation_id));\n}\n\n/** What the orphan sweep needs to know about every session: no owner, model or repo. */\nexport interface SessionRef {\n  id: string;\n  status: SessionStatus;\n  conversationId: number | null;\n}\n\nexport async function listSessionRefs(db: Pick<pg.Pool, \"query\">): Promise<SessionRef[]> {\n  const { rows } = await db.query<{\n    id: string;\n    status: SessionStatus;\n    conversation_id: string | null;\n  }>(\"select id, status, conversation_id from inbox.sessions\");\n  return rows.map((row) => ({\n    id: row.id,\n    status: row.status,\n    conversationId: row.conversation_id === null ? null : Number(row.conversation_id),\n  const { custom } = clients();\n  try {\n    await custom.patchNamespacedCustomObject(\n      { ...SANDBOX_REF, namespace, name: sandboxName, body: { spec: { operatingMode: mode } } },\n      setHeaderOptions(\"Content-Type\", PatchStrategy.MergePatch),\n    );\n    return true;\n  } catch (error) {\n    if (statusOf(error) === 404) return false;\n    throw error;\n  }\n}\n\n/**\n * Suspends a sandbox and waits until the controller reports its Pod gone (`Suspended=True`). Waiting matters: a\n * resume that lands while the Pod is still terminating would see a Ready Sandbox and connect to a dying Pod.\n */\nexport async function suspendSandbox(\n  namespace: string,\n  sandboxName: string,\n  timeoutMs = 120_000,\n): Promise<boolean> {\n  if (!(await setOperatingMode(namespace, sandboxName, \"Suspended\"))) return false;\n  const deadline = Date.now() + timeoutMs;\n  for (;;) {\n    const found = (await listSandboxes(namespace)).find((s) => s.name === sandboxName);\n    if (found === undefined || found.podTerminated) return true;\n    if (Date.now() > deadline) throw new Error(`timed out waiting for ${sandboxName} to suspend`);\n    await sleep(1_000);\n  }\n}\n\n/**\n * Resumes a suspended sandbox before the SDK waits for it to be Ready (a Suspended Sandbox is never Ready, so the\n * wait would run into its timeout). True if it was suspended.\n */\nexport async function resumeIfSuspended(namespace: string, sandboxName: string): Promise<boolean> {\n  const sandbox = (await listSandboxes(namespace)).find((s) => s.name === sandboxName);\n  if (sandbox?.mode !== \"Suspended\") return false;\n  await setOperatingMode(namespace, sandboxName, \"Running\");\n  return true;\n}\n\n/**\n * Deletes the sandbox Pod (never the claim or the PVC) so the Sandbox controller creates a clean one on the same\n * PVC, and waits until the replacement is Ready. Needed after an interrupted command: `setsid` children escape\n * pi-env's process-group kill and only a Pod replacement reaps them. The delete is bound to the Pod's uid, so it\n * cannot hit a replacement that already exists. Returns false when there was no Pod.\n */\nexport async function recyclePod(\n  namespace: string,\n  podName: string,\n  timeoutMs = 120_000,\n): Promise<boolean> {\n  const { core } = clients();\n  let uid: string | undefined;\n  try {\n    uid = (await core.readNamespacedPod({ name: podName, namespace })).metadata?.uid;\n  } catch (error) {\n    if (statusOf(error) === 404) return false;\n    throw error;\n  }\n  if (uid === undefined) return false;\n  await ignoreNotFound(\n    core.deleteNamespacedPod({\n      name: podName,\n      namespace,\n      // Short grace: what runs inside is what we are getting rid of. The PVC is a network volume, so a 10 s kill\n      // costs no more than a node failure would.\n      gracePeriodSeconds: 10,\n      body: { preconditions: { uid } },\n    }),\n  );\n  const deadline = Date.now() + timeoutMs;\n  for (;;) {\n    try {\n      const current = await core.readNamespacedPod({ name: podName, namespace });\n      // The replacement has the same name, so the uid tells old from new. Wait for it to be Ready: the SDK's own\n      // wait reads the Sandbox status, which can still say Ready for an instant after the Pod changed.\n      const ready = current.status?.conditions?.some(\n        (c) => c.type === \"Ready\" && c.status === \"True\",\n      );\n      if (current.metadata?.uid !== uid && ready === true) return true;\n    } catch (error) {\n      if (statusOf(error) !== 404) throw error;\n    }\n    if (Date.now() > deadline)\n      throw new Error(`timed out waiting for Pod ${podName} to be replaced`);\n    await sleep(1_000);\n  }\n}\n   */\n  workspaceEnv(id: number): Promise<WorkspaceEnv> {\n    return Promise.resolve(this.#sandboxes.lazyEnv(id));\n  }\n\n  /** Stops the session's bridge and deletes its SandboxClaim and PVC. */\n  async destroySandbox(id: number): Promise<void> {\n    await this.#sandboxes.destroy(id);\n  }\n\n  /** The orphan sweep's delete of a claim and its PVC: the session deletion's teardown, for a claim with no live session. */\n  async destroyOrphanSandbox(claimName: string, sessionLabel: string): Promise<void> {\n    await this.#sandboxes.destroyOrphan(claimName, sessionLabel);\n  }\n\n  async #conversation(id: number): Promise<Conversation> {\n    const conversation = await this.#harness.conversation(id as ConversationId, context);\n    if (conversation === undefined) throw new Error(`conversation ${String(id)} does not exist`);\n    return conversation;\n  }\n\n  /** Waits for in-flight work to settle and closes storage; bridges stop, claims stay. */\n  async close(): Promise<void> {\n    await this.#harness.close(context);\n    await this.#sandboxes.closeAll();\n  }\n}\n   275\t    if (opened !== undefined) (await opened.catch(() => undefined))?.close();\n   276\t  }\n   277\t\n   278\t  /** Suspends the sandboxes that have been idle for `idleSuspendMs`. Never throws: it runs on a timer. */\n   279\t  async #suspendIdle(): Promise<void> {\n   280\t    try {\n   281\t      const sandboxes = await listSandboxes(this.#config.namespace);\n   282\t      const now = Date.now();\n   283\t      const busy = new Set<number>(this.#replacing.keys());\n   284\t      for (const [conversationId, usage] of this.#usage)\n   285\t        if (usage.inUse > 0) busy.add(conversationId);\n   286\t      for (const sandbox of sandboxes) {\n   287\t        const conversationId = conversationOfName(sandbox.name);\n   288\t        if (conversationId !== undefined && sandbox.mode === \"Suspended\")\n   289\t          this.#lastUsed.delete(conversationId);\n   290\t      }\n   291\t      const plan = planSuspend({\n   292\t        running: sandboxes.filter((s) => s.mode === \"Running\").map((s) => s.name),\n   293\t        lastUsed: this.#lastUsed,\n   294\t        busy,\n   295\t        now,\n   296\t        afterMs: this.#config.sandbox.idleSuspendMs,\n   297\t      });\n   298\t      for (const conversationId of plan.seen) this.#lastUsed.set(conversationId, now);\n   299\t      for (const conversationId of plan.suspend) {\n   300\t        this.#replace(conversationId, \"idle\", async () => {\n   301\t          await this.#closeEnv(conversationId);\n   302\t          await suspendSandbox(this.#config.namespace, claimNameFor(conversationId));\n   303\t        });\n   304\t      }\n   305\t    } catch (error) {\n   306\t      log(\"suspend-scan-failed\", { message: errorMessage(error) });\n   307\t    }\n   308\t  }\n   309\t\n   310\t  /** Creates or adopts the claim and waits for its Sandbox; safe to call on every start. */\n   311\t  async ensure(conversationId: number): Promise<SandboxEnv> {\n   312\t    let env = this.#envs.get(conversationId);\n   313\t    if (env === undefined) {\n   314\t      env = this.#open(conversationId);\n   315\t      this.#envs.set(conversationId, env);\n   316\t      // A failed open must not be cached: the next tool call tries again.\n   317\t      env.catch(() => this.#envs.delete(conversationId));\n   318\t    }\n   319\t    return env;\n   320\t  }\n   321\t\n   322\t  async #open(conversationId: number): Promise<SandboxEnv> {\n   323\t    const claimName = claimNameFor(conversationId);\n   324\t    const { namespace, warmPool } = this.#config;\n   325\t    // Required: a sandbox with no token would be unauthenticated or unreachable. Only the hash goes into the claim.\n   326\t    const master = process.env[ENV.masterKey];\n   327\t    if (master === undefined || master === \"\") throw new Error(`${ENV.masterKey} is not set`);\n   328\t    const token = deriveSandboxToken(master, claimName);\n   329\t    try {\n   330\t      // Create the claim with the session label, or accept an existing one only if the label matches. The SDK\n   331\t      // then adopts it by name.\n   332\t      await ensureLabeledClaim(\n   333\t        namespace,\n   334\t        claimName,\n   335\t        warmPool,\n   336\t        await this.#sessionKeyOf(conversationId),\n   337\t        [{ name: SANDBOXD_TOKEN_SHA256_ENV, value: sandboxTokenSha256(token) }],\n   338\t      );\n   339\t      // A suspended sandbox is never Ready, so the wait below would only time out: resume it first.\n   340\t      if (await resumeIfSuspended(namespace, claimName))\n   341\t        log(\"sandbox-resumed\", { claim: claimName });\n   342\t      await ensureClaim({\n   343\t        claimName,\n   344\t        namespace,\n   345\t        warmPool,\n   346\t        connectivity: \"in-cluster-service\",\n   347\t        authToken: token,\n   348\t      });\n   349\t    } catch (error) {\n   350\t      log(\"claim-failed\", { claim: claimName, message: errorMessage(error) });\n   351\t      throw error;\n   352\t    }\n   353\t    log(\"claim-ready\", { claim: claimName });\n   354\t    // Credentials for a repo session's commands only; plain sessions get nothing here. The token travels through the\n   355\t    // pi-env protocol to the daemon, never through the bridge process environment (bridge-launcher derives its own claim's token and drops the master).\n   356\t    const shellEnv = await this.#hooks.shellEnv?.(conversationId);\n   357\t    return connectSandboxEnv({\n   358\t      claimName,\n   359\t      namespace,\n   360\t      cwd: WORKSPACE,\n   361\t      id: `pi-env:${claimName}`,\n   362\t      bridgeCommand: [process.execPath, BRIDGE_LAUNCHER],\n   363\t      ...(shellEnv === undefined ? {} : { shellEnv }),\n   364\t    });\n   365\t  }\n   366\t\n   367\t  /**\n   368\t   * Session deletion: stops the bridge, then deletes the SandboxClaim and the PVC. Idempotent, so a deletion cut\n   369\t   * off by a crash is simply run again. With `destroyOrphan` the only place that deletes a claim.\n   370\t   */\n   371\t  async destroy(conversationId: number): Promise<void> {\n   372\t    await this.#teardown(conversationId, await this.#sessionKeyOf(conversationId));\n   373\t  }\n   374\t\n   375\t  /**\n   376\t   * The orphan sweep's delete: the same teardown as a session deletion, for a claim whose session is deleted or\n   377\t   * unknown. `sessionLabel` is the label the sweep read from the claim, so `deleteClaimAndPvc` still refuses a\n   378\t   * claim that changed hands meanwhile.\n   379\t   */\n   380\t  async destroyOrphan(claimName: string, sessionLabel: string): Promise<void> {\n   381\t    const conversationId = conversationOfName(claimName);\n   382\t    if (conversationId === undefined) throw new Error(`${claimName} is not a conversation claim`);\n   383\t    await this.#teardown(conversationId, sessionLabel);\n   384\t  }\n   385\t\n   386\t  async #teardown(conversationId: number, sessionKey: string): Promise<void> {\n   387\t    await this.#replacing.get(conversationId);\n   388\t    this.#interrupted.delete(conversationId);\n   389\t    this.#failed.delete(conversationId);\n   390\t    this.#lastUsed.delete(conversationId);\n","isError":false}]}
ENTRY 11297 {"id":11297,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]## Findings\n### 1. Clearing the in-flight record can race with the next command\n- Severity: high\n- Confidence: high\n- Location: packages/orchestrator/src/sandboxes.ts:202\n- What happens: After a command finishes, its database record is cleared asynchronously without blocking the next command. If the next command sets the record before the earlier clear completes, the clear can leave the record unset while the new command is running. An orchestrator crash then fails to trigger the required Pod recycle on restart, allowing leftover processes to survive.\n- Evidence: `usage.recorded = false; void this.#hooks.execInFlight?.(conversationId, false)`\n- Fix idea: Serialize per-conversation record updates and wait for a pending clear before recording and starting another command.\n\nEND-OF-REPORT"}]}
