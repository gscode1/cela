t    why: \"interrupted\" | \"orchestrator-restart\" | \"idle\",\n   239\t    work: () => Promise<void>,\n   240\t  ): void {\n   241\t    if (this.#replacing.has(conversationId)) return;\n   242\t    const claim = claimNameFor(conversationId);\n   243\t    const run = (async () => {\n   244\t      await work();\n   245\t      this.#failed.delete(conversationId);\n   246\t      this.#lastUsed.delete(conversationId);\n   247\t      log(why === \"idle\" ? \"sandbox-suspended\" : \"sandbox-recycled\", { claim, why });\n   248\t    })()\n   249\t      .catch((error: unknown) => {\n   250\t        if (why !== \"idle\") this.#failed.set(conversationId, { why, work });\n   251\t        log(\"sandbox-replace-failed\", { claim, why, message: errorMessage(error) });\n   252\t      })\n   253\t      .finally(() => this.#replacing.delete(conversationId));\n   254\t    this.#replacing.set(conversationId, run);\n   255\t  }\n   256\t\n   257\t  /**\n   258\t   * After a start: the conversations that had a command in flight when the previous process stopped. Their Pods are\n   259\t   * replaced before Pi Durable resumes (the caller invokes this first), so the continuing run finds a clean sandbox.\n   260\t   * Nothing is known about which of them really has a leftover child, so every one is recycled.\n","isError":false}]}
