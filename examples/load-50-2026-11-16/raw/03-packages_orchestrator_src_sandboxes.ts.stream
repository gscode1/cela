await this.#hooks.execInFlight?.(conversationId, true);\n   160\t              usage.recorded = true;\n   161\t            }\n   162\t            try {\n   163\t              const result = await real[property]?.(...args);\n   164\t              outcome = { threw: false, result };\n   165\t              return result;\n   166\t            } catch (error) {\n   167\t              outcome = { threw: true };\n   168\t              throw error;\n   169\t            }\n   170\t          } finally {\n   171\t            usage.inUse--;\n   172\t            usage.lastUsed = Date.now();\n   173\t            this.#lastUsed.set(conversationId, usage.lastUsed);\n   174\t            if (property === \"exec\" && outcome !== undefined && interruptedExec(outcome)) {\n   175\t              this.#interrupted.add(conversationId);\n   176\t            }\n   177\t            if (usage.inUse === 0) this.#settle(conversationId, usage);\n   178\t          }\n   179\t        };\n   180\t      },\n   181\t      set: (object, property, value) => {\n   182\t        if (property === \"cwd\") object.cwd = String(value);\n   183\t        return property === \"cwd\";\n   184\t      },\n   185\t    }) as unknown as ExecutionEnv;\n   186\t  }\n   187\t\n   188\t  /**\n   189\t   * No call is in flight any more. An interrupted command means its sandbox may hold children that escaped the\n   190\t   * process-group kill: replace the Pod. Otherwise the commands ended on their own and the in-flight record goes.\n   191\t   */\n   192\t  #settle(conversationId: number, usage: Usage): void {\n   193\t    if (this.#interrupted.has(conversationId) && !this.#replacing.has(conversationId)) {\n   194\t      this.#interrupted.delete(conversationId);\n   195\t      this.#replace(conversationId, \"interrupted\", async () => {\n   196\t        await this.#closeEnv(conversationId);\n   197\t        await recyclePod(this.#config.namespace, claimNameFor(conversationId));\n   198\t        // Cleared only now: if the r