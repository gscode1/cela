ENTRY 11294 {"id":11294,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import type { SessionRef } from \"@pi-durable-k8s/session-core\";\nimport { errorMessage, log } from \"./log.js\";\nimport { planSweep } from \"./sweep.js\";\nimport type { SweepAction, SweepAgent, SweepClaim, SweepPvc, SweepSecret } from \"./sweep.js\";\n\nexport interface SweeperDeps {\n  listSessions: () => Promise<SessionRef[]>;\n  listClaims: () => Promise<SweepClaim[]>;\n  listPvcs: () => Promise<SweepPvc[]>;\n  /** Undefined when OneCLI is not configured: the sweep then leaves agents alone. */\n  listOneCli: (() => Promise<{ agents: SweepAgent[]; secrets: SweepSecret[] }>) | undefined;\n  /** The session deletion's teardown: stops the bridge, deletes the claim, then the PVC. Also removes a lone PVC. */\n  destroyClaim: (claimName: string, sessionLabel: string) => Promise<void>;\n  revokeSession: (sessionId: string) => Promise<void>;\n  graceMs: number;\n  maxActions: number;\n  now?: () => number;\n}\n\n/**\n * The execution half of the orphan sweep: reads the world, asks `planSweep` what is orphaned, does it, logs each\n * action. One run at a time. A failing action is logged and the run goes on; the next run retries it. The log lines\n * carry names and ids only, never a token or secret value.\n */\nexport class OrphanSweeper {\n  readonly #deps: SweeperDeps;\n  #running = false;\n  #timer: NodeJS.Timeout | undefined;\n\n  constructor(deps: SweeperDeps) {\n    this.#deps = deps;\n  }\n\n  start(intervalMs: number): void {\n    if (intervalMs <= 0) {\n      log(\"sweep-disabled\", {});\n      return;\n    }\n    this.#timer = setInterval(() => void this.run(), intervalMs);\n    this.#timer.unref();\n  }\n\n  stop(): void {\n    if (this.#timer !== undefined) clearInterval(this.#timer);\n  }\n\n  /** One sweep. Returns the actions that succeeded; never throws. */\n  async run(): Promise<SweepAction[]> {\n    if (this.#running) return [];\n    this.#running = true;\n    const done: SweepAction[] = [];\n    try {\n      const d = this.#deps;\n      const [sessions, claims, pvcs, oneCli] = await Promise.all([\n        d.listSessions(),\n        d.listClaims(),\n        d.listPvcs(),\n        d.listOneCli?.(),\n      ]);\n      const actions = planSweep({\n        sessions,\n        claims,\n        pvcs,\n        agents: oneCli?.agents,\n        secrets: oneCli?.secrets ?? [],\n        now: d.now?.() ?? Date.now(),\n        graceMs: d.graceMs,\n        maxActions: d.maxActions,\n      });\n      for (const action of actions) {\n        try {\n          await this.#apply(action);\n          log(\"sweep-action\", { ...action });\n          done.push(action);\n        } catch (error) {\n          log(\"sweep-action-failed\", { ...action, message: errorMessage(error) });\n        }\n      }\n      if (actions.length > 0) log(\"sweep-done\", { planned: actions.length, done: done.length });\n    } catch (error) {\n      log(\"sweep-failed\", { message: errorMessage(error) });\n    } finally {\n      this.#running = false;\n    }\n    return done;\n  }\n\n  async #apply(action: SweepAction): Promise<void> {\n    switch (action.kind) {\n      case \"delete-claim\":\n        return this.#deps.destroyClaim(action.claim, action.sessionLabel);\n      case \"delete-pvc\":\n        // The claim does not exist, so there is no label to check; deleteClaimAndPvc refuses if one appears meanwhile.\n        return this.#deps.destroyClaim(action.claim, \"orphan-pvc-sweep\");\n      case \"revoke-agent\":\n        return this.#deps.revokeSession(action.sessionId);\n    }\n  }\n}\n  }\n\n  async #create(sessionId: string): Promise<number> {\n    const current = await getSession(this.#pool, sessionId);\n    if (current?.conversationId != null) return current.conversationId;\n    const conversationId = await this.#host.createConversation(\n      current?.model ?? this.#options.defaultModel,\n    );\n    await this.#pool.query(\n      \"update inbox.sessions set conversation_id = $1 where id = $2 and conversation_id is null\",\n      [conversationId, sessionId],\n    );\n    log(\"conversation-created\", { session: sessionId, conversation: conversationId });\n    return conversationId;\n  }\n\n  /** Applies one inbox event. Resolves when it is durably handed over; throws PermanentError if it never can be. */\n  async apply(event: InboxEvent, session: SessionRow): Promise<void> {\n    if (session.status === \"deleted\") throw new PermanentError(\"session is deleted\");\n    switch (event.kind) {\n      case \"message\":\n      case \"steer\": {\n        const text = event.payload.text;\n        if (typeof text !== \"string\" || text === \"\") throw new PermanentError(\"event has no text\");\n        if (session.status === \"failed\") {\n          // Retries an abort that failed when the session was failed (see #failSession); throws, and so retries the\n          // row, if the abort fails again.\n          if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n          throw new PermanentError(\"session has failed\");\n        }\n        const conversationId = await this.ensureConversation(session);\n        await this.#withinBudget(session, conversationId);\n        // Before the first turn: OneCLI agent, token and clone. A session without a repo skips all of it.\n        if (session.repo !== null) await this.#prepareRepo(session, conversationId);\n        const requestId = event.id;\n        const faultArmed =\n          this.#options.testFaults && event.payload.testFault === \"exit-after-submit\";\n        const alreadyAdmitted =\n          faultArmed && (await this.#host.hasSubmission(conversationId, requestId));\n        await this.#host.submitInput(conversationId, {\n          text,\n          requestId,\n          steer: event.kind === \"steer\",\n        });\n        this.#watcher.add({ sessionId: session.id, conversationId, requestId });\n        if (faultArmed && !alreadyAdmitted) {\n          // After the durable hand-over, before the row says so: exactly the window test 4 needs.\n          // Synchronous write: stdout to a pipe is async and process.exit would drop the line.\n          writeSync(\n            1,\n            `${JSON.stringify({ event: \"test-fault\", fault: \"exit-after-submit\", id: event.id })}\\n`,\n          );\n          process.exit(137);\n        }\n        return;\n      }\n      case \"cancel\": {\n        if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n        return;\n      }\n      case \"delete\": {\n        await this.#delete(session);\n        return;\n      }\n    }\n  }\n\n  /**\n   * Provisions the repo session's GitHub access and makes sure its clone exists. What no retry can fix ends the input\n   * for good (and, for a lost workspace or refused access, the session): the agent must not run a turn in a workspace\n   * that is not the one the user asked for. Anything else throws as is, so the inbox retries it.\n   */\n  async #prepareRepo(session: SessionRow, conversationId: number): Promise<void> {\n    const repos = this.#options.repos;\n    if (repos === undefined) throw new PermanentError(\"repository workspaces are not configured\");\n    try {\n      await repos.prepare(session, await this.#host.workspaceEnv(conversationId));\n    } catch (error) {\n      if (error instanceof WorkspaceLostError) {\n        await this.#failSession(session.id, conversationId, error.message);\n        throw new PermanentError(error.message);\n      }\n      if (error instanceof GithubDeniedError) {\n        const failure =\n          \"GitHub refused access to the repository: is the GitHub App installed on it?\";\n        await this.#failSession(session.id, conversationId, failure);\n        throw new PermanentError(failure);\n      }\n      if (error instanceof RepoUnavailableError) throw new PermanentError(error.message);\n      throw error;\n    }\n  }\n\n  /**\n   * The per-session turn budget, checked before every input: a session that used all its turns fails for good, and\n   * otherwise the conversation's `maxTurns` is set to what is left, so a single long run cannot overshoot it.\n   * Turns are model responses, counted from the stored transcript, so a restart does not reset the count.\n   */\n  async #withinBudget(session: SessionRow, conversationId: number): Promise<void> {\n    const used = await this.#host.turnsUsed(conversationId);\n    const left = this.#options.turnBudget - used;\n    if (left <= 0) {\n      const failure = terminalFailure({ reason: \"turn_limit\" });\n      await this.#failSession(session.id, conversationId, failure ?? \"turn budget exhausted\");\n      throw new PermanentError(\"turn budget exhausted\");\n    }\n    await this.#host.limitTurns(conversationId, left);\n  }\n\n  /**\n   * Stop the session, delete the SandboxClaim and PVC, mark the session deleted. The conversation's stored state\n   * stays: the Postgres adapter can only delete it in a maintenance window (docs/session-api.md).\n   */\n  async #delete(session: SessionRow): Promise<void> {\n    log(\"session-delete-start\", { session: session.id });\n    // Record what the session holds before anything is revoked, then revoke its OneCLI agent first: from that moment\n    // its proxy token is dead, whatever happens to the claim after. A plain session has no OneCLI objects.\n    await writeTombstone(this.#pool, session);\n    await this.#options.repos?.teardown(session);\n    const conversationId = session.conversationId;\n    if (conversationId !== null) {\n      await this.#host.abort(conversationId);\n      this.streams.closeSession(session.id, \"deleted\");\n      await this.#host.destroySandbox(conversationId);\n    }\n    await this.#pool.query(\n      \"update inbox.sessions set status = 'deleted', last_activity_at = clock_timestamp() where id = $1\",\n      [session.id],\n    );\n    await completeTombstone(this.#pool, session.id);\n    log(\"session-deleted\", { session: session.id });\n  }\n}\nimport { BACKGROUND_CONTEXT as context } from \"@earendil-works/chord/context\";\nimport type { ExecutionEnv } from \"@earendil-works/pi-durable/env\";\nimport { cloneUrl } from \"@pi-durable-k8s/session-core\";\nimport type { RepoSpec } from \"@pi-durable-k8s/session-core\";\nimport { Redacted } from \"./onecli.js\";\n\nexport const WORKSPACE_ROOT = \"/workspace\";\nexport const REPO_DIR = `${WORKSPACE_ROOT}/repo`;\nexport const CLONE_TMP = `${WORKSPACE_ROOT}/.clone-tmp`;\n/** Written once the clone is complete. If it is missing later, the workspace was lost and nothing recreates it. */\nexport const MARKER = `${WORKSPACE_ROOT}/.pi-workspace.json`;\n/** Public material only: the OneCLI gateway CA, never a credential. */\nexport const CA_DIR = `${WORKSPACE_ROOT}/.onecli`;\nexport const CA_FILE = `${CA_DIR}/ca.pem`;\n/** System roots plus the OneCLI CA. Hosts the gateway only tunnels (no injection) still present real certificates. */\nexport const CA_BUNDLE = `${CA_DIR}/bundle.pem`;\nconst SYSTEM_BUNDLE = \"/etc/ssl/certs/ca-certificates.crt\";\n\nconst CLONE_TIMEOUT_S = 600;\n\n/** The part of `ExecutionEnv` the workspace needs; narrower so tests can run it on a local env. */\nexport type WorkspaceEnv = Pick<\n  ExecutionEnv,\n  \"exec\" | \"exists\" | \"createDir\" | \"remove\" | \"renameFile\" | \"writeFile\" | \"readTextFile\"\n>;\n\n/** The workspace was ready once, but its marker or repository is gone (PVC replaced, files removed). Not re-cloned. */\nexport class WorkspaceLostError extends Error {}\n\n/**\n * Environment of one repo session's tool commands, handed to pi-env as `shellEnv`: it is added to the remote\n * environment of every command of that session's env, and of no other session's.\n *\n * The proxy URL carries the session's OneCLI agent token as its password. The plan treats that token as readable by\n * the agent: what bounds it is the grant (one repository, via a GitHub App token that OneCLI injects and the sandbox\n * never sees), the session lifetime and deletion. `GIT_CONFIG_COUNT` is used instead of `GIT_CONFIG`, which only\n * `git config` reads; `proxyAuthMethod=basic` makes git send the proxy credentials at once (spike Q3).\n */\nexport function buildShellEnv(input: { gateway: string; token: Redacted }): Record<string, string> {\n  const proxy = new URL(input.gateway);\n  proxy.username = \"x\";\n  proxy.password = input.token.reveal();\n  const proxyUrl = proxy.toString().replace(/\\/$/, \"\");\n  return {\n    HTTPS_PROXY: proxyUrl,\n    https_proxy: proxyUrl,\n    NO_PROXY: \"localhost,127.0.0.1,::1\",\n    no_proxy: \"localhost,127.0.0.1,::1\",\n    SSL_CERT_FILE: CA_BUNDLE,\n    GIT_SSL_CAINFO: CA_BUNDLE,\n    NODE_EXTRA_CA_CERTS: CA_FILE,\n    NODE_USE_ENV_PROXY: \"1\",\n    GIT_CONFIG_COUNT: \"1\",\n    GIT_CONFIG_KEY_0: \"http.proxyAuthMethod\",\n    GIT_CONFIG_VALUE_0: \"basic\",\n    GIT_TERMINAL_PROMPT: \"0\",\n    GIT_AUTHOR_NAME: \"pi agent\",\n    GIT_AUTHOR_EMAIL: \"pi-agent@users.noreply.github.com\",\n    GIT_COMMITTER_NAME: \"pi agent\",\n    GIT_COMMITTER_EMAIL: \"pi-agent@users.noreply.github.com\",\n  };\n}\n\nasync function isTrue(result: ReturnType<WorkspaceEnv[\"exists\"]>): Promise<boolean> {\n  const checked = await result;\n  return checked.ok && checked.value;\n}\n\nasync function must<T>(\n  result: Promise<{ ok: true; value: T } | { ok: false; error: Error }>,\n  what: string,\n): Promise<T> {\n  const done = await result;\n  if (!done.ok) throw new Error(`${what}: ${done.error.message}`);\n  return done.value;\n}\n\n/** Writes the gateway CA and the bundle that git, curl and OpenSSL clients trust. Rewritten every time: it is public. */\nasync function writeCa(env: WorkspaceEnv, p: Paths, ca: string): Promise<void> {\n  await must(env.createDir(p.caDir, { recursive: true }, context), \"create CA directory\");\n  await must(env.writeFile(p.caFile, ca, context), \"write the OneCLI CA\");\n  const system = await env.readTextFile(SYSTEM_BUNDLE, context);\n  const bundle = system.ok ? `${system.value.trimEnd()}\\n${ca}` : ca;\n  await must(env.writeFile(p.caBundle, bundle, context), \"write the CA bundle\");\n}\n\nfunction pathsFor(root: string) {\n  return {\n    root,\n    repo: `${root}/repo`,\n    cloneTmp: `${root}/.clone-tmp`,\n    marker: `${root}/.pi-workspace.json`,\n    caDir: `${root}/.onecli`,\n    caFile: `${root}/.onecli/ca.pem`,\n    caBundle: `${root}/.onecli/bundle.pem`,\n  };\n}\ntype Paths = ReturnType<typeof pathsFor>;\n\nexport interface PrepareOptions {\n  /** Only tests change this: the workspace root. */\n  root?: string;\n  /** PEM of the OneCLI gateway CA. */\n  ca: string;\n  sessionId: string;\n  /** The session finished a clone before (`workspace_ready_at`). */\n  wasReady: boolean;\n  /** Only tests change this: the clone URL base. */\n  gitBase?: string;\n  now?: () => Date;\n}\n\n/**\n * Makes `/workspace/repo` exist, once. Idempotent and crash-safe: the clone goes to `/workspace/.clone-tmp` and is\n * renamed into place, so `/workspace/repo/.git` exists only for a complete clone, and that is what makes later calls\n * skip it. argv with `--` keeps the repo and branch from being read as options (both are also validated).\n * Returns \"cloned\" when it cloned, \"present\" when the repository was already there.\n *\n * A session that was ready before but now lacks its marker or repository is reported with WorkspaceLostError and\n * never cloned again behind the user's back.\n */\nexport async function prepareWorkspace(\n  env: WorkspaceEnv,\n  spec: RepoSpec,\n  options: PrepareOptions,\n): Promise<\"cloned\" | \"present\"> {\n  const p = pathsFor(options.root ?? WORKSPACE_ROOT);\n  await writeCa(env, p, options.ca);\n  const hasRepo = await isTrue(env.exists(`${p.repo}/.git`, context));\n  const hasMarker = await isTrue(env.exists(p.marker, context));\n  if (options.wasReady && (!hasMarker || !hasRepo)) {\n    throw new WorkspaceLostError(\n      \"the session's workspace is missing (repository or marker not found); it is not cloned again\",\n    );\n  }\n  let outcome: \"cloned\" | \"present\" = \"present\";\n  if (!hasRepo) {\n    await clone(env, p, spec, options.gitBase);\n    outcome = \"cloned\";\n  }\n  if (!hasMarker || outcome === \"cloned\") {\n    const marker = {\n      version: 1,\n      sessionId: options.sessionId,\n      repo: spec.repo,\n      ...(spec.branch === undefined ? {} : { branch: spec.branch }),\n      createdAt: (options.now?.() ?? new Date()).toISOString(),\n    };\n    await must(env.writeFile(p.marker, `${JSON.stringify(marker)}\\n`, context), \"write the marker\");\n  }\n  return outcome;\n}\n\nasync function clone(\n  env: WorkspaceEnv,\n  p: Paths,\n  spec: RepoSpec,\n  gitBase: string | undefined,\n): Promise<void> {\n  // A temp dir left by a crash during an earlier clone is incomplete by definition.\n  await must(\n    env.remove(p.cloneTmp, { recursive: true, force: true }, context),\n    \"clear the clone directory\",\n  );\n  let tail = \"\";\n  const run = await must(\n    env.exec(\n      [\n        \"git\",\n        \"clone\",\n        ...(spec.branch === undefined ? [] : [\"--branch\", spec.branch]),\n        \"--\",\n        cloneUrl(spec.repo, gitBase),\n        p.cloneTmp,\n      ],\n      {\n        cwd: p.root,\n        timeout: CLONE_TIMEOUT_S,\n        onOutput: (text) => {\n          tail = (tail + text).slice(-400);\n        },\n      },\n      context,\n    ),\n    \"git clone\",\n  );\n  if (run.exitCode !== 0) {\n    await env.remove(p.cloneTmp, { recursive: true, force: true }, context);\n    throw new Error(`git clone failed (exit ${String(run.exitCode)}): ${tail.trim()}`);\n  }\n  await must(env.renameFile(p.cloneTmp, p.repo, context), \"move the clone into place\");\n}\n","isError":false}]}
