ENTRY 11948 {"id":11948,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { fileURLToPath } from \"node:url\";\nimport { Connection, RemoteExecutionEnv } from \"@earendil-works/pi-env\";\n\nimport { StartGate, gatedStart } from \"./start-gate.js\";\n\n/** One gate per process: all of this process's bridges cold-start through it. 45 s is above a slow start. */\nconst startGate = new StartGate(45_000);\n\nexport { runBridge } from \"./bridge.js\";\nexport type { BridgeOptions, RemoteProcess, StartProcess } from \"./bridge.js\";\nexport { ENV } from \"./config.js\";\nexport { ensureClaim } from \"./sandbox-client.js\";\nexport { SANDBOXD_TOKEN_SHA256_ENV, deriveSandboxToken, sandboxTokenSha256 } from \"./token.js\";\nexport type { ClaimRequest, Connectivity } from \"./sandbox-client.js\";\n\nexport interface SandboxEnvOptions {\n  claimName: string;\n  namespace: string;\n  /** Working directory inside the sandbox; must exist there (e.g. the workspace mount). */\n  cwd: string;\n  /** File namespace for the env, e.g. `pi-env:<conversation id>`. */\n  id: string;\n  connectivity?: \"in-cluster-service\" | \"in-cluster-pod-ip\" | \"port-forward\";\n  /** argv of the bridge program. Defaults to `node <this package>/dist/cli.js`. */\n  bridgeCommand?: readonly string[];\n  shellPath?: string;\n  /**\n   * Added to the environment of every command this env runs (pi-env's `shellEnv`), and of no other env's. It goes\n   * through the pi-env protocol to the daemon, not through the bridge's own environment.\n   */\n  shellEnv?: Record<string, string>;\n}\n\nexport interface SandboxEnv {\n  env: RemoteExecutionEnv;\n  connection: Connection;\n  /** Stops the bridge; the daemon then ends its commands and exits. */\n  close(): void;\n}\n\n/**\n * pi-env's Connection can only spawn a local program, so the sandbox hop is a bridge process that\n * receives the `serve --token` arguments Connection appends. The sandboxd token is read by the\n * bridge from its own PI_SANDBOX_AUTH_TOKEN, which bridge-launcher derives per claim (see token.ts).\n */\nexport function connectSandboxEnv(options: SandboxEnvOptions): SandboxEnv {\n  const bridge = options.bridgeCommand ?? [\n    process.execPath,\n    fileURLToPath(new URL(\"./cli.js\", import.meta.url)),\n  ];\n  const start = gatedStart(startGate, [\n    ...bridge,\n    \"--claim\",\n    options.claimName,\n    \"--namespace\",\n    options.namespace,\n    ...(options.connectivity ? [\"--connectivity\", options.connectivity] : []),\n  ]);\n  const connection = new Connection({ command: start.command, onLog: start.onLog });\n  const env = new RemoteExecutionEnv({\n    connection,\n    id: options.id,\n    cwd: options.cwd,\n    ...(options.shellPath === undefined ? {} : { shellPath: options.shellPath }),\n    ...(options.shellEnv === undefined ? {} : { shellEnv: options.shellEnv }),\n  });\n  return {\n    env,\n    connection,\n    close: () => {\n      start.release();\n      connection.close();\n    },\n  };\n}\nimport type { Readable, Writable } from \"node:stream\";\n\n/** A process started inside a sandbox. Implemented by sandbox-client.ts and by test fakes. */\nexport interface RemoteProcess {\n  /** Resolves when the bytes are delivered. A rejection leaves an unknown prefix delivered. */\n  write(data: Uint8Array): Promise<void>;\n  closeStdin(): Promise<void>;\n  wait(): Promise<{ exitCode: number }>;\n  /** Tears the stream down; sandboxd kills the process group. Idempotent. */\n  close(): Promise<void>;\n}\n\nexport interface OutputHandlers {\n  onStdout(chunk: Uint8Array): void;\n  onStderr(chunk: Uint8Array): void;\n}\n\nexport type StartProcess = (\n  command: string,\n  args: readonly string[],\n  handlers: OutputHandlers,\n) => Promise<RemoteProcess>;\n\n/** Written to the bridge's stderr once the remote process is running. */\nexport const BRIDGE_READY = \"bridge: ready\";\n\nexport interface BridgeOptions {\n  start: StartProcess;\n  command: string;\n  args: readonly string[];\n  stdin: Readable;\n  stdout: Writable;\n  stderr: Writable;\n}\n\ntype Outcome =\n  { kind: \"exit\"; exitCode: number } | { kind: \"stdin-done\" } | { kind: \"fatal\"; reason: string };\n\n/** Remote codes outside 1..255 (signal deaths, negatives) must still read as failure. */\nfunction toExitCode(exitCode: number): number {\n  if (exitCode === 0) return 0;\n  return Number.isInteger(exitCode) && exitCode > 0 && exitCode <= 255 ? exitCode : 1;\n}\n\nfunction describe(error: unknown): string {\n  return error instanceof Error ? error.message : String(error);\n}\n\nfunction flush(stream: Writable): Promise<void> {\n  return new Promise((resolve) => stream.write(new Uint8Array(0), () => resolve()));\n}\n\n/**\n * Pipes stdin to the remote process and its stdout to ours, byte for byte, and returns the exit code\n * the bridge should exit with. Stdin writes are awaited one at a time: the SDK sends each as its own\n * RPC, and concurrent RPCs could reorder bytes inside a pi-env frame. Any write failure or stream\n * loss is fatal because a half-delivered frame cannot be repaired; pi-env's Connection restarts us.\n */\nexport async function runBridge(options: BridgeOptions): Promise<number> {\n  const { stdin, stdout, stderr } = options;\n  let proc: RemoteProcess;\n  try {\n    proc = await options.start(options.command, options.args, {\n      onStdout: (chunk) => void stdout.write(chunk),\n      onStderr: (chunk) => void stderr.write(chunk),\n    });\n  } catch (error) {\n    stderr.write(`bridge: cannot start ${options.command}: ${describe(error)}\\n`);\n    return 1;\n  }\n  // Tells the parent that the cold start (the CPU-heavy part) is over; see StartGate.\n  stderr.write(`${BRIDGE_READY}\\n`);\n\n  const exited = proc.wait().then(\n    (result): Outcome => ({ kind: \"exit\", exitCode: toExitCode(result.exitCode) }),\n    (error: unknown): Outcome => ({\n      kind: \"fatal\",\n      reason: `remote stream lost: ${describe(error)}`,\n    }),\n  );\n  const outputFailed = new Promise<Outcome>((resolve) =>\n    stdout.once(\"error\", (error) =>\n      resolve({ kind: \"fatal\", reason: `stdout write failed: ${describe(error)}` }),\n    ),\n  );\n  const pumped = (async (): Promise<Outcome> => {\n    try {\n      for await (const chunk of stdin) {\n        await proc.write(chunk as Uint8Array);\n      }\n      await proc.closeStdin();\n      return { kind: \"stdin-done\" };\n    } catch (error) {\n      return { kind: \"fatal\", reason: `stdin write failed: ${describe(error)}` };\n    }\n  })();\n\n  let outcome = await Promise.race([exited, pumped, outputFailed]);\n  if (outcome.kind === \"stdin-done\") {\n    // Stdin ended cleanly: pi-env exits on EOF, so wait for it.\n    outcome = await Promise.race([exited, outputFailed]);\n  }\n  try {\n    if (outcome.kind === \"fatal\") {\n      stderr.write(`bridge: ${outcome.reason}\\n`);\n      return 1;\n    }\n    if (outcome.kind === \"exit\") await flush(stdout);\n    return outcome.kind === \"exit\" ? outcome.exitCode : 1;\n  } finally {\n    await proc.close().catch(() => undefined);\n  }\n}\n{\n  \"name\": \"@pi-durable-k8s/sandbox-env\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"description\": \"pi-env bridge over the Agent Sandbox commands.start() stdio channel.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.19.0\"\n  },\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"bin\": {\n    \"pi-sandbox-bridge\": \"./dist/cli.js\"\n  },\n  \"scripts\": {\n    \"build\": \"rm -rf dist && tsc -p tsconfig.build.json\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@earendil-works/pi-durable\": \"1.5.2\",\n    \"@earendil-works/pi-env\": \"1.5.2\",\n    \"agentic-sandbox-client\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"@earendil-works/chord\": \"1.5.2\",\n    \"@types/node\": \"22.20.5\",\n    \"typescript\": \"7.0.2\",\n    \"vitest\": \"5.1.0\"\n  }\n}\n","isError":false}]}
