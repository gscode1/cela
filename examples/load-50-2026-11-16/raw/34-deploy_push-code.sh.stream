ENTRY 12284 {"id":12284,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\t#!/usr/bin/env bash\n     2\t# Bundle the orchestrator and copy it onto the orchestrator-code PVC, so the stock node image can run it and\n     3\t# a pod restart keeps the code. No image is built or pushed. The orchestrator Deployment (if present) is\n     4\t# scaled to 0 while the volume is written, because a ReadWriteOnce volume is mounted by one node at a time.\n     5\t# Usage: deploy/push-code.sh [deployment...]   (default: pi-orchestrator; scaled back to 1 afterwards)\n     6\tset -euo pipefail\n     7\t\n     8\tctx=${KUBE_CONTEXT:-}\n     9\tns=${NAMESPACE:-pi-durable-poc}\n    10\there=$(cd \"$(dirname \"$0\")\" && pwd)\n    11\troot=$(cd \"$here/..\" && pwd)\n    12\twork=$(mktemp -d)\n    13\tdeployments=(\"$@\")\n    14\t[[ ${#deployments[@]} -gt 0 ]] || deployments=(pi-orchestrator)\n    15\tk() { kubectl ${ctx:+--context=\"$ctx\"} -n \"$ns\" \"$@\"; }\n    16\tscaled=() # deployments this run scaled to 0; the trap restores exactly these\n    17\t# Runs on every exit path: a failed wait, cp or extract must not leave the orchestrator at 0 replicas.\n    18\tcleanup() {\n    19\t  local d\n    20\t  rm -rf \"$work\"\n    21\t  k delete pod orchestrator-code-loader --ignore-not-found --wait=false >/dev/null 2>&1 || true\n    22\t  for d in ${scaled[@]+\"${scaled[@]}\"}; do\n    23\t    k scale deployment \"$d\" --replicas=1 >/dev/null || echo \"could not scale $d back to 1; run: kubectl -n $ns scale deployment $d --replicas=1\" >&2\n    24\t  done\n    25\t}\n    26\ttrap cleanup EXIT\n    27\t\n    28\t(cd \"$root\" && pnpm install --frozen-lockfile >/dev/null && pnpm --filter \"@pi-durable-k8s/orchestrator...\" build >/dev/null)\n    29\t(cd \"$root\" && pnpm --filter @pi-durable-k8s/orchestrator deploy --prod \"$work/app\" >/dev/null)\n    30\tCOPYFILE_DISABLE=1 tar --no-xattrs -czf \"$work/app.tgz\" -C \"$work/app\" .\n    31\t\n    32\tk apply -f \"$here/orchestrator-code-pvc.yaml\" >/dev/null\n    33\tfor d in \"${deployments[@]}\"; do\n    34\t  if k get deployment \"$d\" >/dev/null 2>&1; then\n    35\t    scaled+=(\"$d\")\n    36\t    k scale deployment \"$d\" --replicas=0 >/dev/null\n    37\t  fi\n    38\tdone\n    39\tfor d in \"${deployments[@]}\"; do\n    40\t  k wait --for=delete pod -l \"app.kubernetes.io/instance=$d\" --timeout=120s >/dev/null 2>&1 || true\n    41\tdone\n    42\t\n    43\tk delete pod orchestrator-code-loader --ignore-not-found --wait=true >/dev/null\n    44\tk apply -f - >/dev/null <<EOF\n    45\tapiVersion: v1\n    46\tkind: Pod\n    47\tmetadata:\n    48\t  name: orchestrator-code-loader\n    49\tspec:\n    50\t  restartPolicy: Never\n    51\t  securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000, seccompProfile: { type: RuntimeDefault } }\n    52\t  containers:\n    53\t    - name: loader\n    54\t      image: node:22-bookworm-slim\n    55\t      command: [sleep, \"600\"]\n    56\t      securityContext: { allowPrivilegeEscalation: false, capabilities: { drop: [ALL] } }\n    57\t      resources:\n    58\t        requests: { cpu: 10m, memory: 32Mi }\n    59\t        limits: { cpu: 100m, memory: 128Mi }\n    60\t      volumeMounts: [{ name: code, mountPath: /code }]\n    61\t  volumes:\n    62\t    - name: code\n    63\t      persistentVolumeClaim: { claimName: orchestrator-code }\n    64\tEOF\n    65\tk wait --for=condition=Ready pod/orchestrator-code-loader --timeout=240s >/dev/null\n    66\tk cp \"$work/app.tgz\" orchestrator-code-loader:/tmp/app.tgz >/dev/null\n    67\t# Extract beside the live tree and swap only after the entry point exists, so a failed extract leaves the old\n    68\t# code in place. Same volume, so each mv is a rename.\n    69\tk exec orchestrator-code-loader -- sh -c 'set -e\n    70\trm -rf /code/app.new /code/app.old\n    71\tmkdir -p /code/app.new\n    72\ttar xzf /tmp/app.tgz -C /code/app.new\n    73\tls /code/app.new/dist/main.js >/dev/null\n    74\tif [ -e /code/app ]; then mv /code/app /code/app.old; fi\n    75\tmv /code/app.new /code/app\n    76\trm -rf /code/app.old'\n    77\tk delete pod orchestrator-code-loader --wait=true >/dev/null\n    78\t# The EXIT trap scales the deployments back to 1.\n    79\techo \"orchestrator code pushed to PVC orchestrator-code\"\n---\ncilium\nfetch-onecli-ca.sh\ngen-api-secret.sh\ngen-secret.sh\ningest.yaml\nkustomization.yaml\nmodel-config.yaml\nnamespace.yaml\nnetworkpolicy-e2e.yaml\nnetworkpolicy-ingest.yaml\nnetworkpolicy-orchestrator.yaml\nnetworkpolicy-postgres.yaml\nnetworkpolicy.yaml\nonecli-externalsecret.yaml\nonecli-host-rules.sh\nonecli-policies\norchestrator-code-pvc.yaml\norchestrator-rbac.yaml\norchestrator-service.yaml\norchestrator.yaml\npostgres.yaml\npush-code.sh\npush-ingest.sh\nrepo-externalsecrets.yaml\nsandbox-template.yaml\nsandbox-warmpool.yaml\n","isError":false}]}
