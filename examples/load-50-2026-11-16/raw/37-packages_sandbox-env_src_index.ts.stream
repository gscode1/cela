ENTRY 12023 {"id":12023,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import type { Readable, Writable } from \"node:stream\";\n\n/** A process started inside a sandbox. Implemented by sandbox-client.ts and by test fakes. */\nexport interface RemoteProcess {\n  /** Resolves when the bytes are delivered. A rejection leaves an unknown prefix delivered. */\n  write(data: Uint8Array): Promise<void>;\n  closeStdin(): Promise<void>;\n  wait(): Promise<{ exitCode: number }>;\n  /** Tears the stream down; sandboxd kills the process group. Idempotent. */\n  close(): Promise<void>;\n}\n\nexport interface OutputHandlers {\n  onStdout(chunk: Uint8Array): void;\n  onStderr(chunk: Uint8Array): void;\n}\n\nexport type StartProcess = (\n  command: string,\n  args: readonly string[],\n  handlers: OutputHandlers,\n) => Promise<RemoteProcess>;\n\n/** Written to the bridge's stderr once the remote process is running. */\nexport const BRIDGE_READY = \"bridge: ready\";\n\nexport interface BridgeOptions {\n  start: StartProcess;\n  command: string;\n  args: readonly string[];\n  stdin: Readable;\n  stdout: Writable;\n  stderr: Writable;\n}\n\ntype Outcome =\n  { kind: \"exit\"; exitCode: number } | { kind: \"stdin-done\" } | { kind: \"fatal\"; reason: string };\n\n/** Remote codes outside 1..255 (signal deaths, negatives) must still read as failure. */\nfunction toExitCode(exitCode: number): number {\n  if (exitCode === 0) return 0;\n  return Number.isInteger(exitCode) && exitCode > 0 && exitCode <= 255 ? exitCode : 1;\n}\n\nfunction describe(error: unknown): string {\n  return error instanceof Error ? error.message : String(error);\n}\n\nfunction flush(stream: Writable): Promise<void> {\n  return new Promise((resolve) => stream.write(new Uint8Array(0), () => resolve()));\n}\n\n/**\n * Pipes stdin to the remote process and its stdout to ours, byte for byte, and returns the exit code\n * the bridge should exit with. Stdin writes are awaited one at a time: the SDK sends each as its own\n * RPC, and concurrent RPCs could reorder bytes inside a pi-env frame. Any write failure or stream\n * loss is fatal because a half-delivered frame cannot be repaired; pi-env's Connection restarts us.\n */\nexport async function runBridge(options: BridgeOptions): Promise<number> {\n  const { stdin, stdout, stderr } = options;\n  let proc: RemoteProcess;\n  try {\n    proc = await options.start(options.command, options.args, {\n      onStdout: (chunk) => void stdout.write(chunk),\n      onStderr: (chunk) => void stderr.write(chunk),\n    });\n  } catch (error) {\n    stderr.write(`bridge: cannot start ${options.command}: ${describe(error)}\\n`);\n    return 1;\n  }\n  // Tells the parent that the cold start (the CPU-heavy part) is over; see StartGate.\n  stderr.write(`${BRIDGE_READY}\\n`);\n\n  const exited = proc.wait().then(\n    (result): Outcome => ({ kind: \"exit\", exitCode: toExitCode(result.exitCode) }),\n    (error: unknown): Outcome => ({\n      kind: \"fatal\",\n      reason: `remote stream lost: ${describe(error)}`,\n    }),\n  );\n  const outputFailed = new Promise<Outcome>((resolve) =>\n    stdout.once(\"error\", (error) =>\n      resolve({ kind: \"fatal\", reason: `stdout write failed: ${describe(error)}` }),\n    ),\n  );\n  const pumped = (async (): Promise<Outcome> => {\n    try {\n      for await (const chunk of stdin) {\n        await proc.write(chunk as Uint8Array);\n      }\n      await proc.closeStdin();\n      return { kind: \"stdin-done\" };\n    } catch (error) {\n      return { kind: \"fatal\", reason: `stdin write failed: ${describe(error)}` };\n    }\n  })();\n\n  let outcome = await Promise.race([exited, pumped, outputFailed]);\n  if (outcome.kind === \"stdin-done\") {\n    // Stdin ended cleanly: pi-env exits on EOF, so wait for it.\n    outcome = await Promise.race([exited, outputFailed]);\n  }\n  try {\n    if (outcome.kind === \"fatal\") {\n      stderr.write(`bridge: ${outcome.reason}\\n`);\n      return 1;\n    }\n    if (outcome.kind === \"exit\") await flush(stdout);\n    return outcome.kind === \"exit\" ? outcome.exitCode : 1;\n  } finally {\n    await proc.close().catch(() => undefined);\n  }\n}\n","isError":false}]}
ENTRY 12043 {"id":12043,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && grep -R -n 'connectSandboxEnv\\\\|bridgeCommand' --exclude-dir=.git . | head -100\"})","bash({\"command\":\"cd /workspace/repo && ls -a && grep -R -n 'class Connection\\\\|class RemoteExecutionEnv' packages | head -40 && cat packages/sandbox-env/package.json\"})","bash({\"command\":\"cd /workspace/repo && ls packages/sandbox-env/test* && cat packages/sandbox-env/src/config.ts\"})"]}]}
ENTRY 12063 {"id":12063,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"bridge.test.ts\nconfig.test.ts\nconformance.e2e.test.ts\nconformance.local.test.ts\nisolation.test.ts\nlocal-bridge.ts\nlocal-start.ts\nreattach.e2e.test.ts\nstart-gate.test.ts\nstdio-smoke.e2e.ts\ntoken.test.ts\nimport type { Connectivity, SandboxTarget } from \"./sandbox-client.js\";\n\n/**\n * Environment contract of the bridge. Flags (`--claim`, `--namespace`, `--connectivity`) take\n * precedence so one orchestrator process can run bridges for many claims; pi-env's Connection\n * inherits the parent environment and offers no per-connection env. The token is env-only, so it\n * never shows up in a process listing.\n */\nexport const ENV = {\n  claim: \"PI_SANDBOX_CLAIM\",\n  namespace: \"PI_SANDBOX_NAMESPACE\",\n  connectivity: \"PI_SANDBOX_CONNECTIVITY\",\n  authToken: \"PI_SANDBOX_AUTH_TOKEN\",\n  /** Master key per-sandbox tokens derive from (token.ts). Orchestrator and e2e driver only, never a bridge. */\n  masterKey: \"PI_SANDBOX_MASTER_KEY\",\n  envBinary: \"PI_SANDBOX_ENV_BINARY\",\n} as const;\n\nexport const DEFAULT_ENV_BINARY = \"/usr/local/bin/pi-env\";\n\nconst CONNECTIVITIES: readonly Connectivity[] = [\n  \"in-cluster-service\",\n  \"in-cluster-pod-ip\",\n  \"port-forward\",\n];\n\nexport interface BridgeConfig {\n  target: SandboxTarget;\n  command: string;\n  /** Everything after the bridge's own flags, i.e. `serve --token <hex>` from pi-env. */\n  args: readonly string[];\n}\n\nconst FLAGS = new Map([\n  [\"--claim\", \"claim\"],\n  [\"--namespace\", \"namespace\"],\n  [\"--connectivity\", \"connectivity\"],\n] as const);\n\nexport function parseBridgeArgs(\n  argv: readonly string[],\n  env: Readonly<Record<string, string | undefined>>,\n): BridgeConfig {\n  const flags: Partial<Record<\"claim\" | \"namespace\" | \"connectivity\", string>> = {};\n  let i = 0;\n  for (; i < argv.length; i++) {\n    const arg = argv[i];\n    const key = arg === undefined ? undefined : FLAGS.get(arg as \"--claim\");\n    if (key === undefined) break;\n    const value = argv[++i];\n    if (value === undefined) throw new Error(`${arg ?? \"flag\"} needs a value`);\n    flags[key] = value;\n  }\n  const args = argv.slice(i);\n  if (args[0] !== \"serve\") throw new Error(\"expected `serve --token <hex>` after the bridge flags\");\n\n  const claimName = flags.claim ?? env[ENV.claim];\n  if (!claimName) throw new Error(`sandbox claim missing: set ${ENV.claim} or pass --claim`);\n  const namespace = flags.namespace ?? env[ENV.namespace];\n  if (!namespace) throw new Error(`namespace missing: set ${ENV.namespace} or pass --namespace`);\n  const connectivity = flags.connectivity ?? env[ENV.connectivity] ?? \"in-cluster-service\";\n  if (!CONNECTIVITIES.includes(connectivity as Connectivity)) {\n    throw new Error(`connectivity must be one of ${CONNECTIVITIES.join(\", \")}`);\n  }\n  const authToken = env[ENV.authToken];\n  return {\n    target: {\n      claimName,\n      namespace,\n      connectivity: connectivity as Connectivity,\n      ...(authToken ? { authToken } : {}),\n    },\n    command: env[ENV.envBinary] || DEFAULT_ENV_BINARY,\n    args,\n  };\n}\n","isError":false}]}
ENTRY 12073 {"id":12073,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"17\\t * are live: a claim of an active session whose sandbox can never work again (a token from before ADR 0001) is an\\n    18\\t * operator decision, because removing it destroys the workspace of a session the user can still talk to.\\n    19\\t */\\n    20\\t\\n    21\\texport interface SweepClaim {\\n    22\\t  name: string;\\n    23\\t  sessionLabel: string | undefined;\\n    24\\t  createdAt: Date;\\n    25\\t}\\n    26\\t\\n    27\\texport interface SweepPvc {\\n    28\\t  name: string;\\n    29\\t  createdAt: Date;\\n    30\\t}\\n    31\\t\\n    32\\texport interface SweepAgent {\\n    33\\t  id: string;\\n    34\\t  identifier: string;\\n    35\\t  /** OneCLI does not always report it; an agent without it is judged by its session alone. */\\n    36\\t  createdAt?: Date;\\n    37\\t}\\n    38\\t\\n    39\\texport interface SweepSecret {\\n    40\\t  id: string;\\n    41\\t  name: string;\\n    42\\t}\\n    43\\t\\n    44\\texport interface SweepInput {\\n    45\\t  sessions: readonly SessionRef[];\\n    46\\t  claims: readonly SweepClaim[];\\n    47\\t  pvcs: readonly SweepPvc[];\\n    48\\t  /** Undefined when OneCLI is not configured: no agent is judged. */\\n    49\\t  agents: readonly SweepAgent[] | undefined;\\n    50\\t  secrets: readonly SweepSecret[];\\n    51\\t  now: number;\\n    52\\t  /** An object younger than this is never touched, so a session being created cannot race the sweep. */\\n    53\\t  graceMs: number;\\n    54\\t  /** Upper bound of actions in one run; the rest waits for the next run. */\\n    55\\t  maxActions: number;\\n    56\\t}\\n    57\\t\\n    58\\texport type SweepReason = \\\"session-deleted\\\" | \\\"session-unknown\\\";\\n    59\\t\\n    60\\texport type SweepAction =\\n    61\\t  /** Deletes the claim and its PVC (the session delete path, `deleteClaimAndPvc`). */\\n    62\\t  | { kind: \\\"delete-claim\\\"; claim: string; sessionLabel: string; reason: SweepReason }\\n    63\\t  /** A workspace PVC whose claim is gone and whose session is deleted or unknown. */\\n    64\\t  | { kind: \\\"delete-pvc\\\"; claim: string; reason: SweepReason }\\n    65\\t  /** Revokes a session's OneCLI agent and per-session secrets. Ids are not secret; tokens are never carried. */\\n    66\\t  | {\\n    67\\t      kind: \\\"revoke-agent\\\";\\n    68\\t      sessionId: string;\\n    69\\t      agentIds: string[];\\n    70\\t      secretIds: string[];\\n    71\\t      reason: SweepReason;\\n    72\\t    };\\n    73\\t\\n    74\\tconst CLAIM_NAME = /^pi-conv-(\\\\d+)$/;\\n    75\\tconst PVC_NAME = /^workspace-(pi-conv-(\\\\d+))$/;\\n    76\\tconst AGENT_IDENTIFIER = /^pi-session-([0-9a-f-]{36})$/;\\n    77\\tconst SECRET_NAME = /^pi-session-([0-9a-f-]{36})-(git|api)$/;\\n    78\\t\\n    79\\texport function planSweep(input: SweepInput): SweepAction[] {\\n    80\\t  const bySession = new Map(input.sessions.map((s) => [s.id, s]));\\n    81\\t  const byConversation = new Map(\\n    82\\t    input.sessions.flatMap((s) => (s.conversationId === null ? [] : [[s.conversationId, s]])),\\n    83\\t  );\\n    84\\t  const old = (createdAt: Date | undefined): boolean =>\\n    85\\t    createdAt === undefined || input.now - createdAt.getTime() >= input.graceMs;\\n    86\\t  /** The reason a session no longer owns anything, or undefined if it is live. */\\n    87\\t  const orphanReason = (session: SessionRef | undefined): SweepReason | undefined => {\\n    88\\t    if (session === undefined) return \\\"session-unknown\\\";\\n    89\\t    return session.status === \\\"deleted\\\" ? \\\"session-deleted\\\" : undefined;\\n    90\\t  };\\n    91\\t\\n    92\\t  const actions: SweepAction[] = [];\\n    93\\t\\n    94\\t  for (const claim of input.claims) {\\n    95\\t    if (!CLAIM_NAME.test(claim.name)) continue;\\n    96\\t    const label = claim.sessionLabel;\\n    97\\t    if (label === undefined || !UUID.test(label)) continue;\\n    98\\t    if (!old(claim.createdAt)) continue;\\n    99\\t    const reason = orphanReason(bySession.get(label));\\n   100\\t    if (reason !== undefined)\\n   101\\t      actions.push({ kind: \\\"delete-claim\\\", claim: claim.name, sessionLabel: label, reason });\\n   102\\t  }\\n   103\\t\\n   104\\t  // Any claim of that name, labelled or not, means the PVC is (or may soon be) in use: leave it.\\n   105\\t  const claimNames = new Set(input.claims.map((c) => c.name));\\n   106\\t  for (const pvc of input.pvcs) {\\n   107\\t    const match = PVC_NAME.exec(pvc.name);\\n   108\\t    if (match === null || !old(pvc.createdAt)) continue;\\n   109\\t    const [, claim, conversation] = match;\\n   110\\t    if (claim === undefined || conversation === undefined || claimNames.has(claim)) continue;\\n   111\\t    const reason = orphanReason(byConversation.get(Number(conversation)));\\n   112\\t    if (reason !== undefined) actions.push({ kind: \\\"delete-pvc\\\", claim, reason });\\n   113\\t  }\\n   114\\t\\n   115\\t  if (input.agents !== undefined) {\\n   116\\t    const found = new Map<string, { agentIds: string[]; secretIds: string[] }>();\\n   117\\t    const entry = (sessionId: string) => {\\n   118\\t      let e = found.get(sessionId);\\n   119\\t      if (e === undefined) {\\n   120\\t        e = { agentIds: [], secretIds: [] };\\n   121\\t        found.set(sessionId, e);\\n   122\\t      }\\n   123\\t      return e;\\n   124\\t    };\\n   125\\t    for (const agent of input.agents) {\\n   126\\t      const sessionId = AGENT_IDENTIFIER.exec(agent.identifier)?.[1];\\n   127\\t      if (sessionId === undefined || !old(agent.createdAt)) continue;\\n   128\\t      if (orphanReason(bySession.get(sessionId)) !== undefined)\\n   129\\t        entry(sessionId).agentIds.push(agent.id);\\n   130\\t    }\\n   131\\t    for (const secret of input.secrets) {\\n   132\\t      const sessionId = SECRET_NAME.exec(secret.name)?.[1];\\n   133\\t      if (sessionId === undefined) continue;\\n   134\\t      if (orphanReason(bySession.get(sessionId)) !== undefined)\\n   135\\t        entry(sessionId).secretIds.push(secret.id);\\n   136\\t    }\\n   137\\t    for (const [sessionId, ids] of found) {\\n   138\\t      const reason = orphanReason(bySession.get(sessionId));\\n   139\\t      if (reason !== undefined) actions.push({ kind: \\\"revoke-agent\\\", sessionId, ...ids, reason });\\n   140\\t    }\\n   141\\t  }\\n   142\\t\\n   143\\t  return actions.slice(0, Math.max(0, input.maxActions));\\n   144\\t}\\n==== packages/orchestrator/src/sweeper.ts\\n     1\\timport type { SessionRef } from \\\"@pi-durable-k8s/session-core\\\";\\n     2\\timport { errorMessage, log } from \\\"./log.js\\\";\\n     3\\timport { planSweep } from \\\"./sweep.js\\\";\\n     4\\timport type { SweepAction, SweepAgent, SweepClaim, SweepPvc, SweepSecret } from \\\"./sweep.js\\\";\\n     5\\t\\n     6\\texport interface SweeperDeps {\\n     7\\t  listSessions: () => Promise<SessionRef[]>;\\n     8\\t  listClaims: () => Promise<SweepClaim[]>;\\n     9\\t  listPvcs: () => Promise<SweepPvc[]>;\\n    10\\t  /** Undefined when OneCLI is not configured: the sweep then leaves agents alone. */\\n    11\\t  listOneCli: (() => Promise<{ agents: SweepAgent[]; secrets: SweepSecret[] }>) | undefined;\\n    12\\t  /** The session deletion's teardown: stops the bridge, deletes the claim, then the PVC. Also removes a lone PVC. */\\n    13\\t  destroyClaim: (claimName: string, sessionLabel: string) => Promise<void>;\\n    14\\t  revokeSession: (sessionId: string) => Promise<void>;\\n    15\\t  graceMs: number;\\n    16\\t  maxActions: number;\\n    17\\t  now?: () => number;\\n    18\\t}\\n    19\\t\\n    20\\t/**\\n    21\\t * The execution half of the orphan sweep: reads the world, asks `planSweep` what is orphaned, does it, logs each\\n    22\\t * action. One run at a time. A failing action is logged and the run goes on; the next run retries it. The log lines\\n    23\\t * carry names and ids only, never a token or secret value.\\n    24\\t */\\n    25\\texport class OrphanSweeper {\\n    26\\t  readonly #deps: SweeperDeps;\\n    27\\t  #running = false;\\n    28\\t  #timer: NodeJS.Timeout | undefined;\\n    29\\t\\n    30\\t  constructor(deps: SweeperDeps) {\\n    31\\t    this.#deps = deps;\\n    32\\t  }\\n    33\\t\\n    34\\t  start(intervalMs: number): void {\\n    35\\t    if (intervalMs <= 0) {\\n    36\\t      log(\\\"sweep-disabled\\\", {});\\n    37\\t      return;\\n    38\\t    }\\n    39\\t    this.#timer = setInterval(() => void this.run(), intervalMs);\\n    40\\t    this.#timer.unref();\\n    41\\t  }\\n    42\\t\\n    43\\t  stop(): void {\\n    44\\t    if (this.#timer !== undefined) clearInterval(this.#timer);\\n    45\\t  }\\n    46\\t\\n    47\\t  /** One sweep. Returns the actions that succeeded; never throws. */\\n    48\\t  async run(): Promise<SweepAction[]> {\\n    49\\t    if (this.#running) return [];\\n    50\\t    this.#running = true;\\n    51\\t    const done: SweepAction[] = [];\\n    52\\t    try {\\n    53\\t      const d = this.#deps;\\n    54\\t      const [sessions, claims, pvcs, oneCli] = await Promise.all([\\n    55\\t        d.listSessions(),\\n    56\\t        d.listClaims(),\\n    57\\t        d.listPvcs(),\\n    58\\t        d.listOneCli?.(),\\n    59\\t      ]);\\n    60\\t      const actions = planSweep({\\n    61\\t        sessions,\\n    62\\t        claims,\\n    63\\t        pvcs,\\n    64\\t        agents: oneCli?.agents,\\n    65\\t        secrets: oneCli?.secrets ?? [],\\n    66\\t        now: d.now?.() ?? Date.now(),\\n    67\\t        graceMs: d.graceMs,\\n    68\\t        maxActions: d.maxActions,\\n    69\\t      });\\n    70\\t      for (const action of actions) {\\n    71\\t        try {\\n    72\\t          await this.#apply(action);\\n    73\\t          log(\\\"sweep-action\\\", { ...action });\\n    74\\t          done.push(action);\\n    75\\t        } catch (error) {\\n    76\\t          log(\\\"sweep-action-failed\\\", { ...action, message: errorMessage(error) });\\n    77\\t        }\\n    78\\t      }\\n    79\\t      if (actions.length > 0) log(\\\"sweep-done\\\", { planned: actions.length, done: done.length });\\n    80\\t    } catch (error) {\\n    81\\t      log(\\\"sweep-failed\\\", { message: errorMessage(error) });\\n    82\\t    } finally {\\n    83\\t      this.#running = false;\\n    84\\t    }\\n    85\\t    return done;\\n    86\\t  }\\n    87\\t\\n    88\\t  async #apply(action: SweepAction): Promise<void> {\\n    89\\t    switch (action.kind) {\\n    90\\t      case \\\"delete-claim\\\":\\n    91\\t        return this.#deps.destroyClaim(action.claim, action.sessionLabel);\\n    92\\t      case \\\"delete-pvc\\\":\\n    93\\t        // The claim does not exist, so there is no label to check; deleteClaimAndPvc refuses if one appears meanwhile.\\n    94\\t        return this.#deps.destroyClaim(action.claim, \\\"orphan-pvc-sweep\\\");\\n    95\\t      case \\\"revoke-agent\\\":\\n    96\\t        return this.#deps.revokeSession(action.sessionId);\\n    97\\t    }\\n    98\\t  }\\n    99\\t}\\n==== packages/orchestrator/src/lifecycle.ts\\n     1\\t/**\\n     2\\t * Decision logic of the sandbox lifecycle that is not about talking to Kubernetes: what counts as an interrupted\\n     3\\t * command (docs/decisions/0003-recycle-pod-on-interrupt.md) and which sandboxes are due for suspension\\n     4\\t * (docs/decisions/0004-idle-suspend.md). Pure, so it is unit tested without a cluster.\\n     5\\t */\\n     6\\t\\n     7\\t/**\\n     8\\t * True when an `ExecutionEnv.exec` outcome says the command did not end on its own: Pi Durable aborted it (steer\\n     9\\t * or cancel) or its timeout hit. The daemon kills the command's process group, but a child that called `setsid`\\n    10\\t * is in no such group and keeps running, so the sandbox Pod must be replaced. A thrown error counts too: the\\n    11\\t * connection to the sandbox broke while the command ran, and what it started may still be there.\\n    12\\t */\\n    13\\texport function interruptedExec(\\n    14\\t  outcome: { threw: true } | { threw: false; result: unknown },\\n    15\\t): boolean {\\n    16\\t  if (outcome.threw) return true;\\n    17\\t  const result = outcome.result as { ok?: unknown; error?: { code?: unknown } } | undefined;\\n    18\\t  if (result?.ok !== false) return false;\\n    19\\t  return result.error?.code === \\\"aborted\\\" || result.error?.code === \\\"timeout\\\";\\n    20\\t}\\n    21\\t\\n    22\\tconst SANDBOX_NAME = /^pi-conv-(\\\\d+)$/;\\n    23\\t\\n    24\\t/** The conversation id of a `pi-conv-<n>` sandbox or claim name; undefined for any other name (e.g. `e2e-phase1`). */\\n    25\\texport function conversationOfName(name: string): number | undefined {\\n    26\\t  const match = SANDBOX_NAME.exec(name);\\n    27\\t  return match?.[1] === undefined ? undefined : Number(match[1]);\\n    28\\t}\\n    29\\t\\n    30\\texport interface SuspendInput {\\n    31\\t  /** Names of the Sandboxes whose mode is `Running`. */\\n    32\\t  running: readonly string[];\\n    33\\t  /** When each conversation's sandbox was last used by this process (a call started or ended). */\\n    34\\t  lastUsed: ReadonlyMap<number, number>;\\n    35\\t  /** Conversations with a call in flight or a recycle or suspend under way: never suspended. */\\n    36\\t  busy: ReadonlySet<number>;\\n    37\\t  now: number;\\n    38\\t  /** Idle time after which a sandbox is suspended. 0 or less turns suspension off. */\\n    39\\t  afterMs: number;\\n    40\\t}\\n    41\\t\\n    42\\texport interface SuspendPlan {\\n    43\\t  /** Running sandboxes this process has no record of (it restarted, or never used them): their idle clock starts now. */\\n    44\\t  seen: number[];\\n    45\\t  /** Sandboxes idle for at least `afterMs`. */\\n    46\\t  suspend: number[];\\n    47\\t}\\n    48\\t\\n    49\\t/**\\n    50\\t * Which sandboxes to suspend. Time is measured from the last use this process saw, and a sandbox it has never seen\\n    51\\t * starts its clock at first sight, so an orchestrator restart postpones suspension instead of suspending sessions that\\n    52\\t * are in use. Only `pi-conv-<n>` names are considered.\\n    53\\t */\\n    54\\texport function planSuspend(input: SuspendInput): SuspendPlan {\\n    55\\t  const plan: SuspendPlan = { seen: [], suspend: [] };\\n    56\\t  if (input.afterMs <= 0) return plan;\\n    57\\t  for (const name of input.running) {\\n    58\\t    const conversation = conversationOfName(name);\\n    59\\t    if (conversation === undefined || input.busy.has(conversation)) continue;\\n    60\\t    const last = input.lastUsed.get(conversation);\\n    61\\t    if (last === undefined) plan.seen.push(conversation);\\n    62\\t    else if (input.now - last >= input.afterMs) plan.suspend.push(conversation);\\n    63\\t  }\\n    64\\t  return plan;\\n    65\\t}\\n==== packages/orchestrator/src/sandboxes.ts\\n     1\\timport type { ExecutionEnv } from \\\"@earendil-works/pi-durable/env\\\";\\n     2\\timport {\\n     3\\t  ENV,\\n     4\\t  SANDBOXD_TOKEN_SHA256_ENV,\\n     5\\t  connectSandboxEnv,\\n     6\\t  deriveSandboxToken,\\n     7\\t  ensureClaim,\\n     8\\t  sandboxTokenSha256,\\n     9\\t} from \\\"@pi-durable-k8s/sandbox-env\\\";\\n    10\\timport type { SandboxEnv } from \\\"@pi-durable-k8s/sandbox-env\\\";\\n    11\\timport type { OrchestratorConfig } from \\\"./config.js\\\";\\n    12\\timport { fileURLToPath } from \\\"node:url\\\";\\n    13\\timport {\\n    14\\t  deleteClaimAndPvc,\\n    15\\t  ensureLabeledClaim,\\n    16\\t  listSandboxes,\\n    17\\t  recyclePod,\\n    18\\t  resumeIfSuspended,\\n    19\\t  suspendSandbox,\\n    20\\t} from \\\"./kube.js\\\";\\n    21\\timport { conversationOfName, interruptedExec, planSuspend } from \\\"./lifecycle.js\\\";\\n    22\\timport { errorMessage, log } from \\\"./log.js\\\";\\n    23\\t\\n    24\\texport const WORKSPACE = \\\"/workspace\\\";\\n    25\\t\\n    26\\t/** The value of the claim's session label for a conversation: the API session UUID. */\\n    27\\texport type SessionKeyOf = (conversationId: number) => Promise<string>;\\n    28\\t\\n    29\\t/** The bridge is started through this launcher so it does not inherit the orchestrator's secrets. */\\n    30\\tconst BRIDGE_LAUNCHER = fileURLToPath(new URL(\\\"./bridge-launcher.js\\\", import.meta.url));\\n    31\\t\\n    32\\t/** Per-session hooks for repo sessions (Phase 4c). Plain sessions ignore them: both answer \\\"nothing\\\". */\\n    33\\texport interface SandboxHooks {\\n    34\\t  /** Extra environment for this conversation's tool commands (pi-env `shellEnv`), set when its env is opened. */\\n    35\\t  shellEnv?: (conversationId: number) => Promise<Record<string, string> | undefined>;\\n    36\\t  /** Runs before every call on an open env; renews credentials that are about to expire. */\\n    37\\t  beforeUse?: (conversationId: number) => Promise<void>;\\n    38\\t  /**\\n    39\\t   * Durable record of \\\"a command may be running in this conversation's sandbox\\\". Set before a burst of commands\\n    40\\t   * starts and cleared once the sandbox is known clean. A process that dies mid-command never clears it, so the\\n    41\\t   * next one recycles that sandbox's Pod (see `Sandboxes.recycleAtStart`).\\n    42\\t   */\\n    43\\t  execInFlight?: (conversationId: number, inFlight: boolean) => Promise<void>;\\n    44\\t}\\n    45\\t\\n    46\\t/** Per open env: calls in flight, when one last ended, and whether the in-flight record is set. */\\n    47\\tinterface Usage {\\n    48\\t  inUse: number;\\n    49\\t  lastUsed: number;\\n    50\\t  recorded: boolean;\\n    51\\t}\\n    52\\t\\n    53\\t/** One conversation maps to one SandboxClaim, named from the conversation id (and so to one PVC). */\\n    54\\texport function claimNameFor(conversationId: number): string {\\n    55\\t  return `pi-conv-${String(conversationId)}`;\\n    56\\t}\\n    57\\t\\n    58\\t/**\\n    59\\t * One long-lived sandbox env per conversation. The env's Connection restarts its bridge by itself,\\n    60\\t * so a recreated sandbox Pod needs no handling here beyond the claim staying put.\\n    61\\t */\\n    62\\texport class Sandboxes {\\n    63\\t  readonly #config: OrchestratorConfig;\\n    64\\t  readonly #envs = new Map<number, Promise<SandboxEnv>>();\\n    65\\t\\n    66\\t  /** Per open env. Drives idle eviction. */\\n    67\\t  readonly #usage = new Map<number, Usage>();\\n    68\\t  readonly #timers: NodeJS.Timeout[] = [];\\n    69\\t\\n    70\\t  /**\\n    71\\t   * Last use of each conversation's sandbox as this process saw it. Unlike `#usage` it outlives an evicted env: it is\\n    72\\t   * what idle suspension measures. Entries go when the sandbox is suspended, recycled or deleted.\\n    73\\t   */\\n    74\\t  readonly #lastUsed = new Map<number, number>();\\n    75\\t  /** Conversations whose last command was interrupted, to be recycled once no call is in flight. */\\n    76\\t  readonly #interrupted = new Set<number>();\\n    77\\t  /** A recycle or suspend under way. Calls wait for it before opening the env, so none reaches a dying Pod. */\\n    78\\t  readonly #replacing = new Map<number, Promise<void>>();\\n    79\\t\\n    80\\t  readonly #sessionKeyOf: SessionKeyOf;\\n    81\\t  readonly #hooks: SandboxHooks;\\n    82\\t\\n    83\\t  constructor(config: OrchestratorConfig, sessionKeyOf: SessionKeyOf, hooks: SandboxHooks = {}) {\\n    84\\t    this.#config = config;\\n    85\\t    this.#sessionKeyOf = sessionKeyOf;\\n    86\\t    this.#hooks = hooks;\\n    87\\t    // Every open env is a Node bridge process (tens of MB). Without eviction a long-lived orchestrator grows\\n    88\\t    // with every session it ever ran a tool in (it was OOM-killed at 512Mi after about ten). An evicted env is\\n    89\\t    // simply opened again, adopting the same claim, by the next tool call.\\n    90\\t    this.#timers.push(setInterval(() => this.#evictIdle(config.sandbox.idleEvictMs), 15_000));\\n    91\\t    // Idle suspension (ADR 0004). It lists the Sandboxes, so it runs less often than eviction.\\n    92\\t    if (config.sandbox.idleSuspendMs > 0) {\\n    93\\t      this.#timers.push(setInterval(() => void this.#suspendIdle(), 30_000));\\n    94\\t    }\\n    95\\t    for (const timer of this.#timers) timer.unref();\\n    96\\t  }\\n    97\\t\\n    98\\t  /** Stops the timers. Bridges and sandboxes stay as they are. */\\n    99\\t  stop(): void {\\n   100\\t    for (const timer of this.#timers) clearInterval(timer);\\n   101\\t  }\\n   102\\t\\n   103\\t  #evictIdle(idleMs: number): void {\\n   104\\t    const now = Date.now();\\n   105\\t    for (const [conversationId, usage] of this.#usage) {\\n   106\\t      if (usage.inUse > 0 || now - usage.lastUsed < idleMs) continue;\\n   107\\t      const opened = this.#envs.get(conversationId);\\n   108\\t      this.#usage.delete(conversationId);\\n   109\\t      this.#envs.delete(conversationId);\\n   110\\t      void opened?.then((env) => {\\n   111\\t        env.close();\\n   112\\t        log(\\\"sandbox-env-evicted\\\", { claim: claimNameFor(conversationId) });\\n   113\\t      });\\n   114\\t    }\\n   115\\t  }\\n   116\\t\\n   117\\t  /**\\n   118\\t   * The env handed to Pi Durable. Pi Durable asks for it at every model request, before any tool runs, so\\n   119\\t   * building the real env there would create a SandboxClaim for a session that only chats. This stand-in\\n   120\\t   * does nothing until a method is first called (a tool call), then creates or adopts the claim and\\n   121\\t   * forwards to the real env. `id` and `cwd` are plain properties; every other member is an async method.\\n   122\\t   */\\n   123\\t  lazyEnv(conversationId: number): ExecutionEnv {\\n   124\\t    const target = { id: `pi-env:${claimNameFor(conversationId)}`, cwd: WORKSPACE };\\n   125\\t    return new Proxy(target, {\\n   126\\t      get: (object, property) => {\\n   127\\t        if (property === \\\"id\\\" || property === \\\"cwd\\\") return object[property];\\n   128\\t        if (typeof property === \\\"symbol\\\" || property === \\\"then\\\") return undefined;\\n   129\\t        return async (...args: unknown[]): Promise<unknown> => {\\n   130\\t          // Ending a run with no tool call must not open a sandbox just to clean it up.\\n   131\\t          if (property === \\\"cleanup\\\" && !this.#envs.has(conversationId)) return;\\n   132\\t          const usage = this.#usage.get(conversationId) ?? {\\n   133\\t            inUse: 0,\\n   134\\t            lastUsed: Date.now(),\\n   135\\t            recorded: false,\\n   136\\t          };\\n   137\\t          this.#usage.set(conversationId, usage);\\n   138\\t          usage.inUse++;\\n   139\\t          let outcome: { threw: true } | { threw: false; result: unknown } | undefined;\\n   140\\t          try {\\n   141\\t            // A recycle or suspend of this sandbox finishes first; the env opened below is then for the new Pod.\\n   142\\t            await this.#replacing.get(conversationId);\\n   143\\t            await this.#hooks.beforeUse?.(conversationId);\\n   144\\t            const real = (await this.ensure(conversationId)).env as unknown as Record<\\n   145\\t              string,\\n   146\\t              (...a: unknown[]) => unknown\\n   147\\t            >;\\n   148\\t            // Only commands can leave processes behind. Record that one may be running before it starts, so a\\n   149\\t            // crash in the middle is still known after the restart.\\n   150\\t            if (property === \\\"exec\\\" && !usage.recorded) {\\n   151\\t              await this.#hooks.execInFlight?.(conversationId, true);\\n   152\\t              usage.recorded = true;\\n   153\\t            }\\n   154\\t            try {\\n   155\\t              const result = await real[property]?.(...args);\\n   156\\t              outcome = { threw: false, result };\\n   157\\t              return result;\\n   158\\t            } catch (error) {\\n   159\\t              outcome = { threw: true };\\n   160\\t              throw error;\\n   161\\t            }\\n   162\\t          } finally {\\n   163\\t            usage.inUse--;\\n   164\\t            usage.lastUsed = Date.now();\\n   165\\t            this.#lastUsed.set(conversationId, usage.lastUsed);\\n   166\\t            if (property === \\\"exec\\\" && outcome !== undefined && interruptedExec(outcome)) {\\n   167\\t              this.#interrupted.add(conversationId);\\n   168\\t            }\\n   169\\t            if (usage.inUse === 0) this.#settle(conversationId, usage);\\n   170\\t          }\\n   171\\t        };\\n   172\\t      },\\n   173\\t      set: (object, property, value) => {\\n   174\\t        if (property === \\\"cwd\\\") object.cwd = String(value);\\n   175\\t        return property === \\\"cwd\\\";\\n   176\\t      },\\n   177\\t    }) as unknown as ExecutionEnv;\\n   178\\t  }\\n   179\\t\\n   180\\t  /**\\n   181\\t   * No call is in flight any more. An interrupted command means its sandbox may hold children that escaped the\\n   182\\t   * process-group kill: replace the Pod. Otherwise the commands ended on their own and the in-flight record goes.\\n   183\\t   */\\n   184\\t  #settle(conversationId: number, usage: Usage): void {\\n   185\\t    if (this.#interrupted.has(conversationId) && !this.#replacing.has(conversationId)) {\\n   186\\t      this.#interrupted.delete(conversationId);\\n   187\\t      this.#replace(conversationId, \\\"interrupted\\\", async () => {\\n   188\\t        await this.#closeEnv(conversationId);\\n   189\\t        await recyclePod(this.#config.namespace, claimNameFor(conversationId));\\n   190\\t        // Cleared only now: if the recycle fails or the process dies first, the record is still there.\\n   191\\t        await this.#hooks.execInFlight?.(conversationId, false);\\n   192\\t        usage.recorded = false;\\n   193\\t      });\\n   194\\t    } else if (usage.recorded) {\\n   195\\t      usage.recorded = false;\\n   196\\t      void this.#hooks.execInFlight?.(conversationId, false).catch((error: unknown) => {\\n   197\\t        usage.recorded = true; // still recorded: the next settle clears it\\n   198\\t        log(\\\"exec-record-failed\\\", {\\n   199\\t          claim: claimNameFor(conversationId),\\n   200\\t          message: errorMessage(error),\\n   201\\t        });\\n   202\\t      });\\n   203\\t    }\\n   204\\t  }\\n   205\\t\\n   206\\t  /**\\n   207\\t   * Runs a Pod replacement (recycle) or suspension for a conversation's sandbox. Calls made meanwhile wait for it.\\n   208\\t   * A failure is logged and leaves the conversation to try again: an interrupted one stays queued.\\n   209\\t   */\\n   210\\t  #replace(\\n   211\\t    conversationId: number,\\n   212\\t    why: \\\"interrupted\\\" | \\\"orchestrator-restart\\\" | \\\"idle\\\",\\n   213\\t    work: () => Promise<void>,\\n   214\\t  ): void {\\n   215\\t    if (this.#replacing.has(conversationId)) return;\\n   216\\t    const claim = claimNameFor(conversationId);\\n   217\\t    const run = (async () => {\\n   218\\t      await work();\\n   219\\t      this.#lastUsed.delete(conversationId);\\n   220\\t      log(why === \\\"idle\\\" ? \\\"sandbox-suspended\\\" : \\\"sandbox-recycled\\\", { claim, why });\\n   221\\t    })()\\n   222\\t      .catch((error: unknown) => {\\n   223\\t        if (why !== \\\"idle\\\") this.#interrupted.add(conversationId);\\n   224\\t        log(\\\"sandbox-replace-failed\\\", { claim, why, message: errorMessage(error) });\\n   225\\t      })\\n   226\\t      .finally(() => this.#replacing.delete(conversationId));\\n   227\\t    this.#replacing.set(conversationId, run);\\n   228\\t  }\\n   229\\t\\n   230\\t  /**\\n   231\\t   * After a start: the conversations that had a command in flight when the previous process stopped. Their Pods are\\n   232\\t   * replaced before Pi Durable resumes (the caller invokes this first), so the continuing run finds a clean sandbox.\\n   233\\t   * Nothing is known about which of them really has a leftover child, so every one is recycled.\\n   234\\t   */\\n   235\\t  recycleAtStart(conversationIds: readonly number[]): void {\\n   236\\t    for (const conversationId of conversationIds) {\\n   237\\t      this.#replace(conversationId, \\\"orchestrator-restart\\\", async () => {\\n   238\\t        await recyclePod(this.#config.namespace, claimNameFor(conversationId));\\n   239\\t        await this.#hooks.execInFlight?.(conversationId, false);\\n   240\\t      });\\n   241\\t    }\\n   242\\t  }\\n   243\\t\\n   244\\t  async #closeEnv(conversationId: number): Promise<void> {\\n   245\\t    const opened = this.#envs.get(conversationId);\\n   246\\t    if (this.#usage.get(conversationId)?.inUse === 0) this.#usage.delete(conversationId);\\n   247\\t    this.#envs.delete(conversationId);\\n   248\\t    if (opened !== undefined) (await opened.catch(() => undefined))?.close();\\n   249\\t  }\\n   250\\t\\n   251\\t  /** Suspends the sandboxes that have been idle for `idleSuspendMs`. Never throws: it runs on a timer. */\\n   252\\t  async #suspendIdle(): Promise<void> {\\n   253\\t    try {\\n   254\\t      const sandboxes = await listSandboxes(this.#config.namespace);\\n   255\\t      const now = Date.now();\\n   256\\t      const busy = new Set<number>(this.#replacing.keys());\\n   257\\t      for (const [conversationId, usage] of this.#usage)\\n   258\\t        if (usage.inUse > 0) busy.add(conversationId);\\n   259\\t      for (const sandbox of sandboxes) {\\n   260\\t        const conversationId = conversationOfName(sandbox.name);\\n   261\\t        if (conversationId !== undefined && sandbox.mode === \\\"Suspended\\\")\\n   262\\t          this.#lastUsed.delete(conversationId);\\n   263\\t      }\\n   264\\t      const plan = planSuspend({\\n   265\\t        running: sandboxes.filter((s) => s.mode === \\\"Running\\\").map((s) => s.name),\\n   266\\t        lastUsed: this.#lastUsed,\\n   267\\t        busy,\\n   268\\t        now,\\n   269\\t        afterMs: this.#config.sandbox.idleSuspendMs,\\n   270\\t      });\\n   271\\t      for (const conversationId of plan.seen) this.#lastUsed.set(conversationId, now);\\n   272\\t      for (const conversationId of plan.suspend) {\\n   273\\t        this.#replace(conversationId, \\\"idle\\\", async () => {\\n   274\\t          await this.#closeEnv(conversationId);\\n   275\\t          await suspendSandbox(this.#config.namespace, claimNameFor(conversationId));\\n   276\\t        });\\n   277\\t      }\\n   278\\t    } catch (error) {\\n   279\\t      log(\\\"suspend-scan-failed\\\", { message: errorMessage(error) });\\n   280\\t    }\\n   281\\t  }\\n   282\\t\\n   283\\t  /** Creates or adopts the claim and waits for its Sandbox; safe to call on every start. */\\n   284\\t  async ensure(conversationId: number): Promise<SandboxEnv> {\\n   285\\t    let env = this.#envs.get(conversationId);\\n   286\\t    if (env === undefined) {\\n   287\\t      env = this.#open(conversationId);\\n   288\\t      this.#envs.set(conversationId, env);\\n   289\\t      // A failed open must not be cached: the next tool call tries again.\\n   290\\t      env.catch(() => this.#envs.delete(conversationId));\\n   291\\t    }\\n   292\\t    return env;\\n   293\\t  }\\n   294\\t\\n   295\\t  async #open(conversationId: number): Promise<SandboxEnv> {\\n   296\\t    const claimName = claimNameFor(conversationId);\\n   297\\t    const { namespace, warmPool } = this.#config;\\n   298\\t    // Required: a sandbox with no token would be unauthenticated or unreachable. Only the hash goes into the claim.\\n   299\\t    const master = process.env[ENV.masterKey];\\n   300\\t    if (master === undefined || master === \\\"\\\") throw new Error(`${ENV.masterKey} is not set`);\\n   301\\t    const token = deriveSandboxToken(master, claimName);\\n   302\\t    try {\\n   303\\t      // Create the claim with the session label, or accept an existing one only if the label matches. The SDK\\n   304\\t      // then adopts it by name.\\n   305\\t      await ensureLabeledClaim(\\n   306\\t        namespace,\\n   307\\t        claimName,\\n   308\\t        warmPool,\\n   309\\t        await this.#sessionKeyOf(conversationId),\\n   310\\t        [{ name: SANDBOXD_TOKEN_SHA256_ENV, value: sandboxTokenSha256(token) }],\\n   311\\t      );\\n   312\\t      // A suspended sandbox is never Ready, so the wait below would only time out: resume it first.\\n   313\\t      if (await resumeIfSuspended(namespace, claimName))\\n   314\\t        log(\\\"sandbox-resumed\\\", { claim: claimName });\\n   315\\t      await ensureClaim({\\n   316\\t        claimName,\\n   317\\t        namespace,\\n   318\\t        warmPool,\\n   319\\t        connectivity: \\\"in-cluster-service\\\",\\n   320\\t        authToken: token,\\n   321\\t      });\\n   322\\t    } catch (error) {\\n   323\\t      log(\\\"claim-failed\\\", { claim: claimName, message: errorMessage(error) });\\n   324\\t      throw error;\\n   325\\t    }\\n   326\\t    log(\\\"claim-ready\\\", { claim: claimName });\\n   327\\t    // Credentials for a repo session's commands only; plain sessions get nothing here. The token travels through the\\n   328\\t    // pi-env protocol to the daemon, never through the bridge process environment (bridge-launcher derives its own claim's token and drops the master).\\n   329\\t    const shellEnv = await this.#hooks.shellEnv?.(conversationId);\\n   330\\t    return connectSandboxEnv({\\n   331\\t      claimName,\\n   332\\t      namespace,\\n   333\\t      cwd: WORKSPACE,\\n   334\\t      id: `pi-env:${claimName}`,\\n   335\\t      bridgeCommand: [process.execPath, BRIDGE_LAUNCHER],\\n   336\\t      ...(shellEnv === undefined ? {} : { shellEnv }),\\n   337\\t    });\\n   338\\t  }\\n   339\\t\\n   340\\t  /**\\n   341\\t   * Session deletion: stops the bridge, then deletes the SandboxClaim and the PVC. Idempotent, so a deletion cut\\n   342\\t   * off by a crash is simply run again. With `destroyOrphan` the only place that deletes a claim.\\n   343\\t   */\\n   344\\t  async destroy(conversationId: number): Promise<void> {\\n   345\\t    await this.#teardown(conversationId, await this.#sessionKeyOf(conversationId));\\n   346\\t  }\\n   347\\t\\n   348\\t  /**\\n   349\\t   * The orphan sweep's delete: the same teardown as a session deletion, for a claim whose session is deleted or\\n   350\\t   * unknown. `sessionLabel` is the label the sweep read from the claim, so `deleteClaimAndPvc` still refuses a\\n   351\\t   * claim that changed hands meanwhile.\\n   352\\t   */\\n   353\\t  async destroyOrphan(claimName: string, sessionLabel: string): Promise<void> {\\n   354\\t    const conversationId = conversationOfName(claimName);\\n   355\\t    if (conversationId === undefined) throw new Error(`${claimName} is not a conversation claim`);\\n   356\\t    await this.#teardown(conversationId, sessionLabel);\\n   357\\t  }\\n   358\\t\\n   359\\t  async #teardown(conversationId: number, sessionKey: string): Promise<void> {\\n   360\\t    await this.#replacing.get(conversationId);\\n   361\\t    this.#interrupted.delete(conversationId);\\n   362\\t    this.#lastUsed.delete(conversationId);\\n   363\\t    const opened = this.#envs.get(conversationId);\\n   364\\t    this.#usage.delete(conversationId);\\n   365\\t    this.#envs.delete(conversationId);\\n   366\\t    if (opened !== undefined) {\\n   367\\t      const env = await opened.catch(() => undefined);\\n   368\\t      env?.close();\\n   369\\t    }\\n   370\\t    const claimName = claimNameFor(conversationId);\\n   371\\t    await deleteClaimAndPvc(this.#config.namespace, claimName, sessionKey);\\n   372\\t    log(\\\"sandbox-deleted\\\", { claim: claimName });\\n   373\\t  }\\n   374\\t\\n   375\\t  /** Stops every bridge. Never deletes a claim. */\\n   376\\t  async closeAll(): Promise<void> {\\n   377\\t    this.stop();\\n   378\\t    const opened = await Promise.allSettled([...this.#envs.values()]);\\n   379\\t    for (const result of opened) if (result.status === \\\"fulfilled\\\") result.value.close();\\n   380\\t    this.#envs.clear();\\n   381\\t  }\\n   382\\t}\\n==== packages/orchestrator/src/kube.ts\\n     1\\timport {\\n     2\\t  CoreV1Api,\\n     3\\t  CustomObjectsApi,\\n     4\\t  KubeConfig,\\n     5\\t  PatchStrategy,\\n     6\\t  setHeaderOptions,\\n     7\\t} from \\\"@kubernetes/client-node\\\";\\n     8\\t\\n     9\\t/** HTTP status of a Kubernetes client error, whichever shape this client version uses. */\\n    10\\tfunction statusOf(error: unknown): number | undefined {\\n    11\\t  if (typeof error !== \\\"object\\\" || error === null) return undefined;\\n    12\\t  const e = error as { code?: unknown; statusCode?: unknown };\\n    13\\t  const status = e.code ?? e.statusCode;\\n    14\\t  return typeof status === \\\"number\\\" ? status : undefined;\\n    15\\t}\\n    16\\t\\n    17\\tasync function ignoreNotFound(call: Promise<unknown>): Promise<boolean> {\\n    18\\t  try {\\n    19\\t    await call;\\n    20\\t    return true;\\n    21\\t  } catch (error) {\\n    22\\t    if (statusOf(error) === 404) return false;\\n    23\\t    throw error;\\n    24\\t  }\\n    25\\t}\\n    26\\t\\n    27\\t/** Label that ties a SandboxClaim to the API session (or `control-<id>` for the test-only control sessions). */\\n    28\\texport const SESSION_LABEL = \\\"pi-durable-k8s/session-id\\\";\\n    29\\t\\n    30\\tconst CLAIM_REF = {\\n    31\\t  group: \\\"extensions.agents.x-k8s.io\\\",\\n    32\\t  version: \\\"v1beta1\\\",\\n    33\\t  plural: \\\"sandboxclaims\\\",\\n    34\\t};\\n    35\\t\\n    36\\t/** A `spec.env` entry of a SandboxClaim. */\\n    37\\texport interface ClaimEnvVar {\\n    38\\t  name: string;\\n    39\\t  value: string;\\n    40\\t}\\n    41\\t\\n    42\\tfunction envValueOf(claim: unknown, name: string): string | undefined {\\n    43\\t  const env = (claim as { spec?: { env?: ClaimEnvVar[] } }).spec?.env;\\n    44\\t  return env?.find((entry) => entry.name === name)?.value;\\n    45\\t}\\n    46\\t\\n    47\\tfunction labelOf(claim: unknown): string | undefined {\\n    48\\t  const labels = (claim as { metadata?: { labels?: Record<string, string> } }).metadata?.labels;\\n    49\\t  return labels?.[SESSION_LABEL];\\n    50\\t}\\n    51\\t\\n    52\\t/**\\n    53\\t * Makes sure the named claim exists and belongs to this session. A missing claim is created with the session\\n    54\\t * label; an existing one is accepted only if its label matches: a claim with the right name but another (or no)\\n    55\\t * label is never adopted, so a name collision cannot hand one session another's sandbox and PVC. The SDK then\\n    56\\t * adopts the claim by name and waits for its Sandbox (it never sees an unlabelled foreign claim).\\n    57\\t *\\n    58\\t * `env` is the claim's `spec.env` (the per-sandbox token hash). The template's envVarsInjectionPolicy must allow\\n    59\\t * it. The env is baked into the Pod at creation, so an existing claim is accepted only if it carries the same\\n    60\\t * value: one created before per-sandbox tokens (or under another master) would otherwise fail every call with a\\n    61\\t * bare 401, and a name collision with a hash from another master must not be adopted.\\n    62\\t */\\n    63\\texport async function ensureLabeledClaim(\\n    64\\t  namespace: string,\\n    65\\t  claimName: string,\\n    66\\t  warmPool: string,\\n    67\\t  sessionKey: string,\\n    68\\t  env: readonly ClaimEnvVar[],\\n    69\\t): Promise<void> {\\n    70\\t  const kc = new KubeConfig();\\n    71\\t  kc.loadFromDefault();\\n    72\\t  const custom = kc.makeApiClient(CustomObjectsApi);\\n    73\\t  const ref = { ...CLAIM_REF, namespace, name: claimName };\\n    74\\t  let existing: unknown;\\n    75\\t  try {\\n    76\\t    existing = await custom.getNamespacedCustomObject(ref);\\n    77\\t  } catch (error) {\\n    78\\t    if (statusOf(error) !== 404) throw error;\\n    79\\t  }\\n    80\\t  if (existing !== undefined) {\\n    81\\t    if (labelOf(existing) !== sessionKey) {\\n    82\\t      throw new Error(`SandboxClaim ${claimName} exists but is not labelled for this session`);\\n    83\\t    }\\n    84\\t    for (const { name, value } of env) {\\n    85\\t      if (envValueOf(existing, name) !== value) {\\n    86\\t        throw new Error(\\n    87\\t          `SandboxClaim ${claimName} has no matching ${name}: it predates per-sandbox tokens or the master key changed; ` +\\n    88\\t            `delete the claim and its PVC to recreate it (docs/decisions/0001-per-sandbox-sandboxd-token.md)`,\\n    89\\t        );\\n    90\\t      }\\n    91\\t    }\\n    92\\t    return;\\n    93\\t  }\\n    94\\t  try {\\n    95\\t    await custom.createNamespacedCustomObject({\\n    96\\t      group: ref.group,\\n    97\\t      version: ref.version,\\n    98\\t      namespace,\\n    99\\t      plural: ref.plural,\\n   100\\t      body: {\\n   101\\t        apiVersion: `${ref.group}/${ref.version}`,\\n   102\\t        kind: \\\"SandboxClaim\\\",\\n   103\\t        metadata: { name: claimName, namespace, labels: { [SESSION_LABEL]: sessionKey } },\\n   104\\t        spec: { warmPoolRef: { name: warmPool }, env },\\n   105\\t      },\\n   106\\t    });\\n   107\\t  } catch (error) {\\n   108\\t    // Lost a race with another creator: fall back to the label check.\\n   109\\t    if (statusOf(error) !== 409) throw error;\\n   110\\t    await ensureLabeledClaim(namespace, claimName, warmPool, sessionKey, env);\\n   111\\t  }\\n   112\\t}\\n   113\\t\\n   114\\tconst sleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));\\n   115\\t\\n   116\\t/**\\n   117\\t * Deletes a session's SandboxClaim, then its workspace PVC, and waits until both are gone. The claim goes\\n   118\\t * first: its Sandbox owns the Pod, and a PVC that a Pod still mounts only finishes deleting after the Pod.\\n   119\\t * Both calls ignore \\\"not found\\\", so this is safe to repeat. Needs `delete` on sandboxclaims and\\n   120\\t * persistentvolumeclaims in the namespace (and the `get` on claims the orchestrator has anyway).\\n   121\\t */\\n   122\\texport async function deleteClaimAndPvc(\\n   123\\t  namespace: string,\\n   124\\t  claimName: string,\\n   125\\t  sessionKey: string,\\n   126\\t  timeoutMs = 180_000,\\n   127\\t): Promise<void> {\\n   128\\t  const kc = new KubeConfig();\\n   129\\t  kc.loadFromDefault();\\n   130\\t  const custom = kc.makeApiClient(CustomObjectsApi);\\n   131\\t  const core = kc.makeApiClient(CoreV1Api);\\n   132\\t  const claim = {\\n   133\\t    group: \\\"extensions.agents.x-k8s.io\\\",\\n   134\\t    version: \\\"v1beta1\\\",\\n   135\\t    namespace,\\n   136\\t    plural: \\\"sandboxclaims\\\",\\n   137\\t    name: claimName,\\n   138\\t  };\\n   139\\t  // The Sandbox controller names the PVC after the volume claim template and the Sandbox (`workspace-<claim>`).\\n   140\\t  const pvc = { name: `workspace-${claimName}`, namespace };\\n   141\\t\\n   142\\t  // Never delete a claim that is not this session's (`get` is already granted for the SDK).\\n   143\\t  try {\\n   144\\t    const found: unknown = await custom.getNamespacedCustomObject(claim);\\n   145\\t    if (labelOf(found) !== sessionKey) {\\n   146\\t      throw new Error(\\n   147\\t        `SandboxClaim ${claimName} is not labelled for this session: not deleting it`,\\n   148\\t      );\\n   149\\t    }\\n   150\\t  } catch (error) {\\n   151\\t    if (statusOf(error) !== 404) throw error;\\n   152\\t  }\\n   153\\t  // Only `delete` is needed: a delete that answers 404 means the object is gone. The PVC is deleted only once\\n   154\\t  // the claim is gone, so the Sandbox controller cannot recreate it from a Sandbox that still exists.\\n   155\\t  const deadline = Date.now() + timeoutMs;\\n   156\\t  for (;;) {\\n   157\\t    const claimPresent = await ignoreNotFound(custom.deleteNamespacedCustomObject(claim));\\n   158\\t    const pvcPresent = claimPresent\\n   159\\t      ? true\\n   160\\t      : await ignoreNotFound(core.deleteNamespacedPersistentVolumeClaim(pvc));\\n   161\\t    if (!claimPresent && !pvcPresent) return;\\n   162\\t    if (Date.now() > deadline) {\\n   163\\t      throw new Error(\\n   164\\t        `timed out deleting ${claimName}: claim ${claimPresent ? \\\"present\\\" : \\\"gone\\\"}, pvc ${pvcPresent ? \\\"present\\\" : \\\"gone\\\"}`,\\n   165\\t      );\\n   166\\t    }\\n   167\\t    await sleep(2_000);\\n   168\\t  }\\n   169\\t}\\n   170\\t\\n   171\\tfunction clients(): { custom: CustomObjectsApi; core: CoreV1Api } {\\n   172\\t  const kc = new KubeConfig();\\n   173\\t  kc.loadFromDefault();\\n   174\\t  return { custom: kc.makeApiClient(CustomObjectsApi), core: kc.makeApiClient(CoreV1Api) };\\n   175\\t}\\n   176\\t\\n   177\\tconst SANDBOX_REF = { group: \\\"agents.x-k8s.io\\\", version: \\\"v1beta1\\\", plural: \\\"sandboxes\\\" };\\n   178\\t\\n   179\\t/** A SandboxClaim as the orphan sweep sees it. `sessionLabel` is undefined for a claim we never labelled. */\\n   180\\texport interface ClaimInfo {\\n   181\\t  name: string;\\n   182\\t  sessionLabel: string | undefined;\\n   183\\t  createdAt: Date;\\n   184\\t}\\n   185\\t\\n   186\\t/** Every SandboxClaim in the namespace, labelled or not: the sweep must know a claim exists to leave its PVC alone. */\\n   187\\texport async function listClaims(namespace: string): Promise<ClaimInfo[]> {\\n   188\\t  const { custom } = clients();\\n   189\\t  const list = (await custom.listNamespacedCustomObject({ ...CLAIM_REF, namespace })) as {\\n   190\\t    items?: { metadata?: { name?: string; creationTimestamp?: string } }[];\\n   191\\t  };\\n   192\\t  return (list.items ?? []).flatMap((item) => {\\n   193\\t    const name = item.metadata?.name;\\n   194\\t    const created = item.metadata?.creationTimestamp;\\n   195\\t    if (name === undefined || created === undefined) return [];\\n   196\\t    return [{ name, sessionLabel: labelOf(item), createdAt: new Date(created) }];\\n   197\\t  });\\n   198\\t}\\n   199\\t\\n   200\\texport interface PvcInfo {\\n   201\\t  name: string;\\n   202\\t  createdAt: Date;\\n   203\\t}\\n   204\\t\\n   205\\texport async function listPvcs(namespace: string): Promise<PvcInfo[]> {\\n   206\\t  const { core } = clients();\\n   207\\t  const list = await core.listNamespacedPersistentVolumeClaim({ namespace });\\n   208\\t  return list.items.flatMap((item) => {\\n   209\\t    const name = item.metadata?.name;\\n   210\\t    const created = item.metadata?.creationTimestamp;\\n   211\\t    return name === undefined || created === undefined\\n   212\\t      ? []\\n   213\\t      : [{ name, createdAt: new Date(created) }];\\n   214\\t  });\\n   215\\t}\\n   216\\t\\n   217\\t/** `Suspended` keeps the PVC and the Sandbox object and deletes the Pod (agent-sandbox v1.0.11, controllers/sandbox_controller.go). */\\n   218\\texport type OperatingMode = \\\"Running\\\" | \\\"Suspended\\\";\\n   219\\t\\n   220\\texport interface SandboxInfo {\\n   221\\t  name: string;\\n   222\\t  mode: OperatingMode;\\n   223\\t  /** The controller's `Suspended=True` condition: the Pod is really gone, not just asked to go. */\\n   224\\t  podTerminated: boolean;\\n   225\\t}\\n   226\\t\\n   227\\texport async function listSandboxes(namespace: string): Promise<SandboxInfo[]> {\\n   228\\t  const { custom } = clients();\\n   229\\t  const list = (await custom.listNamespacedCustomObject({ ...SANDBOX_REF, namespace })) as {\\n   230\\t    items?: {\\n   231\\t      metadata?: { name?: string };\\n   232\\t      spec?: { operatingMode?: string };\\n   233\\t      status?: { conditions?: { type?: string; status?: string }[] };\\n   234\\t    }[];\\n   235\\t  };\\n   236\\t  return (list.items ?? []).flatMap((item) => {\\n   237\\t    const name = item.metadata?.name;\\n   238\\t    if (name === undefined) return [];\\n   239\\t    const suspended = item.status?.conditions?.find((c) => c.type === \\\"Suspended\\\");\\n   240\\t    return [\\n   241\\t      {\\n   242\\t        name,\\n   243\\t        mode: item.spec?.operatingMode === \\\"Suspended\\\" ? \\\"Suspended\\\" : \\\"Running\\\",\\n   244\\t        podTerminated: suspended?.status === \\\"True\\\",\\n   245\\t      },\\n   246\\t    ];\\n   247\\t  });\\n   248\\t}\\n   249\\t\\n   250\\t/**\\n   251\\t * Sets `spec.operatingMode` of the Sandbox that a claim created (same name). The claim controller only syncs the\\n   252\\t * Sandbox's pod metadata and labels, never the mode, so the patch sticks (verified live on c2 and in the controller\\n   253\\t * source). False if the Sandbox does not exist.\\n   254\\t */\\n   255\\texport async function setOperatingMode(\\n   256\\t  namespace: string,\\n   257\\t  sandboxName: string,\\n   258\\t  mode: OperatingMode,\\n   259\\t): Promise<boolean> {\\n   260\\t  const { custom } = clients();\\n   261\\t  try {\\n   262\\t    await custom.patchNamespacedCustomObject(\\n   263\\t      { ...SANDBOX_REF, namespace, name: sandboxName, body: { spec: { operatingMode: mode } } },\\n   264\\t      setHeaderOptions(\\\"Content-Type\\\", PatchStrategy.MergePatch),\\n   265\\t    );\\n   266\\t    return true;\\n   267\\t  } catch (error) {\\n   268\\t    if (statusOf(error) === 404) return false;\\n   269\\t    throw error;\\n   270\\t  }\\n   271\\t}\\n   272\\t\\n   273\\t/**\\n   274\\t * Suspends a sandbox and waits until the controller reports its Pod gone (`Suspended=True`). Waiting matters: a\\n   275\\t * resume that lands while the Pod is still terminating would see a Ready Sandbox and connect to a dying Pod.\\n   276\\t */\\n   277\\texport async function suspendSandbox(\\n   278\\t  namespace: string,\\n   279\\t  sandboxName: string,\\n   280\\t  timeoutMs = 120_000,\\n   281\\t): Promise<boolean> {\\n   282\\t  if (!(await setOperatingMode(namespace, sandboxName, \\\"Suspended\\\"))) return false;\\n   283\\t  const deadline = Date.now() + timeoutMs;\\n   284\\t  for (;;) {\\n   285\\t    const found = (await listSandboxes(namespace)).find((s) => s.name === sandboxName);\\n   286\\t    if (found === undefined || found.podTerminated) return true;\\n   287\\t    if (Date.now() > deadline) throw new Error(`timed out waiting for ${sandboxName} to suspend`);\\n   288\\t    await sleep(1_000);\\n   289\\t  }\\n   290\\t}\\n   291\\t\\n   292\\t/**\\n   293\\t * Resumes a suspended sandbox before the SDK waits for it to be Ready (a Suspended Sandbox is never Ready, so the\\n   294\\t * wait would run into its timeout). True if it was suspended.\\n   295\\t */\\n   296\\texport async function resumeIfSuspended(namespace: string, sandboxName: string): Promise<boolean> {\\n   297\\t  const sandbox = (await listSandboxes(namespace)).find((s) => s.name === sandboxName);\\n   298\\t  if (sandbox?.mode !== \\\"Suspended\\\") return false;\\n   299\\t  await setOperatingMode(namespace, sandboxName, \\\"Running\\\");\\n   300\\t  return true;\\n   301\\t}\\n   302\\t\\n   303\\t/**\\n   304\\t * Deletes the sandbox Pod (never the claim or the PVC) so the Sandbox controller creates a clean one on the same\\n   305\\t * PVC, and waits until the replacement is Ready. Needed after an interrupted command: `setsid` children escape\\n   306\\t * pi-env's process-group kill and only a Pod replacement reaps them. The delete is bound to the Pod's uid, so it\\n   307\\t * cannot hit a replacement that already exists. Returns false when there was no Pod.\\n   308\\t */\\n   309\\texport async function recyclePod(\\n   310\\t  namespace: string,\\n   311\\t  podName: string,\\n   312\\t  timeoutMs = 120_000,\\n   313\\t): Promise<boolean> {\\n   314\\t  const { core } = clients();\\n   315\\t  let uid: string | undefined;\\n   316\\t  try {\\n   317\\t    uid = (await core.readNamespacedPod({ name: podName, namespace })).metadata?.uid;\\n   318\\t  } catch (error) {\\n   319\\t    if (statusOf(error) === 404) return false;\\n   320\\t    throw error;\\n   321\\t  }\\n   322\\t  if (uid === undefined) return false;\\n   323\\t  await ignoreNotFound(\\n   324\\t    core.deleteNamespacedPod({\\n   325\\t      name: podName,\\n   326\\t      namespace,\\n   327\\t      // Short grace: what runs inside is what we are getting rid of. The PVC is a network volume, so a 10 s kill\\n   328\\t      // costs no more than a node failure would.\\n   329\\t      gracePeriodSeconds: 10,\\n   330\\t      body: { preconditions: { uid } },\\n   331\\t    }),\\n   332\\t  );\\n   333\\t  const deadline = Date.now() + timeoutMs;\\n   334\\t  for (;;) {\\n   335\\t    try {\\n   336\\t      const current = await core.readNamespacedPod({ name: podName, namespace });\\n   337\\t      // The replacement has the same name, so the uid tells old from new. Wait for it to be Ready: the SDK's own\\n   338\\t      // wait reads the Sandbox status, which can still say Ready for an instant after the Pod changed.\\n   339\\t      const ready = current.status?.conditions?.some(\\n   340\\t        (c) => c.type === \\\"Ready\\\" && c.status === \\\"True\\\",\\n   341\\t      );\\n   342\\t      if (current.metadata?.uid !== uid && ready === true) return true;\\n   343\\t    } catch (error) {\\n   344\\t      if (statusOf(error) !== 404) throw error;\\n   345\\t    }\\n   346\\t    if (Date.now() > deadline)\\n   347\\t      throw new Error(`timed out waiting for Pod ${podName} to be replaced`);\\n   348\\t    await sleep(1_000);\\n   349\\t  }\\n   350\\t}\\n\",\"isError\":false}]}\n<harness>\n[info] Full output: /tmp/tmp-oEmIDj/pi-output-3f9f901c-a890-4035-b4df-cc8e42a5fe86.log\n[warn] Output truncated to its end: 25 lines, 37509 bytes dropped\n</harness>","isError":false}]}
ENTRY 12074 {"id":12074,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":".\n..\n.git\n.gitignore\n.prettierignore\n.prettierrc.json\nAGENT.md\nCLAUDE.md\nLICENSE\nREADME.md\ndeploy\ndocs\neslint.config.js\nexamples\nimages\npackage.json\npackages\nplan.md\npnpm-lock.yaml\npnpm-workspace.yaml\ntests\nvendor\n{\n  \"name\": \"@pi-durable-k8s/sandbox-env\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"description\": \"pi-env bridge over the Agent Sandbox commands.start() stdio channel.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.19.0\"\n  },\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"bin\": {\n    \"pi-sandbox-bridge\": \"./dist/cli.js\"\n  },\n  \"scripts\": {\n    \"build\": \"rm -rf dist && tsc -p tsconfig.build.json\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@earendil-works/pi-durable\": \"1.5.2\",\n    \"@earendil-works/pi-env\": \"1.5.2\",\n    \"agentic-sandbox-client\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"@earendil-works/chord\": \"1.5.2\",\n    \"@types/node\": \"22.20.5\",\n    \"typescript\": \"7.0.2\",\n    \"vitest\": \"5.1.0\"\n  }\n}\n","isError":false}]}
