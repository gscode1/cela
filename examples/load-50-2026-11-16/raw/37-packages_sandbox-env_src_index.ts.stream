ENTRY 12139 {"id":12139,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/sandbox-env/src/index.ts:25:  bridgeCommand?: readonly string[];\npackages/sandbox-env/src/index.ts:46:export function connectSandboxEnv(options: SandboxEnvOptions): SandboxEnv {\npackages/sandbox-env/src/index.ts:47:  const bridge = options.bridgeCommand ?? [\npackages/sandbox-env/test/conformance.e2e.test.ts:10:import { connectSandboxEnv } from \"../src/index.ts\";\npackages/sandbox-env/test/conformance.e2e.test.ts:15:  const sandbox = connectSandboxEnv({\npackages/sandbox-env/test/conformance.e2e.test.ts:20:    bridgeCommand: [process.execPath, resolve(import.meta.dirname, \"../dist/cli.js\")],\npackages/sandbox-env/test/reattach.e2e.test.ts:11:import { connectSandboxEnv } from \"../src/index.ts\";\npackages/sandbox-env/test/reattach.e2e.test.ts:20:  const sandbox = connectSandboxEnv({\npackages/sandbox-env/test/reattach.e2e.test.ts:25:    bridgeCommand: [process.execPath, resolve(import.meta.dirname, \"../dist/cli.js\")],\n// Test-only bridge executable: the real runBridge, but \"the sandbox\" is a local pi-env daemon.\n// Run by pi-env's Connection as `node local-bridge.ts serve --token <hex>`.\nimport { localDaemon } from \"@earendil-works/pi-env\";\nimport { runBridge } from \"../src/bridge.ts\";\nimport { localStart } from \"./local-start.ts\";\n\nconst code = await runBridge({\n  start: localStart(),\n  command: localDaemon(),\n  args: process.argv.slice(2),\n  stdin: process.stdin,\n  stdout: process.stdout,\n  stderr: process.stderr,\n});\nprocess.exit(code);\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join, resolve } from \"node:path\";\nimport { Connection, RemoteExecutionEnv, localDaemon } from \"@earendil-works/pi-env\";\nimport { registerEnvConformance } from \"@earendil-works/pi-durable/testing\";\nimport { afterAll, describe, expect, it } from \"vitest\";\n\n// Baseline: pi-env's own darwin/linux daemon, straight and through our bridge (with a local\n// process standing in for sandboxd). A failure in the second but not the first points at the bridge.\nconst variants: [string, readonly string[]][] = [\n  [\"local pi-env daemon\", [localDaemon()]],\n  [\n    \"local pi-env daemon through the bridge\",\n    [process.execPath, resolve(import.meta.dirname, \"local-bridge.ts\")],\n  ],\n];\n\nfor (const [name, command] of variants) {\n  const connection = new Connection({ command });\n  afterAll(() => connection.close());\n  registerEnvConformance(\n    { describe, expect, it },\n    name,\n    async (use) => {\n      const cwd = mkdtempSync(join(tmpdir(), \"sandbox-env-local-\"));\n      try {\n        await use(\n          new RemoteExecutionEnv({\n            connection,\n            id: \"pi-env:local\",\n            cwd,\n            watch: { pollIntervalMs: 100 },\n          }),\n        );\n      } finally {\n        rmSync(cwd, { recursive: true, force: true, maxRetries: 20, retryDelay: 100 });\n      }\n    },\n    { listFiles: true },\n  );\n}\nREADME.md\nnetzlabor-pi-durable-postgres-0.2.0.tgz\n","isError":false}]}
