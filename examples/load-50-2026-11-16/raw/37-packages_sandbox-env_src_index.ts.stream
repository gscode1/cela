ENTRY 12111 {"id":12111,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { describe, expect, it } from \"vitest\";\nimport { BRIDGE_READY } from \"../src/bridge.ts\";\nimport { StartGate, gatedStart } from \"../src/start-gate.ts\";\n\nconst tick = () => new Promise((resolve) => setTimeout(resolve, 10));\n\ndescribe(\"StartGate\", () => {\n  it(\"lets one holder through at a time, in order\", async () => {\n    const gate = new StartGate(5_000);\n    const order: string[] = [];\n    const first = await gate.acquire();\n    const second = gate.acquire().then((release) => {\n      order.push(\"second\");\n      return release;\n    });\n    const third = gate.acquire().then((release) => {\n      order.push(\"third\");\n      return release;\n    });\n    await tick();\n    expect(order).toEqual([]);\n    first();\n    (await second)();\n    (await third)();\n    expect(order).toEqual([\"second\", \"third\"]);\n  });\n\n  it(\"frees the turn on its own if the holder never reports ready\", async () => {\n    const gate = new StartGate(30);\n    await gate.acquire();\n    const started = Date.now();\n    await gate.acquire();\n    expect(Date.now() - started).toBeGreaterThanOrEqual(25);\n  });\n\n  it(\"treats a second release as a no-op\", async () => {\n    const gate = new StartGate(5_000);\n    const first = await gate.acquire();\n    first();\n    first();\n    const second = await gate.acquire();\n    let thirdRan = false;\n    void gate.acquire().then(() => (thirdRan = true));\n    first();\n    await tick();\n    expect(thirdRan).toBe(false);\n    second();\n    await tick();\n    expect(thirdRan).toBe(true);\n  });\n});\n\ndescribe(\"gatedStart\", () => {\n  it(\"holds the gate from spawn until the bridge says it is ready\", async () => {\n    const gate = new StartGate(5_000);\n    const a = gatedStart(gate, [\"bridge\", \"--claim\", \"a\"]);\n    const b = gatedStart(gate, [\"bridge\", \"--claim\", \"b\"]);\n    expect(await a.command()).toEqual([\"bridge\", \"--claim\", \"a\"]);\n    let bSpawned = false;\n    void b.command().then(() => (bSpawned = true));\n    await tick();\n    expect(bSpawned).toBe(false);\n    a.onLog(\"unrelated stderr\\n\");\n    await tick();\n    expect(bSpawned).toBe(false);\n    a.onLog(`${BRIDGE_READY}\\n`);\n    await tick();\n    expect(bSpawned).toBe(true);\n  });\n\n  it(\"frees the gate when a connection closes mid-start, and on a respawn\", async () => {\n    const gate = new StartGate(5_000);\n    const a = gatedStart(gate, [\"a\"]);\n    const b = gatedStart(gate, [\"b\"]);\n    await a.command();\n    let bSpawned = false;\n    void b.command().then(() => (bSpawned = true));\n    a.release();\n    await tick();\n    expect(bSpawned).toBe(true);\n  });\n\n  it(\"does not take the gate after its connection closed while waiting for a turn\", async () => {\n    const gate = new StartGate(5_000);\n    const a = gatedStart(gate, [\"a\"]);\n    const b = gatedStart(gate, [\"b\"]);\n    const c = gatedStart(gate, [\"c\"]);\n    await a.command();\n    const bResult = b.command().then(\n      () => \"spawned\",\n      () => \"cancelled\",\n    );\n    let cSpawned = false;\n    void c.command().then(() => (cSpawned = true));\n    b.release(); // the connection closed while queued behind a\n    expect(await bResult).toBe(\"cancelled\");\n    a.onLog(`${BRIDGE_READY}\\n`);\n    await tick();\n    expect(cSpawned).toBe(true); // b did not take the turn and sit on it\n  });\n\n  it(\"lets a connection respawn without deadlocking on its own earlier turn\", async () => {\n    const gate = new StartGate(5_000);\n    const a = gatedStart(gate, [\"a\"]);\n    await a.command();\n    await a.command();\n    a.release();\n  });\n});\n    26\t  shellPath?: string;\n    27\t  /**\n    28\t   * Added to the environment of every command this env runs (pi-env's `shellEnv`), and of no other env's. It goes\n    29\t   * through the pi-env protocol to the daemon, not through the bridge's own environment.\n    30\t   */\n    31\t  shellEnv?: Record<string, string>;\n    32\t}\n    33\t\n    34\texport interface SandboxEnv {\n    35\t  env: RemoteExecutionEnv;\n    36\t  connection: Connection;\n    37\t  /** Stops the bridge; the daemon then ends its commands and exits. */\n    38\t  close(): void;\n    39\t}\n    40\t\n    41\t/**\n    42\t * pi-env's Connection can only spawn a local program, so the sandbox hop is a bridge process that\n    43\t * receives the `serve --token` arguments Connection appends. The sandboxd token is read by the\n    44\t * bridge from its own PI_SANDBOX_AUTH_TOKEN, which bridge-launcher derives per claim (see token.ts).\n    45\t */\n    46\texport function connectSandboxEnv(options: SandboxEnvOptions): SandboxEnv {\n    47\t  const bridge = options.bridgeCommand ?? [\n    48\t    process.execPath,\n    49\t    fileURLToPath(new URL(\"./cli.js\", import.meta.url)),\n    50\t  ];\n    51\t  const start = gatedStart(startGate, [\n    52\t    ...bridge,\n    53\t    \"--claim\",\n    54\t    options.claimName,\n    55\t    \"--namespace\",\n    56\t    options.namespace,\n    57\t    ...(options.connectivity ? [\"--connectivity\", options.connectivity] : []),\n    58\t  ]);\n    59\t  const connection = new Connection({ command: start.command, onLog: start.onLog });\n    60\t  const env = new RemoteExecutionEnv({\n    61\t    connection,\n    62\t    id: options.id,\n    63\t    cwd: options.cwd,\n    64\t    ...(options.shellPath === undefined ? {} : { shellPath: options.shellPath }),\n    65\t    ...(options.shellEnv === undefined ? {} : { shellEnv: options.shellEnv }),\n    66\t  });\n    67\t  return {\n    68\t    env,\n    69\t    connection,\n    70\t    close: () => {\n    71\t      start.release();\n    72\t      connection.close();\n    73\t    },\n    74\t  };\n    75\t}\n","isError":false}]}
