ENTRY 12174 {"id":12174,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport { fileURLToPath } from \"node:url\";\n     2\timport { Connection, RemoteExecutionEnv } from \"@earendil-works/pi-env\";\n     3\t\n     4\timport { StartGate, gatedStart } from \"./start-gate.js\";\n     5\t\n     6\t/** One gate per process: all of this process's bridges cold-start through it. 45 s is above a slow start. */\n     7\tconst startGate = new StartGate(45_000);\n     8\t\n     9\texport { runBridge } from \"./bridge.js\";\n    10\texport type { BridgeOptions, RemoteProcess, StartProcess } from \"./bridge.js\";\n    11\texport { ENV } from \"./config.js\";\n    12\texport { ensureClaim } from \"./sandbox-client.js\";\n    13\texport { SANDBOXD_TOKEN_SHA256_ENV, deriveSandboxToken, sandboxTokenSha256 } from \"./token.js\";\n    14\texport type { ClaimRequest, Connectivity } from \"./sandbox-client.js\";\n    15\t\n    16\texport interface SandboxEnvOptions {\n    17\t  claimName: string;\n    18\t  namespace: string;\n    19\t  /** Working directory inside the sandbox; must exist there (e.g. the workspace mount). */\n    20\t  cwd: string;\n    21\t  /** File namespace for the env, e.g. `pi-env:<conversation id>`. */\n    22\t  id: string;\n    23\t  connectivity?: \"in-cluster-service\" | \"in-cluster-pod-ip\" | \"port-forward\";\n    24\t  /** argv of the bridge program. Defaults to `node <this package>/dist/cli.js`. */\n    25\t  bridgeCommand?: readonly string[];\n    26\t  shellPath?: string;\n    27\t  /**\n    28\t   * Added to the environment of every command this env runs (pi-env's `shellEnv`), and of no other env's. It goes\n    29\t   * through the pi-env protocol to the daemon, not through the bridge's own environment.\n    30\t   */\n    31\t  shellEnv?: Record<string, string>;\n    32\t}\n    33\t\n    34\texport interface SandboxEnv {\n    35\t  env: RemoteExecutionEnv;\n    36\t  connection: Connection;\n    37\t  /** Stops the bridge; the daemon then ends its commands and exits. */\n    38\t  close(): void;\n    39\t}\n    40\t\n    41\t/**\n    42\t * pi-env's Connection can only spawn a local program, so the sandbox hop is a bridge process that\n    43\t * receives the `serve --token` arguments Connection appends. The sandboxd token is read by the\n    44\t * bridge from its own PI_SANDBOX_AUTH_TOKEN, which bridge-launcher derives per claim (see token.ts).\n    45\t */\n    46\texport function connectSandboxEnv(options: SandboxEnvOptions): SandboxEnv {\n    47\t  const bridge = options.bridgeCommand ?? [\n    48\t    process.execPath,\n    49\t    fileURLToPath(new URL(\"./cli.js\", import.meta.url)),\n    50\t  ];\n    51\t  const start = gatedStart(startGate, [\n    52\t    ...bridge,\n    53\t    \"--claim\",\n    54\t    options.claimName,\n    55\t    \"--namespace\",\n    56\t    options.namespace,\n    57\t    ...(options.connectivity ? [\"--connectivity\", options.connectivity] : []),\n    58\t  ]);\n    59\t  const connection = new Connection({ command: start.command, onLog: start.onLog });\n    60\t  const env = new RemoteExecutionEnv({\n    61\t    connection,\n    62\t    id: options.id,\n    63\t    cwd: options.cwd,\n    64\t    ...(options.shellPath === undefined ? {} : { shellPath: options.shellPath }),\n    65\t    ...(options.shellEnv === undefined ? {} : { shellEnv: options.shellEnv }),\n    66\t  });\n    67\t  return {\n    68\t    env,\n    69\t    connection,\n    70\t    close: () => {\n    71\t      start.release();\n    72\t      connection.close();\n    73\t    },\n    74\t  };\n    75\t}\n    20\t   * `signal` while waiting gives the turn up at once and rejects: a waiter that is gone must not take the gate later\n    21\t   * and hold it until `maxHoldMs`.\n    22\t   */\n    23\t  async acquire(signal?: AbortSignal): Promise<() => void> {\n    24\t    let release: () => void = () => undefined;\n    25\t    const mine = new Promise<void>((resolve) => {\n    26\t      release = resolve;\n    27\t    });\n    28\t    const previous = this.#tail;\n    29\t    this.#tail = previous.then(() => mine);\n    30\t    const cancelled = new Promise<never>((_resolve, reject) => {\n    31\t      const cancel = (): void => {\n    32\t        release();\n    33\t        reject(new Error(\"start gate wait cancelled\"));\n    34\t      };\n    35\t      if (signal?.aborted === true) cancel();\n    36\t      else signal?.addEventListener(\"abort\", cancel, { once: true });\n    37\t    });\n    38\t    // Nobody may be waiting on `cancelled` any more once `previous` won; it must not become an unhandled rejection.\n    39\t    cancelled.catch(() => undefined);\n    40\t    await Promise.race([previous, cancelled]);\n    41\t    const timer = setTimeout(release, this.#maxHoldMs);\n    42\t    timer.unref();\n    43\t    return () => {\n    44\t      clearTimeout(timer);\n    45\t      release();\n    46\t    };\n    47\t  }\n    48\t}\n    49\t\n    50\texport interface GatedStart {\n    51\t  /** For `ConnectionOptions.command`: waits for the gate, then yields the bridge argv. */\n    52\t  command: () => Promise<readonly string[]>;\n    53\t  /** For `ConnectionOptions.onLog`: frees the gate when the bridge reports ready. */\n    54\t  onLog: (text: string) => void;\n    55\t  /** On close: frees the gate if this connection holds it, and cancels a turn it is still waiting for. */\n    56\t  release: () => void;\n    57\t}\n    58\t\n    59\t/** Wires one connection's bridge launches through `gate`; every respawn takes a new turn. */\n    60\texport function gatedStart(gate: StartGate, argv: readonly string[]): GatedStart {\n    61\t  let release: (() => void) | undefined;\n    62\t  let waiting: AbortController | undefined;\n    63\t  const free = (): void => {\n    64\t    release?.();\n    65\t    release = undefined;\n    66\t  };\n    67\t  return {\n    68\t    command: async () => {\n    69\t      free();\n    70\t      const mine = new AbortController();\n    71\t      waiting = mine;\n    72\t      try {\n    73\t        release = await gate.acquire(mine.signal);\n    74\t      } finally {\n    75\t        if (waiting === mine) waiting = undefined;\n    76\t      }\n    77\t      return argv;\n    78\t    },\n    79\t    onLog: (text) => {\n    80\t      if (text.includes(BRIDGE_READY)) free();\n    81\t    },\n    82\t    release: () => {\n    83\t      // A command() still waiting for its turn must give it up, or it would take the gate after the close.\n    84\t      waiting?.abort();\n    85\t      free();\n    86\t    },\n    87\t  };\n    88\t}\n    45\tfunction describe(error: unknown): string {\n    46\t  return error instanceof Error ? error.message : String(error);\n    47\t}\n    48\t\n    49\tfunction flush(stream: Writable): Promise<void> {\n    50\t  return new Promise((resolve) => stream.write(new Uint8Array(0), () => resolve()));\n    51\t}\n    52\t\n    53\t/**\n    54\t * Pipes stdin to the remote process and its stdout to ours, byte for byte, and returns the exit code\n    55\t * the bridge should exit with. Stdin writes are awaited one at a time: the SDK sends each as its own\n    56\t * RPC, and concurrent RPCs could reorder bytes inside a pi-env frame. Any write failure or stream\n    57\t * loss is fatal because a half-delivered frame cannot be repaired; pi-env's Connection restarts us.\n    58\t */\n    59\texport async function runBridge(options: BridgeOptions): Promise<number> {\n    60\t  const { stdin, stdout, stderr } = options;\n    61\t  let proc: RemoteProcess;\n    62\t  try {\n    63\t    proc = await options.start(options.command, options.args, {\n    64\t      onStdout: (chunk) => void stdout.write(chunk),\n    65\t      onStderr: (chunk) => void stderr.write(chunk),\n    66\t    });\n    67\t  } catch (error) {\n    68\t    stderr.write(`bridge: cannot start ${options.command}: ${describe(error)}\\n`);\n    69\t    return 1;\n    70\t  }\n","isError":false}]}
ENTRY 12189 {"id":12189,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n### 1. A failed bridge start delays unrelated sandboxes\n- Severity: medium\n- Confidence: high\n- Location: packages/sandbox-env/src/index.ts:51\n- What happens: If a bridge exits before reporting ready, such as when its sandbox connection fails, its gate turn is not released on exit. Other sandboxes in the process must wait up to 45 seconds before starting; multiple failures can compound the delay.\n- Evidence: All connections use `gatedStart(startGate, ...)`; the gate releases on the ready log or close, otherwise `setTimeout(release, this.#maxHoldMs)` releases it.\n- Fix idea: Release the turn when the bridge process exits or fails to spawn, as well as when it reports ready. Retain the timer as a fallback.\n\nEND-OF-REPORT"}]}
