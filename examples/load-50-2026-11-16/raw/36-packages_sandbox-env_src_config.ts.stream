ENTRY 11823 {"id":11823,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { fileURLToPath } from \"node:url\";\nimport { Connection, RemoteExecutionEnv } from \"@earendil-works/pi-env\";\n\nimport { StartGate, gatedStart } from \"./start-gate.js\";\n\n/** One gate per process: all of this process's bridges cold-start through it. 45 s is above a slow start. */\nconst startGate = new StartGate(45_000);\n\nexport { runBridge } from \"./bridge.js\";\nexport type { BridgeOptions, RemoteProcess, StartProcess } from \"./bridge.js\";\nexport { ENV } from \"./config.js\";\nexport { ensureClaim } from \"./sandbox-client.js\";\nexport { SANDBOXD_TOKEN_SHA256_ENV, deriveSandboxToken, sandboxTokenSha256 } from \"./token.js\";\nexport type { ClaimRequest, Connectivity } from \"./sandbox-client.js\";\n\nexport interface SandboxEnvOptions {\n  claimName: string;\n  namespace: string;\n  /** Working directory inside the sandbox; must exist there (e.g. the workspace mount). */\n  cwd: string;\n  /** File namespace for the env, e.g. `pi-env:<conversation id>`. */\n  id: string;\n  connectivity?: \"in-cluster-service\" | \"in-cluster-pod-ip\" | \"port-forward\";\n  /** argv of the bridge program. Defaults to `node <this package>/dist/cli.js`. */\n  bridgeCommand?: readonly string[];\n  shellPath?: string;\n  /**\n   * Added to the environment of every command this env runs (pi-env's `shellEnv`), and of no other env's. It goes\n   * through the pi-env protocol to the daemon, not through the bridge's own environment.\n   */\n  shellEnv?: Record<string, string>;\n}\n\nexport interface SandboxEnv {\n  env: RemoteExecutionEnv;\n  connection: Connection;\n  /** Stops the bridge; the daemon then ends its commands and exits. */\n  close(): void;\n}\n\n/**\n * pi-env's Connection can only spawn a local program, so the sandbox hop is a bridge process that\n * receives the `serve --token` arguments Connection appends. The sandboxd token is read by the\n * bridge from its own PI_SANDBOX_AUTH_TOKEN, which bridge-launcher derives per claim (see token.ts).\n */\nexport function connectSandboxEnv(options: SandboxEnvOptions): SandboxEnv {\n  const bridge = options.bridgeCommand ?? [\n    process.execPath,\n    fileURLToPath(new URL(\"./cli.js\", import.meta.url)),\n  ];\n  const start = gatedStart(startGate, [\n    ...bridge,\n    \"--claim\",\n    options.claimName,\n    \"--namespace\",\n    options.namespace,\n    ...(options.connectivity ? [\"--connectivity\", options.connectivity] : []),\n  ]);\n  const connection = new Connection({ command: start.command, onLog: start.onLog });\n  const env = new RemoteExecutionEnv({\n    connection,\n    id: options.id,\n    cwd: options.cwd,\n    ...(options.shellPath === undefined ? {} : { shellPath: options.shellPath }),\n    ...(options.shellEnv === undefined ? {} : { shellEnv: options.shellEnv }),\n  });\n  return {\n    env,\n    connection,\n    close: () => {\n      start.release();\n      connection.close();\n    },\n  };\n}\n// The only module allowed to import the vendored Agent Sandbox SDK (see packages/vendor).\nimport { SandboxClient } from \"agentic-sandbox-client\";\nimport type { RemoteProcess, StartProcess } from \"./bridge.js\";\n\nexport type Connectivity = \"in-cluster-service\" | \"in-cluster-pod-ip\" | \"port-forward\";\n\nexport interface SandboxTarget {\n  claimName: string;\n  namespace: string;\n  connectivity: Connectivity;\n  /** Bearer token for sandboxd; plaintext on the wire with the in-cluster modes. */\n  authToken?: string;\n}\n\n/** Looks the SandboxClaim up on first use, so constructing this does no I/O. */\nexport function sandboxStart(target: SandboxTarget): StartProcess {\n  return async (command, args, handlers) => {\n    const client = new SandboxClient({\n      namespace: target.namespace,\n      sandboxd: {\n        connectivity: target.connectivity,\n        ...(target.authToken === undefined ? {} : { authToken: target.authToken }),\n      },\n    });\n    // Release the handle with closeLocal(): Sandbox.close() also DELETES the SandboxClaim, which\n    // would destroy the session's sandbox (and its PVC) every time a bridge exits.\n    const sandbox = await client.getSandbox(target.claimName, target.namespace);\n    try {\n      // No pty: a terminal would merge stderr into stdout and mangle binary bytes.\n      const handle = await sandbox.commands.start(command, args, {\n        onStdout: (chunk) => {\n          handlers.onStdout(chunk);\n        },\n        onStderr: (chunk) => {\n          handlers.onStderr(chunk);\n        },\n      });\n      const process: RemoteProcess = {\n        write: (data) => handle.write(data),\n        closeStdin: () => handle.closeStdin(),\n        wait: () => handle.wait(),\n        close: async () => {\n          await handle.close();\n          await sandbox.closeLocal();\n        },\n      };\n      return process;\n    } catch (error) {\n      await sandbox.closeLocal();\n      throw error;\n    }\n  };\n}\n\nexport interface ClaimRequest extends SandboxTarget {\n  /** SandboxWarmPool the claim references; a pool with `replicas: 0` is a plain template alias. */\n  warmPool: string;\n}\n\n/**\n * Creates the named SandboxClaim, or adopts it when it exists (create-or-attach, so a restarted\n * orchestrator calls it again for every session), and waits until its Sandbox is ready. The handle is\n * released with closeLocal(): only session deletion may delete a claim, and this module has no delete.\n */\nexport async function ensureClaim(request: ClaimRequest): Promise<void> {\n  const client = new SandboxClient({\n    namespace: request.namespace,\n    sandboxd: {\n      connectivity: request.connectivity,\n      ...(request.authToken === undefined ? {} : { authToken: request.authToken }),\n    },\n  });\n  const sandbox = await client.createSandbox(request.warmPool, request.namespace, {\n    claimName: request.claimName,\n    adoptExisting: true,\n  });\n  await sandbox.closeLocal();\n}\nimport { describe, expect, it } from \"vitest\";\nimport { parseBridgeArgs } from \"../src/config.ts\";\n\nconst serve = [\"serve\", \"--token\", \"abc\"];\n\ndescribe(\"parseBridgeArgs\", () => {\n  it(\"reads the target from the environment and defaults to in-cluster-service\", () => {\n    const config = parseBridgeArgs(serve, {\n      PI_SANDBOX_CLAIM: \"c1\",\n      PI_SANDBOX_NAMESPACE: \"ns\",\n      PI_SANDBOX_AUTH_TOKEN: \"t\",\n    });\n    expect(config).toEqual({\n      target: {\n        claimName: \"c1\",\n        namespace: \"ns\",\n        connectivity: \"in-cluster-service\",\n        authToken: \"t\",\n      },\n      command: \"/usr/local/bin/pi-env\",\n      args: serve,\n    });\n  });\n\n  it(\"lets flags override the environment\", () => {\n    const config = parseBridgeArgs([\"--claim\", \"c2\", \"--connectivity\", \"port-forward\", ...serve], {\n      PI_SANDBOX_CLAIM: \"c1\",\n      PI_SANDBOX_NAMESPACE: \"ns\",\n    });\n    expect(config.target).toEqual({\n      claimName: \"c2\",\n      namespace: \"ns\",\n      connectivity: \"port-forward\",\n    });\n  });\n\n  it(\"rejects a missing claim, bad connectivity and a missing serve command\", () => {\n    expect(() => parseBridgeArgs(serve, { PI_SANDBOX_NAMESPACE: \"ns\" })).toThrow(/claim/);\n    expect(() =>\n      parseBridgeArgs(serve, {\n        PI_SANDBOX_CLAIM: \"c\",\n        PI_SANDBOX_NAMESPACE: \"n\",\n        PI_SANDBOX_CONNECTIVITY: \"x\",\n      }),\n    ).toThrow(/connectivity/);\n    expect(() => parseBridgeArgs([], { PI_SANDBOX_CLAIM: \"c\", PI_SANDBOX_NAMESPACE: \"n\" })).toThrow(\n      /serve/,\n    );\n  });\n});\n","isError":false}]}
