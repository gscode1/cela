ENTRY 12461 {"id":12461,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport type { Readable, Writable } from \"node:stream\";\n     2\t\n     3\t/** A process started inside a sandbox. Implemented by sandbox-client.ts and by test fakes. */\n     4\texport interface RemoteProcess {\n     5\t  /** Resolves when the bytes are delivered. A rejection leaves an unknown prefix delivered. */\n     6\t  write(data: Uint8Array): Promise<void>;\n     7\t  closeStdin(): Promise<void>;\n     8\t  wait(): Promise<{ exitCode: number }>;\n     9\t  /** Tears the stream down; sandboxd kills the process group. Idempotent. */\n    10\t  close(): Promise<void>;\n    11\t}\n    12\t\n    13\texport interface OutputHandlers {\n    14\t  onStdout(chunk: Uint8Array): void;\n    15\t  onStderr(chunk: Uint8Array): void;\n    16\t}\n    17\t\n    18\texport type StartProcess = (\n    19\t  command: string,\n    20\t  args: readonly string[],\n    21\t  handlers: OutputHandlers,\n    22\t) => Promise<RemoteProcess>;\n    23\t\n    24\t/** Written to the bridge's stderr once the remote process is running. */\n    25\texport const BRIDGE_READY = \"bridge: ready\";\n    26\t\n    27\texport interface BridgeOptions {\n    28\t  start: StartProcess;\n    29\t  command: string;\n    30\t  args: readonly string[];\n    31\t  stdin: Readable;\n    32\t  stdout: Writable;\n    33\t  stderr: Writable;\n    34\t}\n    35\t\n    36\ttype Outcome =\n    37\t  { kind: \"exit\"; exitCode: number } | { kind: \"stdin-done\" } | { kind: \"fatal\"; reason: string };\n    38\t\n    39\t/** Remote codes outside 1..255 (signal deaths, negatives) must still read as failure. */\n    40\tfunction toExitCode(exitCode: number): number {\n    41\t  if (exitCode === 0) return 0;\n    42\t  return Number.isInteger(exitCode) && exitCode > 0 && exitCode <= 255 ? exitCode : 1;\n    43\t}\n    44\t\n    45\tfunction describe(error: unknown): string {\n    46\t  return error instanceof Error ? error.message : String(error);\n    47\t}\n    48\t\n    49\tfunction flush(stream: Writable): Promise<void> {\n    50\t  return new Promise((resolve) => stream.write(new Uint8Array(0), () => resolve()));\n    51\t}\n    52\t\n    53\t/**\n    54\t * Pipes stdin to the remote process and its stdout to ours, byte for byte, and returns the exit code\n    55\t * the bridge should exit with. Stdin writes are awaited one at a time: the SDK sends each as its own\n    56\t * RPC, and concurrent RPCs could reorder bytes inside a pi-env frame. Any write failure or stream\n    57\t * loss is fatal because a half-delivered frame cannot be repaired; pi-env's Connection restarts us.\n    58\t */\n    59\texport async function runBridge(options: BridgeOptions): Promise<number> {\n    60\t  const { stdin, stdout, stderr } = options;\n    61\t  let proc: RemoteProcess;\n    62\t  try {\n    63\t    proc = await options.start(options.command, options.args, {\n    64\t      onStdout: (chunk) => void stdout.write(chunk),\n    65\t      onStderr: (chunk) => void stderr.write(chunk),\n    66\t    });\n    67\t  } catch (error) {\n    68\t    stderr.write(`bridge: cannot start ${options.command}: ${describe(error)}\\n`);\n    69\t    return 1;\n    70\t  }\n    71\t  // Tells the parent that the cold start (the CPU-heavy part) is over; see StartGate.\n    72\t  stderr.write(`${BRIDGE_READY}\\n`);\n    73\t\n    74\t  const exited = proc.wait().then(\n    75\t    (result): Outcome => ({ kind: \"exit\", exitCode: toExitCode(result.exitCode) }),\n    76\t    (error: unknown): Outcome => ({\n    77\t      kind: \"fatal\",\n    78\t      reason: `remote stream lost: ${describe(error)}`,\n    79\t    }),\n    80\t  );\n    81\t  const outputFailed = new Promise<Outcome>((resolve) =>\n    82\t    stdout.once(\"error\", (error) =>\n    83\t      resolve({ kind: \"fatal\", reason: `stdout write failed: ${describe(error)}` }),\n    84\t    ),\n    85\t  );\n    86\t  const pumped = (async (): Promise<Outcome> => {\n    87\t    try {\n    88\t      for await (const chunk of stdin) {\n    89\t        await proc.write(chunk as Uint8Array);\n    90\t      }\n    91\t      await proc.closeStdin();\n    92\t      return { kind: \"stdin-done\" };\n    93\t    } catch (error) {\n    94\t      return { kind: \"fatal\", reason: `stdin write failed: ${describe(error)}` };\n    95\t    }\n    96\t  })();\n    97\t\n    98\t  let outcome = await Promise.race([exited, pumped, outputFailed]);\n    99\t  if (outcome.kind === \"stdin-done\") {\n   100\t    // Stdin ended cleanly: pi-env exits on EOF, so wait for it.\n   101\t    outcome = await Promise.race([exited, outputFailed]);\n   102\t  }\n   103\t  try {\n   104\t    if (outcome.kind === \"fatal\") {\n   105\t      stderr.write(`bridge: ${outcome.reason}\\n`);\n   106\t      return 1;\n   107\t    }\n   108\t    if (outcome.kind === \"exit\") await flush(stdout);\n   109\t    return outcome.kind === \"exit\" ? outcome.exitCode : 1;\n   110\t  } finally {\n   111\t    await proc.close().catch(() => undefined);\n   112\t  }\n   113\t}\ntotal 197\ndrwxr-sr-x. 10 1000 1000   4096 Nov 16 12:42 .\ndrwxrwsr-x.  5 root 1000   4096 Nov 16 12:42 ..\ndrwxr-sr-x.  8 1000 1000   4096 Nov 16 12:42 .git\n-rw-r--r--.  1 1000 1000     92 Nov 16 12:42 .gitignore\n-rw-r--r--.  1 1000 1000    255 Nov 16 12:42 .prettierignore\n-rw-r--r--.  1 1000 1000     22 Nov 16 12:42 .prettierrc.json\n-rw-r--r--.  1 1000 1000   3593 Nov 16 12:42 AGENT.md\n-rw-r--r--.  1 1000 1000     10 Nov 16 12:42 CLAUDE.md\n-rw-r--r--.  1 1000 1000   1064 Nov 16 12:42 LICENSE\n-rw-r--r--.  1 1000 1000   4607 Nov 16 12:42 README.md\ndrwxr-sr-x.  4 1000 1000   4096 Nov 16 12:42 deploy\ndrwxr-sr-x.  4 1000 1000   4096 Nov 16 12:42 docs\n-rw-r--r--.  1 1000 1000    672 Nov 16 12:42 eslint.config.js\ndrwxr-sr-x.  3 1000 1000   4096 Nov 16 12:42 examples\ndrwxr-sr-x.  3 1000 1000   4096 Nov 16 12:42 images\n-rw-r--r--.  1 1000 1000    709 Nov 16 12:42 package.json\ndrwxr-sr-x.  7 1000 1000   4096 Nov 16 12:42 packages\n-rw-r--r--.  1 1000 1000  24371 Nov 16 12:42 plan.md\n-rw-r--r--.  1 1000 1000 120703 Nov 16 12:42 pnpm-lock.yaml\n-rw-r--r--.  1 1000 1000    377 Nov 16 12:42 pnpm-workspace.yaml\ndrwxr-sr-x.  3 1000 1000   4096 Nov 16 12:42 tests\ndrwxr-sr-x.  2 1000 1000   4096 Nov 16 12:42 vendor\ndocs/session-api.md:152:  `bridge-launcher.js`, which gives them only `PI_SANDBOX_AUTH_TOKEN` (the token of their own claim, derived from the\ndocs/decisions/0001-per-sandbox-sandboxd-token.md:21:  sandbox or a bridge. `bridge-launcher.js` derives the token of the bridge's own `--claim`, sets\ndocs/research/phase1-apis.md:208:  argv, no shell. Lifetime: **the process is tied to its gRPC stream; closing the handle, aborting the signal, `sandbox.close()` or a lost connection makes sandboxd SIGKILL the whole process group; no detach, no reattach** (README \"Interactive processes\"; `process.go` `killProcessGroupOnContextDone`). This matches plan.md's \"interrupted commands\" decision, and means an orchestrator crash also kills pi-env and all its children (consistent with the daemon's own stdin-EOF behaviour).\ndocs/research/phase1-apis.md:230:5. Process exit: closing stdin (`closeStdin()` => `eof` payload) lets pi-env exit; killing the handle SIGKILLs the process group, so pi-env cannot clean up its children itself; the sandboxd group kill covers pi-env's process group but pi-env puts commands in their own process groups (`exec` \"its own process group\", protocol.md); whether `SIGKILL` of pi-env's group also reaps those child groups is UNVERIFIED and matters for the Phase 3 \"process is dead in the sandbox\" test. pi-env only kills child groups on its own exit paths (stdin end/SIGTERM/30 s silence), and the SDK offers `signal(\"SIGTERM\")`/`closeStdin()` for a graceful stop: prefer `closeStdin()` then `wait()` on shutdown.\ndocs/research/phase1-apis.md:243:- Not resolved: pi-env child-process group cleanup when sandboxd SIGKILLs pi-env (see caveat 5).\npackages/orchestrator/test/bridge-launcher.test.ts:3:import { bridgeEnv, claimOf } from \"../src/bridge-launcher.ts\";\n     1\timport { deriveSandboxToken } from \"@pi-durable-k8s/sandbox-env\";\n     2\timport { describe, expect, it } from \"vitest\";\n     3\timport { bridgeEnv, claimOf } from \"../src/bridge-launcher.ts\";\n     4\t\n     5\tconst MASTER = \"master-key-value\";\n     6\t\n     7\tdescribe(\"bridgeEnv\", () => {\n     8\t  it(\"keeps the Kubernetes endpoint, adds its own claim's token and drops every other secret\", () => {\n     9\t    const kept = bridgeEnv(\n    10\t      {\n    11\t        PATH: \"/usr/bin\",\n    12\t        HOME: \"/tmp\",\n    13\t        KUBERNETES_SERVICE_HOST: \"10.96.0.1\",\n    14\t        PI_SANDBOX_MASTER_KEY: MASTER,\n    15\t        PI_SANDBOX_AUTH_TOKEN: \"stale-inherited-token\",\n    16\t        PI_DURABLE_DATABASE_URL: \"postgres://u:p@db/app\",\n    17\t        PI_API_TOKENS: \"alice:secret-token-value\",\n    18\t        SOMETHING_ELSE: \"x\",\n    19\t      },\n    20\t      \"pi-conv-7\",\n    21\t    );\n    22\t    expect(kept).toEqual({\n    23\t      PATH: \"/usr/bin\",\n    24\t      HOME: \"/tmp\",\n    25\t      KUBERNETES_SERVICE_HOST: \"10.96.0.1\",\n    26\t      PI_SANDBOX_AUTH_TOKEN: deriveSandboxToken(MASTER, \"pi-conv-7\"),\n    27\t    });\n    28\t  });\n    29\t\n    30\t  it(\"never lets the master key (or anything derived from it but its own token) reach the bridge\", () => {\n    31\t    const kept = bridgeEnv({ PATH: \"/usr/bin\", PI_SANDBOX_MASTER_KEY: MASTER }, \"pi-conv-7\");\n    32\t    expect(Object.keys(kept)).not.toContain(\"PI_SANDBOX_MASTER_KEY\");\n    33\t    expect(Object.values(kept)).not.toContain(MASTER);\n    34\t    expect(kept.PI_SANDBOX_AUTH_TOKEN).not.toBe(deriveSandboxToken(MASTER, \"pi-conv-8\"));\n    35\t  });\n    36\t\n    37\t  it(\"fails closed without a master key\", () => {\n    38\t    expect(() => bridgeEnv({ PATH: \"/usr/bin\" }, \"pi-conv-7\")).toThrow(/PI_SANDBOX_MASTER_KEY/);\n    39\t    expect(() => bridgeEnv({ PI_SANDBOX_MASTER_KEY: \"\" }, \"pi-conv-7\")).toThrow(\n    40\t      /PI_SANDBOX_MASTER_KEY/,\n    41\t    );\n    42\t  });\n    43\t\n    44\t  it(\"never passes the OneCLI agent token or any proxy setting on to a bridge\", () => {\n    45\t    const kept = bridgeEnv(\n    46\t      {\n    47\t        PATH: \"/usr/bin\",\n    48\t        PI_SANDBOX_MASTER_KEY: MASTER,\n    49\t        ONECLI_AGENT_TOKEN: \"aoc_0123456789abcdef\",\n    50\t        HTTPS_PROXY: \"http://x:aoc_0123456789abcdef@onecli.onecli:10255\",\n    51\t        HTTP_PROXY: \"http://onecli.onecli:10255\",\n    52\t        NO_PROXY: \".svc\",\n    53\t        NODE_USE_ENV_PROXY: \"1\",\n    54\t        OPENROUTER_API_KEY: \"sk-real\",\n    55\t        ONECLI_API_KEY: \"oc_admin\",\n    56\t        PI_GITHUB_APP_DIR: \"/etc/pi-github-app\",\n    57\t      },\n    58\t      \"pi-conv-7\",\n    59\t    );\n    60\t    expect(Object.keys(kept).sort()).toEqual([\"PATH\", \"PI_SANDBOX_AUTH_TOKEN\"]);\n    61\t  });\n    62\t});\n    63\t\n    64\tdescribe(\"claimOf\", () => {\n    65\t  it(\"reads the --claim value the bridge is started with\", () => {\n    66\t    expect(claimOf([\"--claim\", \"pi-conv-7\", \"--namespace\", \"ns\", \"serve\"])).toBe(\"pi-conv-7\");\n    67\t  });\n    68\t\n    69\t  it(\"rejects a missing or empty claim\", () => {\n    70\t    expect(() => claimOf([\"--namespace\", \"ns\", \"serve\"])).toThrow(/--claim/);\n    71\t    expect(() => claimOf([\"serve\", \"--claim\"])).toThrow(/--claim/);\n    72\t    expect(() => claimOf([\"--claim\", \"\"])).toThrow(/--claim/);\n    73\t  });\n    74\t});\n","isError":false}]}
