ENTRY 12423 {"id":12423,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/orchestrator/src/bridge-launcher.ts:21:  \"PI_SANDBOX_ENV_BINARY\",\npackages/orchestrator/src/bridge-launcher.ts:24:/** The value of the bridge's `--claim` flag. */\npackages/orchestrator/src/bridge-launcher.ts:26:  const claim = argv[argv.indexOf(\"--claim\") + 1];\npackages/orchestrator/src/bridge-launcher.ts:27:  if (argv.indexOf(\"--claim\") < 0 || claim === undefined || claim === \"\") {\npackages/orchestrator/src/bridge-launcher.ts:28:    throw new Error(\"bridge-launcher: --claim <name> is required\");\npackages/orchestrator/src/bridge-launcher.ts:44:    throw new Error(`bridge-launcher: ${ENV.masterKey} is not set`);\npackages/orchestrator/src/sandboxes.ts:30:const BRIDGE_LAUNCHER = fileURLToPath(new URL(\"./bridge-launcher.js\", import.meta.url));\npackages/orchestrator/src/sandboxes.ts:355:    // pi-env protocol to the daemon, never through the bridge process environment (bridge-launcher derives its own claim's token and drops the master).\npackages/orchestrator/test/bridge-launcher.test.ts:3:import { bridgeEnv, claimOf } from \"../src/bridge-launcher.ts\";\npackages/orchestrator/test/bridge-launcher.test.ts:65:  it(\"reads the --claim value the bridge is started with\", () => {\npackages/orchestrator/test/bridge-launcher.test.ts:66:    expect(claimOf([\"--claim\", \"pi-conv-7\", \"--namespace\", \"ns\", \"serve\"])).toBe(\"pi-conv-7\");\npackages/orchestrator/test/bridge-launcher.test.ts:70:    expect(() => claimOf([\"--namespace\", \"ns\", \"serve\"])).toThrow(/--claim/);\npackages/orchestrator/test/bridge-launcher.test.ts:71:    expect(() => claimOf([\"serve\", \"--claim\"])).toThrow(/--claim/);\npackages/orchestrator/test/bridge-launcher.test.ts:72:    expect(() => claimOf([\"--claim\", \"\"])).toThrow(/--claim/);\npackages/sandbox-env/src/config.ts:4: * Environment contract of the bridge. Flags (`--claim`, `--namespace`, `--connectivity`) take\npackages/sandbox-env/src/config.ts:16:  envBinary: \"PI_SANDBOX_ENV_BINARY\",\npackages/sandbox-env/src/config.ts:35:  [\"--claim\", \"claim\"],\npackages/sandbox-env/src/config.ts:48:    const key = arg === undefined ? undefined : FLAGS.get(arg as \"--claim\");\npackages/sandbox-env/src/config.ts:58:  if (!claimName) throw new Error(`sandbox claim missing: set ${ENV.claim} or pass --claim`);\npackages/sandbox-env/src/index.ts:44: * bridge from its own PI_SANDBOX_AUTH_TOKEN, which bridge-launcher derives per claim (see token.ts).\npackages/sandbox-env/src/index.ts:53:    \"--claim\",\npackages/sandbox-env/test/config.test.ts:26:    const config = parseBridgeArgs([\"--claim\", \"c2\", \"--connectivity\", \"port-forward\", ...serve], {\npackages/sandbox-env/test/start-gate.test.ts:56:    const a = gatedStart(gate, [\"bridge\", \"--claim\", \"a\"]);\npackages/sandbox-env/test/start-gate.test.ts:57:    const b = gatedStart(gate, [\"bridge\", \"--claim\", \"b\"]);\npackages/sandbox-env/test/start-gate.test.ts:58:    expect(await a.command()).toEqual([\"bridge\", \"--claim\", \"a\"]);\n","isError":false}]}
