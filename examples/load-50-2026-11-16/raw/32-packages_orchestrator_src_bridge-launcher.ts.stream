ENTRY 12437 {"id":12437,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport type { Connectivity, SandboxTarget } from \"./sandbox-client.js\";\n     2\t\n     3\t/**\n     4\t * Environment contract of the bridge. Flags (`--claim`, `--namespace`, `--connectivity`) take\n     5\t * precedence so one orchestrator process can run bridges for many claims; pi-env's Connection\n     6\t * inherits the parent environment and offers no per-connection env. The token is env-only, so it\n     7\t * never shows up in a process listing.\n     8\t */\n     9\texport const ENV = {\n    10\t  claim: \"PI_SANDBOX_CLAIM\",\n    11\t  namespace: \"PI_SANDBOX_NAMESPACE\",\n    12\t  connectivity: \"PI_SANDBOX_CONNECTIVITY\",\n    13\t  authToken: \"PI_SANDBOX_AUTH_TOKEN\",\n    14\t  /** Master key per-sandbox tokens derive from (token.ts). Orchestrator and e2e driver only, never a bridge. */\n    15\t  masterKey: \"PI_SANDBOX_MASTER_KEY\",\n    16\t  envBinary: \"PI_SANDBOX_ENV_BINARY\",\n    17\t} as const;\n    18\t\n    19\texport const DEFAULT_ENV_BINARY = \"/usr/local/bin/pi-env\";\n    20\t\n    21\tconst CONNECTIVITIES: readonly Connectivity[] = [\n    22\t  \"in-cluster-service\",\n    23\t  \"in-cluster-pod-ip\",\n    24\t  \"port-forward\",\n    25\t];\n    26\t\n    27\texport interface BridgeConfig {\n    28\t  target: SandboxTarget;\n    29\t  command: string;\n    30\t  /** Everything after the bridge's own flags, i.e. `serve --token <hex>` from pi-env. */\n    31\t  args: readonly string[];\n    32\t}\n    33\t\n    34\tconst FLAGS = new Map([\n    35\t  [\"--claim\", \"claim\"],\n    36\t  [\"--namespace\", \"namespace\"],\n    37\t  [\"--connectivity\", \"connectivity\"],\n    38\t] as const);\n    39\t\n    40\texport function parseBridgeArgs(\n    41\t  argv: readonly string[],\n    42\t  env: Readonly<Record<string, string | undefined>>,\n    43\t): BridgeConfig {\n    44\t  const flags: Partial<Record<\"claim\" | \"namespace\" | \"connectivity\", string>> = {};\n    45\t  let i = 0;\n    46\t  for (; i < argv.length; i++) {\n    47\t    const arg = argv[i];\n    48\t    const key = arg === undefined ? undefined : FLAGS.get(arg as \"--claim\");\n    49\t    if (key === undefined) break;\n    50\t    const value = argv[++i];\n    51\t    if (value === undefined) throw new Error(`${arg ?? \"flag\"} needs a value`);\n    52\t    flags[key] = value;\n    53\t  }\n    54\t  const args = argv.slice(i);\n    55\t  if (args[0] !== \"serve\") throw new Error(\"expected `serve --token <hex>` after the bridge flags\");\n    56\t\n    57\t  const claimName = flags.claim ?? env[ENV.claim];\n    58\t  if (!claimName) throw new Error(`sandbox claim missing: set ${ENV.claim} or pass --claim`);\n    59\t  const namespace = flags.namespace ?? env[ENV.namespace];\n    60\t  if (!namespace) throw new Error(`namespace missing: set ${ENV.namespace} or pass --namespace`);\n    61\t  const connectivity = flags.connectivity ?? env[ENV.connectivity] ?? \"in-cluster-service\";\n    62\t  if (!CONNECTIVITIES.includes(connectivity as Connectivity)) {\n    63\t    throw new Error(`connectivity must be one of ${CONNECTIVITIES.join(\", \")}`);\n    64\t  }\n    65\t  const authToken = env[ENV.authToken];\n    66\t  return {\n    67\t    target: {\n    68\t      claimName,\n    69\t      namespace,\n    70\t      connectivity: connectivity as Connectivity,\n    71\t      ...(authToken ? { authToken } : {}),\n    72\t    },\n    73\t    command: env[ENV.envBinary] || DEFAULT_ENV_BINARY,\n    74\t    args,\n    75\t  };\n    76\t}\n     1\t#!/usr/bin/env node\n     2\timport { runBridge } from \"./bridge.js\";\n     3\timport { parseBridgeArgs } from \"./config.js\";\n     4\timport { sandboxStart } from \"./sandbox-client.js\";\n     5\t\n     6\tasync function main(): Promise<number> {\n     7\t  let config;\n     8\t  try {\n     9\t    config = parseBridgeArgs(process.argv.slice(2), process.env);\n    10\t  } catch (error) {\n    11\t    process.stderr.write(`bridge: ${error instanceof Error ? error.message : String(error)}\\n`);\n    12\t    return 2;\n    13\t  }\n    14\t  return runBridge({\n    15\t    start: sandboxStart(config.target),\n    16\t    command: config.command,\n    17\t    args: config.args,\n    18\t    stdin: process.stdin,\n    19\t    stdout: process.stdout,\n    20\t    stderr: process.stderr,\n    21\t  });\n    22\t}\n    23\t\n    24\t// Set the code and let the loop drain: process.exit() could cut off buffered stdout.\n    25\t// A gRPC channel may keep the loop alive, so exit explicitly after a short grace period.\n    26\tvoid main().then((code) => {\n    27\t  process.exitCode = code;\n    28\t  setTimeout(() => process.exit(code), 200).unref();\n    29\t});\n     1\timport { fileURLToPath } from \"node:url\";\n     2\timport { Connection, RemoteExecutionEnv } from \"@earendil-works/pi-env\";\n     3\t\n     4\timport { StartGate, gatedStart } from \"./start-gate.js\";\n     5\t\n     6\t/** One gate per process: all of this process's bridges cold-start through it. 45 s is above a slow start. */\n     7\tconst startGate = new StartGate(45_000);\n     8\t\n     9\texport { runBridge } from \"./bridge.js\";\n    10\texport type { BridgeOptions, RemoteProcess, StartProcess } from \"./bridge.js\";\n    11\texport { ENV } from \"./config.js\";\n    12\texport { ensureClaim } from \"./sandbox-client.js\";\n    13\texport { SANDBOXD_TOKEN_SHA256_ENV, deriveSandboxToken, sandboxTokenSha256 } from \"./token.js\";\n    14\texport type { ClaimRequest, Connectivity } from \"./sandbox-client.js\";\n    15\t\n    16\texport interface SandboxEnvOptions {\n    17\t  claimName: string;\n    18\t  namespace: string;\n    19\t  /** Working directory inside the sandbox; must exist there (e.g. the workspace mount). */\n    20\t  cwd: string;\n    21\t  /** File namespace for the env, e.g. `pi-env:<conversation id>`. */\n    22\t  id: string;\n    23\t  connectivity?: \"in-cluster-service\" | \"in-cluster-pod-ip\" | \"port-forward\";\n    24\t  /** argv of the bridge program. Defaults to `node <this package>/dist/cli.js`. */\n    25\t  bridgeCommand?: readonly string[];\n    26\t  shellPath?: string;\n    27\t  /**\n    28\t   * Added to the environment of every command this env runs (pi-env's `shellEnv`), and of no other env's. It goes\n    29\t   * through the pi-env protocol to the daemon, not through the bridge's own environment.\n    30\t   */\n    31\t  shellEnv?: Record<string, string>;\n    32\t}\n    33\t\n    34\texport interface SandboxEnv {\n    35\t  env: RemoteExecutionEnv;\n    36\t  connection: Connection;\n    37\t  /** Stops the bridge; the daemon then ends its commands and exits. */\n    38\t  close(): void;\n    39\t}\n    40\t\n    41\t/**\n    42\t * pi-env's Connection can only spawn a local program, so the sandbox hop is a bridge process that\n    43\t * receives the `serve --token` arguments Connection appends. The sandboxd token is read by the\n    44\t * bridge from its own PI_SANDBOX_AUTH_TOKEN, which bridge-launcher derives per claim (see token.ts).\n    45\t */\n    46\texport function connectSandboxEnv(options: SandboxEnvOptions): SandboxEnv {\n    47\t  const bridge = options.bridgeCommand ?? [\n    48\t    process.execPath,\n    49\t    fileURLToPath(new URL(\"./cli.js\", import.meta.url)),\n    50\t  ];\n    51\t  const start = gatedStart(startGate, [\n    52\t    ...bridge,\n    53\t    \"--claim\",\n    54\t    options.claimName,\n    55\t    \"--namespace\",\n    56\t    options.namespace,\n    57\t    ...(options.connectivity ? [\"--connectivity\", options.connectivity] : []),\n    58\t  ]);\n    59\t  const connection = new Connection({ command: start.command, onLog: start.onLog });\n    60\t  const env = new RemoteExecutionEnv({\n    61\t    connection,\n    62\t    id: options.id,\n    63\t    cwd: options.cwd,\n    64\t    ...(options.shellPath === undefined ? {} : { shellPath: options.shellPath }),\n    65\t    ...(options.shellEnv === undefined ? {} : { shellEnv: options.shellEnv }),\n    66\t  });\n    67\t  return {\n    68\t    env,\n    69\t    connection,\n    70\t    close: () => {\n    71\t      start.release();\n    72\t      connection.close();\n    73\t    },\n    74\t  };\n    75\t}\n        this.#replace(conversationId, \"idle\", async () => {\n          await this.#closeEnv(conversationId);\n          await suspendSandbox(this.#config.namespace, claimNameFor(conversationId));\n        });\n      }\n    } catch (error) {\n      log(\"suspend-scan-failed\", { message: errorMessage(error) });\n    }\n  }\n\n  /** Creates or adopts the claim and waits for its Sandbox; safe to call on every start. */\n  async ensure(conversationId: number): Promise<SandboxEnv> {\n    let env = this.#envs.get(conversationId);\n    if (env === undefined) {\n      env = this.#open(conversationId);\n      this.#envs.set(conversationId, env);\n      // A failed open must not be cached: the next tool call tries again.\n      env.catch(() => this.#envs.delete(conversationId));\n    }\n    return env;\n  }\n\n  async #open(conversationId: number): Promise<SandboxEnv> {\n    const claimName = claimNameFor(conversationId);\n    const { namespace, warmPool } = this.#config;\n    // Required: a sandbox with no token would be unauthenticated or unreachable. Only the hash goes into the claim.\n    const master = process.env[ENV.masterKey];\n    if (master === undefined || master === \"\") throw new Error(`${ENV.masterKey} is not set`);\n    const token = deriveSandboxToken(master, claimName);\n    try {\n      // Create the claim with the session label, or accept an existing one only if the label matches. The SDK\n      // then adopts it by name.\n      await ensureLabeledClaim(\n        namespace,\n        claimName,\n        warmPool,\n        await this.#sessionKeyOf(conversationId),\n        [{ name: SANDBOXD_TOKEN_SHA256_ENV, value: sandboxTokenSha256(token) }],\n      );\n      // A suspended sandbox is never Ready, so the wait below would only time out: resume it first.\n      if (await resumeIfSuspended(namespace, claimName))\n        log(\"sandbox-resumed\", { claim: claimName });\n      await ensureClaim({\n        claimName,\n        namespace,\n        warmPool,\n        connectivity: \"in-cluster-service\",\n        authToken: token,\n      });\n    } catch (error) {\n      log(\"claim-failed\", { claim: claimName, message: errorMessage(error) });\n      throw error;\n    }\n    log(\"claim-ready\", { claim: claimName });\n    // Credentials for a repo session's commands only; plain sessions get nothing here. The token travels through the\n    // pi-env protocol to the daemon, never through the bridge process environment (bridge-launcher derives its own claim's token and drops the master).\n    const shellEnv = await this.#hooks.shellEnv?.(conversationId);\n    return connectSandboxEnv({\n      claimName,\n      namespace,\n      cwd: WORKSPACE,\n      id: `pi-env:${claimName}`,\n      bridgeCommand: [process.execPath, BRIDGE_LAUNCHER],\n      ...(shellEnv === undefined ? {} : { shellEnv }),\n    });\n  }\n\n  /**\n   * Session deletion: stops the bridge, then deletes the SandboxClaim and the PVC. Idempotent, so a deletion cut\n   * off by a crash is simply run again. With `destroyOrphan` the only place that deletes a claim.\n   */\n  async destroy(conversationId: number): Promise<void> {\n    await this.#teardown(conversationId, await this.#sessionKeyOf(conversationId));\n  }\n\n  /**\n   * The orphan sweep's delete: the same teardown as a session deletion, for a claim whose session is deleted or\n   * unknown. `sessionLabel` is the label the sweep read from the claim, so `deleteClaimAndPvc` still refuses a\n   * claim that changed hands meanwhile.\n   */\n  async destroyOrphan(claimName: string, sessionLabel: string): Promise<void> {\n    const conversationId = conversationOfName(claimName);\n    if (conversationId === undefined) throw new Error(`${claimName} is not a conversation claim`);\n    await this.#teardown(conversationId, sessionLabel);\n  }\n\n  async #teardown(conversationId: number, sessionKey: string): Promise<void> {\n    await this.#replacing.get(conversationId);\n    this.#interrupted.delete(conversationId);\n    this.#failed.delete(conversationId);\n    this.#lastUsed.delete(conversationId);\n{\n  \"name\": \"@pi-durable-k8s/sandbox-env\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"description\": \"pi-env bridge over the Agent Sandbox commands.start() stdio channel.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.19.0\"\n  },\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"bin\": {\n    \"pi-sandbox-bridge\": \"./dist/cli.js\"\n  },\n  \"scripts\": {\n    \"build\": \"rm -rf dist && tsc -p tsconfig.build.json\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@earendil-works/pi-durable\": \"1.5.2\",\n    \"@earendil-works/pi-env\": \"1.5.2\",\n    \"agentic-sandbox-client\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"@earendil-works/chord\": \"1.5.2\",\n    \"@types/node\": \"22.20.5\",\n    \"typescript\": \"7.0.2\",\n    \"vitest\": \"5.1.0\"\n  }\n}\n{\n  \"name\": \"@pi-durable-k8s/orchestrator\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"description\": \"Pi Durable host: Postgres storage, inbox consumer, SSE streams, one sandbox per conversation, scripted model.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.19.0\"\n  },\n  \"scripts\": {\n    \"build\": \"rm -rf dist && tsc -p tsconfig.build.json\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@earendil-works/chord\": \"1.5.2\",\n    \"@earendil-works/pi-ai\": \"1.5.2\",\n    \"@earendil-works/pi-durable\": \"1.5.2\",\n    \"@kubernetes/client-node\": \"2.0.0\",\n    \"@netzlabor/pi-durable-postgres\": \"file:../../vendor/netzlabor-pi-durable-postgres-0.2.0.tgz\",\n    \"@pi-durable-k8s/sandbox-env\": \"workspace:*\",\n    \"@pi-durable-k8s/session-core\": \"workspace:*\",\n    \"undici\": \"8.12.4\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"22.20.5\",\n    \"@types/pg\": \"8.23.1\",\n    \"typescript\": \"7.0.2\",\n    \"vitest\": \"5.1.0\"\n  }\n}\n","isError":false}]}
