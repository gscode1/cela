ENTRY 11386 {"id":11386,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/orchestrator/test/github-app.test.ts:7:  GithubDeniedError,\npackages/orchestrator/test/github-app.test.ts:8:  loadGithubApp,\npackages/orchestrator/test/github-app.test.ts:9:  mintInstallationToken,\npackages/orchestrator/test/github-app.test.ts:57:describe(\"loadGithubApp\", () => {\npackages/orchestrator/test/github-app.test.ts:64:    const loaded = await loadGithubApp(dir);\npackages/orchestrator/test/github-app.test.ts:73:    await expect(loadGithubApp(dir)).rejects.toThrow(\npackages/orchestrator/test/github-app.test.ts:78:    await expect(loadGithubApp(dir)).rejects.toThrow(/private-key\\.pem is missing/);\npackages/orchestrator/test/github-app.test.ts:82:    await expect(loadGithubApp(dir)).rejects.toThrow(/numeric/);\npackages/orchestrator/test/github-app.test.ts:112:  repository_selection: \"selected\",\npackages/orchestrator/test/github-app.test.ts:116:describe(\"mintInstallationToken\", () => {\npackages/orchestrator/test/github-app.test.ts:119:    const minted = await mintInstallationToken(\npackages/orchestrator/test/github-app.test.ts:141:      mintInstallationToken(app, \"octo/hello\", github(201, granted(\"someone-else/hello\")), NOW),\npackages/orchestrator/test/github-app.test.ts:142:    ).rejects.toBeInstanceOf(GithubDeniedError);\npackages/orchestrator/test/github-app.test.ts:147:    await expect(mintInstallationToken(app, \"octo/hello\", github(201, wide), NOW)).rejects.toThrow(\npackages/orchestrator/test/github-app.test.ts:151:    await expect(mintInstallationToken(app, \"octo/hello\", github(201, none), NOW)).rejects.toThrow(\npackages/orchestrator/test/github-app.test.ts:159:        mintInstallationToken(app, \"octo/hello\", github(status, { message: \"Not Found\" }), NOW),\npackages/orchestrator/test/github-app.test.ts:160:      ).rejects.toBeInstanceOf(GithubDeniedError);\npackages/orchestrator/test/github-app.test.ts:162:    const error = await mintInstallationToken(\npackages/orchestrator/test/github-app.test.ts:169:    expect(error).not.toBeInstanceOf(GithubDeniedError);\npackages/orchestrator/src/github-app.ts:48:export async function loadGithubApp(dir: string): Promise<GithubApp> {\npackages/orchestrator/src/github-app.ts:71:export class GithubDeniedError extends Error {}\npackages/orchestrator/src/github-app.ts:78:export async function mintInstallationToken(\npackages/orchestrator/src/github-app.ts:110:      throw new GithubDeniedError(message);\npackages/orchestrator/src/github-app.ts:117:    repository_selection?: unknown;\npackages/orchestrator/src/github-app.ts:126:    throw new GithubDeniedError(\npackages/orchestrator/src/repo-access.ts:5:import { loadGithubApp, mintInstallationToken } from \"./github-app.js\";\npackages/orchestrator/src/repo-access.ts:180:  async #mint(repo: string): ReturnType<typeof mintInstallationToken> {\npackages/orchestrator/src/repo-access.ts:183:      app = await loadGithubApp(this.#deps.githubAppDir);\npackages/orchestrator/src/repo-access.ts:189:    return mintInstallationToken(app, repo, this.#deps.fetch, this.#now(), this.#deps.githubApi);\npackages/orchestrator/src/sessions.ts:13:import { GithubDeniedError } from \"./github-app.js\";\npackages/orchestrator/src/sessions.ts:262:      if (error instanceof GithubDeniedError) {\n","isError":false}]}
