ENTRY 11429 {"id":11429,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"          text,\n          requestId,\n          steer: event.kind === \"steer\",\n        });\n        this.#watcher.add({ sessionId: session.id, conversationId, requestId });\n        if (faultArmed && !alreadyAdmitted) {\n          // After the durable hand-over, before the row says so: exactly the window test 4 needs.\n          // Synchronous write: stdout to a pipe is async and process.exit would drop the line.\n          writeSync(\n            1,\n            `${JSON.stringify({ event: \"test-fault\", fault: \"exit-after-submit\", id: event.id })}\\n`,\n          );\n          process.exit(137);\n        }\n        return;\n      }\n      case \"cancel\": {\n        if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n        return;\n      }\n      case \"delete\": {\n        await this.#delete(session);\n        return;\n      }\n    }\n  }\n\n  /**\n   * Provisions the repo session's GitHub access and makes sure its clone exists. What no retry can fix ends the input\n   * for good (and, for a lost workspace or refused access, the session): the agent must not run a turn in a workspace\n   * that is not the one the user asked for. Anything else throws as is, so the inbox retries it.\n   */\n  async #prepareRepo(session: SessionRow, conversationId: number): Promise<void> {\n    const repos = this.#options.repos;\n    if (repos === undefined) throw new PermanentError(\"repository workspaces are not configured\");\n    try {\n      await repos.prepare(session, await this.#host.workspaceEnv(conversationId));\n    } catch (error) {\n      if (error instanceof WorkspaceLostError) {\n        await this.#failSession(session.id, conversationId, error.message);\n        throw new PermanentError(error.message);\n      }\n      if (error instanceof GithubDeniedError) {\n        const failure =\n          \"GitHub refused access to the repository: is the GitHub App installed on it?\";\n        await this.#failSession(session.id, conversationId, failure);\n        throw new PermanentError(failure);\n      }\n      if (error instanceof RepoUnavailableError) throw new PermanentError(error.message);\n      throw error;\n    }\n  }\n\n  /**\n   * The per-session turn budget, checked before every input: a session that used all its turns fails for good, and\n   * otherwise the conversation's `maxTurns` is set to what is left, so a single long run cannot overshoot it.\n   * Turns are model responses, counted from the stored transcript, so a restart does not reset the count.\n   */\n  async #withinBudget(session: SessionRow, conversationId: number): Promise<void> {\n    const used = await this.#host.turnsUsed(conversationId);\n    const left = this.#options.turnBudget - used;\n    if (left <= 0) {\n      const failure = terminalFailure({ reason: \"turn_limit\" });\n      await this.#failSession(session.id, conversationId, failure ?? \"turn budget exhausted\");\n      throw new PermanentError(\"turn budget exhausted\");\n    }\n    await this.#host.limitTurns(conversationId, left);\n  }\n\n  /**\n   * Stop the session, delete the SandboxClaim and PVC, mark the session deleted. The conversation's stored state\n   * stays: the Postgres adapter can only delete it in a maintenance window (docs/session-api.md).\n   */\n  async #delete(session: SessionRow): Promise<void> {\n    log(\"session-delete-start\", { session: session.id });\n    // Record what the session holds before anything is revoked, then revoke its OneCLI agent first: from that moment\n    // its proxy token is dead, whatever happens to the claim after. A plain session has no OneCLI objects.\n    await writeTombstone(this.#pool, session);\n    await this.#options.repos?.teardown(session);\n    const conversationId = session.conversationId;\n    if (conversationId !== null) {\n      await this.#host.abort(conversationId);\n      this.streams.closeSession(session.id, \"deleted\");\n      await this.#host.destroySandbox(conversationId);\n    }\n    await this.#pool.query(\n      \"update inbox.sessions set status = 'deleted', last_activity_at = clock_timestamp() where id = $1\",\n      [session.id],\n    );\n    await completeTombstone(this.#pool, session.id);<harness>\n[info] 4 more lines in file. Use offset=310 to continue.\n</harness>","isError":false}]}
ENTRY 11430 {"id":11430,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { readFile } from \"node:fs/promises\";\nimport type pg from \"pg\";\nimport { markWorkspaceReady, setOneCliObjects } from \"@pi-durable-k8s/session-core\";\nimport type { SessionRow } from \"@pi-durable-k8s/session-core\";\nimport { loadGithubApp, mintInstallationToken } from \"./github-app.js\";\nimport type { FetchLike } from \"./github-app.js\";\nimport { log } from \"./log.js\";\nimport type { Redacted } from \"./onecli.js\";\nimport { OneCliError } from \"./onecli-admin.js\";\nimport type { OneCliAdmin, OneCliGrant } from \"./onecli-admin.js\";\nimport { buildShellEnv, prepareWorkspace } from \"./workspace.js\";\nimport type { WorkspaceEnv } from \"./workspace.js\";\n\n/** A repo session that cannot be served and never will be without an operator: not configured, repo not installed. */\nexport class RepoUnavailableError extends Error {}\n\n/** Re-mint when the token has less than this left: a command can run for a long while after the check. */\nconst REMINT_BEFORE_MS = 10 * 60 * 1000;\n\nexport interface RepoAccessDeps {\n  pool: Pick<pg.Pool, \"query\">;\n  /** Undefined when `ONECLI_API_KEY` is not set: repo sessions are then refused. */\n  onecli: OneCliAdmin | undefined;\n  /** Directory of the mounted GitHub App secret. */\n  githubAppDir: string;\n  /** Proxy URL of the gateway, without credentials. */\n  gateway: string;\n  /** File holding the OneCLI CA PEM (the mounted ConfigMap). */\n  caFile: string;\n  fetch: FetchLike;\n  now?: () => number;\n  /** Only tests change these. */\n  githubApi?: string;\n  gitBase?: string;\n}\n\ninterface Access {\n  agentId: string;\n  secretIds: string[];\n  /** The agent's `aoc_...` token: the proxy password handed to this session's commands. */\n  proxyToken: Redacted;\n  /** When the GitHub token now stored in the secrets stops working. */\n  expiresAt: number;\n}\n\n/** Names are derived from the session id, so a crash between creating an object and storing its id leaves it findable. */\nexport const agentIdentifier = (sessionId: string): string => `pi-session-${sessionId}`;\nconst SECRET_SUFFIXES = [\n  { suffix: \"git\", host: \"github.com\", header: \"Authorization\", format: \"Basic {value}\" },\n  { suffix: \"api\", host: \"api.github.com\", header: \"Authorization\", format: \"Bearer {value}\" },\n] as const;\nconst secretName = (sessionId: string, suffix: string): string =>\n  `${agentIdentifier(sessionId)}-${suffix}`;\n\n/**\n * Everything a repo session needs from GitHub and OneCLI, kept per session and rebuilt from OneCLI after a restart:\n *\n *  - a OneCLI agent `pi-session-<uuid>` whose only grants are this session's two GitHub secrets;\n *  - those secrets (host `github.com`: `Authorization: Basic base64(\"x-access-token:<token>\")`, host `api.github.com`:\n *    `Bearer <token>`), holding a one-hour installation token for exactly this repository, minted by our own GitHub\n *    App (OneCLI v2 cannot scope a GitHub connection to a repository);\n *  - the token re-minted on every cold `ensure` and before it expires.\n *\n * Plain sessions never reach this class's OneCLI calls: every entry point returns at `session.repo === null`.\n */\nexport class RepoAccess {\n  readonly #deps: RepoAccessDeps;\n  readonly #access = new Map<string, Access>();\n  readonly #byConversation = new Map<number, SessionRow>();\n  readonly #inFlight = new Map<string, Promise<Access>>();\n  readonly #prepared = new Set<string>();\n\n  constructor(deps: RepoAccessDeps) {\n    this.#deps = deps;\n  }\n\n  #now(): number {\n    return this.#deps.now?.() ?? Date.now();\n  }\n\n  /** The `shellEnv` of a repo session's env, provisioning OneCLI first if needed. Undefined for a plain session. */\n  async shellEnv(\n    session: SessionRow,\n    conversationId: number,\n  ): Promise<Record<string, string> | undefined> {\n    if (session.repo === null) return undefined;\n    this.#byConversation.set(conversationId, session);\n    const access = await this.ensureAccess(session);\n    return buildShellEnv({ gateway: this.#deps.gateway, token: access.proxyToken });\n  }\n\n  /** Called before each tool call of an open env: renews a GitHub token that is about to expire. No-op otherwise. */\n  async beforeUse(conversationId: number): Promise<void> {\n    const session = this.#byConversation.get(conversationId);\n    if (session === undefined) return;\n    const access = this.#access.get(session.id);\n    if (access !== undefined && access.expiresAt - this.#now() > REMINT_BEFORE_MS) return;\n    await this.ensureAccess(session);\n  }\n\n  /** Agent, secrets, narrow grants and a fresh token. Serialised per session; warm calls only check the expiry. */\n  ensureAccess(session: SessionRow): Promise<Access> {\n    const running = this.#inFlight.get(session.id);\n    if (running !== undefined) return running;\n    const work = this.#ensure(session).finally(() => this.#inFlight.delete(session.id));\n    this.#inFlight.set(session.id, work);\n    return work;\n  }\n\n  async #ensure(session: SessionRow): Promise<Access> {\n    const { onecli } = this.#deps;\n    if (session.repo === null) throw new Error(\"not a repo session\");\n    if (onecli === undefined) {\n      throw new RepoUnavailableError(\n        \"repository workspaces are not configured: ONECLI_API_KEY is not set\",\n      );\n    }\n    const warm = this.#access.get(session.id);\n    if (warm !== undefined && warm.expiresAt - this.#now() > REMINT_BEFORE_MS) return warm;\n\n    const minted = await this.#mint(session.repo.repo);\n    const gitValue = Buffer.from(`x-access-token:${minted.token.reveal()}`).toString(\"base64\");\n    const valueOf = (suffix: string): string =>\n      suffix === \"git\" ? gitValue : minted.token.reveal();\n\n    const identifier = agentIdentifier(session.id);\n    const findAgent = async () =>\n      (await onecli.listAgents()).find((a) => a.identifier === identifier);\n    let found = await findAgent();\n    const created = found === undefined;\n    if (found === undefined) {\n      await onecli.createAgent(identifier, identifier);\n      found = await findAgent();\n    }\n    if (found === undefined) throw new Error(\"OneCLI created the agent but does not list it\");\n    const agent = found;\n    const existing = new Map((await onecli.listSecrets()).map((s) => [s.name, s.id]));\n    const secretIds: string[] = [];\n    for (const spec of SECRET_SUFFIXES) {\n      const name = secretName(session.id, spec.suffix);\n      let id = existing.get(name);\n      if (id === undefined) {\n        id = await onecli.createSecret({\n          name,\n          value: valueOf(spec.suffix),\n          hostPattern: spec.host,\n          header: spec.header,\n          valueFormat: spec.format,\n        });\n      } else {\n        await onecli.updateSecretValue(id, valueOf(spec.suffix));\n      }\n      secretIds.push(id);\n    }\n\n    try {\n      await this.#narrow(agent.id, secretIds);\n    } catch (error) {\n      // An agent that might hold more than this session's secrets must not outlive the failed attempt.\n      await this.#revoke(session.id, agent.id, secretIds).catch(() => undefined);\n      this.#access.delete(session.id);\n      throw error;\n    }\n\n    const stored = session.onecli;\n    if (stored?.agentId !== agent.id || stored.secretIds.join() !== secretIds.join()) {\n      await setOneCliObjects(this.#deps.pool, session.id, agent.id, secretIds);\n    }\n    const access: Access = {\n      agentId: agent.id,\n      secretIds,\n      proxyToken: agent.accessToken,\n      expiresAt: minted.expiresAt.getTime(),\n    };\n    this.#access.set(session.id, access);\n    log(\"repo-access-ready\", { session: session.id, repo: session.repo.repo, created });\n    return access;\n  }\n\n  async #mint(repo: string): ReturnType<typeof mintInstallationToken> {\n    let app;\n    try {\n      app = await loadGithubApp(this.#deps.githubAppDir);\n    } catch (error) {\n      throw new RepoUnavailableError(\n        error instanceof Error ? error.message : \"GitHub App secret is not available\",\n      );\n    }\n    return mintInstallationToken(app, repo, this.#deps.fetch, this.#now(), this.#deps.githubApi);\n  }\n\n  /**\n   * OneCLI grants every new agent the LLM keys (seen live), so after creating the agent every grant except this\n   * session's own two secrets is removed, then the grant list is read back and must be exactly those two. An answer\n   * that cannot be read counts as a failure: the agent is not used unless it is proven narrow.\n   */\n  async #narrow(agentId: string, secretIds: readonly string[]): Promise<void> {\n    const { onecli } = this.#deps;\n    if (onecli === undefined) throw new Error(\"OneCLI is not configured\");\n    const mine = new Set(secretIds);\n    const have = await onecli.listGrants(agentId);\n    for (const id of mine) {\n      if (!have.some((g) => g.kind === \"secret\" && g.id === id))\n        await onecli.grantSecret(agentId, id);\n    }\n    for (const grant of have) {\n      if (grant.kind === \"secret\" && mine.has(grant.id)) continue;\n      await onecli.revokeGrant(agentId, grant);\n    }\n    const left: OneCliGrant[] = await onecli.listGrants(agentId);\n    const ok =\n      left.length === mine.size && left.every((g) => g.kind === \"secret\" && mine.has(g.id));\n    if (!ok) {\n      throw new Error(\n        `OneCLI agent still holds ${String(left.length)} grants after narrowing; expected only the session's GitHub secrets`,\n      );\n    }\n  }\n\n  /**\n   * Before the first turn of a repo session: provision, then clone through the session's env. Returns quickly once\n   * done in this process; after a restart it runs again, which re-mints the token and finds the clone present.\n   */\n  async prepare(session: SessionRow, env: WorkspaceEnv): Promise<void> {\n    const spec = session.repo;\n    if (spec === null) return;\n    await this.ensureAccess(session);\n    if (this.#prepared.has(session.id)) return;\n    let ca: string;\n    try {\n      ca = await readFile(this.#deps.caFile, \"utf8\");\n    } catch {\n      throw new RepoUnavailableError(`the OneCLI CA is not available at ${this.#deps.caFile}`);\n    }\n    const outcome = await prepareWorkspace(env, spec, {\n      ca,\n      sessionId: session.id,\n      wasReady: session.workspaceReadyAt !== null,\n      ...(this.#deps.gitBase === undefined ? {} : { gitBase: this.#deps.gitBase }),\n    });\n    await markWorkspaceReady(this.#deps.pool, session.id);\n    this.#prepared.add(session.id);\n    // `workspace-cloned` once per session; `workspace-present` after a restart. tests/e2e/run-phase4c.sh greps both.\n    log(outcome === \"cloned\" ? \"workspace-cloned\" : \"workspace-present\", {\n      session: session.id,\n      repo: spec.repo,\n    });\n  }\n\n  /**\n   * Revokes everything the session held in OneCLI: the agent first (its token fails at once), then the secrets.\n   * Looks objects up by name as well as by stored id, so a crash between creating an object and storing its id\n   * cannot leave one behind. Idempotent. A plain session has nothing and makes no OneCLI call.\n   */\n  async teardown(session: SessionRow): Promise<void> {\n    if (session.repo === null) return;\n    const { onecli } = this.#deps;\n    this.#forget(session.id);\n    if (onecli === undefined) {\n      if (session.onecli === null) return;\n      throw new Error(\"cannot revoke the session's OneCLI agent: ONECLI_API_KEY is not set\");\n    }\n    await this.#revoke(session.id, session.onecli?.agentId, session.onecli?.secretIds ?? []);\n    log(\"repo-access-revoked\", { session: session.id });\n  }\n\n  /**\n   * The orphan sweep's revoke: removes whatever OneCLI still holds under this session's names (agent first, then the\n   * secrets), with no session row needed. Nothing is stored for a session that is deleted or unknown.\n   */\n  async revokeSession(sessionId: string): Promise<void> {\n    this.#forget(sessionId);\n    await this.#revoke(sessionId, undefined, []);\n  }\n\n  async #revoke(\n    sessionId: string,\n    agentId: string | undefined,\n    secretIds: readonly string[],\n  ): Promise<void> {\n    const { onecli } = this.#deps;\n    if (onecli === undefined) return;\n    const agents = (await onecli.listAgents())\n      .filter((a) => a.identifier === agentIdentifier(sessionId))\n      .map((a) => a.id);\n    for (const id of new Set([...(agentId === undefined ? [] : [agentId]), ...agents])) {\n      await onecli.deleteAgent(id);\n    }\n    const names = new Set(SECRET_SUFFIXES.map((s) => secretName(sessionId, s.suffix)));\n    const named = (await onecli.listSecrets()).filter((s) => names.has(s.name)).map((s) => s.id);\n    for (const id of new Set([...secretIds, ...named])) {\n      try {\n        await onecli.deleteSecret(id);\n      } catch (error) {\n        if (!(error instanceof OneCliError && error.status === 404)) throw error;\n      }\n    }\n  }\n\n  #forget(sessionId: string): void {\n    this.#access.delete(sessionId);\n    this.#prepared.delete(sessionId);\n    for (const [conversationId, session] of this.#byConversation) {\n      if (session.id === sessionId) this.#byConversation.delete(conversationId);\n    }\n  }\n}\n","isError":false}]}
ENTRY 11431 {"id":11431,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { createPublicKey, createVerify, generateKeyPairSync } from \"node:crypto\";\nimport { mkdtemp, rm, writeFile } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport {\n  GithubDeniedError,\n  loadGithubApp,\n  mintInstallationToken,\n  signAppJwt,\n  TOKEN_PERMISSIONS,\n} from \"../src/github-app.ts\";\nimport type { FetchLike, GithubApp } from \"../src/github-app.ts\";\nimport { Redacted } from \"../src/onecli.ts\";\n\nconst { privateKey, publicKey } = generateKeyPairSync(\"rsa\", {\n  modulusLength: 2048,\n  privateKeyEncoding: { type: \"pkcs8\", format: \"pem\" },\n  publicKeyEncoding: { type: \"spki\", format: \"pem\" },\n});\nconst app: GithubApp = {\n  appId: \"123456\",\n  installationId: \"7890123\",\n  privateKey: new Redacted(privateKey),\n};\nconst NOW = Date.UTC(2026, 10, 15, 12, 0, 0);\n\nconst dirs: string[] = [];\nafterEach(async () => {\n  for (const dir of dirs.splice(0)) await rm(dir, { recursive: true, force: true });\n});\n\ndescribe(\"signAppJwt\", () => {\n  it(\"is an RS256 JWT with the App id as iss, valid under 10 minutes, verifiable with the public key\", () => {\n    const jwt = signAppJwt(app, NOW);\n    const [header, payload, signature] = jwt.split(\".\") as [string, string, string];\n    expect(JSON.parse(Buffer.from(header, \"base64url\").toString())).toEqual({\n      alg: \"RS256\",\n      typ: \"JWT\",\n    });\n    const claims = JSON.parse(Buffer.from(payload, \"base64url\").toString()) as {\n      iss: string;\n      iat: number;\n      exp: number;\n    };\n    expect(claims.iss).toBe(\"123456\");\n    expect(claims.iat).toBe(NOW / 1000 - 60);\n    expect(claims.exp - claims.iat).toBeLessThanOrEqual(10 * 60);\n    expect(claims.exp).toBeGreaterThan(NOW / 1000);\n    const ok = createVerify(\"RSA-SHA256\")\n      .update(`${header}.${payload}`)\n      .verify(createPublicKey(publicKey), Buffer.from(signature, \"base64url\"));\n    expect(ok).toBe(true);\n  });\n});\n\ndescribe(\"loadGithubApp\", () => {\n  it(\"reads the mounted secret files and keeps the key out of string conversion\", async () => {\n    const dir = await mkdtemp(join(tmpdir(), \"gh-app-\"));\n    dirs.push(dir);\n    await writeFile(join(dir, \"app-id\"), \"123456\\n\");\n    await writeFile(join(dir, \"installation-id\"), \"7890123\\n\");\n    await writeFile(join(dir, \"private-key.pem\"), privateKey);\n    const loaded = await loadGithubApp(dir);\n    expect(loaded.appId).toBe(\"123456\");\n    expect(loaded.installationId).toBe(\"7890123\");\n    expect(`${String(loaded.privateKey)} ${JSON.stringify(loaded)}`).not.toContain(\"PRIVATE KEY\");\n  });\n\n  it(\"names the missing file and rejects non-numeric ids\", async () => {\n    const dir = await mkdtemp(join(tmpdir(), \"gh-app-\"));\n    dirs.push(dir);\n    await expect(loadGithubApp(dir)).rejects.toThrow(\n      /app-id, installation-id, private-key\\.pem are missing/,\n    );\n    await writeFile(join(dir, \"app-id\"), \"1\");\n    await writeFile(join(dir, \"installation-id\"), \"1\");\n    await expect(loadGithubApp(dir)).rejects.toThrow(/private-key\\.pem is missing/);\n    await writeFile(join(dir, \"app-id\"), \"not-a-number\");\n    await writeFile(join(dir, \"installation-id\"), \"1\");\n    await writeFile(join(dir, \"private-key.pem\"), \"k\");\n    await expect(loadGithubApp(dir)).rejects.toThrow(/numeric/);\n  });\n});\n\ninterface Sent {\n  url: string;\n  method: string;\n  headers: Record<string, string>;\n  body: Record<string, unknown>;\n}\n\nfunction github(status: number, body: unknown, sent: Sent[] = []): FetchLike {\n  return (url, init) => {\n    sent.push({\n      url,\n      method: init.method,\n      headers: init.headers,\n      body: JSON.parse(init.body ?? \"{}\") as Record<string, unknown>,\n    });\n    return Promise.resolve({\n      status,\n      json: () => Promise.resolve(body),\n      text: () => Promise.resolve(JSON.stringify(body)),\n    });\n  };\n}\n\nconst granted = (full: string) => ({\n  token: \"ghs_secrettokenvalue\",\n  expires_at: \"2026-11-15T13:00:00Z\",\n  repository_selection: \"selected\",\n  repositories: [{ full_name: full }],\n});\n\ndescribe(\"mintInstallationToken\", () => {\n  it(\"asks for one repository and minimal permissions, with the App JWT\", async () => {\n    const sent: Sent[] = [];\n    const minted = await mintInstallationToken(\n      app,\n      \"Octo/Hello\",\n      github(201, granted(\"octo/hello\"), sent),\n      NOW,\n    );\n    expect(sent).toHaveLength(1);\n    expect(sent[0]?.method).toBe(\"POST\");\n    expect(sent[0]?.url).toBe(\"https://api.github.com/app/installations/7890123/access_tokens\");\n    expect(sent[0]?.body).toEqual({\n      repositories: [\"Hello\"],\n      permissions: { contents: \"write\", pull_requests: \"write\", metadata: \"read\" },\n    });\n    expect(TOKEN_PERMISSIONS).toEqual(sent[0]?.body.permissions);\n    expect(sent[0]?.headers.authorization).toMatch(/^Bearer [\\w-]+\\.[\\w-]+\\.[\\w-]+$/);\n    expect(minted.token.reveal()).toBe(\"ghs_secrettokenvalue\");\n    expect(minted.expiresAt.toISOString()).toBe(\"2026-11-15T13:00:00.000Z\");\n    expect(JSON.stringify(minted)).not.toContain(\"ghs_\");\n  });\n\n  it(\"refuses a token that covers another repository or more than one\", async () => {\n    await expect(\n      mintInstallationToken(app, \"octo/hello\", github(201, granted(\"someone-else/hello\")), NOW),\n    ).rejects.toBeInstanceOf(GithubDeniedError);\n    const wide = {\n      ...granted(\"octo/hello\"),\n      repositories: [{ full_name: \"octo/hello\" }, { full_name: \"octo/b\" }],\n    };\n    await expect(mintInstallationToken(app, \"octo/hello\", github(201, wide), NOW)).rejects.toThrow(\n      /exactly that repository/,\n    );\n    const none = { ...granted(\"octo/hello\"), repositories: undefined };\n    await expect(mintInstallationToken(app, \"octo/hello\", github(201, none), NOW)).rejects.toThrow(\n      /0 repositories/,\n    );\n  });\n\n  it(\"classifies answers: 404 and 422 are final, 5xx can be retried, and no message holds a secret\", async () => {\n    for (const status of [401, 403, 404, 422]) {\n      await expect(\n        mintInstallationToken(app, \"octo/hello\", github(status, { message: \"Not Found\" }), NOW),\n      ).rejects.toBeInstanceOf(GithubDeniedError);\n    }\n    const error = await mintInstallationToken(\n      app,\n      \"octo/hello\",\n      github(502, { message: \"bad gateway\" }),\n      NOW,\n    ).catch((e: unknown) => e as Error);\n    expect(error).toBeInstanceOf(Error);\n    expect(error).not.toBeInstanceOf(GithubDeniedError);\n    expect((error as Error).message).not.toContain(\"PRIVATE KEY\");\n  });\n});\n","isError":false}]}
ENTRY 11473 {"id":11473,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && nl -ba packages/orchestrator/src/github-app.ts | sed -n '34,132p'; grep -R -n 'rate limit\\\\|rate-limit' packages/orchestrator/src | head\"})"]}]}
ENTRY 11484 {"id":11484,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"    34\t/**\n    35\t * An RS256 JWT for the GitHub App: `iss` is the App id, issued 60 s in the past to absorb clock skew and valid for\n    36\t * 9 minutes (GitHub allows at most 10). It only authenticates the call that mints an installation token.\n    37\t */\n    38\texport function signAppJwt(app: GithubApp, nowMs: number): string {\n    39\t  const now = Math.floor(nowMs / 1000);\n    40\t  const unsigned = `${b64url(JSON.stringify({ alg: \"RS256\", typ: \"JWT\" }))}.${b64url(\n    41\t    JSON.stringify({ iat: now - 60, exp: now + 9 * 60, iss: app.appId }),\n    42\t  )}`;\n    43\t  const signature = createSign(\"RSA-SHA256\").update(unsigned).sign(app.privateKey.reveal());\n    44\t  return `${unsigned}.${b64url(signature)}`;\n    45\t}\n    46\t\n    47\t/** Reads the mounted App secret. Read at every mint, so a rotated key needs no restart. Never logged. */\n    48\texport async function loadGithubApp(dir: string): Promise<GithubApp> {\n    49\t  const names = [\"app-id\", \"installation-id\", \"private-key.pem\"] as const;\n    50\t  // allSettled, not all: the error must name every missing file in a fixed order, not whichever read failed first.\n    51\t  const results = await Promise.allSettled(\n    52\t    names.map(async (name) => (await readFile(join(dir, name), \"utf8\")).trim()),\n    53\t  );\n    54\t  const missing = names.filter((_, i) => results[i]?.status === \"rejected\");\n    55\t  if (missing.length > 0) {\n    56\t    const verb = missing.length === 1 ? \"is\" : \"are\";\n    57\t    throw new Error(\n    58\t      `GitHub App secret is not available: ${missing.join(\", \")} ${verb} missing in ${dir}`,\n    59\t    );\n    60\t  }\n    61\t  const [appId = \"\", installationId = \"\", privateKey = \"\"] = results.map((r) =>\n    62\t    r.status === \"fulfilled\" ? r.value : \"\",\n    63\t  );\n    64\t  if (!/^\\d+$/.test(appId) || !/^\\d+$/.test(installationId)) {\n    65\t    throw new Error(\"GitHub App app-id and installation-id must be numeric\");\n    66\t  }\n    67\t  return { appId, installationId, privateKey: new Redacted(privateKey) };\n    68\t}\n    69\t\n    70\t/** A GitHub answer that no retry will fix: the repository is not in the installation, or the App lacks a permission. */\n    71\texport class GithubDeniedError extends Error {}\n    72\t\n    73\t/**\n    74\t * Mints a one-hour installation token limited to one repository by GitHub itself (`repositories: [name]`) and to\n    75\t * `TOKEN_PERMISSIONS`. OneCLI v2 cannot scope by repository, so this is the only scope boundary. The answer is\n    76\t * checked: the token must name exactly the requested repository, or it is thrown away.\n    77\t */\n    78\texport async function mintInstallationToken(\n    79\t  app: GithubApp,\n    80\t  repo: string,\n    81\t  fetchImpl: FetchLike,\n    82\t  nowMs: number,\n    83\t  apiBase = \"https://api.github.com\",\n    84\t): Promise<InstallationToken> {\n    85\t  const name = repo.split(\"/\")[1] ?? \"\";\n    86\t  const response = await fetchImpl(\n    87\t    `${apiBase}/app/installations/${encodeURIComponent(app.installationId)}/access_tokens`,\n    88\t    {\n    89\t      method: \"POST\",\n    90\t      headers: {\n    91\t        authorization: `Bearer ${signAppJwt(app, nowMs)}`,\n    92\t        accept: \"application/vnd.github+json\",\n    93\t        \"x-github-api-version\": \"2022-11-28\",\n    94\t        \"user-agent\": \"pi-durable-k8s\",\n    95\t        \"content-type\": \"application/json\",\n    96\t      },\n    97\t      body: JSON.stringify({ repositories: [name], permissions: TOKEN_PERMISSIONS }),\n    98\t    },\n    99\t  );\n   100\t  if (response.status !== 201) {\n   101\t    // The body of an error is GitHub's message, never a secret; the request carried none that it would echo.\n   102\t    const detail = (await response.text().catch(() => \"\")).slice(0, 200);\n   103\t    const message = `GitHub refused the installation token for ${repo}: HTTP ${String(response.status)} ${detail}`;\n   104\t    if (\n   105\t      response.status === 401 ||\n   106\t      response.status === 403 ||\n   107\t      response.status === 404 ||\n   108\t      response.status === 422\n   109\t    ) {\n   110\t      throw new GithubDeniedError(message);\n   111\t    }\n   112\t    throw new Error(message);\n   113\t  }\n   114\t  const body = (await response.json()) as {\n   115\t    token?: unknown;\n   116\t    expires_at?: unknown;\n   117\t    repository_selection?: unknown;\n   118\t    repositories?: { full_name?: unknown }[];\n   119\t  };\n   120\t  if (typeof body.token !== \"string\" || typeof body.expires_at !== \"string\") {\n   121\t    throw new Error(\"GitHub answered without a token\");\n   122\t  }\n   123\t  const granted = (body.repositories ?? []).map((entry) => String(entry.full_name).toLowerCase());\n   124\t  if (granted.length !== 1 || granted[0] !== repo.toLowerCase()) {\n   125\t    // A token wider than asked, or for another owner's same-named repository: never hand it to a session.\n   126\t    throw new GithubDeniedError(\n   127\t      `GitHub token for ${repo} does not cover exactly that repository (${String(granted.length)} repositories granted)`,\n   128\t    );\n   129\t  }\n   130\t  return { token: new Redacted(body.token), expiresAt: new Date(body.expires_at) };\n   131\t}\npackages/orchestrator/src/failure.ts:21: *    retrying only repeats paid or rate-limited calls. (pi-ai does not retry these statuses either.)\n","isError":false}]}
ENTRY 11516 {"id":11516,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n\n### 1. GitHub rate limiting can permanently fail a session\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/github-app.ts:104\n- What happens: GitHub can return HTTP 403 for a temporary rate limit, but the minting code classifies every 403 as a permanent access denial. During repository preparation, the caller then fails the session instead of retrying after the limit resets.\n- Evidence: `response.status === 403` leads to `throw new GithubDeniedError(message)`.\n- Fix idea: Distinguish rate-limit responses using GitHub’s response headers and message, and treat them as retryable. Expose the necessary headers through `FetchLike`.\n\nEND-OF-REPORT"}]}
DONE
