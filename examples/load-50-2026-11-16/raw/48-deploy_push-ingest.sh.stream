ENTRY 12216 {"id":12216,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\t#!/usr/bin/env bash\n     2\t# Bundle ingest (with its workspace dependency session-core) into ConfigMap `ingest-code`, which the\n     3\t# pi-ingest Deployment unpacks in an initContainer. No image is built or pushed. Restarts the pods when the\n     4\t# bundle changed. Usage: deploy/push-ingest.sh\n     5\tset -euo pipefail\n     6\t\n     7\tctx=${KUBE_CONTEXT:-}\n     8\tns=${NAMESPACE:-pi-durable-poc}\n     9\there=$(cd \"$(dirname \"$0\")\" && pwd)\n    10\troot=$(cd \"$here/..\" && pwd)\n    11\twork=$(mktemp -d)\n    12\tk() { kubectl ${ctx:+--context=\"$ctx\"} -n \"$ns\" \"$@\"; }\n    13\ttrap 'rm -rf \"$work\"' EXIT\n    14\t\n    15\t(cd \"$root\" && pnpm install --frozen-lockfile >/dev/null && pnpm --filter @pi-durable-k8s/session-core --filter @pi-durable-k8s/ingest build >/dev/null)\n    16\t(cd \"$root\" && pnpm --filter @pi-durable-k8s/ingest deploy --prod \"$work/app\" >/dev/null)\n    17\tCOPYFILE_DISABLE=1 tar --no-xattrs -czf \"$work/app.tgz\" -C \"$work/app\" .\n    18\tsize=$(wc -c <\"$work/app.tgz\" | tr -d ' ')\n    19\tif [[ $size -gt 900000 ]]; then\n    20\t  echo \"ingest bundle is $size bytes; a ConfigMap holds 1 MiB. Switch to a code PVC (see deploy/ingest.yaml).\" >&2\n    21\t  exit 1\n    22\tfi\n    23\t\n    24\tsum=$(shasum -a 256 \"$work/app.tgz\" | awk '{print $1}')\n    25\tcurrent=$(k get configmap ingest-code -o jsonpath='{.metadata.annotations.bundle-sha256}' 2>/dev/null || true)\n    26\tif [[ $current == \"$sum\" ]]; then\n    27\t  echo \"ingest bundle unchanged\"\n    28\t  exit 0\n    29\tfi\n    30\tk create configmap ingest-code --from-file=app.tgz=\"$work/app.tgz\" --dry-run=client -o yaml |\n    31\t  k annotate --local -f - \"bundle-sha256=$sum\" -o yaml | k apply -f - >/dev/null\n    32\tif k get deployment pi-ingest >/dev/null 2>&1; then\n    33\t  k rollout restart deployment/pi-ingest >/dev/null\n    34\tfi\n    35\techo \"ingest bundle pushed ($size bytes)\"\n","isError":false}]}
