ENTRY 12224 {"id":12224,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\t# ingest: the stateless HTTP front of the session API. Two replicas, any node, no volume.\n     2\t# Code delivery: an initContainer unpacks the bundle in ConfigMap `ingest-code` (deploy/push-ingest.sh builds it,\n     3\t# about 140 KB, limit 1 MiB) into an emptyDir. Chosen over a code PVC because a ReadWriteOnce volume cannot be\n     4\t# shared across nodes, which would pin both replicas to one node; the ConfigMap needs no pinning and a rollout\n     5\t# is \"replace the ConfigMap, restart\". No image is pushed.\n     6\t# Ingest never talks to the orchestrator except to proxy a stream, so it keeps accepting events while the\n     7\t# orchestrator restarts. Its readiness depends on the database only.\n     8\tapiVersion: apps/v1\n     9\tkind: Deployment\n    10\tmetadata:\n    11\t  name: pi-ingest\n    12\t  labels:\n    13\t    app.kubernetes.io/name: pi-ingest\n    14\tspec:\n    15\t  replicas: 2\n    16\t  strategy:\n    17\t    type: RollingUpdate\n    18\t    rollingUpdate: { maxUnavailable: 1, maxSurge: 1 }\n    19\t  selector:\n    20\t    matchLabels:\n    21\t      app.kubernetes.io/name: pi-ingest\n    22\t  template:\n    23\t    metadata:\n    24\t      labels:\n    25\t        app.kubernetes.io/name: pi-ingest\n    26\t    spec:\n    27\t      automountServiceAccountToken: false\n    28\t      securityContext:\n    29\t        runAsNonRoot: true\n    30\t        runAsUser: 1000\n    31\t        runAsGroup: 1000\n    32\t        fsGroup: 1000\n    33\t        seccompProfile:\n    34\t          type: RuntimeDefault\n    35\t      affinity:\n    36\t        podAntiAffinity:\n    37\t          preferredDuringSchedulingIgnoredDuringExecution:\n    38\t            - weight: 100\n    39\t              podAffinityTerm:\n    40\t                topologyKey: kubernetes.io/hostname\n    41\t                labelSelector:\n    42\t                  matchLabels:\n    43\t                    app.kubernetes.io/name: pi-ingest\n    44\t      initContainers:\n    45\t        - name: unpack\n    46\t          image: node:22-bookworm-slim\n    47\t          command: [sh, -c, \"mkdir -p /app/code && tar xzmf /bundle/app.tgz -C /app/code && test -f /app/code/dist/main.js\"]\n    48\t          resources:\n    49\t            requests: { cpu: 10m, memory: 32Mi }\n    50\t            limits: { cpu: 100m, memory: 64Mi }\n    51\t          securityContext:\n    52\t            allowPrivilegeEscalation: false\n    53\t            capabilities:\n    54\t              drop: [ALL]\n    55\t          volumeMounts:\n    56\t            - { name: bundle, mountPath: /bundle, readOnly: true }\n    57\t            - { name: app, mountPath: /app }\n    58\t      containers:\n    59\t        - name: ingest\n    60\t          image: node:22-bookworm-slim\n    61\t          workingDir: /app/code\n    62\t          command: [node, dist/main.js]\n    63\t          # The default model and allowlist POST /sessions is checked against (the orchestrator reads the same).\n    64\t          envFrom:\n    65\t            - configMapRef: { name: pi-model-config }\n    66\t          env:\n    67\t            - { name: HOME, value: /tmp }\n    68\t            - { name: PI_INGEST_PORT, value: \"8080\" }\n    69\t            - { name: PI_ORCH_URL, value: \"http://pi-orchestrator:8081\" }\n    70\t            - name: POD_NAME\n    71\t              valueFrom: { fieldRef: { fieldPath: metadata.name } }\n    72\t            # The CNPG -rw service, straight: no transaction-pooled proxy.\n    73\t            - name: PI_DURABLE_DATABASE_URL\n    74\t              valueFrom: { secretKeyRef: { name: pi-pg-app, key: uri } }\n    75\t            - name: PI_API_TOKENS\n    76\t              valueFrom: { secretKeyRef: { name: api-auth, key: tokens } }\n    77\t          ports:\n    78\t            - { name: http, containerPort: 8080 }\n    79\t          readinessProbe:\n    80\t            httpGet: { path: /readyz, port: http }\n    81\t            periodSeconds: 5\n    82\t          livenessProbe:\n    83\t            httpGet: { path: /healthz, port: http }\n    84\t            periodSeconds: 10\n    85\t            failureThreshold: 6\n    86\t          resources:\n    87\t            requests: { cpu: 50m, memory: 128Mi }\n    88\t            limits: { cpu: 250m, memory: 256Mi }\n    89\t          securityContext:\n    90\t            allowPrivilegeEscalation: false\n    91\t            readOnlyRootFilesystem: true\n    92\t            capabilities:\n    93\t              drop: [ALL]\n    94\t          volumeMounts:\n    95\t            - { name: app, mountPath: /app, readOnly: true }\n    96\t            - { name: tmp, mountPath: /tmp }\n    97\t      volumes:\n    98\t        - name: bundle\n    99\t          configMap: { name: ingest-code }\n   100\t        - name: app\n   101\t          emptyDir: {}\n   102\t        - name: tmp\n   103\t          emptyDir: {}\n   104\t---\n   105\tapiVersion: v1\n   106\tkind: Service\n   107\tmetadata:\n   108\t  name: pi-ingest\n   109\tspec:\n   110\t  selector:\n   111\t    app.kubernetes.io/name: pi-ingest\n   112\t  ports:\n   113\t    - { name: http, port: 8080, targetPort: http }\n/bin/bash: line 1: rg: command not found\n","isError":false}]}
