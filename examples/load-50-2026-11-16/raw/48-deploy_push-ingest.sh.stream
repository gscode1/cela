ENTRY 12234 {"id":12234,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"{\n  \"name\": \"pi-durable-k8s\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"packageManager\": \"pnpm@12.21.0\",\n  \"engines\": {\n    \"node\": \">=22.19.0\"\n  },\n  \"scripts\": {\n    \"lint\": \"eslint .\",\n    \"format\": \"prettier --write .\",\n    \"format:check\": \"prettier --check .\",\n    \"build\": \"pnpm -r run build\",\n    \"typecheck\": \"pnpm build && pnpm -r run typecheck\",\n    \"test\": \"pnpm build && pnpm -r run test\",\n    \"check\": \"pnpm build && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test\"\n  },\n  \"devDependencies\": {\n    \"@eslint/js\": \"10.0.1\",\n    \"eslint\": \"10.15.0\",\n    \"prettier\": \"3.10.1\",\n    \"typescript\": \"6.0.3\",\n    \"typescript-eslint\": \"8.72.2\"\n  },\n  \"license\": \"MIT\"\n}\npackages:\n  - packages/*\n  - packages/vendor/*\n# Their install scripts only check versions or print notices; not needed.\nallowBuilds:\n  protobufjs: false\n  \"@google/genai\": false\n\n# The e2e bundle is installed here and run in an arm64 Linux pod, so keep those native bindings too.\nsupportedArchitectures:\n  os: [current, linux]\n  cpu: [current, arm64]\n  libc: [current, glibc]\n{\n  \"name\": \"@pi-durable-k8s/ingest\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"description\": \"Stateless HTTP front of the session API: authenticates, writes events to the Postgres inbox, proxies the event stream to the orchestrator.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.19.0\"\n  },\n  \"scripts\": {\n    \"build\": \"rm -rf dist && tsc -p tsconfig.build.json\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@pi-durable-k8s/session-core\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"22.20.5\",\n    \"@types/pg\": \"8.23.1\",\n    \"typescript\": \"7.0.2\",\n    \"vitest\": \"5.1.0\"\n  }\n}\ndeploy/ingest.yaml:2:# Code delivery: an initContainer unpacks the bundle in ConfigMap `ingest-code` (deploy/push-ingest.sh builds it,\ndeploy/ingest.yaml:99:          configMap: { name: ingest-code }\ndeploy/push-ingest.sh:2:# Bundle ingest (with its workspace dependency session-core) into ConfigMap `ingest-code`, which the\ndeploy/push-ingest.sh:4:# bundle changed. Usage: deploy/push-ingest.sh\ndeploy/push-ingest.sh:25:current=$(k get configmap ingest-code -o jsonpath='{.metadata.annotations.bundle-sha256}' 2>/dev/null || true)\ndeploy/push-ingest.sh:30:k create configmap ingest-code --from-file=app.tgz=\"$work/app.tgz\" --dry-run=client -o yaml |\ndeploy/kustomization.yaml:23:# deploy/gen-api-secret.sh. ConfigMap `ingest-code` is filled by deploy/push-ingest.sh.\ncilium\nfetch-onecli-ca.sh\ngen-api-secret.sh\ngen-secret.sh\ningest.yaml\nkustomization.yaml\nmodel-config.yaml\nnamespace.yaml\nnetworkpolicy-e2e.yaml\nnetworkpolicy-ingest.yaml\nnetworkpolicy-orchestrator.yaml\nnetworkpolicy-postgres.yaml\nnetworkpolicy.yaml\nonecli-externalsecret.yaml\nonecli-host-rules.sh\nonecli-policies\norchestrator-code-pvc.yaml\norchestrator-rbac.yaml\norchestrator-service.yaml\norchestrator.yaml\npostgres.yaml\npush-code.sh\npush-ingest.sh\nrepo-externalsecrets.yaml\nsandbox-template.yaml\nsandbox-warmpool.yaml\ningest\norchestrator\nsandbox-env\nsession-core\nvendor\n","isError":false}]}
