ENTRY 11570 {"id":11570,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"    if (error instanceof BodyError) {\n      sendJson(res, 400, { error: error.message });\n      return;\n    }\n    throw error;\n  }\n  const model = chooseModel(deps.models, body);\n  if (typeof model === \"string\") {\n    sendJson(res, 400, { error: model });\n    return;\n  }\n  const repo = chooseRepo(body);\n  if (typeof repo === \"string\") {\n    sendJson(res, 400, { error: repo });\n    return;\n  }\n  const sessionId = await createSession(deps.pool, principal, model, repo);\n  sendJson(res, 201, {\n    sessionId,\n    provider: model.provider,\n    model: model.model,\n    ...(model.reasoning === undefined ? {} : { reasoning: model.reasoning }),\n    ...(repo === undefined\n      ? {}\n      : { repo: repo.repo, ...(repo.branch === undefined ? {} : { branch: repo.branch }) }),\n  });\n}\n\nasync function ownedSession(\n  pool: pg.Pool,\n  id: string,\n  principal: Principal,\n): Promise<SessionRow | undefined> {\n  if (!UUID.test(id)) return undefined;\n  const session = await getSession(pool, id);\n  return session?.ownerSubject === principal.subject ? session : undefined;\n}\n\nasync function postEvent(\n  req: IncomingMessage,\n  res: ServerResponse,\n  pool: pg.Pool,\n  session: SessionRow,\n  principal: Principal,\n): Promise<void> {\n  let parsed;\n  try {\n    parsed = parseEventBody(await readJsonObject(req));\n  } catch (error) {\n    if (error instanceof BodyError) {\n      sendJson(res, 400, { error: error.message });\n      return;\n    }\n    throw error;\n  }\n  if (typeof parsed === \"string\") {\n    sendJson(res, 400, { error: parsed });\n    return;\n  }\n  if (session.status !== \"active\") {\n    sendJson(res, session.status === \"deleted\" ? 410 : 409, {\n      error: `session is ${session.status}`,\n    });\n    return;\n  }\n  const result = await enqueueEvent(\n    pool,\n    {\n      sessionId: session.id,\n      source: `api:${principal.owner}`,\n      sourceEventId: parsed.sourceEventId,\n      kind: parsed.kind,\n      payload: parsed.payload,\n    },\n    { requireActive: true },\n  );\n  if (result.outcome === \"inactive\") {\n    // The session was deleted or failed after the check above (the body is read in between).\n    sendJson(res, result.status === \"deleted\" ? 410 : 409, {\n      error: `session is ${result.status}`,\n    });\n    return;\n  }\n  if (result.outcome === \"conflict\") {\n    sendJson(res, 409, { error: \"sourceEventId was already used for another session\" });\n    return;\n  }\n  // 202 either way: a repeated post is accepted and names the first event.\n  sendJson(res, 202, { eventId: result.eventId, duplicate: result.outcome === \"duplicate\" });\n}\n\nasync function queueDelete(pool: pg.Pool, session: SessionRow, res: ServerResponse): Promise<void> {\n  if (session.status === \"deleted\") {\n    sendJson(res, 202, { sessionId: session.id, status: \"deleted\" });\n    return;\n  }\n  /** The (source, source_event_id) belongs to another session. */\n  | { outcome: \"conflict\" }\n  /** `requireActive` was set and the session is not active (any more): nothing was written. */\n  | { outcome: \"inactive\"; status: SessionStatus };\n\n/**\n * Writes one event and returns. The unique index on (source, source_event_id) makes a repeated post a no-op that\n * returns the first event's id. The orchestrator is not involved: this works while it is down.\n */\nexport async function enqueueEvent(\n  pool: pg.Pool,\n  event: {\n    sessionId: string;\n    source: string;\n    sourceEventId: string;\n    kind: EventKind;\n    payload: InboxEvent[\"payload\"];\n  },\n  options: { requireActive?: boolean } = {},\n): Promise<EnqueueResult> {\n  // With requireActive the status test and the insert are one statement: a caller that read the session earlier\n  // (ingest does, before it reads the request body) cannot get an event accepted for a session that was deleted\n  // meanwhile. `for share` makes the insert wait for a concurrent status change to commit and then see it, and\n  // makes a concurrent DELETE wait for this insert, so an accepted event always precedes the delete row.\n  const columns = \"(session_id, source, source_event_id, kind, payload)\";\n  const inserted = await pool.query<{ id: string }>(\n    `insert into inbox.events ${columns}\n     ${\n       options.requireActive === true\n         ? `select s.id, $2, $3, $4, $5::jsonb from inbox.sessions s where s.id = $1 and s.status = 'active' for share of s`\n         : `values ($1, $2, $3, $4, $5)`\n     }\n     on conflict (source, source_event_id) do nothing\n     returning id`,\n    [event.sessionId, event.source, event.sourceEventId, event.kind, JSON.stringify(event.payload)],\n  );\n  const fresh = inserted.rows[0];\n  if (fresh !== undefined) {\n    await pool.query(\n      \"update inbox.sessions set last_activity_at = clock_timestamp() where id = $1\",\n      [event.sessionId],\n    );\n    return { outcome: \"accepted\", eventId: fresh.id };\n  }\n  const { rows } = await pool.query<{ id: string; session_id: string }>(\n    \"select id, session_id from inbox.events where source = $1 and source_event_id = $2\",\n    [event.source, event.sourceEventId],\n  );\n  const existing = rows[0];\n  if (existing === undefined && options.requireActive === true) {\n    const current = await pool.query<{ status: SessionStatus }>(\n      \"select status from inbox.sessions where id = $1\",\n      [event.sessionId],\n    );\n    return { outcome: \"inactive\", status: current.rows[0]?.status ?? \"deleted\" };\n  }\n  if (existing === undefined || existing.session_id !== event.sessionId) {\n    return { outcome: \"conflict\" };\n  }\n  return { outcome: \"duplicate\", eventId: existing.id };\n}\n\n/**\n * The dedup key of a session's delete row. Client events use `source = api:<owner>` with a client-chosen id, so the\n * server's own row lives in a source no client can write: a client id such as `delete:<id>` can then never\n * occupy the key and make DELETE a no-op. (Delete rows written before this carry `api:<owner>` / `delete:<id>`;\npackages/session-core/migrations/001_inbox.sql:25:  source_event_id text not null,\npackages/session-core/migrations/001_inbox.sql:35:-- Deduplication: the same (source, source_event_id) is one event, however often it is posted.\npackages/session-core/migrations/001_inbox.sql:36:create unique index if not exists events_source_dedup on inbox.events (source, source_event_id);\npackages/session-core/src/index.ts:4:export { BodyError, errorMessage, readJsonObject, sendJson, UUID } from \"./http.js\";\npackages/session-core/src/store.ts:72:  source_event_id: string;\npackages/session-core/src/store.ts:119:  sourceEventId: row.source_event_id,\npackages/session-core/src/store.ts:178:  /** The same (source, source_event_id) was already stored: nothing new was written. */\npackages/session-core/src/store.ts:180:  /** The (source, source_event_id) belongs to another session. */\npackages/session-core/src/store.ts:186: * Writes one event and returns. The unique index on (source, source_event_id) makes a repeated post a no-op that\npackages/session-core/src/store.ts:204:  const columns = \"(session_id, source, source_event_id, kind, payload)\";\npackages/session-core/src/store.ts:212:     on conflict (source, source_event_id) do nothing\npackages/session-core/src/store.ts:225:    \"select id, session_id from inbox.events where source = $1 and source_event_id = $2\",\npackages/session-core/src/http.ts:16:export async function readJsonObject(\npackages/ingest/test/fake-db.ts:16: * (source, source_event_id) like the unique index, so tests can see which rows exist.\npackages/ingest/src/server.ts:14:  readJsonObject,\npackages/ingest/src/server.ts:148:    body = await readJsonObject(req);\npackages/ingest/src/server.ts:197:    parsed = parseEventBody(await readJsonObject(req));\npackages/orchestrator/test/inbox.test.ts:19:      source_event_id: id,\n","isError":false}]}
