ENTRY 11596 {"id":11596,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import type { IncomingMessage, ServerResponse } from \"node:http\";\n\nexport function sendJson(\n  res: ServerResponse,\n  status: number,\n  body: unknown,\n  headers: Record<string, string> = {},\n): void {\n  res.writeHead(status, { \"content-type\": \"application/json\", ...headers });\n  res.end(JSON.stringify(body));\n}\n\nexport class BodyError extends Error {}\n\n/** Reads a JSON object body, at most `limit` bytes. Throws BodyError for anything a client got wrong. */\nexport async function readJsonObject(\n  req: IncomingMessage,\n  limit = 128 * 1024,\n): Promise<Record<string, unknown>> {\n  const chunks: Buffer[] = [];\n  let size = 0;\n  for await (const chunk of req) {\n    const buffer = chunk as Buffer;\n    size += buffer.length;\n    if (size > limit) throw new BodyError(\"body too large\");\n    chunks.push(buffer);\n  }\n  const text = Buffer.concat(chunks).toString(\"utf8\");\n  if (text.trim() === \"\") return {};\n  let parsed: unknown;\n  try {\n    parsed = JSON.parse(text);\n  } catch {\n    throw new BodyError(\"body is not valid JSON\");\n  }\n  if (typeof parsed !== \"object\" || parsed === null || Array.isArray(parsed)) {\n    throw new BodyError(\"body must be a JSON object\");\n  }\n  return parsed as Record<string, unknown>;\n}\n\nexport const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;\n\nexport function errorMessage(error: unknown): string {\n  return error instanceof Error ? error.message : String(error);\n}\n39-\n40-export function createIngestServer(deps: IngestDeps): Server {\n41-  return createServer((req, res) => {\n42:    void handle(req, res, deps).catch((error: unknown) => {\n43-      log(\"http-error\", { message: errorMessage(error) });\n44:      if (!res.headersSent) sendJson(res, 500, { error: \"internal error\" });\n45-      else res.destroy();\n46-    });\n47-  });\n--\n66-    try {\n67-      await deps.pool.query(\"select 1\");\n68-      sendJson(res, 200, { status: \"ready\" });\n69:    } catch {\n70-      sendJson(res, 503, { status: \"database unavailable\" });\n71-    }\n72-    return;\n--\n146-  let body: Record<string, unknown>;\n147-  try {\n148-    body = await readJsonObject(req);\n149:  } catch (error) {\n150-    if (error instanceof BodyError) {\n151-      sendJson(res, 400, { error: error.message });\n152-      return;\n--\n195-  let parsed;\n196-  try {\n197-    parsed = parseEventBody(await readJsonObject(req));\n198:  } catch (error) {\n199-    if (error instanceof BodyError) {\n200-      sendJson(res, 400, { error: error.message });\n201-      return;\n     1\timport { randomUUID } from \"node:crypto\";\n     2\timport type { EventKind } from \"@pi-durable-k8s/session-core\";\n     3\t\n     4\tconst MAX_TEXT = 64 * 1024;\n     5\tconst MAX_SOURCE_EVENT_ID = 200;\n     6\t\n     7\texport interface ParsedEvent {\n     8\t  kind: Exclude<EventKind, \"delete\">;\n     9\t  payload: { text?: string };\n    10\t  sourceEventId: string;\n    11\t}\n    12\t\n    13\t/** Validates the body of POST /sessions/{id}/events. Returns an error string for the 400 response. */\n    14\texport function parseEventBody(body: Record<string, unknown>): ParsedEvent | string {\n    15\t  const { kind, text, sourceEventId } = body;\n    16\t  if (kind === \"delete\") return \"use DELETE /sessions/{id} to delete a session\";\n    17\t  if (kind !== \"message\" && kind !== \"steer\" && kind !== \"cancel\") {\n    18\t    return \"kind must be message, steer or cancel\";\n    19\t  }\n    20\t  if (kind !== \"cancel\") {\n    21\t    if (typeof text !== \"string\" || text.trim() === \"\") return `${kind} needs a non-empty text`;\n    22\t    if (text.length > MAX_TEXT) return `text is longer than ${String(MAX_TEXT)} characters`;\n    23\t  } else if (text !== undefined) {\n    24\t    return \"cancel takes no text\";\n    25\t  }\n    26\t  if (sourceEventId !== undefined) {\n    27\t    if (\n    28\t      typeof sourceEventId !== \"string\" ||\n    29\t      sourceEventId === \"\" ||\n    30\t      sourceEventId.length > MAX_SOURCE_EVENT_ID\n    31\t    ) {\n    32\t      return `sourceEventId must be a string of 1 to ${String(MAX_SOURCE_EVENT_ID)} characters`;\n    33\t    }\n    34\t  }\n    35\t  return {\n    36\t    kind,\n    37\t    payload: typeof text === \"string\" ? { text } : {},\n    38\t    // Without a client-supplied id every post is its own event: there is nothing to deduplicate on.\n    39\t    sourceEventId: typeof sourceEventId === \"string\" ? sourceEventId : `auto-${randomUUID()}`,\n    40\t  };\n    41\t}\n-- Inbox schema of the session API. Own schema, separate from the Pi Durable storage schema (`durable`).\n-- Idempotent: ingest and the orchestrator both apply it at start (under an advisory lock, see migrate.ts).\n\ncreate schema if not exists inbox;\n\n-- One row per API session. `conversation_id` is the Pi Durable conversation, set by the orchestrator when it\n-- creates the conversation (lazily, on the first event or stream). One session = one conversation = one\n-- SandboxClaim (`pi-conv-<conversation_id>`) = one PVC.\ncreate table if not exists inbox.sessions (\n  id               uuid primary key,\n  owner            text not null,\n  status           text not null default 'active' check (status in ('active', 'deleting', 'deleted')),\n  conversation_id  bigint,\n  created_at       timestamptz not null default clock_timestamp(),\n  last_activity_at timestamptz not null default clock_timestamp()\n);\n\n-- The owner check compares the caller's subject (static tokens: `static:<owner>`, OIDC: iss + sub), not the name.\nalter table inbox.sessions add column if not exists owner_subject text;\n\ncreate table if not exists inbox.events (\n  id              bigint generated always as identity primary key,\n  session_id      uuid not null references inbox.sessions (id),\n  source          text not null,\n  source_event_id text not null,\n  kind            text not null check (kind in ('message', 'steer', 'cancel', 'delete')),\n  payload         jsonb not null default '{}',\n  status          text not null default 'pending' check (status in ('pending', 'submitted', 'failed')),\n  attempts        integer not null default 0,\n  created_at      timestamptz not null default clock_timestamp(),\n  submitted_at    timestamptz,\n  error           text\n);\n\n-- Deduplication: the same (source, source_event_id) is one event, however often it is posted.\ncreate unique index if not exists events_source_dedup on inbox.events (source, source_event_id);\n-- The orchestrator's claim query: pending rows of one session in arrival order.\ncreate index if not exists events_pending_by_session\n  on inbox.events (session_id, created_at, id) where status = 'pending';\ncreate index if not exists events_pending_any on inbox.events (created_at, id) where status = 'pending';\n\n-- Wakes the orchestrator's LISTEN so a new event does not wait for the poll interval.\ncreate or replace function inbox.notify_event() returns trigger language plpgsql as $$\nbegin\n  perform pg_notify('inbox_events', new.session_id::text);\n","isError":false}]}
ENTRY 11628 {"id":11628,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n\n### 1. Accepted strings can cause database errors\n- Severity: low\n- Confidence: high\n- Location: packages/ingest/src/events.ts:21\n- What happens: A message containing a NUL character, such as `{\"kind\":\"message\",\"text\":\"hello\\u0000world\"}`, passes validation but PostgreSQL rejects it when the payload is inserted as JSONB. The request receives a 500 instead of a validation error, and the event is not queued. A NUL in `sourceEventId` has the same problem with its PostgreSQL text column.\n- Evidence: `typeof text !== \"string\" || text.trim() === \"\"` checks type and emptiness, while the subsequent check only limits length.\n- Fix idea: Reject NUL characters in both fields before enqueueing, with a 400 response. Also validate other Unicode sequences PostgreSQL JSONB cannot store, such as unpaired surrogates.\n\nEND-OF-REPORT"}]}
DONE
