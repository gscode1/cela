ENTRY 11355 {"id":11355,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import type { Message, TranscriptContext } from \"@earendil-works/pi-ai\";\nimport { describe, expect, it } from \"vitest\";\nimport { parseScript, scriptedReply } from \"../src/model.ts\";\n\nconst script = {\n  steps: [{ bash: \"echo one\" }, { bash: \"echo two\", timeout: 9 }],\n  final: \"all done\",\n};\n\nfunction user(text: string): Message {\n  return { role: \"user\", content: text, timestamp: 0 };\n}\n\nfunction result(id: string): Message {\n  return {\n    role: \"toolResult\",\n    toolCallId: id,\n    toolName: \"bash\",\n    content: [{ type: \"text\", text: \"ok\" }],\n    isError: false,\n    timestamp: 0,\n  };\n}\n\nasync function reply(messages: Message[]) {\n  return scriptedReply(\n    { messages } as unknown as TranscriptContext,\n    undefined,\n    {} as never,\n    {} as never,\n  );\n}\n\ndescribe(\"scripted model\", () => {\n  it(\"calls the first step on a fresh transcript\", async () => {\n    const message = await reply([user(JSON.stringify(script))]);\n    expect(message.content).toMatchObject([\n      { type: \"toolCall\", name: \"bash\", arguments: { command: \"echo one\" } },\n    ]);\n  });\n\n  it(\"continues from the stored transcript, which is all a restarted process has\", async () => {\n    const message = await reply([user(JSON.stringify(script)), result(\"a\")]);\n    expect(message.content).toMatchObject([\n      { type: \"toolCall\", name: \"bash\", arguments: { command: \"echo two\", timeout: 9 } },\n    ]);\n  });\n\n  it(\"repeats the same call id when a request is retried\", async () => {\n    const messages = [user(JSON.stringify(script))];\n    const first = await reply(messages);\n    const second = await reply(messages);\n    expect(first.content).toEqual(second.content);\n  });\n\n  it(\"answers once every step has a result, even an interrupted one\", async () => {\n    const message = await reply([user(JSON.stringify(script)), result(\"a\"), result(\"b\")]);\n    expect(message.content).toMatchObject([{ type: \"text\", text: \"all done\" }]);\n  });\n\n  it(\"answers plain chat text with an echo, so message order shows in the answers\", async () => {\n    const message = await reply([user(\"hello there\")]);\n    expect(message.content).toMatchObject([{ type: \"text\", text: \"echo: hello there\" }]);\n  });\n\n  it(\"follows the latest user message, not the first\", async () => {\n    const second = { steps: [{ bash: \"echo later\" }] };\n    const message = await reply([\n      user(JSON.stringify(script)),\n      result(\"a\"),\n      user(JSON.stringify(second)),\n    ]);\n    expect(message.content).toMatchObject([\n      { type: \"toolCall\", arguments: { command: \"echo later\" } },\n    ]);\n  });\n});\n\ndescribe(\"parseScript\", () => {\n  it(\"rejects scripts without bash steps\", () => {\n    expect(() => parseScript(\"{}\")).toThrow(/steps/);\n    expect(() => parseScript('{\"steps\":[{\"cmd\":\"x\"}]}')).toThrow(/bash/);\n  });\n});\nimport { readFile } from \"node:fs/promises\";\nimport type { Models } from \"@earendil-works/pi-ai\";\nimport { createModels } from \"@earendil-works/pi-ai/models\";\nimport { builtinProviders } from \"@earendil-works/pi-ai/providers/all\";\nimport { modelKey } from \"@pi-durable-k8s/session-core\";\nimport type { OrchestratorConfig } from \"./config.js\";\nimport { scriptedProvider } from \"./model.js\";\nimport {\n  createGatewayFetch,\n  placeholderAuthContext,\n  placeholderCredentials,\n  withFetch,\n} from \"./onecli.js\";\n\nconst LOCAL = new Set([\"scripted\", \"faux\"]);\n\n/**\n * The `Models` of the orchestrator.\n *\n * Pi Durable stores a conversation's model as `{ provider, modelId }` names and resolves them against this `Models`\n * at every request, so every provider a stored conversation may name must be installed at every start: the\n * allowlist's providers, the scripted ones, and `faux` for the Phase 3 /control sessions.\n *\n * Real providers resolve their API key to a placeholder (`placeholderAuthContext`) and send their requests through\n * the OneCLI gateway, which replaces the placeholder with the credential it holds. Throws when an allowlisted model\n * is not in pi-ai's catalog, so a typo in the ConfigMap fails at start instead of at the first request.\n */\nexport async function buildModels(\n  config: OrchestratorConfig,\n  readCa: (path: string) => Promise<string> = (path) => readFile(path, \"utf8\"),\n): Promise<Models> {\n  const models = createModels({\n    authContext: placeholderAuthContext,\n    credentials: await placeholderCredentials(config.onecli.codexAccountId),\n  });\n  models.setProvider(scriptedProvider({ provider: \"faux\" }).provider);\n  models.setProvider(\n    scriptedProvider({\n      provider: \"scripted\",\n      models: [{ id: \"scripted-1\" }, { id: \"scripted-2\" }],\n    }).provider,\n  );\n\n  const remote = config.models.allowed.filter((choice) => !LOCAL.has(choice.provider));\n  const token = config.onecli.token;\n  if (remote.length === 0 || token === undefined) {\n    assertInstalled(models, config);\n    return models;\n  }\n  const wanted = new Set(remote.map((choice) => choice.provider));\n  for (const provider of builtinProviders()) {\n    if (wanted.has(provider.id)) models.setProvider(provider);\n  }\n  assertInstalled(models, config);\n  const ca = await readCa(config.onecli.caFile);\n  return withFetch(\n    models,\n    createGatewayFetch({\n      gateway: config.onecli.gateway,\n      token,\n      ca,\n      noProxy: config.onecli.noProxy,\n    }),\n  );\n}\n\nfunction assertInstalled(models: Models, config: OrchestratorConfig): void {\n  for (const choice of config.models.allowed) {\n    if (models.getModel(choice.provider, choice.model) === undefined) {\n      throw new Error(`allowed model ${modelKey(choice)} is not known to pi-ai`);\n    }\n  }\n}\n    const id = parts[1] ?? \"\";\n    const session = UUID.test(id) ? await getSession(deps.pool, id) : undefined;\n    if (session?.ownerSubject !== principal.subject) {\n      sendJson(res, 404, { error: \"session not found\" });\n      return;\n    }\n    if (session.status === \"deleted\") {\n      sendJson(res, 410, { error: \"session deleted\" });\n      return;\n    }\n    const conversationId = await service.ensureConversation(session);\n    await serveStream(req, res, host, service.streams, session.id, conversationId);\n    return;\n  }\n\n  if (deps.control && parts[0] === \"control\") {\n    await handleControl(req, res, host, method, parts.slice(1));\n    return;\n  }\n  sendJson(res, 404, { error: \"not found\" });\n}\n\n/**\n * Test-only. Scripted sessions created straight on the Harness, not through the inbox, with the sandbox claim\n * created eagerly. Kept only so the Phase 3 failure tests keep running unchanged in substance.\n *   POST /control/sessions            body = script JSON\n *   POST /control/sessions/:id/inputs body = script JSON\n *   GET  /control/sessions/:id        status and tool results\n */\nasync function handleControl(\n  req: IncomingMessage,\n  res: ServerResponse,\n  host: Host,\n  method: string,\n  parts: string[],\n): Promise<void> {\n  if (parts[0] !== \"sessions\") {\n    sendJson(res, 404, { error: \"not found\" });\n    return;\n  }\n  if (method === \"POST\" && parts.length === 1) {\n    let script;\n    try {\n      script = parseScript(await readBody(req));\n    } catch (error) {\n      sendJson(res, 400, { error: errorMessage(error) });\n      return;\n    }\n    sendJson(res, 201, await host.startSession(script));\n    return;\n  }\n  const id = Number(parts[1]);\n  if (method === \"POST\" && parts[2] === \"inputs\") {\n    let script;\n    try {\n      script = parseScript(await readBody(req));\n    } catch (error) {\n      sendJson(res, 400, { error: errorMessage(error) });\n      return;\n    }\n    const known = Number.isInteger(id) && (await host.sendInput(id, script));\n    sendJson(res, known ? 202 : 404, known ? { id } : { error: \"unknown session\" });\n    return;\n  }\n  if (method === \"GET\" && parts.length === 2 && Number.isInteger(id)) {\n    const status = await host.status(id);\n    sendJson(res, status === undefined ? 404 : 200, status ?? { error: \"unknown session\" });\n    return;\n  }\n  sendJson(res, 404, { error: \"not found\" });\n}\npackages/orchestrator/src/host.ts:48:      return block.type === \"toolCall\" ? \"\" : `[${block.type}]`;\npackages/orchestrator/src/host.ts:57:      block.type === \"toolCall\" ? [`${block.name}(${JSON.stringify(block.arguments)})`] : [],\npackages/orchestrator/src/host.ts:61:  if (message.role === \"toolResult\") event.isError = message.isError;\npackages/orchestrator/src/host.ts:158:      .filter((e) => e.role === \"toolResult\")\npackages/orchestrator/src/model.ts:88:    .filter((message) => message.role === \"toolResult\").length;\n","isError":false}]}
