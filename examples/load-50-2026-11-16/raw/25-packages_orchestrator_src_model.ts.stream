 harness.resume();\n    return new Host(harness, sandboxes, storage);\n  }\n\n  /** Creates the conversation and its sandbox claim, then submits the script as the first input. */\n  async startSession(script: Script): Promise<{ id: number; claim: string }> {\n    const conversation = await this.#harness.createConversation(\n      {\n        ownership: { kind: \"ownerless\" },\n        agent: { model: { provider: \"faux\", modelId: \"faux-1\" }, cwd: WORKSPACE },\n      },\n      context,\n    );\n    const id = Number(conversation.id);\n    await this.#sandboxes.ensure(id);\n    await conversation.submit(\n      { type: \"input\", content: JSON.stringify(script), requestId: `start-${String(id)}` },\n      context,\n    );\n    log(\"session-started\", { id, claim: claimNameFor(id) });\n    return { id, claim: claimNameFor(id) };\n  }\n\n  /** A further input to an existing session; the model follows the newest script. False if unknown. */\n  async sendInput(id: number, script: Script): Promise<boolean> {\n    const conversation = await this.#harness.conversation(id as ConversationId, context);\n    if (conversation === undefined) return false;\n    await conversation.submit({ type: \"input\", content: JSON.stringify(script) }, context);\n    return true;\n  }\n\n  async events(id: number): Promise<SessionEvent[] | undefined> {\n    const conversation = await this.#harness.conversation(id as ConversationId, context);\n    if (conversation === undefined) return undefined;\n    const view = await conversation.context(context);\n    // Stored entries, not view.messages: the view adds a placeholder result for a call still running.\n    return view.entries.flatMap((entry) => entry.model ?? []).map(toEvent);\n  }\n\n  async status(id: number): Promise<SessionStatus | undefined> {\n    const events = await this.events(id);\n    if (events === undefined) return undefined;\n    const last = events.at(-1);\n    const results = events\n      .filter((e) => e.role === \"toolResult\")\n      .map((e) => ({ text: e.text, isError: e.isError === true }));\n    const answered = last?.role === \"assistant\" && last.calls === undefined;\n    return {\n      id,\n      claim: claimNameFor(id),\n      state: answered ? \"done\" : \"running\",\n      events: events.length,\n      results,\n      ...(answered ? { answer: last.text } : {}),\n    };\n  }\n\n      for (const host of hosts.splice(0)) await host.close().catch(() => undefined);\n      await rm(dir, { recursive: true, force: true });\n    }\n  });\n\n  it(\"answers a turn on the stored model, with nothing applied per turn\", async () => {\n    const host = await openHost();\n    const id = await host.createConversation({ provider: \"scripted\", model: \"scripted-2\" });\n    await host.submitInput(id, { text: \"hello\", requestId: \"r1\", steer: false });\n    expect(await settled(host, id, \"r1\")).toMatchObject({ status: \"done\" });\n    expect(await host.turnsUsed(id)).toBe(1);\n  });\n});\n\ndescribe(\"a provider error\", () => {\n  it(\"reaches the submission as unanswered with the error text, which maps to a terminal failure\", async () => {\n    const host = await openHost();\n    const id = await host.createConversation({ provider: \"scripted\", model: \"scripted-1\" });\n    const script = JSON.stringify({ steps: [], error: \"401 Unauthorized: no credentials\" });\n    await host.submitInput(id, { text: script, requestId: \"r1\", steer: false });\n    const state = await settled(host, id, \"r1\");\n    expect(state).toMatchObject({ status: \"unanswered\", reason: \"model_error\" });\n    const detail = state.status === \"unanswered\" ? String(state.detail) : \"\";\n    expect(detail).toContain(\"401\");\n    expect(terminalFailure({ reason: \"model_error\", detail })).toMatch(/credentials were rejected/);\n  });\n\n  it(\"does not make an unrelated error terminal\", async () => {\n    const host = await openHost();\n    const id = await host.createConversation({ provider: \"scripted\", model: \"scripted-1\" });\n    const script = JSON.stringify({ steps: [], error: \"400 Bad Request: context too long\" });\n    await host.submitInput(id, { text: script, requestId: \"r1\", steer: false });\n    const state = await settled(host, id, \"r1\");\n    const detail = state.status === \"unanswered\" ? String(state.detail) : \"\";\n    expect(terminalFailure({ reason: \"model_error\", detail })).toBeUndefined();\n  });\n});\n\ndescribe(\"turn budget\", () => {\n  const session = (status: SessionRow[\"status\"] = \"active\"): SessionRow => ({\n    id: \"s1\",\n    owner: \"alice\",\n    ownerSubject: \"static:alice\",\n    status,\n    conversationId: null,\n    model: { provider: \"scripted\", model: \"scripted-1\" },\n    failure: null,\n    repo: null,\n    onecli: null,\n    workspaceReadyAt: null,\n    createdAt: new Date(),\npackages/orchestrator/test/config.test.ts:29:      statement_timeout: 30_000,\npackages/orchestrator/test/model.test.ts:6:  steps: [{ bash: \"echo one\" }, { bash: \"echo two\", timeout: 9 }],\npackages/orchestrator/test/model.test.ts:45:      { type: \"toolCall\", name: \"bash\", arguments: { command: \"echo two\", timeout: 9 } },\n    73\t\n    74\t/**\n    75\t * The scripted reply for a transcript: the next unfinished step, else the final answer. A user message that\n    76\t * is not a script is plain chat text and is answered with `echo: <text>`, so message order shows in answers.\n    77\t */\n    78\texport const scriptedReply: FauxResponseFactory = (context) => {\n    79\t  const messages = context.messages;\n    80\t  const lastUser = messages.findLastIndex((message) => message.role === \"user\");\n    81\t  const lastText = textOf(\n    82\t    messages[lastUser] ?? messages[0] ?? { role: \"user\", content: \"{}\", timestamp: 0 },\n    83\t  );\n    84\t  const script = tryParseScript(lastText);\n    85\t  if (script === undefined) return fauxAssistantMessage(fauxText(`echo: ${lastText}`));\n    86\t  const done = messages\n    87\t    .slice(lastUser + 1)\n    88\t    .filter((message) => message.role === \"toolResult\").length;\n    89\t  const step = script.steps[done];\n    90\t  if (step === undefined) {\n    91\t    if (script.error !== undefined) {\n    92\t      return fauxAssistantMessage([], { stopReason: \"error\", errorMessage: script.error });\n    93\t    }\n    94\t    return fauxAssistantMessage(fauxText(script.final ?? \"done\"));\n    95\t  }\n    96\t  // A stable id per (user message, step): a retried request after a restart repeats the same call.\n    97\t  const call = fauxToolCall(\n    98\t    \"bash\",\n    99\t    { command: step.bash, ...(step.timeout === undefined ? {} : { timeout: step.timeout }) },\n   100\t    { id: `step-${String(lastUser)}-${String(done)}` },\n   101\t  );\n   102\t  return fauxAssistantMessage(call, { stopReason: \"toolUse\" });\n   103\t};\n   104\t\n   105\tconst QUEUED_REPLIES = 100_000;\n   106\t\n   107\t/**\n   108\t * Pi's own faux provider, loaded with enough copies of the stateless script for any number of requests.\n   109\t * `faux` / `faux-1` is the Phase 3 /control surface; `scripted` has two models so e2e can tell sessions apart.\n   110\t */\n   111\texport function scriptedProvider(\n   112\t  options?: Parameters<typeof fauxProvider>[0],\n   113\t): ReturnType<typeof fauxProvider> {\n   114\t  const faux = fauxProvider(options);\n   115\t  faux.setResponses(Array.from({ length: QUEUED_REPLIES }, () => scriptedReply));\n   116\t  return faux;\n   117\t}\n","isError":false}]}
ENTRY 11489 {"id":11489,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && grep -n '@earendil-works/pi-ai' pnpm-lock.yaml package-lock.json 2>/dev/null | head; find /workspace -iname '*pi-ai*' | head; grep -R -n 'whenBusy\\\\|steer.*tool\\\\|steering' docs tests/e2e | head -80; sed -n '1,100p' README.md\"})"]}]}
ENTRY 11504 {"id":11504,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"pnpm-lock.yaml:218:      '@earendil-works/pi-ai':\npnpm-lock.yaml:459:  '@earendil-works/pi-ai@1.5.2':\npnpm-lock.yaml:2227:  '@earendil-works/pi-ai@1.5.2(@aws-sdk/credential-provider-node@3.972.97)(@smithy/signature-v4@5.7.5)(undici@8.12.4)(ws@8.23.0)':\npnpm-lock.yaml:2259:      '@earendil-works/pi-ai': 1.5.2(@aws-sdk/credential-provider-node@3.972.97)(@smithy/signature-v4@5.7.5)(undici@8.12.4)(ws@8.23.0)\ndocs/session-api.md:51:   - `message`: `whenBusy: \"followUp\"`. On an idle session it starts a turn; on a busy one it queues behind the\ndocs/session-api.md:53:   - `steer`: `whenBusy: \"steer\"`. The input joins the running turn after its current tool round. On an idle session\ndocs/decisions/0003-recycle-pod-on-interrupt.md:9:steer lands mid-tool, and a command has its own timeout; an orchestrator killed mid-command loses the stream the same\n# pi-durable-k8s\n\nRun [Pi Durable](https://github.com/earendil-works/pi) coding agents on your own Kubernetes cluster.\n\nEach session gets an agent that keeps its state in PostgreSQL and resumes after a crash, plus a private gVisor\nsandbox with a persistent workspace where its tools run. Model and GitHub credentials never reach the agent or the\nsandbox: [OneCLI](https://github.com/onecli/onecli) injects them at its gateway.\n\n**Status: proof of concept.** It runs end to end on a small arm64 lab cluster. It is not hardened for production;\nsee the open items in [plan.md](plan.md).\n\n![Architecture](docs/architecture.svg)\n\n## How it works\n\n1. A client creates a session and posts messages to the **session API** (`packages/ingest`).\n2. Messages land in an inbox in **PostgreSQL** first, so nothing is lost while the agent is busy or restarting.\n3. The **orchestrator** (`packages/orchestrator`) runs one durable Pi agent loop per session and takes inbox\n   messages in order.\n4. Model calls go through the **OneCLI gateway**, which adds the subscription or API key on the way out.\n5. Tool calls (bash, read, write, edit) run in the session's **sandbox**: a pod from\n   [agent-sandbox](https://github.com/kubernetes-sigs/agent-sandbox) under gVisor, with the `pi-env` daemon inside.\n   It is created on the first tool call and keeps its workspace on a PVC.\n6. Progress and answers stream back to the client over SSE.\n\nOptionally a session works on one GitHub repository: the orchestrator mints a token scoped to that repository,\nstores it in OneCLI for that session only, and the sandbox clones and pushes through the gateway.\n\n## Security model\n\n- Sandboxes run under gVisor. Network policies (written for Cilium) block sandboxes from the orchestrator, the\n  database, the Kubernetes API, OneCLI's management API and each other.\n- Each sandbox's daemon accepts only its own token, derived from a master key the orchestrator holds\n  ([ADR 0001](docs/decisions/0001-per-sandbox-sandboxd-token.md)).\n- No credentials in sandboxes or in the agent: OneCLI holds them and only relays to allowlisted hosts\n  ([host rules](docs/onecli-host-rules.md)).\n\n## Repository layout\n\n| Path                                   | What                                                                                                 |\n| -------------------------------------- | ---------------------------------------------------------------------------------------------------- |\n| `packages/ingest`                      | Session API: auth, owner checks, inbox writes, SSE proxy                                             |\n| `packages/orchestrator`                | Pi Durable harness, sandbox lifecycle, model and OneCLI wiring                                       |\n| `packages/sandbox-env`                 | Bridge from Pi's `RemoteExecutionEnv` to an agent-sandbox pod (the only SDK user)                    |\n| `packages/session-core`                | Shared schema, migrations and auth helpers                                                           |\n| `packages/vendor/agent-sandbox-client` | Vendored, pinned agent-sandbox TypeScript SDK (Apache-2.0)                                           |\n| `vendor/`                              | Packed `@netzlabor/pi-durable-postgres` adapter, ported to Pi Durable 1.5.2                          |\n| `images/sandbox`                       | Sandbox image: sandboxd + `pi-env` + git                                                             |\n| `deploy/`                              | Kubernetes manifests (namespace, Postgres, orchestrator, ingest, sandbox template, network policies) |\n| `tests/e2e`                            | End-to-end suites that run as in-cluster Jobs                                                        |\n| `docs/`                                | API, credentials, networking, decisions and research notes                                           |\n\n## Docs\n\n- [Session API](docs/session-api.md)\n- [Model credentials through OneCLI](docs/model-credentials.md)\n- [Repository workspaces](docs/repo-workspace.md)\n- [Network policy](docs/network-policy.md) and [OneCLI host rules](docs/onecli-host-rules.md)\n- [Plan, decisions and phase results](plan.md)\n\n## Development\n\nRequires Node 22.19+ and pnpm.\n\n```sh\npnpm install\npnpm check        # build, lint, format, typecheck, unit tests\ntests/e2e/run.sh smoke   # needs a cluster with agent-sandbox, gVisor and the deploy/ manifests applied\n```\n\n## License\n\nMIT, see [LICENSE](LICENSE). The vendored agent-sandbox SDK in `packages/vendor/agent-sandbox-client` keeps its Apache-2.0 license.\n","isError":false}]}
