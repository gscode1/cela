ENTRY 11156 {"id":11156,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"deploy/sandbox-warmpool.yaml:6:  replicas: 0\ndeploy/postgres.yaml:2:# Connect through the pi-pg-rw service only: the adapter's ownership lock is a session advisory lock.\ndeploy/push-code.sh:17:# Runs on every exit path: a failed wait, cp or extract must not leave the orchestrator at 0 replicas.\ndeploy/push-code.sh:23:    k scale deployment \"$d\" --replicas=1 >/dev/null || echo \"could not scale $d back to 1; run: kubectl -n $ns scale deployment $d --replicas=1\" >&2\ndeploy/push-code.sh:36:    k scale deployment \"$d\" --replicas=0 >/dev/null\ndeploy/orchestrator.yaml:11:  replicas: 1\ndeploy/ingest.yaml:1:# ingest: the stateless HTTP front of the session API. Two replicas, any node, no volume.\ndeploy/ingest.yaml:4:# shared across nodes, which would pin both replicas to one node; the ConfigMap needs no pinning and a rollout\ndeploy/ingest.yaml:15:  replicas: 2\n    30\t  // own connection and holds the ownership lock on it, and neither may share it.\n    31\t  const pool = createPool(config.databaseUrl, `${config.instance}-inbox`, 10);\n    32\t  const server = createOrchestratorServer({\n    33\t    lifecycle,\n    34\t    authenticate: tokenAuthenticator(config.apiTokens),\n    35\t    pool,\n    36\t    control: config.control,\n    37\t  });\n    38\t  await new Promise<void>((resolve) => server.listen(config.port, resolve));\n    39\t  log(\"listening\", { instance: config.instance, port: config.port });\n    40\t\n    41\t  const running: { inbox?: InboxLoop; service?: SessionService; sweeper?: OrphanSweeper } = {};\n    42\t  const stop = new AbortController();\n    43\t  const shutdown = (signal: string): void => {\n    44\t    log(\"shutdown\", { signal });\n    45\t    stop.abort();\n    46\t    server.close();\n    47\t    void (async () => {\n    48\t      running.service?.stop();\n    49\t      running.sweeper?.stop();\n    50\t      await running.inbox?.stop();\n    51\t      await lifecycle.host?.close();\n    52\t      server.closeAllConnections();\n    53\t      await pool.end().catch(() => undefined);\n    54\t    })().finally(() => process.exit(0));\n    55\t    setTimeout(() => process.exit(0), 10_000).unref();\n    56\t  };\n    57\t  process.on(\"SIGTERM\", () => shutdown(\"SIGTERM\"));\n    58\t  process.on(\"SIGINT\", () => shutdown(\"SIGINT\"));\n    59\t\n    60\t  for (;;) {\n    61\t    try {\n    62\t      await applyMigrations(pool);\n    63\t      break;\n    64\t    } catch (error) {\n    65\t      log(\"migrate-failed\", { message: errorMessage(error) });\n    66\t      await new Promise((resolve) => setTimeout(resolve, 2_000));\n    67\t    }\n    68\t  }\n    69\t\n    70\t  const storage = await openStorageWhenFree(config, stop.signal);\n    71\t  log(\"lock-acquired\", { instance: config.instance });\n    72\t  const sessionKeyOf = async (conversationId: number): Promise<string> => {\n    73\t    const { rows } = await pool.query<{ id: string }>(\n    74\t      \"select id from inbox.sessions where conversation_id = $1\",\n    75\t      [conversationId],\n    76\t    );\n    77\t    // Conversations the inbox does not know are the test-only /control sessions.\n    78\t    return rows[0]?.id ?? `control-${String(conversationId)}`;\n    79\t  };\n    80\t  // Repo workspaces (Phase 4c). Plain sessions never touch OneCLI's management API or GitHub through this.\n    81\t  const callApi: FetchLike = (url, init) => fetch(url, init);\n    82\t  const onecli =\n    83\t    config.repos.onecliApiKey === undefined\n    84\t      ? undefined\n    85\t      : new OneCliAdmin(config.repos.onecliApi, config.repos.onecliApiKey, callApi);\n    86\t  const repos = new RepoAccess({\n    87\t    pool,\n    88\t    onecli,\n    89\t    githubAppDir: config.repos.githubAppDir,\n    90\t    gateway: config.onecli.gateway,\n    91\t    caFile: config.onecli.caFile,\n    92\t    fetch: callApi,\n    93\t  });\n    94\t  const hooks: SandboxHooks = {\n    95\t    shellEnv: async (conversationId) => {\n    96\t      const { rows } = await pool.query<{ id: string }>(\n    97\t        \"select id from inbox.sessions where conversation_id = $1\",\n    98\t        [conversationId],\n    99\t      );\n   100\t      const session = rows[0] === undefined ? undefined : await getSession(pool, rows[0].id);\n   101\t      return session === undefined ? undefined : repos.shellEnv(session, conversationId);\n   102\t    },\n   103\t    beforeUse: (conversationId) => repos.beforeUse(conversationId),\n   104\t    execInFlight: (conversationId, inFlight) => setExecInFlight(pool, conversationId, inFlight),\n   105\t  };\n   106\t  // Sandboxes that had a command running when the previous process died: Host.open recycles their Pods before Pi\n   107\t  // Durable resumes (docs/decisions/0003-recycle-pod-on-interrupt.md).\n   108\t  const recycleAtStart = await conversationsWithExecInFlight(pool);\n   109\t  if (recycleAtStart.length > 0) log(\"recycle-at-start\", { conversations: recycleAtStart });\n   110\t  const host = await Host.open(\n   111\t    storage,\n   112\t    config,\n   113\t    (error) => {\n   114\t      // Fail closed: a Harness that lost its storage stops here. Nothing reconnects and nothing more is\n   115\t      // written; the Deployment starts a fresh process, which waits for the lock like any other owner.\n   116\t      log(\"fail-closed\", { instance: config.instance, message: errorMessage(error) });\n   117\t      process.exit(1);\n   118\t    },\n   119\t    sessionKeyOf,\n   120\t    hooks,\n   121\t    recycleAtStart,\n   122\t  );\n   123\t  const service = new SessionService(pool, host, {\n   124\t    testFaults: config.testFaults,\n   125\t    defaultModel: config.models.default,\n   126\t    turnBudget: config.turnBudget,\n   127\t    repos,\n   128\t  });\n   129\t  running.service = service;\n   130\t  // Not fatal: a failed scan only means a run that died unseen is noticed at its next input.\n   131\t  await service.recoverWatches().catch((error: unknown) => {\n   132\t    log(\"run-watch-recover-failed\", { message: errorMessage(error) });\n   133\t  });\n   134\t  lifecycle.host = host;\n   135\t  lifecycle.service = service;\n   136\t  lifecycle.state = \"owner\";\n   137\t  log(\"owner\", { instance: config.instance });\n   138\t\n   139\t  // Orphan sweep (docs/decisions/0002-orphan-sweep.md): only the owner runs it, like the inbox.\n   140\t  const sweeper = new OrphanSweeper({\n   141\t    listSessions: () => listSessionRefs(pool),\n   142\t    listClaims: () => listClaims(config.namespace),\n   143\t    listPvcs: () => listPvcs(config.namespace),\n   144\t    listOneCli:\n   145\t      onecli === undefined\n   146\t        ? undefined\n   147\t        : async () => ({\n   148\t            agents: (await onecli.listAgents()).map(({ id, identifier }) => ({ id, identifier })),\n   149\t            secrets: await onecli.listSecrets(),\n   150\t          }),\n   151\t    destroyClaim: (claim, label) => host.destroyOrphanSandbox(claim, label),\n   152\t    revokeSession: (sessionId) => repos.revokeSession(sessionId),\n   153\t    graceMs: config.sweep.graceMs,\n   154\t    maxActions: config.sweep.maxActions,\n   155\t  });\n   156\t  running.sweeper = sweeper;\n   157\t  sweeper.start(config.sweep.intervalMs);\n   158\t\n   159\t  // Only the owner consumes the inbox. Rows that arrived while no orchestrator ran are waiting.\n   160\t  const inbox = new InboxLoop(pool, (event, session) => service.apply(event, session));\n   161\t  running.inbox = inbox;\n   162\t  inbox.start();\n   163\t}\n   164\t\n   165\tmain().catch((error: unknown) => {\n   166\t  log(\"fatal\", { message: errorMessage(error) });\n   167\t  process.exit(1);\n   168\t});\n22:/** An event that can never succeed (deleted session, malformed payload): the row is marked failed, not retried. */\n23:export class PermanentError extends Error {}\n37:      set.delete(close);\n38:      if (set.size === 0) this.#streams.delete(sessionId);\n163:    // retries here and must not find \"nothing changed\" and stop. A deleting or deleted session is not ours to abort.\n176:      creating = this.#create(session.id).finally(() => this.#creating.delete(session.id));\n196:  /** Applies one inbox event. Resolves when it is durably handed over; throws PermanentError if it never can be. */\n197:  async apply(event: InboxEvent, session: SessionRow): Promise<void> {\n198:    if (session.status === \"deleted\") throw new PermanentError(\"session is deleted\");\n203:        if (typeof text !== \"string\" || text === \"\") throw new PermanentError(\"event has no text\");\n208:          throw new PermanentError(\"session has failed\");\n240:      case \"delete\": {\n241:        await this.#delete(session);\n254:    if (repos === undefined) throw new PermanentError(\"repository workspaces are not configured\");\n260:        throw new PermanentError(error.message);\n266:        throw new PermanentError(failure);\n268:      if (error instanceof RepoUnavailableError) throw new PermanentError(error.message);\n284:      throw new PermanentError(\"turn budget exhausted\");\n290:   * Stop the session, delete the SandboxClaim and PVC, mark the session deleted. The conversation's stored state\n291:   * stays: the Postgres adapter can only delete it in a maintenance window (docs/session-api.md).\n293:  async #delete(session: SessionRow): Promise<void> {\n294:    log(\"session-delete-start\", { session: session.id });\n302:      this.streams.closeSession(session.id, \"deleted\");\n306:      \"update inbox.sessions set status = 'deleted', last_activity_at = clock_timestamp() where id = $1\",\n310:    log(\"session-deleted\", { session: session.id });\n","isError":false}]}
ENTRY 11205 {"id":11205,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && sed -n '190,320p' packages/orchestrator/src/sessions.ts; cat -n deploy/orchestrator.yaml | head -35; grep -R -n 'statement_timeout\\\\|idle_in_transaction' packages | head -30; cat -n packages/orchestrator/test/inbox.test.ts | sed -n '100,200p'\"})"]}]}
ENTRY 11217 {"id":11217,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"      [conversationId, sessionId],\n    );\n    log(\"conversation-created\", { session: sessionId, conversation: conversationId });\n    return conversationId;\n  }\n\n  /** Applies one inbox event. Resolves when it is durably handed over; throws PermanentError if it never can be. */\n  async apply(event: InboxEvent, session: SessionRow): Promise<void> {\n    if (session.status === \"deleted\") throw new PermanentError(\"session is deleted\");\n    switch (event.kind) {\n      case \"message\":\n      case \"steer\": {\n        const text = event.payload.text;\n        if (typeof text !== \"string\" || text === \"\") throw new PermanentError(\"event has no text\");\n        if (session.status === \"failed\") {\n          // Retries an abort that failed when the session was failed (see #failSession); throws, and so retries the\n          // row, if the abort fails again.\n          if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n          throw new PermanentError(\"session has failed\");\n        }\n        const conversationId = await this.ensureConversation(session);\n        await this.#withinBudget(session, conversationId);\n        // Before the first turn: OneCLI agent, token and clone. A session without a repo skips all of it.\n        if (session.repo !== null) await this.#prepareRepo(session, conversationId);\n        const requestId = event.id;\n        const faultArmed =\n          this.#options.testFaults && event.payload.testFault === \"exit-after-submit\";\n        const alreadyAdmitted =\n          faultArmed && (await this.#host.hasSubmission(conversationId, requestId));\n        await this.#host.submitInput(conversationId, {\n          text,\n          requestId,\n          steer: event.kind === \"steer\",\n        });\n        this.#watcher.add({ sessionId: session.id, conversationId, requestId });\n        if (faultArmed && !alreadyAdmitted) {\n          // After the durable hand-over, before the row says so: exactly the window test 4 needs.\n          // Synchronous write: stdout to a pipe is async and process.exit would drop the line.\n          writeSync(\n            1,\n            `${JSON.stringify({ event: \"test-fault\", fault: \"exit-after-submit\", id: event.id })}\\n`,\n          );\n          process.exit(137);\n        }\n        return;\n      }\n      case \"cancel\": {\n        if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n        return;\n      }\n      case \"delete\": {\n        await this.#delete(session);\n        return;\n      }\n    }\n  }\n\n  /**\n   * Provisions the repo session's GitHub access and makes sure its clone exists. What no retry can fix ends the input\n   * for good (and, for a lost workspace or refused access, the session): the agent must not run a turn in a workspace\n   * that is not the one the user asked for. Anything else throws as is, so the inbox retries it.\n   */\n  async #prepareRepo(session: SessionRow, conversationId: number): Promise<void> {\n    const repos = this.#options.repos;\n    if (repos === undefined) throw new PermanentError(\"repository workspaces are not configured\");\n    try {\n      await repos.prepare(session, await this.#host.workspaceEnv(conversationId));\n    } catch (error) {\n      if (error instanceof WorkspaceLostError) {\n        await this.#failSession(session.id, conversationId, error.message);\n        throw new PermanentError(error.message);\n      }\n      if (error instanceof GithubDeniedError) {\n        const failure =\n          \"GitHub refused access to the repository: is the GitHub App installed on it?\";\n        await this.#failSession(session.id, conversationId, failure);\n        throw new PermanentError(failure);\n      }\n      if (error instanceof RepoUnavailableError) throw new PermanentError(error.message);\n      throw error;\n    }\n  }\n\n  /**\n   * The per-session turn budget, checked before every input: a session that used all its turns fails for good, and\n   * otherwise the conversation's `maxTurns` is set to what is left, so a single long run cannot overshoot it.\n   * Turns are model responses, counted from the stored transcript, so a restart does not reset the count.\n   */\n  async #withinBudget(session: SessionRow, conversationId: number): Promise<void> {\n    const used = await this.#host.turnsUsed(conversationId);\n    const left = this.#options.turnBudget - used;\n    if (left <= 0) {\n      const failure = terminalFailure({ reason: \"turn_limit\" });\n      await this.#failSession(session.id, conversationId, failure ?? \"turn budget exhausted\");\n      throw new PermanentError(\"turn budget exhausted\");\n    }\n    await this.#host.limitTurns(conversationId, left);\n  }\n\n  /**\n   * Stop the session, delete the SandboxClaim and PVC, mark the session deleted. The conversation's stored state\n   * stays: the Postgres adapter can only delete it in a maintenance window (docs/session-api.md).\n   */\n  async #delete(session: SessionRow): Promise<void> {\n    log(\"session-delete-start\", { session: session.id });\n    // Record what the session holds before anything is revoked, then revoke its OneCLI agent first: from that moment\n    // its proxy token is dead, whatever happens to the claim after. A plain session has no OneCLI objects.\n    await writeTombstone(this.#pool, session);\n    await this.#options.repos?.teardown(session);\n    const conversationId = session.conversationId;\n    if (conversationId !== null) {\n      await this.#host.abort(conversationId);\n      this.streams.closeSession(session.id, \"deleted\");\n      await this.#host.destroySandbox(conversationId);\n    }\n    await this.#pool.query(\n      \"update inbox.sessions set status = 'deleted', last_activity_at = clock_timestamp() where id = $1\",\n      [session.id],\n    );\n    await completeTombstone(this.#pool, session.id);\n    log(\"session-deleted\", { session: session.id });\n  }\n}\n     1\t# One replica, Recreate: the Postgres adapter allows a single owner per schema.\n     2\t# Code comes from the orchestrator-code PVC (deploy/push-code.sh), so no image is pushed.\n     3\t# The DB URI comes from the CNPG-generated secret pi-pg-app and is never printed.\n     4\tapiVersion: apps/v1\n     5\tkind: Deployment\n     6\tmetadata:\n     7\t  name: pi-orchestrator\n     8\t  labels:\n     9\t    app.kubernetes.io/name: pi-orchestrator\n    10\tspec:\n    11\t  replicas: 1\n    12\t  strategy:\n    13\t    type: Recreate\n    14\t  selector:\n    15\t    matchLabels:\n    16\t      app.kubernetes.io/name: pi-orchestrator\n    17\t      app.kubernetes.io/instance: pi-orchestrator\n    18\t  template:\n    19\t    metadata:\n    20\t      labels:\n    21\t        app.kubernetes.io/name: pi-orchestrator\n    22\t        app.kubernetes.io/instance: pi-orchestrator\n    23\t    spec:\n    24\t      serviceAccountName: pi-orchestrator\n    25\t      securityContext:\n    26\t        runAsNonRoot: true\n    27\t        runAsUser: 1000\n    28\t        runAsGroup: 1000\n    29\t        fsGroup: 1000\n    30\t        seccompProfile:\n    31\t          type: RuntimeDefault\n    32\t      containers:\n    33\t        - name: orchestrator\n    34\t          image: node:22-bookworm-slim\n    35\t          workingDir: /code/app\npackages/orchestrator/test/config.test.ts:29:      statement_timeout: 30_000,\npackages/orchestrator/src/storage.ts:20:    statement_timeout: 30_000,\npackages/orchestrator/src/inbox.ts:171:      // connection: it would wait for a lock that only this transaction's end releases, until statement_timeout.\npackages/session-core/src/db.ts:17:    statement_timeout: 30_000,\n   100\tdescribe(\"a failing delete\", () => {\n   101\t  it(\"is retried with backoff past five attempts and never ends failed\", async () => {\n   102\t    const inbox = new FakeInbox();\n   103\t    const row = inbox.add(\"delete\");\n   104\t    let calls = 0;\n   105\t    const apply = (): Promise<void> => {\n   106\t      calls += 1;\n   107\t      if (calls <= 8) return Promise.reject(new Error(\"kubernetes unavailable\"));\n   108\t      return Promise.resolve();\n   109\t    };\n   110\t    const loop = new InboxLoop(inbox.pool(), apply);\n   111\t\n   112\t    loop.wake();\n   113\t    await flush();\n   114\t    expect(calls).toBe(1);\n   115\t    // Backoff: an immediate wake does not retry before the delay has passed.\n   116\t    loop.wake();\n   117\t    await flush();\n   118\t    expect(calls).toBe(1);\n   119\t\n   120\t    for (let i = 0; i < 20 && row.status !== \"submitted\"; i++) {\n   121\t      vi.setSystemTime(Date.now() + 61_000);\n   122\t      loop.wake();\n   123\t      await flush();\n   124\t      expect(row.status).not.toBe(\"failed\");\n   125\t    }\n   126\t    expect(calls).toBe(9);\n   127\t    expect(row.status).toBe(\"submitted\");\n   128\t  });\n   129\t\n   130\t  it(\"still ends a delete that can never succeed (PermanentError)\", async () => {\n   131\t    const { PermanentError } = await import(\"../src/sessions.ts\");\n   132\t    const inbox = new FakeInbox();\n   133\t    const row = inbox.add(\"delete\");\n   134\t    const loop = new InboxLoop(inbox.pool(), () => Promise.reject(new PermanentError(\"gone\")));\n   135\t    loop.wake();\n   136\t    await flush();\n   137\t    expect(row.status).toBe(\"failed\");\n   138\t  });\n   139\t\n   140\t  it(\"other events still fail after five attempts\", async () => {\n   141\t    const inbox = new FakeInbox();\n   142\t    const row = inbox.add(\"message\");\n   143\t    const loop = new InboxLoop(inbox.pool(), () => Promise.reject(new Error(\"boom\")));\n   144\t    for (let i = 0; i < 6; i++) {\n   145\t      loop.wake();\n   146\t      await flush();\n   147\t    }\n   148\t    expect(row.status).toBe(\"failed\");\n   149\t    expect(row.attempts).toBe(5);\n   150\t  });\n   151\t});\n   152\t\n   153\tdescribe(\"a batch with a message followed by a delete\", () => {\n   154\t  it(\"never updates the session row from the pool while the batch transaction holds it\", async () => {\n   155\t    const inbox = new FakeInbox();\n   156\t    const message = inbox.add(\"message\");\n   157\t    const del = inbox.add(\"delete\");\n   158\t    const pool = inbox.pool();\n   159\t    // What the real #delete does: mark the session deleted on the pool, not on the batch's connection.\n   160\t    const apply = async (event: InboxEvent): Promise<void> => {\n   161\t      if (event.kind === \"delete\") {\n   162\t        await pool.query(\"update inbox.sessions set status = 'deleted' where id = $1\", [SESSION]);\n   163\t      }\n   164\t    };\n   165\t    const loop = new InboxLoop(pool, apply);\n   166\t    loop.wake();\n   167\t    await flush();\n   168\t\n   169\t    expect(message.status).toBe(\"submitted\");\n   170\t    expect(del.status).toBe(\"submitted\");\n   171\t    // Before the fix the first row's last_activity update held the lock and the delete's update waited on it.\n   172\t    expect(inbox.blocked).toEqual([]);\n   173\t    // The idle clock is still bumped, once for the batch, after the commit.\n   174\t    const touches = inbox.log.filter((l) => l.includes(\"set last_activity_at\"));\n   175\t    expect(touches).toEqual([\n   176\t      \"pool: update inbox.sessions set last_activity_at = clock_timestamp() where id = $1\",\n   177\t    ]);\n   178\t    expect(inbox.log.indexOf(\"tx: commit\")).toBeLessThan(inbox.log.indexOf(touches[0] ?? \"\"));\n   179\t  });\n   180\t});\n","isError":false}]}
