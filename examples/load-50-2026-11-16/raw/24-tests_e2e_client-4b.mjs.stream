ENTRY 12165 {"id":12165,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport { createHash, timingSafeEqual } from \"node:crypto\";\n     2\timport type { IncomingHttpHeaders } from \"node:http\";\n     3\t\n     4\t/** Who is calling. `owner` is recorded on every session and checked on every call. */\n     5\texport interface Principal {\n     6\t  /** Display name of the token entry. */\n     7\t  owner: string;\n     8\t  /**\n     9\t   * Stable identity of the caller, stored on every session and compared on every call. For a static token it is\n    10\t   * `static:<owner>`; an OIDC verifier returns the token's `iss` + `sub` here.\n    11\t   */\n    12\t  subject: string;\n    13\t}\n    14\t\n    15\t/**\n    16\t * The single seam for authentication. Ingest and the orchestrator call this and nothing else, so an OIDC\n    17\t * verifier replaces `tokenAuthenticator` without touching a route. Resolves to undefined for \"not authenticated\".\n    18\t */\n    19\texport type Authenticator = (headers: IncomingHttpHeaders) => Promise<Principal | undefined>;\n    20\t\n    21\tconst OWNER = /^[a-z0-9][a-z0-9_-]{0,62}$/;\n    22\tconst MIN_TOKEN_LENGTH = 16;\n    23\t\n    24\tconst digest = (value: string): Buffer => createHash(\"sha256\").update(value).digest();\n    25\t\n    26\t/**\n    27\t * Static bearer tokens from a Kubernetes Secret, one `owner:token` entry per line (or comma). Every\n    28\t * candidate is compared in constant time, so the answer does not depend on which entry matched.\n    29\t * Error messages never contain a token.\n    30\t */\n    31\texport function tokenAuthenticator(spec: string): Authenticator {\n    32\t  const entries = spec\n    33\t    .split(/[\\n,]/)\n    34\t    .map((line) => line.trim())\n    35\t    .filter((line) => line !== \"\")\n    36\t    .map((line, index) => {\n    37\t      const at = line.indexOf(\":\");\n    38\t      const owner = at < 0 ? \"\" : line.slice(0, at);\n    39\t      const token = at < 0 ? \"\" : line.slice(at + 1);\n    40\t      if (!OWNER.test(owner) || token.length < MIN_TOKEN_LENGTH) {\n    41\t        throw new Error(\n    42\t          `API token entry ${String(index + 1)} must be owner:token (token at least ${String(MIN_TOKEN_LENGTH)} characters)`,\n    43\t        );\n    44\t      }\n    45\t      return { owner, hash: digest(token) };\n    46\t    });\n    47\t  if (entries.length === 0) throw new Error(\"no API tokens configured\");\n    48\t\n    49\t  return (headers) => {\n    50\t    const header = headers.authorization;\n    51\t    const match = typeof header === \"string\" ? /^Bearer +(\\S+)$/i.exec(header) : null;\n    52\t    const presented = digest(match?.[1] ?? \"\");\n    53\t    let found: string | undefined;\n    54\t    for (const entry of entries) {\n    55\t      if (timingSafeEqual(entry.hash, presented) && match !== null) found = entry.owner;\n    56\t    }\n    57\t    return Promise.resolve(\n    58\t      found === undefined ? undefined : { owner: found, subject: `static:${found}` },\n    59\t    );\n    60\t  };\n    61\t}\npackages/orchestrator/src/stream.ts:104: *  - `event: entry`, `id: <entry id>`: a committed transcript entry, once, in order. The id is the cursor.\npackages/orchestrator/src/stream.ts:158:      await write(res, `id: ${String(event.id)}\\nevent: entry\\ndata: ${JSON.stringify(event)}\\n\\n`);\npackages/orchestrator/src/stream.ts:64:/** Only entries that carry model messages are streamed (inputs, answers, tool calls and results). */\n    13\tfunction tokenFor(owner) {\n    14\t  if (process.env.API_TOKEN) return process.env.API_TOKEN;\n    15\t  for (const line of (process.env.PI_API_TOKENS ?? \"\").split(\"\\n\")) {\n    16\t    const [name, token] = line.trim().split(\":\");\n    17\t    if (name === owner && token) return token;\n    18\t  }\n    19\t  throw new Error(`no token for owner ${owner}`);\n    36\t} else if (command === \"stream\") {\n    37\t  const [session, needle, seconds] = rest;\n    38\t  const controller = new AbortController();\n    39\t  const timer = setTimeout(() => controller.abort(), Number(seconds) * 1000);\n    40\t  let seen = \"\";\n    41\t  let found = false;\n    42\t  try {\n    43\t    const response = await fetch(`${base}/sessions/${session}/stream`, {\n    44\t      headers: { ...headers, accept: \"text/event-stream\" },\n    45\t      signal: controller.signal,\n    46\t    });\n    47\t    const decoder = new TextDecoder();\n    48\t    for await (const chunk of response.body) {\n    49\t      seen += decoder.decode(chunk, { stream: true });\n    50\t      if (seen.toLowerCase().includes(needle.toLowerCase())) {\n    51\t        found = true;\n    52\t        break;\n    53\t      }\n    54\t    }\n    55\t  } catch {\n    56\t    // Aborted by the timer.\n    57\t  }\n    58\t  clearTimeout(timer);\n    59\t  controller.abort();\n    60\t  console.log(found ? \"found\" : \"timeout\");\n    77\t} else if (command === \"answer\") {\n    78\t  const [session, needle, seconds] = rest;\n    79\t  const controller = new AbortController();\n    80\t  const timer = setTimeout(() => controller.abort(), Number(seconds) * 1000);\n    81\t  let buffer = \"\";\n    82\t  let calls = 0;\n    83\t  let result = \"timeout\";\n    84\t  try {\n    85\t    const response = await fetch(`${base}/sessions/${session}/stream`, {\n    86\t      headers: { ...headers, accept: \"text/event-stream\" },\n    87\t      signal: controller.signal,\n    88\t    });\n    89\t    const decoder = new TextDecoder();\n    90\t    outer: for await (const chunk of response.body) {\n    91\t      buffer += decoder.decode(chunk, { stream: true });\n    92\t      let end;\n    93\t      while ((end = buffer.indexOf(\"\\n\\n\")) >= 0) {\n    94\t        const block = buffer.slice(0, end);\n    95\t        buffer = buffer.slice(end + 2);\n    96\t        if (!block.includes(\"event: entry\")) continue;\n    97\t        const data = block.split(\"\\n\").find((line) => line.startsWith(\"data: \"));\n    98\t        const entry = JSON.parse(data.slice(6));\n    99\t        for (const message of entry.messages ?? []) {\n   100\t          if (message.role !== \"assistant\") continue;\n   101\t          calls += (message.calls ?? []).length;\n   102\t          if (calls > 0 && (message.text ?? \"\").toLowerCase().includes(needle.toLowerCase())) {\n   103\t            result = `found ${calls}`;\n   104\t            break outer;\n   105\t          }\n   106\t        }\n   107\t      }\n   108\t    }\n   109\t  } catch {\n   110\t    // Aborted by the timer.\n   111\t  }\n   112\t  clearTimeout(timer);\n   113\t  controller.abort();\n   114\t  console.log(result);\n","isError":false}]}
