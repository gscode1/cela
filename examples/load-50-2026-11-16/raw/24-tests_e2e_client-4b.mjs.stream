ENTRY 12147 {"id":12147,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { loadModelPolicy } from \"@pi-durable-k8s/session-core\";\nimport type { ModelPolicy } from \"@pi-durable-k8s/session-core\";\n\n/** Environment contract of ingest. The database URL and the API tokens are secrets: env-only, never logged. */\nexport interface IngestConfig {\n  databaseUrl: string;\n  /** `owner:token` entries, see session-core `tokenAuthenticator`. */\n  apiTokens: string;\n  /** Base URL of the orchestrator's stream endpoint. */\n  orchestratorUrl: string;\n  port: number;\n  instance: string;\n  /** Default model and allowlist for POST /sessions (same variables as the orchestrator, from one ConfigMap). */\n  models: ModelPolicy;\n}\n\nexport function loadConfig(env: Readonly<Record<string, string | undefined>>): IngestConfig {\n  const databaseUrl = env.PI_DURABLE_DATABASE_URL;\n  if (!databaseUrl) throw new Error(\"PI_DURABLE_DATABASE_URL is required\");\n  const apiTokens = env.PI_API_TOKENS;\n  if (!apiTokens) throw new Error(\"PI_API_TOKENS is required\");\n  const port = Number(env.PI_INGEST_PORT ?? \"8080\");\n  if (!Number.isInteger(port) || port < 0 || port > 65535) {\n    throw new Error(\"PI_INGEST_PORT is invalid\");\n  }\n  return {\n    databaseUrl,\n    apiTokens,\n    orchestratorUrl: env.PI_ORCH_URL ?? \"http://pi-orchestrator:8081\",\n    port,\n    instance: env.POD_NAME ?? `ingest-${String(process.pid)}`,\n    models: loadModelPolicy(env),\n  };\n}\npackages/session-core/src/auth.ts:33:    .split(/[\\n,]/)\npackages/ingest/src/log.ts:2:export function log(event: string, fields: Record<string, unknown> = {}): void {\npackages/ingest/src/events.ts:38:    // Without a client-supplied id every post is its own event: there is nothing to deduplicate on.\nfor (let i = 0; i < rest.length; i++) {\n  const arg = rest[i];\n  if (arg.startsWith(\"--\")) {\n    const name = arg.slice(2);\n    flags[name] = name === \"reconnect\" ? true : rest[++i];\n  } else positional.push(arg);\n}\n// Loopback: the client runs inside an ingest pod; the pi-ingest Service would be ingest->ingest, which policy denies.\nconst base = flags.base ?? \"http://127.0.0.1:8080\";\n\nfunction token() {\n  if (who === \"none\") return undefined;\n  if (who === \"bad\") return \"0\".repeat(48);\n  for (const line of (process.env.PI_API_TOKENS ?? \"\").split(/[\\n,]/)) {\n    const at = line.indexOf(\":\");\n    if (at > 0 && line.slice(0, at) === who) return line.slice(at + 1);\n  }\n  throw new Error(`no token for owner ${who}`);\n}\nconst auth = () => {\n  const t = token();\n  return t === undefined ? {} : { authorization: `Bearer ${t}` };\n};\nconst sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\n\nasync function call() {\n  const [method, path, body] = positional;\n  const res = await fetch(base + path, {\n    method,\n","isError":false}]}
