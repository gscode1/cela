ENTRY 12057 {"id":12057,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\t/* global process, fetch, console, AbortController, setTimeout, clearTimeout, TextDecoder */\n     2\t// Tiny session-API client for tests/e2e/run-phase4b.sh. Runs inside an ingest pod (`kubectl exec -i ... node - ...`), where\n     3\t// PI_API_TOKENS is already in the environment, so no token ever leaves the cluster or is printed. For a local stack\n     4\t// set API_BASE and PI_API_TOKENS (or API_TOKEN) in the environment.\n     5\t//\n     6\t//   node client.mjs call OWNER METHOD PATH [BODY]  -> {\"status\":N,\"body\":...}\n     7\t//   node client.mjs stream OWNER SESSION NEEDLE SECONDS -> prints \"found\" or \"timeout\"; exit 0 either way\n     8\t//   node client.mjs dump OWNER SESSION SECONDS -> the raw event stream, for debugging\n     9\t//   node client.mjs answer OWNER SESSION NEEDLE SECONDS -> prints \"found <tools>\" when an ASSISTANT text contains\n    10\t//     NEEDLE after at least one tool call (<tools> = number of calls seen), else \"timeout\" or \"failed\"\n    11\tconst base = process.env.API_BASE ?? \"http://127.0.0.1:8080\";\n    12\t\n    13\tfunction tokenFor(owner) {\n    14\t  if (process.env.API_TOKEN) return process.env.API_TOKEN;\n    15\t  for (const line of (process.env.PI_API_TOKENS ?? \"\").split(\"\\n\")) {\n    16\t    const [name, token] = line.trim().split(\":\");\n    17\t    if (name === owner && token) return token;\n    18\t  }\n    19\t  throw new Error(`no token for owner ${owner}`);\n    20\t}\n    21\t\n    22\tconst [command, owner, ...rest] = process.argv.slice(2);\n    23\tconst headers = { authorization: `Bearer ${tokenFor(owner)}`, \"content-type\": \"application/json\" };\n    24\t\n    25\tif (command === \"call\") {\n    26\t  const [method, path, body] = rest;\n    27\t  const response = await fetch(base + path, { method, headers, body: body || undefined });\n    28\t  const text = await response.text();\n    29\t  let parsed = null;\n    30\t  try {\n    31\t    parsed = JSON.parse(text);\n    32\t  } catch {\n    33\t    // Not JSON (an empty body): report the status only.\n    34\t  }\n    35\t  console.log(JSON.stringify({ status: response.status, body: parsed }));\n    36\t} else if (command === \"stream\") {\n    37\t  const [session, needle, seconds] = rest;\n    38\t  const controller = new AbortController();\n    39\t  const timer = setTimeout(() => controller.abort(), Number(seconds) * 1000);\n    40\t  let seen = \"\";\n    41\t  let found = false;\n    42\t  try {\n    43\t    const response = await fetch(`${base}/sessions/${session}/stream`, {\n    44\t      headers: { ...headers, accept: \"text/event-stream\" },\n    45\t      signal: controller.signal,\n    46\t    });\n    47\t    const decoder = new TextDecoder();\n    48\t    for await (const chunk of response.body) {\n    49\t      seen += decoder.decode(chunk, { stream: true });\n    50\t      if (seen.toLowerCase().includes(needle.toLowerCase())) {\n    51\t        found = true;\n    52\t        break;\n    53\t      }\n    54\t    }\n    55\t  } catch {\n    56\t    // Aborted by the timer.\n    57\t  }\n    58\t  clearTimeout(timer);\n    59\t  controller.abort();\n    60\t  console.log(found ? \"found\" : \"timeout\");\n    61\t} else if (command === \"dump\") {\n    62\t  // Debugging aid: print the raw event stream for SECONDS (entries and live state; no secrets pass through here).\n    63\t  const [session, seconds] = rest;\n    64\t  const controller = new AbortController();\n    65\t  setTimeout(() => controller.abort(), Number(seconds) * 1000);\n    66\t  try {\n    67\t    const response = await fetch(`${base}/sessions/${session}/stream`, {\n    68\t      headers: { ...headers, accept: \"text/event-stream\" },\n    69\t      signal: controller.signal,\n    70\t    });\n    71\t    const decoder = new TextDecoder();\n    72\t    for await (const chunk of response.body)\n    73\t      process.stdout.write(decoder.decode(chunk, { stream: true }));\n    74\t  } catch {\n    75\t    // Aborted by the timer.\n    76\t  }\n    77\t} else if (command === \"answer\") {\n    78\t  const [session, needle, seconds] = rest;\n    79\t  const controller = new AbortController();\n    80\t  const timer = setTimeout(() => controller.abort(), Number(seconds) * 1000);\n    81\t  let buffer = \"\";\n    82\t  let calls = 0;\n    83\t  let result = \"timeout\";\n    84\t  try {\n    85\t    const response = await fetch(`${base}/sessions/${session}/stream`, {\n    86\t      headers: { ...headers, accept: \"text/event-stream\" },\n    87\t      signal: controller.signal,\n    88\t    });\n    89\t    const decoder = new TextDecoder();\n    90\t    outer: for await (const chunk of response.body) {\n    91\t      buffer += decoder.decode(chunk, { stream: true });\n    92\t      let end;\n    93\t      while ((end = buffer.indexOf(\"\\n\\n\")) >= 0) {\n    94\t        const block = buffer.slice(0, end);\n    95\t        buffer = buffer.slice(end + 2);\n    96\t        if (!block.includes(\"event: entry\")) continue;\n    97\t        const data = block.split(\"\\n\").find((line) => line.startsWith(\"data: \"));\n    98\t        const entry = JSON.parse(data.slice(6));\n    99\t        for (const message of entry.messages ?? []) {\n   100\t          if (message.role !== \"assistant\") continue;\n   101\t          calls += (message.calls ?? []).length;\n   102\t          if (calls > 0 && (message.text ?? \"\").toLowerCase().includes(needle.toLowerCase())) {\n   103\t            result = `found ${calls}`;\n   104\t            break outer;\n   105\t          }\n   106\t        }\n   107\t      }\n   108\t    }\n   109\t  } catch {\n   110\t    // Aborted by the timer.\n   111\t  }\n   112\t  clearTimeout(timer);\n   113\t  controller.abort();\n   114\t  console.log(result);\n   115\t} else {\n   116\t  throw new Error(\"usage: call|stream|dump|answer\");\n   117\t}\n","isError":false}]}
