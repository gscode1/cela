ENTRY 12188 {"id":12188,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"    55\t        ? [{ callId: String(s.callId), name: String(s.name), status: String(s.status) }]\n    56\t        : [];\n    57\t    });\n    58\t  }\n    59\t  const failure = asObject(live?.runFailure);\n    60\t  if (typeof failure?.reason === \"string\") event.runFailure = failure.reason;\n    61\t  return event;\n    62\t}\n    63\t\n    64\t/** Only entries that carry model messages are streamed (inputs, answers, tool calls and results). */\n    65\tfunction entryEvent(\n    66\t  entry: EntryRecord,\n    67\t): { id: number; kind: string; messages: unknown[] } | undefined {\n    68\t  // System messages (the rendered system prompt) are the host's, not the conversation's: never streamed.\n    69\t  const messages = (entry.model ?? []).filter((message) => message.role !== \"system\");\n    70\t  if (messages.length === 0) return undefined;\n    71\t  return { id: entry.id, kind: entry.kind, messages: messages.map(toEvent) };\n    72\t}\n    73\t\n    74\texport function parseLastEventId(header: string | string[] | undefined): number {\n    75\t  const raw = Array.isArray(header) ? header[0] : header;\n    76\t  const value = Number(raw);\n    77\t  return raw !== undefined && Number.isSafeInteger(value) && value > 0 ? value : 0;\n    78\t}\n    79\t\n    80\t/**\n    81\t * Writes a chunk and waits for the socket to drain, or for the client to go away. Whichever event loses the race must\n    82\t * drop its listener: a slow client under backpressure would otherwise pile up one `close` listener per write.\n    83\t */\n    84\texport async function write(res: ServerResponse, chunk: string): Promise<void> {\n    85\t  if (res.destroyed || res.writableEnded) return;\n    86\t  if (!res.write(chunk)) {\n    87\t    const done = new AbortController();\n    88\t    try {\n    89\t      await Promise.race([\n    90\t        once(res, \"drain\", { signal: done.signal }),\n    91\t        once(res, \"close\", { signal: done.signal }),\n    92\t      ]);\n    93\t    } catch {\n    94\t      // the stream failed or was aborted; the caller sees the closed response on its next write\n    95\t    } finally {\n    96\t      done.abort();\n    97\t    }\n    98\t  }\n    99\t}\n   100\t\n   101\t/**\n   102\t * Server-sent events for one conversation, built on `Conversation.watch()` (the conversation view).\n   103\t *\n   104\t *  - `event: entry`, `id: <entry id>`: a committed transcript entry, once, in order. The id is the cursor.\n   105\t *  - `event: live`, no id: the run in progress (partial answer, tool calls, queue). Sent whole on connect and\n   140\t    clearInterval(keepalive);\n   141\t    unregister();\n   142\t    void watch.stop();\n   143\t    if (res.writableEnded || res.destroyed) return;\n   144\t    if (reason !== undefined) res.write(`event: ${reason}\\ndata: {}\\n\\n`);\n   145\t    res.end();\n   146\t  };\n   147\t  const keepalive = setInterval(() => {\n   148\t    if (!res.destroyed) res.write(\": keepalive\\n\\n\");\n   149\t  }, KEEPALIVE_MS);\n   150\t  const unregister = streams.add(sessionId, finish);\n   151\t  res.on(\"close\", () => finish());\n   152\t\n   153\t  const sendEntry = async (entry: EntryRecord): Promise<void> => {\n   154\t    if (entry.id <= cursor) return;\n   155\t    cursor = entry.id;\n   156\t    const event = entryEvent(entry);\n   157\t    if (event !== undefined) {\n   158\t      await write(res, `id: ${String(event.id)}\\nevent: entry\\ndata: ${JSON.stringify(event)}\\n\\n`);\n   159\t    }\n   160\t  };\n   161\t\n   162\t  const emit = async (view: ConversationView): Promise<void> => {\n   163\t    // The window may start after the client's cursor (long outage, or a fresh connect): read the gap.\n   164\t    if (view.before !== undefined && view.before > cursor) {\n   165\t      let after = cursor;\npackages/orchestrator/test/sweeper.test.ts:10:  const calls: string[] = [];\npackages/orchestrator/test/fake-onecli.ts:26:  readonly calls: string[] = [];\npackages/orchestrator/test/host-workspace-env.test.ts:49:    const calls: string[] = [];\npackages/orchestrator/test/sandboxes-lifecycle.test.ts:40:let ledger: { calls: string[]; fn: (id: number, on: boolean) => Promise<void> };\npackages/orchestrator/test/sandboxes-lifecycle.test.ts:71:  const calls: string[] = [];\npackages/orchestrator/src/repo-access.ts:64: * Plain sessions never reach this class's OneCLI calls: every entry point returns at `session.repo === null`.\n","isError":false}]}
