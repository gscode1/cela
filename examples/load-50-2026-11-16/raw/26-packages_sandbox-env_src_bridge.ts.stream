ENTRY 12465 {"id":12465,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/vendor/agent-sandbox-client/src/types.ts:224:  onStdout?(chunk: Uint8Array): void;\npackages/vendor/agent-sandbox-client/src/types.ts:225:  onStderr?(chunk: Uint8Array): void;\npackages/vendor/agent-sandbox-client/src/sandbox.ts:1169:    for (const name of [\"onStdout\", \"onStderr\"] as const) {\npackages/vendor/agent-sandbox-client/src/sandbox.ts:1246:          onStdout: opts?.onStdout,\npackages/vendor/agent-sandbox-client/src/sandbox.ts:1247:          onStderr: opts?.onStderr,\npackages/vendor/agent-sandbox-client/src/commands.ts:127: * either by passing `onStdout`/`onStderr` to `start()`, by iterating\npackages/vendor/agent-sandbox-client/src/commands.ts:161:    private readonly callbacks: Pick<StartOptions, \"onStdout\" | \"onStderr\">,\npackages/vendor/agent-sandbox-client/src/commands.ts:173:    if (callbacks.onStdout || callbacks.onStderr) {\npackages/vendor/agent-sandbox-client/src/commands.ts:395:        if (event.type === \"stdout\") this.callbacks.onStdout?.(event.data);\npackages/vendor/agent-sandbox-client/src/commands.ts:396:        else if (event.type === \"stderr\") this.callbacks.onStderr?.(event.data);\npackages/vendor/agent-sandbox-client/README.md:316:  onStdout: (chunk) => process.stdout.write(chunk),\npackages/vendor/agent-sandbox-client/README.md:328:- **Consuming output**: pass `onStdout`/`onStderr`, iterate `handle.events`, or call `handle.wait()` (which discards the output). These are mutually exclusive — `events` throws once callbacks or `wait()` are in use — except that `wait()` takes over from an `events` loop you have left. Nothing is buffered on the SDK side: until one of them is in use the stream is not read, and the process blocks once its pipe fills. Output arrives as `Uint8Array`, since a multi-byte character can straddle two chunks. If a callback throws, the process is killed and `wait()` rejects with that error.\nimport { createHash, randomBytes } from \"node:crypto\";\nimport { PassThrough, Readable } from \"node:stream\";\nimport { describe, expect, it } from \"vitest\";\nimport { runBridge } from \"../src/bridge.ts\";\nimport { localStart } from \"./local-start.ts\";\n\nfunction collect(stream: PassThrough): () => Buffer {\n  const chunks: Buffer[] = [];\n  stream.on(\"data\", (chunk: Buffer) => chunks.push(chunk));\n  return () => Buffer.concat(chunks);\n}\n\nfunction sha256(data: Uint8Array): string {\n  return createHash(\"sha256\").update(data).digest(\"hex\");\n}\n\nfunction chunked(data: Buffer, size: number): Readable {\n  const parts: Buffer[] = [];\n  for (let i = 0; i < data.length; i += size) parts.push(data.subarray(i, i + size));\n  return Readable.from(parts, { objectMode: false });\n}\n\ndescribe(\"runBridge\", () => {\n  it(\"round-trips 8 MiB of random bytes through cat unchanged\", async () => {\n    const payload = randomBytes(8 * 1024 * 1024);\n    const stdout = new PassThrough();\n    const stderr = new PassThrough();\n    const out = collect(stdout);\n    const code = await runBridge({\n      start: localStart(),\n      command: \"cat\",\n      args: [],\n      // Odd chunk size so frames never align with the 4 KiB / 1 MiB boundaries of the real path.\n      stdin: chunked(payload, 60_001),\n      stdout,\n      stderr,\n    });\n    expect(code).toBe(0);\n    const received = out();\n    expect(received.length).toBe(payload.length);\n    expect(sha256(received)).toBe(sha256(payload));\n  }, 30_000);\n\n  it(\"keeps remote stderr off stdout\", async () => {\n    const stdout = new PassThrough();\n    const stderr = new PassThrough();\n    const out = collect(stdout);\n    const err = collect(stderr);\n    const code = await runBridge({\n      start: localStart({ command: \"sh\", args: [\"-c\", \"echo out; echo err >&2\"] }),\n      command: \"ignored\",\n      args: [],\n      stdin: Readable.from([]),\n      stdout,\n      stderr,\n    });\n    expect(code).toBe(0);\n    expect(out().toString()).toBe(\"out\\n\");\n    expect(err().toString()).toBe(\"bridge: ready\\nerr\\n\");\n  }, 15_000);\n\n  it(\"exits non-zero and kills the remote process when a stdin write fails\", async () => {\n    let closed = false;\n    const stderr = new PassThrough();\n    const err = collect(stderr);\n    const code = await runBridge({\n      start: localStart({\n        command: \"cat\",\n        args: [],\n        write: async (_data, real, call) => {\n          if (call === 2) throw new Error(\"rpc unavailable\");\n          await real();\n        },\n        onClose: () => {\n          closed = true;\n        },\n      }),\n      command: \"cat\",\n      args: [],\n      stdin: chunked(randomBytes(1024 * 1024), 4096),\n      stdout: new PassThrough(),\n      stderr,\n    });\n    expect(code).not.toBe(0);\n    expect(closed).toBe(true);\n    expect(err().toString()).toContain(\"rpc unavailable\");\n  }, 15_000);\n\n  it(\"never has two stdin writes in flight\", async () => {\n    let inFlight = 0;\n    let maxInFlight = 0;\n    const stdout = new PassThrough();\n    collect(stdout);\n    const code = await runBridge({\n      start: localStart({\n        command: \"cat\",\n        args: [],\n        write: async (_data, real) => {\n          maxInFlight = Math.max(maxInFlight, ++inFlight);\n          await new Promise((resolve) => setTimeout(resolve, 1));\n          await real();\n          inFlight--;\n        },\n      }),\n      command: \"cat\",\n      args: [],\n      stdin: chunked(randomBytes(64 * 1024), 1024),\n      stdout,\n      stderr: new PassThrough(),\n    });\n    expect(code).toBe(0);\n    expect(maxInFlight).toBe(1);\n  }, 15_000);\n\n  it(\"propagates the remote exit code after stdin ends\", async () => {\n    const code = await runBridge({\n      start: localStart({ command: \"sh\", args: [\"-c\", \"cat >/dev/null; exit 7\"] }),\n      command: \"ignored\",\n      args: [],\n      stdin: Readable.from([Buffer.from(\"x\")]),\n      stdout: new PassThrough(),\n      stderr: new PassThrough(),\n    });\n    expect(code).toBe(7);\n  }, 15_000);\n\n  it(\"propagates the remote exit code while stdin is still open\", async () => {\n    const code = await runBridge({\n      start: localStart({ command: \"sh\", args: [\"-c\", \"exit 3\"] }),\n      command: \"ignored\",\n      args: [],\n      stdin: new PassThrough(),\n      stdout: new PassThrough(),\n      stderr: new PassThrough(),\n    });\n    expect(code).toBe(3);\n  }, 15_000);\n\n  it(\"maps a signal death to a non-zero code\", async () => {\n    const code = await runBridge({\n      start: localStart({ command: \"sh\", args: [\"-c\", \"kill -9 $$\"] }),\n      command: \"ignored\",\n      args: [],\n      stdin: new PassThrough(),\n      stdout: new PassThrough(),\n      stderr: new PassThrough(),\n    });\n    expect(code).toBe(1);\n  }, 15_000);\n\n  it(\"exits non-zero when the process cannot be started\", async () => {\n    const stderr = new PassThrough();\n    const err = collect(stderr);\n    const code = await runBridge({\n      start: () => Promise.reject(new Error(\"claim not found\")),\n      command: \"pi-env\",\n      args: [\"serve\"],\n      stdin: new PassThrough(),\n      stdout: new PassThrough(),\n      stderr,\n    });\n    expect(code).toBe(1);\n    expect(err().toString()).toContain(\"claim not found\");\n  }, 15_000);\n});\npackages/sandbox-env/test/bridge.test.ts:59:    expect(err().toString()).toBe(\"bridge: ready\\nerr\\n\");\npackages/sandbox-env/test/start-gate.test.ts:2:import { BRIDGE_READY } from \"../src/bridge.ts\";\npackages/sandbox-env/test/start-gate.test.ts:66:    a.onLog(`${BRIDGE_READY}\\n`);\npackages/sandbox-env/test/start-gate.test.ts:97:    a.onLog(`${BRIDGE_READY}\\n`);\npackages/sandbox-env/src/bridge.ts:25:export const BRIDGE_READY = \"bridge: ready\";\npackages/sandbox-env/src/bridge.ts:72:  stderr.write(`${BRIDGE_READY}\\n`);\npackages/sandbox-env/src/start-gate.ts:1:import { BRIDGE_READY } from \"./bridge.js\";\npackages/sandbox-env/src/start-gate.ts:80:      if (text.includes(BRIDGE_READY)) free();\n","isError":false}]}
