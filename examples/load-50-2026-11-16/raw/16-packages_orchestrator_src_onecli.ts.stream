ENTRY 11631 {"id":11631,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport { readFile } from \"node:fs/promises\";\n     2\timport type { Models } from \"@earendil-works/pi-ai\";\n     3\timport { createModels } from \"@earendil-works/pi-ai/models\";\n     4\timport { builtinProviders } from \"@earendil-works/pi-ai/providers/all\";\n     5\timport { modelKey } from \"@pi-durable-k8s/session-core\";\n     6\timport type { OrchestratorConfig } from \"./config.js\";\n     7\timport { scriptedProvider } from \"./model.js\";\n     8\timport {\n     9\t  createGatewayFetch,\n    10\t  placeholderAuthContext,\n    11\t  placeholderCredentials,\n    12\t  withFetch,\n    13\t} from \"./onecli.js\";\n    14\t\n    15\tconst LOCAL = new Set([\"scripted\", \"faux\"]);\n    16\t\n    17\t/**\n    18\t * The `Models` of the orchestrator.\n    19\t *\n    20\t * Pi Durable stores a conversation's model as `{ provider, modelId }` names and resolves them against this `Models`\n    21\t * at every request, so every provider a stored conversation may name must be installed at every start: the\n    22\t * allowlist's providers, the scripted ones, and `faux` for the Phase 3 /control sessions.\n    23\t *\n    24\t * Real providers resolve their API key to a placeholder (`placeholderAuthContext`) and send their requests through\n    25\t * the OneCLI gateway, which replaces the placeholder with the credential it holds. Throws when an allowlisted model\n    26\t * is not in pi-ai's catalog, so a typo in the ConfigMap fails at start instead of at the first request.\n    27\t */\n    28\texport async function buildModels(\n    29\t  config: OrchestratorConfig,\n    30\t  readCa: (path: string) => Promise<string> = (path) => readFile(path, \"utf8\"),\n    31\t): Promise<Models> {\n    32\t  const models = createModels({\n    33\t    authContext: placeholderAuthContext,\n    34\t    credentials: await placeholderCredentials(config.onecli.codexAccountId),\n    35\t  });\n    36\t  models.setProvider(scriptedProvider({ provider: \"faux\" }).provider);\n    37\t  models.setProvider(\n    38\t    scriptedProvider({\n    39\t      provider: \"scripted\",\n    40\t      models: [{ id: \"scripted-1\" }, { id: \"scripted-2\" }],\n    41\t    }).provider,\n    42\t  );\n    43\t\n    44\t  const remote = config.models.allowed.filter((choice) => !LOCAL.has(choice.provider));\n    45\t  const token = config.onecli.token;\n    46\t  if (remote.length === 0 || token === undefined) {\n    47\t    assertInstalled(models, config);\n    48\t    return models;\n    49\t  }\n    50\t  const wanted = new Set(remote.map((choice) => choice.provider));\n    51\t  for (const provider of builtinProviders()) {\n    52\t    if (wanted.has(provider.id)) models.setProvider(provider);\n    53\t  }\n    54\t  assertInstalled(models, config);\n    55\t  const ca = await readCa(config.onecli.caFile);\n    56\t  return withFetch(\n    57\t    models,\n    58\t    createGatewayFetch({\n    59\t      gateway: config.onecli.gateway,\n    60\t      token,\n    61\t      ca,\n    62\t      noProxy: config.onecli.noProxy,\n    63\t    }),\n    64\t  );\n    65\t}\n    66\t\n    67\tfunction assertInstalled(models: Models, config: OrchestratorConfig): void {\n    68\t  for (const choice of config.models.allowed) {\n    69\t    if (models.getModel(choice.provider, choice.model) === undefined) {\n    70\t      throw new Error(`allowed model ${modelKey(choice)} is not known to pi-ai`);\n    71\t    }\n    72\t  }\n    73\t}\n     1\timport { createServer } from \"node:http\";\n     2\timport type { IncomingHttpHeaders, Server } from \"node:http\";\n     3\timport type { AddressInfo } from \"node:net\";\n     4\timport { inspect } from \"node:util\";\n     5\timport { afterEach, describe, expect, it } from \"vitest\";\n     6\timport {\n     7\t  bypassesProxy,\n     8\t  createGatewayFetch,\n     9\t  parseNoProxy,\n    10\t  placeholderAuthContext,\n    11\t  PLACEHOLDER_API_KEY,\n    12\t  Redacted,\n    13\t} from \"../src/onecli.ts\";\n    14\t\n    15\tconst TOKEN = \"aoc_0123456789abcdef0123456789abcdef\";\n    16\t\n    17\tdescribe(\"Redacted\", () => {\n    18\t  it(\"never prints, however it is formatted or logged\", () => {\n    19\t    const secret = new Redacted(TOKEN);\n    20\t    expect(secret.reveal()).toBe(TOKEN);\n    21\t    expect(JSON.stringify({ token: secret })).not.toContain(TOKEN);\n    22\t    expect(String(secret)).not.toContain(TOKEN);\n    23\t    expect(String(secret)).toBe(\"[redacted]\");\n    24\t    expect(inspect({ onecli: { token: secret } }, { depth: 5 })).not.toContain(TOKEN);\n    25\t  });\n    26\t});\n    27\t\n    28\tdescribe(\"placeholderAuthContext\", () => {\n    29\t  it(\"answers provider key lookups with the placeholder, whatever the process environment holds\", async () => {\n    30\t    process.env.OPENROUTER_API_KEY = \"sk-real-should-never-be-used\";\n    31\t    try {\n    32\t      expect(await placeholderAuthContext.env(\"OPENROUTER_API_KEY\")).toBe(PLACEHOLDER_API_KEY);\n    33\t      expect(await placeholderAuthContext.env(\"OPENAI_API_KEY\")).toBe(PLACEHOLDER_API_KEY);\n    34\t      expect(await placeholderAuthContext.env(\"HOME\")).toBeUndefined();\n    35\t      expect(await placeholderAuthContext.fileExists()).toBe(false);\n    36\t    } finally {\n    37\t      delete process.env.OPENROUTER_API_KEY;\n    38\t    }\n    39\t  });\n    40\t});\n    41\t\n    42\tdescribe(\"NO_PROXY matching\", () => {\n    43\t  const noProxy = parseNoProxy(\n    44\t    \" .svc, kubernetes.default ,pi-pg-rw,10.0.0.0/8,.cluster.local,db:5432\",\n    45\t  );\n    46\t  const bypass = (url: string): boolean => bypassesProxy(new URL(url), noProxy);\n    47\t\n    48\t  it(\"keeps the cluster, the Kubernetes API and Postgres off the gateway\", () => {\n    49\t    expect(bypass(\"https://kubernetes.default.svc/api\")).toBe(true);\n    50\t    expect(bypass(\"https://kubernetes.default/api\")).toBe(true);\n    51\t    expect(bypass(\"http://sandbox-x.pi-durable-poc.svc:8888/\")).toBe(true);\n    52\t    expect(bypass(\"http://pi-pg-rw:5432/\")).toBe(true);\n    53\t    expect(bypass(\"http://pi-pg-rw.pi-durable-poc.svc.cluster.local:5432/\")).toBe(true);\n    54\t    expect(bypass(\"http://10.43.0.1:443/\")).toBe(true);\n    55\t    expect(bypass(\"http://db:5432/\")).toBe(true);\n    56\t  });\n    57\t\n    58\t  it(\"sends public model hosts through it\", () => {\n    59\t    expect(bypass(\"https://openrouter.ai/api/v1/chat/completions\")).toBe(false);\n    60\t    expect(bypass(\"https://api.openai.com/v1/responses\")).toBe(false);\n    61\t    expect(bypass(\"http://db:8080/\")).toBe(false);\n    62\t    expect(bypass(\"http://11.0.0.1/\")).toBe(false);\n    63\t    // Suffix matching is on whole labels.\n    64\t    expect(bypass(\"https://evilsvc/\")).toBe(false);\n    65\t    expect(bypass(\"https://notpi-pg-rw/\")).toBe(false);\n    66\t  });\n    67\t\n    68\t  it(\"supports the wildcard\", () => {\n    69\t    expect(bypassesProxy(new URL(\"https://openrouter.ai/\"), [\"*\"])).toBe(true);\n    70\t  });\n    71\t});\n    72\t\n    73\tdescribe(\"createGatewayFetch\", () => {\n    74\t  const servers: Server[] = [];\n    75\t  afterEach(() => {\n    76\t    for (const server of servers.splice(0)) server.close();\n    77\t  });\n    78\t\n    79\t  async function listen(\n    80\t    onRequest: (url: string, headers: IncomingHttpHeaders) => void,\n    81\t  ): Promise<string> {\n    82\t    const server = createServer((req, res) => {\n    83\t      onRequest(req.url ?? \"\", req.headers);\n    84\t      res.end(\"ok\");\n    85\t    });\n    86\t    servers.push(server);\n    87\t    await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n    88\t    return `http://127.0.0.1:${String((server.address() as AddressInfo).port)}`;\n    89\t  }\n    90\t\n    91\t  it(\"sends model calls to the gateway with the agent token, and bypassed hosts directly\", async () => {\n    92\t    const viaGateway: { url: string; headers: IncomingHttpHeaders }[] = [];\n    93\t    const direct: string[] = [];\n    94\t    const gateway = await listen((url, headers) => viaGateway.push({ url, headers }));\n    95\t    const local = await listen((url) => direct.push(url));\n    96\t    const fetchViaGateway = createGatewayFetch({\n    97\t      gateway,\n    98\t      token: new Redacted(TOKEN),\n    99\t      ca: \"\",\n   100\t      noProxy: [\"127.0.0.1\"],\n   101\t    });\n   102\t\n   103\t    // Plain http so the fake gateway sees the whole request; https adds a CONNECT tunnel and the same header.\n   104\t    const modelCall = await fetchViaGateway(\"http://models.example.test/v1/chat/completions\", {\n   105\t      method: \"POST\",\n   106\t      body: \"{}\",\n   107\t    });\n   108\t    expect(await modelCall.text()).toBe(\"ok\");\n   109\t    expect(viaGateway).toHaveLength(1);\n   110\t    expect(viaGateway[0]?.url).toBe(\"http://models.example.test/v1/chat/completions\");\n   111\t    const expected = `Basic ${Buffer.from(`x:${TOKEN}`).toString(\"base64\")}`;\n   112\t    expect(viaGateway[0]?.headers[\"proxy-authorization\"]).toBe(expected);\n   113\t\n   114\t    await (await fetchViaGateway(`${local}/health`)).text();\n   115\t    expect(direct).toEqual([\"/health\"]);\n   116\t    expect(viaGateway).toHaveLength(1);\n   117\t  });\n   118\t\n   119\t  it(\"does not change the process-wide fetch or proxy settings\", () => {\n   120\t    const before = globalThis.fetch;\n   121\t    createGatewayFetch({\n   122\t      gateway: \"http://127.0.0.1:1\",\n   123\t      token: new Redacted(TOKEN),\n   124\t      ca: \"\",\n   125\t      noProxy: [],\n   126\t    });\n   127\t    expect(globalThis.fetch).toBe(before);\n   128\t    expect(process.env.HTTPS_PROXY).toBeUndefined();\n   129\t    expect(process.env.HTTP_PROXY).toBeUndefined();\n   130\t  });\n   131\t});\n{\n  \"name\": \"@pi-durable-k8s/orchestrator\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"description\": \"Pi Durable host: Postgres storage, inbox consumer, SSE streams, one sandbox per conversation, scripted model.\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.19.0\"\n  },\n  \"scripts\": {\n    \"build\": \"rm -rf dist && tsc -p tsconfig.build.json\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\"\n  },\n  \"dependencies\": {\n    \"@earendil-works/chord\": \"1.5.2\",\n    \"@earendil-works/pi-ai\": \"1.5.2\",\n    \"@earendil-works/pi-durable\": \"1.5.2\",\n    \"@kubernetes/client-node\": \"2.0.0\",\n    \"@netzlabor/pi-durable-postgres\": \"file:../../vendor/netzlabor-pi-durable-postgres-0.2.0.tgz\",\n    \"@pi-durable-k8s/sandbox-env\": \"workspace:*\",\n    \"@pi-durable-k8s/session-core\": \"workspace:*\",\n    \"undici\": \"8.12.4\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"22.20.5\",\n    \"@types/pg\": \"8.23.1\",\n    \"typescript\": \"7.0.2\",\n    \"vitest\": \"5.1.0\"\n  }\n}\ningest\norchestrator\nsandbox-env\nsession-core\nvendor\n","isError":false}]}
ENTRY 11654 {"id":11654,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && sed -n '85,150p' packages/orchestrator/src/onecli.ts && sed -n '152,199p' packages/orchestrator/src/onecli.ts && grep -n -E 'DEFAULT_NO_PROXY|NO_PROXY|gateway' packages/orchestrator/src/config.ts; ls -a | head; find . -iname '*undici*' | head\"})"]}]}
ENTRY 11664 {"id":11664,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"    }),\n  );\n  return store;\n}\n\nexport function parseNoProxy(value: string | undefined): string[] {\n  return (value ?? \"\")\n    .split(\",\")\n    .map((entry) => entry.trim().toLowerCase())\n    .filter((entry) => entry !== \"\");\n}\n\n/**\n * `NO_PROXY` matching as curl and Go do it: `*` matches everything, `.suffix` and `suffix` match the host and its\n * subdomains, an IPv4 CIDR matches addresses in the block, and a port, when given, must match.\n */\nexport function bypassesProxy(url: URL, noProxy: readonly string[]): boolean {\n  const host = url.hostname.toLowerCase().replace(/^\\[|\\]$/g, \"\");\n  const port = url.port || (url.protocol === \"https:\" ? \"443\" : \"80\");\n  for (const entry of noProxy) {\n    if (entry === \"*\") return true;\n    const [pattern, entryPort] = splitPort(entry);\n    if (entryPort !== undefined && entryPort !== port) continue;\n    if (pattern.includes(\"/\")) {\n      if (inCidr(host, pattern)) return true;\n      continue;\n    }\n    const bare = pattern.replace(/^\\*?\\./, \"\");\n    if (host === bare || host.endsWith(`.${bare}`)) return true;\n  }\n  return false;\n}\n\nfunction splitPort(entry: string): [string, string | undefined] {\n  const match = /^(.*):(\\d+)$/.exec(entry);\n  return match?.[1] === undefined ? [entry, undefined] : [match[1], match[2]];\n}\n\nfunction ipv4ToInt(address: string): number | undefined {\n  const parts = address.split(\".\");\n  if (parts.length !== 4) return undefined;\n  let value = 0;\n  for (const part of parts) {\n    const octet = Number(part);\n    if (!/^\\d{1,3}$/.test(part) || octet > 255) return undefined;\n    value = value * 256 + octet;\n  }\n  return value;\n}\n\nfunction inCidr(host: string, cidr: string): boolean {\n  const [network = \"\", bitsText = \"\"] = cidr.split(\"/\");\n  const address = ipv4ToInt(host);\n  const base = ipv4ToInt(network);\n  const bits = Number(bitsText);\n  if (address === undefined || base === undefined || !Number.isInteger(bits)) return false;\n  if (bits < 0 || bits > 32) return false;\n  const size = 2 ** (32 - bits);\n  return Math.floor(address / size) === Math.floor(base / size);\n}\n\n/**\n * A `fetch` for model calls only. Requests go through the OneCLI gateway with the orchestrator's agent token\n * (`Proxy-Authorization`, basic with any username) and trust the gateway CA for the certificates it issues.\n * The dispatcher belongs to this function: nothing sets a process-wide proxy or changes the global dispatcher,\n * so the Kubernetes client, Postgres and the bridges are never proxied. Hosts in `noProxy` skip the gateway.\nexport function createGatewayFetch(config: OneCliConfig): FetchFunction {\n  const proxy = new ProxyAgent({\n    uri: config.gateway,\n    token: `Basic ${Buffer.from(`x:${config.token.reveal()}`).toString(\"base64\")}`,\n    requestTls: { ca: [...rootCertificates, config.ca] },\n  });\n  const gatewayFetch = (\n    input: Parameters<FetchFunction>[0],\n    init?: Parameters<FetchFunction>[1],\n  ) => {\n    const url = new URL(input instanceof Request ? input.url : input.toString());\n    if (bypassesProxy(url, config.noProxy)) return globalThis.fetch(input, init);\n    // undici's fetch and its own ProxyAgent: the same undici version on both sides of the dispatcher call.\n    return undiciFetch(\n      input as Parameters<typeof undiciFetch>[0],\n      { ...init, dispatcher: proxy } as Parameters<typeof undiciFetch>[1],\n    ) as unknown as ReturnType<FetchFunction>;\n  };\n  return gatewayFetch;\n}\n\n/**\n * The `Models` the Harness sees, with every stream request carrying `fetch`. Pi Durable has no per-conversation\n * hook for pi-ai's `fetch` option, so the wrapper adds it where the Harness calls `streamSimple` and `stream`.\n */\nexport function withFetch(models: MutableModels, fetch: FetchFunction): Models {\n  return new Proxy(models, {\n    get(target, property, receiver): unknown {\n      const value: unknown = Reflect.get(target, property, receiver);\n      if (typeof value !== \"function\") return value;\n      const method = value as (...args: unknown[]) => unknown;\n      if (\n        property === \"streamSimple\" ||\n        property === \"stream\" ||\n        property === \"completeSimple\" ||\n        property === \"complete\"\n      ) {\n        return (model: unknown, context: unknown, options?: Record<string, unknown>) =>\n          // `sse`: the Codex provider defaults to a WebSocket, which is not proven through the gateway.\n          method.call(target, model, context, {\n            transport: \"sse\",\n            ...options,\n            fetch: options?.fetch ?? fetch,\n          });\n      }\n      return method.bind(target);\n    },\n  });\n46:  /** Where model calls go. `token` is set only when some allowed provider needs the gateway. */\n48:    gateway: string;\n52:    /** Account id inside the OpenAI Codex placeholder token. The gateway injects the real one; see `codexPlaceholderToken`. */\n60:    /** Management API of OneCLI v2, `:10256`. The proxy (`onecli.gateway`) is a different port. */\n69: * Hosts a model call must never be proxied to: the cluster, the Kubernetes API and Postgres. The gateway refuses\n70: * private targets anyway; this keeps them off it. The deployment also exports it as `NO_PROXY`, and an entry\n71: * of `NO_PROXY` in the environment adds to it.\n73:export const DEFAULT_NO_PROXY = [\n143:      gateway: env.PI_ONECLI_GATEWAY ?? \"http://onecli.onecli:10255\",\n145:      noProxy: [...DEFAULT_NO_PROXY, ...parseNoProxy(env.NO_PROXY)],\n.\n..\n.git\n.gitignore\n.prettierignore\n.prettierrc.json\nAGENT.md\nCLAUDE.md\nLICENSE\nREADME.md\n","isError":false}]}
ENTRY 11700 {"id":11700,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n\n### 1. IPv6 NO_PROXY entries do not match IPv6 hosts\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/onecli.ts:118\n- What happens: An entry such as `::1` is interpreted as pattern `:` with port `1`, while `[::1]` retains brackets that were removed from the URL hostname. Consequently, a model request to an IPv6 host configured for direct access is sent to the gateway instead, potentially failing if the gateway rejects private targets.\n- Evidence: `const match = /^(.*):(\\d+)$/.exec(entry);`\n- Fix idea: Parse bracketed IPv6 addresses and optional ports explicitly, and treat unbracketed IPv6 literals as addresses rather than host-and-port pairs.\n\n### 2. Redirects do not re-evaluate NO_PROXY\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/onecli.ts:163\n- What happens: The proxy decision is made only for the initial URL. If a directly accessed host redirects to a public model host, fetch follows the redirect directly rather than through OneCLI; conversely, a proxied host redirecting to a NO_PROXY host remains proxied. Requests can therefore fail or bypass the intended gateway routing.\n- Evidence: `if (bypassesProxy(url, config.noProxy)) return globalThis.fetch(input, init);`\n- Fix idea: Make the routing decision for each redirect target, for example by handling redirects explicitly or using a dispatcher that selects the route per request.\n\nEND-OF-REPORT"}]}
DONE
