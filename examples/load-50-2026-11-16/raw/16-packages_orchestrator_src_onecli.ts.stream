ckages/orchestrator/src/onecli.ts:152:export function createGatewayFetch(config: OneCliConfig): FetchFunction {\npackages/orchestrator/src/onecli.ts:163:    if (bypassesProxy(url, config.noProxy)) return globalThis.fetch(input, init);\npackages/orchestrator/src/onecli.ts:177:export function withFetch(models: MutableModels, fetch: FetchFunction): Models {\npackages/orchestrator/src/config.ts:4:import { parseNoProxy, PLACEHOLDER_API_KEY, Redacted } from \"./onecli.js\";\npackages/orchestrator/src/config.ts:145:      noProxy: [...DEFAULT_NO_PROXY, ...parseNoProxy(env.NO_PROXY)],\npackages/orchestrator/src/providers.ts:9:  createGatewayFetch,\npackages/orchestrator/src/providers.ts:10:  placeholderAuthContext,\npackages/orchestrator/src/providers.ts:11:  placeholderCredentials,\npackages/orchestrator/src/providers.ts:12:  withFetch,\npackages/orchestrator/src/providers.ts:24: * Real providers resolve their API key to a placeholder (`placeholderAuthContext`) and send their requests through\npackages/orchestrator/src/providers.ts:33:    authContext: placeholderAuthContext,\npackages/orchestrator/src/providers.ts:34:    credentials: await placeholderCredentials(config.onecli.codexAccountId),\npackages/orchestrator/src/providers.ts:56:  return withFetch(\npackages/orchestrator/src/providers.ts:58:    createGatewayFetch({\n","isError":false}]}
