ENTRY 11614 {"id":11614,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { createHash, timingSafeEqual } from \"node:crypto\";\nimport type { IncomingHttpHeaders } from \"node:http\";\n\n/** Who is calling. `owner` is recorded on every session and checked on every call. */\nexport interface Principal {\n  /** Display name of the token entry. */\n  owner: string;\n  /**\n   * Stable identity of the caller, stored on every session and compared on every call. For a static token it is\n   * `static:<owner>`; an OIDC verifier returns the token's `iss` + `sub` here.\n   */\n  subject: string;\n}\n\n/**\n * The single seam for authentication. Ingest and the orchestrator call this and nothing else, so an OIDC\n * verifier replaces `tokenAuthenticator` without touching a route. Resolves to undefined for \"not authenticated\".\n */\nexport type Authenticator = (headers: IncomingHttpHeaders) => Promise<Principal | undefined>;\n\nconst OWNER = /^[a-z0-9][a-z0-9_-]{0,62}$/;\nconst MIN_TOKEN_LENGTH = 16;\n\nconst digest = (value: string): Buffer => createHash(\"sha256\").update(value).digest();\n\n/**\n * Static bearer tokens from a Kubernetes Secret, one `owner:token` entry per line (or comma). Every\n * candidate is compared in constant time, so the answer does not depend on which entry matched.\n * Error messages never contain a token.\n */\nexport function tokenAuthenticator(spec: string): Authenticator {\n  const entries = spec\n    .split(/[\\n,]/)\n    .map((line) => line.trim())\n    .filter((line) => line !== \"\")\n    .map((line, index) => {\n      const at = line.indexOf(\":\");\n      const owner = at < 0 ? \"\" : line.slice(0, at);\n      const token = at < 0 ? \"\" : line.slice(at + 1);\n      if (!OWNER.test(owner) || token.length < MIN_TOKEN_LENGTH) {\n        throw new Error(\n          `API token entry ${String(index + 1)} must be owner:token (token at least ${String(MIN_TOKEN_LENGTH)} characters)`,\n        );\n      }\n      return { owner, hash: digest(token) };\n    });\n  if (entries.length === 0) throw new Error(\"no API tokens configured\");\n\n  return (headers) => {\n    const header = headers.authorization;\n    const match = typeof header === \"string\" ? /^Bearer +(\\S+)$/i.exec(header) : null;\n    const presented = digest(match?.[1] ?? \"\");\n    let found: string | undefined;\n    for (const entry of entries) {\n      if (timingSafeEqual(entry.hash, presented) && match !== null) found = entry.owner;\n    }\n    return Promise.resolve(\n      found === undefined ? undefined : { owner: found, subject: `static:${found}` },\n    );\n  };\n}\ndeploy/gen-api-secret.sh:17:printf 'alice:%s\\nbob:%s' \"$(openssl rand -hex 32)\" \"$(openssl rand -hex 32)\" >\"$tmp/tokens\"\n  let connections = 0;\n  let entries = 0;\n\n  while (Date.now() < deadline) {\n    connections++;\n    const controller = new AbortController();\n    const timer = setTimeout(() => controller.abort(), Math.max(1, deadline - Date.now()));\n    let res;\n    try {\n      res = await fetch(`${base}/sessions/${sessionId}/stream`, {\n        headers: {\n          ...auth(),\n          accept: \"text/event-stream\",\n          ...(last > 0 ? { \"last-event-id\": String(last) } : {}),\n        },\n        signal: controller.signal,\n      });\n    } catch {\n      console.log(`CONNECT ${connections} last=${last} status=error`);\n      clearTimeout(timer);\n      if (!flags.reconnect) break;\n      await sleep(1000);\n      continue;\n    }\n    console.log(`CONNECT ${connections} last=${last} status=${res.status}`);\n    if (!res.ok) {\n      await res.body?.cancel().catch(() => undefined);\n      clearTimeout(timer);\n      if (!flags.reconnect) break;\n      await sleep(1000);\n      continue;\n    }\n    const decoder = new TextDecoder();\n    let buffer = \"\";\n    let outcome;\n    try {\n      read: for await (const chunk of res.body) {\n        buffer += decoder.decode(chunk, { stream: true });\n        let end;\n        while ((end = buffer.indexOf(\"\\n\\n\")) >= 0) {\n          const block = buffer.slice(0, end);\n          buffer = buffer.slice(end + 2);\n          const event = { name: \"message\", id: undefined, data: \"\" };\n          for (const line of block.split(\"\\n\")) {\n            if (line.startsWith(\"event: \")) event.name = line.slice(7);\n            else if (line.startsWith(\"id: \")) event.id = Number(line.slice(4));\n            else if (line.startsWith(\"data: \")) event.data += line.slice(6);\n          }\n          if (event.name === \"live\") console.log(`LIVE ${event.data}`);\n          else if (event.name === \"entry\") {\n            console.log(`ENTRY ${String(event.id)} ${event.data}`);\n            last = event.id;\n            entries++;\n            const parsed = JSON.parse(event.data);\n            const finished = parsed.messages.some(\n              (m) => m.role === \"assistant\" && until !== undefined && m.text.includes(until),\n            );\n            if (finished) {\n              outcome = \"DONE\";\n              break read;\n            }\n            if (entries >= maxEntries) {\n              outcome = `DROP last=${String(last)}`;\n              break read;\n            }\n          } else if (event.name === \"deleted\") console.log(\"DELETED\");\n        }\n      }\n      if (outcome === undefined) console.log(\"END closed-by-server\");\n    } catch {\n      console.log(`END ${controller.signal.aborted ? \"aborted\" : \"error\"}`);\n      if (controller.signal.aborted) break;\n    }\n    clearTimeout(timer);\n    if (outcome !== undefined) {\n      // Leave the loop first and abort afterwards: aborting inside it makes the iterator's cleanup throw.\n      console.log(outcome);\n      controller.abort();\n      return;\n    }\n    if (!flags.reconnect) break;\n    await sleep(1000);\n  }\n  console.log(\"TIMEOUT\");\n  process.exitCode = 3;\n}\n","isError":false}]}
ENTRY 11635 {"id":11635,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n### 1. Token lookup rejects valid whitespace-padded entries\n- Severity: low\n- Confidence: high\n- Location: tests/e2e/client.mjs:33\n- What happens: A valid token specification such as `alice:token,bob:token` with a space before `bob` is accepted by the server, but the client fails to find Bob’s token. E2E calls for Bob then fail before reaching the API.\n- Evidence: `line.slice(0, at) === who`; the server trims each entry before parsing it.\n- Fix idea: Trim each entry before extracting its owner and token, matching the server’s parser.\n\nEND-OF-REPORT"}]}
