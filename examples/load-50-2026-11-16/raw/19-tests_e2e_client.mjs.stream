ENTRY 11587 {"id":11587,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/session-core/src/auth.ts:33:    .split(/[\\n,]/)\n53:export function toEvent(message: Message): SessionEvent {\n54-  const event: SessionEvent = { role: message.role, text: contentText(message.content) };\n55-  if (message.role === \"assistant\") {\n56-    const calls = message.content.flatMap((block) =>\n57-      block.type === \"toolCall\" ? [`${block.name}(${JSON.stringify(block.arguments)})`] : [],\n58-    );\n59-    if (calls.length > 0) event.calls = calls;\n60-  }\n61-  if (message.role === \"toolResult\") event.isError = message.isError;\n62-  return event;\n63-}\n64-\n65-/** The Pi Durable host: one Harness over the Postgres storage, one conversation per session. */\n66-export class Host {\n67-  readonly #harness: Harness;\n68-  readonly #sandboxes: Sandboxes;\n69-  readonly #storage: Storage;\n70-\n71-  private constructor(harness: Harness, sandboxes: Sandboxes, storage: Storage) {\n72-    this.#harness = harness;\n73-    this.#sandboxes = sandboxes;\n74-    this.#storage = storage;\n75-  }\n76-\n77-  /**\n78-   * Opens the Harness over an owned storage and resumes whatever the last process left running.\n79-   * `onFailed` fires when the Harness ends on a storage error, e.g. the database connection died.\n80-   */\n81-  static async open(\n82-    storage: Storage,\n83-    config: OrchestratorConfig,\n84-    onFailed: (error: unknown) => void,\n85-    sessionKeyOf: SessionKeyOf,\n86-    hooks: SandboxHooks = {},\n87-    recycleAtStart: readonly number[] = [],\n88-  ): Promise<Host> {\n/* global process, fetch, console, AbortController, AbortSignal, TextDecoder, setTimeout, clearTimeout */\n// Test client for tests/e2e/run-phase4.sh. It runs INSIDE an ingest pod (`kubectl exec -i pod -- node - ...`\n// with this file on stdin), so API tokens never leave the cluster: it reads PI_API_TOKENS from the pod's\n// environment and picks the entry of the named owner. Nothing here prints a token.\n//\n//   call   <owner|bad|none> <METHOD> <path> [json-body]   [--base URL]\n//          prints one line: {\"status\":N,\"body\":<json or text>}\n//   stream <owner|bad|none> <sessionId> [--base URL] [--last-id N] [--until-text T] [--max-entries N]\n//          [--reconnect] [--timeout SECONDS]\n//          prints  CONNECT <n> last=<id> status=<code>\n//                  ENTRY <id> <json>        one transcript entry (SSE id = entry id)\n//                  LIVE <json>              the run in progress (no id)\n//                  END <reason>             the connection ended\n//                  DONE | DROP last=<id> | TIMEOUT\n//          Exits when an assistant entry contains T (DONE), after N entries (DROP, a simulated client drop),\n//          or at the timeout. With --reconnect it reconnects with Last-Event-ID after every end.\nconst [command, who, ...rest] = process.argv.slice(2);\nconst flags = {};\nconst positional = [];\nfor (let i = 0; i < rest.length; i++) {\n  const arg = rest[i];\n  if (arg.startsWith(\"--\")) {\n    const name = arg.slice(2);\n    flags[name] = name === \"reconnect\" ? true : rest[++i];\n  } else positional.push(arg);\n}\n// Loopback: the client runs inside an ingest pod; the pi-ingest Service would be ingest->ingest, which policy denies.\nconst base = flags.base ?? \"http://127.0.0.1:8080\";\n\nfunction token() {\n  if (who === \"none\") return undefined;\n  if (who === \"bad\") return \"0\".repeat(48);\n  for (const line of (process.env.PI_API_TOKENS ?? \"\").split(/[\\n,]/)) {\n    const at = line.indexOf(\":\");\n    if (at > 0 && line.slice(0, at) === who) return line.slice(at + 1);\n  }\n  throw new Error(`no token for owner ${who}`);\n}\nconst auth = () => {\n  const t = token();\n  return t === undefined ? {} : { authorization: `Bearer ${t}` };\n};\nconst sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\n\nasync function call() {\n","isError":false}]}
