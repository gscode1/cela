ENTRY 11571 {"id":11571,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/ingest/src/config.ts:20:  const apiTokens = env.PI_API_TOKENS;\npackages/ingest/src/config.ts:21:  if (!apiTokens) throw new Error(\"PI_API_TOKENS is required\");\npackages/orchestrator/src/config.ts:100:  const apiTokens = env.PI_API_TOKENS;\npackages/orchestrator/src/config.ts:101:  if (!apiTokens) throw new Error(\"PI_API_TOKENS is required\");\npackages/orchestrator/test/bridge-launcher.test.ts:17:        PI_API_TOKENS: \"alice:secret-token-value\",\npackages/orchestrator/test/host-workspace-env.test.ts:27:  PI_API_TOKENS: \"alice:0123456789abcdef0123\",\npackages/orchestrator/test/providers.test.ts:8:  PI_API_TOKENS: \"alice:0123456789abcdef0123\",\npackages/orchestrator/test/config.test.ts:8:  PI_API_TOKENS: \"alice:0123456789abcdef0123\",\npackages/orchestrator/test/config.test.ts:15:    expect(() => loadConfig({ PI_DURABLE_DATABASE_URL: \"x\" })).toThrow(/PI_API_TOKENS/);\npackages/orchestrator/test/delete-repo.test.ts:19:  PI_API_TOKENS: \"alice:0123456789abcdef0123\",\npackages/orchestrator/test/sandboxes-lifecycle.test.ts:31:    PI_API_TOKENS: \"alice:0123456789abcdef0123\",\npackages/orchestrator/test/host-model.test.ts:19:  PI_API_TOKENS: \"alice:0123456789abcdef0123\",\ntests/e2e/run-phase4.sh:240:        if(/PI_DURABLE_DATABASE_URL=|PI_API_TOKENS=|PI_SANDBOX_MASTER_KEY=/.test(env))leaks++;\ntests/e2e/client.mjs:3:// with this file on stdin), so API tokens never leave the cluster: it reads PI_API_TOKENS from the pod's\ntests/e2e/client.mjs:33:  for (const line of (process.env.PI_API_TOKENS ?? \"\").split(/[\\n,]/)) {\ntests/e2e/run-phase4b.sh:20:#   MODE=local              a local stack: API_BASE (ingest URL), PI_API_TOKENS or API_TOKEN, LOCAL_DB_URL (psql\ntests/e2e/run-phase3.sh:82:  k exec \"$1\" -c orchestrator -- node -e 'const [m,p,b]=process.argv.slice(1);const t=(process.env.PI_API_TOKENS||\"\").split(/[\\n,]/)[0].split(\":\").slice(1).join(\":\");fetch(\"http://127.0.0.1:8081\"+(p.startsWith(\"/sessions\")?\"/control\":\"\")+p,{method:m,body:b||undefined,headers:{authorization:\"Bearer \"+t}}).then(async r=>{process.stdout.write(await r.text());process.exit(r.ok?0:1)}).catch(e=>{console.error(e.message);process.exit(2)})' \"$2\" \"$3\" \"${4:-}\"\ntests/e2e/client-4b.mjs:3:// PI_API_TOKENS is already in the environment, so no token ever leaves the cluster or is printed. For a local stack\ntests/e2e/client-4b.mjs:4:// set API_BASE and PI_API_TOKENS (or API_TOKEN) in the environment.\ntests/e2e/client-4b.mjs:15:  for (const line of (process.env.PI_API_TOKENS ?? \"\").split(\"\\n\")) {\nimport { once } from \"node:events\";\nimport type { IncomingMessage, ServerResponse } from \"node:http\";\nimport { BACKGROUND_CONTEXT as context } from \"@earendil-works/chord/context\";\nimport type { ConversationView, EntryRecord } from \"@earendil-works/pi-durable\";\nimport { errorMessage } from \"@pi-durable-k8s/session-core\";\nimport type { Host } from \"./host.js\";\nimport { toEvent } from \"./host.js\";\nimport { log } from \"./log.js\";\nimport type { StreamRegistry } from \"./sessions.js\";\n\nconst KEEPALIVE_MS = 15_000;\nconst GAP_PAGE = 100;\n\n/** What the client sees of the run in progress. Carries no SSE id: it is not addressable by a cursor. */\nexport interface LiveEvent {\n  running: boolean;\n  /** Inputs queued behind the running turn. */\n  queued: number;\n  /** The throttled partial answer of the response being generated, if any. */\n  partial?: string;\n  tools?: { callId: string; name: string; status: string }[];\n  /** Why the newest run ended without an answer, e.g. `aborted`. */\n  runFailure?: string;\n}\n\nfunction asObject(value: unknown): Record<string, unknown> | undefined {\n  return typeof value === \"object\" && value !== null && !Array.isArray(value)\n    ? (value as Record<string, unknown>)\n    : undefined;\n}\n\n/** Projects `pi.live` and `pi.inbox` of a conversation view. Defensive: these are plain JSON documents. */\nexport function liveEvent(docs: ConversationView[\"docs\"]): LiveEvent {\n  const live = asObject(docs[\"pi.live\"]);\n  const inbox = asObject(docs[\"pi.inbox\"]);\n  const items = inbox?.items;\n  const event: LiveEvent = {\n    running: live?.run !== undefined,\n    queued: Array.isArray(items) ? items.length : 0,\n  };\n  const content = asObject(asObject(live?.generation)?.message)?.content;\n  if (Array.isArray(content)) {\n    const partial = content\n      .map((block) => {\n        const b = asObject(block);\n        return b?.type === \"text\" && typeof b.text === \"string\" ? b.text : \"\";\n      })\n      .join(\"\");\n    if (partial !== \"\") event.partial = partial;\n  }\n  if (Array.isArray(live?.tools)) {\n    event.tools = (live.tools as unknown[]).flatMap((slot) => {\n      const s = asObject(slot);\n      return s !== undefined\n        ? [{ callId: String(s.callId), name: String(s.name), status: String(s.status) }]\n        : [];\n    });\n  }\n  const failure = asObject(live?.runFailure);\n  if (typeof failure?.reason === \"string\") event.runFailure = failure.reason;\n  return event;\n}\n\n/** Only entries that carry model messages are streamed (inputs, answers, tool calls and results). */\nfunction entryEvent(\n  entry: EntryRecord,\n): { id: number; kind: string; messages: unknown[] } | undefined {\n  // System messages (the rendered system prompt) are the host's, not the conversation's: never streamed.\n  const messages = (entry.model ?? []).filter((message) => message.role !== \"system\");\n  if (messages.length === 0) return undefined;\n  return { id: entry.id, kind: entry.kind, messages: messages.map(toEvent) };\n}\n\nexport function parseLastEventId(header: string | string[] | undefined): number {\n  const raw = Array.isArray(header) ? header[0] : header;\n  const value = Number(raw);\n  return raw !== undefined && Number.isSafeInteger(value) && value > 0 ? value : 0;\n}\n\n/**\n * Writes a chunk and waits for the socket to drain, or for the client to go away. Whichever event loses the race must\n * drop its listener: a slow client under backpressure would otherwise pile up one `close` listener per write.\n */\nexport async function write(res: ServerResponse, chunk: string): Promise<void> {\n  if (res.destroyed || res.writableEnded) return;\n  if (!res.write(chunk)) {\n    const done = new AbortController();\n    try {\n      await Promise.race([\n        once(res, \"drain\", { signal: done.signal }),\n        once(res, \"close\", { signal: done.signal }),\n      ]);\n    } catch {\n      // the stream failed or was aborted; the caller sees the closed response on its next write\n    } finally {\n      done.abort();\n    }\n  }\n}\n\n/**\n * Server-sent events for one conversation, built on `Conversation.watch()` (the conversation view).\n *\n *  - `event: entry`, `id: <entry id>`: a committed transcript entry, once, in order. The id is the cursor.\n *  - `event: live`, no id: the run in progress (partial answer, tool calls, queue). Sent whole on connect and\n *    on every change; not replayed from a cursor, so a reconnect starts from the current state of the response.\n *  - `event: deleted`: the session was deleted; the stream ends.\n *\n * A client reconnects with `Last-Event-ID: <last entry id>`: entries after it are sent first (those the\n * watch's window no longer holds are read with `Conversation.entries()`), then live updates. Without the\n * header the whole transcript is replayed from the start.\n */\nexport async function serveStream(\n  req: IncomingMessage,\n  res: ServerResponse,\n  note \"EVIDENCE busy-order: users=$(users \"$e\") answers=$(answers \"$e\")\"\n}\n\nt_steer() {\n  local id claim s e\n  id=$(new_session alice)\n  post alice \"$id\" message \"$(mkscript -f original-final 'echo ORIGINAL-1; sleep 15' 'echo ORIGINAL-STEP2')\" >/dev/null\n  wait_for \"the session has a conversation\" 120 conv_set \"$id\"\n  claim=$(claim_of \"$id\")\n  wait_for \"sleep 15 is running in $claim\" 300 sandbox_has \"$claim\" 'sleep 15'\n  post alice \"$id\" steer \"$(mkscript -f steered-final 'echo STEERED-OK')\" >/dev/null\n  s=$(transcript alice \"$id\" steered-final 300)\n  e=$(entries \"$s\")\n  assert_jq \"the steer's step ran\" \"$(results \"$e\")\" 'any(.[]; contains(\"STEERED-OK\"))'\n  assert_jq \"the original second step never ran\" \"$(results \"$e\")\" 'all(.[]; contains(\"ORIGINAL-STEP2\")|not)'\n  assert_jq \"the run ended with the steered answer, not the original one\" \"$(answers \"$e\")\" '.==[\"steered-final\"]'\n  assert_jq \"two tool calls in all: the interrupted-by-steer round and the steered one\" \"$(results \"$e\")\" 'length==2'\n  note \"EVIDENCE steer: results=$(results \"$e\") answers=$(answers \"$e\")\"\n}\n\nt_reconnect() {\n  local id s1 s2 full a b all pod out last n\n  id=$(new_session alice)\n  post alice \"$id\" message \"$(mkscript -f recon-final 'echo S1; sleep 5' 'echo S2; sleep 5' 'echo S3')\" >/dev/null\n  # (a) client drop: take 3 entries, hang up, come back with Last-Event-ID.\n  s1=$(client stream alice \"$id\" --max-entries 3 --timeout 240)\n  last=$(sed -n 's/^DROP last=//p' <<<\"$s1\")\n  assert \"client A received 3 entries and dropped (last id $last)\" test -n \"$last\"\n  # Wait for the turn to finish while this client is away, then resume from the cursor.\n  full=$(transcript alice \"$id\" recon-final 240)\n  s2=$(client stream alice \"$id\" --last-id \"$last\" --until-text recon-final --timeout 120 || true)\n  a=$(entry_ids \"$s1\")\n  b=$(entry_ids \"$s2\")\n  all=$(printf '%s\\n%s\\n' \"$a\" \"$b\" | sed '/^$/d')\n  assert \"reconnect with Last-Event-ID resumed after the cursor: first id $(head -1 <<<\"$b\") > $last\" test \"$(head -1 <<<\"$b\")\" -gt \"$last\"\n  assert_eq \"A + B is exactly the full transcript: no gap, no duplicate\" \"$(entry_ids \"$full\" | xargs)\" \"$(printf \"%s\" \"$all\" | xargs)\"\n  assert \"the resumed stream says what the connection used\" grep -q \"^CONNECT 1 last=$last status=200\" <<<\"$s2\"\n  note \"EVIDENCE reconnect-client-drop: A ids=[$(tr '\\n' ' ' <<<\"$a\")] B ids=[$(tr '\\n' ' ' <<<\"$b\")] full=[$(entry_ids \"$full\" | tr '\\n' ' ')]\"\n\n  # (b) orchestrator restart under a live stream; the client reconnects by itself.\n  id=$(new_session alice)\n  post alice \"$id\" message \"$(mkscript -f reconnected-final 'echo R1; sleep 25' 'echo R2-OK')\" >/dev/null\n  client stream alice \"$id\" --reconnect --until-text reconnected-final --timeout 420 >\"$work/reconnect.out\" 2>&1 &\n  bg_pids+=($!)\n  wait_for \"the stream delivered the first entries\" 180 file_has \"$work/reconnect.out\" '^ENTRY'\n  wait_for \"the tool call is running\" 180 sandbox_has \"$(claim_of \"$id\")\" 'sleep 25'\n  pod=$(orch_pods | head -1)\n  note \"killing orchestrator pod $pod (force, grace 0) under the open stream\"\n  k delete pod \"$pod\" --grace-period=0 --force >/dev/null 2>&1\n  wait_for \"the client finished after the restart\" 420 file_has \"$work/reconnect.out\" '^DONE'\n  out=$(cat \"$work/reconnect.out\")\n  n=$(grep -c '^CONNECT' <<<\"$out\" || true)\n  assert \"the client had to reconnect ($n connections)\" test \"$n\" -ge 2\n  assert \"the connection ended when the orchestrator died\" grep -q '^END ' <<<\"$out\"\n  assert \"ids strictly increase across connections: nothing replayed\" ids_increasing \"$out\"\n  assert_eq \"the resumed stream equals a fresh replay\" \"$(entry_ids \"$(transcript alice \"$id\" reconnected-final 120)\" | xargs)\" \"$(entry_ids \"$out\" | xargs)\"\n  e=$(entries \"$out\")\n  assert_jq \"the interrupted tool reads as interrupted, then the script continued\" \"$(results \"$e\")\" '(.[0]|test(\"interrupt\";\"i\")) and (.[1]|contains(\"R2-OK\"))'\n  note \"EVIDENCE reconnect-orchestrator-restart: connections=$n; $(grep -E '^(CONNECT|END)' <<<\"$out\" | tr '\\n' ';')\"\n}\n\nt_auth() {\n  local id out\n  id=$(new_session alice)\n  assert_jq \"no token: 401\" \"$(api none POST /sessions)\" '.status==401'\n  assert_jq \"wrong token: 401\" \"$(api bad POST /sessions)\" '.status==401'\n  assert_jq \"wrong token on an existing session: 401\" \"$(api bad GET \"/sessions/$id\")\" '.status==401'\n  assert_jq \"wrong token on events: 401\" \"$(post bad \"$id\" message hi)\" '.status==401'\n  assert_jq \"the owner can read the session\" \"$(api alice GET \"/sessions/$id\")\" '.status==200'\n  assert_jq \"another owner cannot read it (404, existence not revealed)\" \"$(api bob GET \"/sessions/$id\")\" '.status==404'\n  assert_jq \"another owner cannot post events\" \"$(post bob \"$id\" message hi)\" '.status==404'\n    60\t  console.log(JSON.stringify({ status: res.status, body: parsed }));\n    61\t}\n    62\t\n    63\tasync function stream() {\n    64\t  const [sessionId] = positional;\n    65\t  let last = Number(flags[\"last-id\"] ?? 0);\n    66\t  const maxEntries = flags[\"max-entries\"] === undefined ? Infinity : Number(flags[\"max-entries\"]);\n    67\t  const timeoutMs = Number(flags.timeout ?? 300) * 1000;\n    68\t  const until = flags[\"until-text\"];\n    69\t  const deadline = Date.now() + timeoutMs;\n    70\t  let connections = 0;\n    71\t  let entries = 0;\n    72\t\n    73\t  while (Date.now() < deadline) {\n    74\t    connections++;\n    75\t    const controller = new AbortController();\n    76\t    const timer = setTimeout(() => controller.abort(), Math.max(1, deadline - Date.now()));\n    77\t    let res;\n    78\t    try {\n    79\t      res = await fetch(`${base}/sessions/${sessionId}/stream`, {\n    80\t        headers: {\n    81\t          ...auth(),\n    82\t          accept: \"text/event-stream\",\n    83\t          ...(last > 0 ? { \"last-event-id\": String(last) } : {}),\n    84\t        },\n    85\t        signal: controller.signal,\n    86\t      });\n    87\t    } catch {\n    88\t      console.log(`CONNECT ${connections} last=${last} status=error`);\n    89\t      clearTimeout(timer);\n    90\t      if (!flags.reconnect) break;\n    91\t      await sleep(1000);\n    92\t      continue;\n    93\t    }\n    94\t    console.log(`CONNECT ${connections} last=${last} status=${res.status}`);\n    95\t    if (!res.ok) {\n    96\t      await res.body?.cancel().catch(() => undefined);\n    97\t      clearTimeout(timer);\n    98\t      if (!flags.reconnect) break;\n    99\t      await sleep(1000);\n   100\t      continue;\n   101\t    }\n   102\t    const decoder = new TextDecoder();\n   103\t    let buffer = \"\";\n   104\t    let outcome;\n   105\t    try {\n   106\t      read: for await (const chunk of res.body) {\n   107\t        buffer += decoder.decode(chunk, { stream: true });\n   108\t        let end;\n   109\t        while ((end = buffer.indexOf(\"\\n\\n\")) >= 0) {\n   110\t          const block = buffer.slice(0, end);\n   111\t          buffer = buffer.slice(end + 2);\n   112\t          const event = { name: \"message\", id: undefined, data: \"\" };\n   113\t          for (const line of block.split(\"\\n\")) {\n   114\t            if (line.startsWith(\"event: \")) event.name = line.slice(7);\n   115\t            else if (line.startsWith(\"id: \")) event.id = Number(line.slice(4));\n   116\t            else if (line.startsWith(\"data: \")) event.data += line.slice(6);\n   117\t          }\n   118\t          if (event.name === \"live\") console.log(`LIVE ${event.data}`);\n   119\t          else if (event.name === \"entry\") {\n   120\t            console.log(`ENTRY ${String(event.id)} ${event.data}`);\n   121\t            last = event.id;\n   122\t            entries++;\n   123\t            const parsed = JSON.parse(event.data);\n   124\t            const finished = parsed.messages.some(\n   125\t              (m) => m.role === \"assistant\" && until !== undefined && m.text.includes(until),\n   126\t            );\n   127\t            if (finished) {\n   128\t              outcome = \"DONE\";\n   129\t              break read;\n   130\t            }\n   131\t            if (entries >= maxEntries) {\n   132\t              outcome = `DROP last=${String(last)}`;\n   133\t              break read;\n   134\t            }\n   135\t          } else if (event.name === \"deleted\") console.log(\"DELETED\");\n   136\t        }\n   137\t      }\n   138\t      if (outcome === undefined) console.log(\"END closed-by-server\");\n   139\t    } catch {\n   140\t      console.log(`END ${controller.signal.aborted ? \"aborted\" : \"error\"}`);\n   141\t      if (controller.signal.aborted) break;\n   142\t    }\n   143\t    clearTimeout(timer);\n   144\t    if (outcome !== undefined) {\n   145\t      // Leave the loop first and abort afterwards: aborting inside it makes the iterator's cleanup throw.\n   146\t      console.log(outcome);\n   147\t      controller.abort();\n   148\t      return;\n   149\t    }\n   150\t    if (!flags.reconnect) break;\n   151\t    await sleep(1000);\n   152\t  }\n   153\t  console.log(\"TIMEOUT\");\n   154\t  process.exitCode = 3;\n   155\t}\n","isError":false}]}
