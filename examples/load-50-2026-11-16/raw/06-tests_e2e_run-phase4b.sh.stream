ENTRY 11079 {"id":11079,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\t#!/usr/bin/env bash\n     2\t# Phase 4b acceptance tests: per-session model, allowlist, and terminal failure on rejected model credentials.\n     3\t# Runs IN the cluster as the e2e-driver Job started by `tests/e2e/run.sh phase4b` (ServiceAccount kubeconfig, no\n     4\t# context); it also still runs from a Mac (MODE=cluster with a kubectl context, or MODE=local against a local stack).\n     5\t#\n     6\t#   models        two sessions on different allowed models are recorded correctly (API, database) and both answer\n     7\t#   disallowed    a model outside the allowlist gets 400 and creates no session\n     8\t#   failed-401    a simulated 401 from the model makes the session `failed` with a clear message, once: the\n     9\t#                 orchestrator does not restart, nothing is retried, further input gets 409, DELETE still works\n    10\t#   real-model    REAL_MODEL=1 only: OpenAI Codex models (gpt-6.1-terra, gpt-6.1-sol) answer through OneCLI after one\n    11\t#                 sandbox tool call, with no provider key in the orchestrator. Runs only if Secret `pi-onecli` exists\n    12\t#                 in the namespace; otherwise it says so and is reported as SKIPPED (never faked). Two real turns.\n    13\t#\n    14\t# ONLY=\"models,disallowed\" runs just those tests (debugging aid). Prerequisite: the deployed ingest and orchestrator run\n    15\t# this branch's code and ConfigMap `pi-model-config` allows scripted/scripted-1 and scripted/scripted-2 (the committed\n    16\t# allowlist has them next to the Codex models). All API calls run inside an ingest pod, so API tokens stay in the\n    17\t# cluster; nothing here reads or prints a secret value. Throwaway sessions are deleted on exit.\n    18\t#\n    19\t#   MODE=cluster (default)  the current kubectl context, namespace pi-durable-poc\n    20\t#   MODE=local              a local stack: API_BASE (ingest URL), PI_API_TOKENS or API_TOKEN, LOCAL_DB_URL (psql\n    21\t#                           URL), ORCH_LOG (the orchestrator's log file); the real-model test is not available\n    22\t#\n    23\t# Exit code: 0 when no test failed (SKIPPED is not a failure), 1 otherwise.\n    24\tset -euo pipefail\n    25\t\n    26\tmode=${MODE:-cluster}\n    27\tctx=${KUBE_CONTEXT:-} # empty in the Job: kubectl then uses the in-cluster ServiceAccount config\n    28\tns=${NAMESPACE:-pi-durable-poc}\n    29\there=$(cd \"$(dirname \"$0\")\" && pwd)\n    30\troot=$(cd \"$here/../..\" && pwd)\n    31\twork=$(mktemp -d)\n    32\tsessions_file=$work/sessions\n    33\t: >\"$sessions_file\"\n    34\t\n    35\tk() { kubectl ${ctx:+--context=\"$ctx\"} -n \"$ns\" \"$@\"; }\n    36\tlog() { printf '\\n== %s\\n' \"$*\"; }\n    37\tnote() { printf '   %s\\n' \"$*\"; }\n    38\tnow() { date +%s; }\n    39\t\n    40\t# ---------------------------------------------------------------- adapters: cluster or local stack\n    41\tingest_pod() {\n    42\t  k get pods -l app.kubernetes.io/name=pi-ingest -o json |\n    43\t    jq -r '[.items[] | select(.status.phase==\"Running\" and .metadata.deletionTimestamp==null)][0].metadata.name // empty'\n    44\t}\n    45\tapi() { # owner method path [body] -> {\"status\":N,\"body\":...}\n    46\t  if [[ $mode == local ]]; then\n    47\t    node \"$here/client-4b.mjs\" call \"$@\"\n    48\t  else\n    49\t    k exec -i \"$(ingest_pod)\" -c ingest -- node - call \"$@\" <\"$here/client-4b.mjs\"\n    50\t  fi\n    51\t}\n    52\tanswer_has() { # owner session needle seconds -> \"found <tool calls>\"|timeout\n    53\t  if [[ $mode == local ]]; then\n    54\t    node \"$here/client-4b.mjs\" answer \"$@\"\n    55\t  else\n    56\t    k exec -i \"$(ingest_pod)\" -c ingest -- node - answer \"$@\" <\"$here/client-4b.mjs\"\n    57\t  fi\n    58\t}\n    59\tstream_has() { # owner session needle seconds -> found|timeout\n    60\t  if [[ $mode == local ]]; then\n    61\t    node \"$here/client-4b.mjs\" stream \"$@\"\n    62\t  else\n    63\t    k exec -i \"$(ingest_pod)\" -c ingest -- node - stream \"$@\" <\"$here/client-4b.mjs\"\n    64\t  fi\n    65\t}\n    66\tsql() {\n    67\t  if [[ $mode == local ]]; then\n    68\t    psql \"$LOCAL_DB_URL\" -At -v ON_ERROR_STOP=1 -c \"$1\"\n    69\t  else\n    70\t    k exec pi-pg-1 -c postgres -- psql -U postgres -d app -At -v ON_ERROR_STOP=1 -c \"$1\"\n    71\t  fi\n    72\t}\n    73\torch_restarts() {\n    74\t  if [[ $mode == local ]]; then\n    75\t    echo $(($(grep -c '\"event\":\"listening\"' \"$ORCH_LOG\") - 1))\n    76\t  else\n    77\t    # The live pod only: right after a rollout `items[0]` can be a terminating pod without container statuses, and\n    78\t    # the failed lookup used to end the test silently under `set -e`.\n    79\t    k get pods -l app.kubernetes.io/name=pi-orchestrator -o json |\n    80\t      jq -r '[.items[] | select(.status.phase==\"Running\" and .metadata.deletionTimestamp==null)][0].status.containerStatuses[0].restartCount'\n    81\t  fi\n    82\t}\n    83\torch_log() {\n    84\t  if [[ $mode == local ]]; then cat \"$ORCH_LOG\"; else k logs deploy/pi-orchestrator --tail=500; fi\n    85\t}\n    86\t\n    87\tcleanup() {\n    88\t  local id\n    89\t  while read -r id; do\n    90\t    [[ -n $id ]] || continue\n    91\t    api alice DELETE \"/sessions/$id\" >/dev/null 2>&1 || true\n    92\t  done <\"$sessions_file\"\n    93\t  # The delete is asynchronous (the orchestrator removes the sandbox first): wait (bounded) until every session is\n    94\t  # `deleted`, then drop the rows of the sessions that got there. Dropping a row earlier would orphan a claim the\n    95\t  # delete had not reached yet, so the others are reported and kept. A failed query is not \"nothing left\": it is\n    96\t  # retried until the deadline.\n    97\t  local list deadline pending status\n    98\t  list=$(grep -v '^$' \"$sessions_file\" | sed \"s/.*/'&'/\" | paste -sd, -)\n    99\t  deadline=$(($(now) + 180))\n   100\t  while [[ -n $list && $(now) -lt $deadline ]]; do\n   101\t    if pending=$(sql \"select id from inbox.sessions where status <> 'deleted' and id in ($list)\" 2>/dev/null) && [[ -z $pending ]]; then\n   102\t      break\n   103\t    fi\n   104\t    sleep 3\n   105\t  done\n   106\t  while read -r id; do\n   107\t    [[ -n $id ]] || continue\n   108\t    if ! status=$(sql \"select status from inbox.sessions where id='$id'\" 2>/dev/null | tr -d ' '; exit \"${PIPESTATUS[0]}\"); then\n   109\t      note \"cleanup: could not read the status of session $id; keeping its rows\"\n   110\t    elif [[ -z $status || $status == deleted ]]; then\n   111\t      sql \"delete from inbox.events where session_id='$id'; delete from inbox.sessions where id='$id'\" >/dev/null 2>&1 ||\n   112\t        note \"cleanup: could not delete the rows of session $id\"\n   113\t    else\n   114\t      note \"cleanup: session $id is still '$status' after the wait; keeping its rows (its claim may remain)\"\n   115\t    fi\n   116\t  done <\"$sessions_file\"\n   117\t  rm -rf \"$work\"\n   118\t}\n   119\ttrap cleanup EXIT\n   120\t\n   121\t# ---------------------------------------------------------------- assertions (exit the test's subshell)\n   122\tassert_eq() { # description expected actual\n   123\t  if [[ $2 == \"$3\" ]]; then note \"ok: $1\"; else\n   124\t    note \"ASSERT FAILED: $1\"\n   125\t    note \"  expected: $2\"\n   126\t    note \"  got: $3\"\n   127\t    exit 1\n   128\t  fi\n   129\t}\n   130\tassert_jq() { # description json jq-expression\n   131\t  if jq -e \"$3\" <<<\"$2\" >/dev/null 2>&1; then note \"ok: $1\"; else\n   132\t    note \"ASSERT FAILED: $1\"\n   133\t    note \"  expected: $3\"\n   134\t    note \"  got: $(jq -c . <<<\"$2\" 2>/dev/null | cut -c1-500 || printf '%s' \"$2\" | cut -c1-500)\"\n   135\t    exit 1\n   136\t  fi\n   137\t}\n   138\twait_status() { # owner session wanted-status timeout-seconds -> the last GET body\n   139\t  local deadline=$(($(now) + $4)) out\n   140\t  while :; do\n   141\t    out=$(api \"$1\" GET \"/sessions/$2\")\n   142\t    if [[ $(jq -r '.body.status // empty' <<<\"$out\") == \"$3\" ]]; then\n   143\t      printf '%s' \"$out\"\n   144\t      return 0\n   145\t    fi\n   146\t    if [[ $(now) -ge $deadline ]]; then\n   147\t      note \"TIMEOUT after $4s waiting for session $2 to be $3\"\n   148\t      printf '%s' \"$out\"\n   149\t      return 1\n   150\t    fi\n   151\t    sleep 2\n   152\t  done\n   153\t}\n   154\tnew_session() { # owner [body] -> response JSON; records the id for cleanup\n   155\t  local out\n   156\t  # The deployed default may be a real model, so a bare call asks for the scripted one explicitly.\n   157\t  local body=${2:-}\n   158\t  [[ -n $body ]] || body='{\"provider\":\"scripted\",\"model\":\"scripted-1\"}'\n   159\t  out=$(api \"$1\" POST /sessions \"$body\")\n   160\t  jq -r '.body.sessionId // empty' <<<\"$out\" >>\"$sessions_file\"\n   161\t  printf '%s' \"$out\"\n   162\t}\n   163\t\n   164\t# ---------------------------------------------------------------- tests\n   165\tt_models() {\n   166\t  local a b ida idb out\n   167\t  a=$(new_session alice)\n   168\t  b=$(new_session alice '{\"provider\":\"scripted\",\"model\":\"scripted-2\"}')\n   169\t  assert_jq \"default session created on scripted/scripted-1\" \"$a\" '.status==201 and .body.provider==\"scripted\" and .body.model==\"scripted-1\"'\n   170\t  assert_jq \"explicit session created on scripted/scripted-2 (is it in PI_MODEL_ALLOWLIST?)\" \"$b\" '.status==201 and .body.model==\"scripted-2\"'\n   171\t  ida=$(jq -r .body.sessionId <<<\"$a\")\n   172\t  idb=$(jq -r .body.sessionId <<<\"$b\")\n   173\t  assert_eq \"database records the default model\" \"scripted/scripted-1\" \"$(sql \"select model_provider||'/'||model_id from inbox.sessions where id='$ida'\")\"\n   174\t  assert_eq \"database records the requested model\" \"scripted/scripted-2\" \"$(sql \"select model_provider||'/'||model_id from inbox.sessions where id='$idb'\")\"\n   175\t  out=$(api alice GET \"/sessions/$ida\")\n   176\t  assert_jq \"GET reports the default model\" \"$out\" '.body.model.provider==\"scripted\" and .body.model.model==\"scripted-1\"'\n   177\t  out=$(api alice GET \"/sessions/$idb\")\n   178\t  assert_jq \"GET reports the requested model\" \"$out\" '.body.model.model==\"scripted-2\"'\n   179\t  api alice POST \"/sessions/$ida/events\" '{\"kind\":\"message\",\"text\":\"hello a\"}' >/dev/null\n   180\t  api alice POST \"/sessions/$idb/events\" '{\"kind\":\"message\",\"text\":\"hello b\"}' >/dev/null\n   181\t  assert_eq \"session A answers on its model\" found \"$(stream_has alice \"$ida\" \"echo: hello a\" 60)\"\n   182\t  assert_eq \"session B answers on its model\" found \"$(stream_has alice \"$idb\" \"echo: hello b\" 60)\"\n   183\t}\n   184\t\n   185\tt_disallowed() {\n   186\t  local before out\n   187\t  before=$(sql \"select count(*) from inbox.sessions\")\n   188\t  out=$(api alice POST /sessions '{\"provider\":\"openai\",\"model\":\"gpt-5\"}')\n   189\t  assert_jq \"a model outside the allowlist is 400\" \"$out\" '.status==400 and (.body.error|test(\"not allowed\"))'\n   190\t  out=$(api alice POST /sessions '{\"provider\":\"scripted\",\"model\":\"scripted-1/other\"}')\n   191\t  assert_jq \"the model must match as a whole\" \"$out\" '.status==400'\n   192\t  out=$(api alice POST /sessions '{\"provider\":\"scripted\"}')\n   193\t  assert_jq \"provider without model is 400\" \"$out\" '.status==400'\n   194\t  assert_eq \"no session was created\" \"$before\" \"$(sql \"select count(*) from inbox.sessions\")\"\n   195\t}\n   196\t\n   197\tt_failed_401() {\n   198\t  local c id restarts out text\n   199\t  c=$(new_session alice)\n   200\t  id=$(jq -r .body.sessionId <<<\"$c\")\n   201\t  restarts=$(orch_restarts)\n   202\t  text=$(jq -cn '{kind:\"message\", text:({steps:[], error:\"401 Unauthorized: simulated rejected credentials\"}|tostring)}')\n   203\t  api alice POST \"/sessions/$id/events\" \"$text\" >/dev/null\n   204\t  out=$(wait_status alice \"$id\" failed 90) || exit 1\n   205\t  assert_jq \"the session is failed, with a clear message\" \"$out\" '.body.status==\"failed\" and (.body.failure|test(\"401/403\")) and (.body.failure|test(\"OneCLI\"))'\n   206\t  assert_jq \"the failure message does not repeat the provider's text\" \"$out\" '(.body.failure|test(\"simulated\")|not)'\n   207\t  out=$(api alice POST \"/sessions/$id/events\" '{\"kind\":\"message\",\"text\":\"again\"}')\n   208\t  assert_jq \"further input is refused with 409\" \"$out\" '.status==409'\n   209\t  sleep 15\n   210\t  assert_eq \"the orchestrator did not restart\" \"$restarts\" \"$(orch_restarts)\"\n   211\t  assert_eq \"the event was submitted once, not retried\" \"1|submitted\" \"$(sql \"select attempts||'|'||status from inbox.events where session_id='$id' and kind='message' and payload->>'text' like '%401%'\")\"\n   212\t  assert_eq \"the session stays failed\" failed \"$(sql \"select status from inbox.sessions where id='$id'\")\"\n   213\t  if orch_log | grep -q -E 'fail-closed|\"event\":\"fatal\"'; then\n   214\t    note \"ASSERT FAILED: the orchestrator logged a fatal or fail-closed event\"\n   215\t    exit 1\n   216\t  fi\n   217\t  note \"ok: no fatal or fail-closed event in the orchestrator log\"\n   218\t  out=$(api alice DELETE \"/sessions/$id\")\n   219\t  assert_jq \"a failed session can still be deleted\" \"$out\" '.status==202'\n   220\t  wait_status alice \"$id\" deleted 60 >/dev/null || exit 1\n   221\t  note \"ok: the failed session was deleted\"\n   222\t}\n   223\t\n   224\tt_real_model() {\n   225\t  # OpenAI Codex (ChatGPT subscription) through OneCLI. The default pair is in the committed ConfigMap's allowlist.\n   226\t  local models=${REAL_MODELS:-openai-codex/gpt-6.1-terra,openai-codex/gpt-6.1-sol}\n   227\t  local entry provider model out id answer\n   228\t  if [[ $mode == local ]]; then\n   229\t    note \"SKIPPED: the real-model test needs the cluster (MODE=cluster)\"\n   230\t    return 3\n   231\t  fi\n   232\t  if ! k get secret pi-onecli >/dev/null 2>&1; then\n   233\t    note \"SKIPPED: Secret pi-onecli does not exist in the namespace (ExternalSecret pi-onecli, key agent-token).\"\n   234\t    note \"  See docs/model-credentials.md, Set up.\"\n   235\t    return 3\n   236\t  fi\n   237\t  note \"ok: pi-onecli delivered by the ExternalSecret\"\n   238\t  # Names only, never values: no provider credential is in the orchestrator's environment.\n   239\t  if k exec deploy/pi-orchestrator -- sh -c 'env | cut -d= -f1' | grep -q -E '^(OPENROUTER|OPENAI|ANTHROPIC)_API_KEY$'; then\n   240\t    note \"ASSERT FAILED: a provider API key is in the orchestrator environment\"\n   241\t    exit 1\n   242\t  fi\n   243\t  note \"ok: no provider API key in the orchestrator environment\"\n   244\t  for entry in ${models//,/ }; do\n   245\t    provider=${entry%%/*}\n   246\t    model=${entry#*/}\n   247\t    out=$(new_session alice \"$(jq -cn --arg p \"$provider\" --arg m \"$model\" '{provider:$p, model:$m}')\")\n   248\t    assert_jq \"session created on $entry\" \"$out\" '.status==201'\n   249\t    id=$(jq -r .body.sessionId <<<\"$out\")\n   250\t    # printf splits the word, so the user's own message does not contain the needle.\n   251\t    api alice POST \"/sessions/$id/events\" \\\n   252\t      '{\"kind\":\"message\",\"text\":\"Run `printf \\\"hel%s\\\" lo` in the sandbox and tell me exactly what it printed.\"}' >/dev/null\n   253\t    answer=$(answer_has alice \"$id\" hello 180)\n   254\t    case $answer in\n   255\t      found*) note \"ok: $entry answered with the tool output after ${answer#found } tool call(s)\" ;;\n   256\t      *)\n   257\t        note \"ASSERT FAILED: $entry did not answer with the tool output ($answer)\"\n   258\t        exit 1\n   259\t        ;;\n   260\t    esac\n   261\t    assert_jq \"the session is still active\" \"$(api alice GET \"/sessions/$id\")\" '.body.status==\"active\"'\n   262\t    if orch_log | grep -q -E 'aoc_|eyJ|sk-'; then\n   263\t      note \"ASSERT FAILED: the orchestrator log holds something shaped like a token or key\"\n   264\t      exit 1\n   265\t    fi\n   266\t    note \"ok: no aoc_, JWT or sk- shaped text in the orchestrator log\"\n   267\t  done\n   268\t}\n   269\t\n   270\t# ---------------------------------------------------------------- driver\n   271\tpass=0 fail=0 skip=0\n   272\tsummary=()\n   273\trun() { # name function\n   274\t  local name=$1 rc\n   275\t  [[ -z ${ONLY:-} || \",$ONLY,\" == *\",$name,\"* ]] || return 0\n   276\t  log \"$name\"\n   277\t  set +e\n   278\t  (\n   279\t    set -eE\n   280\t    # An unexpected failing command must say so; a bare `set -e` exit left no output at all.\n   281\t    trap 'note \"ERROR: command failed at line $LINENO (exit $?): $BASH_COMMAND\"' ERR\n   282\t    \"$2\"\n   283\t  )\n   284\t  rc=$?\n   285\t  set -e\n   286\t  case $rc in\n   287\t    0)\n   288\t      pass=$((pass + 1))\n   289\t      summary+=(\"PASS  $name\")\n   290\t      ;;\n   291\t    3)\n   292\t      skip=$((skip + 1))\n   293\t      summary+=(\"SKIP  $name\")\n   294\t      ;;\n   295\t    *)\n   296\t      fail=$((fail + 1))\n   297\t      summary+=(\"FAIL  $name\")\n   298\t      ;;\n   299\t  esac\n   300\t}\n   301\t\n   302\trun models t_models\n   303\trun disallowed t_disallowed\n   304\trun failed-401 t_failed_401\n   305\tif [[ ${REAL_MODEL:-0} == 1 ]]; then run real-model t_real_model; fi\n   306\t\n   307\tlog \"summary\"\n   308\tfor line in \"${summary[@]}\"; do note \"$line\"; done\n   309\tnote \"passed=$pass failed=$fail skipped=$skip\"\n   310\tlog \"RESULT\"\n   311\tprintf '%s\\n' \"${summary[@]}\"\n   312\tif [[ $fail -ne 0 ]]; then\n   313\t  echo \"PHASE 4B: FAILED\" >&2\n   314\t  exit 1\n   315\tfi\n   316\techo \"PHASE 4B: all tests passed\"\n","isError":false}]}
