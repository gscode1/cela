1\t      sendJson(res, 503, { error: \"orchestrator unavailable, retry\" }, { \"retry-after\": \"2\" });\n   292\t    } else {\n   293\t      res.end();\n   294\t    }\n   295\t  });\n   296\t  res.on(\"close\", () => upstream.destroy());\n   297\t  // The orchestrator sends a keepalive every 15 s. Silence for 45 s means it is gone without closing the\n   298\t  // connection (node lost, network cut): drop the stream so the client reconnects instead of waiting forever.\n   299\t  upstream.setTimeout(45_000, () => upstream.destroy());\n   300\t  upstream.end();\n   301\t}\n","isError":false}]}
