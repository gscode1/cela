ENTRY 11806 {"id":11806,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"   200\t  // With requireActive the status test and the insert are one statement: a caller that read the session earlier\n   201\t  // (ingest does, before it reads the request body) cannot get an event accepted for a session that was deleted\n   202\t  // meanwhile. `for share` makes the insert wait for a concurrent status change to commit and then see it, and\n   203\t  // makes a concurrent DELETE wait for this insert, so an accepted event always precedes the delete row.\n   204\t  const columns = \"(session_id, source, source_event_id, kind, payload)\";\n   205\t  const inserted = await pool.query<{ id: string }>(\n   206\t    `insert into inbox.events ${columns}\n   207\t     ${\n   208\t       options.requireActive === true\n   209\t         ? `select s.id, $2, $3, $4, $5::jsonb from inbox.sessions s where s.id = $1 and s.status = 'active' for share of s`\n   210\t         : `values ($1, $2, $3, $4, $5)`\n   211\t     }\n   212\t     on conflict (source, source_event_id) do nothing\n   213\t     returning id`,\n   214\t    [event.sessionId, event.source, event.sourceEventId, event.kind, JSON.stringify(event.payload)],\n   215\t  );\n   216\t  const fresh = inserted.rows[0];\n   217\t  if (fresh !== undefined) {\n   218\t    await pool.query(\n   219\t      \"update inbox.sessions set last_activity_at = clock_timestamp() where id = $1\",\n   220\t      [event.sessionId],\n   221\t    );\n   222\t    return { outcome: \"accepted\", eventId: fresh.id };\n   223\t  }\n   224\t  const { rows } = await pool.query<{ id: string; session_id: string }>(\n   225\t    \"select id, session_id from inbox.events where source = $1 and source_event_id = $2\",\n   226\t    [event.source, event.sourceEventId],\n   227\t  );\n   228\t  const existing = rows[0];\n   229\t  if (existing === undefined && options.requireActive === true) {\n   230\t    const current = await pool.query<{ status: SessionStatus }>(\n   231\t      \"select status from inbox.sessions where id = $1\",\n   232\t      [event.sessionId],\n   233\t    );\n   234\t    return { outcome: \"inactive\", status: current.rows[0]?.status ?? \"deleted\" };\n   235\t  }\n   236\t  if (existing === undefined || existing.session_id !== event.sessionId) {\n   237\t    return { outcome: \"conflict\" };\n   238\t  }\n   239\t  return { outcome: \"duplicate\", eventId: existing.id };\n   240\t}\n   241\t\n   242\t/**\n   243\t * The dedup key of a session's delete row. Client events use `source = api:<owner>` with a client-chosen id, so the\n   244\t * server's own row lives in a source no client can write: a client id such as `delete:<id>` can then never\n   245\t * occupy the key and make DELETE a no-op. (Delete rows written before this carry `api:<owner>` / `delete:<id>`;\n   246\t * they stay as they are and a new DELETE simply adds one under this key.)\n   247\t */\n   248\texport function deleteEventKey(sessionId: string): { source: string; sourceEventId: string } {\n   249\t  return { source: \"system:delete\", sourceEventId: sessionId };\n   250\t}\n   251\t\n   252\t/**\n   253\t * Puts a `failed` delete row back to `pending`. A repeated DELETE calls it: the row is deduplicated, so without this\n   254\t * a delete that failed (rows from before deletes were retried without limit, or a permanent error since fixed) could\n   255\t * never run again.\n   256\t */\n   257\texport async function requeueFailedDelete(pool: pg.Pool, sessionId: string): Promise<void> {\n   258\t  await pool.query(\n   259\t    `update inbox.events set status = 'pending', attempts = 0, error = null\n   260\t      where session_id = $1 and kind = 'delete' and status = 'failed'`,\n   261\t    [sessionId],\n   262\t  );\n   263\t}\n   264\t\n   265\t/** Marks an active session as being deleted, so no further events are accepted. Idempotent. */\n   266\texport async function requestDelete(pool: pg.Pool, sessionId: string): Promise<void> {\n   267\t  await pool.query(\n   268\t    \"update inbox.sessions set status = 'deleting', last_activity_at = clock_timestamp() where id = $1 and status in ('active', 'failed')\",\n   269\t    [sessionId],\n   270\t  );\n   271\t}\n   272\t\n   273\texport interface SessionSummary {\n   274\t  status: SessionStatus;\n   275\t  lastActivityAt: Date;\n   315\t * are gone still leaves the list of what to revoke. Safe to repeat; the first record stays.\n   316\t */\n   317\texport async function writeTombstone(\n   318\t  db: Pick<pg.Pool, \"query\">,\n   319\t  session: SessionRow,\n   320\t): Promise<void> {\n   321\t  await db.query(\n   322\t    `insert into inbox.tombstones (session_id, conversation_id, repo, onecli_agent_id, onecli_secret_ids)\n   323\t     values ($1, $2, $3, $4, $5)\n   324\t     on conflict (session_id) do nothing`,\n   325\t    [\n   326\t      session.id,\n   327\t      session.conversationId,\n   328\t      session.repo?.repo ?? null,\n   329\t      session.onecli?.agentId ?? null,\n   330\t      session.onecli === null ? null : [...session.onecli.secretIds],\n   331\t    ],\n   332\t  );\n   333\t}\n   334\t\n   335\texport async function completeTombstone(\n   336\t  db: Pick<pg.Pool, \"query\">,\n   337\t  sessionId: string,\n   338\t): Promise<void> {\n   339\t  await db.query(\n   340\t    \"update inbox.tombstones set completed_at = coalesce(completed_at, clock_timestamp()) where session_id = $1\",\n   341\t    [sessionId],\n   342\t  );\n   343\t}\n   344\t\n-- Phase 4c: an optional repository workspace per session, and the OneCLI objects that serve it.\n-- Idempotent, like 001 to 003.\n\nalter table inbox.sessions add column if not exists repo text;          -- `owner/name`, null: no repository\nalter table inbox.sessions add column if not exists repo_branch text;   -- null: the repository's default branch\n-- The session's OneCLI agent and per-session secrets (ids, never values). Null until provisioned.\nalter table inbox.sessions add column if not exists onecli_agent_id text;\nalter table inbox.sessions add column if not exists onecli_secret_ids text[];\n-- Set once the clone is done and the workspace marker exists. A later missing marker means the workspace was\n-- lost, which is reported instead of silently cloned again.\nalter table inbox.sessions add column if not exists workspace_ready_at timestamptz;\n\n-- Written first when a session is deleted, before any OneCLI object or claim goes away, so a crash mid-delete\n-- leaves a record of what still has to be revoked. Never deleted: it is the audit trail of what a session held.\ncreate table if not exists inbox.tombstones (\n  session_id        uuid primary key,\n  conversation_id   bigint,\n  repo              text,\n  onecli_agent_id   text,\n  onecli_secret_ids text[],\n  created_at        timestamptz not null default clock_timestamp(),\n  completed_at      timestamptz\n);\n<harness>\n[error] Command exited with code 1\n</harness>","isError":true}]}
ENTRY 11832 {"id":11832,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n\n### 1. A crash can leave a session deleting without a delete event\n- Severity: high\n- Confidence: high\n- Location: packages/session-core/src/store.ts:266\n- What happens: If ingest crashes after `requestDelete` commits but before it enqueues the delete event, the session remains in `deleting` with no event to trigger cleanup. Its sandbox and credentials can remain provisioned indefinitely unless the client retries DELETE.\n- Evidence: `requestDelete` independently executes `update inbox.sessions set status = 'deleting'`; its caller subsequently calls `enqueueEvent` in a separate operation.\n- Fix idea: Change the status and insert the deduplicated delete event in one transaction, or add recovery that enqueues missing delete events for sessions stuck in `deleting`.\n\nEND-OF-REPORT"}]}
DONE
