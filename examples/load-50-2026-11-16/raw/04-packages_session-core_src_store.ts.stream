ENTRY 11755 {"id":11755,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import type pg from \"pg\";\nimport { errorMessage, getSession, toEvent } from \"@pi-durable-k8s/session-core\";\nimport type { EventDbRow, InboxEvent, SessionRow } from \"@pi-durable-k8s/session-core\";\nimport { log } from \"./log.js\";\nimport { PermanentError } from \"./sessions.js\";\n\nconst POLL_MS = 1_000;\nconst BATCH = 20;\nconst MAX_PARALLEL_SESSIONS = 8;\nconst MAX_ATTEMPTS = 5;\nconst DELETE_RETRY_BASE_MS = 1_000;\nconst DELETE_RETRY_MAX_MS = 60_000;\n\n/**\n * Wait before the next try of a failing `delete` row: 1 s, 2 s, 4 s ... capped at 60 s. A delete is not given up after\n * MAX_ATTEMPTS like other events (docs/decisions/0006-deletes-retry-until-done.md): five tries a second apart end\n * inside one short Kubernetes or OneCLI outage, and a failed delete leaks the sandbox, PVC and OneCLI agent.\n */\nexport function deleteRetryDelayMs(attempt: number): number {\n  return Math.min(DELETE_RETRY_MAX_MS, DELETE_RETRY_BASE_MS * 2 ** Math.max(0, attempt - 1));\n}\n\nexport type ApplyEvent = (event: InboxEvent, session: SessionRow) => Promise<void>;\n\n/**\n * The orchestrator's side of the inbox. It claims `pending` rows, hands each to Pi Durable (the row id is the\n * `requestId`), and only then marks the row `submitted`. Pi Durable owns run recovery: a row that is\n * already `submitted` is never touched again, so a run that died is never re-run from here.\n *\n *  - Wake-up: LISTEN on `inbox_events` (sent by a trigger on insert) plus a short poll as the safety net.\n *  - Claim: one transaction per session batch, `FOR UPDATE SKIP LOCKED`, oldest first. The row locks are held\n *    until the rows are marked, so a crash in between rolls the batch back to `pending`; the retry submits\n *    with the same `requestId` and Pi Durable returns the original submission.\n *  - Ordering: one drain per session at a time, rows in (created_at, id) order. A transient failure stops\n *    that session's batch so later rows cannot overtake it; other sessions are unaffected.\n *  - Batching: rows of a session are claimed up to 20 at a time and submitted one by one, in order. They are\n *    not merged into one input: each keeps its own requestId and therefore its own idempotent submission.\n */\nexport class InboxLoop {\n  readonly #pool: pg.Pool;\n  readonly #apply: ApplyEvent;\n  readonly #inFlight = new Set<string>();\n  /** Sessions whose failing delete waits out its backoff (epoch ms). In memory: a restart simply retries at once. */\n  readonly #notBefore = new Map<string, number>();\n  #listener: pg.PoolClient | undefined;\n  #timer: NodeJS.Timeout | undefined;\n  #ticking = false;\n  #again = false;\n  #stopped = false;\n\n  constructor(pool: pg.Pool, apply: ApplyEvent) {\n    this.#pool = pool;\n    this.#apply = apply;\n  }\n\n  start(): void {\n    void this.#listen();\n    this.#timer = setInterval(() => this.wake(), POLL_MS);\n    this.wake();\n  }\n\n  async stop(): Promise<void> {\n    this.#stopped = true;\n    if (this.#timer !== undefined) clearInterval(this.#timer);\n    this.#listener?.removeAllListeners();\n    this.#listener?.release(true);\n    // Let drains in flight finish their current row: they hold row locks and a transaction.\n    while (this.#inFlight.size > 0) await new Promise((resolve) => setTimeout(resolve, 100));\n  }\n\n  wake(): void {\n    if (this.#stopped) return;\n    if (this.#ticking) {\n      this.#again = true;\n      return;\n    }\n    this.#ticking = true;\n    void this.#tick().finally(() => {\n      this.#ticking = false;\n      if (this.#again) {\n        this.#again = false;\n        this.wake();\n      }\n    });\n  }\n\n  async #listen(): Promise<void> {\n    while (!this.#stopped) {\n      try {\n        const client = await this.#pool.connect();\n        this.#listener = client;\n        await new Promise<void>((resolve) => {\n          client.on(\"notification\", () => this.wake());\n          client.on(\"error\", () => resolve());\n          client.on(\"end\", () => resolve());\n          client.query(\"listen inbox_events\").catch(() => resolve());\n        });\n        client.removeAllListeners();\n        client.release(true);\n      } catch (error) {\n        log(\"inbox-listen-failed\", { message: errorMessage(error) });\n      }\n      // The poll covers the gap until the listener is back.\n      await new Promise((resolve) => setTimeout(resolve, 2_000));\n    }\n  }\n\n  async #tick(): Promise<void> {\n    try {\n      const { rows } = await this.#pool.query<{ session_id: string }>(\n        \"select distinct session_id from inbox.events where status = 'pending' limit 100\",\n      );\n      for (const { session_id: sessionId } of rows) {\n        if (this.#inFlight.has(sessionId) || this.#inFlight.size >= MAX_PARALLEL_SESSIONS) continue;\n        if ((this.#notBefore.get(sessionId) ?? 0) > Date.now()) continue;\n        this.#inFlight.add(sessionId);\n        void this.#drain(sessionId)\n          .then((progressed) => {\n            if (progressed) this.wake();\n          })\n          .catch((error: unknown) => {\n            log(\"inbox-drain-failed\", { session: sessionId, message: errorMessage(error) });\n          })\n          .finally(() => this.#inFlight.delete(sessionId));\n      }\n    } catch (error) {\n      log(\"inbox-poll-failed\", { message: errorMessage(error) });\n    }\n  }\n\n  /** Claims and applies batches for one session until none is pending. True if it made progress. */\n  async #drain(sessionId: string): Promise<boolean> {\n    let progressed = false;\n    while (!this.#stopped) {\n      const client = await this.#pool.connect();\n      let finished = true;\n      let submitted = 0;\n      try {\n        await client.query(\"begin\");\n        const { rows } = await client.query<EventDbRow>(\n          `select * from inbox.events\n            where session_id = $1 and status = 'pending'\n            order by created_at, id\n            limit $2\n            for update skip locked`,\n          [sessionId, BATCH],\n        );\n        if (rows.length === 0) {\n          await client.query(\"commit\");\n          return progressed;\n        }\n        for (const row of rows) {\n          const event = toEvent(row);\n          const outcome = await this.#applyRow(client, event);\n          if (outcome === \"retry-later\") {\n            finished = false;\n            break;\n          }\n          progressed = true;\n          if (outcome === \"submitted\") submitted += 1;\n        }\n        await client.query(\"commit\");\n      } catch (error) {\n        await client.query(\"rollback\").catch(() => undefined);\n        throw error;\n      } finally {\n        client.release();\n      }\n      // Once per batch and after the commit. Inside the transaction this update would hold the session row's lock\n      // until the commit, and a later row of the batch (delete, a failSession) updates the same row on another\n      // connection: it would wait for a lock that only this transaction's end releases, until statement_timeout.\n      if (submitted > 0) await this.#touchSession(sessionId);\n      if (!finished) return progressed;\n    }\n    return progressed;\n  }\n\n  async #touchSession(sessionId: string): Promise<void> {\n    try {\n      await this.#pool.query(\n        \"update inbox.sessions set last_activity_at = clock_timestamp() where id = $1\",\n        [sessionId],\n      );\n    } catch (error) {\n      // Only the idle clock; the rows are already committed.\n      log(\"inbox-touch-failed\", { session: sessionId, message: errorMessage(error) });\n    }\n  }\n\n  async #applyRow(\n    client: pg.PoolClient,\n    event: InboxEvent,\n  ): Promise<\"submitted\" | \"gave-up\" | \"retry-later\"> {\n    const attempt = event.attempts + 1;\n    try {\n      const session = await getSession(client, event.sessionId);\n      if (session === undefined) throw new PermanentError(\"session does not exist\");\n      await this.#apply(event, session);\n      await client.query(\n        `update inbox.events\n            set status = 'submitted', submitted_at = clock_timestamp(), attempts = $2, error = null\n          where id = $1`,\n        [event.id, attempt],\n      );\n      this.#notBefore.delete(event.sessionId);\n      log(\"event-submitted\", { eventId: event.id, session: event.sessionId, kind: event.kind });\n      return \"submitted\";\n    } catch (error) {\n      const message = errorMessage(error).slice(0, 500);\n      const permanent =\n        error instanceof PermanentError || (attempt >= MAX_ATTEMPTS && event.kind !== \"delete\");\n      if (!permanent && event.kind === \"delete\") {\n        this.#notBefore.set(event.sessionId, Date.now() + deleteRetryDelayMs(attempt));\n      }\n      await client.query(\n        \"update inbox.events set status = $2, attempts = $3, error = $4 where id = $1\",\n        [event.id, permanent ? \"failed\" : \"pending\", attempt, message],\n      );\n      log(\"event-failed\", {\n        eventId: event.id,\n        session: event.sessionId,\n        attempt,\n        permanent,\n        message,\n      });\n      return permanent ? \"gave-up\" : \"retry-later\";\n    }\n  }\n}\n        log(\"failed-session-abort-failed\", { session: row.id, message: errorMessage(error) });\n      }\n    }\n  }\n\n  /**\n   * A submission ended without an answer. Rejected model credentials and a used-up turn budget end the session\n   * for good (`failed`); anything else leaves it active. The stored message is ours, never the provider's text.\n   */\n  async #runEnded(watched: Watched, outcome: RunOutcome): Promise<void> {\n    const failure = terminalFailure(outcome);\n    if (failure === undefined) return;\n    await this.#failSession(watched.sessionId, watched.conversationId, failure);\n  }\n\n  async #failSession(\n    sessionId: string,\n    conversationId: number | null,\n    failure: string,\n  ): Promise<void> {\n    const changed = await failSession(this.#pool, sessionId, failure);\n    if (changed) {\n      log(\"session-failed\", { session: sessionId, failure });\n    } else if ((await getSession(this.#pool, sessionId))?.status !== \"failed\") {\n      return;\n    }\n    // Withdraw whatever queued behind the failed run, so nothing more is sent to the provider. Also when the session\n    // was failed already: the status commits before the abort, so a caller whose abort died (or whose process did)\n    // retries here and must not find \"nothing changed\" and stop. A deleting or deleted session is not ours to abort.\n    if (conversationId !== null) await this.#host.abort(conversationId);\n  }\n\n  /**\n   * The session's conversation id, creating the conversation on first use. Serialised per session, so the\n   * stream handler and the inbox loop cannot create two. A crash between creating the conversation and\n   * storing its id leaves one empty, unreferenced conversation behind (documented limit).\n   */\n  async ensureConversation(session: SessionRow): Promise<number> {\n    if (session.conversationId !== null) return session.conversationId;\n    let creating = this.#creating.get(session.id);\n    if (creating === undefined) {\n      creating = this.#create(session.id).finally(() => this.#creating.delete(session.id));\n      this.#creating.set(session.id, creating);\n    }\n    return creating;\n  }\n\n  async #create(sessionId: string): Promise<number> {\n    const current = await getSession(this.#pool, sessionId);\n    if (current?.conversationId != null) return current.conversationId;\n    const conversationId = await this.#host.createConversation(\n      current?.model ?? this.#options.defaultModel,\n    );\n    await this.#pool.query(\n      \"update inbox.sessions set conversation_id = $1 where id = $2 and conversation_id is null\",\n      [conversationId, sessionId],\n    );\n    log(\"conversation-created\", { session: sessionId, conversation: conversationId });\n    return conversationId;\n  }\n\n  /** Applies one inbox event. Resolves when it is durably handed over; throws PermanentError if it never can be. */\n  async apply(event: InboxEvent, session: SessionRow): Promise<void> {\n    if (session.status === \"deleted\") throw new PermanentError(\"session is deleted\");\n    switch (event.kind) {\n      case \"message\":\n      case \"steer\": {\n        const text = event.payload.text;\n        if (typeof text !== \"string\" || text === \"\") throw new PermanentError(\"event has no text\");\n        if (session.status === \"failed\") {\n          // Retries an abort that failed when the session was failed (see #failSession); throws, and so retries the\n          // row, if the abort fails again.\n          if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n          throw new PermanentError(\"session has failed\");\n        }\n        const conversationId = await this.ensureConversation(session);\n        await this.#withinBudget(session, conversationId);\n        // Before the first turn: OneCLI agent, token and clone. A session without a repo skips all of it.\n        if (session.repo !== null) await this.#prepareRepo(session, conversationId);\n        const requestId = event.id;\n        const faultArmed =\n          this.#options.testFaults && event.payload.testFault === \"exit-after-submit\";\n        const alreadyAdmitted =\n          faultArmed && (await this.#host.hasSubmission(conversationId, requestId));\n        await this.#host.submitInput(conversationId, {\n          text,\n          requestId,\n          steer: event.kind === \"steer\",\n        });\n        this.#watcher.add({ sessionId: session.id, conversationId, requestId });\n        if (faultArmed && !alreadyAdmitted) {\n          // After the durable hand-over, before the row says so: exactly the window test 4 needs.\n          // Synchronous write: stdout to a pipe is async and process.exit would drop the line.\n          writeSync(\n            1,\n            `${JSON.stringify({ event: \"test-fault\", fault: \"exit-after-submit\", id: event.id })}\\n`,\n          );\n          process.exit(137);\n        }\n        return;\n      }\n      case \"cancel\": {\n        if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n        return;\n      }\n      case \"delete\": {\n        await this.#delete(session);\n        return;\n      }\n    }\n  }\npackages/session-core/migrations/004_repo.sql:15:create table if not exists inbox.tombstones (\npackages/session-core/src/store.ts:249:  return { source: \"system:delete\", sourceEventId: sessionId };\npackages/session-core/src/store.ts:322:    `insert into inbox.tombstones (session_id, conversation_id, repo, onecli_agent_id, onecli_secret_ids)\npackages/session-core/src/store.ts:340:    \"update inbox.tombstones set completed_at = coalesce(completed_at, clock_timestamp()) where session_id = $1\",\npackages/orchestrator/test/delete-repo.test.ts:56:      if (sql.includes(\"inbox.tombstones\") && sql.includes(\"insert\")) order.push(\"tombstone\");\n","isError":false}]}
