ENTRY 11314 {"id":11314,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":" * never cloned again behind the user's back.\n */\nexport async function prepareWorkspace(\n  env: WorkspaceEnv,\n  spec: RepoSpec,\n  options: PrepareOptions,\n): Promise<\"cloned\" | \"present\"> {\n  const p = pathsFor(options.root ?? WORKSPACE_ROOT);\n  await writeCa(env, p, options.ca);\n  const hasRepo = await isTrue(env.exists(`${p.repo}/.git`, context));\n  const hasMarker = await isTrue(env.exists(p.marker, context));\n  if (options.wasReady && (!hasMarker || !hasRepo)) {\n    throw new WorkspaceLostError(\n      \"the session's workspace is missing (repository or marker not found); it is not cloned again\",\n    );\n  }\n  let outcome: \"cloned\" | \"present\" = \"present\";\n  if (!hasRepo) {\n    await clone(env, p, spec, options.gitBase);\n    outcome = \"cloned\";\n  }\n  if (!hasMarker || outcome === \"cloned\") {\n    const marker = {\n      version: 1,\n      sessionId: options.sessionId,\n      repo: spec.repo,\n      ...(spec.branch === undefined ? {} : { branch: spec.branch }),\n      createdAt: (options.now?.() ?? new Date()).toISOString(),\n    };\n    await must(env.writeFile(p.marker, `${JSON.stringify(marker)}\\n`, context), \"write the marker\");\n  }\n  return outcome;\n}\n\nasync function clone(\n  env: WorkspaceEnv,\n  p: Paths,\n  spec: RepoSpec,\n  gitBase: string | undefined,\n): Promise<void> {\n  // A temp dir left by a crash during an earlier clone is incomplete by definition.\n  await must(\n    env.remove(p.cloneTmp, { recursive: true, force: true }, context),\n    \"clear the clone directory\",\n  );\n  let tail = \"\";\n  const run = await must(\n    env.exec(\n      [\n        \"git\",\n        \"clone\",\n        ...(spec.branch === undefined ? [] : [\"--branch\", spec.branch]),\n        \"--\",\n        cloneUrl(spec.repo, gitBase),\n        p.cloneTmp,\n      ],\n      {\n        cwd: p.root,\n        timeout: CLONE_TIMEOUT_S,\n        onOutput: (text) => {\n          tail = (tail + text).slice(-400);\n        },\n      },\n      context,\n    ),\n    \"git clone\",\n  );\n  if (run.exitCode !== 0) {\n    await env.remove(p.cloneTmp, { recursive: true, force: true }, context);\n    throw new Error(`git clone failed (exit ${String(run.exitCode)}): ${tail.trim()}`);\n  }\n  await must(env.renameFile(p.cloneTmp, p.repo, context), \"move the clone into place\");\n}\n): Promise<void> {\n  let body: Record<string, unknown>;\n  try {\n    body = await readJsonObject(req);\n  } catch (error) {\n    if (error instanceof BodyError) {\n      sendJson(res, 400, { error: error.message });\n      return;\n    }\n    throw error;\n  }\n  const model = chooseModel(deps.models, body);\n  if (typeof model === \"string\") {\n    sendJson(res, 400, { error: model });\n    return;\n  }\n  const repo = chooseRepo(body);\n  if (typeof repo === \"string\") {\n    sendJson(res, 400, { error: repo });\n    return;\n  }\n  const sessionId = await createSession(deps.pool, principal, model, repo);\n  sendJson(res, 201, {\n    sessionId,\n    provider: model.provider,\n    model: model.model,\n    ...(model.reasoning === undefined ? {} : { reasoning: model.reasoning }),\n    ...(repo === undefined\n      ? {}\n      : { repo: repo.repo, ...(repo.branch === undefined ? {} : { branch: repo.branch }) }),\n  });\n}\n\nasync function ownedSession(\n  pool: pg.Pool,\n  id: string,\n  principal: Principal,\n): Promise<SessionRow | undefined> {\n  if (!UUID.test(id)) return undefined;\n  const session = await getSession(pool, id);\n  return session?.ownerSubject === principal.subject ? session : undefined;\n}\n\nasync function postEvent(\n  req: IncomingMessage,\n  res: ServerResponse,\nimport { describe, expect, it } from \"vitest\";\nimport { branchError, chooseRepo, cloneUrl, repoError } from \"../src/repo.ts\";\n\ndescribe(\"repoError\", () => {\n  it(\"accepts owner/name\", () => {\n    for (const repo of [\"octo/hello\", \"my-org/my.repo_1\", \"A1/b-c\", \"octo/.github\"]) {\n      expect(repoError(repo), repo).toBeUndefined();\n    }\n  });\n\n  it(\"rejects anything else, in particular URLs, traversal and option-like names\", () => {\n    const bad = [\n      \"\",\n      \"octo\",\n      \"octo/\",\n      \"/hello\",\n      \"octo/hello/extra\",\n      \"https://github.com/octo/hello\",\n      \"git@github.com:octo/hello\",\n      \"octo/hello.git\",\n      \"octo/HELLO.GIT\",\n      \"octo/..\",\n      \"octo/a..b\",\n      \"../hello\",\n      \"octo/-rf\",\n      \"-octo/hello\",\n      \"octo-/hello\",\n      \"octo/hel lo\",\n      \"octo/hello\\n\",\n      \"octo/he;llo\",\n      \"octo/he$(x)\",\n      \"x\".repeat(40) + \"/hello\",\n      \"octo/\" + \"n\".repeat(101),\n    ];\n    for (const repo of bad) expect(repoError(repo), JSON.stringify(repo)).toBeDefined();\n  });\n});\n\ndescribe(\"branchError\", () => {\n  it(\"accepts usual branch names\", () => {\n    for (const branch of [\"main\", \"feature/x-1\", \"release-1.2.3\", \"pi/test_branch\", \"v1\"]) {\n      expect(branchError(branch), branch).toBeUndefined();\n    }\n  });\n\n  it(\"rejects options, traversal, whitespace and git-invalid refs\", () => {\n    const bad = [\n      \"\",\n      \"-main\",\n      \"--upload-pack=x\",\n      \"a..b\",\n      \"a//b\",\n      \"a/\",\n      \"a.\",\n      \"a.lock\",\n      \"a/.hidden\",\n      \"a b\",\n      \"a~1\",\n      \"a^\",\n      \"a:b\",\n      \"a?b\",\n      \"a*b\",\n      \"a[b\",\n      \"a\\\\b\",\n      \"a@{1}\",\n      \"/a\",\n      \"n\".repeat(201),\n    ];\n    for (const branch of bad) expect(branchError(branch), JSON.stringify(branch)).toBeDefined();\n  });\n});\n\ndescribe(\"chooseRepo\", () => {\n  it(\"returns undefined without a repo, so nothing changes for a plain session\", () => {\n    expect(chooseRepo({})).toBeUndefined();\n    expect(chooseRepo({ provider: \"scripted\", model: \"scripted-1\" })).toBeUndefined();\n  });\n\n  it(\"returns the validated spec, with the branch only when given\", () => {\n    expect(chooseRepo({ repo: \"octo/hello\" })).toEqual({ repo: \"octo/hello\" });\n    expect(chooseRepo({ repo: \"octo/hello\", branch: \"dev\" })).toEqual({\n      repo: \"octo/hello\",\n      branch: \"dev\",\n    });\n  });\n\n  it(\"returns the 400 message for a bad shape\", () => {\n    expect(chooseRepo({ branch: \"dev\" })).toMatch(/needs a repo/);\n    expect(chooseRepo({ repo: 5 })).toMatch(/must be a string/);\n    expect(chooseRepo({ repo: \"octo/hello\", branch: 5 })).toMatch(/branch must be a string/);\n    expect(chooseRepo({ repo: \"octo/hello\", branch: \"--x\" })).toMatch(/not a valid ref/);\n    expect(chooseRepo({ repo: \"http://evil/x\" })).toMatch(/owner\\/name/);\n    expect(chooseRepo({ repo: null })).toMatch(/must be a string/);\n  });\n});\n\ndescribe(\"cloneUrl\", () => {\n  it(\"is https on github.com and carries no credentials\", () => {\n    expect(cloneUrl(\"octo/hello\")).toBe(\"https://github.com/octo/hello.git\");\n  });\n});\n     1\t/** A repository workspace requested at session creation. `branch` absent: the repository's default branch. */\n     2\texport interface RepoSpec {\n     3\t  /** `owner/name` on github.com. */\n     4\t  repo: string;\n     5\t  branch?: string;\n     6\t}\n     7\t\n     8\t// GitHub owners are 1-39 characters of letters, digits and single hyphens; names are up to 100 characters of\n     9\t// letters, digits, `.`, `_` and `-`. The first pattern is the contract; the length caps and the checks below\n    10\t// close what a character class cannot (`..`, `.git`, a leading dash that git would read as an option).\n    11\tconst REPO = /^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$/;\n    12\tconst REF = /^[A-Za-z0-9][A-Za-z0-9._/-]*$/;\n    13\t\n    14\t/** Returns an error message, or undefined when `repo` is acceptable. */\n    15\texport function repoError(repo: string): string | undefined {\n    16\t  if (repo.length > 140 || !REPO.test(repo)) re