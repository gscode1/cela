ENTRY 11413 {"id":11413,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport { describe, expect, it } from \"vitest\";\n     2\timport { loadConfig } from \"../src/config.ts\";\n     3\timport { PLACEHOLDER_API_KEY } from \"../src/onecli.ts\";\n     4\timport { buildModels } from \"../src/providers.ts\";\n     5\t\n     6\tconst base = {\n     7\t  PI_DURABLE_DATABASE_URL: \"postgres://u:p@db:5432/app\",\n     8\t  PI_API_TOKENS: \"alice:0123456789abcdef0123\",\n     9\t};\n    10\tconst TOKEN = \"aoc_0123456789abcdef0123456789abcdef\";\n    11\tconst readCa = (): Promise<string> => Promise.resolve(\"\");\n    12\t\n    13\tdescribe(\"model config\", () => {\n    14\t  it(\"defaults to the scripted model, which needs no OneCLI token\", () => {\n    15\t    const config = loadConfig(base);\n    16\t    expect(config.models.default).toEqual({ provider: \"scripted\", model: \"scripted-1\" });\n    17\t    expect(config.turnBudget).toBe(100);\n    18\t    expect(config.onecli.token).toBeUndefined();\n    19\t  });\n    20\t\n    21\t  it(\"requires the OneCLI agent token for a real provider, and never prints it\", () => {\n    22\t    const env = { ...base, PI_MODEL_ALLOWLIST: \"openrouter/openai/gpt-4.1-nano\" };\n    23\t    expect(() => loadConfig(env)).toThrow(\n    24\t      /ONECLI_AGENT_TOKEN is required for model provider openrouter/,\n    25\t    );\n    26\t    const config = loadConfig({ ...env, ONECLI_AGENT_TOKEN: TOKEN });\n    27\t    expect(JSON.stringify(config)).not.toContain(TOKEN);\n    28\t    expect(config.onecli.token?.reveal()).toBe(TOKEN);\n    29\t  });\n    30\t\n    31\t  it(\"covers the cluster, the Kubernetes API and Postgres in NO_PROXY, and adds the environment's entries\", () => {\n    32\t    const { noProxy } = loadConfig({ ...base, NO_PROXY: \"corp.internal\" }).onecli;\n    33\t    expect(noProxy).toEqual(\n    34\t      expect.arrayContaining([\n    35\t        \".svc\",\n    36\t        \".cluster.local\",\n    37\t        \"kubernetes.default\",\n    38\t        \"pi-pg-rw\",\n    39\t        \"corp.internal\",\n    40\t      ]),\n    41\t    );\n    42\t  });\n    43\t\n    44\t  it(\"validates the turn budget\", () => {\n    45\t    expect(loadConfig({ ...base, PI_SESSION_TURN_BUDGET: \"7\" }).turnBudget).toBe(7);\n    46\t    expect(() => loadConfig({ ...base, PI_SESSION_TURN_BUDGET: \"0\" })).toThrow(/TURN_BUDGET/);\n    47\t    expect(() => loadConfig({ ...base, PI_SESSION_TURN_BUDGET: \"x\" })).toThrow(/TURN_BUDGET/);\n    48\t  });\n    49\t});\n    50\t\n    51\tdescribe(\"buildModels\", () => {\n    52\t  it(\"installs the scripted models and the legacy faux model for /control\", async () => {\n    53\t    const models = await buildModels(loadConfig(base), readCa);\n    54\t    expect(models.getModel(\"scripted\", \"scripted-1\")).toBeDefined();\n    55\t    expect(models.getModel(\"scripted\", \"scripted-2\")).toBeDefined();\n    56\t    expect(models.getModel(\"faux\", \"faux-1\")).toBeDefined();\n    57\t    expect(models.getModel(\"openrouter\", \"openai/gpt-4.1-nano\")).toBeUndefined();\n    58\t  });\n    59\t\n    60\t  it(\"installs an allowlisted real provider, whose API key is the placeholder, not a credential\", async () => {\n    61\t    const config = loadConfig({\n    62\t      ...base,\n    63\t      ONECLI_AGENT_TOKEN: TOKEN,\n    64\t      PI_MODEL_ALLOWLIST: \"openrouter/openai/gpt-4.1-nano,scripted/scripted-2\",\n    65\t    });\n    66\t    const models = await buildModels(config, readCa);\n    67\t    const model = models.getModel(\"openrouter\", \"openai/gpt-4.1-nano\");\n    68\t    expect(model).toBeDefined();\n    69\t    if (model === undefined) return;\n    70\t    const auth = await models.getAuth(model);\n    71\t    expect(auth?.auth.apiKey).toBe(PLACEHOLDER_API_KEY);\n    72\t    // A real key in the environment is ignored.\n    73\t    process.env.OPENROUTER_API_KEY = \"sk-real-should-never-be-used\";\n    74\t    try {\n    75\t      expect((await models.getAuth(model))?.auth.apiKey).toBe(PLACEHOLDER_API_KEY);\n    76\t    } finally {\n    77\t      delete process.env.OPENROUTER_API_KEY;\n    78\t    }\n    79\t  });\n    80\t\n    81\t  it(\"fails at start for an allowlisted model pi-ai does not know\", async () => {\n    82\t    const config = loadConfig({\n    83\t      ...base,\n    84\t      ONECLI_AGENT_TOKEN: TOKEN,\n    85\t      PI_MODEL_ALLOWLIST: \"openrouter/openai/no-such-model\",\n    86\t    });\n    87\t    await expect(buildModels(config, readCa)).rejects.toThrow(/openrouter\\/openai\\/no-such-model/);\n    88\t  });\n    89\t\n    90\t  it(\"gives the Codex provider a JWT-shaped placeholder login carrying the account id claim\", async () => {\n    91\t    const config = loadConfig({\n    92\t      ...base,\n    93\t      ONECLI_AGENT_TOKEN: TOKEN,\n    94\t      PI_MODEL_ALLOWLIST: \"openai-codex/gpt-6.1-terra\",\n    95\t      PI_CODEX_ACCOUNT_ID: \"acct-placeholder\",\n    96\t    });\n    97\t    const models = await buildModels(config, readCa);\n    98\t    const model = models.getModel(\"openai-codex\", \"gpt-6.1-terra\");\n    99\t    expect(model).toBeDefined();\n   100\t    if (model === undefined) return;\n   101\t    const key = (await models.getAuth(model))?.auth.apiKey ?? \"\";\n   102\t    const parts = key.split(\".\");\n   103\t    expect(parts).toHaveLength(3);\n   104\t    const claims = JSON.parse(Buffer.from(parts[1] ?? \"\", \"base64url\").toString(\"utf8\")) as Record<\n   105\t      string,\n   106\t      { chatgpt_account_id?: string }\n   107\t    >;\n   108\t    expect(claims[\"https://api.openai.com/auth\"]?.chatgpt_account_id).toBe(\"acct-placeholder\");\n   109\t  });\n   110\t});\n     1\t/** A model a session runs on: a Pi provider id and a model id within it. */\n     2\texport interface ModelChoice {\n     3\t  provider: string;\n     4\t  model: string;\n     5\t  /** Reasoning effort (Pi's `thinkingLevel`); unset leaves it to Pi's default, `off`. */\n     6\t  reasoning?: ThinkingLevel;\n     7\t}\n     8\t\n     9\texport const THINKING_LEVELS = [\"off\", \"minimal\", \"low\", \"medium\", \"high\", \"xhigh\"] as const;\n    10\texport type ThinkingLevel = (typeof THINKING_LEVELS)[number];\n    11\t\n    12\t/** `provider/model`. The model id may itself contain slashes (`openrouter/openai/gpt-4.1-nano`). */\n    13\texport function modelKey(choice: ModelChoice): string {\n    14\t  return `${choice.provider}/${choice.model}`;\n    15\t}\n    16\t\n    17\t/** Parses one `provider/model` pair. Throws for anything else, naming the entry. */\n    18\texport function parseModelKey(entry: string): ModelChoice {\n    19\t  const slash = entry.indexOf(\"/\");\n    20\t  const provider = entry.slice(0, slash);\n    21\t  const model = entry.slice(slash + 1);\n    22\t  if (slash <= 0 || model === \"\" || /\\s/.test(entry)) {\n    23\t    throw new Error(`model allowlist entry \"${entry}\" is not provider/model`);\n    24\t  }\n    25\t  return { provider, model };\n    26\t}\n    27\t\n    28\t/** `PI_MODEL_ALLOWLIST`: comma- or newline-separated `provider/model` pairs. */\n    29\texport function parseAllowlist(spec: string): ModelChoice[] {\n    30\t  return spec\n    31\t    .split(/[,\\n]/)\n    32\t    .map((entry) => entry.trim())\n    33\t    .filter((entry) => entry !== \"\")\n    34\t    .map(parseModelKey);\n    35\t}\n    36\t\n    37\texport const DEFAULT_MODEL: ModelChoice = { provider: \"scripted\", model: \"scripted-1\" };\n    38\texport const DEFAULT_ALLOWLIST = \"scripted/scripted-1,scripted/scripted-2\";\n    39\t\n    40\texport interface ModelPolicy {\n    41\t  default: ModelChoice;\n    42\t  /** The default is always allowed, so a session without a model field cannot be refused. */\n    43\t  allowed: readonly ModelChoice[];\n    44\t  /** `PI_MODEL_REASONING`, applied to every new session; unset for none. */\n    45\t  reasoning?: ThinkingLevel;\n    46\t}\n    47\t\n    48\texport function loadModelPolicy(env: Readonly<Record<string, string | undefined>>): ModelPolicy {\n    49\t  const reasoning = parseReasoning(env.PI_MODEL_REASONING);\n    50\t  const defaultChoice: ModelChoice = {\n    51\t    ...parseModelKey(\n    52\t      `${env.PI_MODEL_PROVIDER ?? DEFAULT_MODEL.provider}/${env.PI_MODEL_ID ?? DEFAULT_MODEL.model}`,\n    53\t    ),\n    54\t    ...(reasoning === undefined ? {} : { reasoning }),\n    55\t  };\n    56\t  const listed = parseAllowlist(env.PI_MODEL_ALLOWLIST ?? DEFAULT_ALLOWLIST);\n    57\t  const seen = new Set<string>();\n    58\t  const allowed = [defaultChoice, ...listed].filter((choice) => {\n    59\t    const key = modelKey(choice);\n    60\t    if (seen.has(key)) return false;\n    61\t    seen.add(key);\n    62\t    return true;\n    63\t  });\n    64\t  return { default: defaultChoice, allowed, ...(reasoning === undefined ? {} : { reasoning }) };\n    65\t}\n    66\t\n    67\tfunction parseReasoning(value: string | undefined): ThinkingLevel | undefined {\n    68\t  if (value === undefined || value === \"\") return undefined;\n    69\t  const level = THINKING_LEVELS.find((candidate) => candidate === value);\n    70\t  if (level === undefined) {\n    71\t    throw new Error(`PI_MODEL_REASONING must be one of ${THINKING_LEVELS.join(\", \")}`);\n    72\t  }\n    73\t  return level;\n    74\t}\n    75\t\n    76\t/**\n    77\t * The model for a new session: the default when the body names none, else the requested pair if the allowlist has\n    78\t * it. A string is the 400 message.\n    79\t */\n    80\texport function chooseModel(\n    81\t  policy: ModelPolicy,\n    82\t  body: Record<string, unknown>,\n    83\t): ModelChoice | string {\n    84\t  const { provider, model } = body;\n    85\t  if (provider === undefined && model === undefined) return policy.default;\n    86\t  if (\n    87\t    typeof provider !== \"string\" ||\n    88\t    typeof model !== \"string\" ||\n    89\t    provider === \"\" ||\n    90\t    model === \"\"\n    91\t  ) {\n    92\t    return \"provider and model must both be non-empty strings\";\n    93\t  }\n    94\t  const requested: ModelChoice = {\n    95\t    provider,\n    96\t    model,\n    97\t    ...(policy.reasoning === undefined ? {} : { reasoning: policy.reasoning }),\n    98\t  };\n    99\t  const key = modelKey(requested);\n   100\t  if (!policy.allowed.some((choice) => modelKey(choice) === key)) {\n   101\t    return `model ${key.slice(0, 200)} is not allowed`;\n   102\t  }\n   103\t  return requested;\n   104\t}\npackages/orchestrator/src/providers.ts:44:  const remote = config.models.allowed.filter((choice) => !LOCAL.has(choice.provider));\npackages/orchestrator/src/providers.ts:68:  for (const choice of config.models.allowed) {\npackages/orchestrator/src/providers.ts:69:    if (models.getModel(choice.provider, choice.model) === undefined) {\npackages/orchestrator/src/main.ts:125:    defaultModel: config.models.default,\n","isError":false}]}
