ENTRY 11321 {"id":11321,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport { rootCertificates } from \"node:tls\";\n     2\timport { fetch as undiciFetch, ProxyAgent } from \"undici\";\n     3\timport { InMemoryCredentialStore } from \"@earendil-works/pi-ai\";\n     4\timport type { FetchFunction, Models } from \"@earendil-works/pi-ai\";\n     5\timport type { MutableModels } from \"@earendil-works/pi-ai/models\";\n     6\t\n     7\t/**\n     8\t * A secret that never prints. `JSON.stringify`, template strings and `util.inspect` (so `console.log` and our\n     9\t * logger) all give `[redacted]`; only `reveal()` returns the value.\n    10\t */\n    11\texport class Redacted {\n    12\t  readonly #value: string;\n    13\t\n    14\t  constructor(value: string) {\n    15\t    this.#value = value;\n    16\t  }\n    17\t\n    18\t  reveal(): string {\n    19\t    return this.#value;\n    20\t  }\n    21\t\n    22\t  toJSON(): string {\n    23\t    return \"[redacted]\";\n    24\t  }\n    25\t\n    26\t  toString(): string {\n    27\t    return \"[redacted]\";\n    28\t  }\n    29\t\n    30\t  [Symbol.for(\"nodejs.util.inspect.custom\")](): string {\n    31\t    return \"[redacted]\";\n    32\t  }\n    33\t}\n    34\t\n    35\t/** How the orchestrator reaches model providers through the OneCLI gateway. */\n    36\texport interface OneCliConfig {\n    37\t  /** Proxy URL of the gateway, `http://onecli.onecli:10255`. No credentials in it: the token travels separately. */\n    38\t  gateway: string;\n    39\t  /** The orchestrator's OneCLI agent token (`aoc_...`), from the Secret `pi-onecli`. */\n    40\t  token: Redacted;\n    41\t  /** PEM of the OneCLI gateway CA, which signs the certificates the gateway presents for the model hosts. */\n    42\t  ca: string;\n    43\t  /** `NO_PROXY` entries: hosts that are reached directly, never through the gateway. */\n    44\t  noProxy: readonly string[];\n    45\t}\n    46\t\n    47\t/** Placeholder every provider's API-key lookup resolves to. The gateway replaces it with the real credential. */\n    48\texport const PLACEHOLDER_API_KEY = \"onecli-managed-placeholder\";\n    49\t\n    50\t/**\n    51\t * The pi-ai auth context: provider API keys and tokens resolve to a placeholder, whatever the process\n    52\t * environment holds, and files never exist. The orchestrator therefore never carries a real provider\n    53\t * credential, and a real one that sneaks into the environment is not used.\n    54\t */\n    55\texport const placeholderAuthContext = {\n    56\t  env: (name: string): Promise<string | undefined> =>\n    57\t    Promise.resolve(\n    58\t      /(_API_KEY|_API_TOKEN|_ACCESS_TOKEN)$/.test(name) ? PLACEHOLDER_API_KEY : undefined,\n    59\t    ),\n    60\t  fileExists: (): Promise<boolean> => Promise.resolve(false),\n    61\t};\n    62\t\n    63\t/**\n    64\t * The OpenAI Codex (ChatGPT subscription) provider has no API-key auth, only a stored OAuth login, and pi-ai reads the\n    65\t * `chatgpt-account-id` header value out of the access token (a JWT, claim `https://api.openai.com/auth`.\n    66\t * `chatgpt_account_id`). The gateway replaces both `Authorization` and `chatgpt-account-id` with the real login, so\n    67\t * the orchestrator holds this unsigned, JWT-shaped stand-in instead of a login.\n    68\t */\n    69\texport function codexPlaceholderToken(accountId: string): string {\n    70\t  const part = (value: unknown): string => Buffer.from(JSON.stringify(value)).toString(\"base64url\");\n    71\t  return `${part({ alg: \"none\", typ: \"JWT\" })}.${part({\n    72\t    \"https://api.openai.com/auth\": { chatgpt_account_id: accountId },\n    73\t  })}.${PLACEHOLDER_API_KEY}`;\n    74\t}\n    75\t\n    76\t/** An in-memory credential store holding the Codex placeholder login, valid far beyond any refresh window. */\n    77\texport async function placeholderCredentials(accountId: string): Promise<InMemoryCredentialStore> {\n    78\t  const store = new InMemoryCredentialStore();\n    79\t  await store.modify(\"openai-codex\", () =>\n    80\t    Promise.resolve({\n    81\t      type: \"oauth\" as const,\n    82\t      access: codexPlaceholderToken(accountId),\n    83\t      refresh: PLACEHOLDER_API_KEY,\n    84\t      expires: Date.now() + 10 * 365 * 24 * 3600 * 1000,\n    85\t    }),\n    86\t  );\n    87\t  return store;\n    88\t}\n    89\t\n    90\texport function parseNoProxy(value: string | undefined): string[] {\n    91\t  return (value ?? \"\")\n    92\t    .split(\",\")\n    93\t    .map((entry) => entry.trim().toLowerCase())\n    94\t    .filter((entry) => entry !== \"\");\n    95\t}\n    96\t\n    97\t/**\n    98\t * `NO_PROXY` matching as curl and Go do it: `*` matches everything, `.suffix` and `suffix` match the host and its\n    99\t * subdomains, an IPv4 CIDR matches addresses in the block, and a port, when given, must match.\n   100\t */\n   101\texport function bypassesProxy(url: URL, noProxy: readonly string[]): boolean {\n   102\t  const host = url.hostname.toLowerCase().replace(/^\\[|\\]$/g, \"\");\n   103\t  const port = url.port || (url.protocol === \"https:\" ? \"443\" : \"80\");\n   104\t  for (const entry of noProxy) {\n   105\t    if (entry === \"*\") return true;\n   106\t    const [pattern, entryPort] = splitPort(entry);\n   107\t    if (entryPort !== undefined && entryPort !== port) continue;\n   108\t    if (pattern.includes(\"/\")) {\n   109\t      if (inCidr(host, pattern)) return true;\n   110\t      continue;\n   111\t    }\n   112\t    const bare = pattern.replace(/^\\*?\\./, \"\");\n   113\t    if (host === bare || host.endsWith(`.${bare}`)) return true;\n   114\t  }\n   115\t  return false;\n   116\t}\n   117\t\n   118\tfunction splitPort(entry: string): [string, string | undefined] {\n   119\t  const match = /^(.*):(\\d+)$/.exec(entry);\n   120\t  return match?.[1] === undefined ? [entry, undefined] : [match[1], match[2]];\n   121\t}\n   122\t\n   123\tfunction ipv4ToInt(address: string): number | undefined {\n   124\t  const parts = address.split(\".\");\n   125\t  if (parts.length !== 4) return undefined;\n   126\t  let value = 0;\n   127\t  for (const part of parts) {\n   128\t    const octet = Number(part);\n   129\t    if (!/^\\d{1,3}$/.test(part) || octet > 255) return undefined;\n   130\t    value = value * 256 + octet;\n   131\t  }\n   132\t  return value;\n   133\t}\n   134\t\n   135\tfunction inCidr(host: string, cidr: string): boolean {\n   136\t  const [network = \"\", bitsText = \"\"] = cidr.split(\"/\");\n   137\t  const address = ipv4ToInt(host);\n   138\t  const base = ipv4ToInt(network);\n   139\t  const bits = Number(bitsText);\n   140\t  if (address === undefined || base === undefined || !Number.isInteger(bits)) return false;\n   141\t  if (bits < 0 || bits > 32) return false;\n   142\t  const size = 2 ** (32 - bits);\n   143\t  return Math.floor(address / size) === Math.floor(base / size);\n   144\t}\n   145\t\n   146\t/**\n   147\t * A `fetch` for model calls only. Requests go through the OneCLI gateway with the orchestrator's agent token\n   148\t * (`Proxy-Authorization`, basic with any username) and trust the gateway CA for the certificates it issues.\n   149\t * The dispatcher belongs to this function: nothing sets a process-wide proxy or changes the global dispatcher,\n   150\t * so the Kubernetes client, Postgres and the bridges are never proxied. Hosts in `noProxy` skip the gateway.\n   151\t */\n   152\texport function createGatewayFetch(config: OneCliConfig): FetchFunction {\n   153\t  const proxy = new ProxyAgent({\n   154\t    uri: config.gateway,\n   155\t    token: `Basic ${Buffer.from(`x:${config.token.reveal()}`).toString(\"base64\")}`,\n   156\t    requestTls: { ca: [...rootCertificates, config.ca] },\n   157\t  });\n   158\t  const gatewayFetch = (\n   159\t    input: Parameters<FetchFunction>[0],\n   160\t    init?: Parameters<FetchFunction>[1],\n   161\t  ) => {\n   162\t    const url = new URL(input instanceof Request ? input.url : input.toString());\n   163\t    if (bypassesProxy(url, config.noProxy)) return globalThis.fetch(input, init);\n   164\t    // undici's fetch and its own ProxyAgent: the same undici version on both sides of the dispatcher call.\n   165\t    return undiciFetch(\n   166\t      input as Parameters<typeof undiciFetch>[0],\n   167\t      { ...init, dispatcher: proxy } as Parameters<typeof undiciFetch>[1],\n   168\t    ) as unknown as ReturnType<FetchFunction>;\n   169\t  };\n   170\t  return gatewayFetch;\n   171\t}\n   172\t\n   173\t/**\n   174\t * The `Models` the Harness sees, with every stream request carrying `fetch`. Pi Durable has no per-conversation\n   175\t * hook for pi-ai's `fetch` option, so the wrapper adds it where the Harness calls `streamSimple` and `stream`.\n   176\t */\n   177\texport function withFetch(models: MutableModels, fetch: FetchFunction): Models {\n   178\t  return new Proxy(models, {\n   179\t    get(target, property, receiver): unknown {\n   180\t      const value: unknown = Reflect.get(target, property, receiver);\n   181\t      if (typeof value !== \"function\") return value;\n   182\t      const method = value as (...args: unknown[]) => unknown;\n   183\t      if (\n   184\t        property === \"streamSimple\" ||\n   185\t        property === \"stream\" ||\n   186\t        property === \"completeSimple\" ||\n   187\t        property === \"complete\"\n   188\t      ) {\n   189\t        return (model: unknown, context: unknown, options?: Record<string, unknown>) =>\n   190\t          // `sse`: the Codex provider defaults to a WebSocket, which is not proven through the gateway.\n   191\t          method.call(target, model, context, {\n   192\t            transport: \"sse\",\n   193\t            ...options,\n   194\t            fetch: options?.fetch ?? fetch,\n   195\t          });\n   196\t      }\n   197\t      return method.bind(target);\n   198\t    },\n   199\t  });\n   200\t}\n     1\timport { loadModelPolicy } from \"@pi-durable-k8s/session-core\";\n     2\timport type { ModelPolicy } from \"@pi-durable-k8s/session-core\";\n     3\timport { GITHUB_APP_DIR } from \"./github-app.js\";\n     4\timport { parseNoProxy, PLACEHOLDER_API_KEY, Redacted } from \"./onecli.js\";\n     5\t\n     6\t/** Providers served by the in-process scripted model: no network, no OneCLI. */\n     7\tconst LOCAL_PROVIDERS = new Set([\"scripted\", \"faux\"]);\n     8\t\n     9\t/** Environment contract of the orchestrator. Secrets (database URL, sandboxd token, API tokens) are env-only. */\n    10\texport interface OrchestratorConfig {\n    11\t  databaseUrl: string;\n    12\t  /** Dedicated schema holding the adapter's tables; it must exist. Also the scope of the ownership lock. */\n    13\t  schema: string;\n    14\t  namespace: string;\n    15\t  /** SandboxWarmPool every session's claim references. */\n    16\t  warmPool: string;\n    17\t  port: number;\n    18\t  /** Names this process in pg_stat_activity and logs. */\n    19\t  instance: string;\n    20\t  /** `owner:token` entries for the same bearer-token authentication as ingest. */\n    21\t  apiTokens: string;\n    22\t  /** Mount the test-only /control surface (Phase 3 scripted sessions). */\n    23\t  control: boolean;\n    24\t  /** Honour `payload.testFault` on inbox rows (test 4 kills the process between submit and mark). */\n    25\t  testFaults: boolean;\n    26\t  /** Default model and allowlist (`PI_MODEL_PROVIDER`, `PI_MODEL_ID`, `PI_MODEL_ALLOWLIST`, one ConfigMap). */\n    27\t  models: ModelPolicy;\n    28\t  /** Model turns (assistant responses) one session may use in total; the first spend limit. */\n    29\t  turnBudget: number;\n    30\t  /** Sandbox idle handling. Both are in milliseconds; see docs/decisions/0004-idle-suspend.md. */\n    31\t  sandbox: {\n    32\t    /** An env with no call for this long is closed (its bridge process stops); the next tool call reopens it. */\n    33\t    idleEvictMs: number;\n    34\t    /** A sandbox idle this long is suspended (Pod deleted, PVC kept) and resumed by the next tool call. 0 = never. */\n    35\t    idleSuspendMs: number;\n    36\t  };\n    37\t  /** Periodic removal of resources whose session is deleted or unknown; see docs/decisions/0002-orphan-sweep.md. */\n    38\t  sweep: {\n    39\t    /** Time between runs. 0 turns the sweep off. */\n    40\t    intervalMs: number;\n    41\t    /** An object younger than this is never swept. */\n    42\t    graceMs: number;\n    43\t    /** Most actions per run. */\n    44\t    maxActions: number;\n    45\t  };\n    46\t  /** Where model calls go. `token` is set only when some allowed provider needs the gateway. */\n    47\t  onecli: {\n    48\t    gateway: string;\n    49\t    caFile: string;\n    50\t    noProxy: readonly string[];\n    51\t    token: Redacted | undefined;\n    52\t    /** Account id inside the OpenAI Codex placeholder token. The gateway injects the real one; see `codexPlaceholderToken`. */\n    53\t    codexAccountId: string;\n    54\t  };\n    55\t  /**\n    56\t   * Optional repository workspaces (Phase 4c). Both secrets reach the orchestrator only: the OneCLI admin API key\n    57\t   * from Secret `pi-onecli-admin` (env), the GitHub App key from Secret `pi-github-app` (mounted files).\n    58\t   */\n    59\t  repos: {\n    60\t    /** Management API of OneCLI v2, `:10256`. The proxy (`onecli.gateway`) is a different port. */\n    61\t    onecliApi: string;\n    62\t    /** `ONECLI_API_KEY` (`oc_...`). Undefined: sessions that ask for a repo are refused. */\n    63\t    onecliApiKey: Redacted | undefined;\n    64\t    githubAppDir: string;\n    65\t  };\n    66\t}\n    67\t\n    68\t/**\n    69\t * Hosts a model call must never be proxied to: the cluster, the Kubernetes API and Postgres. The gateway refuses\n    70\t * private targets anyway; this keeps them off it. The deployment also exports it as `NO_PROXY`, and an entry\n    71\t * of `NO_PROXY` in the environment adds to it.\n    72\t */\n    73\texport const DEFAULT_NO_PROXY = [\n    74\t  \"localhost\",\n    75\t  \"127.0.0.1\",\n    76\t  \".svc\",\n    77\t  \".cluster.local\",\n    78\t  \"kubernetes.default\",\n    79\t  \"pi-pg-rw\",\n    80\t  \"10.0.0.0/8\",\n    81\t  \"172.16.0.0/12\",\n    82\t  \"192.168.0.0/16\",\n    83\t];\n    84\t\n    85\t/** A non-negative whole number of seconds from the environment, as milliseconds. */\n    86\tfunction seconds(\n    87\t  env: Readonly<Record<string, string | undefined>>,\n    88\t  name: string,\n    89\t  fallback: number,\n    90\t): number {\n    91\t  const value = Number(env[name] ?? String(fallback));\n    92\t  if (!Number.isInteger(value) || value < 0)\n    93\t    throw new Error(`${name} must be a whole number of seconds, 0 or more`);\n    94\t  return value * 1000;\n    95\t}\n    96\t\n    97\texport function loadConfig(env: Readonly<Record<string, string | undefined>>): OrchestratorConfig {\n    98\t  const databaseUrl = env.PI_DURABLE_DATABASE_URL;\n    99\t  if (!databaseUrl) throw new Error(\"PI_DURABLE_DATABASE_URL is required\");\n   100\t  const apiTokens = env.PI_API_TOKENS;\n   101\t  if (!apiTokens) throw new Error(\"PI_API_TOKENS is required\");\n   102\t  const port = Number(env.PI_ORCH_PORT ?? \"8081\");\n   103\t  if (!Number.isInteger(port) || port < 0 || port > 65535)\n   104\t    throw new Error(\"PI_ORCH_PORT is invalid\");\n   105\t  const turnBudget = Number(env.PI_SESSION_TURN_BUDGET ?? \"100\");\n   106\t  if (!Number.isInteger(turnBudget) || turnBudget < 1)\n   107\t    throw new Error(\"PI_SESSION_TURN_BUDGET must be an integer of 1 or more\");\n   108\t  const idleEvictMs = seconds(env, \"PI_SANDBOX_IDLE_EVICT_SECONDS\", 120);\n   109\t  const idleSuspendMs = seconds(env, \"PI_SANDBOX_IDLE_SUSPEND_SECONDS\", 1800);\n   110\t  // A sandbox is suspended only after its bridge is gone; suspending first would cut a bridge that is still open.\n   111\t  if (idleSuspendMs > 0 && idleSuspendMs < idleEvictMs)\n   112\t    throw new Error(\n   113\t      \"PI_SANDBOX_IDLE_SUSPEND_SECONDS must not be below PI_SANDBOX_IDLE_EVICT_SECONDS\",\n   114\t    );\n   115\t  const maxActions = Number(env.PI_SWEEP_MAX_ACTIONS ?? \"10\");\n   116\t  if (!Number.isInteger(maxActions) || maxActions < 1)\n   117\t    throw new Error(\"PI_SWEEP_MAX_ACTIONS must be an integer of 1 or more\");\n   118\t  const models = loadModelPolicy(env);\n   119\t  const remote = models.allowed.find((choice) => !LOCAL_PROVIDERS.has(choice.provider));\n   120\t  const token = env.ONECLI_AGENT_TOKEN;\n   121\t  if (remote !== undefined && !token) {\n   122\t    throw new Error(`ONECLI_AGENT_TOKEN is required for model provider ${remote.provider}`);\n   123\t  }\n   124\t  return {\n   125\t    databaseUrl,\n   126\t    schema: env.PI_DURABLE_SCHEMA ?? \"public\",\n   127\t    namespace: env.PI_ORCH_NAMESPACE ?? \"pi-durable-poc\",\n   128\t    warmPool: env.PI_ORCH_WARMPOOL ?? \"pi-env-pool\",\n   129\t    port,\n   130\t    instance: env.POD_NAME ?? `orchestrator-${String(process.pid)}`,\n   131\t    apiTokens,\n   132\t    control: env.PI_ORCH_CONTROL === \"1\",\n   133\t    testFaults: env.PI_ORCH_TEST_FAULTS === \"1\",\n   134\t    models,\n   135\t    turnBudget,\n   136\t    sandbox: { idleEvictMs, idleSuspendMs },\n   137\t    sweep: {\n   138\t      intervalMs: seconds(env, \"PI_SWEEP_INTERVAL_SECONDS\", 300),\n   139\t      graceMs: seconds(env, \"PI_SWEEP_GRACE_SECONDS\", 600),\n   140\t      maxActions,\n   141\t    },\n   142\t    onecli: {\n   143\t      gateway: env.PI_ONECLI_GATEWAY ?? \"http://onecli.onecli:10255\",\n   144\t      caFile: env.PI_ONECLI_CA_FILE ?? \"/etc/onecli/ca.pem\",\n   145\t      noProxy: [...DEFAULT_NO_PROXY, ...parseNoProxy(env.NO_PROXY)],\n   146\t      token: token ? new Redacted(token) : undefined,\n   147\t      codexAccountId: env.PI_CODEX_ACCOUNT_ID ?? PLACEHOLDER_API_KEY,\n   148\t    },\n   149\t    repos: {\n   150\t      onecliApi: env.PI_ONECLI_API ?? \"http://onecli.onecli:10256\",\n   151\t      onecliApiKey: env.ONECLI_API_KEY ? new Redacted(env.ONECLI_API_KEY) : undefined,\n   152\t      githubAppDir: env.PI_GITHUB_APP_DIR ?? GITHUB_APP_DIR,\n   153\t    },\n   154\t  };\n   155\t}\n","isError":false}]}
