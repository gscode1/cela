ENTRY 11304 {"id":11304,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport { readFile } from \"node:fs/promises\";\n     2\timport type { Models } from \"@earendil-works/pi-ai\";\n     3\timport { createModels } from \"@earendil-works/pi-ai/models\";\n     4\timport { builtinProviders } from \"@earendil-works/pi-ai/providers/all\";\n     5\timport { modelKey } from \"@pi-durable-k8s/session-core\";\n     6\timport type { OrchestratorConfig } from \"./config.js\";\n     7\timport { scriptedProvider } from \"./model.js\";\n     8\timport {\n     9\t  createGatewayFetch,\n    10\t  placeholderAuthContext,\n    11\t  placeholderCredentials,\n    12\t  withFetch,\n    13\t} from \"./onecli.js\";\n    14\t\n    15\tconst LOCAL = new Set([\"scripted\", \"faux\"]);\n    16\t\n    17\t/**\n    18\t * The `Models` of the orchestrator.\n    19\t *\n    20\t * Pi Durable stores a conversation's model as `{ provider, modelId }` names and resolves them against this `Models`\n    21\t * at every request, so every provider a stored conversation may name must be installed at every start: the\n    22\t * allowlist's providers, the scripted ones, and `faux` for the Phase 3 /control sessions.\n    23\t *\n    24\t * Real providers resolve their API key to a placeholder (`placeholderAuthContext`) and send their requests through\n    25\t * the OneCLI gateway, which replaces the placeholder with the credential it holds. Throws when an allowlisted model\n    26\t * is not in pi-ai's catalog, so a typo in the ConfigMap fails at start instead of at the first request.\n    27\t */\n    28\texport async function buildModels(\n    29\t  config: OrchestratorConfig,\n    30\t  readCa: (path: string) => Promise<string> = (path) => readFile(path, \"utf8\"),\n    31\t): Promise<Models> {\n    32\t  const models = createModels({\n    33\t    authContext: placeholderAuthContext,\n    34\t    credentials: await placeholderCredentials(config.onecli.codexAccountId),\n    35\t  });\n    36\t  models.setProvider(scriptedProvider({ provider: \"faux\" }).provider);\n    37\t  models.setProvider(\n    38\t    scriptedProvider({\n    39\t      provider: \"scripted\",\n    40\t      models: [{ id: \"scripted-1\" }, { id: \"scripted-2\" }],\n    41\t    }).provider,\n    42\t  );\n    43\t\n    44\t  const remote = config.models.allowed.filter((choice) => !LOCAL.has(choice.provider));\n    45\t  const token = config.onecli.token;\n    46\t  if (remote.length === 0 || token === undefined) {\n    47\t    assertInstalled(models, config);\n    48\t    return models;\n    49\t  }\n    50\t  const wanted = new Set(remote.map((choice) => choice.provider));\n    51\t  for (const provider of builtinProviders()) {\n    52\t    if (wanted.has(provider.id)) models.setProvider(provider);\n    53\t  }\n    54\t  assertInstalled(models, config);\n    55\t  const ca = await readCa(config.onecli.caFile);\n    56\t  return withFetch(\n    57\t    models,\n    58\t    createGatewayFetch({\n    59\t      gateway: config.onecli.gateway,\n    60\t      token,\n    61\t      ca,\n    62\t      noProxy: config.onecli.noProxy,\n    63\t    }),\n    64\t  );\n    65\t}\n    66\t\n    67\tfunction assertInstalled(models: Models, config: OrchestratorConfig): void {\n    68\t  for (const choice of config.models.allowed) {\n    69\t    if (models.getModel(choice.provider, choice.model) === undefined) {\n    70\t      throw new Error(`allowed model ${modelKey(choice)} is not known to pi-ai`);\n    71\t    }\n    72\t  }\n    73\t}\n","isError":false}]}
