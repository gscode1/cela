qZhnUtxzX9/2FzyhS9sWQf5S0GJE0AKBrFqjpeYcg==}\n615-    engines: {node: '>=8.0.0'}\n616-\n617-  '@oxc-project/types@0.156.0':\n618-    resolution: {integrity: sha512-1Duyg48TdJNdyhEB8Xn1L36bT9Pv6GUtlKjHxOys8xkaF/rQq3XJE+bAurSK/AgIz5mGFsb77cn9Pb20+WCScw==}\n--\n2436-      '@emnapi/runtime': 2.0.0-beta.2\n2437-      '@tybys/wasm-util': 0.10.4\n2438-    optional: true\n2439-\n2440:  '@netzlabor/pi-durable-postgres@file:vendor/netzlabor-pi-durable-postgres-0.2.0.tgz(@earendil-works/chord@1.5.2(ws@8.23.0))(@earendil-works/pi-durable@1.5.2(@aws-sdk/credential-provider-node@3.972.97)(@smithy/signature-v4@5.7.5)(undici@8.12.4)(ws@8.23.0))':\n2441-    dependencies:\n2442-      '@earendil-works/chord': 1.5.2(ws@8.23.0)\n2443-      '@earendil-works/pi-durable': 1.5.2(@aws-sdk/credential-provider-node@3.972.97)(@smithy/signature-v4@5.7.5)(undici@8.12.4)(ws@8.23.0)\n2444-      '@types/pg': 8.23.1\n2445-      pg: 8.23.1\n2446-    transitivePeerDependencies:\n2447-      - pg-native\n2448-\n2449-  '@opentelemetry/api@1.9.0': {}\n2450-\n2451-  '@oxc-project/types@0.156.0': {}\n2452-\n     1\timport type { Storage } from \"@earendil-works/pi-durable\";\n     2\timport { openNodePostgresStorage } from \"@netzlabor/pi-durable-postgres\";\n     3\timport type { OrchestratorConfig } from \"./config.js\";\n     4\timport { errorMessage, log } from \"./log.js\";\n     5\t\n     6\t/**\n     7\t * Connection settings against silent drops: TCP keepalive notices a dead peer in about a minute, and\n     8\t * the statement timeout turns a hung query into a failure (which fails the Harness closed) instead of\n     9\t * a hang. The adapter pins one connection, so `max: 1` is all it can use.\n    10\t */\n    11\texport function poolConfig(config: OrchestratorConfig): Record<string, unknown> {\n    12\t  return {\n    13\t    connectionString: config.databaseUrl,\n    14\t    options: `-c search_path=${config.schema}`,\n    15\t    application_name: config.instance,\n    16\t    max: 1,\n    17\t    connectionTimeoutMillis: 5_000,\n    18\t    keepAlive: true,\n    19\t    keepAliveInitialDelayMillis: 10_000,\n    20\t    statement_timeout: 30_000,\n    21\t    query_timeout: 35_000,\n    22\t  };\n    23\t}\n    24\t\n    25\tconst LOCK_HELD = /only one owner is supported|in use/;\n    26\t\n    27\t/**\n    28\t * Opens the storage, and waits while another orchestrator owns the schema. The adapter refuses a\n    29\t * second owner immediately instead of blocking, so \"blocking on the lock\" is this retry loop. Other\n    30\t * failures (database not reachable yet) are retried the same way; secrets are never in these messages.\n    31\t */\n    32\texport async function openStorageWhenFree(\n    33\t  config: OrchestratorConfig,\n    34\t  signal: AbortSignal,\n    35\t  retryMs = 2_000,\n    36\t): Promise<Storage> {\n    37\t  let waitingLogged = false;\n    38\t  for (;;) {\n    39\t    signal.throwIfAborted();\n    40\t    try {\n    41\t      return await openNodePostgresStorage({ config: poolConfig(config) });\n    42\t    } catch (error) {\n    43\t      const message = errorMessage(error);\n    44\t      if (LOCK_HELD.test(message)) {\n    45\t        if (!waitingLogged) log(\"waiting-for-lock\", { instance: config.instance });\n    46\t        waitingLogged = true;\n    47\t      } else {\n    48\t        log(\"storage-open-failed\", { instance: config.instance, message });\n    49\t      }\n    50\t      await new Promise((resolve) => setTimeout(resolve, retryMs));\n    51\t    }\n    52\t  }\n    53\t}\nimport { describe, expect, it } from \"vitest\";\nimport { loadConfig } from \"../src/config.ts\";\nimport { poolConfig } from \"../src/storage.ts\";\nimport { claimNameFor } from \"../src/sandboxes.ts\";\n\nconst env = {\n  PI_DURABLE_DATABASE_URL: \"postgres://u:p@db:5432/app\",\n  PI_API_TOKENS: \"alice:0123456789abcdef0123\",\n  POD_NAME: \"pi-orchestrator-abc\",\n};\n\ndescribe(\"config\", () => {\n  it(\"requires the database URL and API tokens and defaults the rest\", () => {\n    expect(() => loadConfig({})).toThrow(/PI_DURABLE_DATABASE_URL/);\n    expect(() => loadConfig({ PI_DURABLE_DATABASE_URL: \"x\" })).toThrow(/PI_API_TOKENS/);\n    expect(loadConfig(env)).toMatchObject({\n      namespace: \"pi-durable-poc\",\n      warmPool: \"pi-env-pool\",\n      port: 8081,\n      control: false,\n      testFaults: false,\n    });\n  });\n\n  it(\"sets keepalive and timeouts so a silent drop fails closed instead of hanging\", () => {\n    expect(poolConfig(loadConfig(env))).toMatchObject({\n      keepAlive: true,\n      keepAliveInitialDelayMillis: 10_000,\n      statement_timeout: 30_000,\n      max: 1,\n      application_name: \"pi-orchestrator-abc\",\n    });\n  });\n\n  it(\"names claims from the conversation id as valid DNS-1123 names\", () => {\n    expect(claimNameFor(42)).toBe(\"pi-conv-42\");\n    expect(claimNameFor(42)).toMatch(/^[a-z0-9]([-a-z0-9]*[a-z0-9])?$/);\n  });\n\n  it(\"defaults the sandbox idle handling and the sweep, and reads them in seconds\", () => {\n    expect(loadConfig(env)).toMatchObject({\n      sandbox: { idleEvictMs: 120_000, idleSuspendMs: 1_800_000 },\n      sweep: { intervalMs: 300_000, graceMs: 600_000, maxActions: 10 },\n    });\n    expect(\n      loadConfig({\n        ...env,\n        PI_SANDBOX_IDLE_EVICT_SECONDS: \"30\",\n        PI_SANDBOX_IDLE_SUSPEND_SECONDS: \"90\",\n        PI_SWEEP_INTERVAL_SECONDS: \"15\",\n        PI_SWEEP_GRACE_SECONDS: \"45\",\n        PI_SWEEP_MAX_ACTIONS: \"3\",\n      }),\n    ).toMatchObject({\n      sandbox: { idleEvictMs: 30_000, idleSuspendMs: 90_000 },\n      sweep: { intervalMs: 15_000, graceMs: 45_000, maxActions: 3 },\n    });\n  });\n\n  it(\"rejects idle and sweep settings that cannot work\", () => {\n    expect(() => loadConfig({ ...env, PI_SANDBOX_IDLE_SUSPEND_SECONDS: \"60\" })).toThrow(\n      /must not be below/,\n    );\n    expect(() => loadConfig({ ...env, PI_SANDBOX_IDLE_SUSPEND_SECONDS: \"-1\" })).toThrow(\n      /whole number/,\n    );\n    expect(() => loadConfig({ ...env, PI_SWEEP_GRACE_SECONDS: \"1.5\" })).toThrow(/whole number/);\n    expect(() => loadConfig({ ...env, PI_SWEEP_MAX_ACTIONS: \"0\" })).toThrow(/1 or more/);\n    expect(loadConfig({ ...env, PI_SANDBOX_IDLE_SUSPEND_SECONDS: \"0\" }).sandbox.idleSuspendMs).toBe(\n      0,\n    );\n  });\n});\n","isError":false}]}
