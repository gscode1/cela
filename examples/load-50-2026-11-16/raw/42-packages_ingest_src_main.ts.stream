ENTRY 12367 {"id":12367,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { readdir, readFile } from \"node:fs/promises\";\nimport type pg from \"pg\";\n\nconst MIGRATIONS = new URL(\"../migrations/\", import.meta.url);\n/** Serialises concurrent starters (several ingest replicas plus the orchestrator). */\nconst LOCK_KEY = \"pi-durable-k8s:inbox-migrate\";\n/**\n * How long DDL may wait for a lock. ALTER TABLE queues for ACCESS EXCLUSIVE and, while queued, blocks every other\n * query on the table; the orchestrator's inbox drain holds row locks for minutes while it prepares a repo workspace.\n * Failing fast lets the caller retry instead of stalling all traffic behind a migration that cannot run yet.\n */\nconst LOCK_TIMEOUT = \"3s\";\nconst UNDEFINED_TABLE = \"42P01\";\n\n/**\n * Applies the inbox schema: every `NNN_*.sql` in order, each idempotent, each recorded in\n * `inbox.schema_migrations`. When every file is recorded this is one plain SELECT: no advisory lock, no DDL, so a\n * process restart never queues behind (or in front of) running traffic. Only a missing file takes the lock and runs.\n *\n * A database that predates the table has all files applied but nothing recorded; it takes the slow path once, the\n * idempotent files re-run (they change nothing) and are recorded, which is the backfill.\n */\nexport async function applyMigrations(pool: pg.Pool, dir: URL = MIGRATIONS): Promise<void> {\n  const files = (await readdir(dir)).filter((name) => name.endsWith(\".sql\")).sort();\n  const applied = await recordedVersions(pool);\n  if (applied !== undefined && files.every((name) => applied.has(name))) return;\n\n  const scripts = new Map(\n    await Promise.all(\n      files.map(async (name) => [name, await readFile(new URL(name, dir), \"utf8\")] as const),\n    ),\n  );\n  const client = await pool.connect();\n  try {\n    await client.query(\"begin\");\n    await client.query(`set local lock_timeout = '${LOCK_TIMEOUT}'`);\n    await client.query(\"select pg_advisory_xact_lock(hashtextextended($1, 0))\", [LOCK_KEY]);\n    // Another starter may have finished while this one waited for the lock.\n    await client.query(\"create schema if not exists inbox\");\n    await client.query(\n      `create table if not exists inbox.schema_migrations (\n         version    text primary key,\n         applied_at timestamptz not null default clock_timestamp()\n       )`,\n    );\n    const done = await recordedVersions(client);\n    for (const [name, sql] of scripts) {\n      if (done?.has(name) === true) continue;\n      await client.query(sql);\n      await client.query(\"insert into inbox.schema_migrations (version) values ($1)\", [name]);\n    }\n    await client.query(\"commit\");\n  } catch (error) {\n    await client.query(\"rollback\").catch(() => undefined);\n    throw error;\n  } finally {\n    client.release();\n  }\n}\n\n/** The recorded versions, or undefined while the table does not exist yet. */\nasync function recordedVersions(db: pg.Pool | pg.PoolClient): Promise<Set<string> | undefined> {\n  try {\n    const { rows } = await db.query<{ version: string }>(\n      \"select version from inbox.schema_migrations\",\n    );\n    return new Set(rows.map((row) => row.version));\n  } catch (error) {\n    if ((error as { code?: string }).code === UNDEFINED_TABLE) return undefined;\n    throw error;\n  }\n}\nimport pg from \"pg\";\n\n/**\n * A pool against the CloudNativePG `-rw` service. Session-mode connections only: LISTEN and advisory\n * locks do not survive a transaction-pooled proxy. Keepalive and the statement timeout turn a silent\n * network drop into an error instead of a hang.\n */\nexport function createPool(databaseUrl: string, applicationName: string, max: number): pg.Pool {\n  const pool = new pg.Pool({\n    connectionString: databaseUrl,\n    application_name: applicationName,\n    max,\n    connectionTimeoutMillis: 5_000,\n    idleTimeoutMillis: 30_000,\n    keepAlive: true,\n    keepAliveInitialDelayMillis: 10_000,\n    statement_timeout: 30_000,\n    query_timeout: 35_000,\n  });\n  // An idle client that the server dropped emits 'error'; without a handler that would crash the process.\n  pool.on(\"error\", () => undefined);\n  return pool;\n}\npackages/ingest/src/main.ts:25:  // Long-lived SSE responses must not be cut by Node's default request timeouts.\npackages/ingest/src/main.ts:26:  server.requestTimeout = 0;\npackages/ingest/src/main.ts:27:  server.headersTimeout = 60_000;\ntests/e2e/run-phase4c.sh:98:wait_status() { # owner session wanted-status timeout-seconds\ntests/e2e/run-phase4c.sh:116:  for cmd in \"$@\"; do steps=$(jq -c --arg b \"$cmd\" '. + [{bash:$b, timeout:300}]' <<<\"$steps\"); done\ntests/e2e/run-phase4c.sh:215:  k wait --for=delete pod -l app.kubernetes.io/instance=pi-orchestrator --timeout=120s >/dev/null 2>&1 || true\ntests/e2e/run-phase4c.sh:217:  k rollout status deploy/pi-orchestrator --timeout=300s >/dev/null\ntests/e2e/run-phase4c.sh:235:  assert_eq \"repo B never answered as reachable\" timeout \"$(stream_has alice \"$repo_session\" B_REACHABLE 5)\"\ntests/e2e/run-phase3.sh:65:wait_for() { # description timeout-seconds command...\ntests/e2e/run-phase3.sh:111:  for cmd in \"$@\"; do steps=$(jq -c --arg b \"$cmd\" '. + [{bash:$b, timeout:900}]' <<<\"$steps\"); done\ntests/e2e/run-phase3.sh:124:wait_session() { wait_for \"${4:-session $1 reaches: $2}\" \"${3:-240}\" session_matches \"$1\" \"$2\"; } # id expr [timeout] [desc]\ntests/e2e/run-phase3.sh:312:  k wait --for=condition=Ready \"pod/$claim\" --timeout=240s >/dev/null\ntests/e2e/run-phase3.sh:407:  probe='probe() { if timeout 4 bash -c \"exec 3<>/dev/tcp/$1/$2\" 2>/dev/null; then echo \"$3 REACHABLE\"; else echo \"$3 BLOCKED\"; fi; }; '\ntests/e2e/run-phase3.sh:443:k wait --for=condition=Ready cluster.postgresql.cnpg.io/pi-pg --timeout=300s >/dev/null\ntests/e2e/run-phase3.sh:444:k rollout status deployment/pi-orchestrator --timeout=240s >/dev/null\ntests/e2e/run-phase4.sh:115:wait_for() { # description timeout-seconds command...\ntests/e2e/run-phase4.sh:160:  for cmd in \"$@\"; do steps=$(jq -c --arg b \"$cmd\" '. + [{bash:$b, timeout:900}]' <<<\"$steps\"); done\ntests/e2e/run-phase4.sh:165:# transcript owner session until-text [timeout]: replays the whole stream from the start (no Last-Event-ID).\ntests/e2e/run-phase4.sh:166:transcript() { client stream \"$1\" \"$2\" --until-text \"$3\" --timeout \"${4:-300}\" --reconnect || true; }\ntests/e2e/run-phase4.sh:331:  k wait --for=delete pod -l app.kubernetes.io/instance=pi-orchestrator --timeout=180s >/dev/null 2>&1 || true\ntests/e2e/run-phase4.sh:425:  s1=$(client stream alice \"$id\" --max-entries 3 --timeout 240)\ntests/e2e/run-phase4.sh:430:  s2=$(client stream alice \"$id\" --last-id \"$last\" --until-text recon-final --timeout 120 || true)\ntests/e2e/run-phase4.sh:442:  client stream alice \"$id\" --reconnect --until-text reconnected-final --timeout 420 >\"$work/reconnect.out\" 2>&1 &\ntests/e2e/run-phase4.sh:666:k wait --for=condition=Ready cluster.postgresql.cnpg.io/pi-pg --timeout=300s >/dev/null\ntests/e2e/run-phase4.sh:667:k rollout status deployment/pi-orchestrator --timeout=240s >/dev/null\ntests/e2e/run-phase4.sh:668:k rollout status deployment/pi-ingest --timeout=240s >/dev/null\ntests/e2e/run-phase4b.sh:52:answer_has() { # owner session needle seconds -> \"found <tool calls>\"|timeout\ntests/e2e/run-phase4b.sh:59:stream_has() { # owner session needle seconds -> found|timeout\ntests/e2e/run-phase4b.sh:138:wait_status() { # owner session wanted-status timeout-seconds -> the last GET body\ntests/e2e/client-4b.mjs:7://   node client.mjs stream OWNER SESSION NEEDLE SECONDS -> prints \"found\" or \"timeout\"; exit 0 either way\ntests/e2e/client-4b.mjs:10://     NEEDLE after at least one tool call (<tools> = number of calls seen), else \"timeout\" or \"failed\"\ntests/e2e/client-4b.mjs:60:  console.log(found ? \"found\" : \"timeout\");\ntests/e2e/client-4b.mjs:83:  let result = \"timeout\";\ntests/e2e/client.mjs:9://          [--reconnect] [--timeout SECONDS]\ntests/e2e/client.mjs:16://          or at the timeout. With --reconnect it reconnects with Last-Event-ID after every end.\ntests/e2e/client.mjs:51:    signal: AbortSignal.timeout(30_000),\ntests/e2e/client.mjs:67:  const timeoutMs = Number(flags.timeout ?? 300) * 1000;\ntests/e2e/client.mjs:69:  const deadline = Date.now() + timeoutMs;\ntests/e2e/run-phase1.sh:47:  k wait --for=condition=Ready pod/e2e-runner --timeout=240s >/dev/null\ntests/e2e/run-phase1.sh:67:k wait --for=delete \"pvc/workspace-$claim\" --timeout=120s >/dev/null 2>&1 || true\ntests/e2e/run-phase1.sh:79:k wait --for=condition=Ready \"pod/$claim\" --timeout=300s >/dev/null || fail \"sandbox pod $claim not Ready\"\ntests/e2e/run-phase1.sh:104:k wait --for=condition=Ready \"pod/$claim\" --timeout=240s >/dev/null || fail \"recreated Pod not Ready\"\ntests/e2e/run.sh:133:k wait --for=condition=Ready pod/e2e-driver-loader --timeout=300s >/dev/null\ntests/e2e/run.sh:162:  k wait --for=condition=complete \"job/$job\" --timeout=3700s >/dev/null 2>&1 &\ntests/e2e/run.sh:164:  k wait --for=condition=failed \"job/$job\" --timeout=3700s >/dev/null 2>&1 &\ndeploy/push-code.sh:40:  k wait --for=delete pod -l \"app.kubernetes.io/instance=$d\" --timeout=120s >/dev/null 2>&1 || true\ndeploy/push-code.sh:65:k wait --for=condition=Ready pod/orchestrator-code-loader --timeout=240s >/dev/null\n/** One JSON line per event on stdout. Never pass secrets in `fields`. */\nexport function log(event: string, fields: Record<string, unknown> = {}): void {\n  process.stdout.write(`${JSON.stringify({ t: new Date().toISOString(), event, ...fields })}\\n`);\n}\n","isError":false}]}
