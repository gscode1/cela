ync () => {\n    35\t    while (!state.stopping) {\n    36\t      try {\n    37\t        await applyMigrations(pool);\n    38\t        schemaReady = true;\n    39\t        log(\"migrated\", { instance: config.instance });\n    40\t        return;\n    41\t      } catch (error) {\n    42\t        log(\"migrate-failed\", { message: errorMessage(error) });\n    43\t        await new Promise((resolve) => setTimeout(resolve, 2_000));\n    44\t      }\n    45\t    }\n    46\t  })();\n    47\t\n    48\t  const shutdown = (signal: string): void => {\n    49\t    log(\"shutdown\", { signal });\n    50\t    state.stopping = true;\n    51\t    server.close();\n    52\t    server.closeAllConnections();\n    53\t    void pool.end().finally(() => process.exit(0));\n    54\t    setTimeout(() => process.exit(0), 5_000).unref();\n    55\t  };\n    56\t  process.on(\"SIGTERM\", () => shutdown(\"SIGTERM\"));\n    57\t  process.on(\"SIGINT\", () => shutdown(\"SIGINT\"));\n    58\t}\n    59\t\n    60\tmain().catch((error: unknown) => {\n    61\t  log(\"fatal\", { message: errorMessage(error) });\n    62\t  process.exit(1);\n    63\t});\nAGENT.md\nCLAUDE.md\nLICENSE\nREADME.md\ndeploy\ndocs\neslint.config.js\nexamples\nimages\npackage.json\npackages\nplan.md\npnpm-lock.yaml\npnpm-workspace.yaml\ntests\nvendor\n","isError":false}]}
