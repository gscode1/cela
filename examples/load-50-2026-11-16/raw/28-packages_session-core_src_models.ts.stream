ENTRY 12360 {"id":12360,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { readFile } from \"node:fs/promises\";\nimport type { Models } from \"@earendil-works/pi-ai\";\nimport { createModels } from \"@earendil-works/pi-ai/models\";\nimport { builtinProviders } from \"@earendil-works/pi-ai/providers/all\";\nimport { modelKey } from \"@pi-durable-k8s/session-core\";\nimport type { OrchestratorConfig } from \"./config.js\";\nimport { scriptedProvider } from \"./model.js\";\nimport {\n  createGatewayFetch,\n  placeholderAuthContext,\n  placeholderCredentials,\n  withFetch,\n} from \"./onecli.js\";\n\nconst LOCAL = new Set([\"scripted\", \"faux\"]);\n\n/**\n * The `Models` of the orchestrator.\n *\n * Pi Durable stores a conversation's model as `{ provider, modelId }` names and resolves them against this `Models`\n * at every request, so every provider a stored conversation may name must be installed at every start: the\n * allowlist's providers, the scripted ones, and `faux` for the Phase 3 /control sessions.\n *\n * Real providers resolve their API key to a placeholder (`placeholderAuthContext`) and send their requests through\n * the OneCLI gateway, which replaces the placeholder with the credential it holds. Throws when an allowlisted model\n * is not in pi-ai's catalog, so a typo in the ConfigMap fails at start instead of at the first request.\n */\nexport async function buildModels(\n  config: OrchestratorConfig,\n  readCa: (path: string) => Promise<string> = (path) => readFile(path, \"utf8\"),\n): Promise<Models> {\n  const models = createModels({\n    authContext: placeholderAuthContext,\n    credentials: await placeholderCredentials(config.onecli.codexAccountId),\n  });\n  models.setProvider(scriptedProvider({ provider: \"faux\" }).provider);\n  models.setProvider(\n    scriptedProvider({\n      provider: \"scripted\",\n      models: [{ id: \"scripted-1\" }, { id: \"scripted-2\" }],\n    }).provider,\n  );\n\n  const remote = config.models.allowed.filter((choice) => !LOCAL.has(choice.provider));\n  const token = config.onecli.token;\n  if (remote.length === 0 || token === undefined) {\n    assertInstalled(models, config);\n    return models;\n  }\n  const wanted = new Set(remote.map((choice) => choice.provider));\n  for (const provider of builtinProviders()) {\n    if (wanted.has(provider.id)) models.setProvider(provider);\n  }\n  assertInstalled(models, config);\n  const ca = await readCa(config.onecli.caFile);\n  return withFetch(\n    models,\n    createGatewayFetch({\n      gateway: config.onecli.gateway,\n      token,\n      ca,\n      noProxy: config.onecli.noProxy,\n    }),\n  );\n}\n\nfunction assertInstalled(models: Models, config: OrchestratorConfig): void {\n  for (const choice of config.models.allowed) {\n    if (models.getModel(choice.provider, choice.model) === undefined) {\n      throw new Error(`allowed model ${modelKey(choice)} is not known to pi-ai`);\n    }\n  }\n}\n    return;\n  }\n  sendJson(res, 404, { error: \"not found\" });\n}\n\n/** Sessions that predate migration 002 have no stored model: they run the default. */\nfunction modelOf(session: SessionRow, policy: ModelPolicy): ModelChoice {\n  return session.model ?? policy.default;\n}\n\nasync function postSession(\n  req: IncomingMessage,\n  res: ServerResponse,\n  deps: IngestDeps,\n  principal: Principal,\n): Promise<void> {\n  let body: Record<string, unknown>;\n  try {\n    body = await readJsonObject(req);\n  } catch (error) {\n    if (error instanceof BodyError) {\n      sendJson(res, 400, { error: error.message });\n      return;\n    }\n    throw error;\n  }\n  const model = chooseModel(deps.models, body);\n  if (typeof model === \"string\") {\n    sendJson(res, 400, { error: model });\n    return;\n  }\n  const repo = chooseRepo(body);\n  if (typeof repo === \"string\") {\n    sendJson(res, 400, { error: repo });\n    return;\n  }\n  const sessionId = await createSession(deps.pool, principal, model, repo);\n  sendJson(res, 201, {\n    sessionId,\n    provider: model.provider,\n    model: model.model,\n    ...(model.reasoning === undefined ? {} : { reasoning: model.reasoning }),\n    ...(repo === undefined\n      ? {}\n      : { repo: repo.repo, ...(repo.branch === undefined ? {} : { branch: repo.branch }) }),\n  });\n}\n\nasync function ownedSession(\n  pool: pg.Pool,\n  id: string,\n  principal: Principal,\n): Promise<SessionRow | undefined> {\n  if (!UUID.test(id)) return undefined;\n  const session = await getSession(pool, id);\n  return session?.ownerSubject === principal.subject ? session : undefined;\n}\n\nasync function postEvent(\n  req: IncomingMessage,\n  res: ServerResponse,\n  pool: pg.Pool,\n  session: SessionRow,\n  principal: Principal,\n): Promise<void> {\n  let parsed;\n  try {\n    parsed = parseEventBody(await readJsonObject(req));\n  } catch (error) {\n    if (error instanceof BodyError) {\n      sendJson(res, 400, { error: error.message });\npackages/orchestrator/src/providers.ts:69:    if (models.getModel(choice.provider, choice.model) === undefined) {\n     1\t/** A model a session runs on: a Pi provider id and a model id within it. */\n     2\texport interface ModelChoice {\n     3\t  provider: string;\n     4\t  model: string;\n     5\t  /** Reasoning effort (Pi's `thinkingLevel`); unset leaves it to Pi's default, `off`. */\n     6\t  reasoning?: ThinkingLevel;\n     7\t}\n     8\t\n     9\texport const THINKING_LEVELS = [\"off\", \"minimal\", \"low\", \"medium\", \"high\", \"xhigh\"] as const;\n    10\texport type ThinkingLevel = (typeof THINKING_LEVELS)[number];\n    11\t\n    12\t/** `provider/model`. The model id may itself contain slashes (`openrouter/openai/gpt-4.1-nano`). */\n    13\texport function modelKey(choice: ModelChoice): string {\n    14\t  return `${choice.provider}/${choice.model}`;\n    15\t}\n    16\t\n    17\t/** Parses one `provider/model` pair. Throws for anything else, naming the entry. */\n    18\texport function parseModelKey