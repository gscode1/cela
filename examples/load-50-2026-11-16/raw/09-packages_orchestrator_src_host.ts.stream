ENTRY 11220 {"id":11220,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/orchestrator/src/sessions.ts:279:    const used = await this.#host.turnsUsed(conversationId);\npackages/orchestrator/src/sessions.ts:286:    await this.#host.limitTurns(conversationId, left);\npackages/orchestrator/src/http.ts:138:    sendJson(res, 201, await host.startSession(script));\npackages/orchestrator/src/http.ts:155:    const status = await host.status(id);\npackages/orchestrator/src/host.ts:119:  async startSession(script: Script): Promise<{ id: number; claim: string }> {\npackages/orchestrator/src/host.ts:194:  async modelOf(id: number): Promise<ModelChoice | undefined> {\npackages/orchestrator/src/host.ts:202:  async thinkingOf(id: number): Promise<string> {\npackages/orchestrator/src/host.ts:207:  async turnsUsed(id: number): Promise<number> {\npackages/orchestrator/src/host.ts:220:  async limitTurns(id: number, maxTurns: number): Promise<void> {\n     1\timport type { RunOutcome } from \"./failure.js\";\n     2\t\n     3\t/** One input the orchestrator handed to Pi Durable and has not yet seen settled. */\n     4\texport interface Watched {\n     5\t  sessionId: string;\n     6\t  conversationId: number;\n     7\t  /** The inbox row id: the Pi Durable `requestId` of the submission. */\n     8\t  requestId: string;\n     9\t}\n    10\t\n    11\t/** What the storage says about a submission; only the fields the watcher reads. */\n    12\texport type SubmissionState =\n    13\t  | { status: \"queued\" | \"placed\" }\n    14\t  | { status: \"done\" }\n    15\t  | { status: \"unanswered\"; reason: string; detail?: unknown };\n    16\t\n    17\texport interface RunWatcherOptions {\n    18\t  lookup: (conversationId: number, requestId: string) => Promise<SubmissionState | undefined>;\n    19\t  /** A submission ended `unanswered`: the run it belonged to failed or was aborted. Called once per submission. */\n    20\t  onUnanswered: (watched: Watched, outcome: RunOutcome) => Promise<void>;\n    21\t  pollMs?: number;\n    22\t  onError?: (error: unknown) => void;\n    23\t}\n    24\t\n    25\t/**\n    26\t * Notices runs that end without an answer. Pi Durable reports a model error only inside the conversation (the run's\n    27\t * submissions settle `unanswered` with the reason and error text), not to the host, so the orchestrator reads the\n    28\t * submissions it handed over until each is settled. Polling the storage also covers a run that a previous process\n    29\t * started and this one resumed: `add` it again at start and it is picked up the same way.\n    30\t */\n    31\texport class RunWatcher {\n    32\t  readonly #options: RunWatcherOptions;\n    33\t  readonly #pending = new Map<string, Watched>();\n    34\t  #timer: NodeJS.Timeout | undefined;\n    35\t  #polling = false;\n    36\t\n    37\t  constructor(options: RunWatcherOptions) {\n    38\t    this.#options = options;\n    39\t  }\n    40\t\n    41\t  add(watched: Watched): void {\n    42\t    this.#pending.set(`${String(watched.conversationId)}/${watched.requestId}`, watched);\n    43\t    this.#timer ??= setInterval(() => void this.poll(), this.#options.pollMs ?? 2_000);\n    44\t    this.#timer.unref();\n    45\t  }\n    46\t\n    47\t  get size(): number {\n    48\t    return this.#pending.size;\n    49\t  }\n    50\t\n    51\t  stop(): void {\n    52\t    if (this.#timer !== undefined) clearInterval(this.#timer);\n    53\t    this.#timer = undefined;\n    54\t  }\n    55\t\n    56\t  /** One pass over the pending submissions. Exposed so tests need no timers. */\n    57\t  async poll(): Promise<void> {\n    58\t    if (this.#polling) return;\n    59\t    this.#polling = true;\n    60\t    try {\n    61\t      for (const [key, watched] of [...this.#pending]) {\n    62\t        try {\n    63\t          const state = await this.#options.lookup(watched.conversationId, watched.requestId);\n    64\t          if (state === undefined || state.status === \"done\") {\n    65\t            this.#pending.delete(key);\n    66\t          } else if (state.status === \"unanswered\") {\n    67\t            const detail =\n    68\t              typeof state.detail === \"string\"\n    69\t                ? state.detail\n    70\t                : state.detail === undefined\n    71\t                  ? undefined\n    72\t                  : JSON.stringify(state.detail);\n    73\t            await this.#options.onUnanswered(watched, {\n    74\t              reason: state.reason,\n    75\t              ...(detail === undefined ? {} : { detail }),\n    76\t            });\n    77\t            // Only now: a handler that threw leaves the watch in place, so the failure is not lost.\n    78\t            this.#pending.delete(key);\n    79\t          }\n    80\t        } catch (error) {\n    81\t          // Keep it pending: a storage hiccup must not lose the watch, nor crash the orchestrator.\n    82\t          this.#options.onError?.(error);\n    83\t        }\n    84\t      }\n    85\t    } finally {\n    86\t      this.#polling = false;\n    87\t      if (this.#pending.size === 0) this.stop();\n    88\t    }\n    89\t  }\n    90\t}\n","isError":false}]}
