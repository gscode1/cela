ENTRY 11441 {"id":11441,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"      log(\"migrate-failed\", { message: errorMessage(error) });\n      await new Promise((resolve) => setTimeout(resolve, 2_000));\n    }\n  }\n\n  const storage = await openStorageWhenFree(config, stop.signal);\n  log(\"lock-acquired\", { instance: config.instance });\n  const sessionKeyOf = async (conversationId: number): Promise<string> => {\n    const { rows } = await pool.query<{ id: string }>(\n      \"select id from inbox.sessions where conversation_id = $1\",\n      [conversationId],\n    );\n    // Conversations the inbox does not know are the test-only /control sessions.\n    return rows[0]?.id ?? `control-${String(conversationId)}`;\n  };\n  // Repo workspaces (Phase 4c). Plain sessions never touch OneCLI's management API or GitHub through this.\n  const callApi: FetchLike = (url, init) => fetch(url, init);\n  const onecli =\n    config.repos.onecliApiKey === undefined\n      ? undefined\n      : new OneCliAdmin(config.repos.onecliApi, config.repos.onecliApiKey, callApi);\npackages/orchestrator/src/config.ts:22:  /** Mount the test-only /control surface (Phase 3 scripted sessions). */\npackages/orchestrator/src/config.ts:23:  control: boolean;\npackages/orchestrator/src/config.ts:132:    control: env.PI_ORCH_CONTROL === \"1\",\npackages/orchestrator/src/http.ts:25:  /** Mounts the test-only /control surface (PI_ORCH_CONTROL=1). */\npackages/orchestrator/src/http.ts:26:  control: boolean;\npackages/orchestrator/src/http.ts:46: *   /control/...                  test-only (PI_ORCH_CONTROL=1): the Phase 3 scripted-session surface, same auth\npackages/orchestrator/src/http.ts:105:  if (deps.control && parts[0] === \"control\") {\npackages/orchestrator/src/http.ts:115: *   POST /control/sessions            body = script JSON\npackages/orchestrator/src/http.ts:116: *   POST /control/sessions/:id/inputs body = script JSON\npackages/orchestrator/src/http.ts:117: *   GET  /control/sessions/:id        status and tool results\n","isError":false}]}
