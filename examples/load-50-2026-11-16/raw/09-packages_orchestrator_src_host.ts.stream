ENTRY 11165 {"id":11165,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport { BACKGROUND_CONTEXT as context } from \"@earendil-works/chord/context\";\n     2\timport type { Message } from \"@earendil-works/pi-ai\";\n     3\timport { createRegistry, Harness } from \"@earendil-works/pi-durable\";\n     4\timport type {\n     5\t  Conversation,\n     6\t  ConversationId,\n     7\t  ConversationWatch,\n     8\t  ConversationWindow,\n     9\t  Cursor,\n    10\t  Storage,\n    11\t} from \"@earendil-works/pi-durable\";\n    12\timport type { ModelChoice } from \"@pi-durable-k8s/session-core\";\n    13\timport { createCodingTools } from \"@earendil-works/pi-durable/tools\";\n    14\timport type { OrchestratorConfig } from \"./config.js\";\n    15\timport { errorMessage, log } from \"./log.js\";\n    16\timport type { Script } from \"./model.js\";\n    17\timport { buildModels } from \"./providers.js\";\n    18\timport { claimNameFor, Sandboxes, WORKSPACE } from \"./sandboxes.js\";\n    19\timport type { SandboxHooks, SessionKeyOf } from \"./sandboxes.js\";\n    20\timport type { SubmissionState } from \"./watcher.js\";\n    21\timport type { WorkspaceEnv } from \"./workspace.js\";\n    22\t\n    23\texport interface SessionEvent {\n    24\t  role: Message[\"role\"];\n    25\t  /** Assistant text, tool output, or the user's script. */\n    26\t  text: string;\n    27\t  /** Tool calls the assistant made, as `name(args)`. */\n    28\t  calls?: string[];\n    29\t  /** Tool results only. */\n    30\t  isError?: boolean;\n    31\t}\n    32\t\n    33\texport interface SessionStatus {\n    34\t  id: number;\n    35\t  claim: string;\n    36\t  state: \"running\" | \"done\";\n    37\t  events: number;\n    38\t  /** Text of every tool result so far, in order. */\n    39\t  results: { text: string; isError: boolean }[];\n    40\t  answer?: string;\n    41\t}\n    42\t\n    43\tfunction contentText(content: Message[\"content\"]): string {\n    44\t  if (typeof content === \"string\") return content;\n    45\t  return content\n    46\t    .map((block) => {\n    47\t      if (block.type === \"text\") return block.text;\n    48\t      return block.type === \"toolCall\" ? \"\" : `[${block.type}]`;\n    49\t    })\n    50\t    .join(\"\");\n    51\t}\n    52\t\n    53\texport function toEvent(message: Message): SessionEvent {\n    54\t  const event: SessionEvent = { role: message.role, text: contentText(message.content) };\n    55\t  if (message.role === \"assistant\") {\n    56\t    const calls = message.content.flatMap((block) =>\n    57\t      block.type === \"toolCall\" ? [`${block.name}(${JSON.stringify(block.arguments)})`] : [],\n    58\t    );\n    59\t    if (calls.length > 0) event.calls = calls;\n    60\t  }\n    61\t  if (message.role === \"toolResult\") event.isError = message.isError;\n    62\t  return event;\n    63\t}\n    64\t\n    65\t/** The Pi Durable host: one Harness over the Postgres storage, one conversation per session. */\n    66\texport class Host {\n    67\t  readonly #harness: Harness;\n    68\t  readonly #sandboxes: Sandboxes;\n    69\t  readonly #storage: Storage;\n    70\t\n    71\t  private constructor(harness: Harness, sandboxes: Sandboxes, storage: Storage) {\n    72\t    this.#harness = harness;\n    73\t    this.#sandboxes = sandboxes;\n    74\t    this.#storage = storage;\n    75\t  }\n    76\t\n    77\t  /**\n    78\t   * Opens the Harness over an owned storage and resumes whatever the last process left running.\n    79\t   * `onFailed` fires when the Harness ends on a storage error, e.g. the database connection died.\n    80\t   */\n    81\t  static async open(\n    82\t    storage: Storage,\n    83\t    config: OrchestratorConfig,\n    84\t    onFailed: (error: unknown) => void,\n    85\t    sessionKeyOf: SessionKeyOf,\n    86\t    hooks: SandboxHooks = {},\n    87\t    recycleAtStart: readonly number[] = [],\n    88\t  ): Promise<Host> {\n    89\t    const models = await buildModels(config);\n    90\t    const registry = createRegistry();\n    91\t    registry.install(createCodingTools());\n    92\t    const sandboxes = new Sandboxes(config, sessionKeyOf, hooks);\n    93\t    // Before resume(): a continuing run must not run its next command in a Pod that still holds the leftovers of\n    94\t    // the command the previous process was killed in.\n    95\t    sandboxes.recycleAtStart(recycleAtStart);\n    96\t\n    97\t    const harness = await Harness.open(\n    98\t      storage,\n    99\t      {\n   100\t        models,\n   101\t        registry,\n   102\t        // Lazy: the SandboxClaim is created at the first tool call, not at the first model request.\n   103\t        env: ({ conversationId }) => Promise.resolve(sandboxes.lazyEnv(Number(conversationId))),\n   104\t        onReport: (report) => {\n   105\t          log(\"report\", { kind: report.kind, message: errorMessage(report.error) });\n   106\t        },\n   107\t      },\n   108\t      context,\n   109\t    );\n   110\t    void harness.closed.then((end) => {\n   111\t      if (end.kind === \"failed\") onFailed(end.error);\n   112\t    });\n   113\t    // No new input needed: open recovers nothing by itself, resume() continues unfinished runs.\n   114\t    harness.resume();\n   115\t    return new Host(harness, sandboxes, storage);\n   116\t  }\n   117\t\n   118\t  /** Creates the conversation and its sandbox claim, then submits the script as the first input. */\n   119\t  async startSession(script: Script): Promise<{ id: number; claim: string }> {\n   120\t    const conversation = await this.#harness.createConversation(\n   121\t      {\n   122\t        ownership: { kind: \"ownerless\" },\n   123\t        agent: { model: { provider: \"faux\", modelId: \"faux-1\" }, cwd: WORKSPACE },\n   124\t      },\n   125\t      context,\n   126\t    );\n   127\t    const id = Number(conversation.id);\n   128\t    await this.#sandboxes.ensure(id);\n   129\t    await conversation.submit(\n   130\t      { type: \"input\", content: JSON.stringify(script), requestId: `start-${String(id)}` },\n   131\t      context,\n   132\t    );\n   133\t    log(\"session-started\", { id, claim: claimNameFor(id) });\n   134\t    return { id, claim: claimNameFor(id) };\n   135\t  }\n   136\t\n   137\t  /** A further input to an existing session; the model follows the newest script. False if unknown. */\n   138\t  async sendInput(id: number, script: Script): Promise<boolean> {\n   139\t    const conversation = await this.#harness.conversation(id as ConversationId, context);\n   140\t    if (conversation === undefined) return false;\n   141\t    await conversation.submit({ type: \"input\", content: JSON.stringify(script) }, context);\n   142\t    return true;\n   143\t  }\n   144\t\n   145\t  async events(id: number): Promise<SessionEvent[] | undefined> {\n   146\t    const conversation = await this.#harness.conversation(id as ConversationId, context);\n   147\t    if (conversation === undefined) return undefined;\n   148\t    const view = await conversation.context(context);\n   149\t    // Stored entries, not view.messages: the view adds a placeholder result for a call still running.\n   150\t    return view.entries.flatMap((entry) => entry.model ?? []).map(toEvent);\n   151\t  }\n   152\t\n   153\t  async status(id: number): Promise<SessionStatus | undefined> {\n   154\t    const events = await this.events(id);\n   155\t    if (events === undefined) return undefined;\n   156\t    const last = events.at(-1);\n   157\t    const results = events\n   158\t      .filter((e) => e.role === \"toolResult\")\n   159\t      .map((e) => ({ text: e.text, isError: e.isError === true }));\n   160\t    const answered = last?.role === \"assistant\" && last.calls === undefined;\n   161\t    return {\n   162\t      id,\n   163\t      claim: claimNameFor(id),\n   164\t      state: answered ? \"done\" : \"running\",\n   165\t      events: events.length,\n   166\t      results,\n   167\t      ...(answered ? { answer: last.text } : {}),\n   168\t    };\n   169\t  }\n   170\t\n   171\t  /**\n   172\t   * Creates an empty conversation for a session, running on `model`. No sandbox: that is created lazily, at the\n   173\t   * first tool call, by the `env` callback of the Harness.\n   174\t   *\n   175\t   * Pi Durable stores the model in the conversation's `pi.agent` document, in the creating commit. It survives\n   176\t   * restarts, so it is set once here and not on every turn; only the provider must be installed again at each start.\n   177\t   */\n   178\t  async createConversation(model: ModelChoice): Promise<number> {\n   179\t    const conversation = await this.#harness.createConversation(\n   180\t      {\n   181\t        ownership: { kind: \"ownerless\" },\n   182\t        agent: {\n   183\t          model: { provider: model.provider, modelId: model.model },\n   184\t          ...(model.reasoning === undefined ? {} : { thinkingLevel: model.reasoning }),\n   185\t          cwd: WORKSPACE,\n   186\t        },\n   187\t      },\n   188\t      context,\n   189\t    );\n   190\t    return Number(conversation.id);\n   191\t  }\n   192\t\n   193\t  /** The model a conversation runs on, as Pi Durable stored it. */\n   194\t  async modelOf(id: number): Promise<ModelChoice | undefined> {\n   195\t    const agent = await (await this.#conversation(id)).agent(context);\n   196\t    return agent.model === undefined\n   197\t      ? undefined\n   198\t      : { provider: agent.model.provider, model: agent.model.modelId };\n   199\t  }\n   200\t\n   201\t  /** The reasoning effort a conversation runs with, as Pi Durable resolved it (`off` when none was stored). */\n   202\t  async thinkingOf(id: number): Promise<string> {\n   203\t    return (await (await this.#conversation(id)).agent(context)).thinkingLevel;\n   204\t  }\n   205\t\n   206\t  /** Model turns (assistant responses) in the conversation's transcript so far. */\n   207\t  async turnsUsed(id: number): Promise<number> {\n   208\t    const conversation = await this.#conversation(id);\n   209\t    let turns = 0;\n   210\t    let cursor: Cursor | undefined;\n   211\t    do {\n   212\t      const page = await conversation.entries({ order: \"ascending\" }, 200, cursor, context);\n   213\t      turns += page.items.filter((entry) => entry.kind === \"pi.assistant\").length;\n   214\t      cursor = page.next;\n   215\t    } while (cursor !== undefined);\n   216\t    return turns;\n   217\t  }\n   218\t\n   219\t  /** Caps the tool rounds of any run of this conversation, so one run cannot overshoot the session's turn budget. */\n   220\t  async limitTurns(id: number, maxTurns: number): Promise<void> {\n   221\t    await (await this.#conversation(id)).configure({ maxTurns }, context);\n   222\t  }\n   223\t\n   224\t  /** The stored state of a submission, for the run watcher. */\n   225\t  async submissionState(id: number, requestId: string): Promise<SubmissionState | undefined> {\n   226\t    return this.#storage.submissionByRequest(id as ConversationId, requestId, context);\n   227\t  }\n   228\t\n   229\t  /**\n   230\t   * Durably admits one inbox event. `requestId` is the inbox row id, so a resubmission after a crash returns the\n   231\t   * original submission instead of adding a second turn. A message queues behind a running turn (follow-up); a\n   232\t   * steer joins the running turn after its current tool round, and starts a turn when the session is idle.\n   233\t   */\n   234\t  async submitInput(\n   235\t    id: number,\n   236\t    input: { text: string; requestId: string; steer: boolean },\n   237\t  ): Promise<void> {\n   238\t    const conversation = await this.#conversation(id);\n   239\t    await conversation.submit(\n   240\t      {\n   241\t        type: \"input\",\n   242\t        content: input.text,\n   243\t        requestId: input.requestId,\n   244\t        whenBusy: input.steer ? \"steer\" : \"followUp\",\n   245\t      },\n   246\t      context,\n   247\t    );\n   248\t  }\n   249\t\n   250\t  async hasSubmission(id: number, requestId: string): Promise<boolean> {\n   251\t    // A read on the Storage: the Harness has no lookup by request id. Only the test-fault gate uses it.\n   252\t    const record = await this.#storage.submissionByRequest(\n   253\t      id as ConversationId,\n   254\t      requestId,\n   255\t      context,\n   256\t    );\n   257\t    return record !== undefined;\n   258\t  }\n   259\t\n   260\t  /** Withdraws queued inputs, aborts the running turn and resolves once the conversation is idle. */\n   261\t  async abort(id: number): Promise<void> {\n   262\t    await (await this.#conversation(id)).abort(context);\n   263\t  }\n   264\t\n   265\t  /** The conversation and a watch of its structural view (a window over the transcript plus live state). */\n   266\t  async watch(\n   267\t    id: number,\n   268\t    window?: ConversationWindow,\n   269\t  ): Promise<{ conversation: Conversation; watch: ConversationWatch } | undefined> {\n   270\t    const conversation = await this.#harness.conversation(id as ConversationId, context);\n   271\t    if (conversation === undefined) return undefined;\n   272\t    return { conversation, watch: await conversation.watch(context, window) };\n   273\t  }\n   274\t\n   275\t  /**\n   276\t   * The session's sandbox env, opening it (claim, bridge) if needed. Only repo sessions call this directly, to clone\n   277\t   * before the first turn; every other session opens its sandbox lazily at the first tool call.\n   278\t   * It is the same tracked env the tools get: the raw env would hide a running clone from idle eviction and suspension\n   279\t   * (a Pod deleted mid-clone) and would never be evicted itself.\n   280\t   */\n   281\t  workspaceEnv(id: number): Promise<WorkspaceEnv> {\n   282\t    return Promise.resolve(this.#sandboxes.lazyEnv(id));\n   283\t  }\n   284\t\n   285\t  /** Stops the session's bridge and deletes its SandboxClaim and PVC. */\n   286\t  async destroySandbox(id: number): Promise<void> {\n   287\t    await this.#sandboxes.destroy(id);\n   288\t  }\n   289\t\n   290\t  /** The orphan sweep's delete of a claim and its PVC: the session deletion's teardown, for a claim with no live session. */\n   291\t  async destroyOrphanSandbox(claimName: string, sessionLabel: string): Promise<void> {\n   292\t    await this.#sandboxes.destroyOrphan(claimName, sessionLabel);\n   293\t  }\n   294\t\n   295\t  async #conversation(id: number): Promise<Conversation> {\n   296\t    const conversation = await this.#harness.conversation(id as ConversationId, context);\n   297\t    if (conversation === undefined) throw new Error(`conversation ${String(id)} does not exist`);\n   298\t    return conversation;\n   299\t  }\n   300\t\n   301\t  /** Waits for in-flight work to settle and closes storage; bridges stop, claims stay. */\n   302\t  async close(): Promise<void> {\n   303\t    await this.#harness.close(context);\n   304\t    await this.#sandboxes.closeAll();\n   305\t  }\n   306\t}\n","isError":false}]}
