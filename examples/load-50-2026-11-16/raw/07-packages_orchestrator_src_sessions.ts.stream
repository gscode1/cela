ENTRY 11195 {"id":11195,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import type pg from \"pg\";\nimport { errorMessage, getSession, toEvent } from \"@pi-durable-k8s/session-core\";\nimport type { EventDbRow, InboxEvent, SessionRow } from \"@pi-durable-k8s/session-core\";\nimport { log } from \"./log.js\";\nimport { PermanentError } from \"./sessions.js\";\n\nconst POLL_MS = 1_000;\nconst BATCH = 20;\nconst MAX_PARALLEL_SESSIONS = 8;\nconst MAX_ATTEMPTS = 5;\nconst DELETE_RETRY_BASE_MS = 1_000;\nconst DELETE_RETRY_MAX_MS = 60_000;\n\n/**\n * Wait before the next try of a failing `delete` row: 1 s, 2 s, 4 s ... capped at 60 s. A delete is not given up after\n * MAX_ATTEMPTS like other events (docs/decisions/0006-deletes-retry-until-done.md): five tries a second apart end\n * inside one short Kubernetes or OneCLI outage, and a failed delete leaks the sandbox, PVC and OneCLI agent.\n */\nexport function deleteRetryDelayMs(attempt: number): number {\n  return Math.min(DELETE_RETRY_MAX_MS, DELETE_RETRY_BASE_MS * 2 ** Math.max(0, attempt - 1));\n}\n\nexport type ApplyEvent = (event: InboxEvent, session: SessionRow) => Promise<void>;\n\n/**\n * The orchestrator's side of the inbox. It claims `pending` rows, hands each to Pi Durable (the row id is the\n * `requestId`), and only then marks the row `submitted`. Pi Durable owns run recovery: a row that is\n * already `submitted` is never touched again, so a run that died is never re-run from here.\n *\n *  - Wake-up: LISTEN on `inbox_events` (sent by a trigger on insert) plus a short poll as the safety net.\n *  - Claim: one transaction per session batch, `FOR UPDATE SKIP LOCKED`, oldest first. The row locks are held\n *    until the rows are marked, so a crash in between rolls the batch back to `pending`; the retry submits\n *    with the same `requestId` and Pi Durable returns the original submission.\n *  - Ordering: one drain per session at a time, rows in (created_at, id) order. A transient failure stops\n *    that session's batch so later rows cannot overtake it; other sessions are unaffected.\n *  - Batching: rows of a session are claimed up to 20 at a time and submitted one by one, in order. They are\n *    not merged into one input: each keeps its own requestId and therefore its own idempotent submission.\n */\nexport class InboxLoop {\n  readonly #pool: pg.Pool;\n  readonly #apply: ApplyEvent;\n  readonly #inFlight = new Set<string>();\n  /** Sessions whose failing delete waits out its backoff (epoch ms). In memory: a restart simply retries at once. */\n  readonly #notBefore = new Map<string, number>();\n  #listener: pg.PoolClient | undefined;\n  #timer: NodeJS.Timeout | undefined;\n  #ticking = false;\n  #again = false;\n  #stopped = false;\n\n  constructor(pool: pg.Pool, apply: ApplyEvent) {\n    this.#pool = pool;\n    this.#apply = apply;\n  }\n\n  start(): void {\n    void this.#listen();\n    this.#timer = setInterval(() => this.wake(), POLL_MS);\n    this.wake();\n  }\n\n  async stop(): Promise<void> {\n    this.#stopped = true;\n    if (this.#timer !== undefined) clearInterval(this.#timer);\n    this.#listener?.removeAllListeners();\n    this.#listener?.release(true);\n    // Let drains in flight finish their current row: they hold row locks and a transaction.\n    while (this.#inFlight.size > 0) await new Promise((resolve) => setTimeout(resolve, 100));\n  }\n\n  wake(): void {\n    if (this.#stopped) return;\n    if (this.#ticking) {\n      this.#again = true;\n      return;\n    }\n    this.#ticking = true;\n    void this.#tick().finally(() => {\n      this.#ticking = false;\n      if (this.#again) {\n        this.#again = false;\n        this.wake();\n      }\n    });\n  }\n\n  async #listen(): Promise<void> {\n    while (!this.#stopped) {\n      try {\n        const client = await this.#pool.connect();\n        this.#listener = client;\n        await new Promise<void>((resolve) => {\n          client.on(\"notification\", () => this.wake());\n          client.on(\"error\", () => resolve());\n          client.on(\"end\", () => resolve());\n          client.query(\"listen inbox_events\").catch(() => resolve());\n        });\n        client.removeAllListeners();\n        client.release(true);\n      } catch (error) {\n        log(\"inbox-listen-failed\", { message: errorMessage(error) });\n      }\n      // The poll covers the gap until the listener is back.\n      await new Promise((resolve) => setTimeout(resolve, 2_000));\n    }\n  }\n\n  async #tick(): Promise<void> {\n    try {\n      const { rows } = await this.#pool.query<{ session_id: string }>(\n        \"select distinct session_id from inbox.events where status = 'pending' limit 100\",\n      );\n      for (const { session_id: sessionId } of rows) {\n        if (this.#inFlight.has(sessionId) || this.#inFlight.size >= MAX_PARALLEL_SESSIONS) continue;\n        if ((this.#notBefore.get(sessionId) ?? 0) > Date.now()) continue;\n        this.#inFlight.add(sessionId);\n        void this.#drain(sessionId)\n          .then((progressed) => {\n            if (progressed) this.wake();\n          })\n          .catch((error: unknown) => {\n            log(\"inbox-drain-failed\", { session: sessionId, message: errorMessage(error) });\n          })\n          .finally(() => this.#inFlight.delete(sessionId));\n      }\n    } catch (error) {\n      log(\"inbox-poll-failed\", { message: errorMessage(error) });\n    }\n  }\n\n  /** Claims and applies batches for one session until none is pending. True if it made progress. */\n  async #drain(sessionId: string): Promise<boolean> {\n    let progressed = false;\n    while (!this.#stopped) {\n      const client = await this.#pool.connect();\n      let finished = true;\n      let submitted = 0;\n      try {\n        await client.query(\"begin\");\n        const { rows } = await client.query<EventDbRow>(\n          `select * from inbox.events\n            where session_id = $1 and status = 'pending'\n            order by created_at, id\n            limit $2\n            for update skip locked`,\n          [sessionId, BATCH],\n        );\n        if (rows.length === 0) {\n          await client.query(\"commit\");\n          return progressed;\n        }\n        for (const row of rows) {\n          const event = toEvent(row);\n          const outcome = await this.#applyRow(client, event);\n          if (outcome === \"retry-later\") {\n            finished = false;\n            break;\n          }\n          progressed = true;\n          if (outcome === \"submitted\") submitted += 1;\n        }\n        await client.query(\"commit\");\n      } catch (error) {\n        await client.query(\"rollback\").catch(() => undefined);\n        throw error;\n      } finally {\n        client.release();\n      }\n      // Once per batch and after the commit. Inside the transaction this update would hold the session row's lock\n      // until the commit, and a later row of the batch (delete, a failSession) updates the same row on another\n      // connection: it would wait for a lock that only this transaction's end releases, until statement_timeout.\n      if (submitted > 0) await this.#touchSession(sessionId);\n      if (!finished) return progressed;\n    }\n    return progressed;\n  }\n\n  async #touchSession(sessionId: string): Promise<void> {\n    try {\n      await this.#pool.query(\n        \"update inbox.sessions set last_activity_at = clock_timestamp() where id = $1\",\n        [sessionId],\n      );\n    } catch (error) {\n      // Only the idle clock; the rows are already committed.\n      log(\"inbox-touch-failed\", { session: sessionId, message: errorMessage(error) });\n    }\n  }\n\n  async #applyRow(\n    client: pg.PoolClient,\n    event: InboxEvent,\n  ): Promise<\"submitted\" | \"gave-up\" | \"retry-later\"> {\n    const attempt = event.attempts + 1;\n    try {\n      const session = await getSession(client, event.sessionId);\n      if (session === undefined) throw new PermanentError(\"session does not exist\");\n      await this.#apply(event, session);\n      await client.query(\n        `update inbox.events\n            set status = 'submitted', submitted_at = clock_timestamp(), attempts = $2, error = null\n          where id = $1`,\n        [event.id, attempt],\n      );\n      this.#notBefore.delete(event.sessionId);\n      log(\"event-submitted\", { eventId: event.id, session: event.sessionId, kind: event.kind });\n      return \"submitted\";\n    } catch (error) {\n      const message = errorMessage(error).slice(0, 500);\n      const permanent =\n        error instanceof PermanentError || (attempt >= MAX_ATTEMPTS && event.kind !== \"delete\");\n      if (!permanent && event.kind === \"delete\") {\n        this.#notBefore.set(event.sessionId, Date.now() + deleteRetryDelayMs(attempt));\n      }\n      await client.query(\n        \"update inbox.events set status = $2, attempts = $3, error = $4 where id = $1\",\n        [event.id, permanent ? \"failed\" : \"pending\", attempt, message],\n      );\n      log(\"event-failed\", {\n        eventId: event.id,\n        session: event.sessionId,\n        attempt,\n        permanent,\n        message,\n      });\n      return permanent ? \"gave-up\" : \"retry-later\";\n    }\n  }\n}\n","isError":false}]}
ENTRY 11196 {"id":11196,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { randomUUID } from \"node:crypto\";\nimport type pg from \"pg\";\nimport { THINKING_LEVELS } from \"./models.js\";\nimport type { ModelChoice } from \"./models.js\";\nimport type { RepoSpec } from \"./repo.js\";\n\n/** `failed` is terminal: the model credentials were rejected or the turn budget is used up. Only DELETE is accepted. */\nexport type SessionStatus = \"active\" | \"deleting\" | \"deleted\" | \"failed\";\nexport type EventKind = \"message\" | \"steer\" | \"cancel\" | \"delete\";\nexport type EventStatus = \"pending\" | \"submitted\" | \"failed\";\n\nexport interface SessionRow {\n  id: string;\n  owner: string;\n  /** Subject of the creating principal; the owner check compares this, not `owner`. */\n  ownerSubject: string | null;\n  status: SessionStatus;\n  /** Pi Durable conversation id; null until the orchestrator has created it. */\n  conversationId: number | null;\n  /** The model chosen at creation; null for sessions that predate migration 002 (they run the default). */\n  model: ModelChoice | null;\n  /** Why the session is `failed`; null otherwise. */\n  failure: string | null;\n  /** The repository workspace asked for at creation; null for a plain session (no OneCLI objects exist). */\n  repo: RepoSpec | null;\n  /** OneCLI agent and secret ids of a repo session, once provisioned. Ids only, never values. */\n  onecli: { agentId: string; secretIds: string[] } | null;\n  /** When the clone and the workspace marker were first completed; null before. */\n  workspaceReadyAt: Date | null;\n  createdAt: Date;\n  lastActivityAt: Date;\n}\n\nexport interface InboxEvent {\n  /** bigint, so a string. Also the Pi Durable `requestId` of the submission. */\n  id: string;\n  sessionId: string;\n  source: string;\n  sourceEventId: string;\n  kind: EventKind;\n  payload: { text?: string; [key: string]: unknown };\n  status: EventStatus;\n  attempts: number;\n  createdAt: Date;\n  submittedAt: Date | null;\n  error: string | null;\n}\n\ninterface SessionDbRow {\n  id: string;\n  owner: string;\n  owner_subject: string | null;\n  status: SessionStatus;\n  conversation_id: string | null;\n  model_provider: string | null;\n  model_id: string | null;\n  model_reasoning: string | null;\n  failure: string | null;\n  repo: string | null;\n  repo_branch: string | null;\n  onecli_agent_id: string | null;\n  onecli_secret_ids: string[] | null;\n  workspace_ready_at: Date | null;\n  created_at: Date;\n  last_activity_at: Date;\n}\n\nexport interface EventDbRow {\n  id: string;\n  session_id: string;\n  source: string;\n  source_event_id: string;\n  kind: EventKind;\n  payload: InboxEvent[\"payload\"];\n  status: EventStatus;\n  attempts: number;\n  created_at: Date;\n  submitted_at: Date | null;\n  error: string | null;\n}\n\nconst toSession = (row: SessionDbRow): SessionRow => ({\n  id: row.id,\n  owner: row.owner,\n  ownerSubject: row.owner_subject,\n  status: row.status,\n  conversationId: row.conversation_id === null ? null : Number(row.conversation_id),\n  model:\n    row.model_provider === null || row.model_id === null\n      ? null\n      : {\n          provider: row.model_provider,\n          model: row.model_id,\n          ...reasoningOf(row.model_reasoning),\n        },\n  failure: row.failure,\n  repo:\n    row.repo === null\n      ? null\n      : { repo: row.repo, ...(row.repo_branch === null ? {} : { branch: row.repo_branch }) },\n  onecli:\n    row.onecli_agent_id === null\n      ? null\n      : { agentId: row.onecli_agent_id, secretIds: row.onecli_secret_ids ?? [] },\n  workspaceReadyAt: row.workspace_ready_at,\n  createdAt: row.created_at,\n  lastActivityAt: row.last_activity_at,\n});\n\nfunction reasoningOf(value: string | null): Pick<ModelChoice, \"reasoning\"> {\n  const level = THINKING_LEVELS.find((candidate) => candidate === value);\n  return level === undefined ? {} : { reasoning: level };\n}\n\nexport const toEvent = (row: EventDbRow): InboxEvent => ({\n  id: row.id,\n  sessionId: row.session_id,\n  source: row.source,\n  sourceEventId: row.source_event_id,\n  kind: row.kind,\n  payload: row.payload,\n  status: row.status,\n  attempts: row.attempts,\n  createdAt: row.created_at,\n  submittedAt: row.submitted_at,\n  error: row.error,\n});\n\n/** Session ids are random UUIDs (v4), never sequential: an id cannot be guessed from another. */\nexport async function createSession(\n  pool: pg.Pool,\n  principal: { owner: string; subject: string },\n  model: ModelChoice,\n  repo?: RepoSpec,\n): Promise<string> {\n  const id = randomUUID();\n  await pool.query(\n    \"insert into inbox.sessions (id, owner, owner_subject, model_provider, model_id, model_reasoning, repo, repo_branch) values ($1, $2, $3, $4, $5, $6, $7, $8)\",\n    [\n      id,\n      principal.owner,\n      principal.subject,\n      model.provider,\n      model.model,\n      model.reasoning ?? null,\n      repo?.repo ?? null,\n      repo?.branch ?? null,\n    ],\n  );\n  return id;\n}\n\n/** Moves an active session to the terminal `failed` state. False if it was not active (failed already, deleting, deleted). */\nexport async function failSession(\n  db: Pick<pg.Pool, \"query\">,\n  sessionId: string,\n  failure: string,\n): Promise<boolean> {\n  const result = await db.query(\n    `update inbox.sessions set status = 'failed', failure = $2, last_activity_at = clock_timestamp()\n      where id = $1 and status = 'active'`,\n    [sessionId, failure.slice(0, 500)],\n  );\n  return (result.rowCount ?? 0) > 0;\n}\n\nexport async function getSession(\n  db: Pick<pg.Pool, \"query\">,\n  id: string,\n): Promise<SessionRow | undefined> {\n  const { rows } = await db.query<SessionDbRow>(\"select * from inbox.sessions where id = $1\", [id]);\n  const row = rows[0];\n  return row === undefined ? undefined : toSession(row);\n}\n\nexport type EnqueueResult =\n  | { outcome: \"accepted\"; eventId: string }\n  /** The same (source, source_event_id) was already stored: nothing new was written. */\n  | { outcome: \"duplicate\"; eventId: string }\n  /** The (source, source_event_id) belongs to another session. */\n  | { outcome: \"conflict\" }\n  /** `requireActive` was set and the session is not active (any more): nothing was written. */\n  | { outcome: \"inactive\"; status: SessionStatus };\n\n/**\n * Writes one event and returns. The unique index on (source, source_event_id) makes a repeated post a no-op that\n * returns the first event's id. The orchestrator is not involved: this works while it is down.\n */\nexport async function enqueueEvent(\n  pool: pg.Pool,\n  event: {\n    sessionId: string;\n    source: string;\n    sourceEventId: string;\n    kind: EventKind;\n    payload: InboxEvent[\"payload\"];\n  },\n  options: { requireActive?: boolean } = {},\n): Promise<EnqueueResult> {\n  // With requireActive the status test and the insert are one statement: a caller that read the session earlier\n  // (ingest does, before it reads the request body) cannot get an event accepted for a session that was deleted\n  // meanwhile. `for share` makes the insert wait for a concurrent status change to commit and then see it, and\n  // makes a concurrent DELETE wait for this insert, so an accepted event always precedes the delete row.\n  const columns = \"(session_id, source, source_event_id, kind, payload)\";\n  const inserted = await pool.query<{ id: string }>(\n    `insert into inbox.events ${columns}\n     ${\n       options.requireActive === true\n         ? `select s.id, $2, $3, $4, $5::jsonb from inbox.sessions s where s.id = $1 and s.status = 'active' for share of s`\n         : `values ($1, $2, $3, $4, $5)`\n     }\n     on conflict (source, source_event_id) do nothing\n     returning id`,\n    [event.sessionId, event.source, event.sourceEventId, event.kind, JSON.stringify(event.payload)],\n  );\n  const fresh = inserted.rows[0];\n  if (fresh !== undefined) {\n    await pool.query(\n      \"update inbox.sessions set last_activity_at = clock_timestamp() where id = $1\",\n      [event.sessionId],\n    );\n    return { outcome: \"accepted\", eventId: fresh.id };\n  }\n  const { rows } = await pool.query<{ id: string; session_id: string }>(\n    \"select id, session_id from inbox.events where source = $1 and source_event_id = $2\",\n    [event.source, event.sourceEventId],\n  );\n  const existing = rows[0];\n  if (existing === undefined && options.requireActive === true) {\n    const current = await pool.query<{ status: SessionStatus }>(\n      \"select status from inbox.sessions where id = $1\",\n      [event.sessionId],\n    );\n    return { outcome: \"inactive\", status: current.rows[0]?.status ?? \"deleted\" };\n  }\n  if (existing === undefined || existing.session_id !== event.sessionId) {\n    return { outcome: \"conflict\" };\n  }\n  return { outcome: \"duplicate\", eventId: existing.id };\n}\n\n/**\n * The dedup key of a session's delete row. Client events use `source = api:<owner>` with a client-chosen id, so the\n * server's own row lives in a source no client can write: a client id such as `delete:<id>` can then never\n * occupy the key and make DELETE a no-op. (Delete rows written before this carry `api:<owner>` / `delete:<id>`;\n * they stay as they are and a new DELETE simply adds one under this key.)\n */\nexport function deleteEventKey(sessionId: string): { source: string; sourceEventId: string } {\n  return { source: \"system:delete\", sourceEventId: sessionId };\n}\n\n/**\n * Puts a `failed` delete row back to `pending`. A repeated DELETE calls it: the row is deduplicated, so without this\n * a delete that failed (rows from before deletes were retried without limit, or a permanent error since fixed) could\n * never run again.\n */\nexport async function requeueFailedDelete(pool: pg.Pool, sessionId: string): Promise<void> {\n  await pool.query(\n    `update inbox.events set status = 'pending', attempts = 0, error = null\n      where session_id = $1 and kind = 'delete' and status = 'failed'`,\n    [sessionId],\n  );\n}\n\n/** Marks an active session as being deleted, so no further events are accepted. Idempotent. */\nexport async function requestDelete(pool: pg.Pool, sessionId: string): Promise<void> {\n  await pool.query(\n    \"update inbox.sessions set status = 'deleting', last_activity_at = clock_timestamp() where id = $1 and status in ('active', 'failed')\",\n    [sessionId],\n  );\n}\n\nexport interface SessionSummary {\n  status: SessionStatus;\n  lastActivityAt: Date;\n  events: Record<EventStatus, number>;\n}\n\nexport async function summarize(pool: pg.Pool, session: SessionRow): Promise<SessionSummary> {\n  const { rows } = await pool.query<{ status: EventStatus; n: string }>(\n    \"select status, count(*) as n from inbox.events where session_id = $1 group by status\",\n    [session.id],\n  );\n  const events: Record<EventStatus, number> = { pending: 0, submitted: 0, failed: 0 };\n  for (const row of rows) events[row.status] = Number(row.n);\n  return { status: session.status, lastActivityAt: session.lastActivityAt, events };\n}\n\n/** Records the OneCLI objects of a repo session. Ids only: no token or secret value is ever stored here. */\nexport async function setOneCliObjects(\n  db: Pick<pg.Pool, \"query\">,\n  sessionId: string,\n  agentId: string,\n  secretIds: readonly string[],\n): Promise<void> {\n  await db.query(\n    \"update inbox.sessions set onecli_agent_id = $2, onecli_secret_ids = $3 where id = $1\",\n    [sessionId, agentId, [...secretIds]],\n  );\n}\n\n/** Marks the repo workspace as cloned. Keeps the first time if called again. */\nexport async function markWorkspaceReady(\n  db: Pick<pg.Pool, \"query\">,\n  sessionId: string,\n): Promise<void> {\n  await db.query(\n    \"update inbox.sessions set workspace_ready_at = coalesce(workspace_ready_at, clock_timestamp()) where id = $1\",\n    [sessionId],\n  );\n}\n\n/**\n * First step of session deletion: records what the session held, so a crash before the OneCLI objects and the claim\n * are gone still leaves the list of what to revoke. Safe to repeat; the first record stays.\n */\nexport async function writeTombstone(\n  db: Pick<pg.Pool, \"query\">,\n  session: SessionRow,\n): Promise<void> {\n  await db.query(\n    `insert into inbox.tombstones (session_id, conversation_id, repo, onecli_agent_id, onecli_secret_ids)\n     values ($1, $2, $3, $4, $5)\n     on conflict (session_id) do nothing`,\n    [\n      session.id,\n      session.conversationId,\n      session.repo?.repo ?? null,\n      session.onecli?.agentId ?? null,\n      session.onecli === null ? null : [...session.onecli.secretIds],\n    ],\n  );\n}\n\nexport async function completeTombstone(\n  db: Pick<pg.Pool, \"query\">,\n  sessionId: string,\n): Promise<void> {\n  await db.query(\n    \"update inbox.tombstones set completed_at = coalesce(completed_at, clock_timestamp()) where session_id = $1\",\n    [sessionId],\n  );\n}\n\n/**\n * Records that a command may be running (or was interrupted) in the sandbox of this conversation. Called when a\n * burst of commands starts; a process that dies mid-command never clears it, which is the signal to recycle the Pod.\n * A conversation without a session row (the test-only control sessions) updates nothing.\n */\nexport async function setExecInFlight(\n  db: Pick<pg.Pool, \"query\">,\n  conversationId: number,\n  inFlight: boolean,\n): Promise<void> {\n  await db.query(\n    \"update inbox.sessions set exec_in_flight_at = case when $2::boolean then clock_timestamp() else null end where conversation_id = $1\",\n    [conversationId, inFlight],\n  );\n}\n\n/** Conversations whose sandbox had a command in flight when the last orchestrator process stopped. */\nexport async function conversationsWithExecInFlight(db: Pick<pg.Pool, \"query\">): Promise<number[]> {\n  const { rows } = await db.query<{ conversation_id: string }>(\n    \"select conversation_id from inbox.sessions where exec_in_flight_at is not null and conversation_id is not null and status in ('active', 'failed', 'deleting')\",\n  );\n  return rows.map((row) => Number(row.conversation_id));\n}\n\n/** What the orphan sweep needs to know about every session: no owner, model or repo. */\nexport interface SessionRef {\n  id: string;\n  status: SessionStatus;\n  conversationId: number | null;\n}\n\nexport async function listSessionRefs(db: Pick<pg.Pool, \"query\">): Promise<SessionRef[]> {\n  const { rows } = await db.query<{\n    id: string;\n    status: SessionStatus;\n    conversation_id: string | null;\n  }>(\"select id, status, conversation_id from inbox.sessions\");\n  return rows.map((row) => ({\n    id: row.id,\n    status: row.status,\n    conversationId: row.conversation_id === null ? null : Number(row.conversation_id),\n  }));\n}\n","isError":false}]}
ENTRY 11197 {"id":11197,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { createServer } from \"node:http\";\nimport type { IncomingMessage, Server, ServerResponse } from \"node:http\";\nimport { errorMessage, getSession, sendJson, UUID } from \"@pi-durable-k8s/session-core\";\nimport type { Authenticator } from \"@pi-durable-k8s/session-core\";\nimport type pg from \"pg\";\nimport type { Host } from \"./host.js\";\nimport { log } from \"./log.js\";\nimport { parseScript } from \"./model.js\";\nimport type { SessionService } from \"./sessions.js\";\nimport { serveStream } from \"./stream.js\";\n\n/** What /readyz reports: ready only once this process holds the storage lock and the Harness is open. */\nexport interface Lifecycle {\n  state: \"waiting-for-lock\" | \"owner\";\n  instance: string;\n  host?: Host;\n  service?: SessionService;\n}\n\nexport interface ServerDeps {\n  lifecycle: Lifecycle;\n  authenticate: Authenticator;\n  /** For the owner check on the stream. Independent of the Pi Durable storage connection. */\n  pool: pg.Pool;\n  /** Mounts the test-only /control surface (PI_ORCH_CONTROL=1). */\n  control: boolean;\n}\n\nasync function readBody(req: IncomingMessage): Promise<string> {\n  const chunks: Buffer[] = [];\n  let size = 0;\n  for await (const chunk of req) {\n    const buffer = chunk as Buffer;\n    size += buffer.length;\n    if (size > 64 * 1024) throw new Error(\"body too large\");\n    chunks.push(buffer);\n  }\n  return Buffer.concat(chunks).toString(\"utf8\");\n}\n\n/**\n * The orchestrator's HTTP surface.\n *   GET /healthz                  liveness: 200 while the process runs\n *   GET /readyz                   200 once this process owns the schema and serves, else 503\n *   GET /sessions/{id}/stream     SSE; bearer token + owner check, the same Authenticator as ingest\n *   /control/...                  test-only (PI_ORCH_CONTROL=1): the Phase 3 scripted-session surface, same auth\n */\nexport function createOrchestratorServer(deps: ServerDeps): Server {\n  const server = createServer((req, res) => {\n    void handle(req, res, deps).catch((error: unknown) => {\n      log(\"http-error\", { message: errorMessage(error) });\n      if (!res.headersSent) sendJson(res, 500, { error: \"internal error\" });\n      else res.destroy();\n    });\n  });\n  server.requestTimeout = 0;\n  return server;\n}\n\nasync function handle(req: IncomingMessage, res: ServerResponse, deps: ServerDeps): Promise<void> {\n  const { lifecycle } = deps;\n  const url = new URL(req.url ?? \"/\", \"http://localhost\");\n  const parts = url.pathname.split(\"/\").filter(Boolean);\n  const method = req.method ?? \"GET\";\n\n  if (method === \"GET\" && url.pathname === \"/healthz\") {\n    sendJson(res, 200, { status: \"ok\", state: lifecycle.state, instance: lifecycle.instance });\n    return;\n  }\n  if (method === \"GET\" && url.pathname === \"/readyz\") {\n    const ready = lifecycle.host !== undefined && lifecycle.service !== undefined;\n    sendJson(res, ready ? 200 : 503, { state: lifecycle.state, instance: lifecycle.instance });\n    return;\n  }\n\n  const principal = await deps.authenticate(req.headers);\n  if (principal === undefined) {\n    sendJson(res, 401, { error: \"unauthorized\" }, { \"www-authenticate\": \"Bearer\" });\n    return;\n  }\n\n  const { host, service } = lifecycle;\n  if (host === undefined || service === undefined) {\n    // Not the owner yet (starting, or waiting for the lock). Clients retry; ingest keeps accepting events.\n    sendJson(res, 503, { error: lifecycle.state }, { \"retry-after\": \"2\" });\n    return;\n  }\n\n  if (method === \"GET\" && parts.length === 3 && parts[0] === \"sessions\" && parts[2] === \"stream\") {\n    const id = parts[1] ?? \"\";\n    const session = UUID.test(id) ? await getSession(deps.pool, id) : undefined;\n    if (session?.ownerSubject !== principal.subject) {\n      sendJson(res, 404, { error: \"session not found\" });\n      return;\n    }\n    if (session.status === \"deleted\") {\n      sendJson(res, 410, { error: \"session deleted\" });\n      return;\n    }\n    const conversationId = await service.ensureConversation(session);\n    await serveStream(req, res, host, service.streams, session.id, conversationId);\n    return;\n  }\n\n  if (deps.control && parts[0] === \"control\") {\n    await handleControl(req, res, host, method, parts.slice(1));\n    return;\n  }\n  sendJson(res, 404, { error: \"not found\" });\n}\n\n/**\n * Test-only. Scripted sessions created straight on the Harness, not through the inbox, with the sandbox claim\n * created eagerly. Kept only so the Phase 3 failure tests keep running unchanged in substance.\n *   POST /control/sessions            body = script JSON\n *   POST /control/sessions/:id/inputs body = script JSON\n *   GET  /control/sessions/:id        status and tool results\n */\nasync function handleControl(\n  req: IncomingMessage,\n  res: ServerResponse,\n  host: Host,\n  method: string,\n  parts: string[],\n): Promise<void> {\n  if (parts[0] !== \"sessions\") {\n    sendJson(res, 404, { error: \"not found\" });\n    return;\n  }\n  if (method === \"POST\" && parts.length === 1) {\n    let script;\n    try {\n      script = parseScript(await readBody(req));\n    } catch (error) {\n      sendJson(res, 400, { error: errorMessage(error) });\n      return;\n    }\n    sendJson(res, 201, await host.startSession(script));\n    return;\n  }\n  const id = Number(parts[1]);\n  if (method === \"POST\" && parts[2] === \"inputs\") {\n    let script;\n    try {\n      script = parseScript(await readBody(req));\n    } catch (error) {\n      sendJson(res, 400, { error: errorMessage(error) });\n      return;\n    }\n    const known = Number.isInteger(id) && (await host.sendInput(id, script));\n    sendJson(res, known ? 202 : 404, known ? { id } : { error: \"unknown session\" });\n    return;\n  }\n  if (method === \"GET\" && parts.length === 2 && Number.isInteger(id)) {\n    const status = await host.status(id);\n    sendJson(res, status === undefined ? 404 : 200, status ?? { error: \"unknown session\" });\n    return;\n  }\n  sendJson(res, 404, { error: \"not found\" });\n}\n","isError":false}]}
ENTRY 11198 {"id":11198,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import type { RunOutcome } from \"./failure.js\";\n\n/** One input the orchestrator handed to Pi Durable and has not yet seen settled. */\nexport interface Watched {\n  sessionId: string;\n  conversationId: number;\n  /** The inbox row id: the Pi Durable `requestId` of the submission. */\n  requestId: string;\n}\n\n/** What the storage says about a submission; only the fields the watcher reads. */\nexport type SubmissionState =\n  | { status: \"queued\" | \"placed\" }\n  | { status: \"done\" }\n  | { status: \"unanswered\"; reason: string; detail?: unknown };\n\nexport interface RunWatcherOptions {\n  lookup: (conversationId: number, requestId: string) => Promise<SubmissionState | undefined>;\n  /** A submission ended `unanswered`: the run it belonged to failed or was aborted. Called once per submission. */\n  onUnanswered: (watched: Watched, outcome: RunOutcome) => Promise<void>;\n  pollMs?: number;\n  onError?: (error: unknown) => void;\n}\n\n/**\n * Notices runs that end without an answer. Pi Durable reports a model error only inside the conversation (the run's\n * submissions settle `unanswered` with the reason and error text), not to the host, so the orchestrator reads the\n * submissions it handed over until each is settled. Polling the storage also covers a run that a previous process\n * started and this one resumed: `add` it again at start and it is picked up the same way.\n */\nexport class RunWatcher {\n  readonly #options: RunWatcherOptions;\n  readonly #pending = new Map<string, Watched>();\n  #timer: NodeJS.Timeout | undefined;\n  #polling = false;\n\n  constructor(options: RunWatcherOptions) {\n    this.#options = options;\n  }\n\n  add(watched: Watched): void {\n    this.#pending.set(`${String(watched.conversationId)}/${watched.requestId}`, watched);\n    this.#timer ??= setInterval(() => void this.poll(), this.#options.pollMs ?? 2_000);\n    this.#timer.unref();\n  }\n\n  get size(): number {\n    return this.#pending.size;\n  }\n\n  stop(): void {\n    if (this.#timer !== undefined) clearInterval(this.#timer);\n    this.#timer = undefined;\n  }\n\n  /** One pass over the pending submissions. Exposed so tests need no timers. */\n  async poll(): Promise<void> {\n    if (this.#polling) return;\n    this.#polling = true;\n    try {\n      for (const [key, watched] of [...this.#pending]) {\n        try {\n          const state = await this.#options.lookup(watched.conversationId, watched.requestId);\n          if (state === undefined || state.status === \"done\") {\n            this.#pending.delete(key);\n          } else if (state.status === \"unanswered\") {\n            const detail =\n              typeof state.detail === \"string\"\n                ? state.detail\n                : state.detail === undefined\n                  ? undefined\n                  : JSON.stringify(state.detail);\n            await this.#options.onUnanswered(watched, {\n              reason: state.reason,\n              ...(detail === undefined ? {} : { detail }),\n            });\n            // Only now: a handler that threw leaves the watch in place, so the failure is not lost.\n            this.#pending.delete(key);\n          }\n        } catch (error) {\n          // Keep it pending: a storage hiccup must not lose the watch, nor crash the orchestrator.\n          this.#options.onError?.(error);\n        }\n      }\n    } finally {\n      this.#polling = false;\n      if (this.#pending.size === 0) this.stop();\n    }\n  }\n}\n","isError":false}]}
ENTRY 11199 {"id":11199,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { once } from \"node:events\";\nimport type { IncomingMessage, ServerResponse } from \"node:http\";\nimport { BACKGROUND_CONTEXT as context } from \"@earendil-works/chord/context\";\nimport type { ConversationView, EntryRecord } from \"@earendil-works/pi-durable\";\nimport { errorMessage } from \"@pi-durable-k8s/session-core\";\nimport type { Host } from \"./host.js\";\nimport { toEvent } from \"./host.js\";\nimport { log } from \"./log.js\";\nimport type { StreamRegistry } from \"./sessions.js\";\n\nconst KEEPALIVE_MS = 15_000;\nconst GAP_PAGE = 100;\n\n/** What the client sees of the run in progress. Carries no SSE id: it is not addressable by a cursor. */\nexport interface LiveEvent {\n  running: boolean;\n  /** Inputs queued behind the running turn. */\n  queued: number;\n  /** The throttled partial answer of the response being generated, if any. */\n  partial?: string;\n  tools?: { callId: string; name: string; status: string }[];\n  /** Why the newest run ended without an answer, e.g. `aborted`. */\n  runFailure?: string;\n}\n\nfunction asObject(value: unknown): Record<string, unknown> | undefined {\n  return typeof value === \"object\" && value !== null && !Array.isArray(value)\n    ? (value as Record<string, unknown>)\n    : undefined;\n}\n\n/** Projects `pi.live` and `pi.inbox` of a conversation view. Defensive: these are plain JSON documents. */\nexport function liveEvent(docs: ConversationView[\"docs\"]): LiveEvent {\n  const live = asObject(docs[\"pi.live\"]);\n  const inbox = asObject(docs[\"pi.inbox\"]);\n  const items = inbox?.items;\n  const event: LiveEvent = {\n    running: live?.run !== undefined,\n    queued: Array.isArray(items) ? items.length : 0,\n  };\n  const content = asObject(asObject(live?.generation)?.message)?.content;\n  if (Array.isArray(content)) {\n    const partial = content\n      .map((block) => {\n        const b = asObject(block);\n        return b?.type === \"text\" && typeof b.text === \"string\" ? b.text : \"\";\n      })\n      .join(\"\");\n    if (partial !== \"\") event.partial = partial;\n  }\n  if (Array.isArray(live?.tools)) {\n    event.tools = (live.tools as unknown[]).flatMap((slot) => {\n      const s = asObject(slot);\n      return s !== undefined\n        ? [{ callId: String(s.callId), name: String(s.name), status: String(s.status) }]\n        : [];\n    });\n  }\n  const failure = asObject(live?.runFailure);\n  if (typeof failure?.reason === \"string\") event.runFailure = failure.reason;\n  return event;\n}\n\n/** Only entries that carry model messages are streamed (inputs, answers, tool calls and results). */\nfunction entryEvent(\n  entry: EntryRecord,\n): { id: number; kind: string; messages: unknown[] } | undefined {\n  // System messages (the rendered system prompt) are the host's, not the conversation's: never streamed.\n  const messages = (entry.model ?? []).filter((message) => message.role !== \"system\");\n  if (messages.length === 0) return undefined;\n  return { id: entry.id, kind: entry.kind, messages: messages.map(toEvent) };\n}\n\nexport function parseLastEventId(header: string | string[] | undefined): number {\n  const raw = Array.isArray(header) ? header[0] : header;\n  const value = Number(raw);\n  return raw !== undefined && Number.isSafeInteger(value) && value > 0 ? value : 0;\n}\n\n/**\n * Writes a chunk and waits for the socket to drain, or for the client to go away. Whichever event loses the race must\n * drop its listener: a slow client under backpressure would otherwise pile up one `close` listener per write.\n */\nexport async function write(res: ServerResponse, chunk: string): Promise<void> {\n  if (res.destroyed || res.writableEnded) return;\n  if (!res.write(chunk)) {\n    const done = new AbortController();\n    try {\n      await Promise.race([\n        once(res, \"drain\", { signal: done.signal }),\n        once(res, \"close\", { signal: done.signal }),\n      ]);\n    } catch {\n      // the stream failed or was aborted; the caller sees the closed response on its next write\n    } finally {\n      done.abort();\n    }\n  }\n}\n\n/**\n * Server-sent events for one conversation, built on `Conversation.watch()` (the conversation view).\n *\n *  - `event: entry`, `id: <entry id>`: a committed transcript entry, once, in order. The id is the cursor.\n *  - `event: live`, no id: the run in progress (partial answer, tool calls, queue). Sent whole on connect and\n *    on every change; not replayed from a cursor, so a reconnect starts from the current state of the response.\n *  - `event: deleted`: the session was deleted; the stream ends.\n *\n * A client reconnects with `Last-Event-ID: <last entry id>`: entries after it are sent first (those the\n * watch's window no longer holds are read with `Conversation.entries()`), then live updates. Without the\n * header the whole transcript is replayed from the start.\n */\nexport async function serveStream(\n  req: IncomingMessage,\n  res: ServerResponse,\n  host: Host,\n  streams: StreamRegistry,\n  sessionId: string,\n  conversationId: number,\n): Promise<void> {\n  const watched = await host.watch(conversationId);\n  if (watched === undefined) {\n    res.writeHead(404, { \"content-type\": \"application/json\" });\n    res.end(JSON.stringify({ error: \"conversation not found\" }));\n    return;\n  }\n  const { conversation, watch } = watched;\n  let cursor = parseLastEventId(req.headers[\"last-event-id\"]);\n\n  res.writeHead(200, {\n    \"content-type\": \"text/event-stream\",\n    \"cache-control\": \"no-cache\",\n    connection: \"keep-alive\",\n    \"x-accel-buffering\": \"no\",\n  });\n  res.write(\"retry: 2000\\n\\n\");\n\n  let lastLive = \"\";\n  const finish = (reason?: string): void => {\n    clearInterval(keepalive);\n    unregister();\n    void watch.stop();\n    if (res.writableEnded || res.destroyed) return;\n    if (reason !== undefined) res.write(`event: ${reason}\\ndata: {}\\n\\n`);\n    res.end();\n  };\n  const keepalive = setInterval(() => {\n    if (!res.destroyed) res.write(\": keepalive\\n\\n\");\n  }, KEEPALIVE_MS);\n  const unregister = streams.add(sessionId, finish);\n  res.on(\"close\", () => finish());\n\n  const sendEntry = async (entry: EntryRecord): Promise<void> => {\n    if (entry.id <= cursor) return;\n    cursor = entry.id;\n    const event = entryEvent(entry);\n    if (event !== undefined) {\n      await write(res, `id: ${String(event.id)}\\nevent: entry\\ndata: ${JSON.stringify(event)}\\n\\n`);\n    }\n  };\n\n  const emit = async (view: ConversationView): Promise<void> => {\n    // The window may start after the client's cursor (long outage, or a fresh connect): read the gap.\n    if (view.before !== undefined && view.before > cursor) {\n      let after = cursor;\n      for (;;) {\n        const page = await conversation.entries(\n          {\n            minEntryId: (after + 1) as EntryRecord[\"id\"],\n            maxEntryId: view.before,\n            order: \"ascending\",\n          },\n          GAP_PAGE,\n          undefined,\n          context,\n        );\n        for (const entry of page.items) await sendEntry(entry);\n        const newest = page.items.at(-1);\n        if (newest === undefined || page.items.length < GAP_PAGE) break;\n        after = newest.id;\n      }\n    }\n    for (const entry of view.entries) await sendEntry(entry);\n    const live = JSON.stringify(liveEvent(view.docs));\n    if (live !== lastLive) {\n      lastLive = live;\n      await write(res, `event: live\\ndata: ${live}\\n\\n`);\n    }\n  };\n\n  try {\n    await emit(watch.value);\n  } catch (error) {\n    log(\"stream-failed\", { session: sessionId, message: errorMessage(error) });\n    finish();\n    return;\n  }\n  watch.start(async (call) => {\n    if (call.kind !== \"value\") return;\n    await emit(call.value);\n  });\n  // The watch ends when the Harness closes (orchestrator shutdown) or fails: end the response so the client reconnects.\n  void watch.closed.then(() => {\n    finish();\n  });\n}\n","isError":false}]}
ENTRY 11235 {"id":11235,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && grep -nE 'turnsUsed|limitTurns|submitInput|abort\\\\(' packages/orchestrator/src/host.ts && nl -ba packages/orchestrator/src/sessions.ts | sed -n '95,115p;170,225p;276,315p' && grep -R -n 'completed_at\\\\|tombstones' packages/orchestrator/src | head -40\"})"]}]}
ENTRY 11240 {"id":11240,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"207:  async turnsUsed(id: number): Promise<number> {\n220:  async limitTurns(id: number, maxTurns: number): Promise<void> {\n234:  async submitInput(\n261:  async abort(id: number): Promise<void> {\n262:    await (await this.#conversation(id)).abort(context);\n    95\t  async recoverWatches(): Promise<void> {\n    96\t    const { rows } = await this.#pool.query<{\n    97\t      id: string;\n    98\t      session_id: string;\n    99\t      conversation_id: string;\n   100\t    }>(\n   101\t      `select e.id, e.session_id, s.conversation_id\n   102\t         from inbox.events e join inbox.sessions s on s.id = e.session_id\n   103\t        where e.kind in ('message', 'steer') and e.status = 'submitted'\n   104\t          and s.status = 'active' and s.conversation_id is not null\n   105\t          and e.submitted_at > clock_timestamp() - interval '24 hours'\n   106\t        order by e.submitted_at desc limit 1000`,\n   107\t    );\n   108\t    for (const row of rows) {\n   109\t      this.#watcher.add({\n   110\t        sessionId: row.session_id,\n   111\t        conversationId: Number(row.conversation_id),\n   112\t        requestId: row.id,\n   113\t      });\n   114\t    }\n   115\t    if (rows.length > 0) log(\"run-watches-recovered\", { count: rows.length });\n   170\t   * storing its id leaves one empty, unreferenced conversation behind (documented limit).\n   171\t   */\n   172\t  async ensureConversation(session: SessionRow): Promise<number> {\n   173\t    if (session.conversationId !== null) return session.conversationId;\n   174\t    let creating = this.#creating.get(session.id);\n   175\t    if (creating === undefined) {\n   176\t      creating = this.#create(session.id).finally(() => this.#creating.delete(session.id));\n   177\t      this.#creating.set(session.id, creating);\n   178\t    }\n   179\t    return creating;\n   180\t  }\n   181\t\n   182\t  async #create(sessionId: string): Promise<number> {\n   183\t    const current = await getSession(this.#pool, sessionId);\n   184\t    if (current?.conversationId != null) return current.conversationId;\n   185\t    const conversationId = await this.#host.createConversation(\n   186\t      current?.model ?? this.#options.defaultModel,\n   187\t    );\n   188\t    await this.#pool.query(\n   189\t      \"update inbox.sessions set conversation_id = $1 where id = $2 and conversation_id is null\",\n   190\t      [conversationId, sessionId],\n   191\t    );\n   192\t    log(\"conversation-created\", { session: sessionId, conversation: conversationId });\n   193\t    return conversationId;\n   194\t  }\n   195\t\n   196\t  /** Applies one inbox event. Resolves when it is durably handed over; throws PermanentError if it never can be. */\n   197\t  async apply(event: InboxEvent, session: SessionRow): Promise<void> {\n   198\t    if (session.status === \"deleted\") throw new PermanentError(\"session is deleted\");\n   199\t    switch (event.kind) {\n   200\t      case \"message\":\n   201\t      case \"steer\": {\n   202\t        const text = event.payload.text;\n   203\t        if (typeof text !== \"string\" || text === \"\") throw new PermanentError(\"event has no text\");\n   204\t        if (session.status === \"failed\") {\n   205\t          // Retries an abort that failed when the session was failed (see #failSession); throws, and so retries the\n   206\t          // row, if the abort fails again.\n   207\t          if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n   208\t          throw new PermanentError(\"session has failed\");\n   209\t        }\n   210\t        const conversationId = await this.ensureConversation(session);\n   211\t        await this.#withinBudget(session, conversationId);\n   212\t        // Before the first turn: OneCLI agent, token and clone. A session without a repo skips all of it.\n   213\t        if (session.repo !== null) await this.#prepareRepo(session, conversationId);\n   214\t        const requestId = event.id;\n   215\t        const faultArmed =\n   216\t          this.#options.testFaults && event.payload.testFault === \"exit-after-submit\";\n   217\t        const alreadyAdmitted =\n   218\t          faultArmed && (await this.#host.hasSubmission(conversationId, requestId));\n   219\t        await this.#host.submitInput(conversationId, {\n   220\t          text,\n   221\t          requestId,\n   222\t          steer: event.kind === \"steer\",\n   223\t        });\n   224\t        this.#watcher.add({ sessionId: session.id, conversationId, requestId });\n   225\t        if (faultArmed && !alreadyAdmitted) {\n   276\t   * Turns are model responses, counted from the stored transcript, so a restart does not reset the count.\n   277\t   */\n   278\t  async #withinBudget(session: SessionRow, conversationId: number): Promise<void> {\n   279\t    const used = await this.#host.turnsUsed(conversationId);\n   280\t    const left = this.#options.turnBudget - used;\n   281\t    if (left <= 0) {\n   282\t      const failure = terminalFailure({ reason: \"turn_limit\" });\n   283\t      await this.#failSession(session.id, conversationId, failure ?? \"turn budget exhausted\");\n   284\t      throw new PermanentError(\"turn budget exhausted\");\n   285\t    }\n   286\t    await this.#host.limitTurns(conversationId, left);\n   287\t  }\n   288\t\n   289\t  /**\n   290\t   * Stop the session, delete the SandboxClaim and PVC, mark the session deleted. The conversation's stored state\n   291\t   * stays: the Postgres adapter can only delete it in a maintenance window (docs/session-api.md).\n   292\t   */\n   293\t  async #delete(session: SessionRow): Promise<void> {\n   294\t    log(\"session-delete-start\", { session: session.id });\n   295\t    // Record what the session holds before anything is revoked, then revoke its OneCLI agent first: from that moment\n   296\t    // its proxy token is dead, whatever happens to the claim after. A plain session has no OneCLI objects.\n   297\t    await writeTombstone(this.#pool, session);\n   298\t    await this.#options.repos?.teardown(session);\n   299\t    const conversationId = session.conversationId;\n   300\t    if (conversationId !== null) {\n   301\t      await this.#host.abort(conversationId);\n   302\t      this.streams.closeSession(session.id, \"deleted\");\n   303\t      await this.#host.destroySandbox(conversationId);\n   304\t    }\n   305\t    await this.#pool.query(\n   306\t      \"update inbox.sessions set status = 'deleted', last_activity_at = clock_timestamp() where id = $1\",\n   307\t      [session.id],\n   308\t    );\n   309\t    await completeTombstone(this.#pool, session.id);\n   310\t    log(\"session-deleted\", { session: session.id });\n   311\t  }\n   312\t}\n","isError":false}]}
ENTRY 11267 {"id":11267,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && sed -n '200,270p' packages/orchestrator/src/host.ts; grep -R -n 'tombstones\\\\|completed_at' packages | head -65; cat packages/orchestrator/src/failure.ts; nl -ba packages/orchestrator/src/sessions.ts | sed -n '130,165p'\"})"]}]}
ENTRY 11273 {"id":11273,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"\n  /** The reasoning effort a conversation runs with, as Pi Durable resolved it (`off` when none was stored). */\n  async thinkingOf(id: number): Promise<string> {\n    return (await (await this.#conversation(id)).agent(context)).thinkingLevel;\n  }\n\n  /** Model turns (assistant responses) in the conversation's transcript so far. */\n  async turnsUsed(id: number): Promise<number> {\n    const conversation = await this.#conversation(id);\n    let turns = 0;\n    let cursor: Cursor | undefined;\n    do {\n      const page = await conversation.entries({ order: \"ascending\" }, 200, cursor, context);\n      turns += page.items.filter((entry) => entry.kind === \"pi.assistant\").length;\n      cursor = page.next;\n    } while (cursor !== undefined);\n    return turns;\n  }\n\n  /** Caps the tool rounds of any run of this conversation, so one run cannot overshoot the session's turn budget. */\n  async limitTurns(id: number, maxTurns: number): Promise<void> {\n    await (await this.#conversation(id)).configure({ maxTurns }, context);\n  }\n\n  /** The stored state of a submission, for the run watcher. */\n  async submissionState(id: number, requestId: string): Promise<SubmissionState | undefined> {\n    return this.#storage.submissionByRequest(id as ConversationId, requestId, context);\n  }\n\n  /**\n   * Durably admits one inbox event. `requestId` is the inbox row id, so a resubmission after a crash returns the\n   * original submission instead of adding a second turn. A message queues behind a running turn (follow-up); a\n   * steer joins the running turn after its current tool round, and starts a turn when the session is idle.\n   */\n  async submitInput(\n    id: number,\n    input: { text: string; requestId: string; steer: boolean },\n  ): Promise<void> {\n    const conversation = await this.#conversation(id);\n    await conversation.submit(\n      {\n        type: \"input\",\n        content: input.text,\n        requestId: input.requestId,\n        whenBusy: input.steer ? \"steer\" : \"followUp\",\n      },\n      context,\n    );\n  }\n\n  async hasSubmission(id: number, requestId: string): Promise<boolean> {\n    // A read on the Storage: the Harness has no lookup by request id. Only the test-fault gate uses it.\n    const record = await this.#storage.submissionByRequest(\n      id as ConversationId,\n      requestId,\n      context,\n    );\n    return record !== undefined;\n  }\n\n  /** Withdraws queued inputs, aborts the running turn and resolves once the conversation is idle. */\n  async abort(id: number): Promise<void> {\n    await (await this.#conversation(id)).abort(context);\n  }\n\n  /** The conversation and a watch of its structural view (a window over the transcript plus live state). */\n  async watch(\n    id: number,\n    window?: ConversationWindow,\n  ): Promise<{ conversation: Conversation; watch: ConversationWatch } | undefined> {\n    const conversation = await this.#harness.conversation(id as ConversationId, context);\npackages/orchestrator/test/delete-repo.test.ts:56:      if (sql.includes(\"inbox.tombstones\") && sql.includes(\"insert\")) order.push(\"tombstone\");\npackages/session-core/src/store.ts:322:    `insert into inbox.tombstones (session_id, conversation_id, repo, onecli_agent_id, onecli_secret_ids)\npackages/session-core/src/store.ts:340:    \"update inbox.tombstones set completed_at = coalesce(completed_at, clock_timestamp()) where session_id = $1\",\npackages/session-core/migrations/004_repo.sql:15:create table if not exists inbox.tombstones (\npackages/session-core/migrations/004_repo.sql:22:  completed_at      timestamptz\n/** What a run that ended without an answer means for the session (Pi Durable `RunFailure`, plus the text of the error). */\nexport interface RunOutcome {\n  reason: string;\n  detail?: string;\n}\n\n/**\n * Model-side signs that the credentials are not accepted: an HTTP status of 401 or 403 from the provider (a missing\n * or revoked key, a revoked OneCLI grant leaves the gateway injecting nothing), 407 from the gateway itself (the\n * agent token was deleted or regenerated), the gateway's own answer when the agent has no grant for the host (a 401\n * whose JSON body, which is all pi-ai keeps, reads `access_restricted` / `this agent does not have access`), or the\n * usual wording. Status codes must stand alone, so a request id or a\n * byte count that happens to contain 401 does not match.\n */\nconst REJECTED =\n  /(?<![a-z0-9])(?:401|403|407)(?![a-z0-9])|unauthori[sz]ed|forbidden|invalid[ _-]?api[ _-]?key|incorrect api key|proxy authentication|authentication[ _-]?(?:error|failed)|permission[ _-]?denied|access_restricted|does not have access/i;\n\n/**\n * The terminal failure a run outcome maps to, or undefined when the session stays usable.\n *  - A model error that reads as rejected credentials is terminal: nothing in the orchestrator can fix a grant, and\n *    retrying only repeats paid or rate-limited calls. (pi-ai does not retry these statuses either.)\n *  - `turn_limit` is the per-session turn budget (`maxTurns`).\n *  - Everything else (a 429 that outlasted the retries, a network error, an abort) leaves the session active: the\n *    next message starts a new run.\n */\nexport function terminalFailure(outcome: RunOutcome): string | undefined {\n  if (outcome.reason === \"turn_limit\") {\n    return \"turn budget exhausted: the session used all the model turns it is allowed\";\n  }\n  if (outcome.reason === \"model_error\" && REJECTED.test(outcome.detail ?? \"\")) {\n    return \"model credentials were rejected (401/403): the OneCLI agent token or its grant for this provider is missing or revoked\";\n  }\n  return undefined;\n}\n   130\t    );\n   131\t    for (const row of rows) {\n   132\t      try {\n   133\t        await this.#host.abort(Number(row.conversation_id));\n   134\t      } catch (error) {\n   135\t        log(\"failed-session-abort-failed\", { session: row.id, message: errorMessage(error) });\n   136\t      }\n   137\t    }\n   138\t  }\n   139\t\n   140\t  /**\n   141\t   * A submission ended without an answer. Rejected model credentials and a used-up turn budget end the session\n   142\t   * for good (`failed`); anything else leaves it active. The stored message is ours, never the provider's text.\n   143\t   */\n   144\t  async #runEnded(watched: Watched, outcome: RunOutcome): Promise<void> {\n   145\t    const failure = terminalFailure(outcome);\n   146\t    if (failure === undefined) return;\n   147\t    await this.#failSession(watched.sessionId, watched.conversationId, failure);\n   148\t  }\n   149\t\n   150\t  async #failSession(\n   151\t    sessionId: string,\n   152\t    conversationId: number | null,\n   153\t    failure: string,\n   154\t  ): Promise<void> {\n   155\t    const changed = await failSession(this.#pool, sessionId, failure);\n   156\t    if (changed) {\n   157\t      log(\"session-failed\", { session: sessionId, failure });\n   158\t    } else if ((await getSession(this.#pool, sessionId))?.status !== \"failed\") {\n   159\t      return;\n   160\t    }\n   161\t    // Withdraw whatever queued behind the failed run, so nothing more is sent to the provider. Also when the session\n   162\t    // was failed already: the status commits before the abort, so a caller whose abort died (or whose process did)\n   163\t    // retries here and must not find \"nothing changed\" and stop. A deleting or deleted session is not ours to abort.\n   164\t    if (conversationId !== null) await this.#host.abort(conversationId);\n   165\t  }\n","isError":false}]}
ENTRY 11352 {"id":11352,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n\n### 1. A terminal failure can race with a new submission\n\n- Severity: high\n- Confidence: high\n- Location: packages/orchestrator/src/sessions.ts:204\n- What happens: An inbox row can read an active session, then pause while the watcher marks that session failed and aborts its conversation. The row resumes and submits its input after the abort, allowing another provider call in a terminally failed session.\n- Evidence: `if (session.status === \"failed\")` is checked before the asynchronous budget and repository preparation calls, followed by `await this.#host.submitInput(...)`.\n- Fix idea: Serialize terminal failure and submission per session, and verify the current session state within that coordination before admitting an input.\n\n### 2. Retrying an admitted input can fail it at the budget check\n\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/sessions.ts:210\n- What happens: If the process dies after handing an input to Pi Durable but before marking its inbox row submitted, the input can consume the remaining budget. On restart, its retry fails the budget check before reaching the idempotent submission, so an input that was already processed is recorded as failed.\n- Evidence: `await this.#withinBudget(session, conversationId)` runs before `submitInput`; the existing submission lookup is gated by `faultArmed`.\n- Fix idea: Check whether the request ID was already admitted before applying admission-time budget and repository checks. Restore its watch and treat it as handed over if it exists.\n\n### 3. Conversation creation can race with deletion\n\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/sessions.ts:182\n- What happens: A stream request can begin creating a conversation while deletion reads a session with no conversation ID. Deletion then skips stream closure and sandbox cleanup, while creation can attach a conversation to the already-deleted session. The stream can remain open after deletion.\n- Evidence: Creation updates `conversation_id` with only `where id = $2 and conversation_id is null`; deletion performs conversation cleanup only when its snapshot’s `conversationId !== null`.\n- Fix idea: Coordinate creation with deletion, conditionally attach only to a session still eligible for creation, and close streams even when the deletion snapshot has no conversation.\n\n### 4. A crash can leave a completed deletion permanently incomplete\n\n- Severity: low\n- Confidence: high\n- Location: packages/orchestrator/src/sessions.ts:305\n- What happens: If the process crashes or `completeTombstone` fails after the session is marked deleted, the delete row is retried. The retry is rejected because the session is already deleted, leaving the tombstone incomplete and the delete event marked failed despite cleanup having run.\n- Evidence: The status update precedes `await completeTombstone(...)`, while `apply` immediately throws `PermanentError` for a deleted session.\n- Fix idea: Make the final status and tombstone updates atomic, or allow a delete retry for an already-deleted session to complete the tombstone successfully.\n\nEND-OF-REPORT"}]}
