ENTRY 12086 {"id":12086,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\t#!/usr/bin/env bash\n     2\t# Phase 4c acceptance tests: the optional repository workspace through OneCLI and a repo-scoped GitHub App token.\n     3\t# Runs IN the cluster as the e2e-driver Job started by `tests/e2e/run.sh phase4c`. WRITTEN, NOT YET RUN: it needs the new\n     4\t# sandbox image (git + ca-certificates) in the SandboxTemplate, the ExternalSecrets pi-github-app and pi-onecli-admin\n     5\t# synced, the OneCLI CA ConfigMap, and the NetworkPolicies that let the orchestrator reach api.github.com.\n     6\t#\n     7\t#   no-repo       a session without a repo is unchanged: no repo columns, no OneCLI agent or secret, no repo directory\n     8\t#   clone-push    REPO_A (private): cloned before the first turn, the OneCLI agent holds exactly the session's two GitHub\n     9\t#                 secrets (no LLM key, no connection), a push to a test branch works and the branch is removed again,\n    10\t#                 and no GitHub token is readable in the sandbox\n    11\t#   restart-skip  after an orchestrator restart the clone is found and skipped (log `workspace-present`, no\n    12\t#                 `workspace-cloned`), and a file the agent wrote in the clone is still there\n    13\t#   scope         the token for REPO_A cannot read REPO_B (a private repo of the same installation)\n    14\t#   delete        after DELETE the OneCLI agent and both secrets are gone and the tombstone is completed\n    15\t#\n    16\t# REPO_A and REPO_B (owner/name) are required for the last four; without them those tests are SKIPPED, never faked.\n    17\t# ONLY=\"no-repo,clone-push\" runs just those tests. clone-push creates the shared repo session; the later tests reuse\n    18\t# it, so run them together (restart-skip, scope and delete SKIP when it does not exist).\n    19\t#\n    20\t# All OneCLI API calls run inside the orchestrator pod (`kubectl exec ... node`), which already holds ONECLI_API_KEY:\n    21\t# no key or token is read, passed or printed here. Exit code: 0 when no test failed (SKIPPED is not a failure).\n    22\tset -euo pipefail\n    23\t\n    24\tctx=${KUBE_CONTEXT:-}\n    25\tns=${NAMESPACE:-pi-durable-poc}\n    26\there=$(cd \"$(dirname \"$0\")\" && pwd)\n    27\twork=$(mktemp -d)\n    28\tsessions_file=$work/sessions\n    29\trepo_session_file=$work/repo-session\n    30\t: >\"$sessions_file\"\n    31\trun_id=$(date +%s)\n    32\tbranch=\"pi-e2e-$run_id\"\n    33\t\n    34\tk() { kubectl ${ctx:+--context=\"$ctx\"} -n \"$ns\" \"$@\"; }\n    35\tlog() { printf '\\n== %s\\n' \"$*\"; }\n    36\tnote() { printf '   %s\\n' \"$*\"; }\n    37\tnow() { date +%s; }\n    38\t\n    39\tingest_pod() {\n    40\t  k get pods -l app.kubernetes.io/name=pi-ingest -o json |\n    41\t    jq -r '[.items[] | select(.status.phase==\"Running\" and .metadata.deletionTimestamp==null)][0].metadata.name // empty'\n    42\t}\n    43\tapi() { k exec -i \"$(ingest_pod)\" -c ingest -- node - call \"$@\" <\"$here/client-4b.mjs\"; }\n    44\tstream_has() { k exec -i \"$(ingest_pod)\" -c ingest -- node - stream \"$@\" <\"$here/client-4b.mjs\"; }\n    45\tanswer_has() { k exec -i \"$(ingest_pod)\" -c ingest -- node - answer \"$@\" <\"$here/client-4b.mjs\" | cut -d\" \" -f1; }\n    46\tsql() { k exec pi-pg-1 -c postgres -- psql -U postgres -d app -At -v ON_ERROR_STOP=1 -c \"$1\"; }\n    47\torch_log() { k logs deploy/pi-orchestrator --tail=2000; }\n    48\t\n    49\t# OneCLI management API through the orchestrator pod, which holds the key. Prints the response body.\n    50\tonecli() { # METHOD PATH\n    51\t  k exec deploy/pi-orchestrator -c orchestrator -- node -e '\n    52\t    const [method, path] = process.argv.slice(1);\n    53\t    fetch((process.env.PI_ONECLI_API ?? \"http://onecli.onecli:10256\") + path, {\n    54\t      method, headers: { authorization: `Bearer ${process.env.ONECLI_API_KEY}` } })\n    55\t      .then(async (r) => { process.stdout.write(await r.text() || \"[]\"); })\n    56\t      .catch((e) => { console.error(e.message); process.exit(1); });' \"$1\" \"$2\"\n    57\t}\n    58\t\n    59\tcleanup() {\n    60\t  local id\n    61\t  while read -r id; do\n    62\t    [[ -n $id ]] || continue\n    63\t    api alice DELETE \"/sessions/$id\" >/dev/null 2>&1 || true\n    64\t  done <\"$sessions_file\"\n    65\t  # Wait until every session is `deleted` (bounded), so the claims and OneCLI objects are gone when the run ends.\n    66\t  # A failed query is not \"nothing left\": it is retried until the deadline.\n    67\t  local list deadline pending drained=0\n    68\t  list=$(grep -v '^$' \"$sessions_file\" | sed \"s/.*/'&'/\" | paste -sd, -)\n    69\t  deadline=$(($(now) + 180))\n    70\t  while [[ -n $list && $(now) -lt $deadline ]]; do\n    71\t    if pending=$(sql \"select id from inbox.sessions where status <> 'deleted' and id in ($list)\" 2>/dev/null) && [[ -z $pending ]]; then\n    72\t      drained=1\n    73\t      break\n    74\t    fi\n    75\t    sleep 3\n    76\t  done\n    77\t  [[ -z $list || $drained -eq 1 ]] || note \"cleanup: sessions not deleted after the wait (or status unreadable); their claims may remain\"\n    78\t  rm -rf \"$work\"\n    79\t}\n    80\ttrap cleanup EXIT\n    81\t\n    82\tassert_eq() { # description expected actual\n    83\t  if [[ $2 == \"$3\" ]]; then note \"ok: $1\"; else\n    84\t    note \"ASSERT FAILED: $1\"\n    85\t    note \"  expected: $2\"\n    86\t    note \"  got: $3\"\n    87\t    exit 1\n    88\t  fi\n    89\t}\n    90\tassert_jq() { # description json jq-expression\n    91\t  if jq -e \"$3\" <<<\"$2\" >/dev/null 2>&1; then note \"ok: $1\"; else\n    92\t    note \"ASSERT FAILED: $1\"\n    93\t    note \"  expected: $3\"\n    94\t    note \"  got: $(printf '%s' \"$2\" | cut -c1-500)\"\n    95\t    exit 1\n    96\t  fi\n    97\t}\n    98\twait_status() { # owner session wanted-status timeout-seconds\n    99\t  local deadline=$(($(now) + $4)) out\n   100\t  while :; do\n   101\t    out=$(api \"$1\" GET \"/sessions/$2\")\n   102\t    if [[ $(jq -r '.body.status // empty' <<<\"$out\") == \"$3\" ]]; then\n   103\t      printf '%s' \"$out\"\n   104\t      return 0\n   105\t    fi\n   106\t    if [[ $(now) -ge $deadline ]]; then\n   107\t      note \"TIMEOUT after $4s waiting for session $2 to be $3\"\n   108\t      return 1\n   109\t    fi\n   110\t    sleep 2\n   111\t  done\n   112\t}\n   113\tscript() { # final cmd... -> the scripted model's input: one bash step per command\n   114\t  local final=$1 steps='[]' cmd\n   115\t  shift\n   116\t  for cmd in \"$@\"; do steps=$(jq -c --arg b \"$cmd\" '. + [{bash:$b, timeout:300}]' <<<\"$steps\"); done\n   117\t  jq -nc --argjson s \"$steps\" --arg f \"$final\" '{steps:$s, final:$f}'\n   118\t}\n   119\tsend() { # session final cmd... -> posts the script as a message\n   120\t  local id=$1\n   121\t  shift\n   122\t  api alice POST \"/sessions/$id/events\" \"$(jq -nc --arg t \"$(script \"$@\")\" '{kind:\"message\", text:$t}')\" >/dev/null\n   123\t}\n   124\t# stream_has searches the whole stream, the user's message included. Needles inside commands are split with '' (kept\n   125\t# by the outer double quotes, removed by the sandbox's bash), so only tool output contains them. Final answers are\n   126\t# in the message too, so wait for them with answer_has (assistant text after a tool call).\n   127\tneed_repos() {\n   128\t  if [[ -z ${REPO_A:-} || -z ${REPO_B:-} ]]; then\n   129\t    note \"SKIPPED: set REPO_A and REPO_B (owner/name, private, in the GitHub App installation) to run this test\"\n   130\t    return 3\n   131\t  fi\n   132\t}\n   133\tneed_repo_session() {\n   134\t  need_repos || return 3\n   135\t  if [[ ! -s $repo_session_file ]]; then\n   136\t    note \"SKIPPED: the shared repo session does not exist (run clone-push first)\"\n   137\t    return 3\n   138\t  fi\n   139\t  repo_session=$(cat \"$repo_session_file\")\n   140\t}\n   141\trepo_session=\"\"\n   142\t\n   143\t# ---------------------------------------------------------------- tests\n   144\tt_no_repo() {\n   145\t  local out id\n   146\t  out=$(api alice POST /sessions '{\"provider\":\"scripted\",\"model\":\"scripted-1\"}')\n   147\t  assert_jq \"session created\" \"$out\" '.status==201 and (.body|has(\"repo\")|not)'\n   148\t  id=$(jq -r .body.sessionId <<<\"$out\")\n   149\t  echo \"$id\" >>\"$sessions_file\"\n   150\t  send \"$id\" plain-done \"pwd\" \"ls -A /workspace | wc -l\"\n   151\t  assert_eq \"the session answers\" found \"$(stream_has alice \"$id\" plain-done 90)\"\n   152\t  assert_eq \"no repo columns, no OneCLI ids, no ready marker\" \"||\" \"$(sql \"select coalesce(repo,'')||'|'||coalesce(onecli_agent_id,'')||'|'||coalesce(workspace_ready_at::text,'') from inbox.sessions where id='$id'\")\"\n   153\t  assert_eq \"no OneCLI agent exists for it\" 0 \"$(onecli GET /v1/agents | jq --arg n \"pi-session-$id\" '[.. | objects | select(.identifier? == $n)] | length')\"\n   154\t  assert_eq \"no OneCLI secret exists for it\" 0 \"$(onecli GET /v1/secrets | jq --arg n \"pi-session-$id\" '[.. | objects | select((.name? // \"\") | startswith($n))] | length')\"\n   155\t  out=$(api alice POST /sessions '{\"repo\":\"https://github.com/a/b\"}')\n   156\t  assert_jq \"a URL is refused\" \"$out\" '.status==400'\n   157\t  out=$(api alice POST /sessions '{\"repo\":\"a/b\",\"branch\":\"--upload-pack=x\"}')\n   158\t  assert_jq \"an option-like branch is refused\" \"$out\" '.status==400'\n   159\t  out=$(api alice POST /sessions '{\"repo\":\"a/../b\"}')\n   160\t  assert_jq \"a traversal is refused\" \"$out\" '.status==400'\n   161\t}\n   162\t\n   163\tt_clone_push() {\n   164\t  local out id sid agent_id grants names\n   165\t  need_repos || return 3\n   166\t  out=$(api alice POST /sessions \"$(jq -nc --arg r \"$REPO_A\" '{provider:\"scripted\", model:\"scripted-1\", repo:$r}')\")\n   167\t  assert_jq \"repo session created\" \"$out\" '.status==201 and .body.repo!=null'\n   168\t  id=$(jq -r .body.sessionId <<<\"$out\")\n   169\t  echo \"$id\" >>\"$sessions_file\"\n   170\t  echo \"$id\" >\"$repo_session_file\"\n   171\t  sid=$id\n   172\t  # Everything in one script: clone present, sentinel for the restart test, token checks, push, ls-remote, remove branch.\n   173\t  send \"$id\" clone-push-finished \\\n   174\t    \"test -d /workspace/repo/.git && echo CLONE_O''K\" \\\n   175\t    \"test -f /workspace/.pi-workspace.json && echo MARKER_O''K\" \\\n   176\t    \"echo sentinel >/workspace/repo/.e2e-sentinel\" \\\n   177\t    \"env | grep -c -E 'ghs_|github_pat_' || true\" \\\n   178\t    \"grep -r -c -E 'ghs_|github_pat_' /workspace/repo/.git/config /workspace/.onecli || true\" \\\n   179\t    \"cd /workspace/repo && git checkout -q -b $branch && date >e2e-$run_id.txt && git add e2e-$run_id.txt && git commit -q -m 'e2e $run_id' && git push -q origin HEAD:refs/heads/$branch && echo PUSH_O''K\" \\\n   180\t    \"cd /workspace/repo && git ls-remote origin refs/heads/$branch | wc -l\" \\\n   181\t    \"cd /workspace/repo && git push -q origin --delete $branch && echo BRANCH_REMO''VED\"\n   182\t  assert_eq \"the session ran its script\" found \"$(answer_has alice \"$id\" clone-push-finished 240)\"\n   183\t  for needle in CLONE_OK MARKER_OK PUSH_OK BRANCH_REMOVED; do\n   184\t    assert_eq \"tool output has $needle\" found \"$(stream_has alice \"$id\" \"$needle\" 20)\"\n   185\t  done\n   186\t  assert_jq \"the session is still active\" \"$(api alice GET \"/sessions/$id\")\" '.body.status==\"active\"'\n   187\t  assert_eq \"the clone is recorded as ready\" t \"$(sql \"select (workspace_ready_at is not null) from inbox.sessions where id='$id'\" | tr -d ' ')\"\n   188\t  assert_eq \"the orchestrator logged one clone\" 1 \"$(orch_log | grep -c \"\\\"event\\\":\\\"workspace-cloned\\\".*$id\")\"\n   189\t\n   190\t  agent_id=$(sql \"select onecli_agent_id from inbox.sessions where id='$id'\")\n   191\t  [[ -n $agent_id ]] || {\n   192\t    note \"ASSERT FAILED: no OneCLI agent id stored\"\n   193\t    exit 1\n   194\t  }\n   195\t  grants=$(onecli GET \"/v1/agents/$agent_id/grants\")\n   196\t  note \"grants shape (ids only): $(jq -c '[.. | objects | keys] | add | unique' <<<\"$grants\" 2>/dev/null || echo unreadable)\"\n   197\t  names=$(onecli GET /v1/secrets | jq -r --arg n \"pi-session-$sid\" '[.. | objects | select((.name? // \"\") | startswith($n)) | .name] | sort | join(\",\")')\n   198\t  assert_eq \"exactly this session's two GitHub secrets exist\" \"pi-session-$sid-api,pi-session-$sid-git\" \"$names\"\n   199\t  # Narrow grants: the count of every id in the answer is 2 (the two secrets) and no connection appears.\n   200\t  assert_eq \"the agent holds exactly two grants and no connection\" 2 \"$(jq '[.. | objects | select(has(\"id\") or has(\"secretId\") or has(\"connectionId\"))] | length' <<<\"$grants\")\"\n   201\t  assert_jq \"no LLM secret is granted\" \"$grants\" '([.. | strings | select(test(\"Codex|OpenRouter|openai|anthropic\";\"i\"))] | length) == 0'\n   202\t  # UNVERIFIED: whether the effective view of the gateway matches. A model-host request through this agent's token\n   203\t  # should get 401 access_restricted (docs/model-credentials.md); not automated because the sandbox has no curl.\n   204\t  if orch_log | grep -q -E 'ghs_|aoc_|oc_[0-9a-f]{8}'; then\n   205\t    note \"ASSERT FAILED: the orchestrator log holds something shaped like a GitHub token or OneCLI key\"\n   206\t    exit 1\n   207\t  fi\n   208\t  note \"ok: no token-shaped text in the orchestrator log\"\n   209\t}\n   210\t\n   211\tt_restart_skip() {\n   212\t  need_repo_session || return 3\n   213\t  # Scale 0 -> 1 rather than rollout restart: the driver may scale but not patch Deployments.\n   214\t  k scale deploy/pi-orchestrator --replicas=0 >/dev/null\n   215\t  k wait --for=delete pod -l app.kubernetes.io/instance=pi-orchestrator --timeout=120s >/dev/null 2>&1 || true\n   216\t  k scale deploy/pi-orchestrator --replicas=1 >/dev/null\n   217\t  k rollout status deploy/pi-orchestrator --timeout=300s >/dev/null\n   218\t  # The first input after the restart prepares the workspace again: provision, re-mint, find the clone.\n   219\t  send \"$repo_session\" after-restart \"grep -qx sentinel /workspace/repo/.e2e-sentinel && echo SENTINEL_O''K\" \"git -C /workspace/repo rev-parse --is-inside-work-tree\"\n   220\t  assert_eq \"the session answers after the restart\" found \"$(answer_has alice \"$repo_session\" after-restart 240)\"\n   221\t  assert_eq \"the sentinel written before the restart is still there\" found \"$(stream_has alice \"$repo_session\" SENTINEL_OK 20)\"\n   222\t  assert_eq \"the clone was found and skipped\" 1 \"$(orch_log | grep -c \"\\\"event\\\":\\\"workspace-present\\\".*$repo_session\")\"\n   223\t  assert_eq \"no second clone after the restart\" 0 \"$(orch_log | grep -c \"\\\"event\\\":\\\"workspace-cloned\\\".*$repo_session\" || true)\"\n   224\t  assert_eq \"still exactly one OneCLI agent for the session\" 1 \"$(onecli GET /v1/agents | jq --arg n \"pi-session-$repo_session\" '[.. | objects | select(.identifier? == $n)] | length')\"\n   225\t}\n   226\t\n   227\tt_scope() {\n   228\t  need_repo_session || return 3\n   229\t  send \"$repo_session\" scope-finished \\\n   230\t    \"cd /workspace/repo && git push --dry-run https://github.com/$REPO_B.git HEAD:refs/heads/e2e-scope-$run_id >/dev/null 2>&1 && echo B_REACH''ABLE || echo B_DEN''IED\" \\\n   231\t    \"cd /workspace/repo && git push --dry-run https://github.com/$REPO_A.git HEAD:refs/heads/e2e-scope-$run_id >/dev/null 2>&1 && echo A_REACH''ABLE || echo A_DEN''IED\"\n   232\t  assert_eq \"the scope script ran\" found \"$(answer_has alice \"$repo_session\" scope-finished 180)\"\n   233\t  assert_eq \"repo A accepts a push with its token (dry run)\" found \"$(stream_has alice \"$repo_session\" A_REACHABLE 20)\"\n   234\t  assert_eq \"repo B refuses a push with A's token (dry run)\" found \"$(stream_has alice \"$repo_session\" B_DENIED 20)\"\n   235\t  assert_eq \"repo B never answered as reachable\" timeout \"$(stream_has alice \"$repo_session\" B_REACHABLE 5)\"\n   236\t  # NOT covered here (needs a second pod): \"rejected from another pod's IP\". OneCLI v2 has no source binding.\n   237\t}\n   238\t\n   239\tt_delete() {\n   240\t  local agent_id\n   241\t  need_repo_session || return 3\n   242\t  agent_id=$(sql \"select onecli_agent_id from inbox.sessions where id='$repo_session'\")\n   243\t  assert_jq \"DELETE is accepted\" \"$(api alice DELETE \"/sessions/$repo_session\")\" '.status==202'\n   244\t  wait_status alice \"$repo_session\" deleted 120 >/dev/null || exit 1\n   245\t  assert_eq \"the OneCLI agent is gone\" 0 \"$(onecli GET /v1/agents | jq --arg n \"pi-session-$repo_session\" '[.. | objects | select(.identifier? == $n)] | length')\"\n   246\t  assert_eq \"its secrets are gone\" 0 \"$(onecli GET /v1/secrets | jq --arg n \"pi-session-$repo_session\" '[.. | objects | select((.name? // \"\") | startswith($n))] | length')\"\n   247\t  assert_eq \"the old agent id no longer has grants\" 0 \"$(onecli GET \"/v1/agents/$agent_id/grants\" | jq '[.. | objects | select(has(\"id\"))] | length' 2>/dev/null || echo 0)\"\n   248\t  assert_eq \"the tombstone was written first and completed\" t \"$(sql \"select (completed_at is not null) from inbox.tombstones where session_id='$repo_session'\" | tr -d ' ')\"\n   249\t  assert_eq \"the claim is gone\" 0 \"$(k get sandboxclaims -l \"pi-durable-k8s/session-id=$repo_session\" -o name | wc -l | tr -d ' ')\"\n   250\t  : >\"$repo_session_file\"\n   251\t}\n   252\t\n   253\t# ---------------------------------------------------------------- driver\n   254\tpass=0 fail=0 skip=0\n   255\tsummary=()\n   256\trun() { # name function\n   257\t  local name=$1 rc\n   258\t  [[ -z ${ONLY:-} || \",$ONLY,\" == *\",$name,\"* ]] || return 0\n   259\t  log \"$name\"\n   260\t  set +e\n   261\t  (\n   262\t    set -eE\n   263\t    trap 'note \"ERROR: command failed at line $LINENO (exit $?): $BASH_COMMAND\"' ERR\n   264\t    \"$2\"\n   265\t  )\n   266\t  rc=$?\n   267\t  set -e\n   268\t  case $rc in\n   269\t    0)\n   270\t      pass=$((pass + 1))\n   271\t      summary+=(\"PASS  $name\")\n   272\t      ;;\n   273\t    3)\n   274\t      skip=$((skip + 1))\n   275\t      summary+=(\"SKIP  $name\")\n   276\t      ;;\n   277\t    *)\n   278\t      fail=$((fail + 1))\n   279\t      summary+=(\"FAIL  $name\")\n   280\t      ;;\n   281\t  esac\n   282\t}\n   283\t\n   284\trun no-repo t_no_repo\n   285\trun clone-push t_clone_push\n   286\trun restart-skip t_restart_skip\n   287\trun scope t_scope\n   288\trun delete t_delete\n   289\t\n   290\tlog \"summary\"\n   291\tfor line in \"${summary[@]}\"; do note \"$line\"; done\n   292\tnote \"passed=$pass failed=$fail skipped=$skip\"\n   293\tlog \"RESULT\"\n   294\tprintf '%s\\n' \"${summary[@]}\"\n   295\tif [[ $fail -ne 0 ]]; then\n   296\t  echo \"PHASE 4C: FAILED\" >&2\n   297\t  exit 1\n   298\tfi\n   299\techo \"PHASE 4C: all tests passed\"\n","isError":false}]}
