ENTRY 12163 {"id":12163,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"/** A model a session runs on: a Pi provider id and a model id within it. */\nexport interface ModelChoice {\n  provider: string;\n  model: string;\n  /** Reasoning effort (Pi's `thinkingLevel`); unset leaves it to Pi's default, `off`. */\n  reasoning?: ThinkingLevel;\n}\n\nexport const THINKING_LEVELS = [\"off\", \"minimal\", \"low\", \"medium\", \"high\", \"xhigh\"] as const;\nexport type ThinkingLevel = (typeof THINKING_LEVELS)[number];\n\n/** `provider/model`. The model id may itself contain slashes (`openrouter/openai/gpt-4.1-nano`). */\nexport function modelKey(choice: ModelChoice): string {\n  return `${choice.provider}/${choice.model}`;\n}\n\n/** Parses one `provider/model` pair. Throws for anything else, naming the entry. */\nexport function parseModelKey(entry: string): ModelChoice {\n  const slash = entry.indexOf(\"/\");\n  const provider = entry.slice(0, slash);\n  const model = entry.slice(slash + 1);\n  if (slash <= 0 || model === \"\" || /\\s/.test(entry)) {\n    throw new Error(`model allowlist entry \"${entry}\" is not provider/model`);\n  }\n  return { provider, model };\n}\n\n/** `PI_MODEL_ALLOWLIST`: comma- or newline-separated `provider/model` pairs. */\nexport function parseAllowlist(spec: string): ModelChoice[] {\n  return spec\n    .split(/[,\\n]/)\n    .map((entry) => entry.trim())\n    .filter((entry) => entry !== \"\")\n    .map(parseModelKey);\n}\n\nexport const DEFAULT_MODEL: ModelChoice = { provider: \"scripted\", model: \"scripted-1\" };\nexport const DEFAULT_ALLOWLIST = \"scripted/scripted-1,scripted/scripted-2\";\n\nexport interface ModelPolicy {\n  default: ModelChoice;\n  /** The default is always allowed, so a session without a model field cannot be refused. */\n  allowed: readonly ModelChoice[];\n  /** `PI_MODEL_REASONING`, applied to every new session; unset for none. */\n  reasoning?: ThinkingLevel;\n}\n\nexport function loadModelPolicy(env: Readonly<Record<string, string | undefined>>): ModelPolicy {\n  const reasoning = parseReasoning(env.PI_MODEL_REASONING);\n  const defaultChoice: ModelChoice = {\n    ...parseModelKey(\n      `${env.PI_MODEL_PROVIDER ?? DEFAULT_MODEL.provider}/${env.PI_MODEL_ID ?? DEFAULT_MODEL.model}`,\n    ),\n    ...(reasoning === undefined ? {} : { reasoning }),\n  };\n  const listed = parseAllowlist(env.PI_MODEL_ALLOWLIST ?? DEFAULT_ALLOWLIST);\n  const seen = new Set<string>();\n  const allowed = [defaultChoice, ...listed].filter((choice) => {\n    const key = modelKey(choice);\n    if (seen.has(key)) return false;\n    seen.add(key);\n    return true;\n  });\n  return { default: defaultChoice, allowed, ...(reasoning === undefined ? {} : { reasoning }) };\n}\n\nfunction parseReasoning(value: string | undefined): ThinkingLevel | undefined {\n  if (value === undefined || value === \"\") return undefined;\n  const level = THINKING_LEVELS.find((candidate) => candidate === value);\n  if (level === undefined) {\n    throw new Error(`PI_MODEL_REASONING must be one of ${THINKING_LEVELS.join(\", \")}`);\n  }\n  return level;\n}\n\n/**\n * The model for a new session: the default when the body names none, else the requested pair if the allowlist has\n * it. A string is the 400 message.\n */\nexport function chooseModel(\n  policy: ModelPolicy,\n  body: Record<string, unknown>,\n): ModelChoice | string {\n  const { provider, model } = body;\n  if (provider === undefined && model === undefined) return policy.default;\n  if (\n    typeof provider !== \"string\" ||\n    typeof model !== \"string\" ||\n    provider === \"\" ||\n    model === \"\"\n  ) {\n    return \"provider and model must both be non-empty strings\";\n  }\n  const requested: ModelChoice = {\n    provider,\n    model,\n    ...(policy.reasoning === undefined ? {} : { reasoning: policy.reasoning }),\n  };\n  const key = modelKey(requested);\n  if (!policy.allowed.some((choice) => modelKey(choice) === key)) {\n    return `model ${key.slice(0, 200)} is not allowed`;\n  }\n  return requested;\n}\n * `chatgpt-account-id` header value out of the access token (a JWT, claim `https://api.openai.com/auth`.\n * `chatgpt_account_id`). The gateway replaces both `Authorization` and `chatgpt-account-id` with the real login, so\n * the orchestrator holds this unsigned, JWT-shaped stand-in instead of a login.\n */\nexport function codexPlaceholderToken(accountId: string): string {\n  const part = (value: unknown): string => Buffer.from(JSON.stringify(value)).toString(\"base64url\");\n  return `${part({ alg: \"none\", typ: \"JWT\" })}.${part({\n    \"https://api.openai.com/auth\": { chatgpt_account_id: accountId },\n  })}.${PLACEHOLDER_API_KEY}`;\n}\n\n/** An in-memory credential store holding the Codex placeholder login, valid far beyond any refresh window. */\nexport async function placeholderCredentials(accountId: string): Promise<InMemoryCredentialStore> {\n  const store = new InMemoryCredentialStore();\n  await store.modify(\"openai-codex\", () =>\n    Promise.resolve({\n      type: \"oauth\" as const,\n      access: codexPlaceholderToken(accountId),\n      refresh: PLACEHOLDER_API_KEY,\n      expires: Date.now() + 10 * 365 * 24 * 3600 * 1000,\n    }),\n  );\n  return store;\n}\n\nexport function parseNoProxy(value: string | undefined): string[] {\n  return (value ?? \"\")\n    .split(\",\")\n    .map((entry) => entry.trim().toLowerCase())\n    .filter((entry) => entry !== \"\");\n}\n\n/**\n * `NO_PROXY` matching as curl and Go do it: `*` matches everything, `.suffix` and `suffix` match the host and its\n * subdomains, an IPv4 CIDR matches addresses in the block, and a port, when given, must match.\n */\nexport function bypassesProxy(url: URL, noProxy: readonly string[]): boolean {\n  const host = url.hostname.toLowerCase().replace(/^\\[|\\]$/g, \"\");\n  const port = url.port || (url.protocol === \"https:\" ? \"443\" : \"80\");\n  for (const entry of noProxy) {\n    if (entry === \"*\") return true;\n    const [pattern, entryPort] = splitPort(entry);\n    if (entryPort !== undefined && entryPort !== port) continue;\n    if (pattern.includes(\"/\")) {\n      if (inCidr(host, pattern)) return true;\n      continue;\n    }\n    const bare = pattern.replace(/^\\*?\\./, \"\");\n    if (host === bare || host.endsWith(`.${bare}`)) return true;\n  }\n  return false;\n}\n\nfunction splitPort(entry: string): [string, string | undefined] {\n  const match = /^(.*):(\\d+)$/.exec(entry);\n  return match?.[1] === undefined ? [entry, undefined] : [match[1], match[2]];\n}\n\nfunction ipv4ToInt(address: string): number | undefined {\n  const parts = address.split(\".\");\n  if (parts.length !== 4) return undefined;\n  let value = 0;\n  for (const part of parts) {\n    const octet = Number(part);\n    if (!/^\\d{1,3}$/.test(part) || octet > 255) return undefined;\n    value = value * 256 + octet;\n  }\n  return value;\n}\n\nfunction inCidr(host: string, cidr: string): boolean {\n  const [network = \"\", bitsText = \"\"] = cidr.split(\"/\");\n  const address = ipv4ToInt(host);\n  const base = ipv4ToInt(network);\n  const bits = Number(bitsText);\n  if (address === undefined || base === undefined || !Number.isInteger(bits)) return false;\n  if (bits < 0 || bits > 32) return false;\n  const size = 2 ** (32 - bits);\n  return Math.floor(address / size) === Math.floor(base / size);\n}\n\n/**\n * A `fetch` for model calls only. Requests go through the OneCLI gateway with the orchestrator's agent token\n * (`Proxy-Authorization`, basic with any username) and trust the gateway CA for the certificates it issues.\n * The dispatcher belongs to this function: nothing sets a process-wide proxy or changes the global dispatcher,\n * so the Kubernetes client, Postgres and the bridges are never proxied. Hosts in `noProxy` skip the gateway.\n */\nexport function createGatewayFetch(config: OneCliConfig): FetchFunction {\n  const proxy = new ProxyAgent({\n    uri: config.gateway,\n    token: `Basic ${Buffer.from(`x:${config.token.reveal()}`).toString(\"base64\")}`,\n    requestTls: { ca: [...rootCertificates, config.ca] },\n  });\n  const gatewayFetch = (\n    input: Parameters<FetchFunction>[0],\n    init?: Parameters<FetchFunction>[1],\n  /** Conversations whose last command was interrupted, to be recycled once no call is in flight. */\n  readonly #interrupted = new Set<number>();\n  /** A recycle or suspend under way. Calls wait for it before opening the env, so none reaches a dying Pod. */\n  readonly #replacing = new Map<number, Promise<void>>();\n  /**\n   * Recycles that failed and are still owed, with the work to run again. While an entry exists the old Pod may hold the\n   * leftovers of an interrupted command (ADR 0003), so no call may run until a retry has succeeded.\n   */\n  readonly #failed = new Map<\n    number,\n    { why: \"interrupted\" | \"orchestrator-restart\"; work: () => Promise<void> }\n  >();\n\n  readonly #sessionKeyOf: SessionKeyOf;\n  readonly #hooks: SandboxHooks;\n\n  constructor(config: OrchestratorConfig, sessionKeyOf: SessionKeyOf, hooks: SandboxHooks = {}) {\n    this.#config = config;\n    this.#sessionKeyOf = sessionKeyOf;\n    this.#hooks = hooks;\n    // Every open env is a Node bridge process (tens of MB). Without eviction a long-lived orchestrator grows\n    // with every session it ever ran a tool in (it was OOM-killed at 512Mi after about ten). An evicted env is\n    // simply opened again, adopting the same claim, by the next tool call.\n    this.#timers.push(setInterval(() => this.#evictIdle(config.sandbox.idleEvictMs), 15_000));\n    // Idle suspension (ADR 0004). It lists the Sandboxes, so it runs less often than eviction.\n    if (config.sandbox.idleSuspendMs > 0) {\n      this.#timers.push(setInterval(() => void this.#suspendIdle(), 30_000));\n    }\n    for (const timer of this.#timers) timer.unref();\n  }\n\n  /** Stops the timers. Bridges and sandboxes stay as they are. */\n  stop(): void {\n    for (const timer of this.#timers) clearInterval(timer);\n  }\n\n  #evictIdle(idleMs: number): void {\n    const now = Date.now();\n    for (const [conversationId, usage] of this.#usage) {\n      if (usage.inUse > 0 || now - usage.lastUsed < idleMs) continue;\n      const opened = this.#envs.get(conversationId);\n   */\n  #replace(\n    conversationId: number,\n    why: \"interrupted\" | \"orchestrator-restart\" | \"idle\",\n    work: () => Promise<void>,\n  ): void {\n    if (this.#replacing.has(conversationId)) return;\n    const claim = claimNameFor(conversationId);\n    const run = (async () => {\n      await work();\n      this.#failed.delete(conversationId);\n      this.#lastUsed.delete(conversationId);\n      log(why === \"idle\" ? \"sandbox-suspended\" : \"sandbox-recycled\", { claim, why });\n    })()\n      .catch((error: unknown) => {\n        if (why !== \"idle\") this.#failed.set(conversationId, { why, work });\n        log(\"sandbox-replace-failed\", { claim, why, message: errorMessage(error) });\n      })\n      .finally(() => this.#replacing.delete(conversationId));\n    this.#replacing.set(conversationId, run);\n  }\n\n  /**\n   * After a start: the conversations that had a command in flight when the previous process stopped. Their Pods are\n   * replaced before Pi Durable resumes (the caller invokes this first), so the continuing run finds a clean sandbox.\n   * Nothing is known about which of them really has a leftover child, so every one is recycled.\n   */\n  recycleAtStart(conversationIds: readonly number[]): void {\n    for (const conversationId of conversationIds) {\n      this.#replace(conversationId, \"orchestrator-restart\", async () => {\n        await recyclePod(this.#config.namespace, claimNameFor(conversationId));\n        await this.#hooks.execInFlight?.(conversationId, false);\n      });\n    }\n  }\n\n  async #closeEnv(conversationId: number): Promise<void> {\n    const opened = this.#envs.get(conversationId);\n    if (this.#usage.get(conversationId)?.inUse === 0) this.#usage.delete(conversationId);\n    this.#envs.delete(conversationId);\n    if (opened !== undefined) (await opened.catch(() => undefined))?.close();\n  }\n\n  /** Suspends the sandboxes that have been idle for `idleSuspendMs`. Never throws: it runs on a timer. */\n  async #suspendIdle(): Promise<void> {\n    try {\n      const sandboxes = await listSandboxes(this.#config.namespace);\n      const now = Date.now();\n      const busy = new Set<number>(this.#replacing.keys());\n      for (const [conversationId, usage] of this.#usage)\n        if (usage.inUse > 0) busy.add(conversationId);\n      for (const sandbox of sandboxes) {\n        const conversationId = conversationOfName(sandbox.name);\n        if (conversationId !== undefined && sandbox.mode === \"Suspended\")\n          this.#lastUsed.delete(conversationId);\n      }\n      const plan = planSuspend({\n        running: sandboxes.filter((s) => s.mode === \"Running\").map((s) => s.name),\n        lastUsed: this.#lastUsed,\n        busy,\n        now,\n        afterMs: this.#config.sandbox.idleSuspendMs,\n      });\n      for (const conversationId of plan.seen) this.#lastUsed.set(conversationId, now);\n      for (const conversationId of plan.suspend) {\n        this.#replace(conversationId, \"idle\", async () => {\n          await this.#closeEnv(conversationId);\n          await suspendSandbox(this.#config.namespace, claimNameFor(conversationId));\n        });\n      }\n    } catch (error) {\n      log(\"suspend-scan-failed\", { message: errorMessage(error) });\n    }\n  }\n\n  /** Creates or adopts the claim and waits for its Sandbox; safe to call on every start. */\nimport type { SessionRef } from \"@pi-durable-k8s/session-core\";\nimport { errorMessage, log } from \"./log.js\";\nimport { planSweep } from \"./sweep.js\";\nimport type { SweepAction, SweepAgent, SweepClaim, SweepPvc, SweepSecret } from \"./sweep.js\";\n\nexport interface SweeperDeps {\n  listSessions: () => Promise<SessionRef[]>;\n  listClaims: () => Promise<SweepClaim[]>;\n  listPvcs: () => Promise<SweepPvc[]>;\n  /** Undefined when OneCLI is not configured: the sweep then leaves agents alone. */\n  listOneCli: (() => Promise<{ agents: SweepAgent[]; secrets: SweepSecret[] }>) | undefined;\n  /** The session deletion's teardown: stops the bridge, deletes the claim, then the PVC. Also removes a lone PVC. */\n  destroyClaim: (claimName: string, sessionLabel: string) => Promise<void>;\n  revokeSession: (sessionId: string) => Promise<void>;\n  graceMs: number;\n  maxActions: number;\n  now?: () => number;\n}\n\n/**\n * The execution half of the orphan sweep: reads the world, asks `planSweep` what is orphaned, does it, logs each\n * action. One run at a time. A failing action is logged and the run goes on; the next run retries it. The log lines\n * carry names and ids only, never a token or secret value.\n */\nexport class OrphanSweeper {\n  readonly #deps: SweeperDeps;\n  #running = false;\n  #timer: NodeJS.Timeout | undefined;\n\n  constructor(deps: SweeperDeps) {\n    this.#deps = deps;\n  }\n\n  start(intervalMs: number): void {\n    if (intervalMs <= 0) {\n      log(\"sweep-disabled\", {});\n      return;\n    }\n    this.#timer = setInterval(() => void this.run(), intervalMs);\n    this.#timer.unref();\n  }\n\n  stop(): void {\n    if (this.#timer !== undefined) clearInterval(this.#timer);\n  }\n\n  /** One sweep. Returns the actions that succeeded; never throws. */\n  async run(): Promise<SweepAction[]> {\n    if (this.#running) return [];\n    this.#running = true;\n    const done: SweepAction[] = [];\n    try {\n      const d = this.#deps;\n      const [sessions, claims, pvcs, oneCli] = await Promise.all([\n        d.listSessions(),\n        d.listClaims(),\n        d.listPvcs(),\n        d.listOneCli?.(),\n      ]);\n      const actions = planSweep({\n        sessions,\n        claims,\n        pvcs,\n        agents: oneCli?.agents,\n        secrets: oneCli?.secrets ?? [],\n        now: d.now?.() ?? Date.now(),\n        graceMs: d.graceMs,\n        maxActions: d.maxActions,\n      });\n      for (const action of actions) {\n        try {\n          await this.#apply(action);\n          log(\"sweep-action\", { ...action });\n          done.push(action);\n        } catch (error) {\n          log(\"sweep-action-failed\", { ...action, message: errorMessage(error) });\n        }\n      }\n      if (actions.length > 0) log(\"sweep-done\", { planned: actions.length, done: done.length });\n    } catch (error) {\n      log(\"sweep-failed\", { message: errorMessage(error) });\n    } finally {\n      this.#running = false;\n    }\n    return done;\n  }\n\n  async #apply(action: SweepAction): Promise<void> {\n    switch (action.kind) {\n      case \"delete-claim\":\n        return this.#deps.destroyClaim(action.claim, action.sessionLabel);\n      case \"delete-pvc\":\n        // The claim does not exist, so there is no label to check; deleteClaimAndPvc refuses if one appears meanwhile.\n        return this.#deps.destroyClaim(action.claim, \"orphan-pvc-sweep\");\n      case \"revoke-agent\":\n        return this.#deps.revokeSession(action.sessionId);\n    }\n  }\n}\n","isError":false}]}
ENTRY 12180 {"id":12180,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]","calls":["bash({\"command\":\"cd /workspace/repo && grep -R -nE 'config.onecli.token|onecli.token|LOCAL_PROVIDERS|provider === \\\"faux\\\"|provider === \\\"scripted\\\"' packages/orchestrator/src && nl -ba packages/orchestrator/src/config.ts | sed -n '80,150p'; grep -R -n 'PI_SWEEP_INTERVAL_SECONDS' . --exclude-dir=.git | head -25\",\"timeout\":10})"]}]}
ENTRY 12182 {"id":12182,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/orchestrator/src/providers.ts:45:  const token = config.onecli.token;\npackages/orchestrator/src/config.ts:7:const LOCAL_PROVIDERS = new Set([\"scripted\", \"faux\"]);\npackages/orchestrator/src/config.ts:119:  const remote = models.allowed.find((choice) => !LOCAL_PROVIDERS.has(choice.provider));\n    80\t  \"10.0.0.0/8\",\n    81\t  \"172.16.0.0/12\",\n    82\t  \"192.168.0.0/16\",\n    83\t];\n    84\t\n    85\t/** A non-negative whole number of seconds from the environment, as milliseconds. */\n    86\tfunction seconds(\n    87\t  env: Readonly<Record<string, string | undefined>>,\n    88\t  name: string,\n    89\t  fallback: number,\n    90\t): number {\n    91\t  const value = Number(env[name] ?? String(fallback));\n    92\t  if (!Number.isInteger(value) || value < 0)\n    93\t    throw new Error(`${name} must be a whole number of seconds, 0 or more`);\n    94\t  return value * 1000;\n    95\t}\n    96\t\n    97\texport function loadConfig(env: Readonly<Record<string, string | undefined>>): OrchestratorConfig {\n    98\t  const databaseUrl = env.PI_DURABLE_DATABASE_URL;\n    99\t  if (!databaseUrl) throw new Error(\"PI_DURABLE_DATABASE_URL is required\");\n   100\t  const apiTokens = env.PI_API_TOKENS;\n   101\t  if (!apiTokens) throw new Error(\"PI_API_TOKENS is required\");\n   102\t  const port = Number(env.PI_ORCH_PORT ?? \"8081\");\n   103\t  if (!Number.isInteger(port) || port < 0 || port > 65535)\n   104\t    throw new Error(\"PI_ORCH_PORT is invalid\");\n   105\t  const turnBudget = Number(env.PI_SESSION_TURN_BUDGET ?? \"100\");\n   106\t  if (!Number.isInteger(turnBudget) || turnBudget < 1)\n   107\t    throw new Error(\"PI_SESSION_TURN_BUDGET must be an integer of 1 or more\");\n   108\t  const idleEvictMs = seconds(env, \"PI_SANDBOX_IDLE_EVICT_SECONDS\", 120);\n   109\t  const idleSuspendMs = seconds(env, \"PI_SANDBOX_IDLE_SUSPEND_SECONDS\", 1800);\n   110\t  // A sandbox is suspended only after its bridge is gone; suspending first would cut a bridge that is still open.\n   111\t  if (idleSuspendMs > 0 && idleSuspendMs < idleEvictMs)\n   112\t    throw new Error(\n   113\t      \"PI_SANDBOX_IDLE_SUSPEND_SECONDS must not be below PI_SANDBOX_IDLE_EVICT_SECONDS\",\n   114\t    );\n   115\t  const maxActions = Number(env.PI_SWEEP_MAX_ACTIONS ?? \"10\");\n   116\t  if (!Number.isInteger(maxActions) || maxActions < 1)\n   117\t    throw new Error(\"PI_SWEEP_MAX_ACTIONS must be an integer of 1 or more\");\n   118\t  const models = loadModelPolicy(env);\n   119\t  const remote = models.allowed.find((choice) => !LOCAL_PROVIDERS.has(choice.provider));\n   120\t  const token = env.ONECLI_AGENT_TOKEN;\n   121\t  if (remote !== undefined && !token) {\n   122\t    throw new Error(`ONECLI_AGENT_TOKEN is required for model provider ${remote.provider}`);\n   123\t  }\n   124\t  return {\n   125\t    databaseUrl,\n   126\t    schema: env.PI_DURABLE_SCHEMA ?? \"public\",\n   127\t    namespace: env.PI_ORCH_NAMESPACE ?? \"pi-durable-poc\",\n   128\t    warmPool: env.PI_ORCH_WARMPOOL ?? \"pi-env-pool\",\n   129\t    port,\n   130\t    instance: env.POD_NAME ?? `orchestrator-${String(process.pid)}`,\n   131\t    apiTokens,\n   132\t    control: env.PI_ORCH_CONTROL === \"1\",\n   133\t    testFaults: env.PI_ORCH_TEST_FAULTS === \"1\",\n   134\t    models,\n   135\t    turnBudget,\n   136\t    sandbox: { idleEvictMs, idleSuspendMs },\n   137\t    sweep: {\n   138\t      intervalMs: seconds(env, \"PI_SWEEP_INTERVAL_SECONDS\", 300),\n   139\t      graceMs: seconds(env, \"PI_SWEEP_GRACE_SECONDS\", 600),\n   140\t      maxActions,\n   141\t    },\n   142\t    onecli: {\n   143\t      gateway: env.PI_ONECLI_GATEWAY ?? \"http://onecli.onecli:10255\",\n   144\t      caFile: env.PI_ONECLI_CA_FILE ?? \"/etc/onecli/ca.pem\",\n   145\t      noProxy: [...DEFAULT_NO_PROXY, ...parseNoProxy(env.NO_PROXY)],\n   146\t      token: token ? new Redacted(token) : undefined,\n   147\t      codexAccountId: env.PI_CODEX_ACCOUNT_ID ?? PLACEHOLDER_API_KEY,\n   148\t    },\n   149\t    repos: {\n   150\t      onecliApi: env.PI_ONECLI_API ?? \"http://onecli.onecli:10256\",\n./tests/e2e/deploy/kustomization.yaml:34:        value: { name: PI_SWEEP_INTERVAL_SECONDS, value: \"15\" }\n./docs/decisions/0002-orphan-sweep.md:13:The orchestrator (the schema owner, so only one process) runs `OrphanSweeper` every `PI_SWEEP_INTERVAL_SECONDS`\n./docs/session-api.md:212:`PI_SWEEP_INTERVAL_SECONDS` (300; 0 = off) it removes SandboxClaims `pi-conv-<n>` labelled with a session UUID, workspace\n./examples/bug-hunt-2026-11-16/raw/2-sandbox-lifecycle.stream:9:ENTRY 9463 {\"id\":9463,\"kind\":\"pi.tool-result\",\"messages\":[{\"role\":\"toolResult\",\"text\":\"# 0002: Orphan sweep\\n\\nStatus: accepted, 2026-11-16 (issue #9). Implements the \\\"periodic sweep\\\" of the plan's Lifecycle baseline.\\n\\n## Context\\n\\nSession deletion removes the claim, the PVC and the OneCLI objects, but a crash, a test that dropped its rows before\\nthe delete finished, or a session that was never deleted through the API leaves objects behind. Each is a gVisor Pod\\nand a PVC, or a OneCLI agent whose token still works. Nothing reconciled the cluster against `inbox.sessions`.\\n\\n## Decision\\n\\nThe orchestrator (the schema owner, so only one process) runs `OrphanSweeper` every `PI_SWEEP_INTERVAL_SECONDS`\\n(300; 0 turns it off). Decision and execution are split: `planSweep` (`sweep.ts`) is a pure function from\\n`{sessions, claims, PVCs, OneCLI agents and secrets, now}` to a list of actions; `OrphanSweeper` (`sweeper.ts`)\\nreads the world, executes the list and logs every action.\\n\\n**What counts as an orphan.** Only a session that is `deleted` or has no row at all (`session-deleted`,\\n`session-unknown`). `active`, `failed` and `deleting` sessions are live.\\n\\n**What may be swept, by exact pattern only:**\\n\\n| Object | Pattern | Orphan when |\\n|---|---|---|\\n| SandboxClaim | name `pi-conv-<n>` and label `pi-durable-k8s/session-id` is a UUID | the label's session is deleted or unknown |\\n| PVC | `workspace-pi-conv-<n>` | no claim of that name exists (labelled or not) and the session that owns conversation `<n>` is deleted or unknown |\\n| OneCLI agent and secrets | agent `pi-session-<uuid>`, secrets `pi-session-<uuid>-git` and `-api` | that session is deleted or unknown |\\n\\nEverything else is left alone: unlabelled claims (the e2e Phase 1 claim `e2e-phase1`), `control-<n>` labels of the\\ntest-only control sessions, other names, other namespaces. A claim whose PVC is still wanted by another claim name is\\nnever touched.\\n\\n**Safety.**\\n\\n- *Grace age.* Nothing younger than `PI_SWEEP_GRACE_SECONDS` (600) is swept, from the object's `creationTimestamp`.\\n  OneCLI does not report creation times; an agent is judged by its session alone. That is safe because the session row\\n  exists before any of its objects does and is never hard-deleted by the API.\\n- *Bounded.* At most `PI_SWEEP_MAX_ACTIONS` (10) per run, claims first, then PVCs, then agents. The rest waits.\\n- *Logged.* One `sweep-action` line per action (kind, claim or session id, reason), `sweep-action-failed` with the\\n  message on error. Names and ids only; no token or secret value is ever in the log (the agent token is not even carried\\n  into the action list).\\n- *Reuses the delete path.* A claim goes through `Sandboxes.destroyOrphan`, which is the teardown of session deletion\\n  (stop the bridge, `deleteClaimAndPvc`). That function still refuses a claim whose label is not the one the sweep\\n  read, so a claim that changed hands between listing and deleting survives. A lone PVC goes through the same function\\n  with a key no label can equal. OneCLI goes through `RepoAccess.revokeSession`, the by-name revoke that session\\n  deletion also uses (agent first, so its token dies first).\\n- *Tombstones.* A `deleted` session already has its tombstone from the delete that did not finish. A session with no\\n  row has nothing to record; the log line is its trace.\\n\\n## Not in scope: an active session whose claim can never work again\\n\\nA claim created under the shared token (before ADR 0001) belongs to an `active` session and fails every call with the\\n\\\"delete the claim and its PVC\\\" error. The sweep does not remove it. The workspace is the only copy of that session's\\nfiles, the session is one the user can still talk to, and ADR 0001 made recreating it an explicit operator decision.\\nDeleting the session through `DELETE /sessions/{id}` removes the claim and PVC through the normal path. (This is how the\\nleftover test sessions on c2, among them the owners of `pi-conv-5858` and `pi-conv-5873`, were cleaned.)\\n\\n## Consequences\\n\\n- The sweep needs `list` on PVCs, in addition to the claim verbs the orchestrator already has (`deploy/orchestrator-rbac.yaml`).\\n- A OneCLI shared with another environment that also creates `pi-session-<uuid>` agents would see those agents swept\\n  as \\\"unknown\\\". c2's OneCLI serves this project only. Do not share one OneCLI between two session databases.\\n- A conversation whose session row is hard-deleted by hand (as the e2e cleanup does after deleting through the API) has\\n  any leftover claim swept as `session-unknown`, which is the intent.\\n# 0003: Recycle the sandbox Pod after an interrupted command\\n\\nStatus: accepted, 2026-11-16 (issue #9). Closes the Phase 3 finding about `setsid` children.\\n\\n## Context\\n\\nPhase 3 measured it: when the stream of a command dies, the daemon reaps the command's process group and same-group\\ndescendants, but a background child that called `setsid` survives. Pi Durable aborts commands on `cancel` and when a\\nsteer lands mid-tool, and a command has its own timeout; an orchestrator killed mid-command loses the stream the same\\nway. The leftover keeps running inside the session's sandbox, with the session's workspace and (for repo sessions)\\nits proxy token, until something replaces the Pod.\\n\\n## Decision\\n\\nWhen the orchestrator knows a command was interrupted, it **deletes the sandbox Pod, never the claim or the PVC**. The\\nSandbox controller creates a clean Pod on the same PVC (Phase 3 sandbox-loss behaviour). It applies to every session,\\nrepo or not: one rule, no flag, and the cost of a recycle is a Pod start (about 15 s on c2, measured).\\n\\n**What counts as interrupted** (`interruptedExec` in `lifecycle.ts`): an `ExecutionEnv.exec` that returned an\\n`aborted` or `timeout` error, or threw (the connection to the sandbox broke while it ran). A command that exits by\\nitself, with any exit code, is not interrupted. File operations never leave processes behind and never trigger it.\\n\\n**In the running orchestrator.** `Sandboxes.lazyEnv` classifies each `exec` outcome. When the last call in flight of\\nthat conversation ends and one of them was interrupted, the env is closed and `recyclePod` runs. Calls that arrive\\nmeanwhile wait for it, so none reaches a dying Pod. `recyclePod` deletes the Pod bound to its uid (10 s grace; what\\nruns there is what we are getting rid of) and returns when a Pod with another uid is Ready. The next call opens a new\\nenv: the SDK waits for the Sandbox, the bridge connects to the new Pod.\\n\\n**Across an orchestrator restart.** The dead process cannot tell us. So the orchestrator records \\\"a command may be\\nrunning\\\" in Postgres before the first command of a burst (`inbox.sessions.exec_in_flight_at`, migration 005) and clears\\nit when the last call ended without interruption, or once a recycle has finished. A record still set at start means the\\nprevious process died mid-command. `Host.open` recycles those sandboxes' Pods *before* `harness.resume()`, so the\\ncontinuing run (the interrupted command reads as `interrupted`, and is not replayed) finds a clean Pod. If a recycle\\nfails, the record stays and the next start tries again.\\n\\n**Cost and limits.**\\n\\n- One extra Postgres write per command burst (two updates: set, clear). Control sessions (no session row) are not\\n  recorded: a restart does not recycle them, which is the behaviour the Phase 3 suite tests.\\n- A recycle takes up to a minute of wall time (gVisor Pod start plus Longhorn re-attach); the tool call that follows\\n  waits for it.\\n- A Pod deleted with a 10 s grace can lose writes that were not flushed yet. Only an interrupted command is in that\\n  position, and its output is already unreliable.\\n- A recycle of a Pod that is not there (a suspended sandbox) is a no-op.\\n\\n## Rejected\\n\\n- *Kill the escapees from inside.* The agent can start processes in any session or process group; there is no list\\n  to kill and the daemon's view is what failed.\\n- *Recycle only repo sessions* (the plan's first wording). A plain session's escapee still burns CPU and can write to the\\n  workspace; one rule is simpler and the cost is the same.\\n- *Recycle every sandbox at every orchestrator start.* It restarts Pods of idle sessions for nothing.\\n# 0004: Idle shutdown by suspending the sandbox\\n\\nStatus: accepted, 2026-11-16 (issue #9). Replaces the \\\"set `shutdownAfterSeconds` as a backstop\\\" line of Phase 4.\\n\\n## Context\\n\\nIdle sandboxes hold a gVisor Pod (100m CPU and 128 Mi requested) for sessions nobody is using. The plan forbids the\\nobvious answer: `Sandbox.spec.shutdownTime` / `shutdownAfterSeconds` is an absolute time after which the controller\\ndeletes the Sandbox, and with its `shutdownPolicy: Delete` the workspace PVC goes with it. A session is a\\nconversation that can resume days later, so a deadline that deletes its workspace is wrong, and \\\"renew on activity\\\" is\\nan orchestrator write per call that fails the same way when the orchestrator is down.\\n\\n`shutdownPolicy: Retain` keeps the Sandbox object after `shutdownTime` but marks it `Expired` and tears the Pod down\\n(`handleSandboxExpiry` in `controllers/sandbox_controller.go`). It is still an absolute deadline that has to be\\nrenewed, and `Expired` is not a state the controller resumes from, so it is no substitute for a suspend.\\n\\n## What `operatingMode: Suspended` does (agent-sandbox v1.0.11, verified in source and on c2)\\n\\n- `Sandbox.spec.operatingMode` is `Running` (default) or `Suspended`\\n  (`kubectl explain sandbox.spec.operatingMode`; `clients/k8s/applyconfiguration/api/v1beta1/sandboxspec.go` documents\\n  it: \\\"the controller terminates the backing Pod but retains the Sandbox object and its volumes so it can later be\\n  resumed. Resuming creates a new Pod from the current podTemplate that reattaches the retained volumes\\\").\\n- `controllers/sandbox_controller.go` (`reconcilePod`, the branch on `OperatingModeSuspended`): deletes the Pod it owns,\\n  and `reconcilePVCs` is not skipped, so the PVC stays. The `Suspended` condition goes `PodTerminating`, then\\n  `Suspended=True` with reason `PodTerminated`; `Ready` is `False` with reason `SandboxSuspended`. The Service stays.\\n- A Sandbox owned by a SandboxClaim may be patched, and the claim controller does not revert it. The claim API has no\\n  operating mode; `extensions/controllers/sandboxclaim_controller.go` only patches the Sandbox's pod-template metadata\\n  and labels (`mergePodMetadata`), never the mode. Verified on c2 with a throwaway claim: a merge patch of\\n  `spec.operatingMode` to `Suspended` removed the Pod within seconds, the PVC (same uid) and the claim stayed, the\\n  claim reported `Ready=False/SandboxSuspended`, and 40 s later the mode was still `Suspended`. Patching back to\\n  `Running` gave a Ready Pod in 15 s on the same PVC.\\n- `Finished` is not set by a suspension (the controller keeps the previous value), so a future\\n  `ttlSecondsAfterFinished` would not delete a suspended sandbox either.\\n\\n## Decision\\n\\nAfter `PI_SANDBOX_IDLE_SUSPEND_SECONDS` (1800; 0 turns it off) with no call, the orchestrator suspends the session's\\nsandbox. The next tool call resumes it. No deadline, no deletion, no renewal.\\n\\n- **Builds on bridge eviction.** `Sandboxes#evictIdle` already closes an idle env's bridge after\\n  `PI_SANDBOX_IDLE_EVICT_SECONDS` (120). Suspension needs the last-use time of sandboxes whose env was evicted, so\\n  `Sandboxes` keeps a second map, `#lastUsed`, that outlives the env. Config refuses a suspend age below the eviction\\n  age. A timer every 30 s lists the Sandboxes and `planSuspend` (pure, `lifecycle.ts`) picks the `pi-conv-<n>` ones that\\n  are `Running` and idle long enough.\\n- **A restart postpones, never suspends.** A Running sandbox the process has no record of (it just started, or it never\\n  used it) starts its idle clock at first sight. Suspended sandboxes need no tracking.\\n- **Suspend completes before anything else.** The patch is followed by a wait for `Suspended=True`; calls for that\\n  conversation wait for it (`#replacing`), so a resume cannot race a Pod that is still terminating and connect to it.\\n- **Resume is lazy**, like claim creation. `#open` calls `resumeIfSuspended` (patch to `Running`) before the SDK's\\n  Ready wait, because a Suspended Sandbox is never Ready and the wait would only time out. It runs on every open, so\\n  it also covers an orchestrator restart and a session whose sandbox was suspended by an earlier process.\\n- **Busy conversations are skipped** (a call in flight, a recycle or suspend under way).\\n- Only `pi-conv-<n>` Sandboxes are considered, which excludes the Phase 1 claim `e2e-phase1`.\\n\\n## Consequences\\n\\n- RBAC: `patch` on `sandboxes` (deploy/orchestrator-rbac.yaml). The claim stays the unit of ownership; nothing but the\\n  mode is written to the Sandbox.\\n- A suspended session costs its PVC and a Service. A resumed one starts a fresh Pod (about 15 s) and loses whatever ran\\n  in the old one, which was idle by definition.\\n- The workspace marker for repo sessions is on the PVC and survives. The in-memory GitHub token cache\\n  (`RepoAccess.beforeUse`) renews its token at the next call as it does after an eviction.\\n- Not done: suspending a sandbox that is busy but silent for 30 minutes (a model thinking). Its next command resumes it.\\n/bin/bash: line 1: rg: command not found\\n<harness>\\n[error] Command exited with code 127\\n</harness>\",\"isError\":true}]}\n./packages/orchestrator/src/config.ts:138:      intervalMs: seconds(env, \"PI_SWEEP_INTERVAL_SECONDS\", 300),\n./packages/orchestrator/test/config.test.ts:50:        PI_SWEEP_INTERVAL_SECONDS: \"15\",\n","isError":false}]}
ENTRY 12201 {"id":12201,"kind":"pi.assistant","messages":[{"role":"assistant","text":"## Findings\n\n### 1. Long sweep intervals become near-continuous sweeps\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/config.ts:138\n- What happens: `PI_SWEEP_INTERVAL_SECONDS` accepts values above Node’s maximum timer delay. For example, an interval of 30 days is converted to milliseconds and passed to `setInterval`, which clamps the overflowed delay to 1 ms. Instead of running monthly, the sweeper repeatedly lists cluster and database resources as fast as its runs complete.\n- Evidence: `intervalMs: seconds(env, \"PI_SWEEP_INTERVAL_SECONDS\", 300)`; `seconds` checks only that the value is a non-negative integer before multiplying by 1000.\n- Fix idea: Reject sweep intervals whose millisecond value exceeds Node’s maximum timer delay, or implement long intervals using shorter scheduled delays.\n\nEND-OF-REPORT"}]}
DONE
