/src/config.ts:109:  const idleSuspendMs = seconds(env, \"PI_SANDBOX_IDLE_SUSPEND_SECONDS\", 1800);\npackages/orchestrator/src/config.ts:111:  if (idleSuspendMs > 0 && idleSuspendMs < idleEvictMs)\npackages/orchestrator/src/config.ts:115:  const maxActions = Number(env.PI_SWEEP_MAX_ACTIONS ?? \"10\");\npackages/orchestrator/src/config.ts:116:  if (!Number.isInteger(maxActions) || maxActions < 1)\npackages/orchestrator/src/config.ts:118:  const models = loadModelPolicy(env);\npackages/orchestrator/src/config.ts:136:    sandbox: { idleEvictMs, idleSuspendMs },\npackages/orchestrator/src/config.ts:138:      intervalMs: seconds(env, \"PI_SWEEP_INTERVAL_SECONDS\", 300),\npackages/orchestrator/src/config.ts:140:      maxActions,\npackages/orchestrator/src/config.ts:145:      noProxy: [...DEFAULT_NO_PROXY, ...parseNoProxy(env.NO_PROXY)],\npackages/session-core/src/index.ts:10:  loadModelPolicy,\npackages/session-core/src/models.ts:48:export function loadModelPolicy(env: Readonly<Record<string, string | undefined>>): ModelPolicy {\n","isError":false}]}
