st/config.test.ts:8:  PI_API_TOKENS: \"alice:0123456789abcdef0123\",\npackages/orchestrator/test/config.test.ts:15:    expect(() => loadConfig({ PI_DURABLE_DATABASE_URL: \"x\" })).toThrow(/PI_API_TOKENS/);\npackages/orchestrator/test/delete-repo.test.ts:19:  PI_API_TOKENS: \"alice:0123456789abcdef0123\",\npackages/orchestrator/src/config.ts:20:  /** `owner:token` entries for the same bearer-token authentication as ingest. */\npackages/orchestrator/src/config.ts:100:  const apiTokens = env.PI_API_TOKENS;\npackages/orchestrator/src/config.ts:101:  if (!apiTokens) throw new Error(\"PI_API_TOKENS is required\");\npackages/orchestrator/src/main.ts:9:  tokenAuthenticator,\npackages/orchestrator/src/main.ts:34:    authenticate: tokenAuthenticator(config.apiTokens),\npackages/ingest/src/config.ts:7:  /** `owner:token` entries, see session-core `tokenAuthenticator`. */\npackages/ingest/src/config.ts:20:  const apiTokens = env.PI_API_TOKENS;\npackages/ingest/src/config.ts:21:  if (!apiTokens) throw new Error(\"PI_API_TOKENS is required\");\npackages/ingest/src/main.ts:5:  tokenAuthenticator,\npackages/ingest/src/main.ts:13:  const authenticate = tokenAuthenticator(config.apiTokens);\ndeploy/orchestrator.yaml:55:            - name: PI_API_TOKENS\ndeploy/ingest.yaml:75:            - name: PI_API_TOKENS\ndeploy/gen-api-secret.sh:2:# Create secret api-auth in pi-durable-poc: key `tokens` holds one `owner:token` line per API owner.\ndocs/session-api.md:118:- Tokens come from the Kubernetes Secret `api-auth`, key `tokens`, as `owner:token` lines (create it with\n","isError":false}]}
