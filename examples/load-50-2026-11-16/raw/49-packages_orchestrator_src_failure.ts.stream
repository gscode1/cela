ENTRY 12320 {"id":12320,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { describe, expect, it } from \"vitest\";\nimport { terminalFailure } from \"../src/failure.ts\";\n\ndescribe(\"terminalFailure\", () => {\n  it.each([\n    \"401 Incorrect API key provided: onecli-managed-placeholder\",\n    \"403 Forbidden\",\n    \"Request failed with status code 401\",\n    'OpenRouter error: 401 {\"error\":{\"message\":\"No auth credentials found\",\"code\":401}}',\n    \"Proxy response (407) !== 200 when HTTP Tunneling\",\n    \"407 Proxy Authentication Required\",\n    \"Unauthorized\",\n    \"invalid_api_key\",\n    // OneCLI v2 with the grant deleted; pi-ai keeps only the body's message.\n    '{\"error\":\"access_restricted\",\"message\":\"chatgpt.com credentials exist in OneCLI but this agent does not have access. Ask the user to attach the key to this agent\",\"provider\":\"chatgpt.com\"}',\n  ])(\"ends the session when the model says credentials are rejected: %s\", (detail) => {\n    expect(terminalFailure({ reason: \"model_error\", detail })).toMatch(\n      /credentials were rejected \\(401\\/403\\)/,\n    );\n  });\n\n  it.each([\n    \"429 Too Many Requests\",\n    \"503 Service Unavailable\",\n    \"fetch failed\",\n    \"request id 4010293 failed\",\n    \"got 14031 bytes\",\n    \"Provider returned error\",\n  ])(\"leaves the session usable for a transient or unrelated error: %s\", (detail) => {\n    expect(terminalFailure({ reason: \"model_error\", detail })).toBeUndefined();\n  });\n\n  it(\"does not read a credential message into other kinds of run failure\", () => {\n    expect(terminalFailure({ reason: \"aborted\", detail: \"401\" })).toBeUndefined();\n    expect(terminalFailure({ reason: \"model_error\" })).toBeUndefined();\n  });\n\n  it(\"maps the turn limit to the turn budget\", () => {\n    expect(terminalFailure({ reason: \"turn_limit\", detail: \"5 turns\" })).toMatch(/turn budget/);\n  });\n\n  it(\"gives a message that never echoes the provider's text\", () => {\n    const message = terminalFailure({ reason: \"model_error\", detail: \"401 key sk-live-abc123\" });\n    expect(message).not.toContain(\"sk-live-abc123\");\n  });\n});\nimport type { RunOutcome } from \"./failure.js\";\n\n/** One input the orchestrator handed to Pi Durable and has not yet seen settled. */\nexport interface Watched {\n  sessionId: string;\n  conversationId: number;\n  /** The inbox row id: the Pi Durable `requestId` of the submission. */\n  requestId: string;\n}\n\n/** What the storage says about a submission; only the fields the watcher reads. */\nexport type SubmissionState =\n  | { status: \"queued\" | \"placed\" }\n  | { status: \"done\" }\n  | { status: \"unanswered\"; reason: string; detail?: unknown };\n\nexport interface RunWatcherOptions {\n  lookup: (conversationId: number, requestId: string) => Promise<SubmissionState | undefined>;\n  /** A submission ended `unanswered`: the run it belonged to failed or was aborted. Called once per submission. */\n  onUnanswered: (watched: Watched, outcome: RunOutcome) => Promise<void>;\n  pollMs?: number;\n  onError?: (error: unknown) => void;\n}\n\n/**\n * Notices runs that end without an answer. Pi Durable reports a model error only inside the conversation (the run's\n * submissions settle `unanswered` with the reason and error text), not to the host, so the orchestrator reads the\n * submissions it handed over until each is settled. Polling the storage also covers a run that a previous process\n * started and this one resumed: `add` it again at start and it is picked up the same way.\n */\nexport class RunWatcher {\n  readonly #options: RunWatcherOptions;\n  readonly #pending = new Map<string, Watched>();\n  #timer: NodeJS.Timeout | undefined;\n  #polling = false;\n\n  constructor(options: RunWatcherOptions) {\n    this.#options = options;\n  }\n\n  add(watched: Watched): void {\n    this.#pending.set(`${String(watched.conversationId)}/${watched.requestId}`, watched);\n    this.#timer ??= setInterval(() => void this.poll(), this.#options.pollMs ?? 2_000);\n    this.#timer.unref();\n  }\n\n  get size(): number {\n    return this.#pending.size;\n  }\n\n  stop(): void {\n    if (this.#timer !== undefined) clearInterval(this.#timer);\n    this.#timer = undefined;\n  }\n\n  /** One pass over the pending submissions. Exposed so tests need no timers. */\n  async poll(): Promise<void> {\n    if (this.#polling) return;\n    this.#polling = true;\n    try {\n      for (const [key, watched] of [...this.#pending]) {\n        try {\n          const state = await this.#options.lookup(watched.conversationId, watched.requestId);\n          if (state === undefined || state.status === \"done\") {\n            this.#pending.delete(key);\n          } else if (state.status === \"unanswered\") {\n            const detail =\n              typeof state.detail === \"string\"\n                ? state.detail\n                : state.detail === undefined\n                  ? undefined\n                  : JSON.stringify(state.detail);\n            await this.#options.onUnanswered(watched, {\n              reason: state.reason,\n              ...(detail === undefined ? {} : { detail }),\n            });\n            // Only now: a handler that threw leaves the watch in place, so the failure is not lost.\n            this.#pending.delete(key);\n          }\n        } catch (error) {\n          // Keep it pending: a storage hiccup must not lose the watch, nor crash the orchestrator.\n          this.#options.onError?.(error);\n        }\n      }\n    } finally {\n      this.#polling = false;\n      if (this.#pending.size === 0) this.stop();\n    }\n  }\n}\n   * A session is marked `failed` before its conversation is aborted, so a crash or a storage error in between leaves a\n   * failed session whose queued inputs still run, and nothing watches a failed session. Abort the recently failed\n   * ones again: `abort` is idempotent and a no-op on an idle conversation.\n   */\n  async #recoverFailedAborts(): Promise<void> {\n    const { rows } = await this.#pool.query<{ id: string; conversation_id: string }>(\n      `select id, conversation_id from inbox.sessions\n        where status = 'failed' and conversation_id is not null\n          and last_activity_at > clock_timestamp() - interval '24 hours'\n        order by last_activity_at desc limit 1000`,\n    );\n    for (const row of rows) {\n      try {\n        await this.#host.abort(Number(row.conversation_id));\n      } catch (error) {\n        log(\"failed-session-abort-failed\", { session: row.id, message: errorMessage(error) });\n      }\n    }\n  }\n\n  /**\n   * A submission ended without an answer. Rejected model credentials and a used-up turn budget end the session\n   * for good (`failed`); anything else leaves it active. The stored message is ours, never the provider's text.\n   */\n  async #runEnded(watched: Watched, outcome: RunOutcome): Promise<void> {\n    const failure = terminalFailure(outcome);\n    if (failure === undefined) return;\n    await this.#failSession(watched.sessionId, watched.conversationId, failure);\n  }\n\n  async #failSession(\n    sessionId: string,\n    conversationId: number | null,\n    failure: string,\n  ): Promise<void> {\n    const changed = await failSession(this.#pool, sessionId, failure);\n    if (changed) {\n      log(\"session-failed\", { session: sessionId, failure });\n    } else if ((await getSession(this.#pool, sessionId))?.status !== \"failed\") {\n      return;\n    }\n    // Withdraw whatever queued behind the failed run, so nothing more is sent to the provider. Also when the session\n    // was failed already: the status commits before the abort, so a caller whose abort died (or whose process did)\n    // retries here and must not find \"nothing changed\" and stop. A deleting or deleted session is not ours to abort.\n    if (conversationId !== null) await this.#host.abort(conversationId);\n  }\n\n  /**\n   * The session's conversation id, creating the conversation on first use. Serialised per session, so the\n   * stream handler and the inbox loop cannot create two. A crash between creating the conversation and\n   * storing its id leaves one empty, unreferenced conversation behind (documented limit).\n   */\n  async ensureConversation(session: SessionRow): Promise<number> {\n    if (session.conversationId !== null) return session.conversationId;\n    let creating = this.#creating.get(session.id);\n    if (creating === undefined) {\n      creating = this.#create(session.id).finally(() => this.#creating.delete(session.id));\n      this.#creating.set(session.id, creating);\n    }\n    return creating;\n  }\n\n  async #create(sessionId: string): Promise<number> {\n    const current = await getSession(this.#pool, sessionId);\n    if (current?.conversationId != null) return current.conversationId;\n    const conversationId = await this.#host.createConversation(\n      expect(await second.thinkingOf(id)).toBe(\"medium\");\n      await second.submitInput(id, { text: \"hi\", requestId: \"r1\", steer: false });\n      expect(await settled(second, id, \"r1\")).toMatchObject({ status: \"done\" });\n    } finally {\n      // Close every Host before deleting its storage dir: an open Harness can still write there (ENOTEMPTY).\n      for (const host of hosts.splice(0)) await host.close().catch(() => undefined);\n      await rm(dir, { recursive: true, force: true });\n    }\n  });\n\n  it(\"answers a turn on the stored model, with nothing applied per turn\", async () => {\n    const host = await openHost();\n    const id = await host.createConversation({ provider: \"scripted\", model: \"scripted-2\" });\n    await host.submitInput(id, { text: \"hello\", requestId: \"r1\", steer: false });\n    expect(await settled(host, id, \"r1\")).toMatchObject({ status: \"done\" });\n    expect(await host.turnsUsed(id)).toBe(1);\n  });\n});\n\ndescribe(\"a provider error\", () => {\n  it(\"reaches the submission as unanswered with the error text, which maps to a terminal failure\", async () => {\n    const host = await openHost();\n    const id = await host.createConversation({ provider: \"scripted\", model: \"scripted-1\" });\n    const script = JSON.stringify({ steps: [], error: \"401 Unauthorized: no credentials\" });\n    await host.submitInput(id, { text: script, requestId: \"r1\", steer: false });\n    const state = await settled(host, id, \"r1\");\n    expect(state).toMatchObject({ status: \"unanswered\", reason: \"model_error\" });\n    const detail = state.status === \"unanswered\" ? String(state.detail) : \"\";\n    expect(detail).toContain(\"401\");\n    expect(terminalFailure({ reason: \"model_error\", detail })).toMatch(/credentials were rejected/);\n  });\n\n  it(\"does not make an unrelated error terminal\", async () => {\n    const host = await openHost();\n    const id = await host.createConversation({ provider: \"scripted\", model: \"scripted-1\" });\n    const script = JSON.stringify({ steps: [], error: \"400 Bad Request: context too long\" });\n    await host.submitInput(id, { text: script, requestId: \"r1\", steer: false });\n    const state = await settled(host, id, \"r1\");\n    const detail = state.status === \"unanswered\" ? String(state.detail) : \"\";\n    expect(terminalFailure({ reason: \"model_error\", detail })).toBeUndefined();\n  });\n});\n\ndescribe(\"turn budget\", () => {\n  const session = (status: SessionRow[\"status\"] = \"active\"): SessionRow => ({\n    id: \"s1\",\n    owner: \"alice\",\n    ownerSubject: \"static:alice\",\n    status,\n    conversationId: null,\n    model: { provider: \"scripted\", model: \"scripted-1\" },\n","isError":false}]}
