trator/test/failure.test.ts:39:    expect(terminalFailure({ reason: \"turn_limit\", detail: \"5 turns\" })).toMatch(/turn budget/);\npackages/orchestrator/test/failure.test.ts:43:    const message = terminalFailure({ reason: \"model_error\", detail: \"401 key sk-live-abc123\" });\npackages/orchestrator/test/watcher.test.ts:2:import type { RunOutcome } from \"../src/failure.ts\";\npackages/orchestrator/test/watcher.test.ts:9:  const ended: { watched: Watched; outcome: RunOutcome }[] = [];\npackages/orchestrator/test/watcher.test.ts:32:      { status: \"unanswered\", reason: \"model_error\", detail: \"401 Unauthorized\" },\npackages/orchestrator/test/watcher.test.ts:41:      { watched, outcome: { reason: \"model_error\", detail: \"401 Unauthorized\" } },\npackages/orchestrator/test/watcher.test.ts:63:      { status: \"unanswered\", reason: \"model_error\", detail: \"403\" },\npackages/orchestrator/test/watcher.test.ts:76:      { status: \"unanswered\", reason: \"turn_limit\", detail: { turns: 3 } },\npackages/orchestrator/test/host-model.test.ts:12:import { terminalFailure } from \"../src/failure.ts\";\npackages/orchestrator/test/host-model.test.ts:116:    expect(state).toMatchObject({ status: \"unanswered\", reason: \"model_error\" });\npackages/orchestrator/test/host-model.test.ts:119:    expect(terminalFailure({ reason: \"model_error\", detail })).toMatch(/credentials were rejected/);\npackages/orchestrator/test/host-model.test.ts:129:    expect(terminalFailure({ reason: \"model_error\", detail })).toBeUndefined();\n","isError":false}]}
