ENTRY 12210 {"id":12210,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/orchestrator/src/stream.ts:23:  runFailure?: string;\npackages/orchestrator/src/stream.ts:59:  const failure = asObject(live?.runFailure);\npackages/orchestrator/src/stream.ts:60:  if (typeof failure?.reason === \"string\") event.runFailure = failure.reason;\npackages/orchestrator/src/stream.ts:113:export async function serveStream(\npackages/orchestrator/src/stream.ts:121:  const watched = await host.watch(conversationId);\npackages/orchestrator/src/stream.ts:164:    if (view.before !== undefined && view.before > cursor) {\npackages/orchestrator/src/stream.ts:170:            maxEntryId: view.before,\npackages/orchestrator/src/host.ts:266:  async watch(\npackages/orchestrator/src/sessions.ts:26:export class StreamRegistry {\npackages/orchestrator/src/http.ts:10:import { serveStream } from \"./stream.js\";\npackages/orchestrator/src/http.ts:101:    await serveStream(req, res, host, service.streams, session.id, conversationId);\npackages/orchestrator/src/stream.ts:23:  runFailure?: string;\npackages/orchestrator/src/stream.ts:59:  const failure = asObject(live?.runFailure);\npackages/orchestrator/src/stream.ts:60:  if (typeof failure?.reason === \"string\") event.runFailure = failure.reason;\npackages/orchestrator/src/stream.ts:113:export async function serveStream(\npackages/orchestrator/src/stream.ts:121:  const watched = await host.watch(conversationId);\npackages/orchestrator/src/stream.ts:164:    if (view.before !== undefined && view.before > cursor) {\npackages/orchestrator/src/stream.ts:170:            maxEntryId: view.before,\npackages/orchestrator/src/host.ts:266:  async watch(\npackages/orchestrator/src/sessions.ts:26:export class StreamRegistry {\npackages/orchestrator/src/http.ts:10:import { serveStream } from \"./stream.js\";\npackages/orchestrator/src/http.ts:101:    await serveStream(req, res, host, service.streams, session.id, conversationId);\npackages/orchestrator/test/stream.test.ts:47:    expect(liveEvent({ \"pi.live\": { runFailure: { reason: \"aborted\" } } })).toMatchObject({\npackages/orchestrator/test/stream.test.ts:49:      runFailure: \"aborted\",\n","isError":false}]}
