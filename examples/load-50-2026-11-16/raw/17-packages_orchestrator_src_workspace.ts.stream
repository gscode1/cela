ENTRY 11579 {"id":11579,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { readFile } from \"node:fs/promises\";\nimport type pg from \"pg\";\nimport { markWorkspaceReady, setOneCliObjects } from \"@pi-durable-k8s/session-core\";\nimport type { SessionRow } from \"@pi-durable-k8s/session-core\";\nimport { loadGithubApp, mintInstallationToken } from \"./github-app.js\";\nimport type { FetchLike } from \"./github-app.js\";\nimport { log } from \"./log.js\";\nimport type { Redacted } from \"./onecli.js\";\nimport { OneCliError } from \"./onecli-admin.js\";\nimport type { OneCliAdmin, OneCliGrant } from \"./onecli-admin.js\";\nimport { buildShellEnv, prepareWorkspace } from \"./workspace.js\";\nimport type { WorkspaceEnv } from \"./workspace.js\";\n\n/** A repo session that cannot be served and never will be without an operator: not configured, repo not installed. */\nexport class RepoUnavailableError extends Error {}\n\n/** Re-mint when the token has less than this left: a command can run for a long while after the check. */\nconst REMINT_BEFORE_MS = 10 * 60 * 1000;\n\nexport interface RepoAccessDeps {\n  pool: Pick<pg.Pool, \"query\">;\n  /** Undefined when `ONECLI_API_KEY` is not set: repo sessions are then refused. */\n  onecli: OneCliAdmin | undefined;\n  /** Directory of the mounted GitHub App secret. */\n  githubAppDir: string;\n  /** Proxy URL of the gateway, without credentials. */\n  gateway: string;\n  /** File holding the OneCLI CA PEM (the mounted ConfigMap). */\n  caFile: string;\n  fetch: FetchLike;\n  now?: () => number;\n  /** Only tests change these. */\n  githubApi?: string;\n  gitBase?: string;\n}\n\ninterface Access {\n  agentId: string;\n  secretIds: string[];\n  /** The agent's `aoc_...` token: the proxy password handed to this session's commands. */\n  proxyToken: Redacted;\n  /** When the GitHub token now stored in the secrets stops working. */\n  expiresAt: number;\n}\n\n/** Names are derived from the session id, so a crash between creating an object and storing its id leaves it findable. */\nexport const agentIdentifier = (sessionId: string): string => `pi-session-${sessionId}`;\nconst SECRET_SUFFIXES = [\n  { suffix: \"git\", host: \"github.com\", header: \"Authorization\", format: \"Basic {value}\" },\n  { suffix: \"api\", host: \"api.github.com\", header: \"Authorization\", format: \"Bearer {value}\" },\n] as const;\nconst secretName = (sessionId: string, suffix: string): string =>\n  `${agentIdentifier(sessionId)}-${suffix}`;\n\n/**\n * Everything a repo session needs from GitHub and OneCLI, kept per session and rebuilt from OneCLI after a restart:\n *\n *  - a OneCLI agent `pi-session-<uuid>` whose only grants are this session's two GitHub secrets;\n *  - those secrets (host `github.com`: `Authorization: Basic base64(\"x-access-token:<token>\")`, host `api.github.com`:\n *    `Bearer <token>`), holding a one-hour installation token for exactly this repository, minted by our own GitHub\n *    App (OneCLI v2 cannot scope a GitHub connection to a repository);\n *  - the token re-minted on every cold `ensure` and before it expires.\n *\n * Plain sessions never reach this class's OneCLI calls: every entry point returns at `session.repo === null`.\n */\nexport class RepoAccess {\n  readonly #deps: RepoAccessDeps;\n  readonly #access = new Map<string, Access>();\n  readonly #byConversation = new Map<number, SessionRow>();\n  readonly #inFlight = new Map<string, Promise<Access>>();\n  readonly #prepared = new Set<string>();\n\n  constructor(deps: RepoAccessDeps) {\n    this.#deps = deps;\n  }\n\n  #now(): number {\n    return this.#deps.now?.() ?? Date.now();\n  }\n\n  /** The `shellEnv` of a repo session's env, provisioning OneCLI first if needed. Undefined for a plain session. */\n  async shellEnv(\n    session: SessionRow,\n    conversationId: number,\n  ): Promise<Record<string, string> | undefined> {\n    if (session.repo === null) return undefined;\n    this.#byConversation.set(conversationId, session);\n    const access = await this.ensureAccess(session);\n    return buildShellEnv({ gateway: this.#deps.gateway, token: access.proxyToken });\n  }\n\n  /** Called before each tool call of an open env: renews a GitHub token that is about to expire. No-op otherwise. */\n  async beforeUse(conversationId: number): Promise<void> {\n    const session = this.#byConversation.get(conversationId);\n    if (session === undefined) return;\n    const access = this.#access.get(session.id);\n    if (access !== undefined && access.expiresAt - this.#now() > REMINT_BEFORE_MS) return;\n    await this.ensureAccess(session);\n  }\n\n  /** Agent, secrets, narrow grants and a fresh token. Serialised per session; warm calls only check the expiry. */\n  ensureAccess(session: SessionRow): Promise<Access> {\n    const running = this.#inFlight.get(session.id);\n    if (running !== undefined) return running;\n    const work = this.#ensure(session).finally(() => this.#inFlight.delete(session.id));\n    this.#inFlight.set(session.id, work);\n    return work;\n  }\n\n  async #ensure(session: SessionRow): Promise<Access> {\n    const { onecli } = this.#deps;\n    if (session.repo === null) throw new Error(\"not a repo session\");\n    if (onecli === undefined) {\n      throw new RepoUnavailableError(\n        \"repository workspaces are not configured: ONECLI_API_KEY is not set\",\n      );\n    }\n    const warm = this.#access.get(session.id);\n    if (warm !== undefined && warm.expiresAt - this.#now() > REMINT_BEFORE_MS) return warm;\n\n    const minted = await this.#mint(session.repo.repo);\n    const gitValue = Buffer.from(`x-access-token:${minted.token.reveal()}`).toString(\"base64\");\n    const valueOf = (suffix: string): string =>\n      suffix === \"git\" ? gitValue : minted.token.reveal();\n\n    const identifier = agentIdentifier(session.id);\n    const findAgent = async () =>\n      (await onecli.listAgents()).find((a) => a.identifier === identifier);\n    let found = await findAgent();\n    const created = found === undefined;\n    if (found === undefined) {\n      await onecli.createAgent(identifier, identifier);\n      found = await findAgent();\n    }\n    if (found === undefined) throw new Error(\"OneCLI created the agent but does not list it\");\n    const agent = found;\n    const existing = new Map((await onecli.listSecrets()).map((s) => [s.name, s.id]));\n    const secretIds: string[] = [];\n    for (const spec of SECRET_SUFFIXES) {\n      const name = secretName(session.id, spec.suffix);\n      let id = existing.get(name);\n      if (id === undefined) {\n        id = await onecli.createSecret({\n          name,\n          value: valueOf(spec.suffix),\n          hostPattern: spec.host,\n          header: spec.header,\n          valueFormat: spec.format,\n        });\n      } else {\n        await onecli.updateSecretValue(id, valueOf(spec.suffix));\n      }\n      secretIds.push(id);\n    }\n\n    try {\n      await this.#narrow(agent.id, secretIds);\n    } catch (error) {\n      // An agent that might hold more than this session's secrets must not outlive the failed attempt.\n      await this.#revoke(session.id, agent.id, secretIds).catch(() => undefined);\n      this.#access.delete(session.id);\n      throw error;\n    }\n\n    const stored = session.onecli;\n    if (stored?.agentId !== agent.id || stored.secretIds.join() !== secretIds.join()) {\n      await setOneCliObjects(this.#deps.pool, session.id, agent.id, secretIds);\n    }\n    const access: Access = {\n      agentId: agent.id,\n      secretIds,\n      proxyToken: agent.accessToken,\n      expiresAt: minted.expiresAt.getTime(),\n    };\n    this.#access.set(session.id, access);\n    log(\"repo-access-ready\", { session: session.id, repo: session.repo.repo, created });\n    return access;\n  }\n\n  async #mint(repo: string): ReturnType<typeof mintInstallationToken> {\n    let app;\n    try {\n      app = await loadGithubApp(this.#deps.githubAppDir);\n    } catch (error) {\n      throw new RepoUnavailableError(\n        error instanceof Error ? error.message : \"GitHub App secret is not available\",\n      );\n    }\n    return mintInstallationToken(app, repo, this.#deps.fetch, this.#now(), this.#deps.githubApi);\n  }\n\n  /**\n   * OneCLI grants every new agent the LLM keys (seen live), so after creating the agent every grant except this\n   * session's own two secrets is removed, then the grant list is read back and must be exactly those two. An answer\n   * that cannot be read counts as a failure: the agent is not used unless it is proven narrow.\n   */\n  async #narrow(agentId: string, secretIds: readonly string[]): Promise<void> {\n    const { onecli } = this.#deps;\n    if (onecli === undefined) throw new Error(\"OneCLI is not configured\");\n    const mine = new Set(secretIds);\n    const have = await onecli.listGrants(agentId);\n    for (const id of mine) {\n      if (!have.some((g) => g.kind === \"secret\" && g.id === id))\n        await onecli.grantSecret(agentId, id);\n    }\n    for (const grant of have) {\n      if (grant.kind === \"secret\" && mine.has(grant.id)) continue;\n      await onecli.revokeGrant(agentId, grant);\n    }\n    const left: OneCliGrant[] = await onecli.listGrants(agentId);\n    const ok =\n      left.length === mine.size && left.every((g) => g.kind === \"secret\" && mine.has(g.id));\n    if (!ok) {\n      throw new Error(\n        `OneCLI agent still holds ${String(left.length)} grants after narrowing; expected only the session's GitHub secrets`,\n      );\n    }\n  }\n\n  /**\n   * Before the first turn of a repo session: provision, then clone through the session's env. Returns quickly once\n   * done in this process; after a restart it runs again, which re-mints the token and finds the clone present.\n   */\n  async prepare(session: SessionRow, env: WorkspaceEnv): Promise<void> {\n    const spec = session.repo;\n    if (spec === null) return;\n    await this.ensureAccess(session);\n    if (this.#prepared.has(session.id)) return;\n    let ca: string;\n    try {\n      ca = await readFile(this.#deps.caFile, \"utf8\");\n    } catch {\n      throw new RepoUnavailableError(`the OneCLI CA is not available at ${this.#deps.caFile}`);\n    }\n    const outcome = await prepareWorkspace(env, spec, {\n      ca,\n      sessionId: session.id,\n      wasReady: session.workspaceReadyAt !== null,\n      ...(this.#deps.gitBase === undefined ? {} : { gitBase: this.#deps.gitBase }),\n    });\n    await markWorkspaceReady(this.#deps.pool, session.id);\n    this.#prepared.add(session.id);\n    // `workspace-cloned` once per session; `workspace-present` after a restart. tests/e2e/run-phase4c.sh greps both.\n    log(outcome === \"cloned\" ? \"workspace-cloned\" : \"workspace-present\", {\n      session: session.id,\n      repo: spec.repo,\n    });\n  }\n\n  /**\n   * Revokes everything the session held in OneCLI: the agent first (its token fails at once), then the secrets.\n   * Looks objects up by name as well as by stored id, so a crash between creating an object and storing its id\n   * cannot leave one behind. Idempotent. A plain session has nothing and makes no OneCLI call.\n   */\n  async teardown(session: SessionRow): Promise<void> {\n    if (session.repo === null) return;\n    const { onecli } = this.#deps;\n    this.#forget(session.id);\n    if (onecli === undefined) {\n      if (session.onecli === null) return;\n      throw new Error(\"cannot revoke the session's OneCLI agent: ONECLI_API_KEY is not set\");\n    }\n    await this.#revoke(session.id, session.onecli?.agentId, session.onecli?.secretIds ?? []);\n    log(\"repo-access-revoked\", { session: session.id });\n  }\n\n  /**\n   * The orphan sweep's revoke: removes whatever OneCLI still holds under this session's names (agent first, then the\n   * secrets), with no session row needed. Nothing is stored for a session that is deleted or unknown.\n   */\n  async revokeSession(sessionId: string): Promise<void> {\n    this.#forget(sessionId);\n    await this.#revoke(sessionId, undefined, []);\n  }\n\n  async #revoke(\n    sessionId: string,\n    agentId: string | undefined,\n    secretIds: readonly string[],\n  ): Promise<void> {\n    const { onecli } = this.#deps;\n    if (onecli === undefined) return;\n    const agents = (await onecli.listAgents())\n      .filter((a) => a.identifier === agentIdentifier(sessionId))\n      .map((a) => a.id);\n    for (const id of new Set([...(agentId === undefined ? [] : [agentId]), ...agents])) {\n      await onecli.deleteAgent(id);\n    }\n    const names = new Set(SECRET_SUFFIXES.map((s) => secretName(sessionId, s.suffix)));\n    const named = (await onecli.listSecrets()).filter((s) => names.has(s.name)).map((s) => s.id);\n    for (const id of new Set([...secretIds, ...named])) {\n      try {\n        await onecli.deleteSecret(id);\n      } catch (error) {\n        if (!(error instanceof OneCliError && error.status === 404)) throw error;\n      }\n    }\n  }\n\n  #forget(sessionId: string): void {\n    this.#access.delete(sessionId);\n    this.#prepared.delete(sessionId);\n    for (const [conversationId, session] of this.#byConversation) {\n      if (session.id === sessionId) this.#byConversation.delete(conversationId);\n    }\n  }\n}\n  }\n\n  async #create(sessionId: string): Promise<number> {\n    const current = await getSession(this.#pool, sessionId);\n    if (current?.conversationId != null) return current.conversationId;\n    const conversationId = await this.#host.createConversation(\n      current?.model ?? this.#options.defaultModel,\n    );\n    await this.#pool.query(\n      \"update inbox.sessions set conversation_id = $1 where id = $2 and conversation_id is null\",\n      [conversationId, sessionId],\n    );\n    log(\"conversation-created\", { session: sessionId, conversation: conversationId });\n    return conversationId;\n  }\n\n  /** Applies one inbox event. Resolves when it is durably handed over; throws PermanentError if it never can be. */\n  async apply(event: InboxEvent, session: SessionRow): Promise<void> {\n    if (session.status === \"deleted\") throw new PermanentError(\"session is deleted\");\n    switch (event.kind) {\n      case \"message\":\n      case \"steer\": {\n        const text = event.payload.text;\n        if (typeof text !== \"string\" || text === \"\") throw new PermanentError(\"event has no text\");\n        if (session.status === \"failed\") {\n          // Retries an abort that failed when the session was failed (see #failSession); throws, and so retries the\n          // row, if the abort fails again.\n          if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n          throw new PermanentError(\"session has failed\");\n        }\n        const conversationId = await this.ensureConversation(session);\n        await this.#withinBudget(session, conversationId);\n        // Before the first turn: OneCLI agent, token and clone. A session without a repo skips all of it.\n        if (session.repo !== null) await this.#prepareRepo(session, conversationId);\n        const requestId = event.id;\n        const faultArmed =\n          this.#options.testFaults && event.payload.testFault === \"exit-after-submit\";\n        const alreadyAdmitted =\n          faultArmed && (await this.#host.hasSubmission(conversationId, requestId));\n        await this.#host.submitInput(conversationId, {\n          text,\n          requestId,\n          steer: event.kind === \"steer\",\n        });\n        this.#watcher.add({ sessionId: session.id, conversationId, requestId });\n        if (faultArmed && !alreadyAdmitted) {\n          // After the durable hand-over, before the row says so: exactly the window test 4 needs.\n          // Synchronous write: stdout to a pipe is async and process.exit would drop the line.\n          writeSync(\n            1,\n            `${JSON.stringify({ event: \"test-fault\", fault: \"exit-after-submit\", id: event.id })}\\n`,\n          );\n          process.exit(137);\n        }\n        return;\n      }\n      case \"cancel\": {\n        if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n        return;\n      }\n      case \"delete\": {\n        await this.#delete(session);\n        return;\n      }\n    }\n  }\n\n  /**\n   * Provisions the repo session's GitHub access and makes sure its clone exists. What no retry can fix ends the input\n   * for good (and, for a lost workspace or refused access, the session): the agent must not run a turn in a workspace\n   * that is not the one the user asked for. Anything else throws as is, so the inbox retries it.\n   */\n  async #prepareRepo(session: SessionRow, conversationId: number): Promise<void> {\n    const repos = this.#options.repos;\n    if (repos === undefined) throw new PermanentError(\"repository workspaces are not configured\");\n    try {\n      await repos.prepare(session, await this.#host.workspaceEnv(conversationId));\n    } catch (error) {\n      if (error instanceof WorkspaceLostError) {\n        await this.#failSession(session.id, conversationId, error.message);\n        throw new PermanentError(error.message);\n      }\n      if (error instanceof GithubDeniedError) {\n        const failure =\n          \"GitHub refused access to the repository: is the GitHub App installed on it?\";\n        await this.#failSession(session.id, conversationId, failure);\n        throw new PermanentError(failure);\n      }\n      if (error instanceof RepoUnavailableError) throw new PermanentError(error.message);\n      throw error;\n    }\n  }\n\n  /**\n   * The per-session turn budget, checked before every input: a session that used all its turns fails for good, and\n   * otherwise the conversation's `maxTurns` is set to what is left, so a single long run cannot overshoot it.\n   * Turns are model responses, counted from the stored transcript, so a restart does not reset the count.\n   */\n  async #withinBudget(session: SessionRow, conversationId: number): Promise<void> {\n    const used = await this.#host.turnsUsed(conversationId);\n    const left = this.#options.turnBudget - used;\n    if (left <= 0) {\n      const failure = terminalFailure({ reason: \"turn_limit\" });\n      await this.#failSession(session.id, conversationId, failure ?? \"turn budget exhausted\");\n      throw new PermanentError(\"turn budget exhausted\");\n    }\n    await this.#host.limitTurns(conversationId, left);\n  }\n\n  /**\n   * Stop the session, delete the SandboxClaim and PVC, mark the session deleted. The conversation's stored state\nimport { execFileSync } from \"node:child_process\";\nimport { createReadStream, existsSync } from \"node:fs\";\nimport { mkdir, mkdtemp, readFile, rm, writeFile } from \"node:fs/promises\";\nimport { createServer } from \"node:http\";\nimport type { Server } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { NodeExecutionEnv } from \"@earendil-works/pi-durable/env/node\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport { Redacted } from \"../src/onecli.ts\";\nimport { buildShellEnv, prepareWorkspace, WorkspaceLostError } from \"../src/workspace.ts\";\n\nconst TOKEN = \"aoc_0123456789abcdef\";\nconst git = (cwd: string, ...args: string[]): string =>\n  execFileSync(\"git\", args, {\n    cwd,\n    encoding: \"utf8\",\n    env: { ...process.env, GIT_CONFIG_GLOBAL: \"/dev/null\", GIT_CONFIG_SYSTEM: \"/dev/null\" },\n  });\n\ndescribe(\"buildShellEnv\", () => {\n  const env = buildShellEnv({ gateway: \"http://onecli.onecli:10255\", token: new Redacted(TOKEN) });\n\n  it(\"routes HTTPS through the gateway with the agent token as the proxy password\", () => {\n    expect(env.HTTPS_PROXY).toBe(`http://x:${TOKEN}@onecli.onecli:10255`);\n    expect(env.https_proxy).toBe(env.HTTPS_PROXY);\n  });\n\n  it(\"trusts the OneCLI CA for git, OpenSSL clients and Node, and makes git send proxy basic auth\", () => {\n    expect(env.SSL_CERT_FILE).toBe(\"/workspace/.onecli/bundle.pem\");\n    expect(env.GIT_SSL_CAINFO).toBe(\"/workspace/.onecli/bundle.pem\");\n    expect(env.NODE_EXTRA_CA_CERTS).toBe(\"/workspace/.onecli/ca.pem\");\n    expect(env.GIT_CONFIG_COUNT).toBe(\"1\");\n    expect(env.GIT_CONFIG_KEY_0).toBe(\"http.proxyAuthMethod\");\n    expect(env.GIT_CONFIG_VALUE_0).toBe(\"basic\");\n    expect(env.GIT_TERMINAL_PROMPT).toBe(\"0\");\n  });\n\n  it(\"holds no GitHub token and no orchestrator secret\", () => {\n    const all = JSON.stringify(env);\n    expect(all).not.toMatch(/ghs_|PRIVATE KEY|oc_admin|postgres/);\n    expect(env.GITHUB_TOKEN).toBeUndefined();\n    expect(env.NO_PROXY).toBe(\"localhost,127.0.0.1,::1\");\n  });\n});\n\ndescribe(\"prepareWorkspace against a fake proxy\", () => {\n  let dir: string;\n  let root: string;\n  let served: string;\n  let proxy: Server;\n  let proxyUrl: string;\n  let seen: { url: string; auth: string | undefined }[];\n  let env: NodeExecutionEnv;\n\n  const ca = \"-----BEGIN CERTIFICATE-----\\nFAKE\\n-----END CERTIFICATE-----\\n\";\n  const run = (over: { wasReady?: boolean; branch?: string } = {}) =>\n    prepareWorkspace(\n      env,\n      { repo: \"octo/hello\", ...(over.branch === undefined ? {} : { branch: over.branch }) },\n      {\n        ca,\n        sessionId: \"s-1\",\n        wasReady: over.wasReady ?? false,\n        root,\n        gitBase: \"http://git.example.test\",\n      },\n    );\n\n  beforeEach(async () => {\n    dir = await mkdtemp(join(tmpdir(), \"ws-\"));\n    root = join(dir, \"workspace\");\n    served = join(dir, \"served\");\n    await mkdir(root, { recursive: true });\n    // A repository with a branch `dev`, served as a bare repo over the dumb HTTP protocol.\n    const work = join(dir, \"work\");\n    await mkdir(work);\n    git(work, \"init\", \"-q\", \"-b\", \"main\");\n    git(work, \"config\", \"user.email\", \"t@example.test\");\n    git(work, \"config\", \"user.name\", \"t\");\n    await writeFile(join(work, \"README.md\"), \"hello\\n\");\n    git(work, \"add\", \".\");\n    git(work, \"commit\", \"-q\", \"-m\", \"first\");\n    git(work, \"branch\", \"dev\");\n    await mkdir(join(served, \"octo\"), { recursive: true });\n    git(dir, \"clone\", \"-q\", \"--bare\", work, join(served, \"octo\", \"hello.git\"));\n    git(join(served, \"octo\", \"hello.git\"), \"update-server-info\");\n\n    seen = [];\n    proxy = createServer((req, res) => {\n      const auth = req.headers[\"proxy-authorization\"];\n      seen.push({ url: req.url ?? \"\", auth });\n      if (auth !== `Basic ${Buffer.from(`x:${TOKEN}`).toString(\"base64\")}`) {\n        res.writeHead(407, { \"proxy-authenticate\": 'Basic realm=\"onecli\"' });\n        res.end();\n        return;\n      }\n      const file = join(served, new URL(req.url ?? \"/\", \"http://x\").pathname);\n      if (!file.startsWith(served) || !existsSync(file)) {\n        res.writeHead(404);\n        res.end();\n        return;\n      }\n      res.writeHead(200);\n      createReadStream(file).pipe(res);\n    });\n    await new Promise<void>((resolve) => proxy.listen(0, \"127.0.0.1\", resolve));\n    proxyUrl = `http://127.0.0.1:${String((proxy.address() as AddressInfo).port)}`;\n    // The session's env, as pi-env's shellEnv would carry it; plain-http proxy so no TLS is needed here.\n    const shellEnv = {\n      ...buildShellEnv({ gateway: proxyUrl, token: new Redacted(TOKEN) }),\n      http_proxy: `http://x:${TOKEN}@${proxyUrl.slice(\"http://\".length)}`,\n      GIT_CONFIG_GLOBAL: \"/dev/null\",\n      GIT_CONFIG_SYSTEM: \"/dev/null\",\n    };\n    env = new NodeExecutionEnv({ cwd: root, shellEnv });\n  });\n\n  afterEach(async () => {\n    await new Promise((resolve) => proxy.close(resolve));\n    await rm(dir, { recursive: true, force: true });\n  });\n\n  it(\"clones through the proxy with the session's token, then writes the marker and the CA bundle\", async () => {\n    expect(await run()).toBe(\"cloned\");\n    expect(await readFile(join(root, \"repo\", \"README.md\"), \"utf8\")).toBe(\"hello\\n\");\n    expect(existsSync(join(root, \".clone-tmp\"))).toBe(false);\n    const marker = JSON.parse(await readFile(join(root, \".pi-workspace.json\"), \"utf8\")) as Record<\n      string,\n      unknown\n    >;\n    expect(marker).toMatchObject({ version: 1, sessionId: \"s-1\", repo: \"octo/hello\" });\n    expect(await readFile(join(root, \".onecli\", \"ca.pem\"), \"utf8\")).toBe(ca);\n    expect(await readFile(join(root, \".onecli\", \"bundle.pem\"), \"utf8\")).toContain(\"FAKE\");\n    // Every request carried the proxy credentials at once (proxyAuthMethod=basic): no 407 round trip.\n    expect(seen.length).toBeGreaterThan(0);\n    expect(seen.every((entry) => entry.auth !== undefined)).toBe(true);\n    // No credential ended up in the repository's config.\n    expect(git(join(root, \"repo\"), \"config\", \"remote.origin.url\")).toBe(\n      \"http://git.example.test/octo/hello.git\\n\",\n    );\n  });\n\n  it(\"is idempotent: a second call finds the clone and makes no request\", async () => {\n    await run();\n    const requests = seen.length;\n    expect(await run({ wasReady: true })).toBe(\"present\");\n    expect(seen.length).toBe(requests);\n  });\n\n  it(\"clones the requested branch\", async () => {\n    await run({ branch: \"dev\" });\n    expect(git(join(root, \"repo\"), \"rev-parse\", \"--abbrev-ref\", \"HEAD\")).toBe(\"dev\\n\");\n  });\n\n  it(\"replaces a half-finished clone left by a crash\", async () => {\n    await mkdir(join(root, \".clone-tmp\", \"junk\"), { recursive: true });\n    expect(await run()).toBe(\"cloned\");\n    expect(existsSync(join(root, \"repo\", \".git\"))).toBe(true);\n    expect(existsSync(join(root, \".clone-tmp\"))).toBe(false);\n  });\n\n  it(\"does not clone again when the session was ready but the workspace is gone\", async () => {\n    await expect(run({ wasReady: true })).rejects.toBeInstanceOf(WorkspaceLostError);\n    expect(seen).toEqual([]);\n    expect(existsSync(join(root, \"repo\"))).toBe(false);\n  });\n\n  it(\"leaves nothing behind when the clone fails\", async () => {\n    const wrong = new NodeExecutionEnv({\n      cwd: root,\n      shellEnv: {\n        http_proxy: proxyUrl,\n        GIT_CONFIG_GLOBAL: \"/dev/null\",\n        GIT_CONFIG_SYSTEM: \"/dev/null\",\n      },\n    });\n    await expect(\n      prepareWorkspace(\n        wrong,\n        { repo: \"octo/hello\" },\n        { ca, sessionId: \"s-1\", wasReady: false, root, gitBase: \"http://git.example.test\" },\n      ),\n    ).rejects.toThrow(/git clone failed/);\n    expect(existsSync(join(root, \"repo\"))).toBe(false);\n    expect(existsSync(join(root, \".clone-tmp\"))).toBe(false);\n    expect(existsSync(join(root, \".pi-workspace.json\"))).toBe(false);\n  });\n});\n","isError":false}]}
