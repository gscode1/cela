ENTRY 11857 {"id":11857,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/ingest/src/server.ts:34:  orchestratorUrl: string;\npackages/ingest/src/server.ts:129:    proxyStream(req, res, deps.orchestratorUrl, session.id);\npackages/ingest/src/server.ts:269:  orchestratorUrl: string,\npackages/ingest/src/server.ts:272:  const target = new URL(`/sessions/${sessionId}/stream`, orchestratorUrl);\npackages/ingest/src/config.ts:10:  orchestratorUrl: string;\npackages/ingest/src/config.ts:17:export function loadConfig(env: Readonly<Record<string, string | undefined>>): IngestConfig {\npackages/ingest/src/config.ts:22:  const port = Number(env.PI_INGEST_PORT ?? \"8080\");\npackages/ingest/src/config.ts:24:    throw new Error(\"PI_INGEST_PORT is invalid\");\npackages/ingest/src/config.ts:29:    orchestratorUrl: env.PI_ORCH_URL ?? \"http://pi-orchestrator:8081\",\npackages/ingest/src/main.ts:12:  const config = loadConfig(process.env);\npackages/ingest/src/main.ts:14:  const pool = createPool(config.databaseUrl, config.instance, 5);\npackages/ingest/src/main.ts:21:    orchestratorUrl: config.orchestratorUrl,\npackages/ingest/src/main.ts:29:  log(\"listening\", { instance: config.instance, port: config.port });\npackages/ingest/src/main.ts:39:        log(\"migrated\", { instance: config.instance });\npackages/ingest/test/server.test.ts:19:    orchestratorUrl: \"http://unused\",\npackages/ingest/test/delete.test.ts:18:    orchestratorUrl: \"http://unused\",\nimport {\n  applyMigrations,\n  createPool,\n  errorMessage,\n  tokenAuthenticator,\n} from \"@pi-durable-k8s/session-core\";\nimport { loadConfig } from \"./config.js\";\nimport { log } from \"./log.js\";\nimport { createIngestServer } from \"./server.js\";\n\nasync function main(): Promise<void> {\n  const config = loadConfig(process.env);\n  const authenticate = tokenAuthenticator(config.apiTokens);\n  const pool = createPool(config.databaseUrl, config.instance, 5);\n\n  let schemaReady = false;\n  const state = { stopping: false };\n  const server = createIngestServer({\n    pool,\n    authenticate,\n    orchestratorUrl: config.orchestratorUrl,\n    models: config.models,\n    schemaReady: () => schemaReady,\n  });\n  // Long-lived SSE responses must not be cut by Node's default request timeouts.\n  server.requestTimeout = 0;\n  server.headersTimeout = 60_000;\n  await new Promise<void>((resolve) => server.listen(config.port, resolve));\n  log(\"listening\", { instance: config.instance, port: config.port });\n\n  // The inbox schema is ingest's own precondition: it must accept events while the orchestrator is down. The server\n  // is already up, so /healthz answers while a migration waits for a lock (a liveness failure would only restart\n  // the pod into the same wait). Retry instead of crashing; /readyz stays 503 until it succeeds.\n  void (async () => {\n    while (!state.stopping) {\n      try {\n        await applyMigrations(pool);\n        schemaReady = true;\n        log(\"migrated\", { instance: config.instance });\n        return;\n      } catch (error) {\n        log(\"migrate-failed\", { message: errorMessage(error) });\n        await new Promise((resolve) => setTimeout(resolve, 2_000));\n      }\n    }\n  })();\n\n  const shutdown = (signal: string): void => {\n    log(\"shutdown\", { signal });\n    state.stopping = true;\n    server.close();\n    server.closeAllConnections();\n    void pool.end().finally(() => process.exit(0));\n    setTimeout(() => process.exit(0), 5_000).unref();\n  };\n  process.on(\"SIGTERM\", () => shutdown(\"SIGTERM\"));\n  process.on(\"SIGINT\", () => shutdown(\"SIGINT\"));\n}\n\nmain().catch((error: unknown) => {\n  log(\"fatal\", { message: errorMessage(error) });\n  process.exit(1);\n});\nimport { randomUUID } from \"node:crypto\";\nimport type { EventKind } from \"@pi-durable-k8s/session-core\";\n\nconst MAX_TEXT = 64 * 1024;\nconst MAX_SOURCE_EVENT_ID = 200;\n\nexport interface ParsedEvent {\n  kind: Exclude<EventKind, \"delete\">;\n  payload: { text?: string };\n  sourceEventId: string;\n}\n\n/** Validates the body of POST /sessions/{id}/events. Returns an error string for the 400 response. */\nexport function parseEventBody(body: Record<string, unknown>): ParsedEvent | string {\n  const { kind, text, sourceEventId } = body;\n  if (kind === \"delete\") return \"use DELETE /sessions/{id} to delete a session\";\n  if (kind !== \"message\" && kind !== \"steer\" && kind !== \"cancel\") {\n    return \"kind must be message, steer or cancel\";\n  }\n  if (kind !== \"cancel\") {\n    if (typeof text !== \"string\" || text.trim() === \"\") return `${kind} needs a non-empty text`;\n    if (text.length > MAX_TEXT) return `text is longer than ${String(MAX_TEXT)} characters`;\n  } else if (text !== undefined) {\n    return \"cancel takes no text\";\n  }\n  if (sourceEventId !== undefined) {\n    if (\n      typeof sourceEventId !== \"string\" ||\n      sourceEventId === \"\" ||\n      sourceEventId.length > MAX_SOURCE_EVENT_ID\n    ) {\n      return `sourceEventId must be a string of 1 to ${String(MAX_SOURCE_EVENT_ID)} characters`;\n    }\n  }\n  return {\n    kind,\n    payload: typeof text === \"string\" ? { text } : {},\n    // Without a client-supplied id every post is its own event: there is nothing to deduplicate on.\n    sourceEventId: typeof sourceEventId === \"string\" ? sourceEventId : `auto-${randomUUID()}`,\n  };\n}\n","isError":false}]}
