ENTRY 11824 {"id":11824,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"import { loadModelPolicy } from \"@pi-durable-k8s/session-core\";\nimport type { ModelPolicy } from \"@pi-durable-k8s/session-core\";\n\n/** Environment contract of ingest. The database URL and the API tokens are secrets: env-only, never logged. */\nexport interface IngestConfig {\n  databaseUrl: string;\n  /** `owner:token` entries, see session-core `tokenAuthenticator`. */\n  apiTokens: string;\n  /** Base URL of the orchestrator's stream endpoint. */\n  orchestratorUrl: string;\n  port: number;\n  instance: string;\n  /** Default model and allowlist for POST /sessions (same variables as the orchestrator, from one ConfigMap). */\n  models: ModelPolicy;\n}\n\nexport function loadConfig(env: Readonly<Record<string, string | undefined>>): IngestConfig {\n  const databaseUrl = env.PI_DURABLE_DATABASE_URL;\n  if (!databaseUrl) throw new Error(\"PI_DURABLE_DATABASE_URL is required\");\n  const apiTokens = env.PI_API_TOKENS;\n  if (!apiTokens) throw new Error(\"PI_API_TOKENS is required\");\n  const port = Number(env.PI_INGEST_PORT ?? \"8080\");\n  if (!Number.isInteger(port) || port < 0 || port > 65535) {\n    throw new Error(\"PI_INGEST_PORT is invalid\");\n  }\n  return {\n    databaseUrl,\n    apiTokens,\n    orchestratorUrl: env.PI_ORCH_URL ?? \"http://pi-orchestrator:8081\",\n    port,\n    instance: env.POD_NAME ?? `ingest-${String(process.pid)}`,\n    models: loadModelPolicy(env),\n  };\n}\n---numbered---\n     1\timport { loadModelPolicy } from \"@pi-durable-k8s/session-core\";\n     2\timport type { ModelPolicy } from \"@pi-durable-k8s/session-core\";\n     3\t\n     4\t/** Environment contract of ingest. The database URL and the API tokens are secrets: env-only, never logged. */\n     5\texport interface IngestConfig {\n     6\t  databaseUrl: string;\n     7\t  /** `owner:token` entries, see session-core `tokenAuthenticator`. */\n     8\t  apiTokens: string;\n     9\t  /** Base URL of the orchestrator's stream endpoint. */\n    10\t  orchestratorUrl: string;\n    11\t  port: number;\n    12\t  instance: string;\n    13\t  /** Default model and allowlist for POST /sessions (same variables as the orchestrator, from one ConfigMap). */\n    14\t  models: ModelPolicy;\n    15\t}\n    16\t\n    17\texport function loadConfig(env: Readonly<Record<string, string | undefined>>): IngestConfig {\n    18\t  const databaseUrl = env.PI_DURABLE_DATABASE_URL;\n    19\t  if (!databaseUrl) throw new Error(\"PI_DURABLE_DATABASE_URL is required\");\n    20\t  const apiTokens = env.PI_API_TOKENS;\n    21\t  if (!apiTokens) throw new Error(\"PI_API_TOKENS is required\");\n    22\t  const port = Number(env.PI_INGEST_PORT ?? \"8080\");\n    23\t  if (!Number.isInteger(port) || port < 0 || port > 65535) {\n    24\t    throw new Error(\"PI_INGEST_PORT is invalid\");\n    25\t  }\n    26\t  return {\n    27\t    databaseUrl,\n    28\t    apiTokens,\n    29\t    orchestratorUrl: env.PI_ORCH_URL ?? \"http://pi-orchestrator:8081\",\n    30\t    port,\n    31\t    instance: env.POD_NAME ?? `ingest-${String(process.pid)}`,\n    32\t    models: loadModelPolicy(env),\n    33\t  };\n    34\t}\n","isError":false}]}
