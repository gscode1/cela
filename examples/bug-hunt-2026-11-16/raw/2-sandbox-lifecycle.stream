b.query<{ conversation_id: string }>(\n   322\t    \"select conversation_id from inbox.sessions where exec_in_flight_at is not null and conversation_id is not null and status in ('active', 'failed', 'deleting')\",\n   323\t  );\n   324\t  return rows.map((row) => Number(row.conversation_id));\n   325\t}\n   326\t\n   327\t/** What the orphan sweep needs to know about every session: no owner, model or repo. */\n   328\texport interface SessionRef {\n   329\t  id: string;\n   330\t  status: SessionStatus;\n   331\t  conversationId: number | null;\n   332\t}\n   333\t\n   334\texport async function listSessionRefs(db: Pick<pg.Pool, \"query\">): Promise<SessionRef[]> {\n   335\t  const { rows } = await db.query<{\n   336\t    id: string;\n   337\t    status: SessionStatus;\n   338\t    conversation_id: string | null;\n   339\t  }>(\"select id, status, conversation_id from inbox.sessions\");\n   340\t  return rows.map((row) => ({\n   341\t    id: row.id,\n   342\t    status: row.status,\n   343\t    conversationId: row.conversation_id === null ? null : Number(row.conversation_id),\n   344\t  }));\n   345\t}\npackages/orchestrator/src/sessions.ts:162:      \"update inbox.sessions set conversation_id = $1 where id = $2 and conversation_id is null\",\npackages/orchestrator/src/main.ts:74:      \"select id from inbox.sessions where conversation_id = $1\",\npackages/orchestrator/src/main.ts:97:        \"select id from inbox.sessions where conversation_id = $1\",\npackages/session-core/src/store.ts:87:  conversationId: row.conversation_id === null ? null : Number(row.conversation_id),\npackages/session-core/src/store.ts:314:    \"update inbox.sessions set exec_in_flight_at = case when $2::boolean then clock_timestamp() else null end where conversation_id = $1\",\npackages/session-core/src/store.ts:343:    conversationId: row.conversation_id === null ? null : Number(row.conversation_id),\n","isError":false}]}
