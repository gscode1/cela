ENTRY 9467 {"id":9467,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"packages/orchestrator/src/sandboxes.ts:41:   * next one recycles that sandbox's Pod (see `Sandboxes.recycleAtStart`).\npackages/orchestrator/src/sandboxes.ts:43:  execInFlight?: (conversationId: number, inFlight: boolean) => Promise<void>;\npackages/orchestrator/src/sandboxes.ts:151:              await this.#hooks.execInFlight?.(conversationId, true);\npackages/orchestrator/src/sandboxes.ts:191:        await this.#hooks.execInFlight?.(conversationId, false);\npackages/orchestrator/src/sandboxes.ts:196:      void this.#hooks.execInFlight?.(conversationId, false).catch((error: unknown) => {\npackages/orchestrator/src/sandboxes.ts:235:  recycleAtStart(conversationIds: readonly number[]): void {\npackages/orchestrator/src/sandboxes.ts:239:        await this.#hooks.execInFlight?.(conversationId, false);\npackages/orchestrator/src/sandboxes.ts:376:  async closeAll(): Promise<void> {\npackages/orchestrator/src/host.ts:87:    recycleAtStart: readonly number[] = [],\npackages/orchestrator/src/host.ts:95:    sandboxes.recycleAtStart(recycleAtStart);\npackages/orchestrator/src/host.ts:302:    await this.#sandboxes.closeAll();\npackages/orchestrator/src/sweeper.ts:7:  listSessions: () => Promise<SessionRef[]>;\npackages/orchestrator/src/sweeper.ts:55:        d.listSessions(),\npackages/orchestrator/src/main.ts:104:    execInFlight: (conversationId, inFlight) => setExecInFlight(pool, conversationId, inFlight),\npackages/orchestrator/src/main.ts:108:  const recycleAtStart = await conversationsWithExecInFlight(pool);\npackages/orchestrator/src/main.ts:109:  if (recycleAtStart.length > 0) log(\"recycle-at-start\", { conversations: recycleAtStart });\npackages/orchestrator/src/main.ts:121:    recycleAtStart,\npackages/orchestrator/src/main.ts:140:  const sweeper = new OrphanSweeper({\npackages/orchestrator/src/main.ts:141:    listSessions: () => listSessionRefs(pool),\n","isError":false}]}
