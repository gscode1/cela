ENTRY 9487 {"id":9487,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"   115\t    return new Host(harness, sandboxes, storage);\n   116\t  }\n   117\t\n   118\t  /** Creates the conversation and its sandbox claim, then submits the script as the first input. */\n   119\t  async startSession(script: Script): Promise<{ id: number; claim: string }> {\n   120\t    const conversation = await this.#harness.createConversation(\n   121\t      {\n   122\t        ownership: { kind: \"ownerless\" },\n   123\t        agent: { model: { provider: \"faux\", modelId: \"faux-1\" }, cwd: WORKSPACE },\n   124\t      },\n   125\t      context,\n   126\t    );\n   127\t    const id = Number(conversation.id);\n   128\t    await this.#sandboxes.ensure(id);\n   129\t    await conversation.submit(\n   130\t      { type: \"input\", content: JSON.stringify(script), requestId: `start-${String(id)}` },\n   131\t      context,\n   132\t    );\n   133\t    log(\"session-started\", { id, claim: claimNameFor(id) });\n   134\t    return { id, claim: claimNameFor(id) };\n   135\t  }\n   136\t\n   137\t  /** A further input to an existing session; the model follows the newest script. False if unknown. */\n   138\t  async sendInput(id: number, script: Script): Promise<boolean> {\n   139\t    const conversation = await this.#harness.conversation(id as ConversationId, context);\n   140\t    if (conversation === undefined) return false;\n219-\n220-  /**\n221-   * Before the first turn of a repo session: provision, then clone through the session's env. Returns quickly once\n222-   * done in this process; after a restart it runs again, which re-mints the token and finds the clone present.\n223-   */\n224:  async prepare(session: SessionRow, env: WorkspaceEnv): Promise<void> {\n225-    const spec = session.repo;\n226-    if (spec === null) return;\n227-    await this.ensureAccess(session);\n228-    if (this.#prepared.has(session.id)) return;\n229-    let ca: string;\n230-    try {\n231-      ca = await readFile(this.#deps.caFile, \"utf8\");\n232-    } catch {\n233-      throw new RepoUnavailableError(`the OneCLI CA is not available at ${this.#deps.caFile}`);\n234-    }\n235-    const outcome = await prepareWorkspace(env, spec, {\n236-      ca,\n237-      sessionId: session.id,\n238-      wasReady: session.workspaceReadyAt !== null,\n239-      ...(this.#deps.gitBase === undefined ? {} : { gitBase: this.#deps.gitBase }),\n240-    });\n241-    await markWorkspaceReady(this.#deps.pool, session.id);\n242-    this.#prepared.add(session.id);\n243-    // `workspace-cloned` once per session; `workspace-present` after a restart. tests/e2e/run-phase4c.sh greps both.\n244-    log(outcome === \"cloned\" ? \"workspace-cloned\" : \"workspace-present\", {\n245-      session: session.id,\n246-      repo: spec.repo,\n247-    });\n248-  }\n249-\n250-  /**\n251-   * Revokes everything the session held in OneCLI: the agent first (its token fails at once), then the secrets.\n252-   * Looks objects up by name as well as by stored id, so a crash between creating an object and storing its id\n253-   * cannot leave one behind. Idempotent. A plain session has nothing and makes no OneCLI call.\n254-   */\n255-  async teardown(session: SessionRow): Promise<void> {\n256-    if (session.repo === null) return;\n257-    const { onecli } = this.#deps;\n258-    this.#forget(session.id);\n259-    if (onecli === undefined) {\n260-      if (session.onecli === null) return;\n261-      throw new Error(\"cannot revoke the session's OneCLI agent: ONECLI_API_KEY is not set\");\n262-    }\n263-    await this.#revoke(session.id, session.onecli?.agentId, session.onecli?.secretIds ?? []);\n264-    log(\"repo-access-revoked\", { session: session.id });\n265-  }\n266-\n267-  /**\n268-   * The orphan sweep's revoke: removes whatever OneCLI still holds under this session's names (agent first, then the\n269-   * secrets), with no session row needed. Nothing is stored for a session that is deleted or unknown.\n270-   */\n271-  async revokeSession(sessionId: string): Promise<void> {\n272-    this.#forget(sessionId);\n273-    await this.#revoke(sessionId, undefined, []);\n274-  }\n275-\n276-  async #revoke(\n277-    sessionId: string,\n278-    agentId: string | undefined,\n279-    secretIds: readonly string[],\n280-  ): Promise<void> {\n281-    const { onecli } = this.#deps;\n282-    if (onecli === undefined) return;\n283-    const agents = (await onecli.listAgents())\n284-      .filter((a) => a.identifier === agentIdentifier(sessionId))\n285-      .map((a) => a.id);\n286-    for (const id of new Set([...(agentId === undefined ? [] : [agentId]), ...agents])) {\n287-      await onecli.deleteAgent(id);\n288-    }\n289-    const names = new Set(SECRET_SUFFIXES.map((s) => secretName(sessionId, s.suffix)));\n290-    const named = (await onecli.listSecrets()).filter((s) => names.has(s.name)).map((s) => s.id);\n291-    for (const id of new Set([...secretIds, ...named])) {\n292-      try {\n293-        await onecli.deleteSecret(id);\n294-      } catch (error) {\n295-        if (!(error instanceof OneCliError && error.status === 404)) throw error;\n296-      }\n297-    }\n298-  }\n299-\n300-  #forget(sessionId: string): void {\n301-    this.#access.delete(sessionId);\n302-    this.#prepared.delete(sessionId);\n303-    for (const [conversationId, session] of this.#byConversation) {\n304-      if (session.id === sessionId) this.#byConversation.delete(conversationId);\n305-    }\n306-  }\n307-}\n    98\t  /** Stops the timers. Bridges and sandboxes stay as they are. */\n    99\t  stop(): void {\n   100\t    for (const timer of this.#timers) clearInterval(timer);\n   101\t  }\n   102\t\n   103\t  #evictIdle(idleMs: number): void {\n   104\t    const now = Date.now();\n   105\t    for (const [conversationId, usage] of this.#usage) {\n   106\t      if (usage.inUse > 0 || now - usage.lastUsed < idleMs) continue;\n   107\t      const opened = this.#envs.get(conversationId);\n   108\t      this.#usage.delete(conversationId);\n   109\t      this.#envs.delete(conversationId);\n   110\t      void opened?.then((env) => {\n   111\t        env.close();\n   112\t        log(\"sandbox-env-evicted\", { claim: claimNameFor(conversationId) });\n   113\t      });\n   114\t    }\n   115\t  }\n   129\t        return async (...args: unknown[]): Promise<unknown> => {\n   130\t          // Ending a run with no tool call must not open a sandbox just to clean it up.\n   131\t          if (property === \"cleanup\" && !this.#envs.has(conversationId)) return;\n   132\t          const usage = this.#usage.get(conversationId) ?? {\n   133\t            inUse: 0,\n   134\t            lastUsed: Date.now(),\n   135\t            recorded: false,\n   136\t          };\n   137\t          this.#usage.set(conversationId, usage);\n   138\t          usage.inUse++;\n   139\t          let outcome: { threw: true } | { threw: false; result: unknown } | undefined;\n   140\t          try {\n   141\t            // A recycle or suspend of this sandbox finishes first; the env opened below is then for the new Pod.\n   142\t            await this.#replacing.get(conversationId);\n   143\t            await this.#hooks.beforeUse?.(conversationId);\n   144\t            const real = (await this.ensure(conversationId)).env as unknown as Record<\n   145\t              string,\n   146\t              (...a: unknown[]) => unknown\n   147\t            >;\n   148\t            // Only commands can leave processes behind. Record that one may be running before it starts, so a\n   149\t            // crash in the middle is still known after the restart.\n   150\t            if (property === \"exec\" && !usage.recorded) {\n   151\t              await this.#hooks.execInFlight?.(conversationId, true);\n   152\t              usage.recorded = true;\n   153\t            }\n   154\t            try {\n   155\t              const result = await real[property]?.(...args);\n   156\t              outcome = { threw: false, result };\n   157\t              return result;\n   158\t            } catch (error) {\n   159\t              outcome = { threw: true };\n   160\t              throw error;\n   161\t            }\n   162\t          } finally {\n   163\t            usage.inUse--;\n   164\t            usage.lastUsed = Date.now();\n   165\t            this.#lastUsed.set(conversationId, usage.lastUsed);\n   166\t            if (property === \"exec\" && outcome !== undefined && interruptedExec(outcome)) {\n   167\t              this.#interrupted.add(conversationId);\n   168\t            }\n   169\t            if (usage.inUse === 0) this.#settle(conversationId, usage);\n   170\t          }\n   184\t  #settle(conversationId: number, usage: Usage): void {\n   185\t    if (this.#interrupted.has(conversationId) && !this.#replacing.has(conversationId)) {\n   186\t      this.#interrupted.delete(conversationId);\n   187\t      this.#replace(conversationId, \"interrupted\", async () => {\n   188\t        await this.#closeEnv(conversationId);\n   189\t        await recyclePod(this.#config.namespace, claimNameFor(conversationId));\n   190\t        // Cleared only now: if the recycle fails or the process dies first, the record is still there.\n   191\t        await this.#hooks.execInFlight?.(conversationId, false);\n   192\t        usage.recorded = false;\n   193\t      });\n   194\t    } else if (usage.recorded) {\n   195\t      usage.recorded = false;\n   196\t      void this.#hooks.execInFlight?.(conversationId, false).catch((error: unknown) => {\n   197\t        usage.recorded = true; // still recorded: the next settle clears it\n   198\t        log(\"exec-record-failed\", {\n   199\t          claim: claimNameFor(conversationId),\n   200\t          message: errorMessage(error),\n   201\t        });\n   202\t      });\n   203\t    }\n   204\t  }\n   205\t\n   206\t  /**\n   207\t   * Runs a Pod replacement (recycle) or suspension for a conversation's sandbox. Calls made meanwhile wait for it.\n   208\t   * A failure is logged and leaves the conversation to try again: an interrupted one stays queued.\n   209\t   */\n   210\t  #replace(\n   211\t    conversationId: number,\n   212\t    why: \"interrupted\" | \"orchestrator-restart\" | \"idle\",\n   213\t    work: () => Promise<void>,\n   214\t  ): void {\n   215\t    if (this.#replacing.has(conversationId)) return;\n   216\t    const claim = claimNameFor(conversationId);\n   217\t    const run = (async () => {\n   218\t      await work();\n   219\t      this.#lastUsed.delete(conversationId);\n   220\t      log(why === \"idle\" ? \"sandbox-suspended\" : \"sandbox-recycled\", { claim, why });\n   221\t    })()\n   222\t      .catch((error: unknown) => {\n   223\t        if (why !== \"idle\") this.#interrupted.add(conversationId);\n   224\t        log(\"sandbox-replace-failed\", { claim, why, message: errorMessage(error) });\n   225\t      })\n   226\t      .finally(() => this.#replacing.delete(conversationId));\n   227\t    this.#replacing.set(conversationId, run);\n   228\t  }\n   229\t\n   230\t  /**\n   231\t   * After a start: the conversations that had a command in flight when the previous process stopped. Their Pods are\n   232\t   * replaced before Pi Durable resumes (the caller invokes this first), so the continuing run finds a clean sandbox.\n   233\t   * Nothing is known about which of them really has a leftover child, so every one is recycled.\n   234\t   */\n   235\t  recycleAtStart(conversationIds: readonly number[]): void {\n   236\t    for (const conversationId of conversationIds) {\n   237\t      this.#replace(conversationId, \"orchestrator-restart\", async () => {\n   238\t        await recyclePod(this.#config.namespace, claimNameFor(conversationId));\n   239\t        await this.#hooks.execInFlight?.(conversationId, false);\n   240\t      });\n   241\t    }\n   242\t  }\n   243\t\n   244\t  async #closeEnv(conversationId: number): Promise<void> {\n   245\t    const opened = this.#envs.get(conversationId);\n   246\t    if (this.#usage.get(conversationId)?.inUse === 0) this.#usage.delete(conversationId);\n   247\t    this.#envs.delete(conversationId);\n   248\t    if (opened !== undefined) (await opened.catch(() => undefined))?.close();\n   251\t  /** Suspends the sandboxes that have been idle for `idleSuspendMs`. Never throws: it runs on a timer. */\n   252\t  async #suspendIdle(): Promise<void> {\n   253\t    try {\n   254\t      const sandboxes = await listSandboxes(this.#config.namespace);\n   255\t      const now = Date.now();\n   256\t      const busy = new Set<number>(this.#replacing.keys());\n   257\t      for (const [conversationId, usage] of this.#usage)\n   258\t        if (usage.inUse > 0) busy.add(conversationId);\n   259\t      for (const sandbox of sandboxes) {\n   260\t        const conversationId = conversationOfName(sandbox.name);\n   261\t        if (conversationId !== undefined && sandbox.mode === \"Suspended\")\n   262\t          this.#lastUsed.delete(conversationId);\n   263\t      }\n   264\t      const plan = planSuspend({\n   265\t        running: sandboxes.filter((s) => s.mode === \"Running\").map((s) => s.name),\n   266\t        lastUsed: this.#lastUsed,\n   267\t        busy,\n   268\t        now,\n   269\t        afterMs: this.#config.sandbox.idleSuspendMs,\n   270\t      });\n   271\t      for (const conversationId of plan.seen) this.#lastUsed.set(conversationId, now);\n   272\t      for (const conversationId of plan.suspend) {\n   273\t        this.#replace(conversationId, \"idle\", async () => {\n   274\t          await this.#closeEnv(conversationId);\n   275\t          await suspendSandbox(this.#config.namespace, claimNameFor(conversationId));\n   276\t        });\n   277\t      }\n   278\t    } catch (error) {\n   283\t  /** Creates or adopts the claim and waits for its Sandbox; safe to call on every start. */\n   284\t  async ensure(conversationId: number): Promise<SandboxEnv> {\n   285\t    let env = this.#envs.get(conversationId);\n   286\t    if (env === undefined) {\n   287\t      env = this.#open(conversationId);\n   288\t      this.#envs.set(conversationId, env);\n   289\t      // A failed open must not be cached: the next tool call tries again.\n   290\t      env.catch(() => this.#envs.delete(conversationId));\n   291\t    }\n   292\t    return env;\n   353\t  async destroyOrphan(claimName: string, sessionLabel: string): Promise<void> {\n   354\t    const conversationId = conversationOfName(claimName);\n   355\t    if (conversationId === undefined) throw new Error(`${claimName} is not a conversation claim`);\n   356\t    await this.#teardown(conversationId, sessionLabel);\n   357\t  }\n   358\t\n   359\t  async #teardown(conversationId: number, sessionKey: string): Promise<void> {\n   360\t    await this.#replacing.get(conversationId);\n   361\t    this.#interrupted.delete(conversationId);\n   362\t    this.#lastUsed.delete(conversationId);\n   363\t    const opened = this.#envs.get(conversationId);\n   364\t    this.#usage.delete(conversationId);\n   365\t    this.#envs.delete(conversationId);\n   366\t    if (opened !== undefined) {\n   367\t      const env = await opened.catch(() => undefined);\n   368\t      env?.close();\n   369\t    }\n   370\t    const claimName = claimNameFor(conversationId);\n   371\t    await deleteClaimAndPvc(this.#config.namespace, claimName, sessionKey);\n   142\t  // Never delete a claim that is not this session's (`get` is already granted for the SDK).\n   143\t  try {\n   144\t    const found: unknown = await custom.getNamespacedCustomObject(claim);\n   145\t    if (labelOf(found) !== sessionKey) {\n   146\t      throw new Error(\n   147\t        `SandboxClaim ${claimName} is not labelled for this session: not deleting it`,\n   148\t      );\n   149\t    }\n   150\t  } catch (error) {\n   151\t    if (statusOf(error) !== 404) throw error;\n   152\t  }\n   153\t  // Only `delete` is needed: a delete that answers 404 means the object is gone. The PVC is deleted only once\n   154\t  // the claim is gone, so the Sandbox controller cannot recreate it from a Sandbox that still exists.\n   155\t  const deadline = Date.now() + timeoutMs;\n   156\t  for (;;) {\n   157\t    const claimPresent = await ignoreNotFound(custom.deleteNamespacedCustomObject(claim));\n   158\t    const pvcPresent = claimPresent\n   159\t      ? true\n   160\t      : await ignoreNotFound(core.deleteNamespacedPersistentVolumeClaim(pvc));\n   161\t    if (!claimPresent && !pvcPresent) return;\n   162\t    if (Date.now() > deadline) {\n   163\t      throw new Error(\n   164\t        `timed out deleting ${claimName}: claim ${claimPresent ? \"present\" : \"gone\"}, pvc ${pvcPresent ? \"present\" : \"gone\"}`,\n   165\t      );\n   166\t    }\n   167\t    await sleep(2_000);\n   168\t  }\n    50\t    this.#running = true;\n    51\t    const done: SweepAction[] = [];\n    52\t    try {\n    53\t      const d = this.#deps;\n    54\t      const [sessions, claims, pvcs, oneCli] = await Promise.all([\n    55\t        d.listSessions(),\n    56\t        d.listClaims(),\n    57\t        d.listPvcs(),\n    58\t        d.listOneCli?.(),\n    59\t      ]);\n    60\t      const actions = planSweep({\n    61\t        sessions,\n    62\t        claims,\n    63\t        pvcs,\n    64\t        agents: oneCli?.agents,\n    65\t        secrets: oneCli?.secrets ?? [],\n    66\t        now: d.now?.() ?? Date.now(),\n    67\t        graceMs: d.graceMs,\n    68\t        maxActions: d.maxActions,\n    69\t      });\n    70\t      for (const action of actions) {\n    71\t        try {\n    72\t          await this.#apply(action);\n    73\t          log(\"sweep-action\", { ...action });\n    74\t          done.push(action);\n    75\t        } catch (error) {\n","isError":false}]}
ENTRY 9490 {"id":9490,"kind":"pi.assistant","messages":[{"role":"assistant","text":"[thinking]## Findings\n\n### 1. Orphan deletion can delete a newly created claim or an in-use PVC\n- Severity: high\n- Confidence: high\n- Location: packages/orchestrator/src/kube.ts:142\n- What happens: For a lone-PVC sweep, the claim can be absent at the initial GET and then be created by a live session before the DELETE. The loop deletes that new claim without checking its label. Alternatively, the claim can appear after the claim DELETE returns 404 but before the PVC DELETE, so the sweep deletes the workspace the new claim is using. The same unchecked loop can delete a replacement claim after an initially matching claim disappears.\n- Evidence: The label is checked once with `getNamespacedCustomObject`; subsequently the loop calls `deleteNamespacedCustomObject(claim)` and, on 404, `deleteNamespacedPersistentVolumeClaim(pvc)`.\n- Fix idea: Coordinate creation and teardown per claim, including across ownership changes. Bind claim deletion to the checked UID and resource version, and protect the PVC deletion against a claim appearing before it completes.\n\n### 2. Repository preparation bypasses lifecycle tracking\n- Severity: high\n- Confidence: high\n- Location: packages/orchestrator/src/host.ts:279\n- What happens: Repository preparation obtains the raw environment rather than the tracked proxy. A clone or other preparation operation can therefore run while an idle-suspend or recycle operation closes its bridge or deletes its Pod. These opens also create no usage entry, so a bridge opened solely for repository preparation is not visited by idle eviction and can remain until shutdown.\n- Evidence: `workspaceEnv` returns `(await this.#sandboxes.ensure(id)).env`; `sessions.ts` passes it to `repos.prepare`, while eviction iterates `#usage` and busy tracking is performed in `lazyEnv`.\n- Fix idea: Route workspace preparation through the same tracked, replacement-aware environment as tool calls. Ensure every opened bridge is registered for eviction.\n\n### 3. Failed recycling allows calls into a potentially dirty sandbox\n- Severity: high\n- Confidence: high\n- Location: packages/orchestrator/src/sandboxes.ts:222\n- What happens: If Pod recycling fails after an interrupted command or during restart recovery, the replacement promise catches the error and resolves. A waiting tool call then proceeds into the sandbox even though an escaped child may still be running. The interrupted marker is retried only after that call settles, rather than preventing the call.\n- Evidence: The catch adds the conversation to `#interrupted` but does not rethrow; callers `await this.#replacing.get(conversationId)` before opening the environment.\n- Fix idea: Keep the sandbox unavailable until recycling succeeds, or propagate the failure to waiting calls and retry recycling before admitting another call.\n\n### 4. Clearing the in-flight record races with the next command\n- Severity: medium\n- Confidence: high\n- Location: packages/orchestrator/src/sandboxes.ts:194\n- What happens: After one command finishes, its asynchronous database clear is not awaited. A new command can set the record to true, then the earlier clear can complete afterward and set it to false while the new command is running. If the orchestrator crashes then, restart recovery has no record requiring the Pod to be recycled.\n- Evidence: `usage.recorded = false; void this.#hooks.execInFlight?.(conversationId, false)` runs independently of the next call’s awaited `execInFlight(..., true)`.\n- Fix idea: Serialize record updates per conversation and prevent a stale clear from overtaking a new set.\n\n### 5. Noncanonical sweep names can target a different workspace\n- Severity: high\n- Confidence: high\n- Location: packages/orchestrator/src/sandboxes.ts:353\n- What happens: The sweep accepts names such as `pi-conv-01`, but converts the suffix to a number and reconstructs `pi-conv-1` for teardown. A planned deletion of `workspace-pi-conv-01` can consequently delete `workspace-pi-conv-1` if its claim is absent, even when conversation 1 is live. Teardown can also close conversation 1’s bridge before the claim-label check rejects a mismatched claim.\n- Evidence: `conversationOfName` uses `Number(match[1])`; `destroyOrphan` passes that number to `#teardown`, which calls `claimNameFor(conversationId)`.\n- Fix idea: Require canonical decimal names before planning or executing a sweep, and retain the exact resource name through deletion rather than reconstructing it.\n\n## Areas checked with no findings\n- Per-claim token adoption: existing claims are checked for both the session label and the expected token hash, including after a create conflict.\n- Failed session-list queries: a rejected query aborts the sweep before actions are planned.\n- Timer shutdown: the normal close path stops the sandbox timers and closes cached bridges.\n\nEND-OF-REPORT"}]}
