ENTRY 9535 {"id":9535,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"==== packages/sandbox-env/src/bridge.ts\n     1\timport type { Readable, Writable } from \"node:stream\";\n     2\t\n     3\t/** A process started inside a sandbox. Implemented by sandbox-client.ts and by test fakes. */\n     4\texport interface RemoteProcess {\n     5\t  /** Resolves when the bytes are delivered. A rejection leaves an unknown prefix delivered. */\n     6\t  write(data: Uint8Array): Promise<void>;\n     7\t  closeStdin(): Promise<void>;\n     8\t  wait(): Promise<{ exitCode: number }>;\n     9\t  /** Tears the stream down; sandboxd kills the process group. Idempotent. */\n    10\t  close(): Promise<void>;\n    11\t}\n    12\t\n    13\texport interface OutputHandlers {\n    14\t  onStdout(chunk: Uint8Array): void;\n    15\t  onStderr(chunk: Uint8Array): void;\n    16\t}\n    17\t\n    18\texport type StartProcess = (\n    19\t  command: string,\n    20\t  args: readonly string[],\n    21\t  handlers: OutputHandlers,\n    22\t) => Promise<RemoteProcess>;\n    23\t\n    24\t/** Written to the bridge's stderr once the remote process is running. */\n    25\texport const BRIDGE_READY = \"bridge: ready\";\n    26\t\n    27\texport interface BridgeOptions {\n    28\t  start: StartProcess;\n    29\t  command: string;\n    30\t  args: readonly string[];\n    31\t  stdin: Readable;\n    32\t  stdout: Writable;\n    33\t  stderr: Writable;\n    34\t}\n    35\t\n    36\ttype Outcome =\n    37\t  { kind: \"exit\"; exitCode: number } | { kind: \"stdin-done\" } | { kind: \"fatal\"; reason: string };\n    38\t\n    39\t/** Remote codes outside 1..255 (signal deaths, negatives) must still read as failure. */\n    40\tfunction toExitCode(exitCode: number): number {\n    41\t  if (exitCode === 0) return 0;\n    42\t  return Number.isInteger(exitCode) && exitCode > 0 && exitCode <= 255 ? exitCode : 1;\n    43\t}\n    44\t\n    45\tfunction describe(error: unknown): string {\n    46\t  return error instanceof Error ? error.message : String(error);\n    47\t}\n    48\t\n    49\tfunction flush(stream: Writable): Promise<void> {\n    50\t  return new Promise((resolve) => stream.write(new Uint8Array(0), () => resolve()));\n    51\t}\n    52\t\n    53\t/**\n    54\t * Pipes stdin to the remote process and its stdout to ours, byte for byte, and returns the exit code\n    55\t * the bridge should exit with. Stdin writes are awaited one at a time: the SDK sends each as its own\n    56\t * RPC, and concurrent RPCs could reorder bytes inside a pi-env frame. Any write failure or stream\n    57\t * loss is fatal because a half-delivered frame cannot be repaired; pi-env's Connection restarts us.\n    58\t */\n    59\texport async function runBridge(options: BridgeOptions): Promise<number> {\n    60\t  const { stdin, stdout, stderr } = options;\n    61\t  let proc: RemoteProcess;\n    62\t  try {\n    63\t    proc = await options.start(options.command, options.args, {\n    64\t      onStdout: (chunk) => void stdout.write(chunk),\n    65\t      onStderr: (chunk) => void stderr.write(chunk),\n    66\t    });\n    67\t  } catch (error) {\n    68\t    stderr.write(`bridge: cannot start ${options.command}: ${describe(error)}\\n`);\n    69\t    return 1;\n    70\t  }\n    71\t  // Tells the parent that the cold start (the CPU-heavy part) is over; see StartGate.\n    72\t  stderr.write(`${BRIDGE_READY}\\n`);\n    73\t\n    74\t  const exited = proc.wait().then(\n    75\t    (result): Outcome => ({ kind: \"exit\", exitCode: toExitCode(result.exitCode) }),\n    76\t    (error: unknown): Outcome => ({\n    77\t      kind: \"fatal\",\n    78\t      reason: `remote stream lost: ${describe(error)}`,\n    79\t    }),\n    80\t  );\n    81\t  const outputFailed = new Promise<Outcome>((resolve) =>\n    82\t    stdout.once(\"error\", (error) =>\n    83\t      resolve({ kind: \"fatal\", reason: `stdout write failed: ${describe(error)}` }),\n    84\t    ),\n    85\t  );\n    86\t  const pumped = (async (): Promise<Outcome> => {\n    87\t    try {\n    88\t      for await (const chunk of stdin) {\n    89\t        await proc.write(chunk as Uint8Array);\n    90\t      }\n    91\t      await proc.closeStdin();\n    92\t      return { kind: \"stdin-done\" };\n    93\t    } catch (error) {\n    94\t      return { kind: \"fatal\", reason: `stdin write failed: ${describe(error)}` };\n    95\t    }\n    96\t  })();\n    97\t\n    98\t  let outcome = await Promise.race([exited, pumped, outputFailed]);\n    99\t  if (outcome.kind === \"stdin-done\") {\n   100\t    // Stdin ended cleanly: pi-env exits on EOF, so wait for it.\n   101\t    outcome = await Promise.race([exited, outputFailed]);\n   102\t  }\n   103\t  try {\n   104\t    if (outcome.kind === \"fatal\") {\n   105\t      stderr.write(`bridge: ${outcome.reason}\\n`);\n   106\t      return 1;\n   107\t    }\n   108\t    if (outcome.kind === \"exit\") await flush(stdout);\n   109\t    return outcome.kind === \"exit\" ? outcome.exitCode : 1;\n   110\t  } finally {\n   111\t    await proc.close().catch(() => undefined);\n   112\t  }\n   113\t}\n==== packages/sandbox-env/src/cli.ts\n     1\t#!/usr/bin/env node\n     2\timport { runBridge } from \"./bridge.js\";\n     3\timport { parseBridgeArgs } from \"./config.js\";\n     4\timport { sandboxStart } from \"./sandbox-client.js\";\n     5\t\n     6\tasync function main(): Promise<number> {\n     7\t  let config;\n     8\t  try {\n     9\t    config = parseBridgeArgs(process.argv.slice(2), process.env);\n    10\t  } catch (error) {\n    11\t    process.stderr.write(`bridge: ${error instanceof Error ? error.message : String(error)}\\n`);\n    12\t    return 2;\n    13\t  }\n    14\t  return runBridge({\n    15\t    start: sandboxStart(config.target),\n    16\t    command: config.command,\n    17\t    args: config.args,\n    18\t    stdin: process.stdin,\n    19\t    stdout: process.stdout,\n    20\t    stderr: process.stderr,\n    21\t  });\n    22\t}\n    23\t\n    24\t// Set the code and let the loop drain: process.exit() could cut off buffered stdout.\n    25\t// A gRPC channel may keep the loop alive, so exit explicitly after a short grace period.\n    26\tvoid main().then((code) => {\n    27\t  process.exitCode = code;\n    28\t  setTimeout(() => process.exit(code), 200).unref();\n    29\t});\n==== packages/sandbox-env/src/config.ts\n     1\timport type { Connectivity, SandboxTarget } from \"./sandbox-client.js\";\n     2\t\n     3\t/**\n     4\t * Environment contract of the bridge. Flags (`--claim`, `--namespace`, `--connectivity`) take\n     5\t * precedence so one orchestrator process can run bridges for many claims; pi-env's Connection\n     6\t * inherits the parent environment and offers no per-connection env. The token is env-only, so it\n     7\t * never shows up in a process listing.\n     8\t */\n     9\texport const ENV = {\n    10\t  claim: \"PI_SANDBOX_CLAIM\",\n    11\t  namespace: \"PI_SANDBOX_NAMESPACE\",\n    12\t  connectivity: \"PI_SANDBOX_CONNECTIVITY\",\n    13\t  authToken: \"PI_SANDBOX_AUTH_TOKEN\",\n    14\t  /** Master key per-sandbox tokens derive from (token.ts). Orchestrator and e2e driver only, never a bridge. */\n    15\t  masterKey: \"PI_SANDBOX_MASTER_KEY\",\n    16\t  envBinary: \"PI_SANDBOX_ENV_BINARY\",\n    17\t} as const;\n    18\t\n    19\texport const DEFAULT_ENV_BINARY = \"/usr/local/bin/pi-env\";\n    20\t\n    21\tconst CONNECTIVITIES: readonly Connectivity[] = [\n    22\t  \"in-cluster-service\",\n    23\t  \"in-cluster-pod-ip\",\n    24\t  \"port-forward\",\n    25\t];\n    26\t\n    27\texport interface BridgeConfig {\n    28\t  target: SandboxTarget;\n    29\t  command: string;\n    30\t  /** Everything after the bridge's own flags, i.e. `serve --token <hex>` from pi-env. */\n    31\t  args: readonly string[];\n    32\t}\n    33\t\n    34\tconst FLAGS = new Map([\n    35\t  [\"--claim\", \"claim\"],\n    36\t  [\"--namespace\", \"namespace\"],\n    37\t  [\"--connectivity\", \"connectivity\"],\n    38\t] as const);\n    39\t\n    40\texport function parseBridgeArgs(\n    41\t  argv: readonly string[],\n    42\t  env: Readonly<Record<string, string | undefined>>,\n    43\t): BridgeConfig {\n    44\t  const flags: Partial<Record<\"claim\" | \"namespace\" | \"connectivity\", string>> = {};\n    45\t  let i = 0;\n    46\t  for (; i < argv.length; i++) {\n    47\t    const arg = argv[i];\n    48\t    const key = arg === undefined ? undefined : FLAGS.get(arg as \"--claim\");\n    49\t    if (key === undefined) break;\n    50\t    const value = argv[++i];\n    51\t    if (value === undefined) throw new Error(`${arg ?? \"flag\"} needs a value`);\n    52\t    flags[key] = value;\n    53\t  }\n    54\t  const args = argv.slice(i);\n    55\t  if (args[0] !== \"serve\") throw new Error(\"expected `serve --token <hex>` after the bridge flags\");\n    56\t\n    57\t  const claimName = flags.claim ?? env[ENV.claim];\n    58\t  if (!claimName) throw new Error(`sandbox claim missing: set ${ENV.claim} or pass --claim`);\n    59\t  const namespace = flags.namespace ?? env[ENV.namespace];\n    60\t  if (!namespace) throw new Error(`namespace missing: set ${ENV.namespace} or pass --namespace`);\n    61\t  const connectivity = flags.connectivity ?? env[ENV.connectivity] ?? \"in-cluster-service\";\n    62\t  if (!CONNECTIVITIES.includes(connectivity as Connectivity)) {\n    63\t    throw new Error(`connectivity must be one of ${CONNECTIVITIES.join(\", \")}`);\n    64\t  }\n    65\t  const authToken = env[ENV.authToken];\n    66\t  return {\n    67\t    target: {\n    68\t      claimName,\n    69\t      namespace,\n    70\t      connectivity: connectivity as Connectivity,\n    71\t      ...(authToken ? { authToken } : {}),\n    72\t    },\n    73\t    command: env[ENV.envBinary] || DEFAULT_ENV_BINARY,\n    74\t    args,\n    75\t  };\n    76\t}\n==== packages/sandbox-env/src/start-gate.ts\n     1\timport { BRIDGE_READY } from \"./bridge.js\";\n     2\t\n     3\t/**\n     4\t * Lets one bridge cold-start at a time. A bridge process loads the Kubernetes and gRPC clients before it\n     5\t * can answer pi-env's hello, which takes about 12 s of wall time on the orchestrator's 250m CPU limit.\n     6\t * Several at once share that CPU, each takes several times longer, and pi-env gives up on a connection\n     7\t * that stays silent for 30 s (\"pi-env connection timed out\"). Serialising the starts keeps each one fast.\n     8\t */\n     9\texport class StartGate {\n    10\t  readonly #maxHoldMs: number;\n    11\t  #tail: Promise<void> = Promise.resolve();\n    12\t\n    13\t  /** `maxHoldMs` frees the turn even if the holder never reports ready (a bridge that crashed early). */\n    14\t  constructor(maxHoldMs: number) {\n    15\t    this.#maxHoldMs = maxHoldMs;\n    16\t  }\n    17\t\n    18\t  /** Resolves on this caller's turn. The returned release hands the turn on; calling it again is a no-op. */\n    19\t  async acquire(): Promise<() => void> {\n    20\t    let release: () => void = () => undefined;\n    21\t    const mine = new Promise<void>((resolve) => {\n    22\t      release = resolve;\n    23\t    });\n    24\t    const previous = this.#tail;\n    25\t    this.#tail = previous.then(() => mine);\n    26\t    await previous;\n    27\t    const timer = setTimeout(release, this.#maxHoldMs);\n    28\t    timer.unref();\n    29\t    return () => {\n    30\t      clearTimeout(timer);\n    31\t      release();\n    32\t    };\n    33\t  }\n    34\t}\n    35\t\n    36\texport interface GatedStart {\n    37\t  /** For `ConnectionOptions.command`: waits for the gate, then yields the bridge argv. */\n    38\t  command: () => Promise<readonly string[]>;\n    39\t  /** For `ConnectionOptions.onLog`: frees the gate when the bridge reports ready. */\n    40\t  onLog: (text: string) => void;\n    41\t  /** Frees the gate if this connection still holds it (on close). */\n    42\t  release: () => void;\n    43\t}\n    44\t\n    45\t/** Wires one connection's bridge launches through `gate`; every respawn takes a new turn. */\n    46\texport function gatedStart(gate: StartGate, argv: readonly string[]): GatedStart {\n    47\t  let release: (() => void) | undefined;\n    48\t  const free = (): void => {\n    49\t    release?.();\n    50\t    release = undefined;\n    51\t  };\n    52\t  return {\n    53\t    command: async () => {\n    54\t      free();\n    55\t      release = await gate.acquire();\n    56\t      return argv;\n    57\t    },\n    58\t    onLog: (text) => {\n    59\t      if (text.includes(BRIDGE_READY)) free();\n    60\t    },\n    61\t    release: free,\n    62\t  };\n    63\t}\n==== packages/sandbox-env/src/sandbox-client.ts\n     1\t// The only module allowed to import the vendored Agent Sandbox SDK (see packages/vendor).\n     2\timport { SandboxClient } from \"agentic-sandbox-client\";\n     3\timport type { RemoteProcess, StartProcess } from \"./bridge.js\";\n     4\t\n     5\texport type Connectivity = \"in-cluster-service\" | \"in-cluster-pod-ip\" | \"port-forward\";\n     6\t\n     7\texport interface SandboxTarget {\n     8\t  claimName: string;\n     9\t  namespace: string;\n    10\t  connectivity: Connectivity;\n    11\t  /** Bearer token for sandboxd; plaintext on the wire with the in-cluster modes. */\n    12\t  authToken?: string;\n    13\t}\n    14\t\n    15\t/** Looks the SandboxClaim up on first use, so constructing this does no I/O. */\n    16\texport function sandboxStart(target: SandboxTarget): StartProcess {\n    17\t  return async (command, args, handlers) => {\n    18\t    const client = new SandboxClient({\n    19\t      namespace: target.namespace,\n    20\t      sandboxd: {\n    21\t        connectivity: target.connectivity,\n    22\t        ...(target.authToken === undefined ? {} : { authToken: target.authToken }),\n    23\t      },\n    24\t    });\n    25\t    // Release the handle with closeLocal(): Sandbox.close() also DELETES the SandboxClaim, which\n    26\t    // would destroy the session's sandbox (and its PVC) every time a bridge exits.\n    27\t    const sandbox = await client.getSandbox(target.claimName, target.namespace);\n    28\t    try {\n    29\t      // No pty: a terminal would merge stderr into stdout and mangle binary bytes.\n    30\t      const handle = await sandbox.commands.start(command, args, {\n    31\t        onStdout: (chunk) => {\n    32\t          handlers.onStdout(chunk);\n    33\t        },\n    34\t        onStderr: (chunk) => {\n    35\t          handlers.onStderr(chunk);\n    36\t        },\n    37\t      });\n    38\t      const process: RemoteProcess = {\n    39\t        write: (data) => handle.write(data),\n    40\t        closeStdin: () => handle.closeStdin(),\n    41\t        wait: () => handle.wait(),\n    42\t        close: async () => {\n    43\t          await handle.close();\n    44\t          await sandbox.closeLocal();\n    45\t        },\n    46\t      };\n    47\t      return process;\n    48\t    } catch (error) {\n    49\t      await sandbox.closeLocal();\n    50\t      throw error;\n    51\t    }\n    52\t  };\n    53\t}\n    54\t\n    55\texport interface ClaimRequest extends SandboxTarget {\n    56\t  /** SandboxWarmPool the claim references; a pool with `replicas: 0` is a plain template alias. */\n    57\t  warmPool: string;\n    58\t}\n    59\t\n    60\t/**\n    61\t * Creates the named SandboxClaim, or adopts it when it exists (create-or-attach, so a restarted\n    62\t * orchestrator calls it again for every session), and waits until its Sandbox is ready. The handle is\n    63\t * released with closeLocal(): only session deletion may delete a claim, and this module has no delete.\n    64\t */\n    65\texport async function ensureClaim(request: ClaimRequest): Promise<void> {\n    66\t  const client = new SandboxClient({\n    67\t    namespace: request.namespace,\n    68\t    sandboxd: {\n    69\t      connectivity: request.connectivity,\n    70\t      ...(request.authToken === undefined ? {} : { authToken: request.authToken }),\n    71\t    },\n    72\t  });\n    73\t  const sandbox = await client.createSandbox(request.warmPool, request.namespace, {\n    74\t    claimName: request.claimName,\n    75\t    adoptExisting: true,\n    76\t  });\n    77\t  await sandbox.closeLocal();\n    78\t}\n==== packages/sandbox-env/src/token.ts\n     1\timport { createHash, createHmac } from \"node:crypto\";\n     2\t\n     3\t/**\n     4\t * Name of the container env var the SandboxClaim sets and the sandbox template turns into\n     5\t * `--auth-token-sha256`. The template defines no value for it, so a Pod created without the claim env\n     6\t * gets the literal `$(...)` text as its hash and nothing can authenticate to it (fails closed).\n     7\t */\n     8\texport const SANDBOXD_TOKEN_SHA256_ENV = \"SANDBOXD_AUTH_TOKEN_SHA256\";\n     9\t\n    10\t/**\n    11\t * The sandboxd bearer token of one sandbox: HMAC-SHA256(master, claimName) as hex. Deterministic, so the\n    12\t * orchestrator re-derives it after a restart instead of storing it. The master never leaves the orchestrator\n    13\t * (and the e2e driver); a sandbox only ever learns the sha256 of its own token, which does not reveal the\n    14\t * token and is useless against any other sandbox.\n    15\t */\n    16\texport function deriveSandboxToken(master: string, claimName: string): string {\n    17\t  if (master === \"\") throw new Error(\"sandbox master key is empty\");\n    18\t  return createHmac(\"sha256\", master).update(claimName).digest(\"hex\");\n    19\t}\n    20\t\n    21\t/** What sandboxd's `--auth-token-sha256` expects: lowercase hex of sha256 over the token's UTF-8 bytes. */\n    22\texport function sandboxTokenSha256(token: string): string {\n    23\t  return createHash(\"sha256\").update(token).digest(\"hex\");\n    24\t}\n==== packages/sandbox-env/src/index.ts\n     1\timport { fileURLToPath } from \"node:url\";\n     2\timport { Connection, RemoteExecutionEnv } from \"@earendil-works/pi-env\";\n     3\t\n     4\timport { StartGate, gatedStart } from \"./start-gate.js\";\n     5\t\n     6\t/** One gate per process: all of this process's bridges cold-start through it. 45 s is above a slow start. */\n     7\tconst startGate = new StartGate(45_000);\n     8\t\n     9\texport { runBridge } from \"./bridge.js\";\n    10\texport type { BridgeOptions, RemoteProcess, StartProcess } from \"./bridge.js\";\n    11\texport { ENV } from \"./config.js\";\n    12\texport { ensureClaim } from \"./sandbox-client.js\";\n    13\texport { SANDBOXD_TOKEN_SHA256_ENV, deriveSandboxToken, sandboxTokenSha256 } from \"./token.js\";\n    14\texport type { ClaimRequest, Connectivity } from \"./sandbox-client.js\";\n    15\t\n    16\texport interface SandboxEnvOptions {\n    17\t  claimName: string;\n    18\t  namespace: string;\n    19\t  /** Working directory inside the sandbox; must exist there (e.g. the workspace mount). */\n    20\t  cwd: string;\n    21\t  /** File namespace for the env, e.g. `pi-env:<conversation id>`. */\n    22\t  id: string;\n    23\t  connectivity?: \"in-cluster-service\" | \"in-cluster-pod-ip\" | \"port-forward\";\n    24\t  /** argv of the bridge program. Defaults to `node <this package>/dist/cli.js`. */\n    25\t  bridgeCommand?: readonly string[];\n    26\t  shellPath?: string;\n    27\t  /**\n    28\t   * Added to the environment of every command this env runs (pi-env's `shellEnv`), and of no other env's. It goes\n    29\t   * through the pi-env protocol to the daemon, not through the bridge's own environment.\n    30\t   */\n    31\t  shellEnv?: Record<string, string>;\n    32\t}\n    33\t\n    34\texport interface SandboxEnv {\n    35\t  env: RemoteExecutionEnv;\n    36\t  connection: Connection;\n    37\t  /** Stops the bridge; the daemon then ends its commands and exits. */\n    38\t  close(): void;\n    39\t}\n    40\t\n    41\t/**\n    42\t * pi-env's Connection can only spawn a local program, so the sandbox hop is a bridge process that\n    43\t * receives the `serve --token` arguments Connection appends. The sandboxd token is read by the\n    44\t * bridge from its own PI_SANDBOX_AUTH_TOKEN, which bridge-launcher derives per claim (see token.ts).\n    45\t */\n    46\texport function connectSandboxEnv(options: SandboxEnvOptions): SandboxEnv {\n    47\t  const bridge = options.bridgeCommand ?? [\n    48\t    process.execPath,\n    49\t    fileURLToPath(new URL(\"./cli.js\", import.meta.url)),\n    50\t  ];\n    51\t  const start = gatedStart(startGate, [\n    52\t    ...bridge,\n    53\t    \"--claim\",\n    54\t    options.claimName,\n    55\t    \"--namespace\",\n    56\t    options.namespace,\n    57\t    ...(options.connectivity ? [\"--connectivity\", options.connectivity] : []),\n    58\t  ]);\n    59\t  const connection = new Connection({ command: start.command, onLog: start.onLog });\n    60\t  const env = new RemoteExecutionEnv({\n    61\t    connection,\n    62\t    id: options.id,\n    63\t    cwd: options.cwd,\n    64\t    ...(options.shellPath === undefined ? {} : { shellPath: options.shellPath }),\n    65\t    ...(options.shellEnv === undefined ? {} : { shellEnv: options.shellEnv }),\n    66\t  });\n    67\t  return {\n    68\t    env,\n    69\t    connection,\n    70\t    close: () => {\n    71\t      start.release();\n    72\t      connection.close();\n    73\t    },\n    74\t  };\n    75\t}\n==== packages/orchestrator/src/bridge-launcher.ts\n     1\timport { spawn } from \"node:child_process\";\n     2\timport { fileURLToPath } from \"node:url\";\n     3\timport { ENV, deriveSandboxToken } from \"@pi-durable-k8s/sandbox-env\";\n     4\t\n     5\t/**\n     6\t * Environment variables the bridge may keep. It needs the in-cluster Kubernetes endpoint (the SDK reads the\n     7\t * claim and Service through the API) and a working PATH/HOME. Everything else in the orchestrator's environment,\n     8\t * notably the database URL, the API tokens and the sandbox master key, stays out of the bridge process. The\n     9\t * sandboxd token is not copied from the parent: bridgeEnv derives it for the bridge's own claim only.\n    10\t */\n    11\tconst ALLOWED = new Set([\n    12\t  \"PATH\",\n    13\t  \"HOME\",\n    14\t  \"TZ\",\n    15\t  \"LANG\",\n    16\t  \"NODE_OPTIONS\",\n    17\t  \"KUBERNETES_SERVICE_HOST\",\n    18\t  \"KUBERNETES_SERVICE_PORT\",\n    19\t  \"KUBERNETES_SERVICE_PORT_HTTPS\",\n    20\t  \"PI_SANDBOX_CONNECTIVITY\",\n    21\t  \"PI_SANDBOX_ENV_BINARY\",\n    22\t]);\n    23\t\n    24\t/** The value of the bridge's `--claim` flag. */\n    25\texport function claimOf(argv: readonly string[]): string {\n    26\t  const claim = argv[argv.indexOf(\"--claim\") + 1];\n    27\t  if (argv.indexOf(\"--claim\") < 0 || claim === undefined || claim === \"\") {\n    28\t    throw new Error(\"bridge-launcher: --claim <name> is required\");\n    29\t  }\n    30\t  return claim;\n    31\t}\n    32\t\n    33\t/**\n    34\t * The bridge's environment: the allow-listed variables plus the sandboxd token of `claimName` only. The master\n    35\t * key is read here and dropped, so a bridge (and anything it spawns) can authenticate to its own sandbox and\n    36\t * to no other. A missing master throws: a bridge without a token could only fail later, less clearly.\n    37\t */\n    38\texport function bridgeEnv(\n    39\t  env: Readonly<Record<string, string | undefined>>,\n    40\t  claimName: string,\n    41\t): Record<string, string> {\n    42\t  const master = env[ENV.masterKey];\n    43\t  if (master === undefined || master === \"\") {\n    44\t    throw new Error(`bridge-launcher: ${ENV.masterKey} is not set`);\n    45\t  }\n    46\t  const kept: Record<string, string> = {};\n    47\t  for (const [name, value] of Object.entries(env)) {\n    48\t    if (value !== undefined && ALLOWED.has(name)) kept[name] = value;\n    49\t  }\n    50\t  kept[ENV.authToken] = deriveSandboxToken(master, claimName);\n    51\t  return kept;\n    52\t}\n    53\t\n    54\t/**\n    55\t * The program pi-env's Connection spawns for a session. It starts the real bridge (sandbox-env's cli.js) with the\n    56\t * trimmed environment and passes stdio straight through, so the pi-env protocol is untouched. When pi-env\n    57\t * ends the connection (SIGTERM or closed stdin) the bridge ends too.\n    58\t */\n    59\tfunction main(): void {\n    60\t  const cli = fileURLToPath(import.meta.resolve(\"@pi-durable-k8s/sandbox-env\")).replace(\n    61\t    /index\\.js$/,\n    62\t    \"cli.js\",\n    63\t  );\n    64\t  const args = process.argv.slice(2);\n    65\t  let env: Record<string, string>;\n    66\t  try {\n    67\t    env = bridgeEnv(process.env, claimOf(args));\n    68\t  } catch (error) {\n    69\t    process.stderr.write(`${error instanceof Error ? error.message : String(error)}\\n`);\n    70\t    process.exit(2);\n    71\t  }\n    72\t  const child = spawn(process.execPath, [cli, ...args], {\n    73\t    env,\n    74\t    stdio: \"inherit\",\n    75\t  });\n    76\t  for (const signal of [\"SIGTERM\", \"SIGINT\", \"SIGHUP\"] as const) {\n    77\t    process.on(signal, () => child.kill(signal));\n    78\t  }\n    79\t  child.on(\"exit\", (code, signal) => {\n    80\t    process.exit(code ?? (signal === null ? 1 : 128));\n    81\t  });\n    82\t}\n    83\t\n    84\t// Only run when started as the launcher, not when a test imports bridgeEnv.\n    85\tif (\n    86\t  process.argv[1] !== undefined &&\n    87\t  import.meta.url === new URL(`file://${process.argv[1]}`).href\n    88\t) {\n    89\t  main();\n    90\t}\n","isError":false}]}
