ENTRY 9459 {"id":9459,"kind":"pi.tool-result","messages":[{"role":"toolResult","text":"     1\timport type pg from \"pg\";\n     2\timport { errorMessage, getSession, toEvent } from \"@pi-durable-k8s/session-core\";\n     3\timport type { EventDbRow, InboxEvent, SessionRow } from \"@pi-durable-k8s/session-core\";\n     4\timport { log } from \"./log.js\";\n     5\timport { PermanentError } from \"./sessions.js\";\n     6\t\n     7\tconst POLL_MS = 1_000;\n     8\tconst BATCH = 20;\n     9\tconst MAX_PARALLEL_SESSIONS = 8;\n    10\tconst MAX_ATTEMPTS = 5;\n    11\t\n    12\texport type ApplyEvent = (event: InboxEvent, session: SessionRow) => Promise<void>;\n    13\t\n    14\t/**\n    15\t * The orchestrator's side of the inbox. It claims `pending` rows, hands each to Pi Durable (the row id is the\n    16\t * `requestId`), and only then marks the row `submitted`. Pi Durable owns run recovery: a row that is\n    17\t * already `submitted` is never touched again, so a run that died is never re-run from here.\n    18\t *\n    19\t *  - Wake-up: LISTEN on `inbox_events` (sent by a trigger on insert) plus a short poll as the safety net.\n    20\t *  - Claim: one transaction per session batch, `FOR UPDATE SKIP LOCKED`, oldest first. The row locks are held\n    21\t *    until the rows are marked, so a crash in between rolls the batch back to `pending`; the retry submits\n    22\t *    with the same `requestId` and Pi Durable returns the original submission.\n    23\t *  - Ordering: one drain per session at a time, rows in (created_at, id) order. A transient failure stops\n    24\t *    that session's batch so later rows cannot overtake it; other sessions are unaffected.\n    25\t *  - Batching: rows of a session are claimed up to 20 at a time and submitted one by one, in order. They are\n    26\t *    not merged into one input: each keeps its own requestId and therefore its own idempotent submission.\n    27\t */\n    28\texport class InboxLoop {\n    29\t  readonly #pool: pg.Pool;\n    30\t  readonly #apply: ApplyEvent;\n    31\t  readonly #inFlight = new Set<string>();\n    32\t  #listener: pg.PoolClient | undefined;\n    33\t  #timer: NodeJS.Timeout | undefined;\n    34\t  #ticking = false;\n    35\t  #again = false;\n    36\t  #stopped = false;\n    37\t\n    38\t  constructor(pool: pg.Pool, apply: ApplyEvent) {\n    39\t    this.#pool = pool;\n    40\t    this.#apply = apply;\n    41\t  }\n    42\t\n    43\t  start(): void {\n    44\t    void this.#listen();\n    45\t    this.#timer = setInterval(() => this.wake(), POLL_MS);\n    46\t    this.wake();\n    47\t  }\n    48\t\n    49\t  async stop(): Promise<void> {\n    50\t    this.#stopped = true;\n    51\t    if (this.#timer !== undefined) clearInterval(this.#timer);\n    52\t    this.#listener?.removeAllListeners();\n    53\t    this.#listener?.release(true);\n    54\t    // Let drains in flight finish their current row: they hold row locks and a transaction.\n    55\t    while (this.#inFlight.size > 0) await new Promise((resolve) => setTimeout(resolve, 100));\n    56\t  }\n    57\t\n    58\t  wake(): void {\n    59\t    if (this.#stopped) return;\n    60\t    if (this.#ticking) {\n    61\t      this.#again = true;\n    62\t      return;\n    63\t    }\n    64\t    this.#ticking = true;\n    65\t    void this.#tick().finally(() => {\n    66\t      this.#ticking = false;\n    67\t      if (this.#again) {\n    68\t        this.#again = false;\n    69\t        this.wake();\n    70\t      }\n    71\t    });\n    72\t  }\n    73\t\n    74\t  async #listen(): Promise<void> {\n    75\t    while (!this.#stopped) {\n    76\t      try {\n    77\t        const client = await this.#pool.connect();\n    78\t        this.#listener = client;\n    79\t        await new Promise<void>((resolve) => {\n    80\t          client.on(\"notification\", () => this.wake());\n    81\t          client.on(\"error\", () => resolve());\n    82\t          client.on(\"end\", () => resolve());\n    83\t          client.query(\"listen inbox_events\").catch(() => resolve());\n    84\t        });\n    85\t        client.removeAllListeners();\n    86\t        client.release(true);\n    87\t      } catch (error) {\n    88\t        log(\"inbox-listen-failed\", { message: errorMessage(error) });\n    89\t      }\n    90\t      // The poll covers the gap until the listener is back.\n    91\t      await new Promise((resolve) => setTimeout(resolve, 2_000));\n    92\t    }\n    93\t  }\n    94\t\n    95\t  async #tick(): Promise<void> {\n    96\t    try {\n    97\t      const { rows } = await this.#pool.query<{ session_id: string }>(\n    98\t        \"select distinct session_id from inbox.events where status = 'pending' limit 100\",\n    99\t      );\n   100\t      for (const { session_id: sessionId } of rows) {\n   101\t        if (this.#inFlight.has(sessionId) || this.#inFlight.size >= MAX_PARALLEL_SESSIONS) continue;\n   102\t        this.#inFlight.add(sessionId);\n   103\t        void this.#drain(sessionId)\n   104\t          .then((progressed) => {\n   105\t            if (progressed) this.wake();\n   106\t          })\n   107\t          .catch((error: unknown) => {\n   108\t            log(\"inbox-drain-failed\", { session: sessionId, message: errorMessage(error) });\n   109\t          })\n   110\t          .finally(() => this.#inFlight.delete(sessionId));\n   111\t      }\n   112\t    } catch (error) {\n   113\t      log(\"inbox-poll-failed\", { message: errorMessage(error) });\n   114\t    }\n   115\t  }\n   116\t\n   117\t  /** Claims and applies batches for one session until none is pending. True if it made progress. */\n   118\t  async #drain(sessionId: string): Promise<boolean> {\n   119\t    let progressed = false;\n   120\t    while (!this.#stopped) {\n   121\t      const client = await this.#pool.connect();\n   122\t      let finished = true;\n   123\t      try {\n   124\t        await client.query(\"begin\");\n   125\t        const { rows } = await client.query<EventDbRow>(\n   126\t          `select * from inbox.events\n   127\t            where session_id = $1 and status = 'pending'\n   128\t            order by created_at, id\n   129\t            limit $2\n   130\t            for update skip locked`,\n   131\t          [sessionId, BATCH],\n   132\t        );\n   133\t        if (rows.length === 0) {\n   134\t          await client.query(\"commit\");\n   135\t          return progressed;\n   136\t        }\n   137\t        for (const row of rows) {\n   138\t          const event = toEvent(row);\n   139\t          const outcome = await this.#applyRow(client, event);\n   140\t          if (outcome === \"retry-later\") {\n   141\t            finished = false;\n   142\t            break;\n   143\t          }\n   144\t          progressed = true;\n   145\t        }\n   146\t        await client.query(\"commit\");\n   147\t      } catch (error) {\n   148\t        await client.query(\"rollback\").catch(() => undefined);\n   149\t        throw error;\n   150\t      } finally {\n   151\t        client.release();\n   152\t      }\n   153\t      if (!finished) return progressed;\n   154\t    }\n   155\t    return progressed;\n   156\t  }\n   157\t\n   158\t  async #applyRow(client: pg.PoolClient, event: InboxEvent): Promise<\"done\" | \"retry-later\"> {\n   159\t    const attempt = event.attempts + 1;\n   160\t    try {\n   161\t      const session = await getSession(client, event.sessionId);\n   162\t      if (session === undefined) throw new PermanentError(\"session does not exist\");\n   163\t      await this.#apply(event, session);\n   164\t      await client.query(\n   165\t        `update inbox.events\n   166\t            set status = 'submitted', submitted_at = clock_timestamp(), attempts = $2, error = null\n   167\t          where id = $1`,\n   168\t        [event.id, attempt],\n   169\t      );\n   170\t      await client.query(\n   171\t        \"update inbox.sessions set last_activity_at = clock_timestamp() where id = $1\",\n   172\t        [event.sessionId],\n   173\t      );\n   174\t      log(\"event-submitted\", { eventId: event.id, session: event.sessionId, kind: event.kind });\n   175\t      return \"done\";\n   176\t    } catch (error) {\n   177\t      const message = errorMessage(error).slice(0, 500);\n   178\t      const permanent = error instanceof PermanentError || attempt >= MAX_ATTEMPTS;\n   179\t      await client.query(\n   180\t        \"update inbox.events set status = $2, attempts = $3, error = $4 where id = $1\",\n   181\t        [event.id, permanent ? \"failed\" : \"pending\", attempt, message],\n   182\t      );\n   183\t      log(\"event-failed\", {\n   184\t        eventId: event.id,\n   185\t        session: event.sessionId,\n   186\t        attempt,\n   187\t        permanent,\n   188\t        message,\n   189\t      });\n   190\t      return permanent ? \"done\" : \"retry-later\";\n   191\t    }\n   192\t  }\n   193\t}\n     1\timport { writeSync } from \"node:fs\";\n     2\timport type pg from \"pg\";\n     3\timport {\n     4\t  completeTombstone,\n     5\t  errorMessage,\n     6\t  failSession,\n     7\t  getSession,\n     8\t  writeTombstone,\n     9\t} from \"@pi-durable-k8s/session-core\";\n    10\timport type { InboxEvent, ModelChoice, SessionRow } from \"@pi-durable-k8s/session-core\";\n    11\timport { terminalFailure } from \"./failure.js\";\n    12\timport type { RunOutcome } from \"./failure.js\";\n    13\timport { GithubDeniedError } from \"./github-app.js\";\n    14\timport type { Host } from \"./host.js\";\n    15\timport { log } from \"./log.js\";\n    16\timport { RepoUnavailableError } from \"./repo-access.js\";\n    17\timport type { RepoAccess } from \"./repo-access.js\";\n    18\timport { WorkspaceLostError } from \"./workspace.js\";\n    19\timport { RunWatcher } from \"./watcher.js\";\n    20\timport type { Watched } from \"./watcher.js\";\n    21\t\n    22\t/** An event that can never succeed (deleted session, malformed payload): the row is marked failed, not retried. */\n    23\texport class PermanentError extends Error {}\n    24\t\n    25\t/** Open SSE streams by session, so deleting a session can end them. */\n    26\texport class StreamRegistry {\n    27\t  readonly #streams = new Map<string, Set<(reason: string) => void>>();\n    28\t\n    29\t  add(sessionId: string, close: (reason: string) => void): () => void {\n    30\t    let set = this.#streams.get(sessionId);\n    31\t    if (set === undefined) {\n    32\t      set = new Set();\n    33\t      this.#streams.set(sessionId, set);\n    34\t    }\n    35\t    set.add(close);\n    36\t    return () => {\n    37\t      set.delete(close);\n    38\t      if (set.size === 0) this.#streams.delete(sessionId);\n    39\t    };\n    40\t  }\n    41\t\n    42\t  closeSession(sessionId: string, reason: string): void {\n    43\t    for (const close of [...(this.#streams.get(sessionId) ?? [])]) close(reason);\n    44\t  }\n    45\t}\n    46\t\n    47\texport interface SessionServiceOptions {\n    48\t  /**\n    49\t   * Honour `payload.testFault` on inbox rows. Test-only (PI_ORCH_TEST_FAULTS=1): lets the e2e suite kill the\n    50\t   * orchestrator between \"submitted to Pi Durable\" and \"row marked submitted\".\n    51\t   */\n    52\t  testFaults: boolean;\n    53\t  /** Model of a session that predates the per-session model (null in `inbox.sessions`). */\n    54\t  defaultModel: ModelChoice;\n    55\t  /** Model turns one session may use in total. A session that reaches it is `failed`. */\n    56\t  turnBudget: number;\n    57\t  /** Repo workspaces (Phase 4c). Without it a session that asked for a repo is refused at its first input. */\n    58\t  repos?: RepoAccess;\n    59\t}\n    60\t\n    61\t/**\n    62\t * Maps API sessions onto Pi Durable and applies inbox events. One session = one conversation = one\n    63\t * SandboxClaim `pi-conv-<conversation id>` = one PVC; the claim is created lazily by the Harness at the first\n    64\t * tool call, never here.\n    65\t */\n    66\texport class SessionService {\n    67\t  readonly #pool: pg.Pool;\n    68\t  readonly #host: Host;\n    69\t  readonly #options: SessionServiceOptions;\n    70\t  readonly streams = new StreamRegistry();\n    71\t  readonly #creating = new Map<string, Promise<number>>();\n    72\t  readonly #watcher: RunWatcher;\n    73\t\n    74\t  constructor(pool: pg.Pool, host: Host, options: SessionServiceOptions) {\n    75\t    this.#pool = pool;\n    76\t    this.#host = host;\n    77\t    this.#options = options;\n    78\t    this.#watcher = new RunWatcher({\n    79\t      lookup: (conversationId, requestId) => host.submissionState(conversationId, requestId),\n    80\t      onUnanswered: (watched, outcome) => this.#runEnded(watched, outcome),\n    81\t      onError: (error) => {\n    82\t        log(\"run-watch-failed\", { message: errorMessage(error) });\n    83\t      },\n    84\t    });\n    85\t  }\n    86\t\n    87\t  stop(): void {\n    88\t    this.#watcher.stop();\n    89\t  }\n    90\t\n    91\t  /**\n    92\t   * After a start: watch the inputs of live sessions that were handed over recently, because the process that\n    93\t   * handed them over may have died before it saw the run fail. Settled ones drop out at the first poll.\n    94\t   */\n    95\t  async recoverWatches(): Promise<void> {\n    96\t    const { rows } = await this.#pool.query<{\n    97\t      id: string;\n    98\t      session_id: string;\n    99\t      conversation_id: string;\n   100\t    }>(\n   101\t      `select e.id, e.session_id, s.conversation_id\n   102\t         from inbox.events e join inbox.sessions s on s.id = e.session_id\n   103\t        where e.kind in ('message', 'steer') and e.status = 'submitted'\n   104\t          and s.status = 'active' and s.conversation_id is not null\n   105\t          and e.submitted_at > clock_timestamp() - interval '24 hours'\n   106\t        order by e.submitted_at desc limit 1000`,\n   107\t    );\n   108\t    for (const row of rows) {\n   109\t      this.#watcher.add({\n   110\t        sessionId: row.session_id,\n   111\t        conversationId: Number(row.conversation_id),\n   112\t        requestId: row.id,\n   113\t      });\n   114\t    }\n   115\t    if (rows.length > 0) log(\"run-watches-recovered\", { count: rows.length });\n   116\t  }\n   117\t\n   118\t  /**\n   119\t   * A submission ended without an answer. Rejected model credentials and a used-up turn budget end the session\n   120\t   * for good (`failed`); anything else leaves it active. The stored message is ours, never the provider's text.\n   121\t   */\n   122\t  async #runEnded(watched: Watched, outcome: RunOutcome): Promise<void> {\n   123\t    const failure = terminalFailure(outcome);\n   124\t    if (failure === undefined) return;\n   125\t    await this.#failSession(watched.sessionId, watched.conversationId, failure);\n   126\t  }\n   127\t\n   128\t  async #failSession(\n   129\t    sessionId: string,\n   130\t    conversationId: number | null,\n   131\t    failure: string,\n   132\t  ): Promise<void> {\n   133\t    const changed = await failSession(this.#pool, sessionId, failure);\n   134\t    if (!changed) return;\n   135\t    log(\"session-failed\", { session: sessionId, failure });\n   136\t    // Withdraw whatever queued behind the failed run, so nothing more is sent to the provider.\n   137\t    if (conversationId !== null) await this.#host.abort(conversationId);\n   138\t  }\n   139\t\n   140\t  /**\n   141\t   * The session's conversation id, creating the conversation on first use. Serialised per session, so the\n   142\t   * stream handler and the inbox loop cannot create two. A crash between creating the conversation and\n   143\t   * storing its id leaves one empty, unreferenced conversation behind (documented limit).\n   144\t   */\n   145\t  async ensureConversation(session: SessionRow): Promise<number> {\n   146\t    if (session.conversationId !== null) return session.conversationId;\n   147\t    let creating = this.#creating.get(session.id);\n   148\t    if (creating === undefined) {\n   149\t      creating = this.#create(session.id).finally(() => this.#creating.delete(session.id));\n   150\t      this.#creating.set(session.id, creating);\n   151\t    }\n   152\t    return creating;\n   153\t  }\n   154\t\n   155\t  async #create(sessionId: string): Promise<number> {\n   156\t    const current = await getSession(this.#pool, sessionId);\n   157\t    if (current?.conversationId != null) return current.conversationId;\n   158\t    const conversationId = await this.#host.createConversation(\n   159\t      current?.model ?? this.#options.defaultModel,\n   160\t    );\n   161\t    await this.#pool.query(\n   162\t      \"update inbox.sessions set conversation_id = $1 where id = $2 and conversation_id is null\",\n   163\t      [conversationId, sessionId],\n   164\t    );\n   165\t    log(\"conversation-created\", { session: sessionId, conversation: conversationId });\n   166\t    return conversationId;\n   167\t  }\n   168\t\n   169\t  /** Applies one inbox event. Resolves when it is durably handed over; throws PermanentError if it never can be. */\n   170\t  async apply(event: InboxEvent, session: SessionRow): Promise<void> {\n   171\t    if (session.status === \"deleted\") throw new PermanentError(\"session is deleted\");\n   172\t    switch (event.kind) {\n   173\t      case \"message\":\n   174\t      case \"steer\": {\n   175\t        const text = event.payload.text;\n   176\t        if (typeof text !== \"string\" || text === \"\") throw new PermanentError(\"event has no text\");\n   177\t        if (session.status === \"failed\") throw new PermanentError(\"session has failed\");\n   178\t        const conversationId = await this.ensureConversation(session);\n   179\t        await this.#withinBudget(session, conversationId);\n   180\t        // Before the first turn: OneCLI agent, token and clone. A session without a repo skips all of it.\n   181\t        if (session.repo !== null) await this.#prepareRepo(session, conversationId);\n   182\t        const requestId = event.id;\n   183\t        const faultArmed =\n   184\t          this.#options.testFaults && event.payload.testFault === \"exit-after-submit\";\n   185\t        const alreadyAdmitted =\n   186\t          faultArmed && (await this.#host.hasSubmission(conversationId, requestId));\n   187\t        await this.#host.submitInput(conversationId, {\n   188\t          text,\n   189\t          requestId,\n   190\t          steer: event.kind === \"steer\",\n   191\t        });\n   192\t        this.#watcher.add({ sessionId: session.id, conversationId, requestId });\n   193\t        if (faultArmed && !alreadyAdmitted) {\n   194\t          // After the durable hand-over, before the row says so: exactly the window test 4 needs.\n   195\t          // Synchronous write: stdout to a pipe is async and process.exit would drop the line.\n   196\t          writeSync(\n   197\t            1,\n   198\t            `${JSON.stringify({ event: \"test-fault\", fault: \"exit-after-submit\", id: event.id })}\\n`,\n   199\t          );\n   200\t          process.exit(137);\n   201\t        }\n   202\t        return;\n   203\t      }\n   204\t      case \"cancel\": {\n   205\t        if (session.conversationId !== null) await this.#host.abort(session.conversationId);\n   206\t        return;\n   207\t      }\n   208\t      case \"delete\": {\n   209\t        await this.#delete(session);\n   210\t        return;\n   211\t      }\n   212\t    }\n   213\t  }\n   214\t\n   215\t  /**\n   216\t   * Provisions the repo session's GitHub access and makes sure its clone exists. What no retry can fix ends the input\n   217\t   * for good (and, for a lost workspace or refused access, the session): the agent must not run a turn in a workspace\n   218\t   * that is not the one the user asked for. Anything else throws as is, so the inbox retries it.\n   219\t   */\n   220\t  async #prepareRepo(session: SessionRow, conversationId: number): Promise<void> {\n   221\t    const repos = this.#options.repos;\n   222\t    if (repos === undefined) throw new PermanentError(\"repository workspaces are not configured\");\n   223\t    try {\n   224\t      await repos.prepare(session, await this.#host.workspaceEnv(conversationId));\n   225\t    } catch (error) {\n   226\t      if (error instanceof WorkspaceLostError) {\n   227\t        await this.#failSession(session.id, conversationId, error.message);\n   228\t        throw new PermanentError(error.message);\n   229\t      }\n   230\t      if (error instanceof GithubDeniedError) {\n   231\t        const failure =\n   232\t          \"GitHub refused access to the repository: is the GitHub App installed on it?\";\n   233\t        await this.#failSession(session.id, conversationId, failure);\n   234\t        throw new PermanentError(failure);\n   235\t      }\n   236\t      if (error instanceof RepoUnavailableError) throw new PermanentError(error.message);\n   237\t      throw error;\n   238\t    }\n   239\t  }\n   240\t\n   241\t  /**\n   242\t   * The per-session turn budget, checked before every input: a session that used all its turns fails for good, and\n   243\t   * otherwise the conversation's `maxTurns` is set to what is left, so a single long run cannot overshoot it.\n   244\t   * Turns are model responses, counted from the stored transcript, so a restart does not reset the count.\n   245\t   */\n   246\t  async #withinBudget(session: SessionRow, conversationId: number): Promise<void> {\n   247\t    const used = await this.#host.turnsUsed(conversationId);\n   248\t    const left = this.#options.turnBudget - used;\n   249\t    if (left <= 0) {\n   250\t      const failure = terminalFailure({ reason: \"turn_limit\" });\n   251\t      await this.#failSession(session.id, conversationId, failure ?? \"turn budget exhausted\");\n   252\t      throw new PermanentError(\"turn budget exhausted\");\n   253\t    }\n   254\t    await this.#host.limitTurns(conversationId, left);\n   255\t  }\n   256\t\n   257\t  /**\n   258\t   * Stop the session, delete the SandboxClaim and PVC, mark the session deleted. The conversation's stored state\n   259\t   * stays: the Postgres adapter can only delete it in a maintenance window (docs/session-api.md).\n   260\t   */\n   261\t  async #delete(session: SessionRow): Promise<void> {\n   262\t    log(\"session-delete-start\", { session: session.id });\n   263\t    // Record what the session holds before anything is revoked, then revoke its OneCLI agent first: from that moment\n   264\t    // its proxy token is dead, whatever happens to the claim after. A plain session has no OneCLI objects.\n   265\t    await writeTombstone(this.#pool, session);\n   266\t    await this.#options.repos?.teardown(session);\n   267\t    const conversationId = session.conversationId;\n   268\t    if (conversationId !== null) {\n   269\t      await this.#host.abort(conversationId);\n   270\t      this.streams.closeSession(session.id, \"deleted\");\n   271\t      await this.#host.destroySandbox(conversationId);\n   272\t    }\n   273\t    await this.#pool.query(\n   274\t      \"update inbox.sessions set status = 'deleted', last_activity_at = clock_timestamp() where id = $1\",\n   275\t      [session.id],\n   276\t    );\n   277\t    await completeTombstone(this.#pool, session.id);\n   278\t    log(\"session-deleted\", { session: session.id });\n   279\t  }\n   280\t}\n","isError":false}]}
