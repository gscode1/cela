{
  "name": "@cela/sandbox-env",
  "private": true,
  "version": "0.0.0",
  "description": "pi-env bridge over the Agent Sandbox commands.start() stdio channel.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "pi-sandbox-bridge": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-env": "1.6.0",
    "agentic-sandbox-client": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.6.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
