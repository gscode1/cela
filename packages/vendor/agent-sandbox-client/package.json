{
  "name": "agentic-sandbox-client",
  "private": true,
  "version": "0.1.0",
  "description": "Vendored kubernetes-sigs/agent-sandbox TypeScript client (see VENDORED.md).",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@kubernetes/client-node": "2.0.0",
    "ws": "8.18.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0"
}
