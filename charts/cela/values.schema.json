{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "database",
    "onecli",
    "agentSandbox",
    "sandbox",
    "security",
    "networkPolicy",
    "orchestrator",
    "ingest",
    "console",
    "sessionMail",
    "api",
    "models",
    "github",
    "egressProxy"
  ],
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "ingest", "sandbox"],
      "properties": {
        "orchestrator": {
          "$ref": "#/definitions/image"
        },
        "ingest": {
          "$ref": "#/definitions/image"
        },
        "sandbox": {
          "$ref": "#/definitions/image"
        },
        "sandboxBrowser": {
          "$ref": "#/definitions/image"
        },
        "sandboxDesktop": {
          "$ref": "#/definitions/image"
        },
        "egressProxy": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external", "tls"],
      "properties": {
        "bundled": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "release": {
              "type": "string"
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "existingSecret", "caKey", "certKey", "keyKey"],
          "properties": {
            "mode": {
              "enum": ["disable", "verify-ca", "verify-full"]
            },
            "existingSecret": {
              "type": "string"
            },
            "caKey": {
              "type": "string"
            },
            "certKey": {
              "type": "string"
            },
            "keyKey": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "enum": ["verify-ca", "verify-full"]
                  }
                }
              },
              "then": {
                "properties": {
                  "existingSecret": {
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "verify-ca"
                  }
                }
              },
              "then": {
                "properties": {
                  "caKey": {
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "certKey": {
                    "minLength": 1
                  }
                },
                "required": ["certKey"]
              },
              "then": {
                "properties": {
                  "keyKey": {
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "keyKey": {
                    "minLength": 1
                  }
                },
                "required": ["keyKey"]
              },
              "then": {
                "properties": {
                  "certKey": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "uriKey", "egress"],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "uriKey": {
              "type": "string",
              "minLength": 1
            },
            "egress": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "podSelector", "cidrs", "port"],
              "properties": {
                "namespace": {
                  "type": "string"
                },
                "podSelector": {
                  "$ref": "#/definitions/labels"
                },
                "cidrs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/cidr"
                  }
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      }
    },
    "onecli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "namePrefix", "bundled", "external"],
      "properties": {
        "mode": {
          "enum": ["bundled", "external", "disabled"]
        },
        "namePrefix": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,11}-$"
        },
        "hostRules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reconcile": { "type": "boolean" }
          }
        },
        "bundled": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release", "caConfigMap", "agentTokenSecret", "adminKeySecret"],
          "properties": {
            "release": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]{0,40}[a-z0-9])?$"
            },
            "caConfigMap": {
              "$ref": "#/definitions/objectName"
            },
            "agentTokenSecret": {
              "$ref": "#/definitions/objectName"
            },
            "adminKeySecret": {
              "$ref": "#/definitions/objectName"
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiUrl", "gatewayUrl", "namespace", "podSelector"],
          "properties": {
            "apiUrl": {
              "type": "string",
              "pattern": "^(https?://[^/:\\s]+(:[0-9]+)?/?)?$"
            },
            "gatewayUrl": {
              "type": "string",
              "pattern": "^(https?://[^/:\\s]+(:[0-9]+)?/?)?$"
            },
            "caConfigMap": {
              "type": "string"
            },
            "agentTokenSecret": {
              "type": "string"
            },
            "adminKeySecret": {
              "type": "string"
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "podSelector": {
              "$ref": "#/definitions/labels"
            }
          }
        }
      }
    },
    "agentSandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["external"]
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeClassName", "masterSecret", "defaultSize", "sizes", "flavours"],
      "properties": {
        "runtimeClassName": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
        },
        "runtimes": {
          "description": "Named sandbox runtimes (ADR 0064); the default runtime is runtimeClassName above.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]{0,15}$",
            "not": { "enum": ["default", "browser", "desktop", "direct", "pool", "template", "rt"] }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runtimeClassName"],
            "properties": {
              "runtimeClassName": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              },
              "allowInsecureRuntime": { "type": "boolean" },
              "flavours": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["default", "browser", "desktop"] }
              }
            },
            "allOf": [
              {
                "description": "A class that is not gvisor or gvisor-* needs this entry's own allowInsecureRuntime (the global one covers the default runtime only).",
                "if": {
                  "required": ["runtimeClassName"],
                  "properties": { "runtimeClassName": { "pattern": "^gvisor(-.+)?$" } }
                },
                "then": {},
                "else": {
                  "required": ["allowInsecureRuntime"],
                  "properties": { "allowInsecureRuntime": { "const": true } }
                }
              }
            ]
          }
        },
        "storageClass": {
          "type": "string"
        },
        "masterSecret": {
          "type": "string",
          "minLength": 1
        },
        "defaultSize": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,15}$"
        },
        "flavours": {
          "type": "object",
          "additionalProperties": false,
          "required": ["browser", "desktop"],
          "properties": {
            "browser": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "resources",
                "ephemeralStorage",
                "shmSize",
                "warmPoolReplicas"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "resources": { "$ref": "#/definitions/resources" },
                "ephemeralStorage": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)?$"
                },
                "shmSize": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)?$"
                },
                "warmPoolReplicas": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 0,
                  "description": "Must be 0. A claim always carries spec.env (the per-sandbox token), and agent-sandbox never adopts a warm Pod for such a claim; warm Pods are built without the env, so sandboxd refuses to start and they crash-loop while holding requests and a PVC (docs/decisions/0001, 0030). The key is kept so older values files still render."
                }
              }
            },
            "desktop": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "resources",
                "ephemeralStorage",
                "shmSize",
                "warmPoolReplicas"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "resources": { "$ref": "#/definitions/resources" },
                "ephemeralStorage": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)?$"
                },
                "shmSize": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)?$"
                },
                "warmPoolReplicas": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 0,
                  "description": "Must be 0. A claim always carries spec.env (the per-sandbox token), and agent-sandbox never adopts a warm Pod for such a claim; warm Pods are built without the env, so sandboxd refuses to start and they crash-loop while holding requests and a PVC (docs/decisions/0001, 0030). The key is kept so older values files still render."
                }
              }
            }
          }
        },
        "sizes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,15}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resources", "workspaceSize", "ephemeralStorage", "warmPoolReplicas"],
            "properties": {
              "resources": {
                "$ref": "#/definitions/resources"
              },
              "workspaceSize": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)?$"
              },
              "ephemeralStorage": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei)?$"
              },
              "warmPoolReplicas": {
                "type": "integer",
                "minimum": 0,
                "maximum": 0,
                "description": "Must be 0. A claim always carries spec.env (the per-sandbox token), and agent-sandbox never adopts a warm Pod for such a claim; warm Pods are built without the env, so sandboxd refuses to start and they crash-loop while holding requests and a PVC (docs/decisions/0001, 0030). The key is kept so older values files still render."
              }
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowInsecureRuntime", "allowDirectSandboxEgress"],
      "properties": {
        "allowInsecureRuntime": {
          "type": "boolean"
        },
        "allowDirectSandboxEgress": {
          "type": "boolean"
        },
        "probePodPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "kubeApiCidrs", "dns", "ingest", "orchestrator", "sandbox"],
      "properties": {
        "provider": {
          "enum": ["cilium", "standard"]
        },
        "kubeApiCidrs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cidr"
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "podSelector"],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "podSelector": {
              "$ref": "#/definitions/labels"
            }
          }
        },
        "ingest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clients"],
          "properties": {
            "clients": {
              "type": "array",
              "items": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        },
        "orchestrator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["extraEgress"],
          "properties": {
            "extraEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["extraEgressExcept"],
          "properties": {
            "extraEgressExcept": {
              "type": "array",
              "items": {
                "type": "string",
                "anyOf": [
                  {
                    "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$"
                  },
                  {
                    "pattern": "^[0-9a-fA-F:]*:[0-9a-fA-F:.]*/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shards", "resources", "noProxy", "extraEnv"],
      "properties": {
        "shards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "noProxy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "resources", "expose", "httpRoute", "ingress"],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "expose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "nodePort", "sourceCidr"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "nodePort": {
              "type": "integer",
              "minimum": 30000,
              "maximum": 32767
            },
            "sourceCidr": {
              "type": "string"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "sourceCidr": {
                "$ref": "#/definitions/host32"
              }
            }
          }
        },
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "parentRefs", "hostnames", "paths", "annotations", "timeouts"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "paths": {
              "$ref": "#/definitions/routePaths"
            },
            "annotations": {
              "$ref": "#/definitions/labels"
            },
            "timeouts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["request", "stream"],
              "properties": {
                "request": {
                  "anyOf": [
                    {
                      "const": ""
                    },
                    {
                      "$ref": "#/definitions/gatewayDuration"
                    }
                  ]
                },
                "stream": {
                  "anyOf": [
                    {
                      "const": ""
                    },
                    {
                      "$ref": "#/definitions/gatewayDuration"
                    }
                  ]
                }
              }
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "parentRefs": {
                "minItems": 1
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "className", "hosts", "paths", "tls", "annotations"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "paths": {
              "$ref": "#/definitions/routePaths"
            },
            "tls": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "annotations": {
              "$ref": "#/definitions/labels"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "hosts": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "sessionMail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9-]{0,31})?$"
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "catalogs": {
          "enum": ["manage", "readOnly"]
        }
      }
    },
    "liveView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "publicUrl": {
          "type": "string"
        },
        "maxViewersPerSession": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admins", "existingSecret"],
      "properties": {
        "admins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "allowlist", "turnBudget"],
      "properties": {
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id", "reasoning"],
          "properties": {
            "provider": {
              "type": "string",
              "pattern": "^[^/,\\s]+$"
            },
            "id": {
              "type": "string",
              "pattern": "^[^,\\s]+$"
            },
            "reasoning": {
              "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
            }
          }
        },
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/,\\s]+/[^,\\s]+$"
          }
        },
        "turnBudget": {
          "type": "integer",
          "minimum": 1
        },
        "tokenBudget": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "customProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "baseUrl", "models"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "baseUrl": {
                "type": "string",
                "pattern": "^https?://[^\\s?#@]+$"
              },
              "via": {
                "enum": ["onecli", "direct"]
              },
              "egress": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cidr", "port"],
                "properties": {
                  "cidr": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "compat": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "supportsStore": { "type": "boolean" },
                  "supportsDeveloperRole": { "type": "boolean" },
                  "supportsReasoningEffort": { "type": "boolean" },
                  "supportsUsageInStreaming": { "type": "boolean" },
                  "supportsFinishReason": { "type": "boolean" },
                  "requiresToolResultName": { "type": "boolean" },
                  "requiresAssistantAfterToolResult": { "type": "boolean" },
                  "requiresNonNullAssistantContent": { "type": "boolean" },
                  "requiresToolsWithToolHistory": { "type": "boolean" },
                  "requiresThinkingAsText": { "type": "boolean" },
                  "requiresReasoningContentOnAssistantMessages": { "type": "boolean" },
                  "maxTokensField": { "enum": ["max_completion_tokens", "max_tokens"] },
                  "thinkingFormat": {
                    "enum": [
                      "ant-ling",
                      "baseten",
                      "chat-template",
                      "deepseek",
                      "openai",
                      "openrouter",
                      "qwen",
                      "qwen-chat-template",
                      "string-thinking",
                      "together",
                      "zai"
                    ]
                  }
                }
              },
              "models": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "contextWindow", "maxTokens"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[^,\\s]+$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contextWindow": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "maxTokens": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "reasoning": {
                      "type": "boolean"
                    },
                    "input": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "enum": ["text", "image"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app"],
      "properties": {
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret"],
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "repoAllowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[A-Za-z0-9-]+/(\\*|[A-Za-z0-9._-]+))$"
          }
        }
      }
    },
    "egressProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicas",
        "resources",
        "database",
        "binding",
        "requireAuth",
        "rules",
        "platform",
        "clients",
        "publicPorts",
        "privateEgress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "existingSecret", "uriKey"],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "existingSecret": {
              "type": "string"
            },
            "uriKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "requireAuth": {
          "type": "boolean"
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pollInterval", "staleAfter"],
          "properties": {
            "pollInterval": {
              "$ref": "#/definitions/goDuration"
            },
            "staleAfter": {
              "$ref": "#/definitions/goDuration"
            }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hosts", "cidrs"],
          "properties": {
            "hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9.:-]+$"
              }
            },
            "cidrs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/cidr"
              }
            }
          }
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "publicPorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "privateEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ports"],
            "properties": {
              "cidr": {
                "$ref": "#/definitions/cidr"
              },
              "namespaceSelector": {
                "type": "object"
              },
              "podSelector": {
                "type": "object"
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Anything but gvisor (including the node default, empty) needs allowInsecureRuntime (ADR 0020, D6).",
      "if": {
        "properties": {
          "security": {
            "properties": {
              "allowInsecureRuntime": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "sandbox": {
            "properties": {
              "runtimeClassName": {
                "const": "gvisor"
              }
            }
          }
        }
      }
    },
    {
      "description": "An external OneCLI needs both URLs.",
      "if": {
        "properties": {
          "onecli": {
            "properties": {
              "mode": {
                "const": "external"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "onecli": {
            "properties": {
              "external": {
                "properties": {
                  "apiUrl": {
                    "minLength": 1
                  },
                  "gatewayUrl": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "The orchestrator and ingest reach the database through a Secret and an egress selector.",
      "properties": {
        "database": {
          "properties": {
            "external": {
              "properties": {
                "existingSecret": {
                  "minLength": 1
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "egress": {
                      "properties": {
                        "podSelector": {
                          "minProperties": 1
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "egress": {
                      "properties": {
                        "cidrs": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$|^$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "objectName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "gatewayDuration": {
      "description": "A Gateway API duration, for example 0s, 30s, 1h or 1h30m.",
      "type": "string",
      "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"
    },
    "routePaths": {
      "description": "Path prefixes routed to ingest, each starting with a slash.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^/[^\\s]*$"
      }
    },
    "host32": {
      "description": "One IPv4 address as /32: a wider range would admit more than the host's gateway.",
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])/32$",
      "not": {
        "const": "0.0.0.0/32"
      }
    },
    "cidr": {
      "type": "string",
      "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "goDuration": {
      "description": "A Go duration such as 5s or 2m.",
      "type": "string",
      "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"
    }
  }
}
