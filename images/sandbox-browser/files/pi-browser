#!/usr/bin/env bash
# Starts, stops and reports the sandbox's one Chromium (docs/decisions/0041-browser-sandbox.md). Both browser tools attach
# to it over CDP, so every launch flag is in this file. State lives in a per-sandbox directory outside /workspace and is
# wiped at every start: no profile, no cookies, nothing signed in survives a restart of the browser.
#
#   pi-browser start    starts the egress forwarder and Chromium if they are not running; prints the CDP endpoint
#   pi-browser stop     stops both
#   pi-browser status   running or stopped, with the endpoint
#
# Environment: HTTPS_PROXY (the session's egress proxy, set by the platform; when absent Chromium runs without a proxy,
# which only a network-mode direct sandbox can use), PI_BROWSER_CDP_PORT (9222), PI_BROWSER_PROXY_PORT (3129),
# PI_BROWSER_DOWNLOADS (/workspace/downloads), PI_BROWSER_MAX_DOWNLOAD_MB (256), PI_BROWSER_STATE (/tmp/pi-browser).
set -euo pipefail
export NODE_NO_WARNINGS=1 # the platform sets NODE_USE_ENV_PROXY, whose experimental warning would fill every command's output

cdp_port=${PI_BROWSER_CDP_PORT:-9222}
proxy_port=${PI_BROWSER_PROXY_PORT:-3129}
downloads=${PI_BROWSER_DOWNLOADS:-/workspace/downloads}
max_download_mb=${PI_BROWSER_MAX_DOWNLOAD_MB:-256}
state=${PI_BROWSER_STATE:-/tmp/pi-browser}
endpoint="http://127.0.0.1:$cdp_port"

alive() { [[ -f $state/$1.pid ]] && kill -0 "$(cat "$state/$1.pid")" 2>/dev/null; }

cdp_ready() {
  node -e 'fetch(process.argv[1] + "/json/version", { signal: AbortSignal.timeout(1000) }).then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))' "$endpoint"
}

stop_all() {
  for name in watch chromium forwarder; do
    if alive "$name"; then
      # Each was started with setsid: its pid is its process group, which takes Chromium's helpers with it.
      kill -- "-$(cat "$state/$name.pid")" 2>/dev/null || true
    fi
    rm -f "$state/$name.pid"
  done
}

# Best effort: Chromium has no download size limit, so this stops the browser and removes the largest file when the
# download directory passes the cap. The workspace volume is the hard bound.
watch_downloads() {
  while sleep 2; do
    used=$(du -sm "$downloads" 2>/dev/null | cut -f1)
    if [[ ${used:-0} -gt $max_download_mb ]]; then
      echo "downloads are over ${max_download_mb} MB: stopping the browser and removing the largest file" >&2
      kill -- "-$(cat "$state/chromium.pid")" 2>/dev/null || true
      # shellcheck disable=SC2012
      ls -S "$downloads" | head -n 1 | while read -r f; do rm -rf -- "${downloads:?}/$f"; done
    fi
  done
}

start() {
  if alive chromium && cdp_ready; then
    echo "$endpoint"
    return
  fi
  stop_all
  mkdir -p "$state" "$downloads"
  rm -rf "$state/profile" "$state/home"
  mkdir -p "$state/profile" "$state/home"

  proxy_flags=()
  if [[ -n ${HTTPS_PROXY:-${https_proxy:-}} ]]; then
    BROWSER_PROXY_PORT=$proxy_port setsid node /opt/browser-proxy/dist/main.js >"$state/forwarder.log" 2>&1 </dev/null &
    echo $! >"$state/forwarder.pid"
    for _ in $(seq 1 50); do
      (exec 3<>"/dev/tcp/127.0.0.1/$proxy_port") 2>/dev/null && break
      sleep 0.1
    done
    # The browser reaches the network only through the forwarder, and never resolves a name itself: the proxy does.
    proxy_flags=(
      "--proxy-server=http://127.0.0.1:$proxy_port"
      "--host-resolver-rules=MAP * ~NOTFOUND , EXCLUDE 127.0.0.1"
    )
  fi

  # /dev/shm is a small memory volume in a Pod: fall back to /tmp when it cannot hold a page's shared memory.
  shm_flags=()
  shm_kb=$(df -Pk /dev/shm 2>/dev/null | awk 'NR==2 {print $2}')
  [[ ${shm_kb:-0} -ge 262144 ]] || shm_flags=(--disable-dev-shm-usage)

  # --no-sandbox: Chromium's own sandbox needs user namespaces, which the Pod does not have; gVisor is the boundary.
  # The shell around Chromium only records how it ended (a signal shows as 128+n), so a lost browser has a reason on file.
  HOME="$state/home" setsid bash -c 'pi-chromium "$@"; echo "chromium exited with status $? at $(date +%T)" >>"$0"' "$state/exit.log" \
    --headless=new --no-sandbox --disable-gpu \
    --user-data-dir="$state/profile" \
    --remote-debugging-address=127.0.0.1 --remote-debugging-port="$cdp_port" \
    --window-size=1280,800 \
    --disable-quic --force-webrtc-ip-handling-policy=disable_non_proxied_udp \
    --disable-background-networking --disable-sync --disable-component-update --disable-breakpad \
    --no-first-run --no-default-browser-check --password-store=basic --mute-audio \
    --disable-features=DnsOverHttps,Translate,MediaRouter,OptimizationHints,AutofillServerCommunication \
    ${proxy_flags[@]+"${proxy_flags[@]}"} ${shm_flags[@]+"${shm_flags[@]}"} \
    about:blank >"$state/chromium.log" 2>&1 </dev/null &
  echo $! >"$state/chromium.pid"

  for _ in $(seq 1 100); do
    cdp_ready && break
    sleep 0.2
  done
  if ! cdp_ready; then
    echo "Chromium did not come up; see $state/chromium.log" >&2
    tail -n 20 "$state/chromium.log" >&2 || true
    exit 1
  fi
  setsid "$0" _watch >"$state/watch.log" 2>&1 </dev/null &
  echo $! >"$state/watch.pid"
  echo "$endpoint"
}

case ${1:-} in
  start) start ;;
  stop) stop_all ;;
  _watch) watch_downloads ;;
  status)
    if alive chromium && cdp_ready; then echo "running $endpoint"; else echo stopped; exit 1; fi
    ;;
  *) echo "usage: pi-browser start|stop|status" >&2; exit 64 ;;
esac
