#!/usr/bin/env bash
# Prints the URL of the focused Firefox window: ctrl+l, ctrl+c, read the clipboard, Escape, F6. Saves the agent reading it out
# of the accessibility tree turn by turn (docs/decisions/0065-desktop-sandbox.md, "Token budget"). Needs Firefox focused.
# Ends with focus back in the page (F6), not the address bar, and puts the clipboard back as it was.
set -euo pipefail

run=(agent-desktop-run --exec)
saved=$("${run[@]}" xclip -o -selection clipboard 2>/dev/null || true)
"${run[@]}" xdotool key --clearmodifiers ctrl+l
sleep 0.3
"${run[@]}" xdotool key --clearmodifiers ctrl+c
sleep 0.3
url=$("${run[@]}" xclip -o -selection clipboard)
"${run[@]}" xdotool key --clearmodifiers Escape
"${run[@]}" xdotool key --clearmodifiers F6
# xclip -i forks a child that keeps the selection; no output pipe may stay open to it.
printf '%s' "$saved" | "${run[@]}" xclip -selection clipboard -i >/dev/null 2>&1 || true
[[ -n "$url" ]] || { echo "desktop-url: empty clipboard; is a Firefox window focused?" >&2; exit 1; }
printf '%s\n' "$url"
