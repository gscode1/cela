#!/usr/bin/env -S node --no-warnings
// Opens a URL in Firefox and returns what the page says, in one call (docs/decisions/0065-desktop-sandbox.md, "Token
// budget"): launch Firefox if it is not running, otherwise type the URL into the address bar; wait for the title to settle;
// print url, title and the page's matching lines (desktop-page).
//
//   desktop-open https://example.com                    url, title and the first lines of the page
//   desktop-open https://shop.example/search?q=x "zł"   url, title and the lines matching the regex
//
// Flags: --limit N, --context N (as desktop-page).
// Cookie banners are not handled here: the image's Firefox carries an extension that accepts or hides them on any site
// (desktop-launch, Dockerfile). A banner it misses is still on the page: desktop-click its accept button.
"use strict";
const fs = process.getBuiltinModule("node:fs");
const path = process.getBuiltinModule("node:path");
const { spawnSync } = process.getBuiltinModule("node:child_process");
const lib = process.getBuiltinModule("node:module").createRequire(fs.realpathSync(process.argv[1]))("./desktop-lib.cjs");

const fail = lib.failer("desktop-open");
const COPY_TRIES = 4;

function parseArgs(argv) {
  const o = { limit: 25, context: 1 };
  const value = (i, flag) => {
    if (i + 1 >= argv.length) fail(`${flag} needs a value`, 64);
    return argv[i + 1];
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--limit") (o.limit = Number(value(i, a))), i++;
    else if (a === "--context") (o.context = Number(value(i, a))), i++;
    else if (a === "-h" || a === "--help") {
      process.stdout.write("usage: desktop-open [--limit N] [--context N] <url> [regex]\n");
      process.exit(0);
    } else if (a.startsWith("--")) fail(`unknown flag ${a}`, 64);
    else if (o.url === undefined) o.url = a;
    else if (o.pattern === undefined) o.pattern = a;
    else fail(`unexpected argument ${a}`, 64);
  }
  if (o.url === undefined) fail("name a URL to open", 64);
  if (!/^(https?:\/\/|file:\/\/\/workspace\/|about:)/u.test(o.url)) fail("the URL must start with https://, http://, file:///workspace/ or about:", 64);
  if (!Number.isInteger(o.limit) || o.limit < 1) fail("--limit needs a positive integer", 64);
  if (!Number.isInteger(o.context) || o.context < 0) fail("--context needs a non-negative integer", 64);
  return o;
}

function firefoxRunning() {
  try {
    return lib.exec("xdotool", "search", "--onlyvisible", "--class", "firefox").trim() !== "";
  } catch {
    return false;
  }
}

// Returns the address shown before navigating ("" when Firefox was not running).
function navigate(url) {
  // A fresh Firefox opens on about:blank and then takes the URL through the address bar like a running one: given on the
  // command line, a URL's %20 came out as a literal + in the query on one shop (fewer results, and the agent retried).
  if (!firefoxRunning()) {
    const launch = path.join(path.dirname(fs.realpathSync(process.argv[1])), "desktop-launch");
    const r = spawnSync(fs.existsSync(launch) ? launch : "desktop-launch", ["firefox", "about:blank"], { encoding: "utf8", timeout: 90_000 });
    if (r.status !== 0) fail(`desktop-launch failed: ${String(r.stderr || r.stdout).trim().slice(0, 200)}`);
    lib.pause(1000);
  }
  const before = lib.windowTitle();
  const saved = lib.readClipboard();
  lib.key("ctrl+l");
  lib.pause(200);
  lib.key("ctrl+c");
  lib.pause(200);
  const previous = lib.readClipboard().trim();
  lib.writeClipboard(saved);
  lib.type(url);
  lib.key("Return");
  // A page load changes the title; give a slow page longer than a click gets.
  lib.settle(before, { quietMs: 6000, capMs: 20000 });
  return previous;
}

function main() {
  const o = parseArgs(process.argv.slice(2));
  let re;
  if (o.pattern !== undefined) {
    try {
      re = new RegExp(o.pattern, "iu");
    } catch (e) {
      fail(`bad regex: ${e.message}`, 64);
    }
  }
  const previous = navigate(o.url);
  // The title can settle before the body renders (a script-built page, a bot check that reloads): copy again until it has text.
  let page = lib.copyPage();
  for (let i = 1; i < COPY_TRIES && page.lines.length <= 1; i++) {
    lib.pause(2000);
    page = lib.copyPage();
  }
  if (page.lines.length <= 1) fail(`the page has no text after ${COPY_TRIES} tries (title "${lib.clip(page.title, 80)}"); desktop-shot to see it`);
  const out = [`url: ${page.url}`, `title: ${lib.clip(page.title, 120)}`, `text: ${lib.savePage(page.lines, undefined, page.links)} (${page.lines.length} lines)`];
  // Still on the page from before: the navigation did not happen (seen when Firefox autofilled a typed URL to a visited one).
  // A redirect elsewhere is normal and not reported.
  if (previous && page.url === previous && o.url !== previous) out.splice(1, 0, `note: the page did not change; still ${lib.clip(previous, 100)}`);
  if (re === undefined) for (const [i, l] of page.lines.slice(0, 15).entries()) out.push(`${i + 1}: ${lib.clip(l, 200)}`);
  else out.push(...lib.grepLines(page.lines, re, { limit: o.limit, context: o.context }));
  process.stdout.write(`${out.join("\n")}\n`);
}

main();
