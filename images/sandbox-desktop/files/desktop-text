#!/usr/bin/env node
// Copies the text of the web page in the focused browser window (select all, copy), saves it to a file and prints only the
// lines that match, with their neighbours. For pages whose accessibility tree is too large or too broken for desktop-find:
// it needs no tree at all, so it works the same on any site (docs/decisions/0065-desktop-sandbox.md, "Token budget"). No
// dependencies. It gives text, not refs: act through desktop-find --role, a link URL, or coordinates from desktop-shot.
//
//   desktop-text "zł|price"             matching lines of the page in the focused browser window, one line of context
//   desktop-text                        no regex: a summary (line count) and the first lines
//   desktop-text --focused "TODO"       copy from whatever has focus (an editor), not the browser page
//   desktop-text --from FILE "regex"    filter the saved text again without copying
//
// Flags: --limit N matches (default 40), --context N lines around each (default 1), --out FILE (default
// $AGENT_DESKTOP_SESSION_DIR or ~/.agent-desktop-session, last-page.txt), --from FILE, --focused.
// The page stays selected (highlighted) until the next click on it; the clipboard is overwritten.
"use strict";
// getBuiltinModule works whether Node treats this extensionless file as CommonJS (the image) or as an ES module (the repo).
const { execFileSync } = process.getBuiltinModule("node:child_process");
const fs = process.getBuiltinModule("node:fs");
const os = process.getBuiltinModule("node:os");
const path = process.getBuiltinModule("node:path");

const LINE_MAX = 200;
const HEAD_LINES = 15;

function fail(message, code = 1) {
  process.stderr.write(`desktop-text: ${message}\n`);
  process.exit(code);
}

function parseArgs(argv) {
  const o = { limit: 40, context: 1, focused: false, pattern: undefined };
  const value = (i, flag) => {
    if (i + 1 >= argv.length) fail(`${flag} needs a value`, 64);
    return argv[i + 1];
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--limit") (o.limit = Number(value(i, a))), i++;
    else if (a === "--context") (o.context = Number(value(i, a))), i++;
    else if (a === "--out") (o.out = value(i, a)), i++;
    else if (a === "--from") (o.from = value(i, a)), i++;
    else if (a === "--focused") o.focused = true;
    else if (a === "-h" || a === "--help") {
      process.stdout.write("usage: desktop-text [--focused] [--limit N] [--context N] [--from FILE] [--out FILE] [regex]\n");
      process.exit(0);
    } else if (a.startsWith("--")) fail(`unknown flag ${a}`, 64);
    else if (o.pattern === undefined) o.pattern = a;
    else fail(`unexpected argument ${a}`, 64);
  }
  if (!Number.isInteger(o.limit) || o.limit < 1) fail("--limit needs a positive integer", 64);
  if (!Number.isInteger(o.context) || o.context < 0) fail("--context needs a non-negative integer", 64);
  return o;
}

const run = (...args) => execFileSync("agent-desktop-run", ["--exec", ...args], { encoding: "utf8", maxBuffer: 256 * 1024 * 1024 });
const key = (k) => run("xdotool", "key", "--clearmodifiers", k);
const pause = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);

function readClipboard() {
  try {
    return run("xclip", "-o", "-selection", "clipboard");
  } catch {
    return "";
  }
}

// Focus the page itself, not the address bar or a field in the page: ctrl+l puts focus in the address bar, Escape restores
// its text, F6 moves focus from the address bar into the page (Firefox, the browser of this image). Then select all and copy.
// xclip -i forks a child that owns the selection until another program takes it; with piped stdio execFileSync would wait for
// that child forever, so it gets no pipes.
function clearClipboard() {
  execFileSync("agent-desktop-run", ["--exec", "xclip", "-selection", "clipboard", "-i", "/dev/null"], { stdio: "ignore", timeout: 10_000 });
}

function copyText(focused) {
  clearClipboard();
  if (!focused) {
    key("ctrl+l");
    pause(200);
    key("Escape");
    key("F6");
    pause(300);
  }
  key("ctrl+a");
  pause(200);
  key("ctrl+c");
  pause(500);
  return readClipboard();
}

function clean(text) {
  const lines = text.split(/\r?\n/).map((l) => l.replace(/\s+/g, " ").trim());
  const out = [];
  for (const l of lines) if (l !== "" || (out.length > 0 && out.at(-1) !== "")) out.push(l);
  while (out.at(-1) === "") out.pop();
  return out;
}

const clip = (s) => (s.length > LINE_MAX ? `${s.slice(0, LINE_MAX - 1)}…` : s);

function main() {
  const o = parseArgs(process.argv.slice(2));
  let re;
  if (o.pattern !== undefined) {
    try {
      re = new RegExp(o.pattern, "iu");
    } catch (e) {
      fail(`bad regex: ${e.message}`, 64);
    }
  }
  let file = o.from;
  let lines;
  if (o.from) {
    lines = fs.readFileSync(o.from, "utf8").split("\n");
  } else {
    lines = clean(copyText(o.focused));
    // A failed page focus copies the address bar (one line) or nothing.
    if (lines.length <= 1) {
      fail(`copied ${lines.length === 0 ? "nothing" : `only "${clip(lines[0]).slice(0, 80)}"`}; is a browser window focused with a page loaded? For another app use --focused`);
    }
    const dir = process.env.AGENT_DESKTOP_SESSION_DIR ?? path.join(process.env.HOME ?? os.homedir(), ".agent-desktop-session");
    file = o.out ?? path.join(dir, "last-page.txt");
    fs.mkdirSync(path.dirname(file), { recursive: true });
    fs.writeFileSync(file, `${lines.join("\n")}\n`);
  }
  const chars = lines.reduce((n, l) => n + l.length, 0);
  const out = [`text: ${file} (${lines.length} lines, ${chars} chars)`];
  if (re === undefined) {
    for (const [i, l] of lines.slice(0, HEAD_LINES).entries()) out.push(`${i + 1}: ${clip(l)}`);
    out.push("Add a regex to list matching lines, for example: desktop-text 'price|zł|€|\\$'");
  } else {
    const hits = [];
    for (const [i, l] of lines.entries()) if (re.test(l)) hits.push(i);
    const isHit = new Set(hits);
    const shown = new Set();
    let last = -2;
    for (const h of hits.slice(0, o.limit)) {
      const from = Math.max(0, h - o.context);
      const to = Math.min(lines.length - 1, h + o.context);
      if (from > last + 1 && shown.size > 0) out.push("--");
      for (let i = from; i <= to; i++) {
        if (shown.has(i) || lines[i] === "") continue;
        shown.add(i);
        out.push(`${i + 1}${isHit.has(i) ? ":" : "-"} ${clip(lines[i])}`);
      }
      last = to;
    }
    if (hits.length > o.limit) out.push(`${hits.length - o.limit} more matches, narrow the regex or raise --limit`);
    if (hits.length === 0) out.push(`no match among ${lines.length} lines; run desktop-text without a regex for the first lines`);
  }
  process.stdout.write(`${out.join("\n")}\n`);
}

main();
