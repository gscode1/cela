#!/usr/bin/env -S node --no-warnings
// Finds one element and clicks it, then reports what changed: one call instead of find, read the ref, click, sleep, check
// (docs/decisions/0065-desktop-sandbox.md, "Token budget"). It never guesses between different targets: with no match or
// several it clicks nothing and lists the candidates (exit 2), so pick one with --near, --nth or a narrower pattern.
//
//   desktop-click "Najtańsze"                         the one clickable element whose name matches (regex, any case)
//   desktop-click "Honey 250 g" --near "SellerB"      of several same-named items, the one in the row with that text
//   desktop-click "Add to cart" --role button         other roles: --role R[,R]
//   desktop-click "Next" --nth 1                      the second of several matches (0-based, in the order listed)
//   desktop-click @s1abc:e12                          a ref from desktop-find
//   desktop-click "Search" --show "results|zł"        also print the new page's matching lines (desktop-page)
//
// Flags: --near REGEX, --app NAME (default firefox-esr), --role R[,R] (default: any clickable role: link, button, switch, tab,
// checkbox, option, ...), --nth N, --all (also offscreen candidates), --show REGEX, --timeout-ms N (per find, default 30000).
// Links are resolved through the page copy where the tree cannot tell them apart: same-named links with one URL are one
// target, and a link chosen with --near is opened by its URL. An element out of view is brought into view with the browser's
// find bar; if the accessibility click is still refused, a mouse click at its centre ("physical"). The whole command stops
// before the agent's tool time limit.
"use strict";
const fs = process.getBuiltinModule("node:fs");
const lib = process.getBuiltinModule("node:module").createRequire(fs.realpathSync(process.argv[1]))("./desktop-lib.cjs");

const fail = lib.failer("desktop-click");
const SCREEN = { width: 1280, height: 800 };
const MAX_CANDIDATES = 8;
// The agent's bash calls are cut at 60 s; past that Firefox was seen gone. Stop with a hint well before.
const BUDGET_MS = 45_000;
const started = Date.now();
const deadline = started + BUDGET_MS;
// What a person can click. Pages also make clickable switches, tabs and options; a link/button-only search missed a switch
// that opened a sellers panel. Elements of these roles win over same-named plain text.
const CLICKABLE = new Set(["link", "button", "switch", "checkbox", "radiobutton", "tab", "menuitem", "menubutton", "option", "combobox", "treeitem", "togglebutton"]);
// Searched one role at a time when the page is too large for one search across all roles.
const CLICK_FALLBACK_ROLES = ["link", "button", "switch", "tab", "checkbox", "menuitem"];
// agent-desktop answers that mean "could not act on this ref as it is", worth the URL, find-bar and mouse fallbacks.
const RETRYABLE = new Set(["ACTION_FAILED", "TIMEOUT", "AMBIGUOUS_TARGET"]);

function parseArgs(argv) {
  const o = { app: "firefox-esr", roles: [], all: false, timeout: "30000" };
  const value = (i, flag) => {
    if (i + 1 >= argv.length) fail(`${flag} needs a value`, 64);
    return argv[i + 1];
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--app") (o.app = value(i, a)), i++;
    else if (a === "--role") o.roles.push(...value(i++, a).split(",").map((r) => r.trim().toLowerCase()).filter(Boolean));
    else if (a === "--nth") (o.nth = Number(value(i, a))), i++;
    else if (a === "--near") (o.near = value(i, a)), i++;
    else if (a === "--show") (o.show = value(i, a)), i++;
    else if (a === "--timeout-ms") (o.timeout = value(i, a)), i++;
    else if (a === "--all") o.all = true;
    else if (a === "-h" || a === "--help") {
      process.stdout.write("usage: desktop-click [--near REGEX] [--role R[,R]] [--nth N] [--all] [--show REGEX] [--app NAME] <regex|@ref>\n");
      process.exit(0);
    } else if (a.startsWith("--")) fail(`unknown flag ${a}`, 64);
    else if (o.target === undefined) o.target = a;
    else fail(`unexpected argument ${a}`, 64);
  }
  if (o.target === undefined) fail("name a regex or an @ref to click", 64);
  if (o.nth !== undefined && (!Number.isInteger(o.nth) || o.nth < 0)) fail("--nth needs a non-negative integer", 64);
  return o;
}

function regex(pattern, flag) {
  try {
    return new RegExp(pattern, "iu");
  } catch (e) {
    return fail(`bad ${flag} regex: ${e.message}`, 64);
  }
}

const tidy = (s) => (s ?? "").replace(/\s+/g, " ").trim();
const sameName = (a, b) => tidy(a) === tidy(b);
// The pattern matches the whole name, not just part of it ("<title>" against "Add to compare <title>").
const wholeMatch = (re, name) => {
  const n = tidy(name);
  const m = re.exec(n);
  return m !== null && m[0].length === n.length;
};

function outOfTime(what) {
  return fail(`${what} took too long (${Math.round((Date.now() - started) / 1000)} s); narrow it with --role, --near or a literal word`, 3);
}

// The lines after `line` that tell this row from the others: the first one or two that are not the link itself.
function rowText(lines, line, name) {
  const parts = [];
  for (let i = line + 1; i < Math.min(lines.length, line + 6) && parts.length < 2; i++) {
    if (lines[i] !== "" && !sameName(lines[i], name)) parts.push(lib.clip(lines[i], 40));
  }
  return parts.join(" · ");
}

function listAndExit(header, items) {
  const lines = [header];
  for (const item of items.slice(0, MAX_CANDIDATES)) lines.push(`  ${item}`);
  if (items.length > MAX_CANDIDATES) lines.push(`  … ${items.length - MAX_CANDIDATES} more`);
  process.stdout.write(`${lines.join("\n")}\n`);
  process.exit(2);
}

function treeCandidates(o, re) {
  // No --role: one search across all roles (one tree walk) for the pattern's literal text, then keep what can be clicked.
  const found = lib.findAcross({
    app: o.app,
    roles: o.roles,
    literal: lib.literalOf(o.target),
    timeout: o.timeout,
    fallbackRoles: CLICK_FALLBACK_ROLES,
    deadline,
  });
  if (found.answered === 0) {
    if (Date.now() > deadline) outOfTime("finding the element");
    fail(`agent-desktop find failed for every role: ${found.skipped.join(", ")}`);
  }
  const seen = new Set();
  const hits = found.matches.filter((n) => {
    if (seen.has(n.ref_id)) return false;
    seen.add(n.ref_id);
    return [n.name, n.value, n.description].some((s) => typeof s === "string" && re.test(s));
  });
  let clickable = o.roles.length > 0 ? hits : hits.filter((n) => CLICKABLE.has(String(n.role ?? "").toLowerCase()));
  // A link and an option with one name (a listbox echoing the page) are one choice: the link.
  const linkNames = new Set(clickable.filter((n) => n.role === "link").map((n) => tidy(n.name)));
  clickable = clickable.filter((n) => !(n.role === "option" && linkNames.has(tidy(n.name))));
  // Visible candidates first: an offscreen duplicate of a visible control (a sticky header copy, a footer link) is rarely meant.
  const visible = clickable.filter((n) => !lib.isHidden(n));
  let pool = o.all || visible.length === 0 ? clickable : visible;
  // Names the pattern matches whole beat names that merely contain it.
  const whole = pool.filter((n) => wholeMatch(re, n.name));
  if (whole.length > 0 && whole.length < pool.length) pool = whole;
  const note = found.skipped.length > 0 ? ` (skipped, find failed: ${found.skipped.join(", ")})` : "";
  return { pool, note };
}

// Resolves a pattern to one element ({ node }) or one URL ({ href }), or exits 2 with the candidates.
function resolve(o, re) {
  const { pool, note } = treeCandidates(o, re);
  if (pool.length === 0) {
    const what = o.roles.length > 0 ? o.roles.join("/") : "clickable element";
    process.stdout.write(`no ${what} matches /${o.target}/${note}; try --role, desktop-find, or desktop-page to see the text\n`);
    process.exit(2);
  }
  if (o.nth !== undefined) {
    if (o.nth >= pool.length) fail(`--nth ${o.nth} but only ${pool.length} matches`, 2);
    return { node: pool[o.nth] };
  }
  if (pool.length === 1) return { node: pool[0] };
  // Same-named links: the page copy says whether they lead to one place (an image link and a title link) or to different ones
  // (rows of offers, sellers, flights), and which text tells the rows apart.
  if (pool.every((n) => n.role === "link" && sameName(n.name, pool[0].name))) {
    const page = lib.copyPage();
    const rows = lib.alignLinks(page.lines, page.links).placed.filter((l) => sameName(l.text, pool[0].name));
    const urls = [...new Set(rows.map((l) => l.href))];
    if (urls.length === 1) return { href: urls[0], name: pool[0].name, note: `${pool.length} links, one URL` };
    if (urls.length > 1) {
      listAndExit(
        `${rows.length} links named "${lib.clip(pool[0].name, 60)}" lead to different pages, opened none; add --near "<text from the row>":`,
        rows.map((l, i) => `${i + 1}. line ${l.line + 1}: ${rowText(page.lines, l.line, l.text) || "(no row text)"} -> ${lib.clip(l.href, 120)}`),
      );
    }
  }
  return listAndExit(
    `${pool.length} matches, clicked none; add --near "<text from the row>", --nth N or narrow the pattern${note}:`,
    pool.map((n, i) => `--nth ${i}: ${lib.nodeLine(n)}`),
  );
}

// Of the target's occurrences (line numbers, in page order), the one in the row of the --near line. Rows are taken as they are
// usually laid out: a link starts its row (title, then seller and price: the last occurrence at or before the --near line),
// a button ends it (label, then "Edit": the first occurrence at or after it). Line distance alone picked the neighbouring row
// when the two were equally far.
function pickRow(occurrences, anchors, startsRow) {
  let best;
  let bestCost = Infinity;
  for (const a of anchors) {
    for (const [k, line] of occurrences.entries()) {
      const onSide = startsRow ? line <= a : line >= a;
      // The preferred side first; the other side only when nothing is on the preferred one.
      const cost = (onSide ? 0 : 1_000_000) + Math.abs(line - a);
      if (cost < bestCost) {
        bestCost = cost;
        best = { k, line, anchor: a };
      }
    }
  }
  return best;
}

// --near: the occurrence of the target in the row of a line matching NEAR. A link is opened by its URL (no tree, no ref to be
// refused as ambiguous); anything else is the same-numbered match of the tree search.
function resolveNear(o, re) {
  const nearRe = regex(o.near, "--near");
  const page = lib.copyPage();
  const anchors = page.lines.flatMap((l, i) => (nearRe.test(l) ? [i] : []));
  if (anchors.length === 0) {
    process.stdout.write(`no line of the page matches --near /${o.near}/; desktop-page "${o.near}" shows what is there\n`);
    process.exit(2);
  }
  const links = lib.alignLinks(page.lines, page.links).placed.filter((l) => re.test(l.text));
  if (links.length > 0) {
    const pick = pickRow(links.map((l) => l.line), anchors, true);
    const best = links[pick.k];
    return { href: best.href, name: best.text, note: `near "${lib.clip(page.lines[pick.anchor], 40)}", line ${best.line + 1}` };
  }
  // Not a link (a button per row): find the target's occurrence in the text and take the same-numbered tree match. The tree's
  // order follows the page most of the time, not always, so the output says which one it took.
  const occurrences = page.lines.flatMap((l, i) => (re.test(l) ? [i] : []));
  if (occurrences.length === 0) fail(`/${o.target}/ is not in the page text; try desktop-page "${o.target}"`, 2);
  const pick = pickRow(occurrences, anchors, false);
  const { pool } = treeCandidates({ ...o, all: true }, re);
  if (pool.length === 0) fail(`no clickable element matches /${o.target}/`, 2);
  const node = pool[Math.min(pick.k, pool.length - 1)];
  return { node, note: `occurrence ${pick.k + 1} of ${occurrences.length} in the text, line ${pick.line + 1}` };
}

const onScreen = (b) => b && b.width > 0 && b.height > 0 && b.x >= 0 && b.y >= 0 && b.x + b.width / 2 < SCREEN.width && b.y + b.height / 2 < SCREEN.height;

function bounds(ref) {
  const env = lib.envelope(lib.desktop(["get", ref, "--property", "bounds"]));
  return env.ok ? env.data?.value : undefined;
}

function click(ref) {
  return lib.envelope(lib.desktop(["click", ref]));
}

// Firefox's find bar scrolls the first occurrence of the text into view. The name may occur earlier on the page, so repeat
// (Return = next match) until the element itself is on screen, a few times at most. Only the typable ASCII prefix is typed.
function bringIntoView(ref, name) {
  const text = tidy(name).match(/^[\x20-\x7e]*/u)[0].trim().slice(0, 60);
  if (text.length < 3) return false;
  lib.key("ctrl+f");
  lib.pause(300);
  lib.key("ctrl+a");
  lib.type(text);
  for (let i = 0; i < 5 && Date.now() < deadline; i++) {
    lib.key("Return");
    lib.pause(400);
    if (onScreen(bounds(ref))) break;
  }
  lib.key("Escape");
  lib.pause(300);
  return onScreen(bounds(ref));
}

// Clicks a tree node, with the fallbacks. Returns how it clicked.
function clickNode(target) {
  const ref = target.ref_id;
  let result = click(ref);
  if (result.ok) return "accessibility";
  const failed = () => fail(`clicked nothing, ${result.error?.code ?? "ERROR"}: ${result.error?.message ?? "click failed"}`, 3);
  if (!RETRYABLE.has(result.error?.code)) return failed();
  // A link agent-desktop will not act on (out of view, or not provably unique among same-named siblings) can still be opened by
  // its URL when the page copy gives exactly one for that name.
  if (target.role === "link" && target.name) {
    const page = lib.copyPage();
    const rows = lib.alignLinks(page.lines, page.links).placed.filter((l) => sameName(l.text, target.name));
    const urls = [...new Set(rows.map((l) => l.href))];
    if (urls.length === 1) {
      lib.openUrl(urls[0], { quietMs: 2500, capMs: 15000 });
      target.href = urls[0];
      return "opened its URL";
    }
  }
  if (Date.now() > deadline) return outOfTime("clicking");
  const name = target.name ?? lib.envelope(lib.desktop(["get", ref, "--property", "text"])).data?.value;
  if (bringIntoView(ref, name)) {
    result = click(ref);
    if (result.ok) return "accessibility";
  }
  const b = bounds(ref);
  if (onScreen(b)) {
    lib.exec("xdotool", "mousemove", String(Math.round(b.x + b.width / 2)), String(Math.round(b.y + b.height / 2)), "click", "1");
    return "physical";
  }
  return failed();
}

function main() {
  const o = parseArgs(process.argv.slice(2));
  const beforeTitle = lib.windowTitle();
  let choice;
  if (o.target.startsWith("@")) choice = { node: { ref_id: o.target } };
  else {
    const re = regex(o.target, "target");
    choice = o.near !== undefined ? resolveNear(o, re) : resolve(o, re);
  }
  let out;
  let title;
  if (choice.href) {
    title = lib.openUrl(choice.href, { quietMs: 2500, capMs: 15000 });
    out = [`opened link "${lib.clip(choice.name, 80)}" (${choice.note}) -> ${lib.clip(choice.href, 160)}`];
  } else {
    const how = clickNode(choice.node);
    title = how === "opened its URL" ? lib.windowTitle() : lib.settle(beforeTitle);
    const n = choice.node;
    const via = n.href ? ` -> ${lib.clip(n.href, 160)}` : "";
    out = [`clicked ${n.role ? `${n.role} ` : ""}${n.name ? `"${lib.clip(n.name, 80)}" ` : ""}${n.ref_id} (${how}${choice.note ? `, ${choice.note}` : ""})${via}`];
  }
  out.push(`title: ${lib.clip(title, 120)} (${title === beforeTitle ? "same" : "changed"})`);
  if (o.show !== undefined) {
    const re = regex(o.show, "--show");
    const page = lib.copyPage();
    if (page.url) out.push(`url: ${page.url}`);
    out.push(`text: ${lib.savePage(page.lines, undefined, page.links)} (${page.lines.length} lines)`);
    out.push(...lib.grepLines(page.lines, re, { limit: 15 }));
  }
  process.stdout.write(`${out.join("\n")}\n`);
}

main();
