#!/usr/bin/env node
// Finds one element and clicks it, then reports what changed: one call instead of find, read the ref, click, sleep, check
// (docs/decisions/0065-desktop-sandbox.md, "Token budget"). It never guesses: with no match or several it clicks nothing and
// lists the candidates (exit 2), so pick one with --nth N or a narrower pattern.
//
//   desktop-click "Najtańsze"                   the one link or button whose name matches (regex, any case)
//   desktop-click "Add to cart" --role button   other roles: --role R[,R]
//   desktop-click "Next" --nth 1                the second of several matches (0-based, in the order listed)
//   desktop-click @s1abc:e12                    a ref from desktop-find
//   desktop-click "Search" --show "results|zł"  also print the new page's matching lines (desktop-page)
//
// Flags: --app NAME (default firefox-esr), --role R[,R] (default link,button), --nth N, --all (also offscreen candidates),
// --show REGEX, --timeout-ms N (per find, default 60000).
// An element out of view is brought into view with the browser's find bar (its name typed, Escape), then clicked; if the
// accessibility click is still refused, a mouse click at its centre ("physical"). Output: what was clicked, title, url.
"use strict";
const fs = process.getBuiltinModule("node:fs");
const lib = process.getBuiltinModule("node:module").createRequire(fs.realpathSync(process.argv[1]))("./desktop-lib.cjs");

const fail = lib.failer("desktop-click");
const SCREEN = { width: 1280, height: 800 };
const MAX_CANDIDATES = 8;

function parseArgs(argv) {
  const o = { app: "firefox-esr", roles: [], all: false, timeout: "60000" };
  const value = (i, flag) => {
    if (i + 1 >= argv.length) fail(`${flag} needs a value`, 64);
    return argv[i + 1];
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--app") (o.app = value(i, a)), i++;
    else if (a === "--role") o.roles.push(...value(i++, a).split(",").map((r) => r.trim().toLowerCase()).filter(Boolean));
    else if (a === "--nth") (o.nth = Number(value(i, a))), i++;
    else if (a === "--show") (o.show = value(i, a)), i++;
    else if (a === "--timeout-ms") (o.timeout = value(i, a)), i++;
    else if (a === "--all") o.all = true;
    else if (a === "-h" || a === "--help") {
      process.stdout.write("usage: desktop-click [--role R[,R]] [--nth N] [--all] [--show REGEX] [--app NAME] <regex|@ref>\n");
      process.exit(0);
    } else if (a.startsWith("--")) fail(`unknown flag ${a}`, 64);
    else if (o.target === undefined) o.target = a;
    else fail(`unexpected argument ${a}`, 64);
  }
  if (o.target === undefined) fail("name a regex or an @ref to click", 64);
  if (o.nth !== undefined && (!Number.isInteger(o.nth) || o.nth < 0)) fail("--nth needs a non-negative integer", 64);
  if (o.roles.length === 0) o.roles = ["link", "button"];
  return o;
}

// Resolves a pattern to exactly one element, or exits 2 with the candidates.
function resolve(o) {
  let re;
  try {
    re = new RegExp(o.target, "iu");
  } catch (e) {
    fail(`bad regex: ${e.message}`, 64);
  }
  const found = lib.findAcross({ app: o.app, roles: o.roles, literal: lib.literalOf(o.target), timeout: o.timeout });
  if (found.answered === 0) fail(`agent-desktop find failed for every role: ${found.skipped.join(", ")}`);
  const seen = new Set();
  const hits = found.matches.filter((n) => {
    if (seen.has(n.ref_id)) return false;
    seen.add(n.ref_id);
    return [n.name, n.value, n.description].some((s) => typeof s === "string" && re.test(s));
  });
  // Visible candidates first: an offscreen duplicate of a visible control (a sticky header copy, a footer link) is rarely meant.
  const visible = hits.filter((n) => !lib.isHidden(n));
  const pool = o.all || visible.length === 0 ? hits : visible;
  const note = found.skipped.length > 0 ? ` (skipped, find failed: ${found.skipped.join(", ")})` : "";
  if (pool.length === 0) {
    process.stdout.write(`no ${o.roles.join("/")} matches /${o.target}/${note}; try --role, desktop-find, or desktop-page to see the text\n`);
    process.exit(2);
  }
  if (o.nth !== undefined) {
    if (o.nth >= pool.length) fail(`--nth ${o.nth} but only ${pool.length} matches`, 2);
    return pool[o.nth];
  }
  // The same role and name on every candidate (a product's image link and title link, a header and footer copy of one
  // control) is one target shown twice: click the first. Different names stay a choice for the agent.
  const same = pool.every((n) => n.role === pool[0].role && (n.name ?? "").trim() === (pool[0].name ?? "").trim());
  if (pool.length > 1 && same) {
    pool[0].note = `first of ${pool.length} identical`;
    return pool[0];
  }
  if (pool.length > 1) {
    const lines = [`${pool.length} matches, clicked none; add --nth N or narrow the pattern${note}:`];
    for (const [i, n] of pool.slice(0, MAX_CANDIDATES).entries()) lines.push(`  --nth ${i}: ${lib.nodeLine(n)}`);
    if (pool.length > MAX_CANDIDATES) lines.push(`  … ${pool.length - MAX_CANDIDATES} more`);
    process.stdout.write(`${lines.join("\n")}\n`);
    process.exit(2);
  }
  return pool[0];
}

const onScreen = (b) => b && b.width > 0 && b.height > 0 && b.x >= 0 && b.y >= 0 && b.x + b.width / 2 < SCREEN.width && b.y + b.height / 2 < SCREEN.height;

function bounds(ref) {
  const env = lib.envelope(lib.desktop(["get", ref, "--property", "bounds"]));
  return env.ok ? env.data?.value : undefined;
}

function click(ref) {
  return lib.envelope(lib.desktop(["click", ref]));
}

// Firefox's find bar scrolls the first occurrence of the text into view. The name may occur earlier on the page, so repeat
// (Return = next match) until the element itself is on screen, a few times at most. Only the typable ASCII prefix is typed.
function bringIntoView(ref, name) {
  const text = (name ?? "").replace(/\s+/g, " ").trim().match(/^[\x20-\x7e]*/u)[0].trim().slice(0, 60);
  if (text.length < 3) return false;
  lib.key("ctrl+f");
  lib.pause(300);
  lib.key("ctrl+a");
  lib.type(text);
  for (let i = 0; i < 5; i++) {
    lib.key("Return");
    lib.pause(400);
    if (onScreen(bounds(ref))) break;
  }
  lib.key("Escape");
  lib.pause(300);
  return onScreen(bounds(ref));
}

function main() {
  const o = parseArgs(process.argv.slice(2));
  const target = o.target.startsWith("@") ? { ref_id: o.target } : resolve(o);
  const ref = target.ref_id;
  const beforeTitle = lib.windowTitle();
  let how = "accessibility";
  let result = click(ref);
  // Refused (usually out of view; agent-desktop's own scroll fails in Firefox) or timed out resolving the element on a very
  // large page: bring it into view and try again, then a mouse click.
  if (!result.ok && ["ACTION_FAILED", "TIMEOUT"].includes(result.error?.code)) {
    const name = target.name ?? lib.envelope(lib.desktop(["get", ref, "--property", "text"])).data?.value;
    if (bringIntoView(ref, name)) result = click(ref);
    if (!result.ok) {
      const b = bounds(ref);
      if (onScreen(b)) {
        lib.exec("xdotool", "mousemove", String(Math.round(b.x + b.width / 2)), String(Math.round(b.y + b.height / 2)), "click", "1");
        result = { ok: true };
        how = "physical";
      }
    }
  }
  if (!result.ok) {
    const err = result.error ?? {};
    fail(`clicked nothing, ${err.code ?? "ERROR"}: ${err.message ?? "click failed"}`, 3);
  }
  const title = lib.settle(beforeTitle);
  const out = [`clicked ${target.role ? `${target.role} ` : ""}${target.name ? `"${lib.clip(target.name, 80)}" ` : ""}${ref} (${how}${target.note ? `, ${target.note}` : ""})`];
  out.push(`title: ${lib.clip(title, 120)} (${title === beforeTitle ? "same" : "changed"})`);
  if (o.show !== undefined) {
    let re;
    try {
      re = new RegExp(o.show, "iu");
    } catch (e) {
      fail(`bad --show regex: ${e.message}`, 64);
    }
    const page = lib.copyPage();
    if (page.url) out.push(`url: ${page.url}`);
    out.push(`text: ${lib.savePage(page.lines)} (${page.lines.length} lines)`);
    out.push(...lib.grepLines(page.lines, re, { limit: 15 }));
  }
  process.stdout.write(`${out.join("\n")}\n`);
}

main();
