#!/usr/bin/env -S node --no-warnings
// Web pages in the desktop's Chrome: reads them over a passive CDP connection (cdp-lib.cjs: accessibility tree, layout
// snapshot, element boxes; never Runtime.enable or script in the page) and acts with real X input through xdotool at a
// person's pace, so a page sees a person's browser (docs/decisions/0065-desktop-sandbox.md, "Chromium and desktop-web").
// Nothing here knows any site or language.
//
//   desktop-web open <url> ["regex"]          type the URL, wait, print url, title, open dialogs, matching lines or an outline
//   desktop-web text ["regex"]                the page's text lines matching the regex (full text saved to a file)
//   desktop-web text --lines 120-170          a range of lines of the page (or of --from FILE)
//   desktop-web snap ["regex"]                open dialogs, then clickable elements and headings with refs: [e123] link "Name";
//                                             with a regex also text that takes clicks: [e124] clickable "4K"
//   desktop-web click <ref|"regex">           click it with the mouse and print its new state and what changed; --near "row
//                                             text", --nth N, --role R, --show "regex". No element by that name: a line of
//                                             clickable text. Exit 1 when refused (disabled, covered), 2 when ambiguous.
//   desktop-web type <ref|"regex"> "text"     click a field, replace its text, print its value and what appeared; --enter,
//                                             --append. Exit 1 when the field kept its value (read-only)
//   desktop-web key <keys...>                 keys in the browser window (End, Page_Down, alt+Left, Escape); prints changes;
//                                             --text "answer" types text first (a prompt dialog), --show "regex"
//   desktop-web select <ref|"regex"> "option" pick an option of a dropdown (native or in-page) and print what it holds
//   desktop-web hover <ref|"regex">           move the pointer over it (menus, captions) and print what appeared
//   desktop-web shot <ref|"regex">            screenshot of that element's area (icons, colours, images): prints the file;
//                                             --pad N takes N more px around it
//   desktop-web wait "regex" [--gone]         wait until the text appears (or disappears); --timeout N seconds (at most 60)
//   desktop-web url                           url and title
//   desktop-web text "regex" --marks          also marks nameless pictures (icons, ratings) inline as ‹class words›
//
// When the page does not answer (a JS alert, confirm, prompt or leave-page dialog blocks it) every command says so, shows
// the dialog's message and buttons and how to answer it with desktop-web key.
//
// Every answer stays within a budget (BUDGET_LINES lines, BUDGET_CHARS characters): a longer one is cut with a note on
// how to page on. Flags: --limit N (matches, at most 40), --context N (at most 3), --lines A-B, --from FILE, --out FILE.
// Environment: PI_DESKTOP_CDP_PORT (default: the port desktop-launch wrote), PI_DESKTOP_STATE (/tmp/pi-desktop),
// PI_DESKTOP_FRAME (4, window frame px).
"use strict";
const fs = process.getBuiltinModule("node:fs");
const path = process.getBuiltinModule("node:path");
const { execFileSync } = process.getBuiltinModule("node:child_process");
const req = process.getBuiltinModule("node:module").createRequire(fs.realpathSync(process.argv[1]));
const lib = req("./desktop-lib.cjs");
const cdp = req("./cdp-lib.cjs");

const fail = lib.failer("desktop-web");
const STATE = process.env.PI_DESKTOP_STATE ?? "/tmp/pi-desktop";
const FRAME = Number(process.env.PI_DESKTOP_FRAME ?? 4);
const BUDGET_LINES = 60;
const BUDGET_CHARS = 4000;
const PROBE_MS = 2500;
const WIDTH = 200;
const REFS = () => path.join(lib.sessionDir(), "web-refs.json");

// desktop-launch starts Chrome on a random port and writes it to the state directory.
function port() {
  if (process.env.PI_DESKTOP_CDP_PORT) return process.env.PI_DESKTOP_CDP_PORT;
  try {
    return fs.readFileSync(path.join(STATE, "cdp-port"), "utf8").trim() || undefined;
  } catch {
    return undefined;
  }
}
const target = async () => {
  const p = port();
  return p ? cdp.pageTarget(p) : undefined;
};

function parseArgs(argv) {
  const o = { pos: [], context: 1, enter: false, append: false };
  const val = (i, f) => {
    if (i + 1 >= argv.length) fail(`${f} needs a value`, 64);
    return argv[i + 1];
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--limit") (o.limit = Math.min(Number(val(i, a)), 40)), i++;
    else if (a === "--context") (o.context = Math.min(Number(val(i, a)), 3)), i++;
    else if (a === "--near") (o.near = val(i, a)), i++;
    else if (a === "--nth") (o.nth = Number(val(i, a))), i++;
    else if (a === "--show") (o.show = val(i, a)), i++;
    else if (a === "--role") (o.role = val(i, a)), i++;
    else if (a === "--from") (o.from = val(i, a)), i++;
    else if (a === "--out") (o.out = val(i, a)), i++;
    else if (a === "--lines") (o.lines = val(i, a)), i++;
    else if (a === "--timeout") (o.timeout = Number(val(i, a))), i++;
    else if (a === "--text") (o.text = val(i, a)), i++;
    else if (a === "--pad") (o.pad = Math.min(Math.max(Number(val(i, a)), 0), 300)), i++;
    else if (a === "--gone") o.gone = true;
    else if (a === "--marks") o.marks = true;
    else if (a === "--enter") o.enter = true;
    else if (a === "--append") o.append = true;
    else o.pos.push(a);
  }
  return o;
}

const regex = (s) => {
  try {
    return new RegExp(s, "i");
  } catch (e) {
    fail(`bad regex ${JSON.stringify(s)}: ${e.message}`, 64);
  }
};

// Cuts an answer to the budget and says how to get the rest.
function budget(lines, hint) {
  const out = [];
  let chars = 0;
  for (const l of lines) {
    if (out.length >= BUDGET_LINES || chars + l.length > BUDGET_CHARS) {
      out.push(`[cut at ${out.length} lines: ${hint}]`);
      return out;
    }
    out.push(l);
    chars += l.length + 1;
  }
  return out;
}
const PAGE_HINT = 'narrow the regex, or read a range with desktop-web text --lines A-B';

// The browser window: the last visible Chrome top-level window.
function chromeWindow() {
  let ids;
  try {
    ids = lib.exec("xdotool", "search", "--onlyvisible", "--class", "[Gg]oogle-chrome").trim().split("\n").filter(Boolean);
  } catch {
    ids = [];
  }
  if (ids.length === 0) return undefined;
  const id = ids[ids.length - 1];
  const g = Object.fromEntries(
    lib
      .exec("xdotool", "getwindowgeometry", "--shell", id)
      .trim()
      .split("\n")
      .map((l) => l.split("=")),
  );
  return { id, x: Number(g.X), y: Number(g.Y), width: Number(g.WIDTH), height: Number(g.HEIGHT) };
}

// Activating a window that already has focus is not needed, and it would close a dropdown's popup (a separate grab window).
function activate(win) {
  try {
    if (lib.exec("xdotool", "getactivewindow").trim() === win.id) return;
  } catch {
    // no active window: activate below
  }
  try {
    lib.exec("xdotool", "windowactivate", "--sync", win.id);
  } catch {
    // openbox may refuse a window that is already active; input still goes to it
  }
}

async function ensureBrowser() {
  if (await target()) return;
  try {
    execFileSync("desktop-launch", ["chrome"], { stdio: ["ignore", "ignore", "pipe"] });
  } catch (e) {
    fail(`Chrome did not start: ${String(e.stderr || e.message).trim().split("\n")[0]}`);
  }
  for (let i = 0; i < 60; i++) {
    if (await target()) return;
    lib.pause(500);
  }
  fail("Chrome did not answer on its debugging port");
}

async function withPage(fn, { timeoutMs } = {}) {
  const t = await target();
  if (!t) fail("Chrome is not running: start with desktop-web open <url>");
  const c = await cdp.connect(t.webSocketDebuggerUrl, { timeoutMs });
  c.target = t;
  c.extra = [];
  try {
    return await fn(c, t);
  } finally {
    for (const e of c.extra) e.close();
    c.close();
  }
}

// The page and the iframes that run in their own process (another site), each read through its own connection. A frame of
// the same process is part of its page: its documents come with the snapshot, its accessibility tree with its frame id.
// An iframe whose element a person cannot see (hidden, 0 px) is left out, like any other hidden element.
async function frameParts(c) {
  if (c.parts) return c.parts;
  c.parts = (async () => {
    const root = { tag: "", send: c.send, target: c.target.id };
    const parts = [root];
    for (const s of cdp.iframeTargets(await cdp.targetList(port()), c.target.id)) {
      try {
        const conn = await cdp.connect(s.webSocketDebuggerUrl);
        c.extra.push(conn);
        parts.push({ tag: s.tag, send: conn.send, target: s.id, parent: parts.find((p) => p.target === s.parentId) });
      } catch {
        // gone since the list was read
      }
    }
    for (const p of parts) {
      try {
        p.frameIds = cdp.childFrameIds((await p.send("Page.getFrameTree")).frameTree);
      } catch {
        p.frameIds = [];
      }
    }
    return parts;
  })();
  return c.parts;
}

// Where an out-of-process iframe's viewport sits in the page's: the top left of its iframe element's content box in the part
// that holds it, and so on up. (Boxes of a frame of the same process already come in the page's coordinates.)
async function partOrigin(part) {
  let o = { x: 0, y: 0 };
  for (let p = part; p.parent; p = p.parent) {
    const owner = await p.parent.send("DOM.getFrameOwner", { frameId: p.target });
    const box = await p.parent.send("DOM.getBoxModel", { backendNodeId: owner.backendNodeId });
    const q = cdp.quadOrigin(box.model.content);
    o = { x: o.x + q.x, y: o.y + q.y };
  }
  return o;
}

async function axOf(part) {
  const trees = [{ nodes: (await part.send("Accessibility.getFullAXTree")).nodes, prefix: "" }];
  for (const [k, frameId] of part.frameIds.entries()) {
    try {
      trees.push({ nodes: (await part.send("Accessibility.getFullAXTree", { frameId })).nodes, prefix: `f${k}:` });
    } catch {
      // a frame that is gone, or not of this process
    }
  }
  return trees.flatMap((t) => cdp.prefixNodes(t.nodes, `${part.tag}${t.prefix}`, part.tag));
}

// Reads every visible part: its layout snapshot, the elements hidden in it and, with `ax`, its accessibility nodes.
async function readParts(c, { ax = false } = {}) {
  const parts = await frameParts(c);
  const read = await Promise.all(
    parts.map(async (part) => {
      const [snap, nodes] = await Promise.all([
        part.send("DOMSnapshot.captureSnapshot", { computedStyles: cdp.STYLES }),
        ax ? axOf(part) : undefined,
      ]);
      return { part, snap, nodes, hidden: cdp.hiddenElements(snap) };
    }),
  );
  const shown = new Set();
  const out = [];
  for (const r of read) {
    if (r.part.parent) {
      const up = read.find((x) => x.part === r.part.parent);
      if (!shown.has(r.part.parent)) continue;
      try {
        const owner = await up.part.send("DOM.getFrameOwner", { frameId: r.part.target });
        if (up.hidden.has(owner.backendNodeId)) continue;
      } catch {
        continue;
      }
    }
    shown.add(r.part);
    out.push(r);
  }
  return out;
}

async function pageLines(c, { marks = false } = {}) {
  return (await readParts(c)).flatMap((r) => cdp.wrapLines(cdp.snapshotLines(r.snap, { marks }), WIDTH));
}

// A page whose renderer is blocked (a JS alert, confirm, prompt or leave-page dialog is open, or it is stuck in a loop) still
// lists its target, but Page.getLayoutMetrics, answered by the renderer, never comes back. Every read would then wait out its
// 20 s timeout and say nothing, so each command asks this first. Returns "none" (no page), "ok" or "blocked".
async function probe() {
  const t = await target();
  if (!t) return { state: "none" };
  let c;
  try {
    c = await cdp.connect(t.webSocketDebuggerUrl, { timeoutMs: PROBE_MS });
    await c.send("Page.getLayoutMetrics");
    return { state: "ok", target: t };
  } catch (e) {
    return { state: /timed out/.test(e.message) ? "blocked" : "ok", target: t };
  } finally {
    c?.close();
  }
}

// What a blocked page shows: Chrome's own dialog is in the accessibility tree (AT-SPI) even while the page is stuck, so its
// title, message and buttons are text; when it is not there, a screenshot of where such a dialog sits (the top centre of the
// window, under the toolbar). Says how to answer it.
function blockedLines({ still = false } = {}) {
  const out = [
    `${still ? "Still blocked: the" : "The"} page is not answering: a browser dialog (alert, confirm, prompt or leave-page) is probably open, or the page is busy.`,
  ];
  let d;
  try {
    d = lib.atspiDialog(lib.envelope(lib.desktop(["snapshot", "--app", "chrome", "--timeout-ms", "3000"])).data?.tree);
  } catch {
    d = undefined;
  }
  if (d) {
    out.push(`dialog "${lib.clip(d.title, 80)}": ${lib.clip(d.message, 300)}`);
    if (d.fields.length > 0) out.push(`text field: ${JSON.stringify(d.fields[0])}`);
    out.push(`buttons: ${d.buttons.map((b) => `${b.name}${b.focused ? " (default)" : ""}`).join(" | ")}`);
  } else {
    const win = chromeWindow();
    if (win) {
      const w = Math.min(760, win.width);
      try {
        const shot = execFileSync("desktop-shot", ["--region", `${win.x + Math.round((win.width - w) / 2)},${win.y + 60},${w},300`], { encoding: "utf8" });
        out.push(`dialog area (read this image): ${shot.trim().split(" ")[0]}`);
      } catch {
        // no screenshot: the instructions below still apply
      }
    }
  }
  out.push(
    'OK: desktop-web key Return. Cancel: desktop-web key Escape. A prompt: desktop-web key --text "answer" Return. If nothing is open the page is busy: wait and run the command again.',
  );
  return out;
}

// Stops a command that needs the page when the page is blocked, saying why.
async function guard() {
  if ((await probe()).state !== "blocked") return;
  console.log(blockedLines().join("\n"));
  process.exit(3);
}

const fingerprint = (lines) => `${lines.length}:${lines.join("\n").length}:${lines.slice(-3).join("|")}`;

// Waits for the page to answer an action: the URL or title changes, or nothing changes within quietMs (an in-page
// update); then the page's text must hold still for two reads in a row, and, with `want`, contain a match for it.
// All within capMs. Returns { target, lines }.
async function settle(before, { quietMs = 1500, capMs = 20000, want } = {}) {
  const start = Date.now();
  let t = before;
  let probed = false;
  while (Date.now() - start < quietMs) {
    t = (await target()) ?? t;
    if (t.url !== before.url || t.title !== before.title) break;
    lib.pause(250);
    // A click that opens a JS dialog changes nothing else: look once after a second, not after the whole quiet time.
    if (!probed && Date.now() - start >= 1000) {
      probed = true;
      if ((await probe()).state === "blocked") return { target: t, lines: [], blocked: true };
    }
  }
  let lines = [];
  let last;
  let same = 0;
  while (Date.now() - start < capMs) {
    lib.pause(400);
    try {
      lines = await withPage((c) => pageLines(c));
    } catch {
      same = 0; // between documents
      if ((await probe()).state === "blocked") return { target: (await target()) ?? t, lines: [], blocked: true };
      continue;
    }
    const f = fingerprint(lines);
    same = lines.length >= 3 && f === last ? same + 1 : 0;
    last = f;
    if (same >= 1 && (!want || lines.some((l) => want.test(l)))) break;
  }
  return { target: (await target()) ?? t, lines };
}

const header = (t) => [`url: ${t.url}`, `title: ${t.title}`];
const pageFile = (o) => o.out ?? path.join(lib.sessionDir(), "web-page.txt");

// Roles a hover or a screenshot can aim at besides what a click can: pictures and groups of things, found by their name.
const SHOWABLE = new Set(["image", "img", "figure", "article", "group", "listitem", "row", "cell", "region", "list"]);

// The page's elements to act on, with the page's text lines from the same read. `options` adds a native select's options
// (read from the layout snapshot, where a closed select's options are nodes all the same) to its entry as `options` and
// `select`; `showable` also lists named pictures and groups, for hover and shot. Hidden elements are left out (but a hidden
// checkbox or radio behind a visible label is kept, `via` the label), fields get their placeholder and nameless controls
// words from their markup or row (cdp.annotate, cdp.nameUnnamed).
async function axTree(c, { options = false, showable = false } = {}) {
  const read = await readParts(c, { ax: true });
  const nodes = read.flatMap((r) => r.nodes);
  const all = cdp.axEntries(nodes, showable ? { extraRoles: SHOWABLE } : {});
  let entries = read.flatMap((r) => cdp.annotate(all.filter((e) => (e.frameTag ?? "") === r.part.tag), r.snap, r.hidden));
  entries = cdp.nameUnnamed(nodes, entries);
  if (options) {
    const selects = new Map(read.map((r) => [r.part.tag, cdp.selectInfos(r.snap)]));
    for (const e of entries) {
      const info = selects.get(e.frameTag ?? "")?.get(e.backendNodeId);
      if (info) Object.assign(e, { options: info.options, select: info });
    }
  }
  const lines = read.flatMap((r) => cdp.wrapLines(cdp.snapshotLines(r.snap), WIDTH));
  return { nodes, entries: cdp.mainFirst(nodes, entries), read, lines };
}

// Lines of text a click can act on that no element's name matches (cdp.textTargets), as entries of role "clickable". Text
// inside a listed element, or inside the label a listed checkbox is clicked through, is that element's.
function textEntries(tree, re) {
  const out = [];
  for (const r of tree.read) {
    const own = tree.entries.filter((e) => (e.frameTag ?? "") === r.part.tag);
    const skip = new Set([...own.map((e) => e.backendNodeId), ...own.map((e) => e.via).filter((v) => v !== undefined)]);
    for (const t of cdp.textTargets(r.snap, re, { skip })) {
      if (r.hidden.has(t.backendNodeId)) continue;
      const tag = r.part.tag || undefined;
      out.push({ ref: `e${t.backendNodeId}${tag ? `@${tag}` : ""}`, frameTag: tag, backendNodeId: t.backendNodeId, role: "clickable", name: t.name });
    }
  }
  return out;
}

// Accessibility nodes of the page and its iframes, for dialogs and outlines.
async function axNodes(c) {
  return (await Promise.all((await frameParts(c)).map(axOf))).flat();
}

// Elements whose name, placeholder or row matches when no text line does (a field's label and placeholder are not page text).
// `tree` reads axTree when called.
async function namedLike(re, tree) {
  const t = await tree().catch(() => undefined);
  const els = (t?.entries ?? []).filter((e) => cdp.matchTexts(e).some((x) => re.test(x))).slice(0, 5);
  if (els.length === 0) return [];
  rememberRefs(els, { merge: true });
  return ["elements that match (no text line does):", ...els.map((e) => `  ${cdp.entryLine(e, { nameMax: 70 })}`)];
}

// What a page shows first: open dialogs, then the matching lines, or without a regex an outline of its headings.
async function describe(lines, nodes, pattern, o, tree) {
  const file = lib.savePage(lines, pageFile(o));
  const out = cdp.dialogLines(cdp.dialogs(nodes));
  if (pattern) {
    const hits = lib.grepLines(lines, regex(pattern), { limit: o.limit ?? 25, context: o.context, width: WIDTH });
    out.push(...hits);
    if (hits.length === 1 && hits[0].startsWith("no match")) out.push(...(await namedLike(regex(pattern), tree)), "outline:", ...cdp.outline(nodes, lines));
  } else {
    const ol = cdp.outline(nodes, lines);
    out.push(...(ol.length > 0 ? ["outline (line: heading):", ...ol] : lines.slice(0, 15).map((l, i) => `${i + 1}: ${l}`)));
  }
  out.push(`(${lines.length} lines in ${file}; read with desktop-web text "regex" or --lines A-B)`);
  return out;
}

// Refs a listing showed, with the role and name each stood for: a later command checks a ref against them, and finds the
// element again by them when the page has replaced it. A full snap replaces the list; a partial listing adds to it.
function rememberRefs(entries, { merge = false } = {}) {
  let refs = {};
  if (merge) refs = readRefs();
  for (const e of entries) refs[e.ref] = { role: e.role, name: e.name };
  fs.mkdirSync(path.dirname(REFS()), { recursive: true });
  fs.writeFileSync(REFS(), JSON.stringify(refs));
}
function readRefs() {
  try {
    return JSON.parse(fs.readFileSync(REFS(), "utf8"));
  } catch {
    return {};
  }
}
const escapeRe = (s) => s.replace(/[\\^$.*+?()[\]{}|]/g, "\\$&");
const isRef = (spec) => /^e\d+(@\w+)?$/.test(spec);

// Resolves a ref (e123) or a name regex to one element. A ref is checked against what snap listed under it, so a ref left
// over from another page cannot click a different element; a ref whose element the page replaced (a re-render) is found
// again by its role and name when exactly one element has them, and `note` says so. A name regex that matches no element
// falls back, with `text`, to a line of clickable text (textEntries). Lists the candidates and exits 2 when a name is
// ambiguous. `tree` is a read of axTree to reuse.
async function resolveTarget(c, spec, o, { fieldsOnly = false, selectsOnly = false, text = false, tree, ...read } = {}) {
  tree ??= await axTree(c, read);
  const { nodes, entries } = tree;
  if (isRef(spec)) {
    const was = readRefs()[spec];
    let now = entries.find((e) => e.ref === spec);
    if (!now && was?.role === "clickable") now = textEntries(tree, new RegExp(`^${escapeRe(was.name.replace(/…$/, ""))}`)).find((e) => e.ref === spec);
    let note;
    if (!now && was) {
      const pool = was.role === "clickable" ? textEntries(tree, new RegExp(`^${escapeRe(was.name.replace(/…$/, ""))}`)) : entries;
      const same = pool.filter((e) => e.role === was.role && e.name === was.name);
      if (same.length === 1) {
        now = same[0];
        note = `${spec} is gone (the page replaced it); using ${now.ref}, the one ${was.role} "${lib.clip(was.name, 60)}" on the page now`;
        rememberRefs([now], { merge: true });
      }
    }
    if (!now) fail(`${spec} is not on the page now (it changed or the element is hidden): run desktop-web snap again`);
    if (!note && was && (was.role !== now.role || was.name !== now.name))
      fail(`${spec} is now ${cdp.entryLine(now)}, not the ${was.role} "${lib.clip(was.name, 60)}" snap listed: run desktop-web snap again`);
    return { entry: now, nodes, note };
  }
  const pool = fieldsOnly
    ? entries.filter((e) => ["textbox", "searchbox", "combobox", "spinbutton"].includes(e.role))
    : selectsOnly
      ? entries.filter((e) => e.select || ["combobox", "listbox"].includes(e.role))
      : entries;
  const re = regex(spec);
  let r = cdp.chooseTarget(nodes, pool, re, { near: o.near ? regex(o.near) : undefined, nth: o.nth, role: o.role, showable: read.showable });
  if (r.none && text && !r.near && !o.role) {
    // No element is named so: a line of text that takes clicks (a role-less option), if exactly one, or the exact one.
    const hits = textEntries(tree, re);
    const whole = new RegExp(`^(?:${re.source})$`, re.flags);
    const exact = hits.filter((e) => whole.test(e.name));
    const pick = o.nth !== undefined ? hits[o.nth - 1] : hits.length === 1 ? hits[0] : exact.length === 1 ? exact[0] : undefined;
    if (pick) return { entry: pick, nodes, note: "no element has that name; clicked the text" };
    if (hits.length > 1) r = { several: hits };
  }
  if (r.pick) return { entry: r.pick, nodes };
  if (r.none) {
    const d = cdp.dialogLines(cdp.dialogs(nodes));
    fail(
      [
        r.near
          ? `nothing matching ${JSON.stringify(spec)} near ${JSON.stringify(o.near)}`
          : `nothing ${read.showable ? "" : "clickable "}matches ${JSON.stringify(spec)}: try desktop-web snap "word"`,
        ...d,
      ].join("\n"),
    );
  }
  const rows = cdp.rowTexts(nodes, r.several.map((e) => ({ ...e, nodeId: e.nodeId ?? "" })));
  rememberRefs(r.several, { merge: true });
  const lines = r.several.slice(0, 15).map((e, i) => {
    // The row text starts with the element's own name more often than not: show only what tells the rows apart.
    const row = rows[i].startsWith(e.name) ? rows[i].slice(e.name.length).trim() : rows[i];
    return `${cdp.entryLine(e, { nameMax: 70 })}${row ? `  | ${lib.clip(row, 120)}` : ""}${e.url ? ` -> ${lib.clip(e.url, 90)}` : ""}`;
  });
  process.stdout.write(
    `${r.several.length} elements match ${JSON.stringify(spec)}; nothing clicked. Click one by ref (desktop-web click e123), or add --near "text from its row":\n${lines.join("\n")}\n`,
  );
  process.exit(2);
}

// Says what covers the element at `point` (its viewport's coordinates), or nothing when the click would reach it.
// getNodeForLocation takes document coordinates: the viewport point plus the scroll offset.
async function coveredBy(send, backendNodeId, quad, point, nodes) {
  const lp = (await send("Page.getLayoutMetrics")).cssLayoutViewport;
  const hit = await send("DOM.getNodeForLocation", {
    x: Math.round(point.x + lp.pageX),
    y: Math.round(point.y + lp.pageY),
    includeUserAgentShadowDOM: true,
  }).catch(() => undefined);
  if (!hit || hit.backendNodeId === backendNodeId) return undefined;
  const inside = cdp.subtreeIds((await send("DOM.describeNode", { backendNodeId, depth: -1, pierce: true })).node);
  if (inside.has(hit.backendNodeId)) return undefined;
  const hb = await send("DOM.getBoxModel", { backendNodeId: hit.backendNodeId }).catch(() => undefined);
  // A wrapper around the element and only a little larger (a link around a span) takes the same click; anything else
  // under the point (a dialog's text, a big layer) means the element is covered.
  if (hb && cdp.wraps(hb.model.border, quad)) return undefined;
  const d = (await send("DOM.describeNode", { backendNodeId: hit.backendNodeId })).node;
  const cls = (d.attributes ?? []).reduce((s, v, i, a) => (a[i - 1] === "class" ? v : s), "");
  return [
    `another element covers it (${d.nodeName.toLowerCase()}${cls ? `.${lib.clip(cls, 40)}` : ""}): something is in front. Close or answer it first`,
    ...cdp.dialogLines(cdp.dialogs(nodes)),
  ].join("\n");
}

// Scrolls the element into view, checks nothing covers it (unless `cover` is false: a screenshot shows what covers it), and
// returns where it is on the screen: { box: {x, y, w, h}, win }. An element of an out-of-process iframe is read through that
// frame's connection and placed in the page by its iframe element's content box.
async function placeNode(c, nodes, entry, { cover = true } = {}) {
  // A checkbox drawn by its label is clicked on the label, which a person sees and which toggles it.
  const backendNodeId = entry.via ?? entry.backendNodeId;
  const part = (await frameParts(c)).find((p) => p.tag === (entry.frameTag ?? ""));
  if (!part) fail("the iframe of that element is gone: run desktop-web snap again");
  try {
    await part.send("DOM.scrollIntoViewIfNeeded", { backendNodeId });
  } catch {
    // not scrollable (fixed position); the box check below still applies
  }
  let quad;
  try {
    quad = (await part.send("DOM.getBoxModel", { backendNodeId })).model.border;
  } catch {
    const q = await part.send("DOM.getContentQuads", { backendNodeId }).catch(() => ({ quads: [] }));
    quad = q.quads[0];
  }
  if (!quad) fail("the element has no box on the page (hidden or removed): run desktop-web snap again");
  const lm = await c.send("Page.getLayoutMetrics");
  const vp = lm.cssLayoutViewport;
  const zoom = lm.cssVisualViewport.zoom ?? 1;
  // The part of the page where a click can reach: the viewport, and for an iframe its own viewport inside it.
  let reach = { x: 0, y: 0, w: vp.clientWidth, h: vp.clientHeight };
  let origin = { x: 0, y: 0 };
  if (part.parent) {
    origin = await partOrigin(part).catch(() => fail("the iframe of that element is gone: run desktop-web snap again"));
    const own = (await part.send("Page.getLayoutMetrics")).cssLayoutViewport;
    const x = Math.max(reach.x, origin.x);
    const y = Math.max(reach.y, origin.y);
    reach = { x, y, w: Math.min(reach.x + reach.w, origin.x + own.clientWidth) - x, h: Math.min(reach.y + reach.h, origin.y + own.clientHeight) - y };
  }
  const pageQuad = cdp.shiftQuad(quad, origin.x, origin.y);
  const center = cdp.quadCenter(pageQuad);
  if (center.x < reach.x || center.y < reach.y || center.x > reach.x + reach.w || center.y > reach.y + reach.h)
    fail("the element is outside the visible page and could not be scrolled into view");
  // Something in front (a dialog, an overlay) would get the click instead: say what, rather than click it. For an iframe
  // that is checked at each frame on the way: the iframe element in its holder, then the element in its own frame.
  const checks = [];
  for (let p = part; p.parent; p = p.parent) {
    const owner = await p.parent.send("DOM.getFrameOwner", { frameId: p.target });
    const box = (await p.parent.send("DOM.getBoxModel", { backendNodeId: owner.backendNodeId })).model.border;
    const o = await partOrigin(p.parent);
    checks.push({ send: p.parent.send, id: owner.backendNodeId, quad: box, point: { x: center.x - o.x, y: center.y - o.y } });
  }
  checks.push({ send: part.send, id: backendNodeId, quad, point: { x: center.x - origin.x, y: center.y - origin.y } });
  for (const k of cover ? checks : []) {
    const why = await coveredBy(k.send, k.id, k.quad, k.point, nodes);
    if (why) fail(why);
  }
  const win = chromeWindow();
  if (!win) fail("no Chrome window on the screen");
  // clientHeight leaves out a horizontal scrollbar, which takes the bottom of the window's page area: the viewport's top is
  // found from its full height.
  const bar = await cdp.scrollbarThickness(
    (y) => c.send("DOM.getNodeForLocation", { x: 1, y: Math.round(y + vp.pageY) }).then(() => true, () => false),
    vp.clientHeight,
  );
  const geo = { win, viewport: { height: vp.clientHeight + bar }, zoom, frame: FRAME };
  const xs = [pageQuad[0], pageQuad[2], pageQuad[4], pageQuad[6]];
  const ys = [pageQuad[1], pageQuad[3], pageQuad[5], pageQuad[7]];
  const tl = cdp.screenPoint(geo, { x: Math.max(Math.min(...xs), reach.x), y: Math.max(Math.min(...ys), reach.y) });
  const br = cdp.screenPoint(geo, { x: Math.min(Math.max(...xs), reach.x + reach.w), y: Math.min(Math.max(...ys), reach.y + reach.h) });
  return { box: { x: tl.x, y: tl.y, w: Math.max(br.x - tl.x, 1), h: Math.max(br.y - tl.y, 1) }, win };
}

async function clickNode(c, nodes, entry) {
  const { box, win } = await placeNode(c, nodes, entry);
  activate(win);
  return lib.humanClick(box);
}

// The pointer over the element without a press: menus and captions that appear on hover. A dwell for the page's own handlers.
async function hoverNode(c, nodes, entry) {
  const { box, win } = await placeNode(c, nodes, entry);
  activate(win);
  const at = lib.humanMove(box);
  lib.pause(450);
  return at;
}

// The state an action is measured against: the page's text lines, its elements and its accessibility nodes (dialogs, alerts).
const stateOf = (tree) => ({ lines: tree.lines, entries: tree.entries, nodes: tree.nodes });
const squash = (s) => String(s ?? "").replace(/\s+/g, " ").trim();
const OPTION_ROLES = new Set(["option", "menuitem", "menuitemradio", "menuitemcheckbox", "treeitem"]);

// What an action did: the new page, or what changed on this one (dialogs that closed, alerts that appeared, lines that
// appeared or went, other controls whose state changed), within the budget. `now` is a read after the action (read here when
// not given); `self` is the element acted on, whose own change the caller reports (`selfChanged`). The "result may come
// later" hint comes only when nothing changed at all, or the page shows it is busy.
async function changes(pre, before, after, o, { now, self, selfChanged = false } = {}) {
  now ??= await withPage((c) => axTree(c)).catch(() => undefined);
  const nodes = now?.nodes ?? [];
  const out = header(after.target);
  const navigated = after.target.url !== before.url;
  const shown = cdp.dialogs(nodes);
  out.push(...cdp.dialogLines(shown));
  let nothing = false;
  if (o.show) {
    lib.savePage(after.lines, pageFile(o));
    out.push(...lib.grepLines(after.lines, regex(o.show), { limit: o.limit ?? 25, context: o.context, width: WIDTH }));
  } else if (navigated) {
    out.push(...(await describe(after.lines, nodes, undefined, o, async () => now)).slice(cdp.dialogLines(shown).length));
  } else {
    const added = cdp.newLines(pre.lines, after.lines);
    const gone = after.lines.length > 0 ? cdp.newLines(after.lines, pre.lines) : [];
    const was = cdp.dialogs(pre.nodes);
    const closed = cdp.closedDialogs(was, shown);
    const opened = cdp.closedDialogs(shown, was);
    const had = new Set(cdp.liveTexts(pre.nodes));
    const alerts = cdp.liveTexts(nodes).filter((t) => !had.has(t));
    const diffs = now ? cdp.controlDiffs(pre.entries, now.entries, { skip: self?.ref }) : [];
    lib.savePage(after.lines, pageFile(o));
    out.push(...closed.map((d) => `closed ${d}`), ...alerts.slice(0, 3));
    if (added.length > 0) out.push(`changed (${added.length} new lines):`, ...added.slice(0, 20));
    if (added.length > 20) out.push(`... ${added.length - 20} more: desktop-web text "regex"`);
    if (gone.length > 0) out.push(`gone (${gone.length} lines): ${gone.slice(0, 3).map((l) => lib.clip(l, 60)).join(" | ")}${gone.length > 3 ? " | ..." : ""}`);
    out.push(...diffs.slice(0, 5));
    if (diffs.length > 5) out.push(`... ${diffs.length - 5} more controls changed: desktop-web snap`);
    if (added.length === 0 && gone.length === 0) out.push("page text unchanged");
    nothing = !added.length && !gone.length && !closed.length && !opened.length && !alerts.length && !diffs.length && !selfChanged;
    if (nothing) {
      const bad = (now?.entries ?? []).filter((e) => e.invalid);
      if (bad.length > 0) out.push(`invalid fields: ${bad.slice(0, 5).map((e) => cdp.entryLine(e, { nameMax: 40 })).join(" | ")}`);
    }
    if (self?.role === "link" && !o.noHint) out.push("note: the address did not change");
  }
  if (!o.show && !o.noHint && !navigated && (nothing || cdp.busy(nodes))) out.push('result may come later: desktop-web wait "regex"');
  return budget(out, PAGE_HINT);
}

// What typing did without Enter, kept short: the options that appeared (an autocomplete), else at most 5 new lines (a
// filter's results) and new alert text.
async function afterTyping(pre, after, typed, o) {
  const now = await withPage((c) => axTree(c)).catch(() => undefined);
  lib.savePage(after.lines, pageFile(o));
  const known = new Set(pre.entries.map((e) => e.ref));
  const opts = (now?.entries ?? []).filter((e) => OPTION_ROLES.has(e.role) && !known.has(e.ref));
  const had = new Set(cdp.liveTexts(pre.nodes));
  const out = cdp.liveTexts(now?.nodes ?? []).filter((t) => !had.has(t)).slice(0, 2);
  if (opts.length > 0) {
    rememberRefs(opts, { merge: true });
    out.push(`options (${opts.length}):`, ...opts.slice(0, 5).map((e) => `  ${cdp.entryLine(e, { nameMax: 70 })}`));
    if (opts.length > 5) out.push(`  ... ${opts.length - 5} more: desktop-web snap "regex"`);
    return out;
  }
  const added = cdp.newLines(pre.lines, after.lines).filter((l) => l !== squash(typed));
  const gone = after.lines.length > 0 ? cdp.newLines(after.lines, pre.lines).length : 0;
  if (added.length > 0) out.push(`changed (${added.length} new lines):`, ...added.slice(0, 5));
  if (added.length > 5) out.push(`... ${added.length - 5} more: desktop-web text "regex"`);
  if (gone > 0) out.push(`(${gone} lines gone)`);
  return out;
}

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  const o = parseArgs(rest);
  switch (cmd) {
    case "open": {
      const url = o.pos[0];
      if (!url) fail('usage: desktop-web open <url> ["regex"]', 64);
      if (!/^https?:\/\//.test(url) && !url.startsWith("file:///workspace/")) fail("give a full https:// URL", 64);
      await ensureBrowser();
      await guard();
      const before = await target();
      const win = chromeWindow();
      if (!win) fail("no Chrome window on the screen");
      activate(win);
      lib.key("ctrl+l");
      lib.pause(150);
      // A URL is pasted, as people do; typing a long one key by key would take seconds.
      lib.pasteText(url);
      lib.key("Delete"); // drops an inline completion the address bar may have added
      lib.pause(120);
      lib.key("Return");
      const after = await settle(before, { quietMs: 8000, capMs: 25000, want: o.pos[1] ? regex(o.pos[1]) : undefined });
      if (after.blocked) {
        console.log([...header(after.target), ...blockedLines()].join("\n"));
        return;
      }
      const nodes = await withPage(axNodes);
      const out = [...header(after.target), ...(await describe(after.lines, nodes, o.pos[1], o, () => withPage((c) => axTree(c))))];
      if (after.target.url === before.url && before.url !== "about:blank") out.push("note: the address did not change");
      console.log(budget(out, PAGE_HINT).join("\n"));
      return;
    }
    case "text": {
      let lines;
      let head = [];
      if (o.from) lines = fs.readFileSync(o.from, "utf8").replace(/\n$/, "").split("\n");
      else {
        await guard();
        const r = await withPage(async (c, t) => ({ lines: await pageLines(c, { marks: o.marks }), t }));
        lines = r.lines;
        head = header(r.t);
        // The saved text stays the plain page: its line numbers are what outlines and --lines refer to.
        if (!o.marks) lib.savePage(lines, pageFile(o));
        else head.push("(marks ‹…› come from the page's markup, and line numbers differ from the saved text)");
      }
      if (o.lines) {
        const m = /^(\d+)-(\d+)$/.exec(o.lines);
        if (!m) fail("--lines takes A-B, e.g. --lines 120-170", 64);
        const a = Math.max(Number(m[1]), 1);
        const b = Math.min(Number(m[2]), lines.length, a + BUDGET_LINES - 1);
        const out = [...head, ...lines.slice(a - 1, b).map((l, i) => `${a + i}: ${l}`)];
        if (b < Number(m[2]) && b < lines.length) out.push(`[${b - a + 1} lines shown; continue with --lines ${b + 1}-${b + BUDGET_LINES}]`);
        console.log(budget(out, `continue with --lines`).join("\n"));
        return;
      }
      const pattern = o.pos[0];
      if (!pattern) fail('give a regex of the words you need, or --lines A-B', 64);
      const hits = lib.grepLines(lines, regex(pattern), { limit: o.limit ?? 25, context: o.context, width: WIDTH });
      if (!o.from && hits.length === 1 && hits[0].startsWith("no match")) hits.push(...(await namedLike(regex(pattern), () => withPage((c) => axTree(c)))));
      const out = [...head, ...hits, `(${lines.length} lines${o.from || o.marks ? "" : ` in ${pageFile(o)}`})`];
      console.log(budget(out, PAGE_HINT).join("\n"));
      return;
    }
    case "snap": {
      await guard();
      const out = await withPage(async (c, t) => {
        const tree = await axTree(c, { options: true });
        const { nodes, entries } = tree;
        rememberRefs(entries);
        const re = o.pos[0] ? regex(o.pos[0]) : undefined;
        const lines = entries.map((e) => cdp.entryLine(e)).filter((l) => !re || re.test(l));
        if (re) {
          // Text that takes clicks but is no element's name (role-less options): only when asked for by a regex.
          const named = new Set(entries.map((e) => e.name));
          const extra = textEntries(tree, re).filter((e) => !named.has(e.name));
          rememberRefs(extra, { merge: true });
          lines.push(...extra.map((e) => cdp.entryLine(e)));
        }
        const limit = o.limit ?? 40;
        const shown = lines.slice(0, limit);
        if (lines.length > limit) shown.push(`${lines.length - limit} more: narrow the regex`);
        if (lines.length === 0) shown.push(`no element matches among ${entries.length}`);
        const sel = entries.find((e) => e.select && !e.select.multiple && e.select.size <= 1 && lines.includes(cdp.entryLine(e)));
        const alt = sel?.options.find((x) => !x.selected && !x.disabled);
        if (sel && alt) shown.push(`(pick an option: desktop-web select ${sel.ref} "${alt.text}")`);
        return [...header(t), ...cdp.dialogLines(cdp.dialogs(nodes)), ...shown];
      });
      console.log(budget(out, "narrow the regex").join("\n"));
      return;
    }
    case "click":
    case "type": {
      const spec = o.pos[0];
      if (!spec || (cmd === "type" && o.pos[1] === undefined))
        fail(`usage: desktop-web ${cmd} <ref|"regex">${cmd === "type" ? ' "text"' : ""}`, 64);
      await guard();
      const before = await target();
      if (!before) fail("Chrome is not running: start with desktop-web open <url>");
      const { entry, note, pre } = await withPage(async (c) => {
        const tree = await axTree(c);
        const { entry, nodes, note } = await resolveTarget(c, spec, o, { fieldsOnly: cmd === "type" && !isRef(spec), text: cmd === "click", tree });
        if (entry.disabled) fail(`${cdp.entryLine(entry)}: it is disabled, the page does not take it yet (something it needs is missing); nothing clicked`);
        await clickNode(c, nodes, entry);
        return { entry, note, pre: stateOf(tree) };
      });
      const head = note ? [note] : [];
      const { backendNodeId } = entry;
      const frameTag = entry.frameTag ?? "";
      if (cmd === "type") {
        lib.pause(150);
        if (!o.append) lib.key("ctrl+a");
        if (lib.typable(o.pos[1])) lib.humanType(o.pos[1]);
        else lib.pasteText(o.pos[1]);
        // Read the field back: what the page holds is the result, not what was sent.
        // The accessibility tree catches up with the field a moment after the last key.
        let now;
        for (let i = 0; i < 4 && !now; i++) {
          lib.pause(250);
          now = await withPage(async (c) => {
            const nodes = await axNodes(c);
            // The field that has focus: pages often swap the clicked input for another element as it gains focus.
            const has = (m, name) => (m.properties ?? []).some((p) => p.name === name && p.value?.value === true);
            const field = nodes.find((m) => !m.ignored && has(m, "focused") && has(m, "editable"));
            return (field ?? nodes.find((m) => m.backendDOMNodeId === backendNodeId && (m.frameTag ?? "") === frameTag))?.value?.value;
          });
        }
        const value = squash(now);
        const lines = [...head, `typed into ${cdp.entryLine(entry)}`, `value now: ${JSON.stringify(now ?? "")}`];
        const meant = squash(o.append ? `${entry.value}${o.pos[1]}` : o.pos[1]);
        if (value === entry.value && meant !== entry.value && !entry.secret) {
          console.log(
            [...lines, `the field kept its value: it ${entry.readonly ? "is read-only" : "did not take the typed text"}; set it with the control that drives it`].join("\n"),
          );
          process.exit(1);
        }
        if (!o.enter) {
          const after = await settle(before, { quietMs: 700, capMs: 6000 });
          console.log([...lines, ...(after.blocked ? blockedLines() : await afterTyping(pre, after, o.pos[1], o))].join("\n"));
          return;
        }
        lib.key("Return");
        const after = await settle(before, { want: o.show ? regex(o.show) : undefined });
        console.log([...lines, ...(after.blocked ? blockedLines() : await changes(pre, before, after, o, { self: entry }))].join("\n"));
        return;
      }
      const after = await settle(before, { want: o.show ? regex(o.show) : undefined });
      if (after.blocked) {
        console.log([...head, `clicked ${cdp.entryLine(entry)}`, ...blockedLines()].join("\n"));
        return;
      }
      // Read the element again: its state after the click (checked, expanded, value) is the answer, not the one before.
      const now = await withPage((c) => axTree(c)).catch(() => undefined);
      const self = now?.entries.find((e) => e.ref === entry.ref);
      const diff = cdp.stateDiff(entry, self);
      const first = diff.length > 0 ? `clicked [${entry.ref}] ${entry.role} ${cdp.shortName(entry, 80)}: ${diff.join(", ")}` : `clicked ${cdp.entryLine(self ?? entry)}`;
      console.log([...head, first, ...(await changes(pre, before, after, o, { now, self: entry, selfChanged: diff.length > 0 }))].join("\n"));
      return;
    }
    case "key": {
      if (o.pos.length === 0 && o.text === undefined) fail('usage: desktop-web key <keys...> [--text "answer"] [--show "regex"]', 64);
      const state = await probe();
      const win = chromeWindow();
      if (state.state === "none" || !win) fail("Chrome is not running: start with desktop-web open <url>");
      const before = state.target;
      const wasBlocked = state.state === "blocked";
      // A blocked page cannot be read, and the keys are what unblocks it: the text of the last read stands in as "before".
      let pre;
      if (wasBlocked) {
        let lines = [];
        try {
          lines = fs.readFileSync(pageFile(o), "utf8").replace(/\n$/, "").split("\n");
        } catch {
          lines = [];
        }
        pre = { lines, entries: [], nodes: [] };
      } else pre = stateOf(await withPage((c) => axTree(c)));
      activate(win);
      if (o.text !== undefined) {
        // A prompt's field may hold a default: replace it. (Not on a live page, where ctrl+a would select the page.)
        if (wasBlocked) lib.key("ctrl+a");
        if (lib.typable(o.text)) lib.humanType(o.text);
        else lib.pasteText(o.text);
      }
      if (o.pos.length > 0) lib.key(...o.pos);
      if (wasBlocked) lib.pause(500);
      const after = await settle(before, { quietMs: 800, capMs: 15000, want: o.show ? regex(o.show) : undefined });
      if (after.blocked) {
        console.log(blockedLines({ still: wasBlocked }).join("\n"));
        return;
      }
      console.log([...(wasBlocked ? ["dialog closed"] : []), ...(await changes(pre, before, after, o))].join("\n"));
      return;
    }
    case "select": {
      const [spec, want] = o.pos;
      if (!spec || want === undefined) fail('usage: desktop-web select <ref|"regex"> "option text"', 64);
      await guard();
      const before = await target();
      if (!before) fail("Chrome is not running: start with desktop-web open <url>");
      const { pre, entry, how, shown } = await withPage(async (c) => {
        const tree = await axTree(c, { options: true });
        const pre = stateOf(tree);
        const { entry, nodes } = await resolveTarget(c, spec, o, { selectsOnly: !isRef(spec), tree });
        if (entry.disabled) fail(`${cdp.entryLine(entry)}: it is disabled, the page does not take it yet; nothing selected`);
        const info = entry.select;
        // A dropdown's popup is its own window and takes the keyboard: one click opens it, arrows move over the enabled options
        // (a change fires only at Return), Return picks. Never arrows on a closed select: each step would fire a change.
        if (info && !info.multiple && info.size <= 1) {
          const m = cdp.matchOption(info.options.map((x) => x.text), want);
          if (m.several) fail(`${m.several.length} options match ${JSON.stringify(want)}: ${cdp.optionsText(m.several.map((i) => info.options[i]))}. Give the full text of one.`, 2);
          if (m.none) fail(`no option matches ${JSON.stringify(want)}. Options: ${cdp.optionsText(info.options)}`, 2);
          const opt = info.options[m.index];
          if (opt.disabled) fail(`option ${JSON.stringify(opt.text)} is disabled. Options: ${cdp.optionsText(info.options)}`, 2);
          const steps = cdp.arrowSteps(info.options, m.index);
          if (steps === 0) return { pre, entry, how: "already", shown: opt.text };
          await clickNode(c, nodes, entry);
          lib.pause(350);
          lib.key(...Array(Math.abs(steps)).fill(steps < 0 ? "Up" : "Down"));
          lib.pause(150);
          lib.key("Return");
          return { pre, entry, how: "native", shown: opt.text };
        }
        // A list that is already on the page (multiple, size above 1) or a combobox of in-page elements: open it if needed, then
        // click the option whose text matches.
        const known = new Set(tree.entries.filter((e) => OPTION_ROLES.has(e.role)).map((e) => e.ref));
        if (!info) await clickNode(c, nodes, entry);
        lib.pause(500);
        const now = await axTree(c);
        let options = now.entries.filter((e) => OPTION_ROLES.has(e.role));
        if (info) {
          // the options of this select: its accessibility subtree
          const own = new Set();
          const walk = (id) => {
            const n = now.nodes.find((x) => x.nodeId === id);
            if (!n || own.has(id)) return;
            own.add(id);
            for (const k of n.childIds ?? []) walk(k);
          };
          const sel = now.nodes.find((x) => x.backendDOMNodeId === entry.backendNodeId && (x.frameTag ?? "") === (entry.frameTag ?? ""));
          if (sel) walk(sel.nodeId);
          options = options.filter((e) => own.has(e.nodeId));
        } else if (options.some((e) => !known.has(e.ref))) options = options.filter((e) => !known.has(e.ref));
        if (options.length === 0) fail(`no options appeared after opening ${cdp.entryLine(entry)}: desktop-web snap`);
        const m = cdp.matchOption(options.map((e) => e.name), want);
        if (m.several) fail(`${m.several.length} options match ${JSON.stringify(want)}: ${m.several.map((i) => options[i].name).join(" | ")}. Give the full text of one.`, 2);
        if (m.none) {
          fail(`no option matches ${JSON.stringify(want)}. Options: ${options.map((e) => e.name).slice(0, 15).join(" | ")}`, 2);
        }
        await clickNode(c, now.nodes, options[m.index]);
        return { pre, entry, how: "click", shown: options[m.index].name };
      });
      if (how === "already") {
        console.log(`${JSON.stringify(shown)} is already selected in ${cdp.entryLine(entry, { nameMax: 60 })}`);
        return;
      }
      const after = await settle(before, { quietMs: 800 });
      if (after.blocked) {
        console.log(blockedLines().join("\n"));
        return;
      }
      // Read the select back: what the page holds is the result, not what was sent.
      const now = await withPage(async (c) => (await axTree(c, { options: true })).entries.find((e) => e.backendNodeId === entry.backendNodeId && (e.frameTag ?? "") === (entry.frameTag ?? "")));
      let state = "";
      if (now?.options) {
        const picked = now.options.filter((x) => x.selected).map((x) => x.text);
        state = `${now.select.multiple ? "selected now" : "value now"}: ${JSON.stringify(now.select.multiple ? picked.join(", ") : (picked[0] ?? ""))}`;
        if (how === "native" && picked[0] !== shown) {
          lib.key("Escape"); // a popup left open would take the next click
          console.log(`the select holds ${JSON.stringify(picked[0] ?? "")}, not ${JSON.stringify(shown)}; ${cdp.entryLine(now, { nameMax: 60 })}`);
          process.exit(1);
        }
      }
      console.log([`${how === "native" ? "selected" : "clicked option"} ${JSON.stringify(shown)} in ${cdp.entryLine(now ?? entry, { nameMax: 60 })}`, state, ...(await changes(pre, before, after, o, { self: entry }))].filter(Boolean).join("\n"));
      return;
    }
    case "hover":
    case "shot": {
      const spec = o.pos[0];
      if (!spec) fail(`usage: desktop-web ${cmd} <ref|"regex">`, 64);
      await guard();
      const before = await target();
      if (!before) fail("Chrome is not running: start with desktop-web open <url>");
      const r = await withPage(async (c) => {
        const tree = await axTree(c, { showable: true });
        const { entry, nodes, note } = await resolveTarget(c, spec, o, { showable: true, tree });
        if (cmd === "hover") {
          await hoverNode(c, nodes, entry);
          return { pre: stateOf(tree), entry, note };
        }
        const { box } = await placeNode(c, nodes, entry, { cover: false });
        return { entry, box, note };
      });
      if (cmd === "hover") {
        const after = await settle(before, { quietMs: 700 });
        console.log([...(r.note ? [r.note] : []), `hovered ${cdp.entryLine(r.entry)}`, ...(after.blocked ? blockedLines() : await changes(r.pre, before, after, { ...o, noHint: true }, { self: r.entry }))].join("\n"));
        return;
      }
      // A little room around the element, and never a sliver: small icons are easier to read with their surroundings.
      const pad = o.pad ?? 14;
      // A wide block (a heading that spans the page) is cut to a readable width, kept at its left edge.
      const w = Math.min(Math.max(r.box.w + 2 * pad, 160), 640 + 2 * pad);
      const h = Math.max(r.box.h + 2 * pad, 90);
      const x = Math.max(Math.round(r.box.w + 2 * pad > w ? r.box.x - pad : r.box.x + r.box.w / 2 - w / 2), 0);
      const y = Math.max(Math.round(r.box.y + r.box.h / 2 - h / 2), 0);
      let shot;
      try {
        shot = execFileSync("desktop-shot", ["--region", `${x},${y},${Math.round(w)},${Math.round(h)}`, "--width", "900"], { encoding: "utf8" }).trim();
      } catch (e) {
        fail(`screenshot failed: ${String(e.stderr || e.message).trim().split("\n")[0]}`);
      }
      console.log([...(r.note ? [r.note] : []), `shot of ${cdp.entryLine(r.entry)}`, `${shot} (read this image with the read tool)`].join("\n"));
      return;
    }
    case "wait": {
      const pattern = o.pos[0];
      if (!pattern) fail('usage: desktop-web wait "regex" [--gone] [--timeout N]', 64);
      const re = regex(pattern);
      const secs = Math.min(Math.max(Number.isFinite(o.timeout) ? o.timeout : 20, 1), 60);
      await guard();
      const start = Date.now();
      let lines = [];
      for (;;) {
        try {
          lines = await withPage((c) => pageLines(c), { timeoutMs: 8000 });
        } catch {
          if ((await probe()).state === "blocked") {
            console.log(blockedLines().join("\n"));
            process.exit(3);
          }
        }
        const hits = lines.filter((l) => re.test(l));
        const done = o.gone ? hits.length === 0 : hits.length > 0;
        const took = ((Date.now() - start) / 1000).toFixed(1);
        if (done || Date.now() - start >= secs * 1000) {
          lib.savePage(lines, pageFile(o));
          const shownHits = lib.grepLines(lines, re, { limit: o.limit ?? 8, context: 0, width: WIDTH });
          if (done) {
            console.log([o.gone ? `gone after ${took} s: no line matches ${JSON.stringify(pattern)}` : `seen after ${took} s:`, ...(o.gone ? [] : shownHits)].join("\n"));
            return;
          }
          console.log([`${o.gone ? "still there" : "not seen"} after ${secs} s: ${JSON.stringify(pattern)}`, ...(o.gone ? shownHits : []), "the page may need another action, or a longer --timeout (at most 60)"].join("\n"));
          process.exit(3);
        }
        lib.pause(600);
      }
    }
    case "url": {
      const t = await target();
      if (!t) fail("Chrome is not running");
      console.log(header(t).join("\n"));
      return;
    }
    default:
      fail("usage: desktop-web open|text|snap|click|type|key|select|hover|shot|wait|url (see the header of this file)", 64);
  }
}

main().catch((e) => fail(e.message));
