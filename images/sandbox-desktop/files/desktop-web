      for (;;) {
        try {
          lines = await withPage((c) => pageLines(c), { timeoutMs: 8000 });
        } catch {
          const why = await blockedNow();
          if (why) {
            console.log(blockedLines({ why }).join("\n"));
            process.exit(3);
          }
        }
        const hits = lines.filter((l) => re.test(l));
        const done = o.gone ? hits.length === 0 : hits.length > 0;
        const took = ((Date.now() - start) / 1000).toFixed(1);
        if (done || Date.now() - start >= secs * 1000) {
          lib.savePage(lines, pageFile(o));
          const shownHits = lib.grepLines(lines, re, { limit: o.limit ?? 8, context: 0, width: WIDTH });
          if (done) {
            console.log([o.gone ? `gone after ${took} s: no line matches ${JSON.stringify(pattern)}` : `seen after ${took} s:`, ...(o.gone ? [] : shownHits)].join("\n"));
            return;
          }
          console.log([`${o.gone ? "still there" : "not seen"} after ${secs} s: ${JSON.stringify(pattern)}`, ...(o.gone ? shownHits : []), "the page may need another action, or a longer --timeout (at most 60)"].join("\n"));
          process.exit(3);
        }
        lib.pause(600);
      }
    }
    case "upload": {
      const [spec, file] = o.pos;
      if (!spec || !file) fail('usage: desktop-web upload <ref|"regex"> /workspace/file', 64);
      if (!path.isAbsolute(file)) fail(`give the file's full path, e.g. /workspace/${path.basename(file)}`, 64);
      let st;
      try {
        st = fs.statSync(file);
      } catch {
        fail(`no file ${file}`, 64);
      }
      if (!st.isFile()) fail(`${file} is not a file`, 64);
      await guard();
      const before = await target();
      if (!before) fail("Chrome is not running: start with desktop-web open <url>");
      const { entry, note, pre, inputs } = await withPage(async (c) => {
        const tree = await axTree(c);
        const { entry, nodes, note } = await resolveTarget(c, spec, o, { text: true, tree });
        if (entry.disabled) fail(`${cdp.entryLine(entry)}: it is disabled; nothing clicked`);
        await clickNode(c, nodes, entry);
        return { entry, note, pre: stateOf(tree), inputs: cdp.fileInputs(tree.read.flatMap((r) => [r.snap])) };
      });
      // The click opens the browser's file chooser (a GTK dialog window); its location field (ctrl+l) takes a typed path.
      let chooser;
      for (let i = 0; i < 24 && !chooser; i++) {
        lib.pause(250);
        chooser = chooserWindow();
      }
      if (!chooser)
        fail(`clicked ${cdp.entryLine(entry)} but no file chooser opened: click the file input itself or the button that opens it (desktop-web snap "upload|file|browse|choose")`);
      try {
        activate(chooser);
        lib.pause(rand(300, 500));
        lib.key("ctrl+l");
        lib.pause(rand(200, 350));
        if (lib.typable(file)) lib.humanType(file);
        else lib.pasteText(file);
        lib.pause(rand(200, 350));
        lib.key("Return");
      } catch (e) {
        cancelChooser(); // never left open half-filled: it would take every later click and key
        throw e;
      }
      let open = true;
      for (let i = 0; i < 16 && open; i++) {
        lib.pause(250);
        open = chooserWindow() !== undefined;
      }
      if (open) {
        cancelChooser();
        fail(`the file chooser did not take ${file} (its type may not be accepted): cancelled it; nothing uploaded`);
      }
      const after = await settle(before, { quietMs: 900, capMs: 8000 });
      const now = await withPage((c) => axTree(c)).catch(() => undefined);
      const held = now ? cdp.fileInputs(now.read.map((r) => r.snap)).filter((f) => f.value && !inputs.some((x) => x.backendNodeId === f.backendNodeId && x.value === f.value)) : [];
      const out = [...(note ? [note] : []), `picked ${file} in the file chooser of ${cdp.entryLine(entry, { nameMax: 60 })}`];
      if (held.length > 0) out.push(`file input now holds: ${held.map((f) => JSON.stringify(path.basename(f.value.replace(/\\/g, "/")))).join(", ")}`);
      console.log([...out, ...(after.blocked ? blockedLines({ why: after.blocked }) : await changes(pre, before, after, { ...o, noHint: held.length > 0 }, { now, self: entry, selfChanged: held.length > 0 }))].join("\n"));
      return;
    }
    case "drag": {
      const [spec, to] = o.pos;
      if (!spec || (to === undefined) === (o.by === undefined)) fail('usage: desktop-web drag <ref|"regex"> <ref|"regex">, or drag <ref|"regex"> --by dx,dy', 64);
      await guard();
      const before = await target();
      if (!before) fail("Chrome is not running: start with desktop-web open <url>");
      const r = await withPage(async (c) => {
        const tree = await axTree(c, { showable: true });
        const src = await resolveTarget(c, spec, o, { showable: true, text: true, anyText: true, tree });
        if (src.entry.disabled) fail(`${cdp.entryLine(src.entry)}: it is disabled; nothing dragged`);
        const dst = to === undefined ? undefined : await resolveTarget(c, to, {}, { showable: true, text: true, anyText: true, tree });
        for (const x of [src, dst]) if (x) await refuseChallenge(tree.read, x.entry, "dragged");
        const from = await placeNode(c, tree.nodes, src.entry);
        let point;
        if (dst) {
          const d = await placeNode(c, tree.nodes, dst.entry, { cover: false, scroll: false });
          point = { x: Math.round(d.box.x + d.box.w / 2), y: Math.round(d.box.y + d.box.h / 2) };
        }
        const w = from.win;
        const end = point ?? { x: from.box.x + from.box.w / 2 + o.by.dx, y: from.box.y + from.box.h / 2 + o.by.dy };
        if (end.x < w.x || end.y < w.y || end.x > w.x + w.width || end.y > w.y + w.height) fail("that would release outside the browser window: a smaller --by");
        activate(w);
        lib.humanDrag(from.box, point ?? { by: o.by });
        return { src, dst, pre: stateOf(tree) };
      });
      const after = await settle(before, { quietMs: 900 });
      const notes = [r.src.note, r.dst?.note].filter(Boolean).map((n) => n.replace("used the text", "used the text it shows"));
      const what = r.dst ? `to ${cdp.entryLine(r.dst.entry, { nameMax: 60 })}` : `by ${o.by.dx},${o.by.dy} px`;
      console.log([...new Set(notes), `dragged ${cdp.entryLine(r.src.entry, { nameMax: 60 })} ${what}`, ...(after.blocked ? blockedLines({ why: after.blocked }) : await changes(r.pre, before, after, o, { self: r.src.entry }))].join("\n"));
      return;
    }
    case "url": {
      const t = await target();
      if (!t) fail("Chrome is not running");
      const d = chooserWindow();
      console.log([...header(t, [], { full: true }), ...(d ? chooserLines(d) : [])].join("\n"));
      return;
    }
    default:
      fail("usage: desktop-web open|text|snap|click|type|upload|drag|key|select|hover|shot|wait|url (see the header of this file)", 64);
  }
}

main().catch((e) => fail(e.message));
