#!/usr/bin/env -S node --no-warnings
// Web pages in the desktop's Chrome: reads them over a passive CDP connection (cdp-lib.cjs: accessibility tree, layout
// snapshot, element boxes; never Runtime.enable or script in the page) and acts with real X input through xdotool, so a
// page sees a person's browser (docs/decisions/0065-desktop-sandbox.md, "Chromium and desktop-web").
//
//   desktop-web open <url> ["regex"]          type the URL into the address bar, wait, print url, title, matching text lines
//   desktop-web text ["regex"]                the page's text lines matching the regex (full text saved to a file)
//   desktop-web snap ["regex"]                clickable elements and headings with refs: [e123] link "Name"
//   desktop-web click <ref|"regex">           click it with the mouse; --near "row text", --nth N, --role R, --show "regex"
//   desktop-web type <ref|"regex"> "text"     click a field, replace its text; --enter presses Return, --append keeps text
//   desktop-web key <keys...>                 xdotool keys in the browser window (End, Page_Down, alt+Left, Escape)
//   desktop-web url                           url and title
//
// Flags: --limit N (matches shown, default 25 for text, 40 for snap), --context N (text, default 1), --from FILE (text:
// filter a saved page again), --out FILE. Environment: PI_DESKTOP_CDP_PORT (9222), PI_DESKTOP_FRAME (4, window frame px).
"use strict";
const fs = process.getBuiltinModule("node:fs");
const path = process.getBuiltinModule("node:path");
const { execFileSync } = process.getBuiltinModule("node:child_process");
const req = process.getBuiltinModule("node:module").createRequire(fs.realpathSync(process.argv[1]));
const lib = req("./desktop-lib.cjs");
const cdp = req("./cdp-lib.cjs");

const fail = lib.failer("desktop-web");
const PORT = process.env.PI_DESKTOP_CDP_PORT ?? "9222";
const FRAME = Number(process.env.PI_DESKTOP_FRAME ?? 4);
const HEAD_LINES = 15;

function parseArgs(argv) {
  const o = { pos: [], limit: undefined, context: 1, enter: false, append: false };
  const val = (i, f) => {
    if (i + 1 >= argv.length) fail(`${f} needs a value`, 64);
    return argv[i + 1];
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--limit") (o.limit = Number(val(i, a))), i++;
    else if (a === "--context") (o.context = Number(val(i, a))), i++;
    else if (a === "--near") (o.near = val(i, a)), i++;
    else if (a === "--nth") (o.nth = Number(val(i, a))), i++;
    else if (a === "--show") (o.show = val(i, a)), i++;
    else if (a === "--role") (o.role = val(i, a)), i++;
    else if (a === "--from") (o.from = val(i, a)), i++;
    else if (a === "--out") (o.out = val(i, a)), i++;
    else if (a === "--enter") o.enter = true;
    else if (a === "--append") o.append = true;
    else o.pos.push(a);
  }
  return o;
}

const regex = (s) => {
  try {
    return new RegExp(s, "i");
  } catch (e) {
    fail(`bad regex ${JSON.stringify(s)}: ${e.message}`, 64);
  }
};

// The browser window: the last visible Chrome top-level window.
function chromeWindow() {
  let ids;
  try {
    ids = lib.exec("xdotool", "search", "--onlyvisible", "--class", "[Gg]oogle-chrome").trim().split("\n").filter(Boolean);
  } catch {
    ids = [];
  }
  if (ids.length === 0) return undefined;
  const id = ids[ids.length - 1];
  const g = Object.fromEntries(
    lib
      .exec("xdotool", "getwindowgeometry", "--shell", id)
      .trim()
      .split("\n")
      .map((l) => l.split("=")),
  );
  return { id, x: Number(g.X), y: Number(g.Y), width: Number(g.WIDTH), height: Number(g.HEIGHT) };
}

function activate(win) {
  try {
    lib.exec("xdotool", "windowactivate", "--sync", win.id);
  } catch {
    // openbox may refuse a window that is already active; input still goes to it
  }
}

async function ensureBrowser() {
  if (await cdp.pageTarget(PORT)) return;
  try {
    execFileSync("desktop-launch", ["chrome"], { stdio: ["ignore", "ignore", "pipe"] });
  } catch (e) {
    fail(`Chrome did not start: ${String(e.stderr || e.message).trim().split("\n")[0]}`);
  }
  for (let i = 0; i < 60; i++) {
    if (await cdp.pageTarget(PORT)) return;
    lib.pause(500);
  }
  fail("Chrome did not answer on its debugging port");
}

async function withPage(fn) {
  const target = await cdp.pageTarget(PORT);
  if (!target) fail("Chrome is not running: start with desktop-web open <url>");
  const c = await cdp.connect(target.webSocketDebuggerUrl);
  try {
    return await fn(c, target);
  } finally {
    c.close();
  }
}

// Waits for the page to answer an action: the URL or title changes, or nothing changes within quietMs (an in-page
// update); then the page height must hold still for ~1 s (content still loading), all within capMs.
async function settle(before, { quietMs = 1500, capMs = 20000 } = {}) {
  const start = Date.now();
  let changed = false;
  let t = before;
  while (Date.now() - start < capMs) {
    t = (await cdp.pageTarget(PORT)) ?? t;
    if (t.url !== before.url || t.title !== before.title) changed = true;
    if (changed || Date.now() - start >= quietMs) break;
    lib.pause(250);
  }
  let last = -1;
  let same = 0;
  while (Date.now() - start < capMs && same < 3) {
    lib.pause(350);
    try {
      const h = await withPage(async (c) => (await c.send("Page.getLayoutMetrics")).cssContentSize.height);
      // An empty document between pages holds still at a small height: only a laid-out page counts.
      same = h === last && h > 200 ? same + 1 : 0;
      last = h;
    } catch {
      same = 0; // between documents
    }
  }
  return (await cdp.pageTarget(PORT)) ?? t;
}

const header = (t) => [`url: ${t.url}`, `title: ${t.title}`];

async function pageLines(c) {
  let lines = [];
  // A page that has just committed can still be empty: give it a few seconds to put text on screen.
  for (let i = 0; i < 6; i++) {
    const snap = await c.send("DOMSnapshot.captureSnapshot", { computedStyles: ["display", "visibility"] });
    lines = cdp.snapshotLines(snap);
    if (lines.length >= 3) break;
    lib.pause(800);
  }
  return lines;
}

function showText(lines, pattern, o, target) {
  const file = lib.savePage(lines, o.out ?? path.join(lib.sessionDir(), "web-page.txt"));
  const out = target ? header(target) : [];
  if (pattern) out.push(...lib.grepLines(lines, regex(pattern), { limit: o.limit ?? 25, context: o.context }));
  else {
    out.push(...lines.slice(0, HEAD_LINES).map((l, i) => `${i + 1}: ${lib.clip(l, 200)}`));
    if (lines.length > HEAD_LINES) out.push(`... ${lines.length - HEAD_LINES} more lines: desktop-web text "regex"`);
  }
  out.push(`(${lines.length} lines in ${file})`);
  return out;
}

async function axTree(c) {
  const { nodes } = await c.send("Accessibility.getFullAXTree");
  return { nodes, entries: cdp.axEntries(nodes) };
}

// Resolves a ref (e123) or a name regex to one element; lists the candidates and exits 2 when the name is ambiguous.
async function resolveTarget(c, spec, o, { fieldsOnly = false } = {}) {
  if (/^e\d+$/.test(spec)) return { backendNodeId: Number(spec.slice(1)), label: spec };
  const { nodes, entries } = await axTree(c);
  const pool = fieldsOnly ? entries.filter((e) => ["textbox", "searchbox", "combobox", "spinbutton"].includes(e.role)) : entries;
  const r = cdp.chooseTarget(nodes, pool, regex(spec), { near: o.near ? regex(o.near) : undefined, nth: o.nth, role: o.role });
  if (r.pick) return { backendNodeId: r.pick.backendNodeId, label: cdp.entryLine(r.pick) };
  if (r.none) fail(r.near ? `nothing matching ${JSON.stringify(spec)} near ${JSON.stringify(o.near)}` : `nothing clickable matches ${JSON.stringify(spec)}: try desktop-web snap "word"`);
  const rows = cdp.rowTexts(nodes, r.several);
  const lines = r.several
    .slice(0, 15)
    .map((e, i) => {
      // The row text starts with the element's own name more often than not: show only what tells the rows apart.
      const row = rows[i].startsWith(e.name) ? rows[i].slice(e.name.length).trim() : rows[i];
      return `${cdp.entryLine(e, { nameMax: 70 })}  | ${lib.clip(row, 120)}${e.url ? ` -> ${lib.clip(e.url, 90)}` : ""}`;
    });
  process.stdout.write(
    `${r.several.length} elements match ${JSON.stringify(spec)}; nothing clicked. Click one by ref (desktop-web click e123), or add --near "text from its row":\n${lines.join("\n")}\n`,
  );
  process.exit(2);
}

// Scrolls the element into view, checks nothing covers its centre, and clicks there with the X mouse.
async function clickNode(c, target, backendNodeId) {
  try {
    await c.send("DOM.scrollIntoViewIfNeeded", { backendNodeId });
  } catch {
    // not scrollable (fixed position); the box check below still applies
  }
  let quad;
  try {
    quad = (await c.send("DOM.getBoxModel", { backendNodeId })).model.border;
  } catch {
    const q = await c.send("DOM.getContentQuads", { backendNodeId }).catch(() => ({ quads: [] }));
    quad = q.quads[0];
  }
  if (!quad) fail("the element has no box on the page (hidden or removed): run desktop-web snap again");
  const center = cdp.quadCenter(quad);
  const lm = await c.send("Page.getLayoutMetrics");
  const vp = lm.cssLayoutViewport;
  const zoom = lm.cssVisualViewport.zoom ?? 1;
  if (center.x < 0 || center.y < 0 || center.x > vp.clientWidth || center.y > vp.clientHeight)
    fail("the element is outside the visible page and could not be scrolled into view");
  // Something in front (a cookie dialog, an overlay) gets the click instead: say so rather than click it.
  // getNodeForLocation takes document coordinates: the viewport point plus the scroll offset.
  const hit = await c
    .send("DOM.getNodeForLocation", {
      x: Math.round(center.x + vp.pageX),
      y: Math.round(center.y + vp.pageY),
      includeUserAgentShadowDOM: true,
    })
    .catch(() => undefined);
  if (hit && hit.backendNodeId !== backendNodeId) {
    const inside = cdp.subtreeIds((await c.send("DOM.describeNode", { backendNodeId, depth: -1, pierce: true })).node);
    if (!inside.has(hit.backendNodeId)) {
      const hb = await c.send("DOM.getBoxModel", { backendNodeId: hit.backendNodeId }).catch(() => undefined);
      // A wrapper around the element and only a little larger (a link around a span) takes the same click; anything else
      // under the point (a dialog's text, a big layer) means the element is covered.
      if (!hb || !cdp.wraps(hb.model.border, quad)) {
        const d = (await c.send("DOM.describeNode", { backendNodeId: hit.backendNodeId })).node;
        const cls = (d.attributes ?? []).reduce((s, v, i, a) => (a[i - 1] === "class" ? v : s), "");
        fail(`another element covers it (${d.nodeName.toLowerCase()}${cls ? `.${lib.clip(cls, 40)}` : ""}): a dialog or banner is in front. Read it with desktop-web snap and close or accept it first`);
      }
    }
  }
  const win = chromeWindow();
  if (!win) fail("no Chrome window on the screen");
  const p = cdp.screenPoint({ win, viewport: { height: vp.clientHeight }, zoom, frame: FRAME }, center);
  activate(win);
  lib.exec("xdotool", "mousemove", String(p.x), String(p.y), "click", "1");
  return p;
}

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  const o = parseArgs(rest);
  switch (cmd) {
    case "open": {
      const url = o.pos[0];
      if (!url) fail("usage: desktop-web open <url> [\"regex\"]", 64);
      if (!/^https?:\/\//.test(url) && !url.startsWith("file:///workspace/")) fail("give a full https:// URL", 64);
      await ensureBrowser();
      const before = await cdp.pageTarget(PORT);
      const win = chromeWindow();
      if (!win) fail("no Chrome window on the screen");
      activate(win);
      lib.key("ctrl+l");
      lib.pause(150);
      lib.type(url);
      lib.key("Delete"); // drops an inline completion the address bar may have added
      lib.key("Return");
      const after = await settle(before, { quietMs: 8000, capMs: 25000 });
      const lines = await withPage((c) => pageLines(c));
      console.log(showText(lines, o.pos[1], o, after).join("\n"));
      if (after.url === before.url && before.url !== "about:blank") console.log("note: the address did not change");
      return;
    }
    case "text": {
      if (o.from) {
        const lines = fs.readFileSync(o.from, "utf8").split("\n");
        console.log(lib.grepLines(lines, regex(o.pos[0] ?? "."), { limit: o.limit ?? 25, context: o.context }).join("\n"));
        return;
      }
      const out = await withPage(async (c, t) => showText(await pageLines(c), o.pos[0], o, t));
      console.log(out.join("\n"));
      return;
    }
    case "snap": {
      const out = await withPage(async (c, t) => {
        const { entries } = await axTree(c);
        const re = o.pos[0] ? regex(o.pos[0]) : undefined;
        const lines = entries.map((e) => cdp.entryLine(e)).filter((l) => !re || re.test(l));
        const limit = o.limit ?? 40;
        const shown = lines.slice(0, limit);
        if (lines.length > limit) shown.push(`${lines.length - limit} more: narrow the regex or raise --limit`);
        if (lines.length === 0) shown.push(`no element matches among ${entries.length}`);
        return [...header(t), ...shown];
      });
      console.log(out.join("\n"));
      return;
    }
    case "click":
    case "type": {
      const spec = o.pos[0];
      if (!spec || (cmd === "type" && o.pos[1] === undefined)) fail(`usage: desktop-web ${cmd} <ref|"regex">${cmd === "type" ? ' "text"' : ""}`, 64);
      const before = await cdp.pageTarget(PORT);
      if (!before) fail("Chrome is not running: start with desktop-web open <url>");
      const label = await withPage(async (c, t) => {
        const tg = await resolveTarget(c, spec, o, { fieldsOnly: cmd === "type" && !/^e\d+$/.test(spec) });
        await clickNode(c, t, tg.backendNodeId);
        return tg.label;
      });
      if (cmd === "type") {
        lib.pause(150);
        if (!o.append) lib.key("ctrl+a");
        lib.type(o.pos[1]);
        if (o.enter) lib.key("Return");
      }
      const after = cmd === "click" || o.enter ? await settle(before) : before;
      const out = [`${cmd === "click" ? "clicked" : "typed into"} ${label}`, ...header(after)];
      if (o.show) out.push(...(await withPage(async (c) => showText(await pageLines(c), o.show, o))));
      console.log(out.join("\n"));
      return;
    }
    case "key": {
      if (o.pos.length === 0) fail("usage: desktop-web key <keys...>", 64);
      const before = await cdp.pageTarget(PORT);
      const win = chromeWindow();
      if (!before || !win) fail("Chrome is not running: start with desktop-web open <url>");
      activate(win);
      lib.key(...o.pos);
      const after = await settle(before, { quietMs: 800, capMs: 15000 });
      console.log(header(after).join("\n"));
      return;
    }
    case "url": {
      const t = await cdp.pageTarget(PORT);
      if (!t) fail("Chrome is not running");
      console.log(header(t).join("\n"));
      return;
    }
    default:
      fail("usage: desktop-web open|text|snap|click|type|key|url (see the header of this file)", 64);
  }
}

main().catch((e) => fail(e.message));
