#!/usr/bin/env -S node --no-warnings
// Web pages in the desktop's Chrome: reads them over a passive CDP connection (cdp-lib.cjs: accessibility tree, layout
// snapshot, element boxes; never Runtime.enable or script in the page) and acts with real X input through xdotool at a
// person's pace, so a page sees a person's browser (docs/decisions/0065-desktop-sandbox.md, "Chromium and desktop-web").
// Nothing here knows any site or language.
//
//   desktop-web open <url> ["regex"]          type the URL, wait, print url, title, open dialogs, matching lines or an outline
//   desktop-web text ["regex"]                the page's text lines matching the regex (full text saved to a file)
//   desktop-web text --lines 120-170          a range of lines of the page (or of --from FILE)
//   desktop-web snap ["regex"]                open dialogs, then clickable elements and headings with refs: [e123] link "Name";
//                                             with a regex also text that takes clicks: [e124] clickable "4K"
//   desktop-web click <ref|"regex">           click it with the mouse and print its new state and what changed; --near "row
//                                             text", --nth N, --role R, --show "regex". No element by that name: a line of
//                                             clickable text, else the one line of any visible text (said so). --double:
//                                             two presses (edit a label), any visible text. Exit 1 when refused (disabled,
//                                             covered), 2 when ambiguous.
//   desktop-web type <ref|"regex"> "text"     click a field, replace its text, print its value and what appeared; --enter,
//                                             --append, --near "row text"; "" clears it. Of several matching fields the one
//                                             outside the header and navigation. Exit 1 when the field kept its value
//   desktop-web key <keys...>                 keys in the browser window (End, Page_Down, alt+Left, Escape); prints changes,
//                                             the element that took the focus and how far the page scrolled; --text "answer"
//                                             types text first (a prompt dialog), --show "regex"
//   desktop-web select <ref|"regex"> "option" pick an option of a dropdown (native or in-page: the options it owns, else
//                                             those that appear as it opens) and print what it holds
//   desktop-web type <slider> 75              set a slider: a press at its proportional point, then arrow keys to the value;
//                                             prints value 25 -> 75. Exit 1 when it did not move or ended elsewhere
//   desktop-web upload <ref|"regex"> /workspace/file
//                                             click a file input (or the button that opens one), pick the file in the
//                                             browser's file chooser (its location field), print what the page shows
//   desktop-web drag <src> <dst>              press on src, move there at a person's pace, release over dst; --by dx,dy (px)
//                                             instead of dst. src and dst: refs, element names or any visible text
//   desktop-web hover <ref|"regex">           move the pointer over it (menus, captions) and print what appeared; any
//                                             visible text is a target too
//   desktop-web shot <ref|"regex">            screenshot of that element's or text's area (icons, colours, images): prints the file;
//                                             --pad N takes N more px around it
//   desktop-web wait "regex" [--gone]         wait until the text appears (or disappears); --timeout N seconds (at most 60)
//   desktop-web url                           url and title
//   desktop-web text "regex" --marks          also marks nameless pictures (icons, ratings) inline as ‹class words›
//   desktop-web text "regex" --indent         prefixes each line with > per level it is indented (replies in a thread)
//   desktop-web text "regex" --table          a table row as its cells joined by " | " (empty cells kept), with the table's
//                                             header rows above the matches as "cols: ..."
//
// What an action changed counts lines that kept their text but moved (a sort, a drag swap: "order changed (lines A-B)"),
// a control's selected, pressed and sort state, the clicked control drawn again by the page, and controls that appeared
// ("appeared: [e5] button "Remove Red"", at most 5, a count only above 8). An element a person reaches with Tab but that has
// no control role (a slider's handle drawn as a span) is listed as `focusable ‹class words› near "row"`: click it, then keys.
//
// Answers start with the page's url (only when it changed since the last answer, cut to 120 characters) and title, then
// notices: redirected from the typed URL, Chrome's error page, a likely error page, a page of a few short lines and no
// field (an error or block page that names no status), a bot check (the first sight on a host
// allows one ordinary revisit, the second says stop), a frame still loading (once per page). Struck-through text reads
// ~637 zł~. A `text` regex that matches nothing says how many matches a collapsed (overflow-cut) section holds and which
// control opens it, never their text. click, type and drag refuse a bot check's own widget.
//
// When the page does not answer (a JS alert, confirm, prompt or leave-page dialog blocks it) every command says so, shows
// the dialog's message and buttons and how to answer it with desktop-web key. A file chooser window open over the browser
// is reported the same way: reads go on, actions are refused until it is cancelled (desktop-web key Escape).
//
// Every answer stays within a budget (BUDGET_LINES lines, BUDGET_CHARS characters): a longer one is cut with a note on
// how to page on. Flags: --limit N (matches, at most 40), --context N (at most 3), --lines A-B, --from FILE, --out FILE.
// Environment: PI_DESKTOP_CDP_PORT (default: the port desktop-launch wrote), PI_DESKTOP_STATE (/tmp/pi-desktop),
// PI_DESKTOP_FRAME (4, window frame px).
"use strict";
const fs = process.getBuiltinModule("node:fs");
const path = process.getBuiltinModule("node:path");
const { execFileSync } = process.getBuiltinModule("node:child_process");
const req = process.getBuiltinModule("node:module").createRequire(fs.realpathSync(process.argv[1]));
const lib = req("./desktop-lib.cjs");
const cdp = req("./cdp-lib.cjs");

const fail = lib.failer("desktop-web");
const STATE = process.env.PI_DESKTOP_STATE ?? "/tmp/pi-desktop";
const FRAME = Number(process.env.PI_DESKTOP_FRAME ?? 4);
const BUDGET_LINES = 60;
const BUDGET_CHARS = 4000;
const PROBE_MS = 2500;
const SETTLE_BOX_MS = 1000;
const WIDTH = 200;
const REFS = () => path.join(lib.sessionDir(), "web-refs.json");
const LAST_URL = () => path.join(lib.sessionDir(), "web-url");

// desktop-launch starts Chrome on a random port and writes it to the state directory.
function port() {
  if (process.env.PI_DESKTOP_CDP_PORT) return process.env.PI_DESKTOP_CDP_PORT;
  try {
    return fs.readFileSync(path.join(STATE, "cdp-port"), "utf8").trim() || undefined;
  } catch {
    return undefined;
  }
}
const target = async () => {
  const p = port();
  return p ? cdp.pageTarget(p) : undefined;
};

function parseArgs(argv) {
  const o = { pos: [], context: 1, enter: false, append: false };
  const val = (i, f) => {
    if (i + 1 >= argv.length) fail(`${f} needs a value`, 64);
    return argv[i + 1];
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--limit") (o.limit = Math.min(Number(val(i, a)), 40)), i++;
    else if (a === "--context") (o.context = Math.min(Number(val(i, a)), 3)), i++;
    else if (a === "--near") (o.near = val(i, a)), i++;
    else if (a === "--nth") (o.nth = Number(val(i, a))), i++;
    else if (a === "--show") (o.show = val(i, a)), i++;
    else if (a === "--role") (o.role = val(i, a)), i++;
    else if (a === "--from") (o.from = val(i, a)), i++;
    else if (a === "--out") (o.out = val(i, a)), i++;
    else if (a === "--lines") (o.lines = val(i, a)), i++;
    else if (a === "--timeout") (o.timeout = Number(val(i, a))), i++;
    else if (a === "--text") (o.text = val(i, a)), i++;
    else if (a === "--by") {
      const m = /^(-?\d+),(-?\d+)$/.exec(val(i, a));
      if (!m) fail("--by takes dx,dy in px, e.g. --by 120,0", 64);
      o.by = { dx: Number(m[1]), dy: Number(m[2]) };
      i++;
    } else if (a === "--pad") (o.pad = Math.min(Math.max(Number(val(i, a)), 0), 300)), i++;
    else if (a === "--gone") o.gone = true;
    else if (a === "--marks") o.marks = true;
    else if (a === "--indent") o.indent = true;
    else if (a === "--table") o.table = true;
    else if (a === "--enter") o.enter = true;
    else if (a === "--append") o.append = true;
    else if (a === "--double") o.double = true;
    else o.pos.push(a);
  }
  return o;
}

const regex = (s) => {
  try {
    return new RegExp(s, "i");
  } catch (e) {
    fail(`bad regex ${JSON.stringify(s)}: ${e.message}`, 64);
  }
};

// Cuts an answer to the budget and says how to get the rest.
function budget(lines, hint) {
  const out = [];
  let chars = 0;
  for (const l of lines) {
    if (out.length >= BUDGET_LINES || chars + l.length > BUDGET_CHARS) {
      out.push(`[cut at ${out.length} lines: ${hint}]`);
      return out;
    }
    out.push(l);
    chars += l.length + 1;
  }
  return out;
}
const rand = (a, b) => a + Math.random() * (b - a);
const PAGE_HINT = 'narrow the regex, or read a range with desktop-web text --lines A-B';

// Chrome's visible top-level windows with what the window manager knows of them: whether one is transient for another and
// its type (a file chooser is a dialog window transient for the browser window).
function chromeWindows() {
  let ids;
  try {
    ids = lib.exec("xdotool", "search", "--onlyvisible", "--class", "[Gg]oogle-chrome").trim().split("\n").filter(Boolean);
  } catch {
    ids = [];
  }
  return ids.map((id) => {
    let p = "";
    try {
      p = lib.exec("xprop", "-id", id, "WM_TRANSIENT_FOR", "_NET_WM_WINDOW_TYPE", "WM_NAME");
    } catch {
      // gone since the search
    }
    return {
      id,
      transientFor: /WM_TRANSIENT_FOR\(WINDOW\): window id/.test(p),
      type: /_NET_WM_WINDOW_TYPE\(ATOM\) = (.*)/.exec(p)?.[1],
      name: /WM_NAME\([^)]*\) = "(.*)"/.exec(p)?.[1] ?? "",
    };
  });
}

// A dialog window of the browser (the file chooser, a save-as dialog), or undefined.
const chooserWindow = () => lib.dialogWindows(chromeWindows())[0];

// What an open file chooser means and how to get out of it, as blockedLines does for a JS dialog.
function chooserLines(d) {
  return [
    `A file chooser is open ("${lib.clip(d.name || "dialog", 60)}"): the browser takes no other input until it closes.`,
    "Cancel it: desktop-web key Escape. To give a file: cancel it, then desktop-web upload <ref> /workspace/file.",
  ];
}

// Escape until the chooser is gone: the first may only close its location field's completion popup. Never an Escape more,
// which would reach the page.
function cancelChooser() {
  for (let i = 0; i < 3; i++) {
    const d = chooserWindow();
    if (!d) return;
    activate(d);
    lib.key("Escape");
    lib.pause(300);
  }
}

// The browser window: the last visible Chrome top-level window that is not one of its dialogs.
function chromeWindow() {
  const wins = chromeWindows();
  const dialogs = new Set(lib.dialogWindows(wins).map((w) => w.id));
  const id = wins.filter((w) => !dialogs.has(w.id)).at(-1)?.id;
  if (id === undefined) return undefined;
  const g = Object.fromEntries(
    lib
      .exec("xdotool", "getwindowgeometry", "--shell", id)
      .trim()
      .split("\n")
      .map((l) => l.split("=")),
  );
  return { id, x: Number(g.X), y: Number(g.Y), width: Number(g.WIDTH), height: Number(g.HEIGHT) };
}

// Activating a window that already has focus is not needed, and it would close a dropdown's popup (a separate grab window).
function activate(win) {
  try {
    if (lib.exec("xdotool", "getactivewindow").trim() === win.id) return;
  } catch {
    // no active window: activate below
  }
  try {
    lib.exec("xdotool", "windowactivate", "--sync", win.id);
  } catch {
    // openbox may refuse a window that is already active; input still goes to it
  }
}

async function ensureBrowser() {
  if (await target()) return;
  try {
    execFileSync("desktop-launch", ["chrome"], { stdio: ["ignore", "ignore", "pipe"] });
  } catch (e) {
    fail(`Chrome did not start: ${String(e.stderr || e.message).trim().split("\n")[0]}`);
  }
  for (let i = 0; i < 60; i++) {
    if (await target()) return;
    lib.pause(500);
  }
  fail("Chrome did not answer on its debugging port");
}

async function withPage(fn, { timeoutMs } = {}) {
  const t = await target();
  if (!t) fail("Chrome is not running: start with desktop-web open <url>");
  const c = await cdp.connect(t.webSocketDebuggerUrl, { timeoutMs });
  c.target = t;
  c.extra = [];
  try {
    return await fn(c, t);
  } finally {
    for (const e of c.extra) e.close();
    c.close();
  }
}

// The page and the iframes that run in their own process (another site), each read through its own connection. A frame of
// the same process is part of its page: its documents come with the snapshot, its accessibility tree with its frame id.
// An iframe whose element a person cannot see (display:none, visibility:hidden, 0 px) is left out, like any other hidden element.
async function frameParts(c) {
  if (c.parts) return c.parts;
  c.parts = (async () => {
    const root = { tag: "", send: c.send, target: c.target.id };
    const parts = [root];
    for (const s of cdp.iframeTargets(await cdp.targetList(port()), c.target.id)) {
      try {
        const conn = await cdp.connect(s.webSocketDebuggerUrl);
        c.extra.push(conn);
        parts.push({ tag: s.tag, send: conn.send, target: s.id, url: s.url, parent: parts.find((p) => p.target === s.parentId) });
      } catch {
        // gone since the list was read
      }
    }
    for (const p of parts) {
      try {
        p.frameIds = cdp.childFrameIds((await p.send("Page.getFrameTree")).frameTree);
      } catch {
        p.frameIds = [];
      }
    }
    return parts;
  })();
  return c.parts;
}

// Where an out-of-process iframe's viewport sits in the page's: the top left of its iframe element's content box in the part
// that holds it, and so on up. (Boxes of a frame of the same process already come in the page's coordinates.)
async function partOrigin(part) {
  let o = { x: 0, y: 0 };
  for (let p = part; p.parent; p = p.parent) {
    const owner = await p.parent.send("DOM.getFrameOwner", { frameId: p.target });
    const box = await p.parent.send("DOM.getBoxModel", { backendNodeId: owner.backendNodeId });
    const q = cdp.quadOrigin(box.model.content);
    o = { x: o.x + q.x, y: o.y + q.y };
  }
  return o;
}

async function axOf(part) {
  const trees = [{ nodes: (await part.send("Accessibility.getFullAXTree")).nodes, prefix: "" }];
  for (const [k, frameId] of part.frameIds.entries()) {
    try {
      trees.push({ nodes: (await part.send("Accessibility.getFullAXTree", { frameId })).nodes, prefix: `f${k}:` });
    } catch {
      // a frame that is gone, or not of this process
    }
  }
  return trees.flatMap((t) => cdp.prefixNodes(t.nodes, `${part.tag}${t.prefix}`, part.tag));
}

// A layout snapshot, asked for twice when the first times out: a heavy page can miss the deadline once while it builds.
async function capture(part) {
  const ask = () => part.send("DOMSnapshot.captureSnapshot", { computedStyles: cdp.STYLES });
  try {
    return await ask();
  } catch (e) {
    if (!/timed out/.test(e.message)) throw e;
    return ask();
  }
}

// Reads every visible part: its layout snapshot, the elements hidden in it and, with `ax`, its accessibility nodes.
async function readParts(c, { ax = false } = {}) {
  const parts = await frameParts(c);
  const read = await Promise.all(
    parts.map(async (part) => {
      const [snap, nodes] = await Promise.all([capture(part), ax ? axOf(part) : undefined]);
      return { part, snap, nodes, hidden: cdp.hiddenElements(snap) };
    }),
  );
  const shown = new Set();
  const out = [];
  for (const r of read) {
    if (r.part.parent) {
      const up = read.find((x) => x.part === r.part.parent);
      if (!shown.has(r.part.parent)) continue;
      try {
        const owner = await up.part.send("DOM.getFrameOwner", { frameId: r.part.target });
        if (up.hidden.has(owner.backendNodeId) || !cdp.showsBox(up.snap, owner.backendNodeId)) continue;
      } catch {
        continue;
      }
    }
    shown.add(r.part);
    out.push(r);
  }
  return out;
}

// The text of a read (readParts), the page's first: { lines, xs (left edges), lineOf (accessibility node -> line index, by
// its element), notes (cdp.pageNotices), rows (with `table`: per line, the table row's { table, head }) }. `t` is the
// page's target, for its title.
function readText(read, t, { marks = false, table = false } = {}) {
  const lines = [];
  const xs = [];
  const at = new Map();
  const rows = [];
  for (const r of read) {
    const s = cdp.snapshotText(r.snap, { marks, width: WIDTH, table });
    for (const [id, k] of s.at) at.set(`${r.part.tag}:${id}`, lines.length + k);
    s.rows.forEach((x, k) => {
      if (x) rows[lines.length + k] = { table: `${r.part.tag}/${x.table}`, head: x.head };
    });
    lines.push(...s.lines);
    xs.push(...s.xs);
  }
  const notes = cdp.pageNotices(
    read.map((r) => ({ snap: r.snap, hidden: r.hidden, url: r.part.url })),
    { lines, title: cdp.decodeEntities(t?.title), sighting: (host) => Math.max((botChecks()[host] ?? 0) + (opening ? 1 : 0), 1) },
  );
  return { lines, xs, lineOf: (n) => at.get(`${n.frameTag ?? ""}:${n.backendDOMNodeId}`), notes, rows };
}

// Bot checks met per host this session, counted by open: the first may be a one-off, the second is the site's answer
// (cdp.pageNotices words them). `opening` is set while open reads the page it typed: what it finds is one more.
const BOT_CHECKS = () => path.join(lib.sessionDir(), "web-bot-checks.json");
let opening = false;
function botChecks() {
  try {
    return JSON.parse(fs.readFileSync(BOT_CHECKS(), "utf8"));
  } catch {
    return {};
  }
}
function countBotCheck(url) {
  let host;
  try {
    host = new URL(url).host;
  } catch {
    return;
  }
  const seen = botChecks();
  seen[host] = (seen[host] ?? 0) + 1;
  try {
    fs.mkdirSync(path.dirname(BOT_CHECKS()), { recursive: true });
    fs.writeFileSync(BOT_CHECKS(), JSON.stringify(seen));
  } catch {
    // the next sighting reads as a first one
  }
}
const BOT_NOTE = /^(looks like a bot check|bot check again) \(/;

const pageText = async (c, o) => readText(await readParts(c), c.target, o);
const pageLines = async (c, o) => (await pageText(c, o)).lines;

// A page whose renderer is blocked (a JS alert, confirm, prompt or leave-page dialog is open, or it is stuck in a loop) still
// lists its target, but Page.getLayoutMetrics, answered by the renderer, never comes back. Every read would then wait out its
// 20 s timeout and say nothing, so each command asks this first. Returns "none" (no page), "ok" or "blocked".
async function probe() {
  const t = await target();
  if (!t) return { state: "none" };
  let c;
  try {
    c = await cdp.connect(t.webSocketDebuggerUrl, { timeoutMs: PROBE_MS });
    await c.send("Page.getLayoutMetrics");
    return { state: "ok", target: t };
  } catch (e) {
    return { state: /timed out/.test(e.message) ? "blocked" : "ok", target: t };
  } finally {
    c?.close();
  }
}

// Chrome's own JS dialog from its accessibility tree (AT-SPI), which answers while the page is stuck: { dialog } when one is
// open, {} when there is none, { unread: true } when the tree could not be read.
function browserDialog() {
  try {
    const d = lib.atspiDialog(lib.envelope(lib.desktop(["snapshot", "--app", "chrome", "--timeout-ms", "3000"])).data?.tree);
    return d ? { dialog: d } : {};
  } catch {
    return { unread: true };
  }
}

// Whether a page whose probe timed out is really blocked: a heavy load (a long script, a big page building) misses one probe
// too. Blocked when Chrome shows its own dialog, or when two more probes 1.5 s apart time out as well; then returns what
// blockedLines prints. Undefined when the page answered after all.
async function stuck() {
  const first = browserDialog();
  if (first.dialog) return first;
  for (let k = 0; k < 2; k++) {
    lib.pause(1500);
    if ((await probe()).state !== "blocked") return undefined;
  }
  const last = browserDialog();
  return last.dialog || last.unread ? last : { busy: true };
}

// Probes the page and, when the probe times out, asks stuck(): what blockedLines prints when the page is blocked, else
// undefined.
async function blockedNow() {
  return (await probe()).state === "blocked" ? stuck() : undefined;
}

// What a blocked page shows (`why`, from stuck()): Chrome's own dialog is in the accessibility tree even while the page is
// stuck, so its title, message and buttons are text; when the tree cannot be read, a screenshot of where such a dialog sits
// (the top centre of the window, under the toolbar). Says how to answer it. A page that is only busy (no dialog found) says
// so, and nothing about a dialog.
function blockedLines({ still = false, why } = {}) {
  if (why.busy || (!why.dialog && !why.unread)) {
    return [
      `${still ? "Still busy" : "The page is busy"}: it has not answered for several seconds, and no browser dialog is open.`,
      'Wait and read it again: desktop-web wait "regex" or desktop-web text "regex".',
    ];
  }
  const out = [
    `${still ? "Still blocked: the" : "The"} page is not answering: a browser dialog (alert, confirm, prompt or leave-page) is ${why.dialog ? "open" : "probably open, or the page is busy"}.`,
  ];
  const d = why.dialog;
  if (d) {
    out.push(`dialog "${lib.clip(d.title, 80)}": ${lib.clip(d.message, 300)}`);
    if (d.fields.length > 0) out.push(`text field: ${JSON.stringify(d.fields[0])}`);
    out.push(`buttons: ${d.buttons.map((b) => `${b.name}${b.focused ? " (default)" : ""}`).join(" | ")}`);
  } else {
    const win = chromeWindow();
    if (win) {
      const w = Math.min(760, win.width);
      try {
        const shot = execFileSync("desktop-shot", ["--region", `${win.x + Math.round((win.width - w) / 2)},${win.y + 60},${w},300`], { encoding: "utf8" });
        out.push(`dialog area (read this image): ${shot.trim().split(" ")[0]}`);
      } catch {
        // no screenshot: the instructions below still apply
      }
    }
  }
  out.push(
    `OK: desktop-web key Return. Cancel: desktop-web key Escape. A prompt: desktop-web key --text "answer" Return.${d ? "" : " If nothing is open the page is busy: wait and run the command again."}`,
  );
  return out;
}

// Stops a command that needs the page when the page is blocked, saying why. An open file chooser stops actions too (it takes
// the browser's input); a read (`read`) goes on with the notice first.
async function guard({ read = false } = {}) {
  const d = chooserWindow();
  if (d) {
    console.log(chooserLines(d).join("\n"));
    if (!read) process.exit(3);
  }
  const why = await blockedNow();
  if (!why) return;
  console.log(blockedLines({ why }).join("\n"));
  process.exit(3);
}

const fingerprint = (lines) => `${lines.length}:${lines.join("\n").length}:${lines.slice(-3).join("|")}`;

// Waits for the page to answer an action: the URL or title changes, or nothing changes within quietMs (an in-page
// update); then the page's text must hold still for two reads in a row, and, with `want`, contain a match for it.
// All within capMs. A page of one or two lines (a bot check, an error) must hold still for three reads. Returns { target,
// lines, lineOf, notes } (readText).
async function settle(before, { quietMs = 1500, capMs = 20000, want } = {}) {
  const start = Date.now();
  let t = before;
  let probed = false;
  while (Date.now() - start < quietMs) {
    t = (await target()) ?? t;
    if (t.url !== before.url || t.title !== before.title) break;
    lib.pause(250);
    // A click that opens a JS dialog changes nothing else: look once after a second, not after the whole quiet time.
    if (!probed && Date.now() - start >= 1000) {
      probed = true;
      const why = await blockedNow();
      if (why) return { target: t, lines: [], blocked: why };
    }
  }
  let text = { lines: [], notes: [] };
  let last;
  let same = 0;
  while (Date.now() - start < capMs) {
    lib.pause(400);
    try {
      text = await withPage((c) => pageText(c));
    } catch {
      same = 0; // between documents
      const why = await blockedNow();
      if (why) return { target: (await target()) ?? t, lines: [], notes: [], blocked: why };
      continue;
    }
    const f = fingerprint(text.lines);
    same = text.lines.length > 0 && f === last ? same + 1 : 0;
    last = f;
    if (same >= (text.lines.length >= 3 ? 1 : 2) && (!want || text.lines.some((l) => want.test(l)))) break;
  }
  // Every read failed or found a document between pages: one more, so an answer never says "0 lines" of a page with text.
  if (text.lines.length === 0) text = await withPage((c) => pageText(c)).catch(() => text);
  return { ...text, target: (await target()) ?? t };
}

// The head of an answer: the url when it changed since the last answer (`full`: always, uncut), the title, and notices. A
// frame still loading is said once per page URL: a tracker's frame that never draws would say it in every answer.
const LOADING_SAID = () => path.join(lib.sessionDir(), "web-loading-said");
function header(t, notes = [], { full = false } = {}) {
  let last;
  try {
    last = fs.readFileSync(LAST_URL(), "utf8");
  } catch {
    last = undefined;
  }
  if (notes.some((n) => / still loading \(/.test(n))) {
    let said;
    try {
      said = fs.readFileSync(LOADING_SAID(), "utf8").split("\n");
    } catch {
      said = [];
    }
    if (said.includes(t.url)) notes = notes.filter((n) => !/ still loading \(/.test(n));
    else {
      try {
        fs.mkdirSync(path.dirname(LOADING_SAID()), { recursive: true });
        fs.writeFileSync(LOADING_SAID(), [...said.slice(-49), t.url].join("\n"));
      } catch {
        // said again next time
      }
    }
  }
  const out = full || last !== t.url ? [`url: ${full ? t.url : lib.clip(t.url, 120)}`] : [];
  try {
    fs.mkdirSync(path.dirname(LAST_URL()), { recursive: true });
    fs.writeFileSync(LAST_URL(), t.url);
  } catch {
    // the next answer prints the url again
  }
  return [...out, `title: ${cdp.decodeEntities(t.title)}`, ...notes];
}

// Whether `typed` led elsewhere: another origin or path (a query or fragment a page rewrites in place does not count).
function redirected(typed, final) {
  try {
    const a = new URL(typed);
    const b = new URL(final);
    const trim = (u) => u.pathname.replace(/\/+$/, "");
    return a.origin !== b.origin || trim(a) !== trim(b);
  } catch {
    return false;
  }
}
const pageFile = (o) => o.out ?? path.join(lib.sessionDir(), "web-page.txt");

// Roles a hover or a screenshot can aim at besides what a click can: pictures and groups of things, found by their name.
const SHOWABLE = new Set(["image", "img", "figure", "article", "group", "listitem", "row", "cell", "region", "list"]);

// The page's elements to act on, with the page's text lines from the same read. `options` adds a native select's options
// (read from the layout snapshot, where a closed select's options are nodes all the same) to its entry as `options` and
// `select`; `showable` also lists named pictures and groups, for hover and shot. Hidden elements are left out (but a hidden
// checkbox or radio behind a visible label is kept, `via` the label), fields get their placeholder and nameless controls
// words from their markup or row (cdp.annotate, cdp.nameUnnamed).
async function axTree(c, { options = false, showable = false } = {}) {
  const read = await readParts(c, { ax: true });
  const nodes = read.flatMap((r) => r.nodes);
  const all = cdp.axEntries(nodes, showable ? { extraRoles: SHOWABLE } : {});
  let entries = read.flatMap((r) => cdp.annotate(all.filter((e) => (e.frameTag ?? "") === r.part.tag), r.snap, r.hidden));
  entries = cdp.nameUnnamed(nodes, entries);
  if (options) {
    const selects = new Map(read.map((r) => [r.part.tag, cdp.selectInfos(r.snap)]));
    for (const e of entries) {
      const info = selects.get(e.frameTag ?? "")?.get(e.backendNodeId);
      if (info) Object.assign(e, { options: info.options, select: info });
    }
  }
  const { lines, lineOf, notes } = readText(read, c.target);
  return { nodes, entries: cdp.mainFirst(nodes, entries), read, lines, lineOf, notes };
}

// Lines of text a click can act on that no element's name matches (cdp.textTargets), as entries of role "clickable"; with
// `any` every visible line (a drop zone), role "text" when it shows no sign of taking clicks. Text inside a listed element,
// or inside the label a listed checkbox is clicked through, is that element's.
function textEntries(tree, re, { any = false } = {}) {
  const out = [];
  for (const r of tree.read) {
    const own = tree.entries.filter((e) => (e.frameTag ?? "") === r.part.tag);
    const skip = new Set([...own.map((e) => e.backendNodeId), ...own.map((e) => e.via).filter((v) => v !== undefined)]);
    for (const t of cdp.textTargets(r.snap, re, { skip, any })) {
      if (r.hidden.has(t.backendNodeId)) continue;
      const tag = r.part.tag || undefined;
      out.push({ ref: `e${t.backendNodeId}${tag ? `@${tag}` : ""}`, frameTag: tag, backendNodeId: t.backendNodeId, role: t.clickable ? "clickable" : "text", name: t.name });
    }
  }
  return out;
}

// Accessibility nodes of the page and its iframes, for dialogs and outlines.
async function axNodes(c) {
  return (await Promise.all((await frameParts(c)).map(axOf))).flat();
}

// Elements whose name, placeholder or row matches when no text line does (a field's label and placeholder are not page text).
// `tree` reads axTree when called.
async function namedLike(re, tree) {
  const t = await tree().catch(() => undefined);
  const els = (t?.entries ?? []).filter((e) => cdp.matchTexts(e).some((x) => re.test(x))).slice(0, 5);
  if (els.length === 0) return [];
  rememberRefs(els, { merge: true });
  return ["elements that match (no text line does):", ...els.map((e) => `  ${cdp.entryLine(e, { nameMax: 70 })}`)];
}

// When no line matches: how many blocks of text a box with overflow hidden cuts away match (cdp.cutOff), never their text,
// and the control that opens that box: a collapsed one (expanded=false) in or just below it, else the button or link just
// below it.
function cutOffLines(re, tree) {
  if (!tree) return [];
  let count = 0;
  let pick;
  for (const r of tree.read) {
    const cut = cdp.cutOff(r.snap, re);
    if (cut.count === 0) continue;
    count += cut.count;
    if (pick) continue;
    const own = tree.entries.filter((e) => (e.frameTag ?? "") === (r.part.tag ?? "") && !r.hidden.has(e.backendNodeId));
    const at = cdp.boxesOf(r.snap, own.map((e) => e.backendNodeId));
    // how far below a cutting box an element starts (inside it counts as 0), or undefined when it is not in or under it
    const below = (e) => {
      const b = at.get(e.backendNodeId);
      if (!b) return undefined;
      let best;
      for (const c of cut.boxes) {
        if (b.x > c.x + c.w || b.x + b.w < c.x || b.y < c.y - 10 || b.y > c.y + c.h + 150) continue;
        const d = Math.max(b.y - (c.y + c.h), 0);
        best = best === undefined ? d : Math.min(best, d);
      }
      return best;
    };
    const near = (list) =>
      list
        .map((e) => ({ e, d: below(e) }))
        .filter((x) => x.d !== undefined)
        .sort((a, b) => a.d - b.d)[0]?.e;
    pick = near(own.filter((e) => e.expanded === "false" || e.expanded === false)) ?? near(own.filter((e) => ["button", "link"].includes(e.role) && e.expanded === undefined));
  }
  if (count === 0) return [];
  const what = `${count === 1 ? "1 match is" : `${count} matches are`} in a cut-off section (text not shown)`;
  if (!pick) return [`${what}: open it first (a "more" control near it: desktop-web snap)`];
  rememberRefs([pick], { merge: true });
  return [`${what}: open it first with ${cdp.entryLine(pick, { nameMax: 60 })} (desktop-web click ${pick.ref})`];
}

// What a page shows first: open dialogs, then the matching lines, or without a regex an outline of its headings. `lineOf`
// maps a heading to its line (readText).
async function describe(lines, nodes, pattern, o, tree, lineOf) {
  const file = lib.savePage(lines, pageFile(o));
  const out = cdp.dialogLines(cdp.dialogs(nodes));
  if (pattern) {
    const hits = lib.grepLines(lines, regex(pattern), { limit: o.limit ?? 25, context: o.context, width: WIDTH });
    out.push(...hits);
    if (hits.length === 1 && hits[0].startsWith("no match"))
      out.push(...(await namedLike(regex(pattern), tree)), "outline:", ...cdp.outline(nodes, lines, { lineOf }));
  } else {
    const ol = cdp.outline(nodes, lines, { lineOf });
    out.push(...(ol.length > 0 ? ["outline (line: heading):", ...ol] : lines.slice(0, 15).map((l, i) => `${i + 1}: ${l}`)));
  }
  out.push(
    lines.length > 0
      ? `(${lines.length} lines in ${file}; read with desktop-web text "regex" or --lines A-B)`
      : "(no text on the page yet: read it again with desktop-web text \"regex\", or desktop-web shot it)",
  );
  return out;
}

// Refs a listing showed, with the role and name each stood for: a later command checks a ref against them, and finds the
// element again by them when the page has replaced it. A full snap replaces the list; a partial listing adds to it.
function rememberRefs(entries, { merge = false } = {}) {
  let refs = {};
  if (merge) refs = readRefs();
  for (const e of entries) refs[e.ref] = { role: e.role, name: e.name };
  fs.mkdirSync(path.dirname(REFS()), { recursive: true });
  fs.writeFileSync(REFS(), JSON.stringify(refs));
}
function readRefs() {
  try {
    return JSON.parse(fs.readFileSync(REFS(), "utf8"));
  } catch {
    return {};
  }
}
const CHROME_LANDMARKS = new Set(["banner", "navigation"]);

// Whether an element's box (from the read's layout snapshot, page coordinates) shows in the viewport now: of identical
// matches, the one a person sees. An element of an out-of-process frame counts as not in view.
async function viewTest(c, tree) {
  let vp;
  try {
    vp = (await c.send("Page.getLayoutMetrics")).cssLayoutViewport;
  } catch {
    return undefined;
  }
  const root = tree.read.find((r) => !r.part.parent);
  return (e) => {
    if (!root || (e.frameTag ?? "") !== root.part.tag) return false;
    const id = e.via ?? e.backendNodeId;
    const b = cdp.boxesOf(root.snap, [id]).get(id);
    if (!b) return false;
    const w = Math.min(b.x + b.w, vp.pageX + vp.clientWidth) - Math.max(b.x, vp.pageX);
    const h = Math.min(b.y + b.h, vp.pageY + vp.clientHeight) - Math.max(b.y, vp.pageY);
    return w >= 2 && h >= 2;
  };
}

// When nothing matches: closed menus and collapsed controls that may hold it (cdp.closedMenus), with refs. Nothing is opened.
function menuLines(entries) {
  const menus = cdp.closedMenus(entries);
  if (menus.length === 0) return [];
  rememberRefs(menus, { merge: true });
  return ["closed menus that may hold it:", ...menus.map((e) => `  ${cdp.entryLine(e, { nameMax: 70 })}${e.hasPopup && e.expanded === undefined ? ` haspopup=${e.hasPopup}` : ""}`)];
}
const escapeRe = (s) => s.replace(/[\\^$.*+?()[\]{}|]/g, "\\$&");
const isRef = (spec) => /^e\d+(@\w+)?$/.test(spec);

// Resolves a ref (e123) or a name regex to one element. A ref is checked against what snap listed under it, so a ref left
// over from another page cannot click a different element; a ref whose element the page replaced (a re-render) is found
// again by its role and name when exactly one element has them, and `note` says so. A name regex that matches no element
// falls back, with `text`, to a line of clickable text (textEntries). Lists the candidates and exits 2 when a name is
// ambiguous. `tree` is a read of axTree to reuse.
async function resolveTarget(c, spec, o, { fieldsOnly = false, selectsOnly = false, text = false, anyText = false, tree, ...read } = {}) {
  tree ??= await axTree(c, read);
  const { nodes, entries } = tree;
  if (isRef(spec)) {
    const was = readRefs()[spec];
    let now = entries.find((e) => e.ref === spec);
    // a line of text (clickable, or any text a listing showed) is found again among the lines that start like it
    const isText = was?.role === "clickable" || was?.role === "text";
    const lines = () => textEntries(tree, new RegExp(`^${escapeRe(was.name.replace(/…$/, ""))}`), { any: was.role === "text" });
    if (!now && isText) now = lines().find((e) => e.ref === spec);
    let note;
    if (!now && was) {
      const pool = isText ? lines() : entries;
      const same = pool.filter((e) => e.role === was.role && e.name === was.name);
      if (same.length === 1) {
        now = same[0];
        note = `${spec} is gone (the page replaced it); using ${now.ref}, the one ${was.role} "${lib.clip(was.name, 60)}" on the page now`;
        rememberRefs([now], { merge: true });
      }
    }
    if (!now) fail(`${spec} is not on the page now (it changed or the element is hidden): run desktop-web snap again`);
    if (!note && was && (was.role !== now.role || was.name !== now.name))
      fail(`${spec} is now ${cdp.entryLine(now)}, not the ${was.role} "${lib.clip(was.name, 60)}" snap listed: run desktop-web snap again`);
    return { entry: now, nodes, note };
  }
  const pool = fieldsOnly
    ? entries.filter((e) => ["textbox", "searchbox", "combobox", "spinbutton", "slider"].includes(e.role) || e.file)
    : selectsOnly
      ? entries.filter((e) => e.select || ["combobox", "listbox"].includes(e.role))
      : entries;
  const re = regex(spec);
  let r = cdp.chooseTarget(nodes, pool, re, {
    near: o.near ? regex(o.near) : undefined,
    nth: o.nth,
    role: o.role,
    showable: read.showable,
    texts: text ? () => textEntries(tree, re, { any: anyText }) : undefined,
    fields: fieldsOnly,
    landmark: (e) => cdp.inLandmark(nodes, e, CHROME_LANDMARKS),
    inView: await viewTest(c, tree),
  });
  if (r.none && text && !r.near && !o.role) {
    // No element is named so: a line of text that takes clicks (a role-less option), if exactly one, or the exact one.
    const hits = textEntries(tree, re, { any: anyText });
    const whole = new RegExp(`^(?:${re.source})$`, re.flags);
    const exact = hits.filter((e) => whole.test(e.name));
    const pick = o.nth !== undefined ? hits[o.nth - 1] : hits.length === 1 ? hits[0] : exact.length === 1 ? exact[0] : undefined;
    if (pick) return { entry: pick, nodes, note: `no element has that name; ${anyText ? "used" : "clicked"} the text` };
    if (hits.length > 1) r = { several: hits };
    else if (!anyText) {
      // Last, any visible line (a page that listens on the whole list, as frameworks do, shows no sign on the text): only the
      // one line that matches, or reads exactly so.
      const plain = textEntries(tree, re, { any: true });
      const one = plain.length === 1 ? plain[0] : plain.filter((e) => whole.test(e.name)).length === 1 ? plain.find((e) => whole.test(e.name)) : undefined;
      if (one) return { entry: one, nodes, note: "no element or clickable text has that name; clicked the plain text (it shows no sign of taking clicks)" };
      if (plain.length > 1) r = { several: plain };
    }
  }
  if (r.pick) return { entry: r.pick, nodes, note: r.note };
  if (r.none) {
    const d = cdp.dialogLines(cdp.dialogs(nodes));
    fail(
      [
        r.near
          ? `nothing matching ${JSON.stringify(spec)} near ${JSON.stringify(o.near)}`
          : `nothing ${read.showable ? "" : "clickable "}matches ${JSON.stringify(spec)}: try desktop-web snap "word"`,
        ...(r.near ? [] : menuLines(entries)),
        ...d,
      ].join("\n"),
    );
  }
  const rows = cdp.rowTexts(nodes, r.several.map((e) => ({ ...e, nodeId: e.nodeId ?? "" })));
  rememberRefs(r.several, { merge: true });
  const lines = r.several.slice(0, 15).map((e, i) => {
    // The row text starts with the element's own name more often than not: show only what tells the rows apart.
    const row = rows[i].startsWith(e.name) ? rows[i].slice(e.name.length).trim() : rows[i];
    return `${cdp.entryLine(e, { nameMax: 70 })}${row ? `  | ${lib.clip(row, 120)}` : ""}${e.url ? ` -> ${lib.clip(e.url, 90)}` : ""}`;
  });
  process.stdout.write(
    `${r.several.length} elements match ${JSON.stringify(spec)}; nothing clicked. Click one by ref (desktop-web click e123), or add --near "text from its row":\n${lines.join("\n")}\n`,
  );
  process.exit(2);
}

// The challenge provider (cdp.challengeOf) of the frame an element sits in, or of a frame around it, by the frame's URL or
// its iframe element's src: a bot check's own widget, which nothing here clicks, types into or drags. A frame that shows a
// srcdoc or has not loaded keeps the src it was given. `read` is the read (readParts) the element was found in: its layout
// snapshot says which frame's document holds the element.
async function challengeAround(read, entry) {
  const r = read.find((x) => x.part.tag === (entry.frameTag ?? ""));
  if (!r) return undefined;
  const { part, snap } = r;
  const doc = (snap.documents ?? []).find((d) => d.nodes.backendNodeId?.includes(entry.backendNodeId));
  const frameId = doc && doc.frameId >= 0 ? snap.strings[doc.frameId] : undefined;
  const srcOf = async (send, id) => {
    try {
      const { backendNodeId } = await send("DOM.getFrameOwner", { frameId: id });
      const attrs = (await send("DOM.describeNode", { backendNodeId })).node.attributes ?? [];
      return attrs.reduce((s, v, i, a) => (i % 2 === 1 && a[i - 1] === "src" ? v : s), "");
    } catch {
      return "";
    }
  };
  const urls = [];
  // the frames of this part's process from the element's up to (not including) the part's own root
  const parent = new Map();
  const url = new Map();
  const walk = (n, up) => {
    parent.set(n.frame.id, up);
    url.set(n.frame.id, [n.frame.url, n.frame.unreachableUrl]);
    for (const ch of n.childFrames ?? []) walk(ch, n.frame.id);
  };
  try {
    walk((await part.send("Page.getFrameTree")).frameTree);
  } catch {
    // no tree: the part's own frames below still count
  }
  for (let f = frameId; f && parent.get(f) !== undefined; f = parent.get(f)) urls.push(...url.get(f), await srcOf(part.send, f));
  for (let p = part; p.parent; p = p.parent) urls.push(p.url, await srcOf(p.parent.send, p.target));
  for (const u of urls) {
    if (!u) continue;
    const hit = cdp.challengeOf(u) ?? (/^\/\//.test(u) ? cdp.challengeOf(`https:${u}`) : undefined);
    if (hit) return hit;
  }
  return undefined;
}
async function refuseChallenge(read, entry, what) {
  const hit = await challengeAround(read, entry);
  if (hit) fail(`${cdp.entryLine(entry, { nameMax: 60 })}: that is the bot check's own widget (${hit}). It is never clicked, typed into, dragged or solved; nothing ${what}`);
}

// Says what covers the element at `point` (its viewport's coordinates), or nothing when the click would reach it:
// { by (the element hit, tag.class), what (what is in front), lines (the dialog or layer with its controls) }.
// getNodeForLocation takes document coordinates: the viewport point plus the scroll offset. `own` are elements that are part
// of the control (its <label>, its own box: cdp.annotate): their decoration (a drawn check box, a ::before) takes the same
// click. `tag` is the part's frame tag, to find a dialog in front among `nodes`. With no dialog in front, the fixed layer the
// hit element sits in (a consent overlay without a dialog role) is named instead, with its controls.
async function coveredBy(send, backendNodeId, quad, point, nodes, { own = [], tag = "" } = {}) {
  const lp = (await send("Page.getLayoutMetrics")).cssLayoutViewport;
  const hit = await send("DOM.getNodeForLocation", {
    x: Math.round(point.x + lp.pageX),
    y: Math.round(point.y + lp.pageY),
    includeUserAgentShadowDOM: true,
  }).catch(() => undefined);
  if (!hit || hit.backendNodeId === backendNodeId) return undefined;
  const inside = cdp.subtreeIds((await send("DOM.describeNode", { backendNodeId, depth: -1, pierce: true })).node);
  if (inside.has(hit.backendNodeId)) return undefined;
  const hb = await send("DOM.getBoxModel", { backendNodeId: hit.backendNodeId }).catch(() => undefined);
  // A wrapper around the element and only a little larger (a link around a span) takes the same click; anything else
  // under the point (a dialog's text, a big layer) means the element is covered.
  if (hb && cdp.wraps(hb.model.border, quad)) return undefined;
  const within = async (id) => cdp.subtreeIds((await send("DOM.describeNode", { backendNodeId: id, depth: -1, pierce: true })).node).has(hit.backendNodeId);
  for (const id of own) if (await within(id).catch(() => false)) return undefined;
  const d = (await send("DOM.describeNode", { backendNodeId: hit.backendNodeId })).node;
  const cls = (d.attributes ?? []).reduce((s, v, i, a) => (a[i - 1] === "class" ? v : s), "");
  const shown = cdp.dialogs(nodes);
  let front;
  for (const x of shown) {
    if ((x.frameTag ?? "") !== tag || x.backendNodeId === undefined) continue;
    if (await within(x.backendNodeId).catch(() => false)) {
      front = x;
      break;
    }
  }
  const by = `${d.nodeName.toLowerCase()}${cls ? `.${lib.clip(cls, 40)}` : ""}`;
  if (front || shown.length > 0) {
    return { by, what: front ? `the ${front.role}${front.name ? ` "${lib.clip(front.name, 60)}"` : ""} is in front` : "something is in front", lines: cdp.dialogLines(shown) };
  }
  const layer = await fixedLayer(send, hit.backendNodeId, nodes, tag).catch(() => undefined);
  if (layer) return { by, what: "a fixed layer is in front", lines: layer.lines };
  return { by, what: "something is in front", lines: [] };
}

// The fixed layer (fixedLayer) under the centre of the page's viewport when it holds a button: an overlay that a person
// must answer first. Undefined for none, or for a layer of links alone (a docked menu).
async function centreOverlay(c, nodes) {
  const vp = (await c.send("Page.getLayoutMetrics")).cssLayoutViewport;
  const hit = await c.send("DOM.getNodeForLocation", {
    x: Math.round(vp.pageX + vp.clientWidth / 2),
    y: Math.round(vp.pageY + vp.clientHeight / 2),
    includeUserAgentShadowDOM: true,
  });
  const layer = await fixedLayer(c.send, hit.backendNodeId, nodes);
  return layer && layer.buttons > 0 ? layer.lines : undefined;
}

// A refusal for a covered element (coveredBy): what is in front and what to do.
const coverText = (k) =>
  [`another element covers it (${k.by}): ${k.what}. Close or answer it first, then run the rest of the chain again`, ...k.lines].join("\n");

// The fixed layer (position fixed) an element sits in, with up to 8 of its controls, refs remembered: an overlay in front
// that has no dialog role. Undefined when the element is in no such layer or the layer holds no control.
async function fixedLayer(send, backendNodeId, nodes, tag = "") {
  const snap = await send("DOMSnapshot.captureSnapshot", { computedStyles: cdp.STYLES });
  const layer = cdp.fixedAncestor(snap, backendNodeId);
  if (layer === undefined) return undefined;
  const ids = cdp.subtreeIds((await send("DOM.describeNode", { backendNodeId: layer, depth: -1, pierce: true })).node);
  const c = cdp.layerControls(nodes, ids, { tag });
  if (c.entries.length === 0) return undefined;
  rememberRefs(c.entries, { merge: true });
  return {
    buttons: c.buttons,
    lines: [
      "open overlay (a fixed layer without a dialog role; act on it first):",
      ...c.entries.map((e) => `  ${cdp.entryLine(e, { nameMax: 70 })}`),
      ...(c.more ? [`  ... ${c.more} more: desktop-web snap`] : []),
    ],
  };
}

// Scrolls the element into view, checks nothing covers it (unless `cover` is false; "note": what covers it is returned as
// `covered`, for a screenshot that says so), and returns where it is on the screen: { box: {x, y, w, h}, win, area (the
// page's visible area on the screen), covered }. An element of an out-of-process iframe is read through that
// frame's connection and placed in the page by its iframe element's content box.
async function placeNode(c, nodes, entry, { cover = true, scroll = true, aim = false } = {}) {
  // A checkbox drawn by its label is clicked on the label, which a person sees and which toggles it.
  const backendNodeId = entry.via ?? entry.backendNodeId;
  const part = (await frameParts(c)).find((p) => p.tag === (entry.frameTag ?? ""));
  if (!part) fail("the iframe of that element is gone: run desktop-web snap again");
  try {
    if (scroll) await part.send("DOM.scrollIntoViewIfNeeded", { backendNodeId });
  } catch {
    // not scrollable (fixed position); the box check below still applies
  }
  let quad;
  try {
    quad = (await part.send("DOM.getBoxModel", { backendNodeId })).model.border;
  } catch {
    const q = await part.send("DOM.getContentQuads", { backendNodeId }).catch(() => ({ quads: [] }));
    quad = q.quads[0];
  }
  if (!quad) fail("the element has no box on the page (hidden or removed): run desktop-web snap again");
  // A box still moving (a dialog sliding in, a panel that opens) would take the click where it was: read it again until it
  // holds still, for at most a second.
  const boxOf = () => part.send("DOM.getBoxModel", { backendNodeId }).then((b) => b.model.border, () => undefined);
  for (const start = Date.now(); Date.now() - start < SETTLE_BOX_MS; ) {
    lib.pause(150);
    const next = await boxOf();
    if (!next || next.every((v, i) => Math.abs(v - quad[i]) < 1)) break;
    quad = next;
  }
  const lm = await c.send("Page.getLayoutMetrics");
  const vp = lm.cssLayoutViewport;
  const zoom = lm.cssVisualViewport.zoom ?? 1;
  // The part of the page where a click can reach: the viewport, and for an iframe its own viewport inside it.
  let reach = { x: 0, y: 0, w: vp.clientWidth, h: vp.clientHeight };
  let origin = { x: 0, y: 0 };
  if (part.parent) {
    origin = await partOrigin(part).catch(() => fail("the iframe of that element is gone: run desktop-web snap again"));
    const own = (await part.send("Page.getLayoutMetrics")).cssLayoutViewport;
    const x = Math.max(reach.x, origin.x);
    const y = Math.max(reach.y, origin.y);
    reach = { x, y, w: Math.min(reach.x + reach.w, origin.x + own.clientWidth) - x, h: Math.min(reach.y + reach.h, origin.y + own.clientHeight) - y };
  }
  const pageQuad = cdp.shiftQuad(quad, origin.x, origin.y);
  let center = cdp.quadCenter(pageQuad);
  // A control that holds other listed controls (a column header with a footnote link) is clicked beside them, on itself.
  const beside = aim && entry.inner?.length ? await clearPoint(part.send, backendNodeId, quad, entry.inner) : undefined;
  if (beside) center = { x: beside.x + origin.x, y: beside.y + origin.y };
  if (center.x < reach.x || center.y < reach.y || center.x > reach.x + reach.w || center.y > reach.y + reach.h)
    fail(
      scroll
        ? "the element is outside the visible page and could not be scrolled into view"
        : "the target is out of view while the source shows: scroll so both show (desktop-web key Page_Down), zoom out (desktop-web key ctrl+minus), or use --by dx,dy",
    );
  // Something in front (a dialog, an overlay) would get the click instead: say what, rather than click it. For an iframe
  // that is checked at each frame on the way: the iframe element in its holder, then the element in its own frame.
  const checks = [];
  for (let p = part; p.parent; p = p.parent) {
    const owner = await p.parent.send("DOM.getFrameOwner", { frameId: p.target });
    const box = (await p.parent.send("DOM.getBoxModel", { backendNodeId: owner.backendNodeId })).model.border;
    const o = await partOrigin(p.parent);
    checks.push({ send: p.parent.send, id: owner.backendNodeId, quad: box, point: { x: center.x - o.x, y: center.y - o.y }, tag: p.parent.tag });
  }
  const own = [entry.labelEl, entry.boxEl].filter((x) => x !== undefined && x !== backendNodeId);
  checks.push({ send: part.send, id: backendNodeId, quad, point: { x: center.x - origin.x, y: center.y - origin.y }, tag: part.tag, own });
  let covered;
  for (const k of cover ? checks : []) {
    // a screenshot is taken whatever the hit test says
    const why = await coveredBy(k.send, k.id, k.quad, k.point, nodes, { own: k.own, tag: k.tag }).catch((e) => {
      if (cover === "note") return undefined;
      throw e;
    });
    if (why && cover === "note") {
      covered = why;
      break;
    }
    if (why) fail(coverText(why));
  }
  const win = chromeWindow();
  if (!win) fail("no Chrome window on the screen");
  // clientHeight leaves out a horizontal scrollbar, which takes the bottom of the window's page area: the viewport's top is
  // found from its full height.
  const bar = await cdp.scrollbarThickness(
    (y) => c.send("DOM.getNodeForLocation", { x: 1, y: Math.round(y + vp.pageY) }).then(() => true, () => false),
    vp.clientHeight,
  );
  const geo = { win, viewport: { height: vp.clientHeight + bar }, zoom, frame: FRAME };
  const xs = [pageQuad[0], pageQuad[2], pageQuad[4], pageQuad[6]];
  const ys = [pageQuad[1], pageQuad[3], pageQuad[5], pageQuad[7]];
  const tl = cdp.screenPoint(geo, { x: Math.max(Math.min(...xs), reach.x), y: Math.max(Math.min(...ys), reach.y) });
  const br = cdp.screenPoint(geo, { x: Math.min(Math.max(...xs), reach.x + reach.w), y: Math.min(Math.max(...ys), reach.y + reach.h) });
  const point = beside ? cdp.screenPoint(geo, center) : undefined;
  const a0 = cdp.screenPoint(geo, { x: reach.x, y: reach.y });
  const a1 = cdp.screenPoint(geo, { x: reach.x + reach.w, y: reach.y + reach.h });
  const area = { x: a0.x, y: a0.y, w: a1.x - a0.x, h: a1.y - a0.y };
  return { box: { x: tl.x, y: tl.y, w: Math.max(br.x - tl.x, 1), h: Math.max(br.y - tl.y, 1) }, win, point, area, covered };
}

// A point of the element (its part's viewport coordinates) outside the controls inside it, confirmed by hit testing: the
// element or its own text is there, none of those controls. Undefined when no such point is found (the centre is used).
async function clearPoint(send, backendNodeId, quad, inner) {
  const rect = (q) => ({ l: Math.min(q[0], q[6]), t: Math.min(q[1], q[3]), r: Math.max(q[2], q[4]), b: Math.max(q[5], q[7]) });
  const kids = [];
  const kidIds = new Set();
  for (const id of inner) {
    try {
      kids.push(rect((await send("DOM.getBoxModel", { backendNodeId: id })).model.border));
      for (const k of cdp.subtreeIds((await send("DOM.describeNode", { backendNodeId: id, depth: -1, pierce: true })).node)) kidIds.add(k);
    } catch {
      // gone or without a box: nothing to keep away from
    }
  }
  if (kids.length === 0) return undefined;
  try {
    const own = cdp.subtreeIds((await send("DOM.describeNode", { backendNodeId, depth: -1, pierce: true })).node);
    const lp = (await send("Page.getLayoutMetrics")).cssLayoutViewport;
    for (const p of cdp.aimPoints(rect(quad), kids).slice(0, 8)) {
      const hit = await send("DOM.getNodeForLocation", { x: Math.round(p.x + lp.pageX), y: Math.round(p.y + lp.pageY), includeUserAgentShadowDOM: true }).catch(() => undefined);
      if (hit && own.has(hit.backendNodeId) && !kidIds.has(hit.backendNodeId)) return p;
    }
  } catch {
    // the element changed: its centre is used
  }
  return undefined;
}

async function clickNode(c, nodes, entry, { double = false } = {}) {
  const { box, win, point } = await placeNode(c, nodes, entry, { aim: true });
  activate(win);
  return (double ? lib.humanDoubleClick : lib.humanClick)(point ? { x: point.x - 1, y: point.y - 1, w: 3, h: 3 } : box);
}

// The pointer over the element without a press: menus and captions that appear on hover. A dwell for the page's own handlers.
// The title a person would see as a tooltip over the element (cdp.titleAround), read from its part's layout snapshot.
async function titleOf(c, entry) {
  const part = (await frameParts(c)).find((p) => p.tag === (entry.frameTag ?? ""));
  const snap = part ? await capture(part).catch(() => undefined) : undefined;
  return snap ? cdp.titleAround(snap, entry.via ?? entry.backendNodeId) : undefined;
}

async function hoverNode(c, nodes, entry) {
  const { box, win } = await placeNode(c, nodes, entry);
  activate(win);
  const at = lib.humanMove(box);
  lib.pause(450);
  return at;
}

// A slider's value and focus as the accessibility tree has it now.
async function sliderState(entry) {
  return withPage(async (c) => {
    const n = (await axNodes(c)).find((m) => m.backendDOMNodeId === entry.backendNodeId && (m.frameTag ?? "") === (entry.frameTag ?? ""));
    const focused = (n?.properties ?? []).some((p) => p.name === "focused" && p.value?.value === true);
    return { value: Number(n?.value?.value), focused };
  });
}

// Sets a slider the way a person does, first by pointer: a slider that is its own track (a native range, a wide element) is
// pressed at the value's proportional point; a thumb drawn alone is dragged there along its track. Returns { want, from }.
async function pressSlider(c, tree, entry, text) {
  const want = Number(text);
  if (text === "" || !Number.isFinite(want)) fail(`a slider takes a number: desktop-web type ${entry.ref} 75`, 64);
  if ((entry.min !== undefined && want < entry.min) || (entry.max !== undefined && want > entry.max))
    fail(`${cdp.entryLine(entry)} takes ${entry.min} to ${entry.max}, not ${want}`, 64);
  const from = Number(entry.value);
  if (from === want) return { want, from };
  const range = { min: entry.min ?? 0, max: entry.max ?? 100, vertical: entry.vertical };
  const r = tree.read.find((x) => x.part.tag === (entry.frameTag ?? ""));
  const track = r ? cdp.sliderTrack(r.snap, entry.backendNodeId, { vertical: entry.vertical }) : undefined;
  const { box, win } = await placeNode(c, tree.nodes, entry);
  activate(win);
  if (track === undefined) {
    const p = cdp.sliderPoint(box, range, want);
    lib.humanClick({ x: p.x - 1, y: p.y - 1, w: 2, h: 2 });
  } else {
    const t = await placeNode(c, tree.nodes, { backendNodeId: track, frameTag: entry.frameTag }, { cover: false, scroll: false });
    lib.humanDrag(box, cdp.sliderPoint(t.box, range, want, { inset: 0 }));
  }
  return { want, from };
}

// Reads the slider back and closes in on the value with the arrow keys (the keyboard moves a slider by its own step), then
// prints value before -> after and what else changed. Exit 1 when it did not move, or stopped short of the value.
async function finishSlider(entry, { want, from }, { pre, before, head, o }) {
  const [up, down] = entry.vertical ? ["Up", "Down"] : ["Right", "Left"];
  lib.pause(250);
  let now = await sliderState(entry);
  let step;
  for (let round = 0; round < 6 && now.focused && Number.isFinite(now.value); round++) {
    const n = cdp.sliderPresses(now.value, want, step);
    if (n === 0) break;
    lib.keyRepeat(n > 0 ? up : down, Math.abs(n));
    lib.pause(200);
    const next = await sliderState(entry);
    if (next.value === now.value) break; // the keys do not move it
    if (!step && Math.abs(n) === 1) step = Math.abs(next.value - now.value);
    now = next;
  }
  const after = await settle(before, { quietMs: 700, capMs: 6000 });
  const got = Number.isFinite(now.value) ? now.value : from;
  const lines = [...head, `set [${entry.ref}] slider ${cdp.shortName(entry, 60)}: value ${from} -> ${got}`];
  const off = got !== want;
  if (off && step && Math.abs(got - want) < step) lines.push(`(${want} is between its steps of ${step}: ${got} is the nearest it takes)`);
  else if (off) lines.push(got === from ? "the slider did not move: desktop-web shot it, or try desktop-web key Right/Left after a click on it" : `it stopped at ${got}, not ${want}`);
  console.log([...lines, ...(after.blocked ? blockedLines({ why: after.blocked }) : await changes(pre, before, after, { ...o, noHint: true }, { self: entry, selfChanged: got !== from }))].join("\n"));
  if (off && !(step && Math.abs(got - want) < step)) process.exit(1);
}

// The state an action is measured against: the page's text lines, its elements and its accessibility nodes (dialogs, alerts).
const stateOf = (tree) => ({ lines: tree.lines, entries: tree.entries, nodes: tree.nodes });
const squash = (s) => String(s ?? "").replace(/\s+/g, " ").trim();
const OPTION_ROLES = new Set(["option", "menuitem", "menuitemradio", "menuitemcheckbox", "treeitem"]);

// What an action did: the new page, or what changed on this one (dialogs that closed, alerts that appeared, options that
// appeared, lines that appeared or went, other controls whose state changed), within the budget. `now` is a read after the
// action (read here when not given); `self` is the element acted on, whose own change the caller reports (`selfChanged`).
// A new address that keeps the path or most of the page's lines (a filter or sort in the query) shows what changed, not an
// outline.
// Lines that kept their text but not their order (a sort, a drag that swapped two items) are a change too: the range is
// printed as it reads now, its first ORDER_LINES lines. With `focus` (a key, a click) the element that took the focus is
// printed when it is another one than before and than the one acted on. Controls that appeared are printed with refs
// (appearedControls): at most APPEARED, only their count when more than APPEARED_MAX. `scrolled` (a key) is a line that says
// how far the page moved, a change too. `tooltip` (a hover) is the title printed when nothing else changed.
// When nothing changed at all: "result may come later" if the page shows it is busy, else "nothing happened" with the fields
// that block a form and how to look; the same no-op twice in a row says to stop.
const ORDER_LINES = 8;
const APPEARED = 5;
const APPEARED_MAX = 8;
async function changes(pre, before, after, o, { now, self, selfChanged = false, focus = false, scrolled, tooltip } = {}) {
  now ??= await withPage((c) => axTree(c)).catch(() => undefined);
  const nodes = now?.nodes ?? [];
  const out = header(after.target, after.notes);
  const chooser = chooserWindow();
  if (chooser) out.push(...chooserLines(chooser));
  const navigated = after.target.url !== before.url;
  const had = new Set(pre.lines);
  // only the query or fragment changed (a filter, a sort, a form sent with GET), or most lines stayed: the same page
  const samePage = navigated && after.lines.length > 0 && (!redirected(before.url, after.target.url) || after.lines.filter((l) => had.has(l)).length > after.lines.length / 2);
  const shown = cdp.dialogs(nodes);
  out.push(...cdp.dialogLines(shown));
  const busy = cdp.busy(nodes);
  let nothing = false;
  if (o.show) {
    lib.savePage(after.lines, pageFile(o));
    out.push(...lib.grepLines(after.lines, regex(o.show), { limit: o.limit ?? 25, context: o.context, width: WIDTH }));
  } else if (navigated && !samePage) {
    out.push(...(await describe(after.lines, nodes, undefined, o, async () => now, after.lineOf)).slice(cdp.dialogLines(shown).length));
  } else {
    const added = cdp.newLines(pre.lines, after.lines);
    const gone = after.lines.length > 0 ? cdp.newLines(after.lines, pre.lines) : [];
    const was = cdp.dialogs(pre.nodes);
    const closed = cdp.closedDialogs(was, shown);
    const opened = cdp.closedDialogs(shown, was);
    const live = new Set(cdp.liveTexts(pre.nodes));
    const alerts = cdp.liveTexts(nodes).filter((t) => !live.has(t));
    const diffs = now ? cdp.controlDiffs(pre.entries, now.entries, { skip: self?.ref }) : [];
    const known = new Set(pre.entries.map((e) => e.ref));
    const opts = (now?.entries ?? []).filter((e) => OPTION_ROLES.has(e.role) && !known.has(e.ref));
    const order = after.lines.length > 0 ? cdp.orderChange(pre.lines, after.lines) : undefined;
    // options are printed as such, and an open dialog's controls with the dialog
    const inDialog = cdp.dialogLines(shown).join("\n");
    // after a dialog blocked the page nothing was read before the key: every control would read as new
    const appeared = now && pre.nodes.length > 0
      ? cdp.appearedControls(pre.entries, now.entries).filter((e) => !OPTION_ROLES.has(e.role) && !(e.role === "listbox" && opts.length > 0) && !inDialog.includes(`[${e.ref}]`))
      : [];
    const focusWas = focus ? cdp.focusOf(pre.nodes, pre.entries) : undefined;
    const is = focus && now ? cdp.focusOf(now.nodes, now.entries) : undefined;
    // the clicked control itself taking the focus, or one printed under appeared, says nothing new
    const selfKeys = self ? [self.backendNodeId, self.via].filter((x) => x !== undefined).map((id) => `${self.frameTag ?? ""}:${id}`) : [];
    const mine = (x) => selfKeys.includes(x.key) || (x.entry && self && x.entry.role === self.role && x.entry.name === self.name) || appeared.includes(x.entry);
    const moved = is && is.key !== focusWas?.key && !mine(is) ? is : undefined;
    // a handle drawn without a role does nothing on a click but take the focus, for the keys that move it
    const keysNext = self?.role === "focusable" && is && is.key !== focusWas?.key && selfKeys.includes(is.key);
    lib.savePage(after.lines, pageFile(o));
    if (moved?.entry) rememberRefs([moved.entry], { merge: true });
    if (scrolled) out.push(scrolled);
    if (moved) out.push(`focus: ${moved.line}`);
    if (keysNext) out.push("it has the focus: move it with desktop-web key Right, Left, Page_Up or Page_Down");
    if (appeared.length > APPEARED_MAX) out.push(`appeared: ${appeared.length} controls (desktop-web snap)`);
    else if (appeared.length > 0) {
      rememberRefs(appeared, { merge: true });
      out.push(...appeared.slice(0, APPEARED).map((e) => `appeared: ${cdp.entryLine(e, { nameMax: 70 })}`));
      if (appeared.length > APPEARED) out.push(`appeared: ... ${appeared.length - APPEARED} more (desktop-web snap)`);
    }
    out.push(...closed.map((d) => `closed ${d}`), ...alerts.slice(0, 3));
    if (opts.length > 0) {
      rememberRefs(opts, { merge: true });
      out.push(`options (${opts.length}):`, ...opts.slice(0, 5).map((e) => `  ${cdp.entryLine(e, { nameMax: 70 })}`));
      if (opts.length > 5) out.push(`  ... ${opts.length - 5} more: desktop-web snap "regex"`);
    }
    if (added.length > 0) out.push(`changed (${added.length} new lines):`, ...added.slice(0, 20));
    if (added.length > 20) out.push(`... ${added.length - 20} more: desktop-web text "regex"`);
    if (gone.length > 0) out.push(`gone (${gone.length} lines): ${gone.slice(0, 3).map((l) => lib.clip(l, 60)).join(" | ")}${gone.length > 3 ? " | ..." : ""}`);
    if (order) {
      out.push(`order changed (lines ${order.from}-${order.to}), now:`);
      for (let k = order.from; k <= Math.min(order.to, order.from + ORDER_LINES - 1); k++) out.push(`${k}: ${lib.clip(after.lines[k - 1], 160)}`);
    }
    out.push(...diffs.slice(0, 5));
    if (diffs.length > 5) out.push(`... ${diffs.length - 5} more controls changed: desktop-web snap`);
    nothing = !navigated && !added.length && !gone.length && !order && !moved && !keysNext && !scrolled && !appeared.length && !closed.length && !opened.length && !alerts.length && !diffs.length && !selfChanged;
    if (nothing && tooltip) out.push(`tooltip: "${lib.clip(tooltip, 200)}"`);
    if (nothing && !busy && !o.noHint && !chooser) out.push(...nothingHappened(now, self, after.target.url));
    else if (!added.length && !gone.length && !order) out.push("page text unchanged");
    if (self?.role === "link" && !navigated && !o.noHint) out.push("note: the address did not change");
  }
  if (!nothing) forgetNoop();
  if (!o.show && !o.noHint && !(navigated && !samePage) && !chooser && busy) out.push('result may come later: desktop-web wait "regex"');
  return budget(out, PAGE_HINT);
}

// The same action on the same page that did nothing last time: what the agent must not repeat.
const NOOP = () => path.join(lib.sessionDir(), "web-noop");
function forgetNoop() {
  try {
    fs.rmSync(NOOP(), { force: true });
  } catch {
    // nothing to forget
  }
}

// What to say when an action changed nothing and the page is not busy: the fields that hold a form back (required and
// empty, or invalid), a look at the element, and, the second time the same control does nothing here, to stop.
function nothingHappened(now, self, url) {
  const out = ["nothing happened (no text, state, dialog or address change)"];
  const entries = now?.entries ?? [];
  const bad = entries.filter((e) => e.invalid);
  if (bad.length > 0) out.push(`invalid fields: ${bad.slice(0, 5).map((e) => cdp.entryLine(e, { nameMax: 40 })).join(" | ")}`);
  const empty = entries.filter((e) => e.required && !e.invalid && !e.value && ["textbox", "searchbox", "combobox", "spinbutton"].includes(e.role));
  if (empty.length > 0) out.push(`required and empty: ${empty.slice(0, 5).map((e) => cdp.entryLine(e, { nameMax: 40 })).join(" | ")}`);
  if (!self) return out;
  const key = `${process.argv[2]} ${self.ref} ${url}`;
  let last;
  try {
    last = fs.readFileSync(NOOP(), "utf8");
  } catch {
    last = undefined;
  }
  if (last === key) out.push("this control does nothing here; stop clicking it");
  else out.push(`look at it: desktop-web shot ${self.ref}`);
  try {
    fs.mkdirSync(path.dirname(NOOP()), { recursive: true });
    fs.writeFileSync(NOOP(), key);
  } catch {
    // the next no-op is not recognised as a repeat
  }
  return out;
}

// What typing did without Enter, kept short: the options that appeared (an autocomplete), else at most 5 new lines (a
// filter's results) and new alert text.
async function afterTyping(pre, after, typed, o) {
  const now = await withPage((c) => axTree(c)).catch(() => undefined);
  lib.savePage(after.lines, pageFile(o));
  const known = new Set(pre.entries.map((e) => e.ref));
  const opts = (now?.entries ?? []).filter((e) => OPTION_ROLES.has(e.role) && !known.has(e.ref));
  const had = new Set(cdp.liveTexts(pre.nodes));
  const out = cdp.liveTexts(now?.nodes ?? []).filter((t) => !had.has(t)).slice(0, 2);
  if (opts.length > 0) {
    rememberRefs(opts, { merge: true });
    out.push(`options (${opts.length}):`, ...opts.slice(0, 5).map((e) => `  ${cdp.entryLine(e, { nameMax: 70 })}`));
    if (opts.length > 5) out.push(`  ... ${opts.length - 5} more: desktop-web snap "regex"`);
    return out;
  }
  const added = cdp.newLines(pre.lines, after.lines).filter((l) => l !== squash(typed));
  const gone = after.lines.length > 0 ? cdp.newLines(after.lines, pre.lines).length : 0;
  if (added.length > 0) out.push(`changed (${added.length} new lines):`, ...added.slice(0, 5));
  if (added.length > 5) out.push(`... ${added.length - 5} more: desktop-web text "regex"`);
  if (gone > 0) out.push(`(${gone} lines gone)`);
  return out;
}

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  const o = parseArgs(rest);
  switch (cmd) {
    case "open": {
      const url = o.pos[0];
      if (!url) fail('usage: desktop-web open <url> ["regex"]', 64);
      if (!/^https?:\/\//.test(url) && !url.startsWith("file:///workspace/")) fail("give a full https:// URL", 64);
      await ensureBrowser();
      await guard();
      const before = await target();
      const win = chromeWindow();
      if (!win) fail("no Chrome window on the screen");
      activate(win);
      lib.key("ctrl+l");
      lib.pause(150);
      // A URL is pasted, as people do; typing a long one key by key would take seconds.
      lib.pasteText(url);
